/-- If the local cross analysis proves that the auxiliary adjacency relation is
unchanged on the shared index type, then the cross replacement linkage
satisfies the auxiliary-isomorphism invariant. -/
theorem replacementLinkage_auxGraphsIsomorphic_of_adj_iff
    (hleft_right :
      Cross.replacementPaths.leftPath.NodeDisjoint
        Cross.replacementPaths.rightPath)
    (hleft_disj :
      ∀ i : I.linkage.Index,
        i ≠ I.rowIndex Cross.rowLeft →
          i ≠ I.rowIndex Cross.rowRight →
            Cross.replacementPaths.leftPath.NodeDisjoint
              (I.linkage.path i))
    (hright_disj :
      ∀ i : I.linkage.Index,
        i ≠ I.rowIndex Cross.rowLeft →
          i ≠ I.rowIndex Cross.rowRight →
            Cross.replacementPaths.rightPath.NodeDisjoint
              (I.linkage.path i))
    (hadj :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph
          (Cross.replacementLinkage hleft_right hleft_disj hright_disj)).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j) :
    AuxGraphsIsomorphic I.linkage
      (Cross.replacementLinkage hleft_right hleft_disj hright_disj) := by
  refine auxGraphsIsomorphic_of_equiv_adj (Equiv.refl I.linkage.Index) ?_
  intro i j
  exact (hadj i j).symm

/-- Nonterminating cross branch: if all four local successor vertices still
have degree two, then the replacement linkage has an auxiliary graph
isomorphic to the previous one.

This is the formal version of the sentence after Figure 8 saying that, when
the local degrees remain two, `H''` is isomorphic to `H'`, with the two
replacement paths possibly switched.  The possible switch is represented by
the caller's chosen local order `auxA -- auxU -- auxV -- auxD`. -/
theorem replacementLinkage_auxGraphsIsomorphic_of_supportedLocalDegreeTwo
    (hleft_right :
      Cross.replacementPaths.leftPath.NodeDisjoint
        Cross.replacementPaths.rightPath)
    (hleft_disj :
      ∀ i : I.linkage.Index,
        i ≠ I.rowIndex Cross.rowLeft →
          i ≠ I.rowIndex Cross.rowRight →
            Cross.replacementPaths.leftPath.NodeDisjoint
              (I.linkage.path i))
    (hright_disj :
      ∀ i : I.linkage.Index,
        i ≠ I.rowIndex Cross.rowLeft →
          i ≠ I.rowIndex Cross.rowRight →
            Cross.replacementPaths.rightPath.NodeDisjoint
              (I.linkage.path i))
    (auxL auxA auxU auxV auxD auxR : I.linkage.Index)
    (hsupport :
      AdjChangeSupportedIn (linkageAuxGraph I.linkage)
        (linkageAuxGraph
          (Cross.replacementLinkage hleft_right hleft_disj hright_disj))
        ({auxA, auxU, auxV, auxD} : Finset I.linkage.Index))
    (hLA_old : (linkageAuxGraph I.linkage).Adj auxA auxL)
    (hAU_old : (linkageAuxGraph I.linkage).Adj auxA auxU)
    (hUV_old : (linkageAuxGraph I.linkage).Adj auxU auxV)
    (hVD_old : (linkageAuxGraph I.linkage).Adj auxV auxD)
    (hDR_old : (linkageAuxGraph I.linkage).Adj auxD auxR)
    (hAU_new :
      (linkageAuxGraph
        (Cross.replacementLinkage hleft_right hleft_disj hright_disj)).Adj
        auxA auxU)
    (hUV_new :
      (linkageAuxGraph
        (Cross.replacementLinkage hleft_right hleft_disj hright_disj)).Adj
        auxU auxV)
    (hVD_new :
      (linkageAuxGraph
        (Cross.replacementLinkage hleft_right hleft_disj hright_disj)).Adj
        auxV auxD)
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hU_old : DegreeEquals (linkageAuxGraph I.linkage) auxU 2)
    (hV_old : DegreeEquals (linkageAuxGraph I.linkage) auxV 2)
    (hD_old : DegreeEquals (linkageAuxGraph I.linkage) auxD 2)
    (hA_new :
      DegreeEquals
        (linkageAuxGraph
          (Cross.replacementLinkage hleft_right hleft_disj hright_disj))
        auxA 2)
    (hU_new :
      DegreeEquals
        (linkageAuxGraph
          (Cross.replacementLinkage hleft_right hleft_disj hright_disj))
        auxU 2)
    (hV_new :
      DegreeEquals
        (linkageAuxGraph
          (Cross.replacementLinkage hleft_right hleft_disj hright_disj))
        auxV 2)
    (hD_new :
      DegreeEquals
        (linkageAuxGraph
          (Cross.replacementLinkage hleft_right hleft_disj hright_disj))
        auxD 2)
    (hL_not :
      auxL ∉ ({auxA, auxU, auxV, auxD} : Finset I.linkage.Index))
    (hR_not :
      auxR ∉ ({auxA, auxU, auxV, auxD} : Finset I.linkage.Index))
    (hLU : auxL ≠ auxU) (hRV : auxR ≠ auxV)
    (hAU_ne : auxA ≠ auxU) (hAD : auxA ≠ auxD)
    (hUD : auxU ≠ auxD) (hAV : auxA ≠ auxV)
    (hDV : auxD ≠ auxV) (hLD : auxL ≠ auxD) :
    AuxGraphsIsomorphic I.linkage
      (Cross.replacementLinkage hleft_right hleft_disj hright_disj) := by
  let L'' : PerfectPathPacking G A B :=
    Cross.replacementLinkage hleft_right hleft_disj hright_disj
  have hadj :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph L'').Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j := by
    exact
      cross_local_adj_iff_of_supported_degree_two
        (H := linkageAuxGraph I.linkage) (H' := linkageAuxGraph L'')
        (L := auxL) (A := auxA) (U := auxU) (V := auxV)
        (D := auxD) (R := auxR)
        hsupport hLA_old hAU_old hUV_old hVD_old hDR_old
        hAU_new hUV_new hVD_new hA_old hU_old hV_old hD_old
        hA_new hU_new hV_new hD_new hL_not hR_not hLU hRV
        hAU_ne hAD hUD hAV hDV hLD
  exact Cross.replacementLinkage_auxGraphsIsomorphic_of_adj_iff
    hleft_right hleft_disj hright_disj hadj

/-- Concrete nonterminating cross branch, with the replacement linkage built
directly from the cross witness. -/
theorem replacementLinkageConcrete_auxGraphsIsomorphic_of_supportedLocalDegreeTwo
    (auxL auxA auxU auxV auxD auxR : I.linkage.Index)
    (hsupport :
      AdjChangeSupportedIn (linkageAuxGraph I.linkage)
        (linkageAuxGraph Cross.replacementLinkageConcrete)
        ({auxA, auxU, auxV, auxD} : Finset I.linkage.Index))
    (hLA_old : (linkageAuxGraph I.linkage).Adj auxA auxL)
    (hAU_old : (linkageAuxGraph I.linkage).Adj auxA auxU)
    (hUV_old : (linkageAuxGraph I.linkage).Adj auxU auxV)
    (hVD_old : (linkageAuxGraph I.linkage).Adj auxV auxD)
    (hDR_old : (linkageAuxGraph I.linkage).Adj auxD auxR)
    (hAU_new :
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj auxA auxU)
    (hUV_new :
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj auxU auxV)
    (hVD_new :
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj auxV auxD)
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hU_old : DegreeEquals (linkageAuxGraph I.linkage) auxU 2)
    (hV_old : DegreeEquals (linkageAuxGraph I.linkage) auxV 2)
    (hD_old : DegreeEquals (linkageAuxGraph I.linkage) auxD 2)
    (hA_new :
      DegreeEquals (linkageAuxGraph Cross.replacementLinkageConcrete) auxA 2)
    (hU_new :
      DegreeEquals (linkageAuxGraph Cross.replacementLinkageConcrete) auxU 2)
    (hV_new :
      DegreeEquals (linkageAuxGraph Cross.replacementLinkageConcrete) auxV 2)
    (hD_new :
      DegreeEquals (linkageAuxGraph Cross.replacementLinkageConcrete) auxD 2)
    (hL_not :
      auxL ∉ ({auxA, auxU, auxV, auxD} : Finset I.linkage.Index))
    (hR_not :
      auxR ∉ ({auxA, auxU, auxV, auxD} : Finset I.linkage.Index))
    (hLU : auxL ≠ auxU) (hRV : auxR ≠ auxV)
    (hAU_ne : auxA ≠ auxU) (hAD : auxA ≠ auxD)
    (hUD : auxU ≠ auxD) (hAV : auxA ≠ auxV)
    (hDV : auxD ≠ auxV) (hLD : auxL ≠ auxD) :
    AuxGraphsIsomorphic I.linkage Cross.replacementLinkageConcrete := by
  simpa [replacementLinkageConcrete, replacementLinkageOfDisjointUnchanged]
    using
      Cross.replacementLinkage_auxGraphsIsomorphic_of_supportedLocalDegreeTwo
        Cross.replacementPaths_nodeDisjoint
        (fun _ hileft hiright =>
          Cross.replacementPaths_left_nodeDisjoint_unchanged hileft hiright)
        (fun _ hileft hiright =>
          Cross.replacementPaths_right_nodeDisjoint_unchanged hileft hiright)
        auxL auxA auxU auxV auxD auxR
        (by
          simpa [replacementLinkageConcrete,
            replacementLinkageOfDisjointUnchanged] using hsupport)
        hLA_old hAU_old hUV_old hVD_old hDR_old
        (by
          simpa [replacementLinkageConcrete,
            replacementLinkageOfDisjointUnchanged] using hAU_new)
        (by
          simpa [replacementLinkageConcrete,
            replacementLinkageOfDisjointUnchanged] using hUV_new)
        (by
          simpa [replacementLinkageConcrete,
            replacementLinkageOfDisjointUnchanged] using hVD_new)
        hA_old hU_old hV_old hD_old
        (by
          simpa [replacementLinkageConcrete,
            replacementLinkageOfDisjointUnchanged] using hA_new)
        (by
          simpa [replacementLinkageConcrete,
            replacementLinkageOfDisjointUnchanged] using hU_new)
        (by
          simpa [replacementLinkageConcrete,
            replacementLinkageOfDisjointUnchanged] using hV_new)
        (by
          simpa [replacementLinkageConcrete,
            replacementLinkageOfDisjointUnchanged] using hD_new)
        hL_not hR_not hLU hRV hAU_ne hAD hUD hAV hDV hLD

end CrossWitness

/-- In the non-degree-drop branch of a cross action, the paper obtains a valid
successor iteration input and the maintained graph `H̃` loses an edge.

The deleted edge may come from either old middle interval
`P_j'[s₁,s₂]` or `P_{j+1}'[t₂,t₁]`. -/
structure CrossSuccessorCertificate {I : IterationInput R hpos Q0}
    (Cross : CrossWitness I) where
  replacement : CrossReplacementPaths Cross
  next : IterationInput R hpos Q0
  tilde_subset : next.tildeEdgeSet ⊆ I.tildeEdgeSet
  deleted_edge : Sym2 V
  deleted_edge_middle :
    deleted_edge ∈ Cross.deletedLeftMiddle.edgeSet ∨
      deleted_edge ∈ Cross.deletedRightMiddle.edgeSet
  deleted_edge_new : deleted_edge ∉ next.tildeEdgeSet

namespace CrossSuccessorCertificate

variable {I : IterationInput R hpos Q0} {Cross : CrossWitness I}

def of_missing_left_deleted_edge
    (replacement : CrossReplacementPaths Cross)
    (next : IterationInput R hpos Q0)
    (htilde_subset : next.tildeEdgeSet ⊆ I.tildeEdgeSet)
    (deleted_edge : Sym2 V)
    (hdeleted : deleted_edge ∈ Cross.deletedLeftMiddle.edgeSet)
    (hmissing : deleted_edge ∉ next.tildeEdgeSet) :
    CrossSuccessorCertificate Cross :=
  { replacement := replacement
    next := next
    tilde_subset := htilde_subset
    deleted_edge := deleted_edge
    deleted_edge_middle := Or.inl hdeleted
    deleted_edge_new := hmissing }

def of_missing_right_deleted_edge
    (replacement : CrossReplacementPaths Cross)
    (next : IterationInput R hpos Q0)
    (htilde_subset : next.tildeEdgeSet ⊆ I.tildeEdgeSet)
    (deleted_edge : Sym2 V)
    (hdeleted : deleted_edge ∈ Cross.deletedRightMiddle.edgeSet)
    (hmissing : deleted_edge ∉ next.tildeEdgeSet) :
    CrossSuccessorCertificate Cross :=
  { replacement := replacement
    next := next
    tilde_subset := htilde_subset
    deleted_edge := deleted_edge
    deleted_edge_middle := Or.inr hdeleted
    deleted_edge_new := hmissing }

theorem tilde_card_lt (C : CrossSuccessorCertificate Cross) :
    C.next.tildeEdgeSet.card < I.tildeEdgeSet.card := by
  rcases C.deleted_edge_middle with hleft | hright
  · exact Cross.tilde_card_lt_of_missing_deletedLeftMiddle_edge
      C.tilde_subset hleft C.deleted_edge_new
  · exact Cross.tilde_card_lt_of_missing_deletedRightMiddle_edge
      C.tilde_subset hright C.deleted_edge_new

end CrossSuccessorCertificate

namespace CrossWitness

variable {I : IterationInput R hpos Q0} (Cross : CrossWitness I)

/-- Package the concrete left-to-right cross successor as a successor
certificate once a deleted middle edge is known to be absent from the successor
maintained graph. -/
noncomputable def successorCertificateLeftRight_of_missing_deleted_edge
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathLeftRight)
    (deleted_edge : Sym2 V)
    (hdeleted :
      deleted_edge ∈ Cross.deletedLeftMiddle.edgeSet ∨
        deleted_edge ∈ Cross.deletedRightMiddle.edgeSet)
    (hmissing :
      deleted_edge ∉
        (Cross.successorInputLeftRight haux hq0).tildeEdgeSet) :
    CrossSuccessorCertificate Cross where
  replacement := Cross.replacementPaths
  next := Cross.successorInputLeftRight haux hq0
  tilde_subset := Cross.successorInputLeftRight_tilde_subset haux hq0
  deleted_edge := deleted_edge
  deleted_edge_middle := hdeleted
  deleted_edge_new := hmissing

/-- The left-to-right cross successor certificate preserves the explicit
linkage-support invariant. -/
theorem successorCertificateLeftRight_typeOneLinkageSupportInvariant
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathLeftRight)
    (hsupport : IterationInput.TypeOneLinkageSupportInvariant I)
    (deleted_edge : Sym2 V)
    (hdeleted :
      deleted_edge ∈ Cross.deletedLeftMiddle.edgeSet ∨
        deleted_edge ∈ Cross.deletedRightMiddle.edgeSet)
    (hmissing :
      deleted_edge ∉
        (Cross.successorInputLeftRight haux hq0).tildeEdgeSet) :
    IterationInput.TypeOneLinkageSupportInvariant
      (Cross.successorCertificateLeftRight_of_missing_deleted_edge haux hq0
        deleted_edge hdeleted hmissing).next :=
  Cross.successorInputLeftRight_typeOneLinkageSupportInvariant haux hq0
    hsupport

/-- The concrete left-to-right cross successor certificate preserves the row
invariant package. -/
noncomputable def successorCertificateLeftRight_iterationInvariants
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathLeftRight)
    (Inv : TypeOneIterationInvariants I)
    (deleted_edge : Sym2 V)
    (hdeleted :
      deleted_edge ∈ Cross.deletedLeftMiddle.edgeSet ∨
        deleted_edge ∈ Cross.deletedRightMiddle.edgeSet)
    (hmissing :
      deleted_edge ∉
        (Cross.successorInputLeftRight haux hq0).tildeEdgeSet) :
    TypeOneIterationInvariants
      (Cross.successorCertificateLeftRight_of_missing_deleted_edge haux hq0
        deleted_edge hdeleted hmissing).next :=
  Cross.successorInputLeftRight_iterationInvariants haux hq0 Inv

/-- The concrete left-to-right cross successor certificate preserves the full
invariant package when the nonterminating local analysis proves that auxiliary
adjacency is unchanged on the shared index type. -/
noncomputable def successorCertificateLeftRight_fullIterationInvariants
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathLeftRight)
    (Inv : TypeOneFullIterationInvariants I)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j)
    (deleted_edge : Sym2 V)
    (hdeleted :
      deleted_edge ∈ Cross.deletedLeftMiddle.edgeSet ∨
        deleted_edge ∈ Cross.deletedRightMiddle.edgeSet)
    (hmissing :
      deleted_edge ∉
        (Cross.successorInputLeftRight haux hq0).tildeEdgeSet) :
    TypeOneFullIterationInvariants
      (Cross.successorCertificateLeftRight_of_missing_deleted_edge haux hq0
        deleted_edge hdeleted hmissing).next where
  base :=
    Cross.successorCertificateLeftRight_iterationInvariants haux hq0
      Inv.base deleted_edge hdeleted hmissing
  active_aux := by
    change TypeOneActiveAuxiliaryInvariant
      (Cross.successorInputLeftRight haux hq0)
      (Cross.successorInputLeftRight_iterationInvariants haux hq0 Inv.base)
    exact Cross.successorInputLeftRight_activeAuxiliaryInvariant haux hq0
      Inv.base Inv.active_aux hadj_iff

/-- The concrete left-to-right cross successor certificate preserves the
extended full invariant package. -/
noncomputable def successorCertificateLeftRight_extendedFullIterationInvariants
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathLeftRight)
    (Inv : TypeOneExtendedFullIterationInvariants I)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j)
    (deleted_edge : Sym2 V)
    (hdeleted :
      deleted_edge ∈ Cross.deletedLeftMiddle.edgeSet ∨
        deleted_edge ∈ Cross.deletedRightMiddle.edgeSet)
    (hmissing :
      deleted_edge ∉
        (Cross.successorInputLeftRight haux hq0).tildeEdgeSet) :
    TypeOneExtendedFullIterationInvariants
      (Cross.successorCertificateLeftRight_of_missing_deleted_edge haux hq0
        deleted_edge hdeleted hmissing).next where
  full :=
    Cross.successorCertificateLeftRight_fullIterationInvariants haux hq0
      Inv.full hadj_iff deleted_edge hdeleted hmissing
  boundary := by
    change TypeOneBoundaryAuxiliaryInvariant
      (Cross.successorInputLeftRight haux hq0)
      (Cross.successorInputLeftRight_iterationInvariants haux hq0
        Inv.full.base)
    exact Cross.successorInputLeftRight_boundaryAuxiliaryInvariant haux hq0
      Inv hadj_iff

/-- Package the concrete switched-order cross successor as a successor
certificate once a deleted middle edge is known to be absent from the successor
maintained graph. -/
noncomputable def successorCertificateRightLeft_of_missing_deleted_edge
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
