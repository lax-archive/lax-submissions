/-- Invariant-aware loop conclusion with the terminal branch split exactly
into Claim B.2 and Claim B.3.  Everything before the terminal picture is
therefore discharged by the finite descent and action certificates; the only
remaining terminal assumptions are the two named claims from the paper. -/
theorem gridMinor_or_degree_drop_of_claimB2_B3
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (hstep :
      ∀ I : IterationInput R hpos Q0,
        TypeOneIterationInvariants I →
          ¬ NoBumpNoCross I → InvariantSimplifyingActionOutcome I)
    (hclaimB2 :
      ∀ I : IterationInput R hpos Q0,
        ∀ Inv : TypeOneIterationInvariants I,
          NoBumpNoCross I → ClaimB2TerminalGridAdjacencies I Inv)
    (hclaimB3 :
      ∀ I : IterationInput R hpos Q0,
        ∀ Inv : TypeOneIterationInvariants I,
          NoBumpNoCross I → ClaimB3ConnectedIntersections I Inv)
    (I₀ : IterationInput R hpos Q0)
    (Inv₀ : TypeOneIterationInvariants I₀) :
    ContainsGridMinor G h ∨
      ∃ L'' : PerfectPathPacking G A B,
        linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount L := by
  refine gridMinor_or_degree_drop_of_invariant_terminal_intersection_core
    hstep ?_ I₀ Inv₀
  intro I Inv hterm
  exact TerminalIntersectionCoreData.of_claimB2_B3 Inv
    (hclaimB2 I Inv hterm) (hclaimB3 I Inv hterm)

/-- Invariant-aware loop conclusion with the corrected explicitly ordered
versions of the terminal Claims B.2 and B.3. -/
theorem gridMinor_or_degree_drop_of_ordered_claimB2_B3
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (hstep :
      ∀ I : IterationInput R hpos Q0,
        TypeOneIterationInvariants I →
          ¬ NoBumpNoCross I → InvariantSimplifyingActionOutcome I)
    (hterminal :
      ∀ I : IterationInput R hpos Q0,
        ∀ Inv : TypeOneIterationInvariants I,
          NoBumpNoCross I →
            ∃ columns : TerminalColumnOrder Q0,
              ClaimB2OrderedTerminalGridAdjacencies I Inv columns ∧
                ClaimB3OrderedConnectedIntersections I Inv columns)
    (I₀ : IterationInput R hpos Q0)
    (Inv₀ : TypeOneIterationInvariants I₀) :
    ContainsGridMinor G h ∨
      ∃ L'' : PerfectPathPacking G A B,
        linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount L := by
  classical
  refine gridMinor_or_degree_drop_of_invariant_terminal_ordered_intersection_core
    hstep ?_ I₀ Inv₀
  intro I Inv hterm
  let H := hterminal I Inv hterm
  let columns : TerminalColumnOrder Q0 := Classical.choose H
  have hspec :
      ClaimB2OrderedTerminalGridAdjacencies I Inv columns ∧
        ClaimB3OrderedConnectedIntersections I Inv columns :=
    Classical.choose_spec H
  exact TerminalOrderedIntersectionCoreData.of_claimB2_B3 Inv columns
    hspec.1 hspec.2

/-- Boundary-aware full-invariant loop conclusion with the corrected
explicitly ordered versions of the terminal Claims B.2 and B.3. -/
theorem gridMinor_or_degree_drop_of_extended_ordered_claimB2_B3
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (hstep :
      ∀ I : IterationInput R hpos Q0,
        TypeOneExtendedFullIterationInvariants I →
          ¬ NoBumpNoCross I →
            ExtendedFullInvariantSimplifyingActionOutcome I)
    (hterminal :
      ∀ I : IterationInput R hpos Q0,
        ∀ Inv : TypeOneExtendedFullIterationInvariants I,
          NoBumpNoCross I →
            ∃ columns : TerminalColumnOrder Q0,
              ClaimB2OrderedTerminalGridAdjacencies I Inv.full.base columns ∧
                ClaimB3OrderedConnectedIntersections I Inv.full.base columns)
    (I₀ : IterationInput R hpos Q0)
    (Inv₀ : TypeOneExtendedFullIterationInvariants I₀) :
    ContainsGridMinor G h ∨
      ∃ L'' : PerfectPathPacking G A B,
        linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount L := by
  classical
  refine gridMinor_or_degree_drop_of_extended_full_invariant_terminal_ordered_intersection_core
    hstep ?_ I₀ Inv₀
  intro I Inv hterm
  let H := hterminal I Inv hterm
  let columns : TerminalColumnOrder Q0 := Classical.choose H
  have hspec :
      ClaimB2OrderedTerminalGridAdjacencies I Inv.full.base columns ∧
        ClaimB3OrderedConnectedIntersections I Inv.full.base columns :=
    Classical.choose_spec H
  exact TerminalOrderedIntersectionCoreData.of_claimB2_B3 Inv.full.base columns
    hspec.1 hspec.2

