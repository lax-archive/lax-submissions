/-- Ordered Figure 8 update using local endpoint outside-neighbor data.

This wrapper extracts the old local quadruple from the maintained extended
row path.  Both successor orders are rebuilt from the finite Figure 8 local
dichotomy and the replacement-row contact facts. -/
noncomputable def paperActionUpdate_of_orderedLocalDegreeTest_constructedSuccessor_byLeftLocalRightAttachments
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hendpoint :
      ∀ auxA auxD : I.linkage.Index,
        EndpointOutsideNeighborData Inv Cross auxA auxD)
    (hleftReplacementHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.leftPath)
    (hrightReplacementHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.rightPath) :
    CrossPaperActionUpdate Inv Cross := by
  classical
  rcases Cross.old_rows_forward_or_backward Inv with hforward | hbackward
  · let D :=
      TypeOneExtendedFutureCleanIterationInvariants.crossForwardLocalQuadData
        (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
        Inv Cross hforward
    let O := hendpoint D.auxA D.auxD
    exact
      Cross.paperActionUpdate_of_localDegreeTest_constructedSuccessor_byLeftLocalRightAttachments
        Inv O.auxL D.auxA D.auxD O.auxR O.left_adj_auxL
        D.hAU_old D.hUV_old D.hVD_old O.right_adj_auxR D.hA_old
        D.hU_old D.hV_old D.hD_old O.auxL_not O.auxR_not
        O.auxL_ne_leftRow O.auxR_ne_rightRow D.hAU_old.1 D.hAD
        D.hUD D.hAV D.hVD_old.1.symm O.auxL_ne_auxD
        hleftReplacementHit hrightReplacementHit
  · let D :=
      TypeOneExtendedFutureCleanIterationInvariants.crossBackwardLocalQuadData
        (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
        Inv Cross hbackward
    let O := hendpoint D.auxA D.auxD
    exact
      Cross.paperActionUpdate_of_localDegreeTest_constructedSuccessor_byLeftLocalRightAttachments
        Inv O.auxL D.auxA D.auxD O.auxR O.left_adj_auxL
        D.hAU_old D.hUV_old D.hVD_old O.right_adj_auxR D.hA_old
        D.hU_old D.hV_old D.hD_old O.auxL_not O.auxR_not
        O.auxL_ne_leftRow O.auxR_ne_rightRow D.hAU_old.1 D.hAD
        D.hUD D.hAV D.hVD_old.1.symm O.auxL_ne_auxD
        hleftReplacementHit hrightReplacementHit

/-- Ordered Figure 8 update with endpoint data only for the actual local
quadruple selected by the row order.

This is the Lean version of the paper's "possibly switching them" clause:
after deciding whether the crossed rows occur in the forward or backward order,
the proof only needs the outside neighbors of the two corresponding local
endpoints. -/
noncomputable def paperActionUpdate_of_orderedLocalDegreeTest_constructedSuccessor_byActualEndpointData
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hforwardEndpoint :
      ∀ hforward :
        (Inv.base.orderedRows.order Cross.rowLeft).1 + 1 =
          (Inv.base.orderedRows.order Cross.rowRight).1,
        let D :=
          TypeOneExtendedFutureCleanIterationInvariants.crossForwardLocalQuadData
            (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
            Inv Cross hforward
        EndpointOutsideNeighborData Inv Cross D.auxA D.auxD)
    (hbackwardEndpoint :
      ∀ hbackward :
        (Inv.base.orderedRows.order Cross.rowRight).1 + 1 =
          (Inv.base.orderedRows.order Cross.rowLeft).1,
        let D :=
          TypeOneExtendedFutureCleanIterationInvariants.crossBackwardLocalQuadData
            (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
            Inv Cross hbackward
        EndpointOutsideNeighborData Inv Cross D.auxA D.auxD)
    (hleftReplacementHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.leftPath)
    (hrightReplacementHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.rightPath) :
    CrossPaperActionUpdate Inv Cross := by
  classical
  rcases Cross.old_rows_forward_or_backward Inv with hforward | hbackward
  · let D :=
      TypeOneExtendedFutureCleanIterationInvariants.crossForwardLocalQuadData
        (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
        Inv Cross hforward
    let O : EndpointOutsideNeighborData Inv Cross D.auxA D.auxD :=
      hforwardEndpoint hforward
    exact
      Cross.paperActionUpdate_of_localDegreeTest_constructedSuccessor_byLeftLocalRightAttachments
        Inv O.auxL D.auxA D.auxD O.auxR O.left_adj_auxL
        D.hAU_old D.hUV_old D.hVD_old O.right_adj_auxR D.hA_old
        D.hU_old D.hV_old D.hD_old O.auxL_not O.auxR_not
        O.auxL_ne_leftRow O.auxR_ne_rightRow D.hAU_old.1 D.hAD
        D.hUD D.hAV D.hVD_old.1.symm O.auxL_ne_auxD
        hleftReplacementHit hrightReplacementHit
  · let D :=
      TypeOneExtendedFutureCleanIterationInvariants.crossBackwardLocalQuadData
        (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
        Inv Cross hbackward
    let O : EndpointOutsideNeighborData Inv Cross D.auxA D.auxD :=
      hbackwardEndpoint hbackward
    exact
      Cross.paperActionUpdate_of_localDegreeTest_constructedSuccessor_byLeftLocalRightAttachments
        Inv O.auxL D.auxA D.auxD O.auxR O.left_adj_auxL
        D.hAU_old D.hUV_old D.hVD_old O.right_adj_auxR D.hA_old
        D.hU_old D.hV_old D.hD_old O.auxL_not O.auxR_not
        O.auxL_ne_leftRow O.auxR_ne_rightRow D.hAU_old.1 D.hAD
        D.hUD D.hAV D.hVD_old.1.symm O.auxL_ne_auxD
        hleftReplacementHit hrightReplacementHit

/-- Figure 8 paper update from the fully packaged local outside-neighbor data. -/
noncomputable def paperActionUpdate_of_localOutsideData_hitsReplacements
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (D : CrossLocalOutsideData Inv Cross)
    (hleftReplacementHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.leftPath)
    (hrightReplacementHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.rightPath) :
    CrossPaperActionUpdate Inv Cross :=
  Cross.paperActionUpdate_of_localDegreeTest_constructedSuccessor_byLeftLocalRightAttachments
    Inv D.auxL D.auxA D.auxD D.auxR D.hLA_old D.hAU_old D.hUV_old
    D.hVD_old D.hDR_old D.hA_old D.hU_old D.hV_old D.hD_old
    D.hL_not D.hR_not D.hLU D.hRV D.hAU_ne D.hAD D.hUD D.hAV
    D.hDV D.hLD hleftReplacementHit hrightReplacementHit

/-- Figure 8 paper update from packaged local outside-neighbor data and
branch-specific bare successor traces. -/
noncomputable def paperActionUpdate_of_localOutsideData_traces
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (D : CrossLocalOutsideData Inv Cross)
    (htraceLeftRight :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        Nonempty
          (TypeOneBareExtendedRowContactTrace
            (h := h) I.Row Inv.base.orderedRows.order
            Cross.successorRowPathLeftRight (Q0.data i hi).qstar))
    (htraceRightLeft :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        Nonempty
          (TypeOneBareExtendedRowContactTrace
            (h := h) I.Row Inv.base.orderedRows.order
            Cross.successorRowPathRightLeft (Q0.data i hi).qstar)) :
    CrossPaperActionUpdate Inv Cross :=
  Cross.paperActionUpdate_of_localDegreeTest_constructedSuccessor_byLeftLocalRightAttachments_traces
    Inv D.auxL D.auxA D.auxD D.auxR D.hLA_old D.hAU_old D.hUV_old
    D.hVD_old D.hDR_old D.hA_old D.hU_old D.hV_old D.hD_old
    D.hL_not D.hR_not D.hLU D.hRV D.hAU_ne D.hAD D.hUD D.hAV
    D.hDV D.hLD htraceLeftRight htraceRightLeft

end CrossWitness

namespace CrossActionCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {Inv : TypeOneExtendedFutureCleanIterationInvariants I}
variable {Cross : CrossWitness I}

/-- Upgrade an ordinary cross action certificate to the paper-level Figure 8
update, once every possible nonterminating successor is known to preserve the
extended future-clean invariant.

The cross certificate may choose either successor order for the two replacement
rows.  The invariant proof is correspondingly indexed by the concrete
successor certificate rather than by a fixed local order. -/
def paperActionUpdate
    (C : CrossActionCertificate Cross)
    (hsuccInv :
      ∀ S : CrossSuccessorCertificate Cross,
        TypeOneExtendedFutureCleanIterationInvariants S.next) :
    CrossPaperActionUpdate Inv Cross where
  degree_drop_or_successor := by
    rcases C.degree_drop with hdrop | hsucc
    · exact Or.inl hdrop
    · rcases hsucc with ⟨S⟩
      exact Or.inr
        ⟨{ successor := S
           invariant := hsuccInv S }⟩

end CrossActionCertificate

/-- Assemble the nonterminal step of the loop from the paper-level Figure 7 and
Figure 8 update packages. -/
theorem extendedFutureCleanSimplifyingActionOutcome_of_paper_updates
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (hbump :
      ∀ {I : IterationInput R hpos Q0}
        (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
        (Bump : BumpWitness I),
          BumpPaperActionUpdate Inv Bump)
    (hcross :
      ∀ {I : IterationInput R hpos Q0}
        (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
        (Cross : CrossWitness I),
          CrossPaperActionUpdate Inv Cross)
    (I : IterationInput R hpos Q0)
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hnot_terminal : ¬ NoBumpNoCross I) :
    ExtendedFutureCleanSimplifyingActionOutcome I := by
  classical
  by_cases hb : HasBump I
  · rcases hb with ⟨B⟩
    exact (hbump Inv B).extendedFutureCleanSimplifyingActionOutcome
  · by_cases hc : HasCross I
    · rcases hc with ⟨C⟩
      exact (hcross Inv C).extendedFutureCleanSimplifyingActionOutcome
    · exact False.elim (hnot_terminal ⟨hb, hc⟩)

/-- Assemble the nonterminal step from the older local action certificates plus
the paper-level successor invariant update.

This is the practical version of the expanded proof: the local bump/cross
paragraphs still provide the ordinary action certificates, and the separate
successor-invariant lemmas prove that fixed `Q₀` contacts, outside avoidance,
and future-cleanliness survive in the nonterminating branch. -/
theorem extendedFutureCleanSimplifyingActionOutcome_of_action_certificates
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (hbump :
      ∀ {I : IterationInput R hpos Q0} (Bump : BumpWitness I),
        BumpActionCertificate Bump)
    (hcross :
      ∀ {I : IterationInput R hpos Q0} (Cross : CrossWitness I),
        CrossActionCertificate Cross)
    (hbump_next_inv :
      ∀ {I : IterationInput R hpos Q0}
        (_Inv : TypeOneExtendedFutureCleanIterationInvariants I)
        (Bump : BumpWitness I)
        (S : BumpSuccessorCertificate Bump),
          TypeOneExtendedFutureCleanIterationInvariants S.next)
    (hcross_next_inv :
      ∀ {I : IterationInput R hpos Q0}
        (_Inv : TypeOneExtendedFutureCleanIterationInvariants I)
        (Cross : CrossWitness I)
        (S : CrossSuccessorCertificate Cross),
          TypeOneExtendedFutureCleanIterationInvariants S.next)
    (I : IterationInput R hpos Q0)
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hnot_terminal : ¬ NoBumpNoCross I) :
    ExtendedFutureCleanSimplifyingActionOutcome I := by
  exact extendedFutureCleanSimplifyingActionOutcome_of_paper_updates
    (hbump := fun {I} Inv' Bump =>
      (hbump Bump).paperActionUpdate
        (fun S => hbump_next_inv Inv' Bump S))
    (hcross := fun {I} Inv' Cross =>
      (hcross Cross).paperActionUpdate
        (fun S => hcross_next_inv Inv' Cross S))
    I Inv hnot_terminal

/-- The same paper-level updates, forgetting future-cleanliness in the output,
recover the older boundary-aware extended action outcome. -/
theorem extendedFullInvariantSimplifyingActionOutcome_of_paper_updates
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (hbump :
      ∀ {I : IterationInput R hpos Q0}
        (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
        (Bump : BumpWitness I),
          BumpPaperActionUpdate Inv Bump)
    (hcross :
      ∀ {I : IterationInput R hpos Q0}
        (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
        (Cross : CrossWitness I),
          CrossPaperActionUpdate Inv Cross)
    (I : IterationInput R hpos Q0)
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hnot_terminal : ¬ NoBumpNoCross I) :
    ExtendedFullInvariantSimplifyingActionOutcome I := by
  classical
  by_cases hb : HasBump I
  · rcases hb with ⟨B⟩
    exact (hbump Inv B).extendedFullInvariantSimplifyingActionOutcome
  · by_cases hc : HasCross I
    · rcases hc with ⟨C⟩
      exact (hcross Inv C).extendedFullInvariantSimplifyingActionOutcome
    · exact False.elim (hnot_terminal ⟨hb, hc⟩)

/-- Loop conclusion using the paper-level invariant-preserving bump/cross
updates.  The terminal proof receives both the extended auxiliary invariant and
the future-clean segment invariant. -/
theorem gridMinor_or_degree_drop_of_extended_future_clean_actions
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (hstep :
      ∀ I : IterationInput R hpos Q0,
        TypeOneExtendedFutureCleanIterationInvariants I →
          ¬ NoBumpNoCross I →
            ExtendedFutureCleanSimplifyingActionOutcome I)
    (hterminal :
      ∀ I : IterationInput R hpos Q0,
        TypeOneExtendedFutureCleanIterationInvariants I → NoBumpNoCross I →
          ContainsGridMinor G h)
    (I₀ : IterationInput R hpos Q0)
    (Inv₀ : TypeOneExtendedFutureCleanIterationInvariants I₀) :
    ContainsGridMinor G h ∨
      ∃ L'' : PerfectPathPacking G A B,
        linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount L := by
  rcases
    exists_terminal_or_degree_drop_of_extended_future_clean_actions
      (Terminal := NoBumpNoCross) hstep I₀ Inv₀ with
    ⟨I, InvNE, hterm | hdrop⟩
  · rcases InvNE with ⟨Inv⟩
    exact Or.inl (hterminal I Inv hterm)
  · rcases hdrop with ⟨L'', hlt⟩
    exact Or.inr ⟨L'', by
      rw [I.aux_iso_fixed_outside.degreeTwoCount_eq]
      exact hlt⟩

/-- Loop conclusion directly from the paper-level Figure 7/Figure 8 updates. -/
theorem gridMinor_or_degree_drop_of_paper_updates
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (hbump :
      ∀ {I : IterationInput R hpos Q0}
        (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
        (Bump : BumpWitness I),
          BumpPaperActionUpdate Inv Bump)
    (hcross :
      ∀ {I : IterationInput R hpos Q0}
        (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
        (Cross : CrossWitness I),
          CrossPaperActionUpdate Inv Cross)
    (hterminal :
      ∀ I : IterationInput R hpos Q0,
        TypeOneExtendedFutureCleanIterationInvariants I → NoBumpNoCross I →
          ContainsGridMinor G h)
    (I₀ : IterationInput R hpos Q0)
    (Inv₀ : TypeOneExtendedFutureCleanIterationInvariants I₀) :
    ContainsGridMinor G h ∨
      ∃ L'' : PerfectPathPacking G A B,
        linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount L :=
  gridMinor_or_degree_drop_of_extended_future_clean_actions
    (fun I Inv hnot =>
      extendedFutureCleanSimplifyingActionOutcome_of_paper_updates
        hbump hcross I Inv hnot)
    hterminal I₀ Inv₀

/-- Loop conclusion from ordinary bump/cross action certificates plus the
successor proof of the expanded paper invariant.

This is the interface closest to the local proof organization: prove the
Figure 7/Figure 8 action certificates, prove the generic no-skip/future-clean
successor invariant for every nonterminating successor, and the finite
`H̃`-descent loop follows. -/
theorem gridMinor_or_degree_drop_of_action_certificates_with_extended_future_clean
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (hbump :
      ∀ {I : IterationInput R hpos Q0} (Bump : BumpWitness I),
        BumpActionCertificate Bump)
    (hcross :
      ∀ {I : IterationInput R hpos Q0} (Cross : CrossWitness I),
        CrossActionCertificate Cross)
    (hbump_next_inv :
      ∀ {I : IterationInput R hpos Q0}
        (_Inv : TypeOneExtendedFutureCleanIterationInvariants I)
        (Bump : BumpWitness I)
        (S : BumpSuccessorCertificate Bump),
          TypeOneExtendedFutureCleanIterationInvariants S.next)
    (hcross_next_inv :
      ∀ {I : IterationInput R hpos Q0}
        (_Inv : TypeOneExtendedFutureCleanIterationInvariants I)
        (Cross : CrossWitness I)
        (S : CrossSuccessorCertificate Cross),
          TypeOneExtendedFutureCleanIterationInvariants S.next)
    (hterminal :
      ∀ I : IterationInput R hpos Q0,
        TypeOneExtendedFutureCleanIterationInvariants I → NoBumpNoCross I →
          ContainsGridMinor G h)
    (I₀ : IterationInput R hpos Q0)
    (Inv₀ : TypeOneExtendedFutureCleanIterationInvariants I₀) :
    ContainsGridMinor G h ∨
      ∃ L'' : PerfectPathPacking G A B,
        linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount L :=
  gridMinor_or_degree_drop_of_extended_future_clean_actions
    (fun I Inv hnot =>
      extendedFutureCleanSimplifyingActionOutcome_of_action_certificates
        hbump hcross hbump_next_inv hcross_next_inv I Inv hnot)
    hterminal I₀ Inv₀

/-- Construct all raw row-contact traces from the concrete contact lists,
provided each consecutive contact segment is full-linkage-clean.  The
unit-step and same-row-subset parts come from the Claim B.2 strip
certificate. -/
noncomputable def claimB3RowContactTraceOfLinkageClean
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (S : ClaimB2PlanarStripCertificate I inv)
    (hclean : ClaimB3AllConsecutiveContactSegmentsLinkageClean I inv) :
    ∀ j : Fin h, ClaimB3RowContactTrace I inv j := by
  intro j
  exact
    (ClaimB3ConsecutiveContactAtomization.ofList
      (I := I) (inv := inv) (j := j) (hclean j)).toRowContactTrace S

namespace ClaimB3RowContactTrace

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}
variable {j : Fin h}

/-- Consecutive contacts in a complete row-contact trace either stay on the
same current row or move between consecutive current rows.  This is the
row-trace unit-step fact used in the maximal-hill argument. -/
theorem row_eq_or_consecutive_of_succ
    (T : ClaimB3RowContactTrace I inv j)
    (r : Fin T.len) :
    T.row ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self T.len)⟩ =
        T.row ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩ ∨
      FinConsecutive
        (T.row ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self T.len)⟩)
        (T.row ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩) := by
  exact T.consecutive_row_step r

/-- The row-number trace of a complete row-contact trace is a unit-step natural
trace. -/
theorem unitStepNatTrace
    (T : ClaimB3RowContactTrace I inv j) :
    UnitStepNatTrace T.len (fun r : Fin (T.len + 1) => (T.row r).1) := by
  intro r
  let cur : Fin (T.len + 1) :=
    ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self T.len)⟩
  let nxt : Fin (T.len + 1) :=
    ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩
  have hstep := T.row_eq_or_consecutive_of_succ r
  change T.row cur = T.row nxt ∨ FinConsecutive (T.row cur) (T.row nxt) at hstep
  change (T.row nxt).1 ≤ (T.row cur).1 + 1 ∧
    (T.row cur).1 ≤ (T.row nxt).1 + 1
  rcases hstep with hsame | hcon
  · have hval : (T.row cur).1 = (T.row nxt).1 := congrArg Fin.val hsame
    constructor <;> omega
  · rcases hcon with hsucc | hpred
    · constructor <;> omega
    · constructor <;> omega

/-- If two consecutive row contacts lie on the same row, then their column
segment is contained in that row in a no-bump terminal strip certificate. -/
theorem segment_subset_row_of_same_row_succ
    (T : ClaimB3RowContactTrace I inv j)
    (r : Fin T.len)
    (hsame :
      T.row ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self T.len)⟩ =
        T.row ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩) :
    ((claimB3ColumnPath I inv j).segmentOfBefore
      ((T.contact_before_iff_le
        ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self T.len)⟩
        ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩).2
          (Nat.le_succ r.1))).vertexSet ⊆
      (claimB3RowPath I inv
        (T.row ⟨r.1, Nat.lt_trans r.2
          (Nat.lt_succ_self T.len)⟩)).vertexSet :=
  T.same_row_segment_subset r hsame

/-- Edge-set version of `segment_subset_row_of_same_row_succ`: a same-row
successive-contact column segment is a genuine subpath of the row path. -/
theorem segment_edgeSet_subset_row_of_same_row_succ
    (T : ClaimB3RowContactTrace I inv j)
    (r : Fin T.len)
    (hsame :
      T.row ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self T.len)⟩ =
        T.row ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩) :
    ((claimB3ColumnPath I inv j).segmentOfBefore
      ((T.contact_before_iff_le
        ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self T.len)⟩
        ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩).2
          (Nat.le_succ r.1))).edgeSet ⊆
      (claimB3RowPath I inv
        (T.row ⟨r.1, Nat.lt_trans r.2
          (Nat.lt_succ_self T.len)⟩)).edgeSet :=
  T.same_row_segment_edgeSet_subset r hsame

/-- A same-row consecutive blocker segment contains every row vertex lying
between its two endpoint contacts.  This is the row-path uniqueness fact used
in Claim B.3's maximal blocker interval: once a blocker follows row edges
between two contacts, it cannot jump over one of the hill interval endpoints. -/
theorem mem_column_of_same_row_succ_between_row_contacts
    (T : ClaimB3RowContactTrace I inv j)
    (r : Fin T.len)
    (hsame :
      T.row ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self T.len)⟩ =
        T.row ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩)
    {x : V}
    (hxrow :
      x ∈ (claimB3RowPath I inv
        (T.row ⟨r.1, Nat.lt_trans r.2
          (Nat.lt_succ_self T.len)⟩)).vertexSet)
    (hbetween :
      ((claimB3RowPath I inv
          (T.row ⟨r.1, Nat.lt_trans r.2
            (Nat.lt_succ_self T.len)⟩)).vertexIndex
            (T.contact ⟨r.1, Nat.lt_trans r.2
              (Nat.lt_succ_self T.len)⟩) ≤
          (claimB3RowPath I inv
            (T.row ⟨r.1, Nat.lt_trans r.2
              (Nat.lt_succ_self T.len)⟩)).vertexIndex x ∧
        (claimB3RowPath I inv
          (T.row ⟨r.1, Nat.lt_trans r.2
            (Nat.lt_succ_self T.len)⟩)).vertexIndex x ≤
          (claimB3RowPath I inv
            (T.row ⟨r.1, Nat.lt_trans r.2
              (Nat.lt_succ_self T.len)⟩)).vertexIndex
            (T.contact ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩)) ∨
        ((claimB3RowPath I inv
          (T.row ⟨r.1, Nat.lt_trans r.2
            (Nat.lt_succ_self T.len)⟩)).vertexIndex
            (T.contact ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩) ≤
          (claimB3RowPath I inv
            (T.row ⟨r.1, Nat.lt_trans r.2
              (Nat.lt_succ_self T.len)⟩)).vertexIndex x ∧
        (claimB3RowPath I inv
          (T.row ⟨r.1, Nat.lt_trans r.2
            (Nat.lt_succ_self T.len)⟩)).vertexIndex x ≤
          (claimB3RowPath I inv
            (T.row ⟨r.1, Nat.lt_trans r.2
              (Nat.lt_succ_self T.len)⟩)).vertexIndex
            (T.contact ⟨r.1, Nat.lt_trans r.2
              (Nat.lt_succ_self T.len)⟩))) :
    x ∈ (claimB3ColumnPath I inv j).vertexSet := by
  classical
  let cur : Fin (T.len + 1) :=
    ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self T.len)⟩
  let nxt : Fin (T.len + 1) :=
    ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩
  let Row : GraphPath G := claimB3RowPath I inv (T.row cur)
  let Seg : GraphPath G :=
    (claimB3ColumnPath I inv j).segmentOfBefore
      ((T.contact_before_iff_le cur nxt).2 (by simp [cur, nxt]))
  have hSegV : Seg.vertexSet ⊆ Row.vertexSet := by
    simpa [Seg, Row, cur, nxt] using
      T.segment_subset_row_of_same_row_succ r hsame
  have hSegE : Seg.edgeSet ⊆ Row.edgeSet := by
    simpa [Seg, Row, cur, nxt] using
      T.segment_edgeSet_subset_row_of_same_row_succ r hsame
  have hxSeg : x ∈ Seg.vertexSet := by
    exact GraphPath.mem_of_vertexIndex_between_endpoints_of_edgeSet_subset
      Row Seg hSegV hSegE (by simpa [Row, cur] using hxrow)
      (by simpa [Row, Seg, cur, nxt] using hbetween)
  exact (claimB3ColumnPath I inv j).segmentOfBefore_vertexSet_subset
    ((T.contact_before_iff_le cur nxt).2 (by simp [cur, nxt])) (by
      simpa [Seg] using hxSeg)

/-- A different selected column cannot have one of its vertices between the
endpoints of a same-row blocker atom. -/
theorem not_other_column_vertex_between_same_row_succ
    (T : ClaimB3RowContactTrace I inv j)
    (r : Fin T.len)
    (hsame :
      T.row ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self T.len)⟩ =
        T.row ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩)
    {k : Fin h} (hjk : j ≠ k)
    {x : V}
    (hxrow :
      x ∈ (claimB3RowPath I inv
        (T.row ⟨r.1, Nat.lt_trans r.2
          (Nat.lt_succ_self T.len)⟩)).vertexSet)
    (hxcol : x ∈ (claimB3ColumnPath I inv k).vertexSet)
    (hbetween :
      ((claimB3RowPath I inv
          (T.row ⟨r.1, Nat.lt_trans r.2
            (Nat.lt_succ_self T.len)⟩)).vertexIndex
            (T.contact ⟨r.1, Nat.lt_trans r.2
              (Nat.lt_succ_self T.len)⟩) ≤
          (claimB3RowPath I inv
            (T.row ⟨r.1, Nat.lt_trans r.2
              (Nat.lt_succ_self T.len)⟩)).vertexIndex x ∧
        (claimB3RowPath I inv
          (T.row ⟨r.1, Nat.lt_trans r.2
            (Nat.lt_succ_self T.len)⟩)).vertexIndex x ≤
          (claimB3RowPath I inv
            (T.row ⟨r.1, Nat.lt_trans r.2
              (Nat.lt_succ_self T.len)⟩)).vertexIndex
            (T.contact ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩)) ∨
        ((claimB3RowPath I inv
          (T.row ⟨r.1, Nat.lt_trans r.2
            (Nat.lt_succ_self T.len)⟩)).vertexIndex
            (T.contact ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩) ≤
          (claimB3RowPath I inv
            (T.row ⟨r.1, Nat.lt_trans r.2
              (Nat.lt_succ_self T.len)⟩)).vertexIndex x ∧
        (claimB3RowPath I inv
          (T.row ⟨r.1, Nat.lt_trans r.2
            (Nat.lt_succ_self T.len)⟩)).vertexIndex x ≤
          (claimB3RowPath I inv
            (T.row ⟨r.1, Nat.lt_trans r.2
              (Nat.lt_succ_self T.len)⟩)).vertexIndex
            (T.contact ⟨r.1, Nat.lt_trans r.2
              (Nat.lt_succ_self T.len)⟩))) :
    False := by
  classical
  have hxj :
      x ∈ (claimB3ColumnPath I inv j).vertexSet :=
    T.mem_column_of_same_row_succ_between_row_contacts r hsame hxrow hbetween
  exact Finset.disjoint_left.mp
    (claimB3ColumnPath_vertexSet_disjoint_of_ne (I := I) (inv := inv) hjk)
    hxj hxcol

/-- A raw same-row interval of the row-contact trace contains every row
vertex lying between its endpoint contacts.  This is the uncompressed version
of the blocker-block ownership fact: if all row contacts between `p` and `q`
lie on `row`, then the selected column follows the row between those endpoint
contacts. -/
theorem mem_column_of_same_row_trace_interval_between_contacts
    (T : ClaimB3RowContactTrace I inv j)
    {row : Fin (z h)} {p q : Fin (T.len + 1)}
    (hpq : p.1 ≤ q.1)
    (hrows :
      ∀ r : Fin (T.len + 1), p.1 ≤ r.1 → r.1 ≤ q.1 →
        T.row r = row)
    {x : V}
    (hxrow : x ∈ (claimB3RowPath I inv row).vertexSet)
    (hbetween :
      ((claimB3RowPath I inv row).vertexIndex (T.contact p) ≤
          (claimB3RowPath I inv row).vertexIndex x ∧
        (claimB3RowPath I inv row).vertexIndex x ≤
          (claimB3RowPath I inv row).vertexIndex (T.contact q)) ∨
      ((claimB3RowPath I inv row).vertexIndex (T.contact q) ≤
          (claimB3RowPath I inv row).vertexIndex x ∧
        (claimB3RowPath I inv row).vertexIndex x ≤
          (claimB3RowPath I inv row).vertexIndex (T.contact p))) :
    x ∈ (claimB3ColumnPath I inv j).vertexSet := by
  classical
  let Row : GraphPath G := claimB3RowPath I inv row
  by_cases hpq_eq : p.1 = q.1
  · have hp_eq_q : p = q := Fin.ext hpq_eq
    have hp_mem_row : T.contact p ∈ Row.vertexSet := by
      have hrow_p : T.row p = row := hrows p le_rfl hpq
      simpa [Row, hrow_p] using T.contact_mem_row p
    have hx_eq : x = T.contact p := by
      have hidx : Row.vertexIndex x = Row.vertexIndex (T.contact p) := by
        rcases hbetween with h | h
        · have hx_le_p : Row.vertexIndex x ≤ Row.vertexIndex (T.contact p) := by
            simpa [Row, hp_eq_q] using h.2
          have hp_le_x : Row.vertexIndex (T.contact p) ≤ Row.vertexIndex x := by
            simpa [Row] using h.1
          exact le_antisymm hx_le_p hp_le_x
        · have hp_le_x : Row.vertexIndex (T.contact p) ≤ Row.vertexIndex x := by
            simpa [Row, hp_eq_q] using h.1
          have hx_le_p : Row.vertexIndex x ≤ Row.vertexIndex (T.contact p) := by
            simpa [Row] using h.2
          exact le_antisymm hx_le_p hp_le_x
      have hx_before :
          Row.Before x (T.contact p) :=
        (Row.before_iff_vertexIndex_le).2 ⟨hxrow, hp_mem_row, by omega⟩
      have hp_before :
          Row.Before (T.contact p) x :=
        (Row.before_iff_vertexIndex_le).2 ⟨hp_mem_row, hxrow, by omega⟩
      exact Row.before_antisymm hx_before hp_before
    simpa [hx_eq] using T.contact_mem_column p
  · have hp_lt_q : p.1 < q.1 := Nat.lt_of_le_of_ne hpq hpq_eq
    rcases exists_adjacent_straddle
        (n := T.len)
        (c := Row.vertexIndex x)
        (f := fun r : Fin (T.len + 1) => Row.vertexIndex (T.contact r))
        hp_lt_q
        (by simpa [Row] using hbetween) with
      ⟨s, hp_s, hs_q, hpair⟩
    let cur : Fin (T.len + 1) :=
      ⟨s.1, Nat.lt_trans s.2 (Nat.lt_succ_self T.len)⟩
    let nxt : Fin (T.len + 1) :=
      ⟨s.1 + 1, Nat.succ_lt_succ s.2⟩
    have hcur_row : T.row cur = row :=
      hrows cur (by simpa [cur] using hp_s) (by
        simp [cur]
        omega)
    have hnxt_row : T.row nxt = row :=
      hrows nxt (by
        simp [nxt]
        omega) (by simpa [nxt] using hs_q)
    have hsame : T.row cur = T.row nxt := hcur_row.trans hnxt_row.symm
    have hxrow_cur :
        x ∈ (claimB3RowPath I inv (T.row cur)).vertexSet := by
      simpa [hcur_row] using hxrow
    have hbetween_cur :
        ((claimB3RowPath I inv (T.row cur)).vertexIndex (T.contact cur) ≤
            (claimB3RowPath I inv (T.row cur)).vertexIndex x ∧
          (claimB3RowPath I inv (T.row cur)).vertexIndex x ≤
            (claimB3RowPath I inv (T.row cur)).vertexIndex
              (T.contact nxt)) ∨
        ((claimB3RowPath I inv (T.row cur)).vertexIndex (T.contact nxt) ≤
            (claimB3RowPath I inv (T.row cur)).vertexIndex x ∧
          (claimB3RowPath I inv (T.row cur)).vertexIndex x ≤
            (claimB3RowPath I inv (T.row cur)).vertexIndex
              (T.contact cur)) := by
      simpa [Row, cur, nxt, hcur_row] using hpair
    exact T.mem_column_of_same_row_succ_between_row_contacts s
      (by simpa [cur, nxt] using hsame) hxrow_cur hbetween_cur

/-- Row-segment version of
`mem_column_of_same_row_trace_interval_between_contacts`. -/
theorem rowSegment_between_same_row_trace_interval_subset_column
    (T : ClaimB3RowContactTrace I inv j)
    {row : Fin (z h)} {p q : Fin (T.len + 1)}
    (hpq : p.1 ≤ q.1)
    (hrows :
      ∀ r : Fin (T.len + 1), p.1 ≤ r.1 → r.1 ≤ q.1 →
        T.row r = row)
    (hbefore :
      (claimB3RowPath I inv row).Before (T.contact p) (T.contact q)) :
    ((claimB3RowPath I inv row).segmentOfBefore hbefore).vertexSet ⊆
      (claimB3ColumnPath I inv j).vertexSet := by
  classical
  intro x hxseg
  let Row : GraphPath G := claimB3RowPath I inv row
  have hxrow : x ∈ Row.vertexSet :=
    Row.segmentOfBefore_vertexSet_subset hbefore hxseg
  have hleft : Row.Before (T.contact p) x :=
    Row.before_of_mem_segmentOfBefore_left hbefore hxseg
  have hright : Row.Before x (T.contact q) :=
    Row.before_of_mem_segmentOfBefore_right hbefore hxseg
  have hbetween :
      ((claimB3RowPath I inv row).vertexIndex (T.contact p) ≤
          (claimB3RowPath I inv row).vertexIndex x ∧
        (claimB3RowPath I inv row).vertexIndex x ≤
          (claimB3RowPath I inv row).vertexIndex (T.contact q)) ∨
      ((claimB3RowPath I inv row).vertexIndex (T.contact q) ≤
          (claimB3RowPath I inv row).vertexIndex x ∧
        (claimB3RowPath I inv row).vertexIndex x ≤
          (claimB3RowPath I inv row).vertexIndex (T.contact p)) := by
    left
    exact ⟨((Row.before_iff_vertexIndex_le).1 hleft).2.2,
      ((Row.before_iff_vertexIndex_le).1 hright).2.2⟩
  exact T.mem_column_of_same_row_trace_interval_between_contacts hpq hrows
    (by simpa [Row] using hxrow) hbetween

/-- `Q₀`-data version of
`rowSegment_between_same_row_trace_interval_subset_column`. -/
theorem rowSegment_between_same_row_trace_interval_subset_qstar
    (T : ClaimB3RowContactTrace I inv j)
    {row : Fin (z h)} {p q : Fin (T.len + 1)}
    (hpq : p.1 ≤ q.1)
    (hrows :
      ∀ r : Fin (T.len + 1), p.1 ≤ r.1 → r.1 ≤ q.1 →
        T.row r = row)
    (hbefore :
      (claimB3RowPath I inv row).Before (T.contact p) (T.contact q)) :
    ((claimB3RowPath I inv row).segmentOfBefore hbefore).vertexSet ⊆
      (Q0.data (Q0.selectedColumn j)
        (Q0.selectedColumn_mem_indices j)).qstar.vertexSet := by
  simpa [claimB3ColumnPath, TypeOneQStarFamily.selectedData] using
    T.rowSegment_between_same_row_trace_interval_subset_column hpq hrows hbefore

/-- Reverse-orientation version of
`rowSegment_between_same_row_trace_interval_subset_column`.  The raw trace
indices still run from `p` to `q`; the row segment is consumed in the opposite
row orientation. -/
theorem rowSegment_between_same_row_trace_interval_subset_column_rev
    (T : ClaimB3RowContactTrace I inv j)
    {row : Fin (z h)} {p q : Fin (T.len + 1)}
    (hpq : p.1 ≤ q.1)
    (hrows :
      ∀ r : Fin (T.len + 1), p.1 ≤ r.1 → r.1 ≤ q.1 →
        T.row r = row)
    (hbefore :
      (claimB3RowPath I inv row).Before (T.contact q) (T.contact p)) :
    ((claimB3RowPath I inv row).segmentOfBefore hbefore).vertexSet ⊆
      (claimB3ColumnPath I inv j).vertexSet := by
  classical
  intro x hxseg
  have hxrow :
      x ∈ (claimB3RowPath I inv row).vertexSet :=
    (claimB3RowPath I inv row).segmentOfBefore_vertexSet_subset hbefore hxseg
  have hleft :
      (claimB3RowPath I inv row).Before (T.contact q) x :=
    (claimB3RowPath I inv row).before_of_mem_segmentOfBefore_left
      hbefore hxseg
  have hright :
      (claimB3RowPath I inv row).Before x (T.contact p) :=
    (claimB3RowPath I inv row).before_of_mem_segmentOfBefore_right
      hbefore hxseg
  have hbetween :
      ((claimB3RowPath I inv row).vertexIndex (T.contact p) ≤
          (claimB3RowPath I inv row).vertexIndex x ∧
        (claimB3RowPath I inv row).vertexIndex x ≤
          (claimB3RowPath I inv row).vertexIndex (T.contact q)) ∨
      ((claimB3RowPath I inv row).vertexIndex (T.contact q) ≤
          (claimB3RowPath I inv row).vertexIndex x ∧
        (claimB3RowPath I inv row).vertexIndex x ≤
          (claimB3RowPath I inv row).vertexIndex (T.contact p)) := by
    right
    exact ⟨((claimB3RowPath I inv row).before_iff_vertexIndex_le).1 hleft |>.2.2,
      ((claimB3RowPath I inv row).before_iff_vertexIndex_le).1 hright |>.2.2⟩
  exact T.mem_column_of_same_row_trace_interval_between_contacts hpq hrows
    hxrow hbetween

/-- `Q₀`-data version of
`rowSegment_between_same_row_trace_interval_subset_column_rev`. -/
theorem rowSegment_between_same_row_trace_interval_subset_qstar_rev
    (T : ClaimB3RowContactTrace I inv j)
    {row : Fin (z h)} {p q : Fin (T.len + 1)}
    (hpq : p.1 ≤ q.1)
    (hrows :
      ∀ r : Fin (T.len + 1), p.1 ≤ r.1 → r.1 ≤ q.1 →
        T.row r = row)
    (hbefore :
      (claimB3RowPath I inv row).Before (T.contact q) (T.contact p)) :
    ((claimB3RowPath I inv row).segmentOfBefore hbefore).vertexSet ⊆
      (Q0.data (Q0.selectedColumn j)
        (Q0.selectedColumn_mem_indices j)).qstar.vertexSet := by
  simpa [claimB3ColumnPath, TypeOneQStarFamily.selectedData] using
    T.rowSegment_between_same_row_trace_interval_subset_column_rev
      hpq hrows hbefore

/-- Three consecutive contacts forming a one-step down-and-back pattern in
the row trace.  This is the local-valley object from the proof of Claim B.3. -/
structure LocalValley (T : ClaimB3RowContactTrace I inv j) where
  left : Fin (T.len + 1)
  mid : Fin (T.len + 1)
  right : Fin (T.len + 1)
  left_succ : left.1 + 1 = mid.1
  mid_succ : mid.1 + 1 = right.1
  rowTop : Fin (z h)
  rowLower : Fin (z h)
  left_row : T.row left = rowTop
  mid_row : T.row mid = rowLower
  right_row : T.row right = rowTop
  lower_succ : rowLower.1 + 1 = rowTop.1

namespace LocalValley

variable {T : ClaimB3RowContactTrace I inv j}

/-- A local valley in the complete row-contact trace gives the concrete hill
candidate used in Claim B.3.  This is the formal version of the paper's
“choose the local pattern `i,i-1,i`” step. -/
noncomputable def toHillCandidateData
    (Vly : T.LocalValley) :
    ClaimB3HillCandidateData I inv := by
  classical
  have hleft_mid_eq : Vly.left.1 + 1 = Vly.mid.1 := Vly.left_succ
  have hmid_right_eq : Vly.mid.1 + 1 = Vly.right.1 := Vly.mid_succ
  have hleft_le_right : Vly.left.1 ≤ Vly.right.1 := by
    omega
  have hleft_before_right_col :
      (claimB3ColumnPath I inv j).Before
        (T.contact Vly.left) (T.contact Vly.right) :=
    (T.contact_before_iff_le Vly.left Vly.right).2 hleft_le_right
  let Seg : GraphPath G :=
    (claimB3ColumnPath I inv j).segmentOfBefore hleft_before_right_col
  have hleft_mem_top :
      T.contact Vly.left ∈ (claimB3RowPath I inv Vly.rowTop).vertexSet := by
    simpa [Vly.left_row] using T.contact_mem_row Vly.left
  have hright_mem_top :
      T.contact Vly.right ∈ (claimB3RowPath I inv Vly.rowTop).vertexSet := by
    simpa [Vly.right_row] using T.contact_mem_row Vly.right
  have hrow_order :
      (claimB3RowPath I inv Vly.rowTop).Before
          (T.contact Vly.left) (T.contact Vly.right) ∨
        (claimB3RowPath I inv Vly.rowTop).Before
          (T.contact Vly.right) (T.contact Vly.left) :=
    ClaimB2Atom.graphPath_before_or_before_of_mem
      (claimB3RowPath I inv Vly.rowTop) hleft_mem_top hright_mem_top
  have hseg_subset :
      Seg.vertexSet ⊆ (claimB3ColumnPath I inv j).vertexSet := by
    intro v hv
    exact (claimB3ColumnPath I inv j).segmentOfBefore_vertexSet_subset
      hleft_before_right_col hv
  have hseg_edge_subset :
      Seg.edgeSet ⊆ (claimB3ColumnPath I inv j).edgeSet := by
    intro e he
    exact (claimB3ColumnPath I inv j).segmentOfBefore_edgeSet_subset
      hleft_before_right_col he
  have hseg_hits_lower : HitsGraphPath Seg (claimB3RowPath I inv Vly.rowLower) := by
    have hleft_le_mid : Vly.left.1 ≤ Vly.mid.1 := by omega
    have hmid_le_right : Vly.mid.1 ≤ Vly.right.1 := by omega
    have hleft_before_mid :
        (claimB3ColumnPath I inv j).Before
          (T.contact Vly.left) (T.contact Vly.mid) :=
      (T.contact_before_iff_le Vly.left Vly.mid).2 hleft_le_mid
    have hmid_before_right :
        (claimB3ColumnPath I inv j).Before
          (T.contact Vly.mid) (T.contact Vly.right) :=
      (T.contact_before_iff_le Vly.mid Vly.right).2 hmid_le_right
    refine ⟨T.contact Vly.mid, Finset.mem_inter.2 ⟨?_, ?_⟩⟩
    · exact (claimB3ColumnPath I inv j).mem_segmentOfBefore_of_before_of_before
        hleft_before_right_col hleft_before_mid hmid_before_right
    · simpa [Vly.mid_row] using T.contact_mem_row Vly.mid
  have hseg_clean_other :
      Seg.InternallyDisjointFromSet
        (Finset.univ.biUnion fun r : Fin (z h) =>
          if r = Vly.rowLower then ∅ else (claimB3RowPath I inv r).vertexSet) := by
    intro v hvseg hvrows
    rw [Finset.mem_biUnion] at hvrows
    rcases hvrows with ⟨k, _hk, hvk⟩
    by_cases hk_lower : k = Vly.rowLower
    · simp [hk_lower] at hvk
    have hvk_row : v ∈ (claimB3RowPath I inv k).vertexSet := by
      simpa [hk_lower] using hvk
    have hvcol :
        v ∈ (claimB3ColumnPath I inv j).vertexSet :=
      (claimB3ColumnPath I inv j).segmentOfBefore_vertexSet_subset
        hleft_before_right_col hvseg
    have hvrowUnion : v ∈ I.rowVertexSet :=
      claimB3RowPath_vertexSet_subset_rowVertexSet (I := I) (inv := inv) k
        hvk_row
    rcases T.contact_complete hvcol hvrowUnion with ⟨r, hr⟩
    have hleft_before_v :
        (claimB3ColumnPath I inv j).Before (T.contact Vly.left) v :=
      (claimB3ColumnPath I inv j).before_of_mem_segmentOfBefore_left
        hleft_before_right_col hvseg
    have hv_before_right :
        (claimB3ColumnPath I inv j).Before v (T.contact Vly.right) :=
      (claimB3ColumnPath I inv j).before_of_mem_segmentOfBefore_right
        hleft_before_right_col hvseg
    have hleft_le_r : Vly.left.1 ≤ r.1 := by
      have hbefore :
          (claimB3ColumnPath I inv j).Before
            (T.contact Vly.left) (T.contact r) := by
        simpa [hr] using hleft_before_v
      exact (T.contact_before_iff_le Vly.left r).1 hbefore
    have hr_le_right : r.1 ≤ Vly.right.1 := by
      have hbefore :
          (claimB3ColumnPath I inv j).Before
            (T.contact r) (T.contact Vly.right) := by
        simpa [hr] using hv_before_right
      exact (T.contact_before_iff_le r Vly.right).1 hbefore
    have hrow_r : k = T.row r := T.contact_row_unique r k (by simpa [hr] using hvk_row)
    have hcases :
        r.1 = Vly.left.1 ∨ r.1 = Vly.mid.1 ∨ r.1 = Vly.right.1 := by
      omega
    rcases hcases with hrl | hrm | hrr
    · left
      have hr_eq_left : r = Vly.left := Fin.ext hrl
      simpa [hr_eq_left] using hr.symm
    · have hr_eq_mid : r = Vly.mid := Fin.ext hrm
      have hk_eq_lower : k = Vly.rowLower := by
        calc
          k = T.row r := hrow_r
          _ = T.row Vly.mid := by rw [hr_eq_mid]
          _ = Vly.rowLower := Vly.mid_row
      exact False.elim (hk_lower hk_eq_lower)
    · right
      have hr_eq_right : r = Vly.right := Fin.ext hrr
      simpa [hr_eq_right] using hr.symm
  by_cases hrow_left_right :
      (claimB3RowPath I inv Vly.rowTop).Before
        (T.contact Vly.left) (T.contact Vly.right)
  · refine {
      row := Vly.rowTop
      col := j
      lower := Vly.rowLower
      lower_succ := Vly.lower_succ
      left := T.contact Vly.left
      right := T.contact Vly.right
      left_mem_row := hleft_mem_top
      right_mem_row := hright_mem_top
      left_before_right := hrow_left_right
      segment := Seg
      segment_connects := ?_
      segment_subset_column := hseg_subset
      segment_edgeSet_subset_column := hseg_edge_subset
      hits_lower := hseg_hits_lower
      internally_disjoint_from_other_rows := hseg_clean_other
    }
    exact Or.inl ⟨by simp [Seg], by simp [Seg]⟩
  · have hrow_right_left :
        (claimB3RowPath I inv Vly.rowTop).Before
          (T.contact Vly.right) (T.contact Vly.left) := by
      rcases hrow_order with h | h
      · exact False.elim (hrow_left_right h)
      · exact h
    refine {
      row := Vly.rowTop
      col := j
      lower := Vly.rowLower
      lower_succ := Vly.lower_succ
      left := T.contact Vly.right
      right := T.contact Vly.left
      left_mem_row := hright_mem_top
      right_mem_row := hleft_mem_top
      left_before_right := hrow_right_left
      segment := Seg
      segment_connects := ?_
      segment_subset_column := hseg_subset
      segment_edgeSet_subset_column := hseg_edge_subset
      hits_lower := hseg_hits_lower
      internally_disjoint_from_other_rows := hseg_clean_other
    }
    exact Or.inr ⟨by simp [Seg], by simp [Seg]⟩

end LocalValley

/-- A hill interval in a complete row-contact trace.  Unlike `LocalValley`,
this object does not require the three relevant row contacts to be consecutive
in the raw contact list.  This matches the paper's compressed row-index trace:
between the two top-row contacts all row contacts are on the immediately lower
row, except for the two top endpoints themselves. -/
structure HillValley (T : ClaimB3RowContactTrace I inv j) where
  left : Fin (T.len + 1)
  right : Fin (T.len + 1)
  rowTop : Fin (z h)
  rowLower : Fin (z h)
  left_lt_right : left.1 < right.1
  left_row : T.row left = rowTop
  right_row : T.row right = rowTop
  lower_succ : rowLower.1 + 1 = rowTop.1
  hit_lower :
    ∃ mid : Fin (T.len + 1),
      left.1 ≤ mid.1 ∧ mid.1 ≤ right.1 ∧ T.row mid = rowLower
  contacts_only_lower_or_endpoints :
    ∀ r : Fin (T.len + 1),
      left.1 ≤ r.1 → r.1 ≤ right.1 →
        T.row r ≠ rowLower → r = left ∨ r = right

namespace HillValley

variable {T : ClaimB3RowContactTrace I inv j}

theorem top_ne_lower (Vly : T.HillValley) :
    Vly.rowTop ≠ Vly.rowLower := by
  intro h
  have hsucc := Vly.lower_succ
  rw [h] at hsucc
  omega

theorem left_succ_lt_len (Vly : T.HillValley) :
    Vly.left.1 < T.len := by
  have hlt : Vly.left.1 < Vly.right.1 := Vly.left_lt_right
  have hright_lt : Vly.right.1 < T.len + 1 := Vly.right.2
  omega

theorem right_pos (Vly : T.HillValley) :
    0 < Vly.right.1 := by
  have hlt : Vly.left.1 < Vly.right.1 := Vly.left_lt_right
  omega

theorem hit_lower_strict
    (Vly : T.HillValley) :
    ∃ mid : Fin (T.len + 1),
      Vly.left.1 < mid.1 ∧ mid.1 < Vly.right.1 ∧
        T.row mid = Vly.rowLower := by
  rcases Vly.hit_lower with ⟨mid, hleft, hright, hmid⟩
  have hmid_ne_left : mid ≠ Vly.left := by
    intro hEq
    exact Vly.top_ne_lower (by
      calc
        Vly.rowTop = T.row Vly.left := Vly.left_row.symm
        _ = T.row mid := by rw [hEq]
        _ = Vly.rowLower := hmid)
  have hmid_ne_right : mid ≠ Vly.right := by
    intro hEq
    exact Vly.top_ne_lower (by
      calc
        Vly.rowTop = T.row Vly.right := Vly.right_row.symm
        _ = T.row mid := by rw [hEq]
        _ = Vly.rowLower := hmid)
  exact ⟨mid, by omega, by omega, hmid⟩

theorem left_succ_le_right_pred
    (Vly : T.HillValley) :
    Vly.left.1 + 1 ≤ Vly.right.1 - 1 := by
  rcases Vly.hit_lower_strict with ⟨mid, hleft, hright, _⟩
  omega

theorem left_succ_row (Vly : T.HillValley) :
    T.row ⟨Vly.left.1 + 1, by
      have h := Vly.left_succ_lt_len
      omega⟩ = Vly.rowLower := by
  classical
  have hle : Vly.left.1 ≤ Vly.left.1 + 1 := by omega
  have hright : Vly.left.1 + 1 ≤ Vly.right.1 := by
    rcases Vly.hit_lower_strict with ⟨mid, hleft, hright_mid, _⟩
    omega
  by_contra hnot
  rcases Vly.contacts_only_lower_or_endpoints
      ⟨Vly.left.1 + 1, by
        have h := Vly.left_succ_lt_len
        omega⟩ hle hright hnot with hEq | hEq
  · have hval : Vly.left.1 + 1 = Vly.left.1 := by
      simpa using congrArg Fin.val hEq
    omega
  · have hval : Vly.left.1 + 1 = Vly.right.1 := by
      simpa using congrArg Fin.val hEq
    rcases Vly.hit_lower_strict with ⟨mid, hleft, hright_mid, _⟩
    omega

theorem right_pred_row (Vly : T.HillValley) :
    T.row ⟨Vly.right.1 - 1, by
      have h := Vly.right.2
      omega⟩ = Vly.rowLower := by
  classical
  have hleft : Vly.left.1 ≤ Vly.right.1 - 1 := by
    have h := Vly.left_succ_le_right_pred
    omega
  have hright : Vly.right.1 - 1 ≤ Vly.right.1 := by omega
  by_contra hnot
  rcases Vly.contacts_only_lower_or_endpoints
      ⟨Vly.right.1 - 1, by
        have h := Vly.right.2
        omega⟩ hleft hright hnot with hEq | hEq
  · have hval : Vly.right.1 - 1 = Vly.left.1 := by
      simpa using congrArg Fin.val hEq
    rcases Vly.hit_lower_strict with ⟨mid, hleft_mid, hright_mid, _⟩
    omega
  · have hval : Vly.right.1 - 1 = Vly.right.1 := by
      simpa using congrArg Fin.val hEq
    have hpos := Vly.right_pos
    omega

theorem row_eq_lower_of_internal
    (Vly : T.HillValley)
    (r : Fin (T.len + 1))
    (hleft : Vly.left.1 + 1 ≤ r.1)
    (hright : r.1 ≤ Vly.right.1 - 1) :
    T.row r = Vly.rowLower := by
  classical
  by_contra hnot
  have hleft' : Vly.left.1 ≤ r.1 := by omega
  have hright' : r.1 ≤ Vly.right.1 := by omega
  rcases Vly.contacts_only_lower_or_endpoints r hleft' hright' hnot with hEq | hEq
  · have hval := congrArg Fin.val hEq
    omega
  · have hval := congrArg Fin.val hEq
    omega

/-- A three-consecutive-contact local valley is a special case of a compressed
hill interval. -/
def ofLocalValley (Vly : T.LocalValley) : T.HillValley where
  left := Vly.left
  right := Vly.right
  rowTop := Vly.rowTop
  rowLower := Vly.rowLower
  left_lt_right := by
    have h₁ := Vly.left_succ
    have h₂ := Vly.mid_succ
    omega
  left_row := Vly.left_row
  right_row := Vly.right_row
  lower_succ := Vly.lower_succ
  hit_lower := by
    have h₁ := Vly.left_succ
    have h₂ := Vly.mid_succ
    refine ⟨Vly.mid, ?_, ?_, Vly.mid_row⟩ <;> omega
  contacts_only_lower_or_endpoints := by
    intro r hleft hright hnot_lower
    have hcases :
        r.1 = Vly.left.1 ∨ r.1 = Vly.mid.1 ∨ r.1 = Vly.right.1 := by
      have hleft_mid := Vly.left_succ
      have hmid_right := Vly.mid_succ
      omega
    rcases hcases with hr | hr | hr
    · left
      exact Fin.ext hr
    · have hr_eq_mid : r = Vly.mid := Fin.ext hr
      exact False.elim (hnot_lower (by simpa [hr_eq_mid] using Vly.mid_row))
    · right
      exact Fin.ext hr

/-- A compressed-trace hill interval gives the concrete hill candidate used in
Claim B.3.  This is the raw-contact-list version of the paper's local valley
step: the selected column segment runs from one top-row contact to the next,
hits the immediately lower row, and has no internal contacts with any other
row. -/
noncomputable def toHillCandidateData
    (Vly : T.HillValley) :
    ClaimB3HillCandidateData I inv := by
  classical
  have hleft_le_right : Vly.left.1 ≤ Vly.right.1 :=
    Nat.le_of_lt Vly.left_lt_right
  have hleft_before_right_col :
      (claimB3ColumnPath I inv j).Before
        (T.contact Vly.left) (T.contact Vly.right) :=
    (T.contact_before_iff_le Vly.left Vly.right).2 hleft_le_right
  let Seg : GraphPath G :=
    (claimB3ColumnPath I inv j).segmentOfBefore hleft_before_right_col
  have hleft_mem_top :
      T.contact Vly.left ∈ (claimB3RowPath I inv Vly.rowTop).vertexSet := by
    simpa [Vly.left_row] using T.contact_mem_row Vly.left
  have hright_mem_top :
      T.contact Vly.right ∈ (claimB3RowPath I inv Vly.rowTop).vertexSet := by
    simpa [Vly.right_row] using T.contact_mem_row Vly.right
  have hrow_order :
      (claimB3RowPath I inv Vly.rowTop).Before
          (T.contact Vly.left) (T.contact Vly.right) ∨
        (claimB3RowPath I inv Vly.rowTop).Before
          (T.contact Vly.right) (T.contact Vly.left) :=
    ClaimB2Atom.graphPath_before_or_before_of_mem
      (claimB3RowPath I inv Vly.rowTop) hleft_mem_top hright_mem_top
  have hseg_subset :
      Seg.vertexSet ⊆ (claimB3ColumnPath I inv j).vertexSet := by
    intro v hv
    exact (claimB3ColumnPath I inv j).segmentOfBefore_vertexSet_subset
      hleft_before_right_col hv
  have hseg_edge_subset :
      Seg.edgeSet ⊆ (claimB3ColumnPath I inv j).edgeSet := by
    intro e he
    exact (claimB3ColumnPath I inv j).segmentOfBefore_edgeSet_subset
      hleft_before_right_col he
  have hseg_hits_lower : HitsGraphPath Seg (claimB3RowPath I inv Vly.rowLower) := by
    rcases Vly.hit_lower with ⟨mid, hleft_mid, hmid_right, hmid_row⟩
    have hleft_before_mid :
        (claimB3ColumnPath I inv j).Before
          (T.contact Vly.left) (T.contact mid) :=
      (T.contact_before_iff_le Vly.left mid).2 hleft_mid
    have hmid_before_right :
        (claimB3ColumnPath I inv j).Before
          (T.contact mid) (T.contact Vly.right) :=
      (T.contact_before_iff_le mid Vly.right).2 hmid_right
    refine ⟨T.contact mid, Finset.mem_inter.2 ⟨?_, ?_⟩⟩
    · exact (claimB3ColumnPath I inv j).mem_segmentOfBefore_of_before_of_before
        hleft_before_right_col hleft_before_mid hmid_before_right
    · simpa [hmid_row] using T.contact_mem_row mid
  have hseg_clean_other :
      Seg.InternallyDisjointFromSet
        (Finset.univ.biUnion fun r : Fin (z h) =>
          if r = Vly.rowLower then ∅ else (claimB3RowPath I inv r).vertexSet) := by
    intro v hvseg hvrows
    rw [Finset.mem_biUnion] at hvrows
    rcases hvrows with ⟨k, _hk, hvk⟩
    by_cases hk_lower : k = Vly.rowLower
    · simp [hk_lower] at hvk
    have hvk_row : v ∈ (claimB3RowPath I inv k).vertexSet := by
      simpa [hk_lower] using hvk
    have hvcol :
        v ∈ (claimB3ColumnPath I inv j).vertexSet :=
      (claimB3ColumnPath I inv j).segmentOfBefore_vertexSet_subset
        hleft_before_right_col hvseg
    have hvrowUnion : v ∈ I.rowVertexSet :=
      claimB3RowPath_vertexSet_subset_rowVertexSet (I := I) (inv := inv) k
        hvk_row
    rcases T.contact_complete hvcol hvrowUnion with ⟨r, hr⟩
    have hleft_before_v :
        (claimB3ColumnPath I inv j).Before (T.contact Vly.left) v :=
      (claimB3ColumnPath I inv j).before_of_mem_segmentOfBefore_left
        hleft_before_right_col hvseg
    have hv_before_right :
        (claimB3ColumnPath I inv j).Before v (T.contact Vly.right) :=
      (claimB3ColumnPath I inv j).before_of_mem_segmentOfBefore_right
        hleft_before_right_col hvseg
    have hleft_le_r : Vly.left.1 ≤ r.1 := by
      have hbefore :
          (claimB3ColumnPath I inv j).Before
            (T.contact Vly.left) (T.contact r) := by
        simpa [hr] using hleft_before_v
      exact (T.contact_before_iff_le Vly.left r).1 hbefore
    have hr_le_right : r.1 ≤ Vly.right.1 := by
      have hbefore :
          (claimB3ColumnPath I inv j).Before
            (T.contact r) (T.contact Vly.right) := by
        simpa [hr] using hv_before_right
      exact (T.contact_before_iff_le r Vly.right).1 hbefore
    have hrow_r : k = T.row r := T.contact_row_unique r k (by simpa [hr] using hvk_row)
    have hr_not_lower : T.row r ≠ Vly.rowLower := by
      intro hr_lower
      exact hk_lower (by
        calc
          k = T.row r := hrow_r
          _ = Vly.rowLower := hr_lower)
    rcases Vly.contacts_only_lower_or_endpoints r hleft_le_r hr_le_right
        hr_not_lower with hr_left | hr_right
    · left
      simpa [hr_left] using hr.symm
    · right
      simpa [hr_right] using hr.symm
  by_cases hrow_left_right :
      (claimB3RowPath I inv Vly.rowTop).Before
        (T.contact Vly.left) (T.contact Vly.right)
  · refine {
      row := Vly.rowTop
      col := j
      lower := Vly.rowLower
      lower_succ := Vly.lower_succ
      left := T.contact Vly.left
      right := T.contact Vly.right
      left_mem_row := hleft_mem_top
      right_mem_row := hright_mem_top
      left_before_right := hrow_left_right
      segment := Seg
      segment_connects := ?_
      segment_subset_column := hseg_subset
      segment_edgeSet_subset_column := hseg_edge_subset
      hits_lower := hseg_hits_lower
      internally_disjoint_from_other_rows := hseg_clean_other
    }
    exact Or.inl ⟨by simp [Seg], by simp [Seg]⟩
  · have hrow_right_left :
        (claimB3RowPath I inv Vly.rowTop).Before
          (T.contact Vly.right) (T.contact Vly.left) := by
      rcases hrow_order with h | h
      · exact False.elim (hrow_left_right h)
      · exact h
    refine {
      row := Vly.rowTop
      col := j
      lower := Vly.rowLower
      lower_succ := Vly.lower_succ
      left := T.contact Vly.right
      right := T.contact Vly.left
      left_mem_row := hright_mem_top
      right_mem_row := hleft_mem_top
      left_before_right := hrow_right_left
      segment := Seg
      segment_connects := ?_
      segment_subset_column := hseg_subset
      segment_edgeSet_subset_column := hseg_edge_subset
      hits_lower := hseg_hits_lower
      internally_disjoint_from_other_rows := hseg_clean_other
    }
    exact Or.inr ⟨by simp [Seg], by simp [Seg]⟩

@[simp] theorem toHillCandidateData_row
    (Vly : T.HillValley) :
    Vly.toHillCandidateData.row = Vly.rowTop := by
  dsimp [toHillCandidateData]
  split <;> rfl

@[simp] theorem toHillCandidateData_col
    (Vly : T.HillValley) :
    Vly.toHillCandidateData.col = j := by
  dsimp [toHillCandidateData]
  split <;> rfl

@[simp] theorem toHillCandidateData_lower
    (Vly : T.HillValley) :
    Vly.toHillCandidateData.lower = Vly.rowLower := by
  dsimp [toHillCandidateData]
  split <;> rfl

theorem toHillCandidateData_left_of_before
    (Vly : T.HillValley)
    (h :
      (claimB3RowPath I inv Vly.rowTop).Before
        (T.contact Vly.left) (T.contact Vly.right)) :
    Vly.toHillCandidateData.left = T.contact Vly.left := by
  dsimp [toHillCandidateData]
  simp [h]

theorem toHillCandidateData_right_of_before
    (Vly : T.HillValley)
    (h :
      (claimB3RowPath I inv Vly.rowTop).Before
        (T.contact Vly.left) (T.contact Vly.right)) :
    Vly.toHillCandidateData.right = T.contact Vly.right := by
  dsimp [toHillCandidateData]
  simp [h]

theorem toHillCandidateData_left_of_not_before
    (Vly : T.HillValley)
    (h :
      ¬ (claimB3RowPath I inv Vly.rowTop).Before
        (T.contact Vly.left) (T.contact Vly.right)) :
    Vly.toHillCandidateData.left = T.contact Vly.right := by
  dsimp [toHillCandidateData]
  simp [h]

theorem toHillCandidateData_right_of_not_before
    (Vly : T.HillValley)
    (h :
      ¬ (claimB3RowPath I inv Vly.rowTop).Before
        (T.contact Vly.left) (T.contact Vly.right)) :
    Vly.toHillCandidateData.right = T.contact Vly.left := by
  dsimp [toHillCandidateData]
  simp [h]

end HillValley

/-- A blocker-column hill interval whose lower row is the original hill row
is exactly the endpoint data needed for the blocker-barrier step.

This is the trace-level form of the last sentence in Claim B.3's barrier
argument: once the blocker is known to enter and leave the row interval from
the row immediately above, the corresponding blocker subpath is the next hill
candidate. -/
noncomputable def HillValley.toHigherHillFromBlockerData
    {T : ClaimB3RowContactTrace I inv j}
    {C : ClaimB3HillCandidateData I inv}
    (Vly : HillValley T)
    (hrowLower : Vly.rowLower = C.row) :
    ClaimB3HigherHillFromBlockerData inv C j := by
  classical
  let H : ClaimB3HillCandidateData I inv := Vly.toHillCandidateData
  have hH_col : H.col = j := by
    dsimp [H, ClaimB3RowContactTrace.HillValley.toHillCandidateData]
    split <;> rfl
  have hH_lower : H.lower = C.row := by
    dsimp [H, ClaimB3RowContactTrace.HillValley.toHillCandidateData]
    split <;> simp [hrowLower]
  refine {
    upper := H.row
    upper_succ := ?_
    left := H.left
    right := H.right
    left_mem_upper := H.left_mem_row
    right_mem_upper := H.right_mem_row
    left_before_right := H.left_before_right
    segment := H.segment
    segment_connects := H.segment_connects
    segment_subset_column := by
      simpa [hH_col] using H.segment_subset_column
    segment_edgeSet_subset_column := by
      simpa [hH_col] using H.segment_edgeSet_subset_column
    hits_lower := ?_
    internally_disjoint_from_other_rows := ?_
  }
  · simpa [hH_lower] using H.lower_succ
  · simpa [hH_lower] using H.hits_lower
  · simpa [hH_lower] using H.internally_disjoint_from_other_rows

/-- A compressed block decomposition of a row-contact trace.  Each block is a
maximal run of raw row contacts on one row, encoded by its first and last raw
indices.  Adjacent blocks are consecutive in the raw trace, and the sequence
of block rows moves by exact unit steps. -/
structure CompressedRowBlocks (T : ClaimB3RowContactTrace I inv j) where
  len : ℕ
  first : Fin (len + 1) → Fin (T.len + 1)
  last : Fin (len + 1) → Fin (T.len + 1)
  first_zero : (first ⟨0, by omega⟩).1 = 0
  last_eq_trace_len : (last ⟨len, by omega⟩).1 = T.len
  first_le_last : ∀ k, (first k).1 ≤ (last k).1
  blockRow : Fin (len + 1) → Fin (z h)
  row_eq_block :
    ∀ k : Fin (len + 1), ∀ r : Fin (T.len + 1),
      (first k).1 ≤ r.1 → r.1 ≤ (last k).1 → T.row r = blockRow k
  next :
    ∀ k : Fin len,
      (last ⟨k.1, by omega⟩).1 + 1 =
        (first ⟨k.1 + 1, by omega⟩).1
  exact_step :
    ExactUnitStepNatTrace len (fun k : Fin (len + 1) => (blockRow k).1)
  first_max :
    ∀ k : Fin (len + 1), (blockRow k).1 ≤ (blockRow ⟨0, by omega⟩).1

/-- Bracketing data for vertices between row contacts.  If a column vertex
lies between two row contacts but is not itself a row contact, then it lies
between two consecutive row contacts.  This is the finite support-list fact
needed to turn strict compressed descent into row-trace convexity. -/
structure BetweenContactBracketCertificate
    (T : ClaimB3RowContactTrace I inv j) where
  bracket_of_noncontact_between :
    ∀ {p q : Fin (T.len + 1)} {v : V},
      p.1 ≤ q.1 →
      (claimB3ColumnPath I inv j).Before (T.contact p) v →
      (claimB3ColumnPath I inv j).Before v (T.contact q) →
      v ∉ I.rowVertexSet →
        ∃ r : Fin T.len,
          p.1 ≤ r.1 ∧ r.1 + 1 ≤ q.1 ∧
            (claimB3ColumnPath I inv j).Before
              (T.contact ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self T.len)⟩) v ∧
            (claimB3ColumnPath I inv j).Before v
              (T.contact ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩)

/-- If the row-contact trace has already been compressed so that consecutive
contacts are never on the same row, then each raw contact is its own compressed
block. -/
def compressedRowBlocksOfNoStutter
    (T : ClaimB3RowContactTrace I inv j)
    (hno_stutter :
      ∀ r : Fin T.len,
        T.row ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self T.len)⟩ ≠
          T.row ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩)
    (hfirst_max :
      ∀ k : Fin (T.len + 1),
        (T.row k).1 ≤ (T.row ⟨0, by omega⟩).1) :
    T.CompressedRowBlocks where
  len := T.len
  first k := k
  last k := k
  first_zero := by simp
  last_eq_trace_len := by simp
  first_le_last := by intro k; rfl
  blockRow k := T.row k
  row_eq_block := by
    intro k r hkr hrk
    have hr_eq : r = k := Fin.ext (Nat.le_antisymm hrk hkr)
    simp [hr_eq]
  next := by
    intro k
    simp
  exact_step := by
    intro r
    let cur : Fin (T.len + 1) :=
      ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self T.len)⟩
    let nxt : Fin (T.len + 1) :=
      ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩
    have hstep := T.consecutive_row_step r
    change T.row cur = T.row nxt ∨ FinConsecutive (T.row cur) (T.row nxt)
      at hstep
    rcases hstep with hsame | hcon
    · exact False.elim (hno_stutter r (by simpa [cur, nxt] using hsame))
    · rcases hcon with hsucc | hpred
      · exact Or.inr hsucc
      · exact Or.inl hpred
  first_max := hfirst_max

/-- Every complete row-contact trace supplies brackets for non-contact
vertices between two contacts: choose the first row contact after the vertex
and take its predecessor. -/
theorem betweenContactBracketCertificate
    (T : ClaimB3RowContactTrace I inv j) :
    T.BetweenContactBracketCertificate where
  bracket_of_noncontact_between := by
    classical
    intro p q v hpq hpv hvq hv_not_row
    let P : GraphPath G := claimB3ColumnPath I inv j
    have hvP : v ∈ P.vertexSet := ((P.before_iff_vertexIndex_le).1 hpv).2.1
    have hex :
        ∃ n : ℕ, ∃ hn : n < T.len + 1,
          P.Before v (T.contact ⟨n, hn⟩) := by
      exact ⟨q.1, q.2, hvq⟩
    let n : ℕ := Nat.find hex
    have hspec :
        ∃ hn : n < T.len + 1, P.Before v (T.contact ⟨n, hn⟩) :=
      Nat.find_spec hex
    rcases hspec with ⟨hn_lt, hv_before_n⟩
    have hn_pos : 0 < n := by
      by_contra hn_not
      have hn0 : n = 0 := Nat.eq_zero_of_not_pos hn_not
      let z0 : Fin (T.len + 1) := ⟨0, by omega⟩
      have hzero_before_p : P.Before (T.contact z0) (T.contact p) :=
        (T.contact_before_iff_le z0 p).2 (by
          simp [z0])
      have hzero_before_v : P.Before (T.contact z0) v :=
        P.before_trans hzero_before_p hpv
      have hv_before_zero : P.Before v (T.contact z0) := by
        simpa [z0, hn0] using hv_before_n
      have hv_eq_zero : v = T.contact z0 :=
        P.before_antisymm hv_before_zero hzero_before_v
      have hzero_rowUnion : T.contact z0 ∈ I.rowVertexSet :=
        claimB3RowPath_vertexSet_subset_rowVertexSet
          (I := I) (inv := inv) (T.row z0) (T.contact_mem_row z0)
      exact hv_not_row (by simpa [hv_eq_zero] using hzero_rowUnion)
    have hn_le_q : n ≤ q.1 := by
      by_contra hnle
      have hq_lt_n : q.1 < n := Nat.lt_of_not_ge hnle
      exact (Nat.find_min hex hq_lt_n) ⟨q.2, hvq⟩
    have hp_lt_n : p.1 < n := by
      by_contra hp_not
      have hn_le_p : n ≤ p.1 := Nat.le_of_not_gt hp_not
      have hn_before_p :
          P.Before (T.contact ⟨n, hn_lt⟩) (T.contact p) :=
        (T.contact_before_iff_le ⟨n, hn_lt⟩ p).2 hn_le_p
      have hv_before_p : P.Before v (T.contact p) :=
        P.before_trans hv_before_n hn_before_p
      have hp_eq_v : T.contact p = v :=
        P.before_antisymm hpv hv_before_p
      have hp_rowUnion : T.contact p ∈ I.rowVertexSet :=
        claimB3RowPath_vertexSet_subset_rowVertexSet
          (I := I) (inv := inv) (T.row p) (T.contact_mem_row p)
      exact hv_not_row (by simpa [hp_eq_v] using hp_rowUnion)
    let r : Fin T.len := ⟨n - 1, by omega⟩
    have hr_succ_eq : r.1 + 1 = n := by
      simp [r]
      omega
    have hp_le_r : p.1 ≤ r.1 := by
      simp [r]
      omega
    have hr_succ_le_q : r.1 + 1 ≤ q.1 := by
      simpa [hr_succ_eq] using hn_le_q
    have hv_before_succ :
        P.Before v
          (T.contact ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩) := by
      have hidx : (⟨r.1 + 1, Nat.succ_lt_succ r.2⟩ :
          Fin (T.len + 1)) = ⟨n, hn_lt⟩ := by
        apply Fin.ext
        exact hr_succ_eq
      simpa [hidx] using hv_before_n
    have hnot_v_before_r :
        ¬ P.Before v
          (T.contact ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self T.len)⟩) := by
      intro hv_before_r
      have hidx_lt : r.1 < n := by omega
      exact (Nat.find_min hex hidx_lt)
        ⟨Nat.lt_trans r.2 (Nat.lt_succ_self T.len), hv_before_r⟩
    have hcontact_r_mem :
        T.contact ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self T.len)⟩ ∈
          P.vertexSet :=
      T.contact_mem_column ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self T.len)⟩
    have hleft_before :
        P.Before
          (T.contact ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self T.len)⟩) v := by
      rcases ClaimB2Atom.graphPath_before_or_before_of_mem P hcontact_r_mem hvP with
        hrv | hvr
      · exact hrv
      · exact False.elim (hnot_v_before_r hvr)
    exact ⟨r, hp_le_r, hr_succ_le_q, hleft_before, hv_before_succ⟩

/-- If a raw row-contact trace has no upward step between two contacts on the
same row, then every row contact between them is on that same row.  This
formally removes harmless same-row stutters without constructing a separate
compressed list. -/
theorem row_eq_of_between_same_row_contacts_of_no_up
    (T : ClaimB3RowContactTrace I inv j)
    {p q r : Fin (T.len + 1)}
    (hrow : T.row p = T.row q)
    (hpr : p.1 ≤ r.1) (hrq : r.1 ≤ q.1)
    (hno_up :
      ∀ s : Fin T.len, p.1 ≤ s.1 → s.1 + 1 ≤ q.1 →
        (T.row ⟨s.1 + 1, Nat.succ_lt_succ s.2⟩).1 ≤
          (T.row ⟨s.1, Nat.lt_trans s.2 (Nat.lt_succ_self T.len)⟩).1) :
    T.row r = T.row p := by
  classical
  have h_r_le_p :
      (T.row r).1 ≤ (T.row p).1 := by
    exact nat_trace_antitone_on_of_succ_le
      (f := fun x : Fin (T.len + 1) => (T.row x).1)
      (lo := p.1) (hi := q.1)
      (by
        intro s hslo hshi
        exact hno_up s hslo hshi)
      (a := p) (b := r) (by omega) hpr hrq
  have h_q_le_r :
      (T.row q).1 ≤ (T.row r).1 := by
    exact nat_trace_antitone_on_of_succ_le
      (f := fun x : Fin (T.len + 1) => (T.row x).1)
      (lo := p.1) (hi := q.1)
      (by
        intro s hslo hshi
        exact hno_up s hslo hshi)
      (a := r) (b := q) hpr hrq (by omega)
  have hval_pq : (T.row p).1 = (T.row q).1 := by
    simpa using congrArg Fin.val hrow
  apply Fin.ext
  omega

/-- Bracketed non-row-contact vertices also remain on the common row when
there is no upward row step between the endpoint contacts. -/
theorem mem_row_of_bracket_between_same_row_contacts_of_no_up
    (T : ClaimB3RowContactTrace I inv j)
    {p q : Fin (T.len + 1)} {r : Fin T.len} {v : V}
    (hrow : T.row p = T.row q)
    (hp_r : p.1 ≤ r.1)
    (hr_succ_q : r.1 + 1 ≤ q.1)
    (hno_up :
      ∀ s : Fin T.len, p.1 ≤ s.1 → s.1 + 1 ≤ q.1 →
        (T.row ⟨s.1 + 1, Nat.succ_lt_succ s.2⟩).1 ≤
          (T.row ⟨s.1, Nat.lt_trans s.2 (Nat.lt_succ_self T.len)⟩).1)
    (hleft :
      (claimB3ColumnPath I inv j).Before
        (T.contact ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self T.len)⟩) v)
    (hright :
      (claimB3ColumnPath I inv j).Before v
        (T.contact ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩)) :
    v ∈ (claimB3RowPath I inv (T.row p)).vertexSet := by
  let cur : Fin (T.len + 1) :=
    ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self T.len)⟩
  let nxt : Fin (T.len + 1) :=
    ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩
  have hcur_row :
      T.row cur = T.row p :=
    T.row_eq_of_between_same_row_contacts_of_no_up hrow hp_r
      (Nat.le_trans (Nat.le_succ r.1) hr_succ_q) hno_up
  have hnxt_row :
      T.row nxt = T.row p :=
    T.row_eq_of_between_same_row_contacts_of_no_up hrow
      (Nat.le_trans hp_r (Nat.le_succ r.1)) hr_succ_q hno_up
  have hsame : T.row cur = T.row nxt := hcur_row.trans hnxt_row.symm
  have hab :
      (claimB3ColumnPath I inv j).Before (T.contact cur) (T.contact nxt) :=
    (T.contact_before_iff_le cur nxt).2 (by simp [cur, nxt])
  have hvseg :
      v ∈ ((claimB3ColumnPath I inv j).segmentOfBefore hab).vertexSet :=
    (claimB3ColumnPath I inv j).mem_segmentOfBefore_of_before_of_before
      hab (by simpa [cur] using hleft) (by simpa [nxt] using hright)
  have hsubset :=
    T.segment_subset_row_of_same_row_succ r (by simpa [cur, nxt] using hsame)
  have hvcur :
      v ∈ (claimB3RowPath I inv (T.row cur)).vertexSet := hsubset hvseg
  simpa [hcur_row] using hvcur

/-- A non-convex row trace forces an upward step somewhere in the raw
row-contact trace.  If no upward step occurred between the two equal-row
contacts, the previous two lemmas would force the middle vertex back onto the
same row, contradicting non-convexity. -/
theorem exists_up_step_of_nonconvex_trace
    (T : ClaimB3RowContactTrace I inv j)
    {i : Fin (z h)}
    (Br : T.BetweenContactBracketCertificate)
    (N : ClaimB3NonconvexTrace I inv i j) :
    ∃ r : Fin T.len,
      (T.row ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self T.len)⟩).1 + 1 =
        (T.row ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩).1 := by
  classical
  by_contra hno_exists
  have hno_up_global :
      ∀ s : Fin T.len,
        (T.row ⟨s.1 + 1, Nat.succ_lt_succ s.2⟩).1 ≤
          (T.row ⟨s.1, Nat.lt_trans s.2 (Nat.lt_succ_self T.len)⟩).1 := by
    intro s
    have hstep := T.consecutive_row_step s
    rcases hstep with hsame | hcon
    · have hval :
          (T.row ⟨s.1 + 1, Nat.succ_lt_succ s.2⟩).1 =
            (T.row ⟨s.1, Nat.lt_trans s.2
              (Nat.lt_succ_self T.len)⟩).1 := by
        simpa using congrArg Fin.val hsame.symm
      omega
    · rcases hcon with hup | hdown
      · exact False.elim (hno_exists ⟨s, by simpa using hup⟩)
      · omega
  have hleft_col :
      N.left ∈ (claimB3ColumnPath I inv j).vertexSet :=
    (Finset.mem_inter.1 N.left_mem).1
  have hleft_row :
      N.left ∈ (claimB3RowPath I inv i).vertexSet :=
    (Finset.mem_inter.1 N.left_mem).2
  have hright_col :
      N.right ∈ (claimB3ColumnPath I inv j).vertexSet :=
    (Finset.mem_inter.1 N.right_mem).1
  have hright_row :
      N.right ∈ (claimB3RowPath I inv i).vertexSet :=
    (Finset.mem_inter.1 N.right_mem).2
  have hleft_rowUnion : N.left ∈ I.rowVertexSet :=
    claimB3RowPath_vertexSet_subset_rowVertexSet (I := I) (inv := inv) i
      hleft_row
  have hright_rowUnion : N.right ∈ I.rowVertexSet :=
    claimB3RowPath_vertexSet_subset_rowVertexSet (I := I) (inv := inv) i
      hright_row
  rcases T.contact_complete hleft_col hleft_rowUnion with ⟨p, hp⟩
  rcases T.contact_complete hright_col hright_rowUnion with ⟨q, hq⟩
  have hp_row_i : T.row p = i := by
    exact (T.contact_row_unique p i (by simpa [hp] using hleft_row)).symm
  have hq_row_i : T.row q = i := by
    exact (T.contact_row_unique q i (by simpa [hq] using hright_row)).symm
  have hrow_pq : T.row p = T.row q := hp_row_i.trans hq_row_i.symm
  have hleft_before_right :
      (claimB3ColumnPath I inv j).Before N.left N.right :=
    (claimB3ColumnPath I inv j).before_trans
      N.left_before_middle N.middle_before_right
  have hp_le_q : p.1 ≤ q.1 := by
    have hpq :
        (claimB3ColumnPath I inv j).Before (T.contact p) (T.contact q) := by
      simpa [hp, hq] using hleft_before_right
    exact (T.contact_before_iff_le p q).1 hpq
  let hno_up_between :
      ∀ s : Fin T.len, p.1 ≤ s.1 → s.1 + 1 ≤ q.1 →
        (T.row ⟨s.1 + 1, Nat.succ_lt_succ s.2⟩).1 ≤
          (T.row ⟨s.1, Nat.lt_trans s.2 (Nat.lt_succ_self T.len)⟩).1 :=
    fun s _ _ => hno_up_global s
  by_cases hmid_rowUnion : N.middle ∈ I.rowVertexSet
  · rcases T.contact_complete N.middle_mem_column hmid_rowUnion with ⟨m, hm⟩
    have hp_le_m : p.1 ≤ m.1 := by
      have hpm :
          (claimB3ColumnPath I inv j).Before (T.contact p) (T.contact m) := by
        simpa [hp, hm] using N.left_before_middle
      exact (T.contact_before_iff_le p m).1 hpm
    have hm_le_q : m.1 ≤ q.1 := by
      have hmq :
          (claimB3ColumnPath I inv j).Before (T.contact m) (T.contact q) := by
        simpa [hm, hq] using N.middle_before_right
      exact (T.contact_before_iff_le m q).1 hmq
    have hm_row_p :
        T.row m = T.row p :=
      T.row_eq_of_between_same_row_contacts_of_no_up hrow_pq
        hp_le_m hm_le_q hno_up_between
    have hmid_mem :
        N.middle ∈ (claimB3RowPath I inv i).vertexSet := by
      have hm_mem :
          N.middle ∈ (claimB3RowPath I inv (T.row m)).vertexSet := by
        simpa [hm] using T.contact_mem_row m
      simpa [hm_row_p, hp_row_i] using hm_mem
    exact N.middle_not_mem_row hmid_mem
  · rcases Br.bracket_of_noncontact_between hp_le_q
      (by simpa [hp] using N.left_before_middle)
      (by simpa [hq] using N.middle_before_right)
      hmid_rowUnion with
      ⟨r, hp_r, hr_succ_q, hleft, hright⟩
    have hmid_mem :
        N.middle ∈ (claimB3RowPath I inv i).vertexSet := by
      have hmem_p :
          N.middle ∈ (claimB3RowPath I inv (T.row p)).vertexSet :=
        T.mem_row_of_bracket_between_same_row_contacts_of_no_up hrow_pq
          hp_r hr_succ_q hno_up_between hleft hright
      simpa [hp_row_i] using hmem_p
    exact N.middle_not_mem_row hmid_mem

/-- The first upward step in the raw row-contact trace determines a compressed
hill interval.  Equal-row stutters before the first upward step are absorbed
by taking the last previous contact on the upper row. -/
theorem hillValley_of_up_step
    (T : ClaimB3RowContactTrace I inv j)
    (hfirst_max :
      ∀ k : Fin (T.len + 1),
        (T.row k).1 ≤ (T.row ⟨0, by omega⟩).1)
    (hex_up :
      ∃ r : Fin T.len,
        (T.row ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self T.len)⟩).1 + 1 =
          (T.row ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩).1) :
    Nonempty T.HillValley := by
  classical
  let f : Fin (T.len + 1) → ℕ := fun r => (T.row r).1
  let Up : ℕ → Prop := fun n =>
    ∃ hn : n < T.len,
      f ⟨n, Nat.lt_trans hn (Nat.lt_succ_self T.len)⟩ + 1 =
        f ⟨n + 1, Nat.succ_lt_succ hn⟩
  have hex_nat : ∃ n, Up n := by
    rcases hex_up with ⟨r, hr⟩
    exact ⟨r.1, r.2, by simpa [f] using hr⟩
  let k : ℕ := Nat.find hex_nat
  have hk_spec : Up k := Nat.find_spec hex_nat
  rcases hk_spec with ⟨hk_lt, hk_up⟩
  have hk_min : ∀ m : ℕ, m < k → ¬ Up m :=
    fun m hm => Nat.find_min hex_nat hm
  have hk_pos : 0 < k := by
    by_contra hk_not
    have hk0 : k = 0 := Nat.eq_zero_of_not_pos hk_not
    have hle : f ⟨1, by omega⟩ ≤ f ⟨0, by omega⟩ := by
      simpa [f] using hfirst_max ⟨1, by omega⟩
    have hup :
        f ⟨0, by omega⟩ + 1 = f ⟨1, by omega⟩ := by
      simpa [k, hk0] using hk_up
    omega
  let lower : ℕ := f ⟨k, Nat.lt_trans hk_lt (Nat.lt_succ_self T.len)⟩
  let top : ℕ := f ⟨k + 1, Nat.succ_lt_succ hk_lt⟩
  have htop_eq : top = lower + 1 := by
    dsimp [top, lower]
    omega
  have htop_le_first : top ≤ f ⟨0, by omega⟩ := by
    simpa [top, f] using hfirst_max ⟨k + 1, Nat.succ_lt_succ hk_lt⟩
  have htop_before_exists : ∃ m : ℕ, ∃ hm : m < k,
      f ⟨m, Nat.lt_trans (Nat.lt_trans hm hk_lt)
        (Nat.lt_succ_self T.len)⟩ = top := by
    let g : Fin (k + 1) → ℕ := fun r =>
      f ⟨r.1, by omega⟩
    have hgstep : UnitStepNatTrace k g := by
      intro r
      simpa [g, f] using T.unitStepNatTrace ⟨r.1, by omega⟩
    have hlast : g ⟨k, by omega⟩ ≤ top := by
      dsimp [g, top, lower]
      omega
    have hfirst : top ≤ g ⟨0, by omega⟩ := by
      simpa [g] using htop_le_first
    rcases UnitStepNatTrace.exists_eq_of_ge hgstep hfirst hlast with ⟨r, hr⟩
    have hr_ne_k : r.1 ≠ k := by
      intro hrk
      have hlow_eq_top : lower = top := by
        have hfin :
            (⟨k, Nat.lt_trans hk_lt (Nat.lt_succ_self T.len)⟩ :
              Fin (T.len + 1)) = ⟨r.1, by omega⟩ := by
          exact Fin.ext hrk.symm
        calc
          lower = f ⟨k, Nat.lt_trans hk_lt (Nat.lt_succ_self T.len)⟩ := rfl
          _ = f ⟨r.1, by omega⟩ := by rw [hfin]
          _ = top := by simpa [g] using hr
      omega
    exact ⟨r.1, by omega, by simpa [g] using hr⟩
  let TopBefore : ℕ → Prop := fun m =>
    ∃ hm : m < k,
      f ⟨m, Nat.lt_trans (Nat.lt_trans hm hk_lt)
        (Nat.lt_succ_self T.len)⟩ = top
  let l : ℕ := Nat.findGreatest TopBefore k
  have hl_spec : TopBefore l := by
    rcases htop_before_exists with ⟨m, hm_lt, hm_top⟩
    exact Nat.findGreatest_spec
      (P := TopBefore) (m := m) (n := k) (by omega) ⟨hm_lt, hm_top⟩
  rcases hl_spec with ⟨hl_lt_k, hl_top_raw⟩
  have hl_top : f ⟨l, by omega⟩ = top := by
    simpa using hl_top_raw
  have hl_le_k : l ≤ k := Nat.le_of_lt hl_lt_k
  have hno_up_le_before_k :
      ∀ s : Fin T.len, l ≤ s.1 → s.1 + 1 ≤ k →
        f ⟨s.1 + 1, by omega⟩ ≤ f ⟨s.1, by omega⟩ := by
    intro s _hslo hshi
    have hs_lt_k : s.1 < k := by omega
    have hs_not_up : ¬ Up s.1 := hk_min s.1 hs_lt_k
    have hstep := T.consecutive_row_step s
    rcases hstep with hsame | hcon
    · have hval :
          f ⟨s.1 + 1, by omega⟩ = f ⟨s.1, by omega⟩ := by
        simpa [f] using congrArg Fin.val hsame.symm
      omega
    · rcases hcon with hup | hdown
      · exact False.elim
          (hs_not_up ⟨s.2, by simpa [f] using hup⟩)
      · have hval :
            f ⟨s.1 + 1, by omega⟩ + 1 = f ⟨s.1, by omega⟩ := by
          simpa [f] using hdown
        omega
  let left : Fin (T.len + 1) := ⟨l, by omega⟩
  let mid : Fin (T.len + 1) :=
    ⟨k, Nat.lt_trans hk_lt (Nat.lt_succ_self T.len)⟩
  let right : Fin (T.len + 1) := ⟨k + 1, Nat.succ_lt_succ hk_lt⟩
  have hleft_row_val : f left = top := by
    simpa [left] using hl_top
  have hmid_row_val : f mid = lower := rfl
  have hright_row_val : f right = top := rfl
  have hleft_lt_right : left.1 < right.1 := by
    dsimp [left, right]
    omega
  refine ⟨{
    left := left
    right := right
    rowTop := T.row right
    rowLower := T.row mid
    left_lt_right := hleft_lt_right
    left_row := ?_
    right_row := rfl
    lower_succ := ?_
    hit_lower := ?_
    contacts_only_lower_or_endpoints := ?_
  }⟩
  · apply Fin.ext
    simp [f, hleft_row_val, hright_row_val]
  · dsimp [mid, right, f, lower, top] at hk_up ⊢
    simpa using hk_up
  · refine ⟨mid, ?_, ?_, rfl⟩ <;> dsimp [left, mid, right] <;> omega
  · intro q hleft_q hq_right hnot_lower
    by_cases hq_left : q = left
    · exact Or.inl hq_left
    by_cases hq_right_eq : q = right
    · exact Or.inr hq_right_eq
    have hl_lt_q : l < q.1 := by
      dsimp [left] at hleft_q
      exact Nat.lt_of_le_of_ne hleft_q (by
        intro hq
        exact hq_left (Fin.ext hq.symm))
    have hq_lt_right_nat : q.1 < k + 1 := by
      dsimp [right] at hq_right
      exact Nat.lt_of_le_of_ne hq_right (by
        intro hq
        exact hq_right_eq (Fin.ext hq))
    have hq_le_k : q.1 ≤ k := by omega
    have hq_ge_lower :
        lower ≤ f q := by
      have hanti :=
        nat_trace_antitone_on_of_succ_le
          (f := f) (lo := l) (hi := k)
          (by
            intro s hslo hshi
            exact hno_up_le_before_k s hslo hshi)
          (a := q) (b := mid) (Nat.le_of_lt hl_lt_q)
          (by simpa [mid] using hq_le_k) (by simp [mid])
      simpa [mid, lower] using hanti
    have hq_le_top :
        f q ≤ top := by
      have hanti :=
        nat_trace_antitone_on_of_succ_le
          (f := f) (lo := l) (hi := k)
          (by
            intro s hslo hshi
            exact hno_up_le_before_k s hslo hshi)
          (a := left) (b := q) (by simp [left]) hleft_q hq_le_k
      simpa [left, hleft_row_val] using hanti
    have hq_eq_lower : f q = lower := by
      have hcases : f q = lower ∨ f q = top := by
        omega
      rcases hcases with hlow | htopq
      · exact hlow
      · have hq_lt_k : q.1 < k := by
          by_contra hnot
          have hqk : q.1 = k := by omega
          have hlow_top : lower = top := by
            have hq_fin : q = mid := Fin.ext hqk
            calc
              lower = f mid := hmid_row_val.symm
              _ = f q := by rw [hq_fin]
              _ = top := htopq
          omega
        have hnot_top :
            ¬ TopBefore q.1 :=
          Nat.findGreatest_is_greatest
            (P := TopBefore) (n := k) (hk := hl_lt_q) (hkb := hq_le_k)
        exact False.elim (hnot_top ⟨hq_lt_k, by simpa using htopq⟩)
    have hq_lower_row : T.row q = T.row mid := by
      apply Fin.ext
      simp [f, hq_eq_lower, hmid_row_val]
    exact False.elim (hnot_lower hq_lower_row)

namespace CompressedRowBlocks

variable {T : ClaimB3RowContactTrace I inv j}

/-- The compressed row blocks cover every raw row-contact index. -/
theorem exists_block_of_raw_index
    (B : T.CompressedRowBlocks) (r : Fin (T.len + 1)) :
    ∃ k : Fin (B.len + 1),
      (B.first k).1 ≤ r.1 ∧ r.1 ≤ (B.last k).1 := by
  classical
  have hex :
      ∃ n : ℕ, ∃ hn : n ≤ B.len,
        r.1 ≤ (B.last ⟨n, by omega⟩).1 := by
    refine ⟨B.len, le_rfl, ?_⟩
    have hrle : r.1 ≤ T.len := by omega
    simpa [B.last_eq_trace_len] using hrle
  let n : ℕ := Nat.find hex
  have hspec :
      ∃ hn : n ≤ B.len,
        r.1 ≤ (B.last ⟨n, by omega⟩).1 :=
    Nat.find_spec hex
  rcases hspec with ⟨hn_le, hr_le_last⟩
  let k : Fin (B.len + 1) := ⟨n, by omega⟩
  refine ⟨k, ?_, hr_le_last⟩
  by_cases hn0 : n = 0
  · have hfirst : (B.first k).1 = 0 := by
      simpa [k, hn0] using B.first_zero
    omega
  · have hn_pos : 0 < n := Nat.pos_of_ne_zero hn0
    let p : Fin B.len := ⟨n - 1, by omega⟩
    have hprev_not :
        ¬ (∃ hm : n - 1 ≤ B.len,
          r.1 ≤ (B.last ⟨n - 1, by omega⟩).1) :=
      Nat.find_min hex (by omega : n - 1 < n)
    have hnot_le : ¬ r.1 ≤ (B.last ⟨n - 1, by omega⟩).1 := by
      intro hle
      exact hprev_not ⟨by omega, hle⟩
    have hprev_lt : (B.last ⟨n - 1, by omega⟩).1 < r.1 :=
      Nat.lt_of_not_ge hnot_le
    have hnext :
        (B.last ⟨n - 1, by omega⟩).1 + 1 = (B.first k).1 := by
      simpa [p, k, Nat.sub_add_cancel hn_pos] using B.next p
    omega

/-- In a strictly descending compressed trace, two different block positions
cannot have the same row. -/
theorem blockRow_ne_of_index_lt
    (B : T.CompressedRowBlocks)
    (hdown :
      StrictDownNatTrace B.len
        (fun k : Fin (B.len + 1) => (B.blockRow k).1))
    {a b : Fin (B.len + 1)} (hab : a.1 < b.1) :
    B.blockRow a ≠ B.blockRow b := by
  intro hrow
  have hlt :=
    StrictDownNatTrace.value_lt_of_index_lt
      (f := fun k : Fin (B.len + 1) => (B.blockRow k).1)
      hdown hab
  have hlt' : (B.blockRow b).1 < (B.blockRow a).1 := by
    simpa using hlt
  have heq : (B.blockRow b).1 = (B.blockRow a).1 := by
    rw [hrow]
  rw [heq] at hlt'
  exact Nat.lt_irrefl _ hlt'

/-- In a strictly descending compressed trace, two raw contacts on the same
row lie in one compressed block. -/
theorem exists_same_block_of_same_row_contacts
    (B : T.CompressedRowBlocks)
    (hdown :
      StrictDownNatTrace B.len
        (fun k : Fin (B.len + 1) => (B.blockRow k).1))
    {p q : Fin (T.len + 1)}
    (hrow : T.row p = T.row q) :
    ∃ k : Fin (B.len + 1),
      (B.first k).1 ≤ p.1 ∧ p.1 ≤ (B.last k).1 ∧
        (B.first k).1 ≤ q.1 ∧ q.1 ≤ (B.last k).1 := by
  classical
  rcases B.exists_block_of_raw_index p with ⟨kp, hp_first, hp_last⟩
  rcases B.exists_block_of_raw_index q with ⟨kq, hq_first, hq_last⟩
  have hp_row : T.row p = B.blockRow kp :=
    B.row_eq_block kp p hp_first hp_last
  have hq_row : T.row q = B.blockRow kq :=
    B.row_eq_block kq q hq_first hq_last
  have hblock : B.blockRow kp = B.blockRow kq := by
    calc
      B.blockRow kp = T.row p := hp_row.symm
      _ = T.row q := hrow
      _ = B.blockRow kq := hq_row
  have hk : kp = kq := by
    rcases lt_trichotomy kp.1 kq.1 with hlt | heq | hgt
    · exact False.elim ((B.blockRow_ne_of_index_lt hdown hlt) hblock)
    · exact Fin.ext heq
    · exact False.elim ((B.blockRow_ne_of_index_lt hdown hgt) hblock.symm)
  subst hk
  exact ⟨kp, hp_first, hp_last, hq_first, hq_last⟩

/-- In a strictly descending compressed trace, all raw contacts between two
contacts on the same row also lie on that row. -/
theorem row_eq_of_between_same_row_contacts
    (B : T.CompressedRowBlocks)
    (hdown :
      StrictDownNatTrace B.len
        (fun k : Fin (B.len + 1) => (B.blockRow k).1))
    {p q r : Fin (T.len + 1)}
    (hrow : T.row p = T.row q)
    (hpr : p.1 ≤ r.1) (hrq : r.1 ≤ q.1) :
    T.row r = T.row p := by
  rcases B.exists_same_block_of_same_row_contacts hdown hrow with
    ⟨k, hp_first, hp_last, hq_first, hq_last⟩
  have hr_first : (B.first k).1 ≤ r.1 := le_trans hp_first hpr
  have hr_last : r.1 ≤ (B.last k).1 := le_trans hrq hq_last
  have hr_block : T.row r = B.blockRow k :=
    B.row_eq_block k r hr_first hr_last
  have hp_block : T.row p = B.blockRow k :=
    B.row_eq_block k p hp_first hp_last
  exact hr_block.trans hp_block.symm

/-- If a vertex is bracketed by two consecutive raw contacts inside an interval
whose endpoint contacts lie on one row, then strict descent of the compressed
trace forces that vertex to lie on the same row. -/
theorem mem_row_of_bracket_between_same_row_contacts
    (B : T.CompressedRowBlocks)
    (hdown :
      StrictDownNatTrace B.len
        (fun k : Fin (B.len + 1) => (B.blockRow k).1))
    {p q : Fin (T.len + 1)} {r : Fin T.len} {v : V}
    (hrow : T.row p = T.row q)
    (hp_r : p.1 ≤ r.1)
    (hr_succ_q : r.1 + 1 ≤ q.1)
    (hleft :
      (claimB3ColumnPath I inv j).Before
        (T.contact ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self T.len)⟩) v)
    (hright :
      (claimB3ColumnPath I inv j).Before v
        (T.contact ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩)) :
    v ∈ (claimB3RowPath I inv (T.row p)).vertexSet := by
  let cur : Fin (T.len + 1) :=
    ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self T.len)⟩
  let nxt : Fin (T.len + 1) :=
    ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩
  have hcur_row :
      T.row cur = T.row p :=
    B.row_eq_of_between_same_row_contacts hdown hrow hp_r
      (Nat.le_trans (Nat.le_succ r.1) hr_succ_q)
  have hnxt_row :
      T.row nxt = T.row p :=
    B.row_eq_of_between_same_row_contacts hdown hrow
      (Nat.le_trans hp_r (Nat.le_succ r.1)) hr_succ_q
  have hsame : T.row cur = T.row nxt := by
    exact hcur_row.trans hnxt_row.symm
  have hab :
      (claimB3ColumnPath I inv j).Before (T.contact cur) (T.contact nxt) :=
    (T.contact_before_iff_le cur nxt).2 (by simp [cur, nxt])
  have hvseg :
      v ∈ ((claimB3ColumnPath I inv j).segmentOfBefore hab).vertexSet :=
    (claimB3ColumnPath I inv j).mem_segmentOfBefore_of_before_of_before
      hab (by simpa [cur] using hleft) (by simpa [nxt] using hright)
  have hsubset :=
    T.segment_subset_row_of_same_row_succ r (by simpa [cur, nxt] using hsame)
  have hvcur :
      v ∈ (claimB3RowPath I inv (T.row cur)).vertexSet := by
    exact hsubset hvseg
  simpa [hcur_row] using hvcur

/-- With bracketing for non-row-contact vertices, a non-convex row trace
contradicts strict descent of the compressed row trace. -/
theorem not_strictDown_of_nonconvex_trace
    (B : T.CompressedRowBlocks)
    (Br : T.BetweenContactBracketCertificate)
    {i : Fin (z h)}
    (N : ClaimB3NonconvexTrace I inv i j) :
    ¬ StrictDownNatTrace B.len
        (fun k : Fin (B.len + 1) => (B.blockRow k).1) := by
  classical
  intro hdown
  have hleft_col :
      N.left ∈ (claimB3ColumnPath I inv j).vertexSet :=
    (Finset.mem_inter.1 N.left_mem).1
  have hleft_row :
      N.left ∈ (claimB3RowPath I inv i).vertexSet :=
    (Finset.mem_inter.1 N.left_mem).2
  have hright_col :
      N.right ∈ (claimB3ColumnPath I inv j).vertexSet :=
    (Finset.mem_inter.1 N.right_mem).1
  have hright_row :
      N.right ∈ (claimB3RowPath I inv i).vertexSet :=
    (Finset.mem_inter.1 N.right_mem).2
  have hleft_rowUnion : N.left ∈ I.rowVertexSet :=
    claimB3RowPath_vertexSet_subset_rowVertexSet (I := I) (inv := inv) i
      hleft_row
  have hright_rowUnion : N.right ∈ I.rowVertexSet :=
    claimB3RowPath_vertexSet_subset_rowVertexSet (I := I) (inv := inv) i
      hright_row
  rcases T.contact_complete hleft_col hleft_rowUnion with ⟨p, hp⟩
  rcases T.contact_complete hright_col hright_rowUnion with ⟨q, hq⟩
  have hp_row_i : T.row p = i := by
    exact (T.contact_row_unique p i (by simpa [hp] using hleft_row)).symm
  have hq_row_i : T.row q = i := by
    exact (T.contact_row_unique q i (by simpa [hq] using hright_row)).symm
  have hrow_pq : T.row p = T.row q := by
    exact hp_row_i.trans hq_row_i.symm
  have hleft_before_right :
      (claimB3ColumnPath I inv j).Before N.left N.right :=
    (claimB3ColumnPath I inv j).before_trans
      N.left_before_middle N.middle_before_right
  have hp_le_q : p.1 ≤ q.1 := by
    have hpq :
        (claimB3ColumnPath I inv j).Before (T.contact p) (T.contact q) := by
      simpa [hp, hq] using hleft_before_right
    exact (T.contact_before_iff_le p q).1 hpq
  by_cases hmid_rowUnion : N.middle ∈ I.rowVertexSet
  · rcases T.contact_complete N.middle_mem_column hmid_rowUnion with ⟨m, hm⟩
    have hp_le_m : p.1 ≤ m.1 := by
      have hpm :
          (claimB3ColumnPath I inv j).Before (T.contact p) (T.contact m) := by
        simpa [hp, hm] using N.left_before_middle
      exact (T.contact_before_iff_le p m).1 hpm
    have hm_le_q : m.1 ≤ q.1 := by
      have hmq :
          (claimB3ColumnPath I inv j).Before (T.contact m) (T.contact q) := by
        simpa [hm, hq] using N.middle_before_right
      exact (T.contact_before_iff_le m q).1 hmq
    have hm_row_p :
        T.row m = T.row p :=
      B.row_eq_of_between_same_row_contacts hdown hrow_pq hp_le_m hm_le_q
    have hmid_mem :
        N.middle ∈ (claimB3RowPath I inv i).vertexSet := by
      have hm_mem :
          N.middle ∈ (claimB3RowPath I inv (T.row m)).vertexSet := by
        simpa [hm] using T.contact_mem_row m
      simpa [hm_row_p, hp_row_i] using hm_mem
    exact N.middle_not_mem_row hmid_mem
  · rcases Br.bracket_of_noncontact_between hp_le_q
      (by simpa [hp] using N.left_before_middle)
      (by simpa [hq] using N.middle_before_right)
      hmid_rowUnion with
      ⟨r, hp_r, hr_succ_q, hleft, hright⟩
    have hmid_mem :
        N.middle ∈ (claimB3RowPath I inv i).vertexSet := by
      have hmem_p :
          N.middle ∈ (claimB3RowPath I inv (T.row p)).vertexSet :=
        B.mem_row_of_bracket_between_same_row_contacts hdown hrow_pq
          hp_r hr_succ_q hleft hright
      simpa [hp_row_i] using hmem_p
    exact N.middle_not_mem_row hmid_mem

/-- The pure finite-list step of Claim B.3.  If the compressed trace is not
strictly descending, it contains a down-and-back interval; expanded back to
the raw row-contact trace, that interval is precisely a `HillValley`. -/
theorem hillValley_of_not_strictDown
    (B : T.CompressedRowBlocks)
    (hnot :
      ¬ StrictDownNatTrace B.len
        (fun k : Fin (B.len + 1) => (B.blockRow k).1)) :
    Nonempty T.HillValley := by
  classical
  rcases ExactUnitStepNatTrace.exists_local_valley_of_not_strictDown
      B.exact_step B.first_max hnot with
    ⟨r, htop_val, hlower_succ_val⟩
  let k0 : Fin (B.len + 1) := ⟨r.1, by omega⟩
  let k1 : Fin (B.len + 1) := ⟨r.1 + 1, by omega⟩
  let k2 : Fin (B.len + 1) := ⟨r.1 + 2, by omega⟩
  let e0 : Fin B.len := ⟨r.1, by omega⟩
  let e1 : Fin B.len := ⟨r.1 + 1, by omega⟩
  let left : Fin (T.len + 1) := B.last k0
  let right : Fin (T.len + 1) := B.first k2
  have hnext0 : left.1 + 1 = (B.first k1).1 := by
    simpa [left, k0, k1, e0] using B.next e0
  have hnext1 : (B.last k1).1 + 1 = right.1 := by
    simpa [right, k1, k2, e1] using B.next e1
  have hleft_lt_right : left.1 < right.1 := by
    have hle_mid := B.first_le_last k1
    omega
  have htop_eq : B.blockRow k0 = B.blockRow k2 := by
    apply Fin.ext
    simpa [k0, k2] using htop_val
  have hlower_succ : (B.blockRow k1).1 + 1 = (B.blockRow k0).1 := by
    simpa [k0, k1] using hlower_succ_val
  refine ⟨{
    left := left
    right := right
    rowTop := B.blockRow k0
    rowLower := B.blockRow k1
    left_lt_right := hleft_lt_right
    left_row := ?_
    right_row := ?_
    lower_succ := hlower_succ
    hit_lower := ?_
    contacts_only_lower_or_endpoints := ?_
  }⟩
  · exact B.row_eq_block k0 left (B.first_le_last k0) (by rfl)
  · calc
      T.row right = B.blockRow k2 :=
        B.row_eq_block k2 right (by rfl) (B.first_le_last k2)
      _ = B.blockRow k0 := htop_eq.symm
  · refine ⟨B.first k1, ?_, ?_, ?_⟩
    · omega
    · have hle_mid := B.first_le_last k1
      omega
    · exact B.row_eq_block k1 (B.first k1) (by rfl) (B.first_le_last k1)
  · intro q hleft hright hnot_lower
    by_cases hq_left : q = left
    · exact Or.inl hq_left
    by_cases hq_right : q = right
    · exact Or.inr hq_right
    have hfirst1_le_q : (B.first k1).1 ≤ q.1 := by
      have hq_gt_left : left.1 < q.1 := Nat.lt_of_le_of_ne hleft
        (by
          intro hleq
          exact hq_left (Fin.ext hleq.symm))
      omega
    have hq_le_last1 : q.1 ≤ (B.last k1).1 := by
      have hq_lt_right : q.1 < right.1 := Nat.lt_of_le_of_ne hright
        (by
          intro hqeq
          exact hq_right (Fin.ext hqeq))
      omega
    have hq_lower : T.row q = B.blockRow k1 :=
      B.row_eq_block k1 q hfirst1_le_q hq_le_last1
    exact False.elim (hnot_lower hq_lower)

/-- A compressed row block with the immediately preceding and following blocks
on the row one higher is exactly a hill interval.

This is the trace-only part of the Claim B.3 blocker argument: after the
no-cross barrier proves that a blocker row segment is entered and exited from
the row above, the corresponding three compressed blocks form the higher hill
candidate. -/
theorem hillValley_of_block_with_upper_neighbors
    (B : T.CompressedRowBlocks)
    {b : Fin (B.len + 1)}
    (hb_pos : 0 < b.1)
    (hb_lt : b.1 < B.len)
    (hprev_upper :
      (B.blockRow b).1 + 1 =
        (B.blockRow ⟨b.1 - 1, by omega⟩).1)
    (hnext_upper :
      (B.blockRow b).1 + 1 =
        (B.blockRow ⟨b.1 + 1, by omega⟩).1) :
    ∃ Vly : T.HillValley, Vly.rowLower = B.blockRow b := by
  classical
  let prev : Fin (B.len + 1) := ⟨b.1 - 1, by omega⟩
  let next : Fin (B.len + 1) := ⟨b.1 + 1, by omega⟩
  let eprev : Fin B.len := ⟨b.1 - 1, by omega⟩
  let ecur : Fin B.len := ⟨b.1, by omega⟩
  let left : Fin (T.len + 1) := B.last prev
  let right : Fin (T.len + 1) := B.first next
  have hnext_prev :
      left.1 + 1 = (B.first b).1 := by
    have h := B.next eprev
    have hb :
        (⟨(b.1 - 1) + 1, by omega⟩ : Fin (B.len + 1)) = b := by
      apply Fin.ext
      simp
      omega
    simpa [left, prev, eprev, hb] using h
  have hnext_cur :
      (B.last b).1 + 1 = right.1 := by
    simpa [right, next, ecur] using B.next ecur
  have hleft_lt_right : left.1 < right.1 := by
    have hle := B.first_le_last b
    omega
  have htop_eq : B.blockRow next = B.blockRow prev := by
    apply Fin.ext
    have hn :
        (B.blockRow next).1 = (B.blockRow b).1 + 1 := by
      simpa [next] using hnext_upper.symm
    have hp :
        (B.blockRow prev).1 = (B.blockRow b).1 + 1 := by
      simpa [prev] using hprev_upper.symm
    omega
  refine ⟨{
    left := left
    right := right
    rowTop := B.blockRow prev
    rowLower := B.blockRow b
    left_lt_right := hleft_lt_right
    left_row := ?_
    right_row := ?_
    lower_succ := hprev_upper
    hit_lower := ?_
    contacts_only_lower_or_endpoints := ?_
  }, rfl⟩
  · exact B.row_eq_block prev left (B.first_le_last prev) (by rfl)
  · calc
      T.row right = B.blockRow next :=
        B.row_eq_block next right (by rfl) (B.first_le_last next)
      _ = B.blockRow prev := htop_eq
  · refine ⟨B.first b, ?_, ?_, ?_⟩
    · omega
    · have hle := B.first_le_last b
      omega
    · exact B.row_eq_block b (B.first b) (by rfl) (B.first_le_last b)
  · intro q hleft_q hq_right hnot_lower
    by_cases hq_left : q = left
    · exact Or.inl hq_left
    by_cases hq_eq_right : q = right
    · exact Or.inr hq_eq_right
    have hfirst_b_le_q : (B.first b).1 ≤ q.1 := by
      have hlt : left.1 < q.1 := Nat.lt_of_le_of_ne hleft_q (by
        intro hq
        exact hq_left (Fin.ext hq.symm))
      omega
    have hq_le_last_b : q.1 ≤ (B.last b).1 := by
      have hlt : q.1 < right.1 := Nat.lt_of_le_of_ne hq_right (by
        intro hq
        exact hq_eq_right (Fin.ext hq))
      omega
    have hq_lower : T.row q = B.blockRow b :=
      B.row_eq_block b q hfirst_b_le_q hq_le_last_b
    exact False.elim (hnot_lower hq_lower)

/-- A concrete vertex of the selected column on a terminal row lies in a
compressed row-contact block for that row. -/
theorem exists_block_of_vertex_on_row
    (B : T.CompressedRowBlocks)
    {row : Fin (z h)} {v : V}
    (hvcol : v ∈ (claimB3ColumnPath I inv j).vertexSet)
    (hvrow : v ∈ (claimB3RowPath I inv row).vertexSet) :
    ∃ b : Fin (B.len + 1), B.blockRow b = row := by
  classical
  have hvrowUnion : v ∈ I.rowVertexSet :=
    claimB3RowPath_vertexSet_subset_rowVertexSet (I := I) (inv := inv)
      row hvrow
  rcases T.contact_complete hvcol hvrowUnion with ⟨r, hr⟩
  rcases B.exists_block_of_raw_index r with
    ⟨b, hb_first, hb_last⟩
  have hTrow : T.row r = row := by
    exact (T.contact_row_unique r row (by simpa [hr] using hvrow)).symm
  have hblock : T.row r = B.blockRow b :=
    B.row_eq_block b r hb_first hb_last
  exact ⟨b, hblock.symm.trans hTrow⟩

/-- A blocker for a hill candidate supplies a compressed blocker-trace block
on the candidate row.  This is the formal version of choosing a maximal
contiguous blocker subpath inside the candidate's row interval, before proving
that the neighboring contacts are on the row above. -/
theorem exists_block_on_candidate_row_of_blocker
    (B : T.CompressedRowBlocks)
    {C : ClaimB3HillCandidateData I inv}
    (hblock :
      ¬ Disjoint C.rowInterval.vertexSet
        (claimB3ColumnPath I inv j).vertexSet) :
    ∃ b : Fin (B.len + 1), B.blockRow b = C.row := by
  classical
  rcases Finset.not_disjoint_iff.1 hblock with ⟨v, hvrowInterval, hvcol⟩
  have hvrow : v ∈ (claimB3RowPath I inv C.row).vertexSet :=
    (claimB3RowPath I inv C.row).segmentOfBefore_vertexSet_subset
      C.left_before_right hvrowInterval
  exact B.exists_block_of_vertex_on_row hvcol hvrow

/-- A compressed same-row block of a selected column contains every row
vertex lying between its first and last contacts.  This is the positive
version of the blocker straddling lemma: a maximal same-row blocker block
does not skip any vertex of the ambient row interval. -/
theorem mem_column_of_same_row_block_between_contacts
    (B : T.CompressedRowBlocks)
    {b : Fin (B.len + 1)}
    {x : V}
    (hxrow :
      x ∈ (claimB3RowPath I inv (B.blockRow b)).vertexSet)
    (hbetween :
      ((claimB3RowPath I inv (B.blockRow b)).vertexIndex
          (T.contact (B.first b)) ≤
        (claimB3RowPath I inv (B.blockRow b)).vertexIndex x ∧
          (claimB3RowPath I inv (B.blockRow b)).vertexIndex x ≤
        (claimB3RowPath I inv (B.blockRow b)).vertexIndex
          (T.contact (B.last b))) ∨
      ((claimB3RowPath I inv (B.blockRow b)).vertexIndex
          (T.contact (B.last b)) ≤
        (claimB3RowPath I inv (B.blockRow b)).vertexIndex x ∧
          (claimB3RowPath I inv (B.blockRow b)).vertexIndex x ≤
        (claimB3RowPath I inv (B.blockRow b)).vertexIndex
          (T.contact (B.first b)))) :
    x ∈ (claimB3ColumnPath I inv j).vertexSet := by
  classical
  let Row : GraphPath G := claimB3RowPath I inv (B.blockRow b)
  by_cases hsame_idx : (B.first b).1 = (B.last b).1
  · have hfirst_eq_last : B.first b = B.last b := Fin.ext hsame_idx
    have hcontact_mem_row :
        T.contact (B.first b) ∈ Row.vertexSet := by
      have hrow_first :
          T.row (B.first b) = B.blockRow b :=
        B.row_eq_block b (B.first b) (by rfl) (B.first_le_last b)
      simpa [Row, hrow_first] using T.contact_mem_row (B.first b)
    have hx_eq : x = T.contact (B.first b) := by
      have hidx :
          Row.vertexIndex x = Row.vertexIndex (T.contact (B.first b)) := by
        rcases hbetween with h | h
        · have hx_le_first :
              Row.vertexIndex x ≤ Row.vertexIndex (T.contact (B.first b)) := by
            simpa [Row, hfirst_eq_last] using h.2
          have hfirst_le_x :
              Row.vertexIndex (T.contact (B.first b)) ≤ Row.vertexIndex x := by
            simpa [Row] using h.1
          exact le_antisymm hx_le_first hfirst_le_x
        · have hfirst_le_x :
              Row.vertexIndex (T.contact (B.first b)) ≤ Row.vertexIndex x := by
            simpa [Row, hfirst_eq_last] using h.1
          have hx_le_first :
              Row.vertexIndex x ≤ Row.vertexIndex (T.contact (B.first b)) := by
            simpa [Row] using h.2
          exact le_antisymm hx_le_first hfirst_le_x
      have hx_before :
          Row.Before x (T.contact (B.first b)) :=
        (Row.before_iff_vertexIndex_le).2
          ⟨hxrow, hcontact_mem_row, by omega⟩
      have hcontact_before :
          Row.Before (T.contact (B.first b)) x :=
        (Row.before_iff_vertexIndex_le).2
          ⟨hcontact_mem_row, hxrow, by omega⟩
      exact Row.before_antisymm hx_before hcontact_before
    simpa [hx_eq] using T.contact_mem_column (B.first b)
  · have hfirst_lt_last : (B.first b).1 < (B.last b).1 :=
      Nat.lt_of_le_of_ne (B.first_le_last b) hsame_idx
    rcases exists_adjacent_straddle
        (n := T.len)
        (c := Row.vertexIndex x)
        (f := fun r : Fin (T.len + 1) => Row.vertexIndex (T.contact r))
        hfirst_lt_last
        (by simpa [Row] using hbetween) with
      ⟨s, hfirst_s, hs_last, hpair⟩
    let cur : Fin (T.len + 1) :=
      ⟨s.1, Nat.lt_trans s.2 (Nat.lt_succ_self T.len)⟩
    let nxt : Fin (T.len + 1) :=
      ⟨s.1 + 1, Nat.succ_lt_succ s.2⟩
    have hcur_row_block : T.row cur = B.blockRow b :=
      B.row_eq_block b cur
        (by simpa [cur] using hfirst_s)
        (by
          simp [cur]
          omega)
    have hnxt_row_block : T.row nxt = B.blockRow b :=
      B.row_eq_block b nxt
        (by
          simp [nxt]
          omega)
        (by simpa [nxt] using hs_last)
    have hsame_row : T.row cur = T.row nxt :=
      hcur_row_block.trans hnxt_row_block.symm
    have hxrow_cur :
        x ∈ (claimB3RowPath I inv (T.row cur)).vertexSet := by
      simpa [hcur_row_block] using hxrow
    have hbetween_cur :
        ((claimB3RowPath I inv (T.row cur)).vertexIndex
            (T.contact cur) ≤
          (claimB3RowPath I inv (T.row cur)).vertexIndex x ∧
            (claimB3RowPath I inv (T.row cur)).vertexIndex x ≤
          (claimB3RowPath I inv (T.row cur)).vertexIndex
            (T.contact nxt)) ∨
        ((claimB3RowPath I inv (T.row cur)).vertexIndex
            (T.contact nxt) ≤
          (claimB3RowPath I inv (T.row cur)).vertexIndex x ∧
            (claimB3RowPath I inv (T.row cur)).vertexIndex x ≤
          (claimB3RowPath I inv (T.row cur)).vertexIndex
            (T.contact cur)) := by
      simpa [Row, cur, nxt, hcur_row_block] using hpair
    exact T.mem_column_of_same_row_succ_between_row_contacts s
      (by simpa [cur, nxt] using hsame_row) hxrow_cur hbetween_cur

/- The row interval between the first and last contacts of a compressed
same-row block belongs to the selected column.  The orientation of the row
segment is supplied by the caller, because later bracketing arguments choose
the direction according to the row order of the hill endpoints. -/
theorem rowSegment_between_block_contacts_subset_column
    (B : T.CompressedRowBlocks)
    {b : Fin (B.len + 1)}
    (hbefore :
      (claimB3RowPath I inv (B.blockRow b)).Before
        (T.contact (B.first b)) (T.contact (B.last b))) :
    ((claimB3RowPath I inv (B.blockRow b)).segmentOfBefore hbefore).vertexSet ⊆
      (claimB3ColumnPath I inv j).vertexSet := by
  classical
  intro x hxseg
  let Row : GraphPath G := claimB3RowPath I inv (B.blockRow b)
  have hxrow : x ∈ Row.vertexSet :=
    Row.segmentOfBefore_vertexSet_subset hbefore hxseg
  have hleft :
      Row.Before (T.contact (B.first b)) x :=
    Row.before_of_mem_segmentOfBefore_left hbefore hxseg
  have hright :
      Row.Before x (T.contact (B.last b)) :=
    Row.before_of_mem_segmentOfBefore_right hbefore hxseg
  have hbetween :
      ((claimB3RowPath I inv (B.blockRow b)).vertexIndex
          (T.contact (B.first b)) ≤
        (claimB3RowPath I inv (B.blockRow b)).vertexIndex x ∧
          (claimB3RowPath I inv (B.blockRow b)).vertexIndex x ≤
        (claimB3RowPath I inv (B.blockRow b)).vertexIndex
          (T.contact (B.last b))) ∨
      ((claimB3RowPath I inv (B.blockRow b)).vertexIndex
          (T.contact (B.last b)) ≤
        (claimB3RowPath I inv (B.blockRow b)).vertexIndex x ∧
          (claimB3RowPath I inv (B.blockRow b)).vertexIndex x ≤
        (claimB3RowPath I inv (B.blockRow b)).vertexIndex
          (T.contact (B.first b))) := by
    left
    exact ⟨((Row.before_iff_vertexIndex_le).1 hleft).2.2,
      ((Row.before_iff_vertexIndex_le).1 hright).2.2⟩
  exact B.mem_column_of_same_row_block_between_contacts (by simpa [Row] using hxrow)
    hbetween

/-- The same same-row block ownership lemma stated against the underlying
`Q₀` data object.  This is the form consumed by the Claim B.3 bracketing
barrier, whose atoms store the original packing index rather than the
`Fin h` column label. -/
theorem rowSegment_between_block_contacts_subset_qstar
    (B : T.CompressedRowBlocks)
    {b : Fin (B.len + 1)}
    (hbefore :
      (claimB3RowPath I inv (B.blockRow b)).Before
        (T.contact (B.first b)) (T.contact (B.last b))) :
    ((claimB3RowPath I inv (B.blockRow b)).segmentOfBefore hbefore).vertexSet ⊆
      (Q0.data (Q0.selectedColumn j)
        (Q0.selectedColumn_mem_indices j)).qstar.vertexSet := by
  simpa [claimB3ColumnPath, TypeOneQStarFamily.selectedData] using
    B.rowSegment_between_block_contacts_subset_column hbefore

/-- Reverse-orientation version of
`rowSegment_between_block_contacts_subset_column`. -/
theorem rowSegment_between_block_contacts_subset_column_rev
    (B : T.CompressedRowBlocks)
    {b : Fin (B.len + 1)}
    (hbefore :
      (claimB3RowPath I inv (B.blockRow b)).Before
        (T.contact (B.last b)) (T.contact (B.first b))) :
    ((claimB3RowPath I inv (B.blockRow b)).segmentOfBefore hbefore).vertexSet ⊆
      (claimB3ColumnPath I inv j).vertexSet := by
  classical
  intro x hxseg
  let Row : GraphPath G := claimB3RowPath I inv (B.blockRow b)
  have hxrow : x ∈ Row.vertexSet :=
    Row.segmentOfBefore_vertexSet_subset hbefore hxseg
  have hleft :
      Row.Before (T.contact (B.last b)) x :=
    Row.before_of_mem_segmentOfBefore_left hbefore hxseg
  have hright :
      Row.Before x (T.contact (B.first b)) :=
    Row.before_of_mem_segmentOfBefore_right hbefore hxseg
  have hbetween :
      ((claimB3RowPath I inv (B.blockRow b)).vertexIndex
          (T.contact (B.first b)) ≤
        (claimB3RowPath I inv (B.blockRow b)).vertexIndex x ∧
          (claimB3RowPath I inv (B.blockRow b)).vertexIndex x ≤
        (claimB3RowPath I inv (B.blockRow b)).vertexIndex
          (T.contact (B.last b))) ∨
      ((claimB3RowPath I inv (B.blockRow b)).vertexIndex
          (T.contact (B.last b)) ≤
        (claimB3RowPath I inv (B.blockRow b)).vertexIndex x ∧
          (claimB3RowPath I inv (B.blockRow b)).vertexIndex x ≤
        (claimB3RowPath I inv (B.blockRow b)).vertexIndex
          (T.contact (B.first b))) := by
    right
    exact ⟨((Row.before_iff_vertexIndex_le).1 hleft).2.2,
      ((Row.before_iff_vertexIndex_le).1 hright).2.2⟩
  exact B.mem_column_of_same_row_block_between_contacts (by simpa [Row] using hxrow)
    hbetween

/-- Reverse-orientation version of
`rowSegment_between_block_contacts_subset_qstar`. -/
theorem rowSegment_between_block_contacts_subset_qstar_rev
    (B : T.CompressedRowBlocks)
    {b : Fin (B.len + 1)}
    (hbefore :
      (claimB3RowPath I inv (B.blockRow b)).Before
        (T.contact (B.last b)) (T.contact (B.first b))) :
    ((claimB3RowPath I inv (B.blockRow b)).segmentOfBefore hbefore).vertexSet ⊆
      (Q0.data (Q0.selectedColumn j)
        (Q0.selectedColumn_mem_indices j)).qstar.vertexSet := by
  simpa [claimB3ColumnPath, TypeOneQStarFamily.selectedData] using
    B.rowSegment_between_block_contacts_subset_column_rev hbefore

/-- Inside one compressed same-row block of a blocker column, no vertex of a
different selected column can be skipped in row order.  If two contacts in
the block lie on opposite sides of such a vertex, a consecutive pair in the
block already straddles it, and the same-row atom containment forces the
vertex onto the blocker column, contradicting disjointness of selected
columns. -/
theorem no_other_column_straddle_between_contacts_in_block
    (B : T.CompressedRowBlocks)
    {C : ClaimB3HillCandidateData I inv}
    {b : Fin (B.len + 1)}
    (hblock_row : B.blockRow b = C.row)
    {p q : Fin (T.len + 1)}
    (hp_first : (B.first b).1 ≤ p.1)
    (_hp_last : p.1 ≤ (B.last b).1)
    (_hq_first : (B.first b).1 ≤ q.1)
    (hq_last : q.1 ≤ (B.last b).1)
    (hpq : p.1 < q.1)
    {x : V}
    (hxrow : x ∈ (claimB3RowPath I inv C.row).vertexSet)
    (hxcol : x ∈ (claimB3ColumnPath I inv C.col).vertexSet)
    (hj : j ≠ C.col)
    (hstraddle :
      ((claimB3RowPath I inv C.row).vertexIndex (T.contact p) ≤
          (claimB3RowPath I inv C.row).vertexIndex x ∧
        (claimB3RowPath I inv C.row).vertexIndex x ≤
          (claimB3RowPath I inv C.row).vertexIndex (T.contact q)) ∨
      ((claimB3RowPath I inv C.row).vertexIndex (T.contact q) ≤
          (claimB3RowPath I inv C.row).vertexIndex x ∧
        (claimB3RowPath I inv C.row).vertexIndex x ≤
          (claimB3RowPath I inv C.row).vertexIndex (T.contact p))) :
    False := by
  classical
  let Row : GraphPath G := claimB3RowPath I inv C.row
  rcases exists_adjacent_straddle
      (n := T.len) (c := Row.vertexIndex x)
      (f := fun r : Fin (T.len + 1) => Row.vertexIndex (T.contact r))
      hpq (by simpa [Row] using hstraddle) with
    ⟨s, hp_s, hs_q, hpair⟩
  let cur : Fin (T.len + 1) :=
    ⟨s.1, Nat.lt_trans s.2 (Nat.lt_succ_self T.len)⟩
  let nxt : Fin (T.len + 1) :=
    ⟨s.1 + 1, Nat.succ_lt_succ s.2⟩
  have hcur_first : (B.first b).1 ≤ cur.1 := by
    simp [cur]
    omega
  have hcur_last : cur.1 ≤ (B.last b).1 := by
    simp [cur]
    omega
  have hnxt_first : (B.first b).1 ≤ nxt.1 := by
    simp [nxt]
    omega
  have hnxt_last : nxt.1 ≤ (B.last b).1 := by
    simp [nxt]
    omega
  have hcur_row_block : T.row cur = B.blockRow b :=
    B.row_eq_block b cur hcur_first hcur_last
  have hnxt_row_block : T.row nxt = B.blockRow b :=
    B.row_eq_block b nxt hnxt_first hnxt_last
  have hcur_row : T.row cur = C.row := hcur_row_block.trans hblock_row
  have hnxt_row : T.row nxt = C.row := hnxt_row_block.trans hblock_row
  have hsame : T.row cur = T.row nxt := hcur_row.trans hnxt_row.symm
  have hxrow_cur :
      x ∈ (claimB3RowPath I inv (T.row cur)).vertexSet := by
    simpa [hcur_row] using hxrow
  have hbetween :
      ((claimB3RowPath I inv (T.row cur)).vertexIndex (T.contact cur) ≤
          (claimB3RowPath I inv (T.row cur)).vertexIndex x ∧
        (claimB3RowPath I inv (T.row cur)).vertexIndex x ≤
          (claimB3RowPath I inv (T.row cur)).vertexIndex (T.contact nxt)) ∨
      ((claimB3RowPath I inv (T.row cur)).vertexIndex (T.contact nxt) ≤
          (claimB3RowPath I inv (T.row cur)).vertexIndex x ∧
        (claimB3RowPath I inv (T.row cur)).vertexIndex x ≤
          (claimB3RowPath I inv (T.row cur)).vertexIndex (T.contact cur)) := by
    simpa [Row, cur, nxt, hcur_row] using hpair
  exact T.not_other_column_vertex_between_same_row_succ s
    (by simpa [cur, nxt] using hsame) hj hxrow_cur hxcol hbetween

/-- If a compressed blocker block on a candidate row contains one contact in
the candidate row interval, then its first contact is also inside that
interval.  Otherwise one of the interval endpoints is skipped by a same-row
part of the blocker, contradicting disjointness of selected columns. -/
theorem first_mem_rowInterval_of_block_contains_contact
    (B : T.CompressedRowBlocks)
    {C : ClaimB3HillCandidateData I inv}
    {b : Fin (B.len + 1)}
    (hblock_row : B.blockRow b = C.row)
    {r : Fin (T.len + 1)}
    (hr_first : (B.first b).1 ≤ r.1)
    (hr_last : r.1 ≤ (B.last b).1)
    (hr_mem : T.contact r ∈ C.rowInterval.vertexSet)
    (hj : j ≠ C.col) :
    T.contact (B.first b) ∈ C.rowInterval.vertexSet := by
  classical
  let p : Fin (T.len + 1) := B.first b
  by_cases hpr : p.1 = r.1
  · have hp_eq : p = r := Fin.ext hpr
    simpa [p, hp_eq] using hr_mem
  have hp_lt_r : p.1 < r.1 := Nat.lt_of_le_of_ne hr_first hpr
  let Row : GraphPath G := claimB3RowPath I inv C.row
  have hp_row_block : T.row p = B.blockRow b :=
    B.row_eq_block b p (by simp [p]) (by
      simpa [p] using B.first_le_last b)
  have hp_row : T.row p = C.row := hp_row_block.trans hblock_row
  have hp_mem_row : T.contact p ∈ Row.vertexSet := by
    have hp_mem := T.contact_mem_row p
    simpa [Row, hp_row] using hp_mem
  have hr_mem_row : T.contact r ∈ Row.vertexSet :=
    (claimB3RowPath I inv C.row).segmentOfBefore_vertexSet_subset
      C.left_before_right hr_mem
  by_cases hp_mem_interval : T.contact p ∈ C.rowInterval.vertexSet
  · simpa [p] using hp_mem_interval
  exfalso
  have hleft_before_r :
      Row.vertexIndex C.left ≤ Row.vertexIndex (T.contact r) := by
    have hbefore :=
      (claimB3RowPath I inv C.row).before_of_mem_segmentOfBefore_left
        C.left_before_right hr_mem
    exact ((Row.before_iff_vertexIndex_le).1 (by simpa [Row] using hbefore)).2.2
  have hr_before_right :
      Row.vertexIndex (T.contact r) ≤ Row.vertexIndex C.right := by
    have hbefore :=
      (claimB3RowPath I inv C.row).before_of_mem_segmentOfBefore_right
        C.left_before_right hr_mem
    exact ((Row.before_iff_vertexIndex_le).1 (by simpa [Row] using hbefore)).2.2
  have hnot_between :
      ¬ (Row.vertexIndex C.left ≤ Row.vertexIndex (T.contact p) ∧
        Row.vertexIndex (T.contact p) ≤ Row.vertexIndex C.right) := by
    intro hb
    have hleft_p :
        Row.Before C.left (T.contact p) :=
      (Row.before_iff_vertexIndex_le).2 ⟨C.left_mem_row, hp_mem_row, hb.1⟩
    have hp_right :
        Row.Before (T.contact p) C.right :=
      (Row.before_iff_vertexIndex_le).2 ⟨hp_mem_row, C.right_mem_row, hb.2⟩
    exact hp_mem_interval
      (Row.mem_segmentOfBefore_of_before_of_before
        (by simpa [Row] using C.left_before_right) hleft_p hp_right)
  have hboundary :
      (Row.vertexIndex (T.contact p) < Row.vertexIndex C.left) ∨
        (Row.vertexIndex C.right < Row.vertexIndex (T.contact p)) := by
    omega
  rcases hboundary with hbefore_left | hafter_right
  · exact B.no_other_column_straddle_between_contacts_in_block
      hblock_row (p := p) (q := r)
      (by simp [p]) (by simpa [p] using B.first_le_last b)
      hr_first hr_last hp_lt_r
      (x := C.left) C.left_mem_row C.left_mem_column hj
      (by
        left
        exact ⟨by simpa [Row] using Nat.le_of_lt hbefore_left,
          by simpa [Row] using hleft_before_r⟩)
  · exact B.no_other_column_straddle_between_contacts_in_block
      hblock_row (p := p) (q := r)
      (by simp [p]) (by simpa [p] using B.first_le_last b)
      hr_first hr_last hp_lt_r
      (x := C.right) C.right_mem_row C.right_mem_column hj
      (by
        right
        exact ⟨by simpa [Row] using hr_before_right,
          by simpa [Row] using Nat.le_of_lt hafter_right⟩)

/-- If a compressed blocker block on a candidate row contains one contact in
the candidate row interval, then its last contact is also inside that
interval.  This is the right-end analogue of
`first_mem_rowInterval_of_block_contains_contact`. -/
theorem last_mem_rowInterval_of_block_contains_contact
    (B : T.CompressedRowBlocks)
    {C : ClaimB3HillCandidateData I inv}
    {b : Fin (B.len + 1)}
    (hblock_row : B.blockRow b = C.row)
    {r : Fin (T.len + 1)}
    (hr_first : (B.first b).1 ≤ r.1)
    (hr_last : r.1 ≤ (B.last b).1)
    (hr_mem : T.contact r ∈ C.rowInterval.vertexSet)
    (hj : j ≠ C.col) :
    T.contact (B.last b) ∈ C.rowInterval.vertexSet := by
  classical
  let q : Fin (T.len + 1) := B.last b
  by_cases hrq : r.1 = q.1
  · have hr_eq : r = q := Fin.ext hrq
    simpa [q, hr_eq] using hr_mem
  have hr_lt_q : r.1 < q.1 := Nat.lt_of_le_of_ne hr_last hrq
  let Row : GraphPath G := claimB3RowPath I inv C.row
  have hq_row_block : T.row q = B.blockRow b :=
    B.row_eq_block b q (B.first_le_last b) (by simp [q])
  have hq_row : T.row q = C.row := hq_row_block.trans hblock_row
  have hq_mem_row : T.contact q ∈ Row.vertexSet := by
    have hq_mem := T.contact_mem_row q
    simpa [Row, hq_row] using hq_mem
  have hr_mem_row : T.contact r ∈ Row.vertexSet :=
    (claimB3RowPath I inv C.row).segmentOfBefore_vertexSet_subset
      C.left_before_right hr_mem
  by_cases hq_mem_interval : T.contact q ∈ C.rowInterval.vertexSet
  · simpa [q] using hq_mem_interval
  exfalso
  have hleft_before_r :
      Row.vertexIndex C.left ≤ Row.vertexIndex (T.contact r) := by
    have hbefore :=
      (claimB3RowPath I inv C.row).before_of_mem_segmentOfBefore_left
        C.left_before_right hr_mem
    exact ((Row.before_iff_vertexIndex_le).1 (by simpa [Row] using hbefore)).2.2
  have hr_before_right :
      Row.vertexIndex (T.contact r) ≤ Row.vertexIndex C.right := by
    have hbefore :=
      (claimB3RowPath I inv C.row).before_of_mem_segmentOfBefore_right
        C.left_before_right hr_mem
    exact ((Row.before_iff_vertexIndex_le).1 (by simpa [Row] using hbefore)).2.2
  have hnot_between :
      ¬ (Row.vertexIndex C.left ≤ Row.vertexIndex (T.contact q) ∧
        Row.vertexIndex (T.contact q) ≤ Row.vertexIndex C.right) := by
    intro hb
    have hleft_q :
        Row.Before C.left (T.contact q) :=
      (Row.before_iff_vertexIndex_le).2 ⟨C.left_mem_row, hq_mem_row, hb.1⟩
    have hq_right :
        Row.Before (T.contact q) C.right :=
      (Row.before_iff_vertexIndex_le).2 ⟨hq_mem_row, C.right_mem_row, hb.2⟩
    exact hq_mem_interval
      (Row.mem_segmentOfBefore_of_before_of_before
        (by simpa [Row] using C.left_before_right) hleft_q hq_right)
  have hboundary :
      (Row.vertexIndex (T.contact q) < Row.vertexIndex C.left) ∨
        (Row.vertexIndex C.right < Row.vertexIndex (T.contact q)) := by
    omega
  rcases hboundary with hbefore_left | hafter_right
  · exact B.no_other_column_straddle_between_contacts_in_block
      hblock_row (p := r) (q := q)
      hr_first hr_last (by simpa [q] using B.first_le_last b)
      (by simp [q]) hr_lt_q
      (x := C.left) C.left_mem_row C.left_mem_column hj
      (by
        right
        exact ⟨by simpa [Row] using Nat.le_of_lt hbefore_left,
          by simpa [Row] using hleft_before_r⟩)
  · exact B.no_other_column_straddle_between_contacts_in_block
      hblock_row (p := r) (q := q)
      hr_first hr_last (by simpa [q] using B.first_le_last b)
      (by simp [q]) hr_lt_q
      (x := C.right) C.right_mem_row C.right_mem_column hj
      (by
        left
        exact ⟨by simpa [Row] using hr_before_right,
          by simpa [Row] using Nat.le_of_lt hafter_right⟩)

/-- A blocker compressed block on the candidate row, with both neighboring
blocks on the row above, supplies the higher-hill endpoint data used by the
finite ascent proof of Claim B.3. -/
theorem higherHillFromBlockerData_of_block_with_upper_neighbors
    (B : T.CompressedRowBlocks)
    {C : ClaimB3HillCandidateData I inv}
    {b : Fin (B.len + 1)}
    (hblock_row : B.blockRow b = C.row)
    (hb_pos : 0 < b.1)
    (hb_lt : b.1 < B.len)
    (hprev_upper :
      C.row.1 + 1 =
        (B.blockRow ⟨b.1 - 1, by omega⟩).1)
    (hnext_upper :
      C.row.1 + 1 =
        (B.blockRow ⟨b.1 + 1, by omega⟩).1) :
    Nonempty (ClaimB3HigherHillFromBlockerData inv C j) := by
  classical
  have hprev_upper' :
      (B.blockRow b).1 + 1 =
        (B.blockRow ⟨b.1 - 1, by omega⟩).1 := by
    simpa [hblock_row] using hprev_upper
  have hnext_upper' :
      (B.blockRow b).1 + 1 =
        (B.blockRow ⟨b.1 + 1, by omega⟩).1 := by
    simpa [hblock_row] using hnext_upper
  rcases B.hillValley_of_block_with_upper_neighbors
      hb_pos hb_lt hprev_upper' hnext_upper' with ⟨Vly, hrowLower⟩
  exact ⟨Vly.toHigherHillFromBlockerData (hrowLower.trans hblock_row)⟩

/-- In an exact unit-step compressed trace, a block on the candidate row whose
two neighboring blocks are not on the lower row must have both neighbors on
the upper row; consequently it yields the higher-hill endpoint data. -/
theorem higherHillFromBlockerData_of_block_without_lower_neighbors
    (B : T.CompressedRowBlocks)
    {C : ClaimB3HillCandidateData I inv}
    {b : Fin (B.len + 1)}
    (hblock_row : B.blockRow b = C.row)
    (hb_pos : 0 < b.1)
    (hb_lt : b.1 < B.len)
    (hprev_not_lower :
      (B.blockRow ⟨b.1 - 1, by omega⟩).1 + 1 ≠ C.row.1)
    (hnext_not_lower :
      (B.blockRow ⟨b.1 + 1, by omega⟩).1 + 1 ≠ C.row.1) :
    Nonempty (ClaimB3HigherHillFromBlockerData inv C j) := by
  classical
  let prev : Fin (B.len + 1) := ⟨b.1 - 1, by omega⟩
  let next : Fin (B.len + 1) := ⟨b.1 + 1, by omega⟩
  let eprev : Fin B.len := ⟨b.1 - 1, by omega⟩
  let ecur : Fin B.len := ⟨b.1, by omega⟩
  have hb_prev_succ :
      (⟨(b.1 - 1) + 1, by omega⟩ : Fin (B.len + 1)) = b := by
    apply Fin.ext
    simp
    omega
  have hprev_upper :
      C.row.1 + 1 = (B.blockRow prev).1 := by
    rcases B.exact_step eprev with hdown | hup
    · have h :
          (B.blockRow b).1 + 1 = (B.blockRow prev).1 := by
        simpa [prev, eprev, hb_prev_succ] using hdown
      simpa [hblock_row] using h
    · have hbelow :
          (B.blockRow prev).1 + 1 = C.row.1 := by
        have h :
            (B.blockRow prev).1 + 1 = (B.blockRow b).1 := by
          simpa [prev, eprev, hb_prev_succ] using hup
        simpa [hblock_row] using h
      exact False.elim (hprev_not_lower (by simpa [prev] using hbelow))
  have hnext_upper :
      C.row.1 + 1 = (B.blockRow next).1 := by
    rcases B.exact_step ecur with hdown | hup
    · have hbelow :
          (B.blockRow next).1 + 1 = C.row.1 := by
        have h :
            (B.blockRow next).1 + 1 = (B.blockRow b).1 := by
          simpa [next, ecur] using hdown
        simpa [hblock_row] using h
      exact False.elim (hnext_not_lower (by simpa [next] using hbelow))
    · have h :
          (B.blockRow b).1 + 1 = (B.blockRow next).1 := by
        simpa [next, ecur] using hup
      simpa [hblock_row] using h
  exact B.higherHillFromBlockerData_of_block_with_upper_neighbors
    hblock_row hb_pos hb_lt
    (by simpa [prev] using hprev_upper)
    (by simpa [next] using hnext_upper)

/-- Valley-level version of
`higherHillFromBlockerData_of_block_without_lower_neighbors`.

This keeps the actual blocker-trace hill interval, rather than immediately
forgetting it to endpoint data.  It is the form needed for the bracketed
finite-ascent proof: the next hill candidate is again one generated by a raw
row-contact trace. -/
theorem hillValley_of_block_without_lower_neighbors
    (B : T.CompressedRowBlocks)
    {C : ClaimB3HillCandidateData I inv}
    {b : Fin (B.len + 1)}
    (hblock_row : B.blockRow b = C.row)
    (hb_pos : 0 < b.1)
    (hb_lt : b.1 < B.len)
    (hprev_not_lower :
      (B.blockRow ⟨b.1 - 1, by omega⟩).1 + 1 ≠ C.row.1)
    (hnext_not_lower :
      (B.blockRow ⟨b.1 + 1, by omega⟩).1 + 1 ≠ C.row.1) :
    ∃ Vly : T.HillValley, Vly.rowLower = C.row := by
  classical
  let prev : Fin (B.len + 1) := ⟨b.1 - 1, by omega⟩
  let next : Fin (B.len + 1) := ⟨b.1 + 1, by omega⟩
  let eprev : Fin B.len := ⟨b.1 - 1, by omega⟩
  let ecur : Fin B.len := ⟨b.1, by omega⟩
  have hb_prev_succ :
      (⟨(b.1 - 1) + 1, by omega⟩ : Fin (B.len + 1)) = b := by
    apply Fin.ext
    simp
    omega
  have hprev_upper :
      C.row.1 + 1 = (B.blockRow prev).1 := by
    rcases B.exact_step eprev with hdown | hup
    · have h :
          (B.blockRow b).1 + 1 = (B.blockRow prev).1 := by
        simpa [prev, eprev, hb_prev_succ] using hdown
      simpa [hblock_row] using h
    · have hbelow :
          (B.blockRow prev).1 + 1 = C.row.1 := by
        have h :
            (B.blockRow prev).1 + 1 = (B.blockRow b).1 := by
          simpa [prev, eprev, hb_prev_succ] using hup
        simpa [hblock_row] using h
      exact False.elim (hprev_not_lower (by simpa [prev] using hbelow))
  have hnext_upper :
      C.row.1 + 1 = (B.blockRow next).1 := by
    rcases B.exact_step ecur with hdown | hup
    · have hbelow :
          (B.blockRow next).1 + 1 = C.row.1 := by
        have h :
            (B.blockRow next).1 + 1 = (B.blockRow b).1 := by
          simpa [next, ecur] using hdown
        simpa [hblock_row] using h
      exact False.elim (hnext_not_lower (by simpa [next] using hbelow))
    · have h :
          (B.blockRow b).1 + 1 = (B.blockRow next).1 := by
        simpa [next, ecur] using hup
      simpa [hblock_row] using h
  have hprev_upper' :
      (B.blockRow b).1 + 1 = (B.blockRow prev).1 := by
    simpa [hblock_row] using hprev_upper
  have hnext_upper' :
      (B.blockRow b).1 + 1 = (B.blockRow next).1 := by
    simpa [hblock_row] using hnext_upper
  rcases B.hillValley_of_block_with_upper_neighbors
      hb_pos hb_lt
      (by simpa [prev] using hprev_upper')
      (by simpa [next] using hnext_upper') with
    ⟨Vly, hrowLower⟩
  exact ⟨Vly, hrowLower.trans hblock_row⟩

end CompressedRowBlocks

end ClaimB3RowContactTrace

/-- Trace-level extraction package for Claim B.3.  The only remaining
combinatorial trace choice is the standard finite-list fact that a
non-convex row trace contains a hill interval in the compressed row trace.
Once such an interval is supplied, `HillValley.toHillCandidateData` proves
that it is a genuine hill candidate. -/
structure ClaimB3TraceValleyExtractionCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  trace : ∀ j : Fin h, ClaimB3RowContactTrace I inv j
  hill_valley_of_maximal_nonconvex_trace :
    ∀ M : ClaimB3MaximalNonconvexTrace I inv,
        Nonempty ((trace M.col).HillValley)

namespace ClaimB3TraceValleyExtractionCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Compatibility constructor from the older strict local-valley formulation.
The current certificate uses hill intervals, but any three-consecutive-contact
valley is automatically such an interval. -/
noncomputable def ofLocalValleys
    (trace : ∀ j : Fin h, ClaimB3RowContactTrace I inv j)
    (local_valley_of_maximal_nonconvex_trace :
      ∀ M : ClaimB3MaximalNonconvexTrace I inv,
          Nonempty ((trace M.col).LocalValley)) :
    ClaimB3TraceValleyExtractionCertificate I inv where
  trace := trace
  hill_valley_of_maximal_nonconvex_trace := by
    intro M
    rcases local_valley_of_maximal_nonconvex_trace M with ⟨Vly⟩
    exact ⟨ClaimB3RowContactTrace.HillValley.ofLocalValley Vly⟩

/-- Direct constructor from complete raw row-contact traces.  A non-convex
trace forces an upward raw step; the first such step gives a hill interval
after absorbing same-row stutters. -/
noncomputable def ofRawTraces
    (trace : ∀ j : Fin h, ClaimB3RowContactTrace I inv j)
    (hfirst_max :
      ∀ j : Fin h, ∀ k : Fin ((trace j).len + 1),
        ((trace j).row k).1 ≤ ((trace j).row ⟨0, by omega⟩).1) :
    ClaimB3TraceValleyExtractionCertificate I inv where
  trace := trace
  hill_valley_of_maximal_nonconvex_trace := by
    intro M
    let T := trace M.col
    exact T.hillValley_of_up_step (hfirst_max M.col)
      (T.exists_up_step_of_nonconvex_trace
        T.betweenContactBracketCertificate M.witness)

/-- A row-trace valley extraction certificate gives the hill-candidate
extraction step used by the path-level Claim B.3 proof. -/
theorem candidate_of_nonconvex_trace
    (C : ClaimB3TraceValleyExtractionCertificate I inv)
    (hbad : ∃ i : Fin (z h), ∃ j : Fin h,
      Nonempty (ClaimB3NonconvexTrace I inv i j)) :
    Nonempty (ClaimB3HillCandidateData I inv) := by
  rcases ClaimB3MaximalNonconvexTrace.exists_of_any (I := I) (inv := inv)
      hbad with ⟨M⟩
  rcases C.hill_valley_of_maximal_nonconvex_trace M with ⟨Vly⟩
  exact ⟨Vly.toHillCandidateData⟩

end ClaimB3TraceValleyExtractionCertificate

/-- Trace-level extraction package stated at the compressed-row-block level.
This is closer to the paper's Claim B.3 argument: after equal-row runs are
compressed, a maximal non-convex trace is not strictly descending, so the
proved finite trace lemma produces the required hill interval. -/
structure ClaimB3TraceCompressionExtractionCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  trace : ∀ j : Fin h, ClaimB3RowContactTrace I inv j
  blocks : ∀ j : Fin h, (trace j).CompressedRowBlocks

namespace ClaimB3TraceCompressionExtractionCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Build the compressed trace extraction package when the supplied traces
have already had equal-row stutters removed. -/
def ofNoStutter
    (trace : ∀ j : Fin h, ClaimB3RowContactTrace I inv j)
    (hno_stutter :
      ∀ j : Fin h, ∀ r : Fin (trace j).len,
        (trace j).row ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self (trace j).len)⟩ ≠
          (trace j).row ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩)
    (hfirst_max :
      ∀ j : Fin h, ∀ k : Fin ((trace j).len + 1),
        ((trace j).row k).1 ≤ ((trace j).row ⟨0, by omega⟩).1) :
    ClaimB3TraceCompressionExtractionCertificate I inv where
  trace := trace
  blocks j :=
    (trace j).compressedRowBlocksOfNoStutter
      (hno_stutter j) (hfirst_max j)

/-- Convert the compressed-block form of the trace extraction proof to the
hill-valley form used by the existing path-level Claim B.3 proof. -/
def toTraceValleyExtractionCertificate
    (C : ClaimB3TraceCompressionExtractionCertificate I inv) :
    ClaimB3TraceValleyExtractionCertificate I inv where
  trace := C.trace
  hill_valley_of_maximal_nonconvex_trace := by
    intro M
    exact (C.blocks M.col).hillValley_of_not_strictDown
      ((C.blocks M.col).not_strictDown_of_nonconvex_trace
        ((C.trace M.col).betweenContactBracketCertificate) M.witness)

/-- The compressed-block extraction certificate directly supplies the
hill-candidate extraction step. -/
theorem candidate_of_nonconvex_trace
    (C : ClaimB3TraceCompressionExtractionCertificate I inv)
    (hbad : ∃ i : Fin (z h), ∃ j : Fin h,
      Nonempty (ClaimB3NonconvexTrace I inv i j)) :
    Nonempty (ClaimB3HillCandidateData I inv) :=
  C.toTraceValleyExtractionCertificate.candidate_of_nonconvex_trace hbad

end ClaimB3TraceCompressionExtractionCertificate

/-- Trace-compression data with the consecutive-contact atomization retained.

The older `ClaimB3TraceCompressionExtractionCertificate` is enough for the
finite hill-ascent proof, but the remaining blocker-barrier construction also
needs the raw atoms adjacent to compressed blocker blocks.  This certificate
keeps the trace, atomization, and block decomposition definitionally aligned. -/
structure ClaimB3AtomizedTraceCompressionExtractionCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  stripCertificate : ClaimB2PlanarStripCertificate I inv
  atomization : ∀ j : Fin h, ClaimB3ConsecutiveContactAtomization I inv j
  blocks :
    ∀ j : Fin h,
      ((atomization j).toRowContactTrace stripCertificate).CompressedRowBlocks

namespace ClaimB3AtomizedTraceCompressionExtractionCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- The raw trace generated by the retained atomization. -/
noncomputable def trace
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (j : Fin h) : ClaimB3RowContactTrace I inv j :=
  (C.atomization j).toRowContactTrace C.stripCertificate

/-- Forget atomization to the compressed trace-extraction package. -/
noncomputable def toTraceCompressionExtractionCertificate
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv) :
    ClaimB3TraceCompressionExtractionCertificate I inv where
  trace := C.trace
  blocks := C.blocks

/-- Raw trace edge from the previous compressed block into `b`. -/
noncomputable def prevBoundaryEdge
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (j : Fin h) {b : Fin ((C.blocks j).len + 1)} (hbpos : 0 < b.1) :
    Fin ((C.trace j).len) :=
  let B := C.blocks j
  let prev : Fin (B.len + 1) := ⟨b.1 - 1, by dsimp [B]; omega⟩
  ⟨(B.last prev).1, by
    have hnext :
        (B.last prev).1 + 1 = (B.first b).1 := by
      let e : Fin B.len := ⟨b.1 - 1, by dsimp [B]; omega⟩
      have hb :
          (⟨(b.1 - 1) + 1, by dsimp [B]; omega⟩ :
            Fin (B.len + 1)) = b := by
        apply Fin.ext
        simp
        omega
      simpa [prev, e, hb] using B.next e
    have hfirst_lt : (B.first b).1 < (C.trace j).len + 1 :=
      (B.first b).2
    omega⟩

/-- Raw trace edge from `b` into the next compressed block. -/
noncomputable def nextBoundaryEdge
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (j : Fin h) {b : Fin ((C.blocks j).len + 1)}
    (hblt : b.1 < (C.blocks j).len) :
    Fin ((C.trace j).len) :=
  let B := C.blocks j
  ⟨(B.last b).1, by
    let e : Fin B.len := ⟨b.1, by dsimp [B]; exact hblt⟩
    have hnext :
        (B.last b).1 + 1 =
          (B.first ⟨b.1 + 1, by dsimp [B]; omega⟩).1 := by
      simpa [e] using B.next e
    have hfirst_lt :
        (B.first ⟨b.1 + 1, by dsimp [B]; omega⟩).1 <
          (C.trace j).len + 1 :=
      (B.first ⟨b.1 + 1, by dsimp [B]; omega⟩).2
    omega⟩

/-- The atom crossing from the previous compressed block into `b`. -/
noncomputable def prevBoundaryAtom
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (j : Fin h) {b : Fin ((C.blocks j).len + 1)} (hbpos : 0 < b.1) :
    ClaimB2Atom I :=
  (C.atomization j).atomAtTraceEdge C.stripCertificate
    (C.prevBoundaryEdge j hbpos)

/-- The atom crossing from `b` into the next compressed block. -/
noncomputable def nextBoundaryAtom
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (j : Fin h) {b : Fin ((C.blocks j).len + 1)}
    (hblt : b.1 < (C.blocks j).len) :
    ClaimB2Atom I :=
  (C.atomization j).atomAtTraceEdge C.stripCertificate
    (C.nextBoundaryEdge j hblt)

@[simp] theorem prevBoundaryAtom_qIndex
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (j : Fin h) {b : Fin ((C.blocks j).len + 1)} (hbpos : 0 < b.1) :
    (C.prevBoundaryAtom j hbpos).qIndex = Q0.selectedColumn j := by
  simp [prevBoundaryAtom]

@[simp] theorem nextBoundaryAtom_qIndex
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (j : Fin h) {b : Fin ((C.blocks j).len + 1)}
    (hblt : b.1 < (C.blocks j).len) :
    (C.nextBoundaryAtom j hblt).qIndex = Q0.selectedColumn j := by
  simp [nextBoundaryAtom]

theorem prevBoundaryAtom_rowStart_order
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (j : Fin h) {b : Fin ((C.blocks j).len + 1)} (hbpos : 0 < b.1) :
    inv.orderedRows.order (C.prevBoundaryAtom j hbpos).rowStart =
      (C.blocks j).blockRow ⟨b.1 - 1, by omega⟩ := by
  classical
  let B := C.blocks j
  let prev : Fin (B.len + 1) := ⟨b.1 - 1, by dsimp [B]; omega⟩
  let e : Fin B.len := ⟨b.1 - 1, by dsimp [B]; omega⟩
  have hraw :
      (C.prevBoundaryEdge j hbpos).1 = (B.last prev).1 := rfl
  have hrow :
      (C.trace j).row
          ⟨(C.prevBoundaryEdge j hbpos).1,
            Nat.lt_trans (C.prevBoundaryEdge j hbpos).2
              (Nat.lt_succ_self (C.trace j).len)⟩ =
        B.blockRow prev := by
    simpa [hraw] using B.row_eq_block prev (B.last prev)
      (B.first_le_last prev) (by rfl)
  have hatom :=
    (C.atomization j).atomAtTraceEdge_rowStart_order C.stripCertificate
      (C.prevBoundaryEdge j hbpos)
  exact hatom.trans hrow

theorem prevBoundaryAtom_rowStop_order
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (j : Fin h) {b : Fin ((C.blocks j).len + 1)} (hbpos : 0 < b.1) :
    inv.orderedRows.order (C.prevBoundaryAtom j hbpos).rowStop =
      (C.blocks j).blockRow b := by
  classical
  let B := C.blocks j
  let prev : Fin (B.len + 1) := ⟨b.1 - 1, by dsimp [B]; omega⟩
  let e : Fin B.len := ⟨b.1 - 1, by dsimp [B]; omega⟩
  have hnext :
      (B.last prev).1 + 1 = (B.first b).1 := by
    have hb :
        (⟨(b.1 - 1) + 1, by dsimp [B]; omega⟩ :
          Fin (B.len + 1)) = b := by
      apply Fin.ext
      simp
      omega
    simpa [prev, e, hb] using B.next e
  have hraw :
      (C.prevBoundaryEdge j hbpos).1 + 1 = (B.first b).1 := by
    simpa [prevBoundaryEdge, B, prev] using hnext
  have hrow :
      (C.trace j).row
          ⟨(C.prevBoundaryEdge j hbpos).1 + 1,
            Nat.succ_lt_succ (C.prevBoundaryEdge j hbpos).2⟩ =
        B.blockRow b := by
    have hfin :
        (⟨(C.prevBoundaryEdge j hbpos).1 + 1,
            Nat.succ_lt_succ (C.prevBoundaryEdge j hbpos).2⟩ :
          Fin ((C.trace j).len + 1)) = B.first b := by
      exact Fin.ext hraw
    simpa [hfin] using B.row_eq_block b (B.first b) (by rfl)
      (B.first_le_last b)
  have hatom :=
    (C.atomization j).atomAtTraceEdge_rowStop_order C.stripCertificate
      (C.prevBoundaryEdge j hbpos)
  exact hatom.trans hrow

theorem nextBoundaryAtom_rowStart_order
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (j : Fin h) {b : Fin ((C.blocks j).len + 1)}
    (hblt : b.1 < (C.blocks j).len) :
    inv.orderedRows.order (C.nextBoundaryAtom j hblt).rowStart =
      (C.blocks j).blockRow b := by
  classical
  let B := C.blocks j
  have hraw :
      (C.nextBoundaryEdge j hblt).1 = (B.last b).1 := rfl
  have hrow :
      (C.trace j).row
          ⟨(C.nextBoundaryEdge j hblt).1,
            Nat.lt_trans (C.nextBoundaryEdge j hblt).2
              (Nat.lt_succ_self (C.trace j).len)⟩ =
        B.blockRow b := by
    simpa [hraw] using B.row_eq_block b (B.last b)
      (B.first_le_last b) (by rfl)
  have hatom :=
    (C.atomization j).atomAtTraceEdge_rowStart_order C.stripCertificate
      (C.nextBoundaryEdge j hblt)
  exact hatom.trans hrow

theorem nextBoundaryAtom_rowStop_order
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (j : Fin h) {b : Fin ((C.blocks j).len + 1)}
    (hblt : b.1 < (C.blocks j).len) :
    inv.orderedRows.order (C.nextBoundaryAtom j hblt).rowStop =
      (C.blocks j).blockRow ⟨b.1 + 1, by omega⟩ := by
  classical
  let B := C.blocks j
  let e : Fin B.len := ⟨b.1, by dsimp [B]; exact hblt⟩
  let next : Fin (B.len + 1) := ⟨b.1 + 1, by dsimp [B]; omega⟩
  have hnext :
      (B.last b).1 + 1 = (B.first next).1 := by
    simpa [e, next] using B.next e
  have hraw :
      (C.nextBoundaryEdge j hblt).1 + 1 = (B.first next).1 := by
    simpa [nextBoundaryEdge, B, next] using hnext
  have hrow :
      (C.trace j).row
          ⟨(C.nextBoundaryEdge j hblt).1 + 1,
            Nat.succ_lt_succ (C.nextBoundaryEdge j hblt).2⟩ =
        B.blockRow next := by
    have hfin :
        (⟨(C.nextBoundaryEdge j hblt).1 + 1,
            Nat.succ_lt_succ (C.nextBoundaryEdge j hblt).2⟩ :
          Fin ((C.trace j).len + 1)) = B.first next := by
      exact Fin.ext hraw
    simpa [hfin] using B.row_eq_block next (B.first next) (by rfl)
      (B.first_le_last next)
  have hatom :=
    (C.atomization j).atomAtTraceEdge_rowStop_order C.stripCertificate
      (C.nextBoundaryEdge j hblt)
  exact hatom.trans hrow

@[simp] theorem prevBoundaryAtom_stop_eq_first
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (j : Fin h) {b : Fin ((C.blocks j).len + 1)} (hbpos : 0 < b.1) :
    (C.prevBoundaryAtom j hbpos).stop =
      (C.trace j).contact ((C.blocks j).first b) := by
  classical
  let B := C.blocks j
  let prev : Fin (B.len + 1) := ⟨b.1 - 1, by dsimp [B]; omega⟩
  let e : Fin B.len := ⟨b.1 - 1, by dsimp [B]; omega⟩
  have hnext :
      (B.last prev).1 + 1 = (B.first b).1 := by
    have hb :
        (⟨(b.1 - 1) + 1, by dsimp [B]; omega⟩ :
          Fin (B.len + 1)) = b := by
      apply Fin.ext
      simp
      omega
    simpa [prev, e, hb] using B.next e
  have hraw :
      (C.prevBoundaryEdge j hbpos).1 + 1 = (B.first b).1 := by
    simpa [prevBoundaryEdge, B, prev] using hnext
  have hfin :
      (⟨(C.prevBoundaryEdge j hbpos).1 + 1,
          Nat.succ_lt_succ (C.prevBoundaryEdge j hbpos).2⟩ :
        Fin ((C.trace j).len + 1)) = B.first b := by
    exact Fin.ext hraw
  change
    ((C.atomization j).atomAtTraceEdge C.stripCertificate
      (C.prevBoundaryEdge j hbpos)).stop =
      (C.trace j).contact (B.first b)
  rw [(C.atomization j).atomAtTraceEdge_stop_eq C.stripCertificate
    (C.prevBoundaryEdge j hbpos)]
  exact congrArg (fun x => (C.trace j).contact x) hfin

@[simp] theorem nextBoundaryAtom_start_eq_last
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (j : Fin h) {b : Fin ((C.blocks j).len + 1)}
    (hblt : b.1 < (C.blocks j).len) :
    (C.nextBoundaryAtom j hblt).start =
      (C.trace j).contact ((C.blocks j).last b) := by
  classical
  simp [nextBoundaryAtom, nextBoundaryEdge, trace]

/-- If the previous compressed block is the lower row of a hill candidate,
then the previous boundary atom is oriented lower-to-top. -/
theorem prevBoundaryAtom_rows_of_prev_lower
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (j : Fin h) {H : ClaimB3HillCandidateData I inv}
    (Bkt : ClaimB3HillBracketAtomData inv H)
    {b : Fin ((C.blocks j).len + 1)}
    (hbpos : 0 < b.1)
    (hblock_row : (C.blocks j).blockRow b = H.row)
    (hprev_lower :
      ((C.blocks j).blockRow ⟨b.1 - 1, by omega⟩).1 + 1 = H.row.1) :
    (C.prevBoundaryAtom j hbpos).rowStart = Bkt.lowerRow ∧
      (C.prevBoundaryAtom j hbpos).rowStop = Bkt.top := by
  classical
  constructor
  · apply inv.orderedRows.order.injective
    have hstart := C.prevBoundaryAtom_rowStart_order j hbpos
    have hval :
        ((C.blocks j).blockRow ⟨b.1 - 1, by omega⟩).1 = H.lower.1 := by
      have hlower := H.lower_succ
      omega
    apply Fin.ext
    calc
      (inv.orderedRows.order (C.prevBoundaryAtom j hbpos).rowStart).1
          = ((C.blocks j).blockRow ⟨b.1 - 1, by omega⟩).1 := by
            rw [hstart]
      _ = H.lower.1 := hval
      _ = (inv.orderedRows.order Bkt.lowerRow).1 := by
            rw [Bkt.lower_order]
  · apply inv.orderedRows.order.injective
    have hstop := C.prevBoundaryAtom_rowStop_order j hbpos
    apply Fin.ext
    calc
      (inv.orderedRows.order (C.prevBoundaryAtom j hbpos).rowStop).1
          = ((C.blocks j).blockRow b).1 := by
            rw [hstop]
      _ = H.row.1 := by rw [hblock_row]
      _ = (inv.orderedRows.order Bkt.top).1 := by
            rw [Bkt.top_order]

/-- If the next compressed block is the lower row of a hill candidate, then
the next boundary atom is oriented top-to-lower. -/
theorem nextBoundaryAtom_rows_of_next_lower
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (j : Fin h) {H : ClaimB3HillCandidateData I inv}
    (Bkt : ClaimB3HillBracketAtomData inv H)
    {b : Fin ((C.blocks j).len + 1)}
    (hblt : b.1 < (C.blocks j).len)
    (hblock_row : (C.blocks j).blockRow b = H.row)
    (hnext_lower :
      ((C.blocks j).blockRow ⟨b.1 + 1, by omega⟩).1 + 1 = H.row.1) :
    (C.nextBoundaryAtom j hblt).rowStart = Bkt.top ∧
      (C.nextBoundaryAtom j hblt).rowStop = Bkt.lowerRow := by
  classical
  constructor
  · apply inv.orderedRows.order.injective
    have hstart := C.nextBoundaryAtom_rowStart_order j hblt
    apply Fin.ext
    calc
      (inv.orderedRows.order (C.nextBoundaryAtom j hblt).rowStart).1
          = ((C.blocks j).blockRow b).1 := by
            rw [hstart]
      _ = H.row.1 := by rw [hblock_row]
      _ = (inv.orderedRows.order Bkt.top).1 := by
            rw [Bkt.top_order]
  · apply inv.orderedRows.order.injective
    have hstop := C.nextBoundaryAtom_rowStop_order j hblt
    have hval :
        ((C.blocks j).blockRow ⟨b.1 + 1, by omega⟩).1 = H.lower.1 := by
      have hlower := H.lower_succ
      omega
    apply Fin.ext
    calc
      (inv.orderedRows.order (C.nextBoundaryAtom j hblt).rowStop).1
          = ((C.blocks j).blockRow ⟨b.1 + 1, by omega⟩).1 := by
            rw [hstop]
      _ = H.lower.1 := hval
      _ = (inv.orderedRows.order Bkt.lowerRow).1 := by
            rw [Bkt.lower_order]

/-- Raw atom immediately before a chosen row-contact index. -/
noncomputable def prevRawBoundaryAtom
  (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (j : Fin h) {r : Fin ((C.trace j).len + 1)} (hrpos : 0 < r.1) :
    ClaimB2Atom I :=
  (C.atomization j).atomAtTraceEdge C.stripCertificate
    ⟨r.1 - 1, by
      have hr :
          r.1 <
            ((C.atomization j).toRowContactTrace C.stripCertificate).len + 1 := by
        simpa [ClaimB3AtomizedTraceCompressionExtractionCertificate.trace] using r.2
      omega⟩

