  refine reroutingConclusion_of_page60_typeOne_paper_updates_sparse_terminal_autoInitial
    (L := L) (h := h) hbad hlink hpos ?_ ?_ ?_ ?_
  · intro R Q S I Inv Bump
    let T :=
      TypeOneExtendedFutureCleanIterationInvariants.bumpLocalTripleData
        (R := R) (hpos := hpos) (Q := Q) (Q0 := S.Q0) (I := I)
        Inv Bump
    let N :=
      TypeOneBumpLeftOutsideNeighborData.ofInvariant
        (R := R) (hpos := hpos) (Q := Q) (Q0 := S.Q0) (I := I)
        Inv Bump
    have hsupport :
        AdjChangeSupportedIn (linkageAuxGraph I.linkage)
          (linkageAuxGraph Bump.replacementLinkageConcrete)
          ({T.left, I.rowIndex Bump.row, T.right} :
              Finset I.linkage.Index) := by
      simpa [T] using
        Bump.bump_adjChangeSupportedIn T.left T.right
          T.left_adj_mid T.mid_adj_right T.mid_degree_two T.left_ne_right
    exact
      Bump.paperActionUpdate_of_supportedLocalDichotomy_constructedSuccessor_fromLocalData_conditional_autoAdj
        Inv
        (D.hbump_successorRows S Inv Bump)
        N.auxL T.left T.right hsupport
        N.left_adj_auxL T.left_adj_mid T.mid_adj_right
        T.left_degree_two T.mid_degree_two T.right_degree_two
        N.auxL_ne_left N.auxL_ne_mid N.auxL_ne_right
        T.left_ne_mid T.left_ne_right T.mid_ne_right
  · intro R Q S I Inv Cross
    let C :=
      CrossWitness.CrossLocalOutsideData.ofInvariant
        (R := R) (hpos := hpos) (Q := Q) (Q0 := S.Q0) (I := I)
        Inv Cross
    exact
      Cross.paperActionUpdate_of_localDegreeTest_constructedSuccessor_byLeftLocalRightAttachments_conditional
        Inv C.auxL C.auxA C.auxD C.auxR
        C.hLA_old C.hAU_old C.hUV_old C.hVD_old C.hDR_old
        C.hA_old C.hU_old C.hV_old C.hD_old
        C.hL_not C.hR_not C.hLU C.hRV C.hAU_ne C.hAD C.hUD
        C.hAV C.hDV C.hLD
        (D.hcross_leftRight_successorRows S Inv Cross)
        (D.hcross_rightLeft_successorRows S Inv Cross)
  · intro R Q S I Inv hterm
    exact
      (D.hterminal (R := R) (Q := Q) S I Inv hterm).toTerminalSparseGridTraceCertificate
  · intro R Q T
    exact D.hTypeTwo (R := R) (Q := Q) T

