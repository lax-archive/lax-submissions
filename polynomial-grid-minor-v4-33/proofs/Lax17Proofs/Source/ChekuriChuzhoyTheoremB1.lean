The only branch that still consumes an auxiliary-isomorphism package here is
the switched successor order.  In the unswitched order, the theorem uses the
formal Figure 8 locality theorem, the deleted-middle progress edge, and the
replacement-row contact facts to build the paper update directly. -/
noncomputable def paperActionUpdate_of_localDegreeTest_constructedSuccessor_byLeftLocalRightAttachments
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (auxL auxA auxD auxR : I.linkage.Index)
    (hLA_old : (linkageAuxGraph I.linkage).Adj auxA auxL)
    (hAU_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Cross.rowLeft))
    (hUV_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight))
    (hVD_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hDR_old : (linkageAuxGraph I.linkage).Adj auxD auxR)
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hU_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowLeft) 2)
    (hV_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowRight) 2)
    (hD_old : DegreeEquals (linkageAuxGraph I.linkage) auxD 2)
    (hL_not :
      auxL ∉ ({auxA, I.rowIndex Cross.rowLeft,
        I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index))
    (hR_not :
      auxR ∉ ({auxA, I.rowIndex Cross.rowLeft,
        I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index))
    (hLU : auxL ≠ I.rowIndex Cross.rowLeft)
    (hRV : auxR ≠ I.rowIndex Cross.rowRight)
    (hAU_ne : auxA ≠ I.rowIndex Cross.rowLeft)
    (hAD : auxA ≠ auxD)
    (hUD : I.rowIndex Cross.rowLeft ≠ auxD)
    (hAV : auxA ≠ I.rowIndex Cross.rowRight)
    (hDV : auxD ≠ I.rowIndex Cross.rowRight)
    (hLD : auxL ≠ auxD)
    (hleftReplacementHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.leftPath)
    (hrightReplacementHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.rightPath) :
    CrossPaperActionUpdate Inv Cross := by
  classical
  let S : Finset I.linkage.Index :=
    {auxA, I.rowIndex Cross.rowLeft, I.rowIndex Cross.rowRight, auxD}
  let L'' : PerfectPathPacking G A B := Cross.replacementLinkageConcrete
  have hsupport :
      AdjChangeSupportedIn (linkageAuxGraph I.linkage)
        (linkageAuxGraph L'') S := by
    simpa [S, L''] using
      Cross.cross_adjChangeSupportedIn auxA auxD
        hAU_old hUV_old hVD_old hU_old hV_old hAV hUD
  have hlocal_old :
      ∀ x : I.linkage.Index, x ∈ S →
        DegreeEquals (linkageAuxGraph I.linkage) x 2 := by
    intro x hx
    simp [S] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · exact hA_old
    · exact hU_old
    · exact hV_old
    · exact hD_old
  refine ⟨?_⟩
  by_cases hU_new :
      DegreeEquals (linkageAuxGraph Cross.replacementLinkageConcrete)
        (I.rowIndex Cross.rowLeft) 2
  · by_cases hV_new :
        DegreeEquals (linkageAuxGraph Cross.replacementLinkageConcrete)
          (I.rowIndex Cross.rowRight) 2
    · have horder :=
        Cross.replacement_attachment_order_of_old_local_data auxA auxD
          hAU_old hVD_old hU_new hV_new hAV hUD hAD
      rcases horder with hleft | hright
      · exact
          (Cross.paperActionUpdate_leftRight_of_localDichotomy_constructedSuccessor_hitsReplacements
            Inv auxL auxA auxD auxR hLA_old hAU_old hUV_old hVD_old
            hDR_old hleft.1 hleft.2 hA_old hU_old hV_old hD_old
            hL_not hR_not hLU hRV hAU_ne hAD hUD hAV hDV hLD
            hleftReplacementHit hrightReplacementHit).degree_drop_or_successor
      · exact
          (Cross.paperActionUpdate_rightLeft_of_localDichotomy_constructedSuccessor_hitsReplacements
            Inv auxL auxA auxD auxR hLA_old hAU_old hUV_old hVD_old
            hDR_old hright.1 hright.2 hA_old hU_old hV_old hD_old
            hU_new hV_new hL_not hR_not hLU hRV hAU_ne hAD hUD hAV
            hDV hLD hleftReplacementHit
            hrightReplacementHit).degree_drop_or_successor
    · have hdrop :
          degreeTwoVertexCount (linkageAuxGraph L'') <
            degreeTwoVertexCount (linkageAuxGraph I.linkage) :=
        degreeTwoVertexCount_lt_of_supported_local_drop
          (linkageAuxGraph I.linkage) (linkageAuxGraph L'') S hsupport
          hlocal_old
          ⟨I.rowIndex Cross.rowRight, by simp [S], by
            simpa [L''] using hV_new⟩
      exact Or.inl ⟨L'', by
        simpa [L'', linkageAuxDegreeTwoCount] using hdrop⟩
  · have hdrop :
        degreeTwoVertexCount (linkageAuxGraph L'') <
          degreeTwoVertexCount (linkageAuxGraph I.linkage) :=
      degreeTwoVertexCount_lt_of_supported_local_drop
        (linkageAuxGraph I.linkage) (linkageAuxGraph L'') S hsupport
        hlocal_old
        ⟨I.rowIndex Cross.rowLeft, by simp [S], by
          simpa [L''] using hU_new⟩
    exact Or.inl ⟨L'', by
      simpa [L'', linkageAuxDegreeTwoCount] using hdrop⟩

