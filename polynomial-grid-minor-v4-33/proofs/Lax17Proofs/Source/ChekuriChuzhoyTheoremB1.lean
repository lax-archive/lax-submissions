/-- Orientation-free lower-neighbor blocker atom data.  This is the interface
that a compressed blocker block should produce when one of its adjacent blocks
lies on the lower side of a hill candidate. -/
inductive ClaimB3LowerNeighborAtomData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    (inv : TypeOneIterationInvariants I)
    (C : ClaimB3HillCandidateData I inv) (j' : Fin h) : Type _
  | topToLower :
      ClaimB3LowerNeighborTopToLowerAtomData inv C j' →
        ClaimB3LowerNeighborAtomData inv C j'
  | lowerToTop :
      ClaimB3LowerNeighborLowerToTopAtomData inv C j' →
        ClaimB3LowerNeighborAtomData inv C j'

namespace ClaimB3LowerNeighborAtomData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}
variable {C : ClaimB3HillCandidateData I inv} {j' : Fin h}

/-- Either orientation of a lower-neighbor blocker atom contradicts the
Claim B.2 no-cross strip certificate. -/
theorem impossible
    (S : ClaimB2PlanarStripCertificate I inv)
    (D : ClaimB3LowerNeighborAtomData inv C j')
    (hj' : j' ≠ C.col) :
    False := by
  cases D with
  | topToLower D =>
      exact D.impossible S hj'
  | lowerToTop D =>
      exact D.impossible S hj'

end ClaimB3LowerNeighborAtomData

/-! ### Claim B.3: bracketed hill candidates -/

/-- A Claim B.3 hill candidate together with the two original-column atoms
that bracket it in the strip between the candidate row and the lower row.

This is the invariant that the blocker-barrier proof naturally uses.  The
finite ascent only needs the underlying row/column position, but each
successive candidate must carry bracketing data so the next blocker can again
be ruled out by the Claim B.2 strip barrier. -/
structure ClaimB3BracketedHillCandidateData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  candidate : ClaimB3HillCandidateData I inv
  bracket : ClaimB3HillBracketAtomData inv candidate

/-- Bracketed path-level hill-normal certificate for Claim B.3.

This version avoids the earlier over-generalized barrier obligation for every
bare `ClaimB3HillCandidateData`.  The candidate predicate in the finite
ascent consists of candidates that already carry the bracketing atoms needed
for the blocker argument. -/
structure ClaimB3BracketedPathHillNormalCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  no_hill : ClaimB3NoHill I inv
  candidate_of_nonconvex_trace :
    (∃ i : Fin (z h), ∃ j : Fin h,
      Nonempty (ClaimB3NonconvexTrace I inv i j)) →
      Nonempty (ClaimB3BracketedHillCandidateData I inv)
  higher_candidate_of_candidate :
    ∀ C : ClaimB3BracketedHillCandidateData I inv,
      ∃ C' : ClaimB3BracketedHillCandidateData I inv,
        C.candidate.row.1 < C'.candidate.row.1

namespace ClaimB3BracketedPathHillNormalCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Forget bracketed candidates to the finite path-hill certificate consumed
by the existing maximal-ascent proof. -/
noncomputable def toPathHillNormalCertificate
    (C : ClaimB3BracketedPathHillNormalCertificate I inv) :
    ClaimB3PathHillNormalCertificate I inv where
  HillCandidate i j :=
    ∃ H : ClaimB3BracketedHillCandidateData I inv,
      H.candidate.row = i ∧ H.candidate.col = j
  candidate_of_nonconvex_trace := by
    intro hbad
    rcases C.candidate_of_nonconvex_trace hbad with ⟨H⟩
    exact ⟨H.candidate.row, H.candidate.col, H, rfl, rfl⟩
  higher_candidate_of_candidate := by
    intro i j hcandidate
    rcases hcandidate with ⟨H, hrow, hcol⟩
    rcases C.higher_candidate_of_candidate H with ⟨H', hlt⟩
    exact ⟨H'.candidate.row, H'.candidate.col, by simpa [hrow] using hlt,
      H', rfl, rfl⟩

/-- Path-level Claim B.3 from bracketed hill candidates. -/
noncomputable def pathIntersections
    (C : ClaimB3BracketedPathHillNormalCertificate I inv) :
    ClaimB3PathIntersections I inv :=
  C.toPathHillNormalCertificate.pathIntersections

/-- Connected-intersection Claim B.3 conclusion from bracketed hill
candidates. -/
theorem connectedIntersections
    (C : ClaimB3BracketedPathHillNormalCertificate I inv) :
    ClaimB3ConnectedIntersections I inv :=
  ClaimB3ConnectedIntersections.of_pathIntersections C.pathIntersections

end ClaimB3BracketedPathHillNormalCertificate

/-! ### Claim B.3: flexible bracketed hill candidates -/

/-- A Claim B.3 hill candidate together with flexible bracketing atoms.

Unlike `ClaimB3BracketedHillCandidateData`, this version does not choose an
orientation of the lower-row interval in advance.  That orientation is supplied
only when the no-cross strip argument needs it. -/
structure ClaimB3FlexibleBracketedHillCandidateData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  candidate : ClaimB3HillCandidateData I inv
  bracket : ClaimB3FlexibleHillBracketAtomData inv candidate

/-- Flexible-bracket path-level hill-normal certificate for Claim B.3. -/
structure ClaimB3FlexibleBracketedPathHillNormalCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  no_hill : ClaimB3NoHill I inv
  candidate_of_nonconvex_trace :
    (∃ i : Fin (z h), ∃ j : Fin h,
      Nonempty (ClaimB3NonconvexTrace I inv i j)) →
      Nonempty (ClaimB3FlexibleBracketedHillCandidateData I inv)
  higher_candidate_of_candidate :
    ∀ C : ClaimB3FlexibleBracketedHillCandidateData I inv,
      ∃ C' : ClaimB3FlexibleBracketedHillCandidateData I inv,
        C.candidate.row.1 < C'.candidate.row.1

namespace ClaimB3FlexibleBracketedPathHillNormalCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Forget flexible-bracketed candidates to the finite path-hill certificate. -/
noncomputable def toPathHillNormalCertificate
    (C : ClaimB3FlexibleBracketedPathHillNormalCertificate I inv) :
    ClaimB3PathHillNormalCertificate I inv where
  HillCandidate i j :=
    ∃ H : ClaimB3FlexibleBracketedHillCandidateData I inv,
      H.candidate.row = i ∧ H.candidate.col = j
  candidate_of_nonconvex_trace := by
    intro hbad
    rcases C.candidate_of_nonconvex_trace hbad with ⟨H⟩
    exact ⟨H.candidate.row, H.candidate.col, H, rfl, rfl⟩
  higher_candidate_of_candidate := by
    intro i j hcandidate
    rcases hcandidate with ⟨H, hrow, hcol⟩
    rcases C.higher_candidate_of_candidate H with ⟨H', hlt⟩
    exact ⟨H'.candidate.row, H'.candidate.col, by simpa [hrow] using hlt,
      H', rfl, rfl⟩

/-- Path-level Claim B.3 from flexible-bracketed hill candidates. -/
noncomputable def pathIntersections
    (C : ClaimB3FlexibleBracketedPathHillNormalCertificate I inv) :
    ClaimB3PathIntersections I inv :=
  C.toPathHillNormalCertificate.pathIntersections

/-- Connected-intersection Claim B.3 conclusion from flexible brackets. -/
theorem connectedIntersections
    (C : ClaimB3FlexibleBracketedPathHillNormalCertificate I inv) :
    ClaimB3ConnectedIntersections I inv :=
  ClaimB3ConnectedIntersections.of_pathIntersections C.pathIntersections

end ClaimB3FlexibleBracketedPathHillNormalCertificate

/-! ## Claim B.3: row-contact traces and local valleys -/

/-- The ordered row-contact vertices of the `j`-th selected terminal column.
This is the concrete list underlying the paper's trace of a transversal
through the terminal rows. -/
noncomputable def claimB3RowContactVertexList
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (j : Fin h) : List V :=
  (claimB3ColumnPath I inv j).walk.support.filter
    fun v => v ∈ I.rowVertexSet

/-- Membership in the row-contact list is exactly membership in the selected
column and in the current row family. -/
theorem mem_claimB3RowContactVertexList_iff
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    {j : Fin h} {v : V} :
    v ∈ claimB3RowContactVertexList I inv j ↔
      v ∈ (claimB3ColumnPath I inv j).vertexSet ∧
        v ∈ I.rowVertexSet := by
  classical
  simp [claimB3RowContactVertexList, GraphPath.vertexSet]

/-- Any ordered terminal row is contained in the current row-family vertex
set. -/
theorem claimB3RowPath_vertexSet_subset_rowVertexSet
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (i : Fin (z h)) :
    (claimB3RowPath I inv i).vertexSet ⊆ I.rowVertexSet := by
  simpa [claimB3RowPath] using
    I.rowPath_vertexSet_subset_rowVertexSet (inv.orderedRows.order.symm i)

/-- Since each selected column meets every current row, its row-contact list
is nonempty. -/
theorem claimB3RowContactVertexList_nonempty
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (j : Fin h) :
    0 < (claimB3RowContactVertexList I inv j).length := by
  classical
  let i0 : Fin (z h) := ⟨0, by dsimp [z]; omega⟩
  rcases selectedColumn_currentRow_inter_nonempty I inv.orderedRows i0 j with
    ⟨v, hv⟩
  have hvrow : v ∈ I.rowVertexSet :=
    claimB3RowPath_vertexSet_subset_rowVertexSet (I := I) (inv := inv) i0
      (Finset.mem_inter.1 (by
        simpa [claimB3BranchSet, claimB3RowPath, claimB3ColumnPath]
          using hv)).1
  have hvcol : v ∈ (claimB3ColumnPath I inv j).vertexSet := by
    exact (Finset.mem_inter.1 (by
      simpa [claimB3BranchSet, claimB3RowPath, claimB3ColumnPath]
        using hv)).2
  have hmem : v ∈ claimB3RowContactVertexList I inv j :=
    (mem_claimB3RowContactVertexList_iff (I := I) (inv := inv)
      (j := j) (v := v)).2 ⟨hvcol, hvrow⟩
  exact List.length_pos_of_mem hmem

/-- The length parameter for the row-contact trace extracted from the support
list.  The actual list has length `traceLen + 1`. -/
noncomputable def claimB3RowContactTraceLen
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (j : Fin h) : ℕ :=
  (claimB3RowContactVertexList I inv j).length - 1

@[simp] theorem claimB3RowContactTraceLen_add_one
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (j : Fin h) :
    claimB3RowContactTraceLen I inv j + 1 =
      (claimB3RowContactVertexList I inv j).length := by
  exact Nat.succ_pred_eq_of_pos
    (claimB3RowContactVertexList_nonempty I inv j)

/-- The `r`-th row contact of a selected terminal column. -/
noncomputable def claimB3RowContact
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (j : Fin h)
    (r : Fin (claimB3RowContactTraceLen I inv j + 1)) : V :=
  (claimB3RowContactVertexList I inv j).get
    ⟨r.1, by
      simpa [claimB3RowContactTraceLen_add_one] using r.2⟩

/-- Every extracted row contact lies on the selected column. -/
theorem claimB3RowContact_mem_column
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (j : Fin h)
    (r : Fin (claimB3RowContactTraceLen I inv j + 1)) :
    claimB3RowContact I inv j r ∈
      (claimB3ColumnPath I inv j).vertexSet := by
  classical
  have hmem :
      claimB3RowContact I inv j r ∈ claimB3RowContactVertexList I inv j := by
    exact List.get_mem _ _
  exact ((mem_claimB3RowContactVertexList_iff (I := I) (inv := inv)
    (j := j) (v := claimB3RowContact I inv j r)).1 hmem).1

/-- Every extracted row contact lies in the current row family. -/
theorem claimB3RowContact_mem_rowVertexSet
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (j : Fin h)
    (r : Fin (claimB3RowContactTraceLen I inv j + 1)) :
    claimB3RowContact I inv j r ∈ I.rowVertexSet := by
  classical
  have hmem :
      claimB3RowContact I inv j r ∈ claimB3RowContactVertexList I inv j := by
    exact List.get_mem _ _
  exact ((mem_claimB3RowContactVertexList_iff (I := I) (inv := inv)
    (j := j) (v := claimB3RowContact I inv j r)).1 hmem).2

/-- The current row containing an extracted row contact, expressed as an
ordered row number. -/
noncomputable def claimB3RowContactRow
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (j : Fin h)
    (r : Fin (claimB3RowContactTraceLen I inv j + 1)) : Fin (z h) :=
  inv.orderedRows.order
    (Classical.choose
      (by
        have hv := claimB3RowContact_mem_rowVertexSet I inv j r
        rw [IterationInput.rowVertexSet] at hv
        rcases Finset.mem_biUnion.1 hv with ⟨row, _hrow, hvrow⟩
        exact ⟨row, hvrow⟩))

/-- The extracted row contact lies on its chosen current row. -/
theorem claimB3RowContact_mem_row
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (j : Fin h)
    (r : Fin (claimB3RowContactTraceLen I inv j + 1)) :
    claimB3RowContact I inv j r ∈
      (claimB3RowPath I inv (claimB3RowContactRow I inv j r)).vertexSet := by
  classical
  let ex :
      ∃ row : I.Row,
        claimB3RowContact I inv j r ∈ (I.rowPath row).vertexSet := by
    have hv := claimB3RowContact_mem_rowVertexSet I inv j r
    rw [IterationInput.rowVertexSet] at hv
    rcases Finset.mem_biUnion.1 hv with ⟨row, _hrow, hvrow⟩
    exact ⟨row, hvrow⟩
  change
    claimB3RowContact I inv j r ∈
      (I.rowPath (inv.orderedRows.order.symm
        (inv.orderedRows.order (Classical.choose ex)))).vertexSet
  simpa using (Classical.choose_spec ex)

/-- The chosen row of a contact is unique, using row disjointness. -/
theorem claimB3RowContact_row_unique
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (j : Fin h)
    (r : Fin (claimB3RowContactTraceLen I inv j + 1))
    (k : Fin (z h))
    (hk :
      claimB3RowContact I inv j r ∈ (claimB3RowPath I inv k).vertexSet) :
    k = claimB3RowContactRow I inv j r := by
  classical
  by_contra hne
  have hrow_ne :
      inv.orderedRows.order.symm k ≠
        inv.orderedRows.order.symm (claimB3RowContactRow I inv j r) := by
    intro h
    exact hne (by
      have := congrArg inv.orderedRows.order h
      simpa using this)
  have hchosen :
      claimB3RowContact I inv j r ∈
        (I.rowPath
          (inv.orderedRows.order.symm
            (claimB3RowContactRow I inv j r))).vertexSet := by
    simpa [claimB3RowPath] using
      claimB3RowContact_mem_row I inv j r
  have hk' :
      claimB3RowContact I inv j r ∈
        (I.rowPath (inv.orderedRows.order.symm k)).vertexSet := by
    simpa [claimB3RowPath] using hk
  exact Finset.disjoint_left.mp (inv.rowsNodeDisjoint hrow_ne) hk' hchosen

/-- The extracted row-contact list reflects the column-path order. -/
theorem claimB3RowContact_before_iff_le_of_list
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (j : Fin h)
    (r s : Fin (claimB3RowContactTraceLen I inv j + 1)) :
    (claimB3ColumnPath I inv j).Before
      (claimB3RowContact I inv j r) (claimB3RowContact I inv j s) ↔
        r.1 ≤ s.1 := by
  classical
  let P : GraphPath G := claimB3ColumnPath I inv j
  let contacts := claimB3RowContactVertexList I inv j
  have hsub : contacts.Sublist P.walk.support := by
    exact
      (List.filter_sublist (p := fun v => v ∈ I.rowVertexSet)
        (l := (claimB3ColumnPath I inv j).walk.support))
  rcases List.sublist_iff_exists_fin_orderEmbedding_get_eq.mp hsub with
    ⟨f, hf⟩
  let ir : Fin contacts.length :=
    ⟨r.1, by
      simpa [contacts, claimB3RowContactTraceLen_add_one] using r.2⟩
  let is : Fin contacts.length :=
    ⟨s.1, by
      simpa [contacts, claimB3RowContactTraceLen_add_one] using s.2⟩
  have hcontact_r :
      claimB3RowContact I inv j r = contacts.get ir := by
    simp [claimB3RowContact, contacts, ir]
  have hcontact_s :
      claimB3RowContact I inv j s = contacts.get is := by
    simp [claimB3RowContact, contacts, is]
  have hidx_contact :
      ∀ k : Fin contacts.length,
        P.vertexIndex (contacts.get k) = (f k).1 := by
    intro k
    have hget := hf k
    have hidx :
        P.vertexIndex (P.walk.support.get (f k)) = (f k).1 := by
      simpa [GraphPath.vertexIndex] using
        P.isPath.support_nodup.idxOf_getElem (f k).1 (f k).2
    rw [hget, hidx]
  constructor
  · intro hbefore
    have hidx_le :=
      ((P.before_iff_vertexIndex_le).1 (by simpa [P] using hbefore)).2.2
    have hf_le : f ir ≤ f is := by
      change (f ir).1 ≤ (f is).1
      rw [← hidx_contact ir, ← hidx_contact is]
      simpa [P, hcontact_r, hcontact_s] using hidx_le
    have hir_le_is : ir ≤ is := (OrderEmbedding.le_iff_le f).1 hf_le
    simpa [ir, is] using hir_le_is
  · intro hrs
    have hir_le_is : ir ≤ is := by
      simpa [ir, is] using hrs
    have hf_le : f ir ≤ f is :=
      (OrderEmbedding.le_iff_le f).2 hir_le_is
    refine (P.before_iff_vertexIndex_le).2 ?_
    refine ⟨?_, ?_, ?_⟩
    · rw [hcontact_r]
      exact claimB3RowContact_mem_column I inv j r
    · rw [hcontact_s]
      exact claimB3RowContact_mem_column I inv j s
    · change P.vertexIndex (claimB3RowContact I inv j r) ≤
        P.vertexIndex (claimB3RowContact I inv j s)
      rw [hcontact_r, hcontact_s, hidx_contact ir, hidx_contact is]
      exact hf_le

/-- Consecutive entries of the extracted row-contact list have no internal
vertex on any current row.  This is the row-family analogue of the linkage
contact cleanup used earlier for complete auxiliary contact traces. -/
theorem claimB3RowContactsCleanConsecutiveRows_of_list
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (j : Fin h) :
    ∀ r : Fin (claimB3RowContactTraceLen I inv j),
      ((claimB3ColumnPath I inv j).segmentOfBefore
        ((claimB3RowContact_before_iff_le_of_list I inv j
          ⟨r.1, Nat.lt_trans r.2
            (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩
          ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩).2
            (Nat.le_succ r.1))).InternallyDisjointFromSet
          I.rowVertexSet := by
  classical
  intro r v hvSeg hvRows
  let P : GraphPath G := claimB3ColumnPath I inv j
  let contacts := claimB3RowContactVertexList I inv j
  let left : Fin (claimB3RowContactTraceLen I inv j + 1) :=
    ⟨r.1, Nat.lt_trans r.2
      (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩
  let right : Fin (claimB3RowContactTraceLen I inv j + 1) :=
    ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩
  let a : V := claimB3RowContact I inv j left
  let b : V := claimB3RowContact I inv j right
  let hab : (claimB3ColumnPath I inv j).Before a b :=
    (claimB3RowContact_before_iff_le_of_list I inv j left right).2
      (Nat.le_succ r.1)
  have hvP : v ∈ (claimB3ColumnPath I inv j).vertexSet :=
    (claimB3ColumnPath I inv j).segmentOfBefore_vertexSet_subset hab hvSeg
  have hvContacts : v ∈ contacts := by
    exact (mem_claimB3RowContactVertexList_iff (I := I) (inv := inv)
      (j := j) (v := v)).2 ⟨hvP, hvRows⟩
  rcases List.mem_iff_get.mp hvContacts with ⟨iv, hiv⟩
  let idx : Fin (claimB3RowContactTraceLen I inv j + 1) :=
    ⟨iv.1, by
      simp [contacts, claimB3RowContactTraceLen_add_one] at iv ⊢⟩
  have hidx_contact : claimB3RowContact I inv j idx = v := by
    simpa [claimB3RowContact, contacts, idx] using hiv
  have ha_before_v :
      (claimB3ColumnPath I inv j).Before a v :=
    (claimB3ColumnPath I inv j).before_of_mem_segmentOfBefore_left hab hvSeg
  have hv_before_b :
      (claimB3ColumnPath I inv j).Before v b :=
    (claimB3ColumnPath I inv j).before_of_mem_segmentOfBefore_right hab hvSeg
  have hleft_le_idx : left.1 ≤ idx.1 := by
    have hbefore :
        (claimB3ColumnPath I inv j).Before
          (claimB3RowContact I inv j left) (claimB3RowContact I inv j idx) := by
      simpa [a, hidx_contact] using ha_before_v
    exact (claimB3RowContact_before_iff_le_of_list I inv j left idx).1 hbefore
  have hidx_le_right : idx.1 ≤ right.1 := by
    have hbefore :
        (claimB3ColumnPath I inv j).Before
          (claimB3RowContact I inv j idx) (claimB3RowContact I inv j right) := by
      simpa [b, hidx_contact] using hv_before_b
    exact (claimB3RowContact_before_iff_le_of_list I inv j idx right).1 hbefore
  have hidx_cases : idx.1 = left.1 ∨ idx.1 = right.1 := by
    simp [left, right] at hleft_le_idx hidx_le_right ⊢
    omega
  rcases hidx_cases with hleft | hright
  · left
    have hidx_eq : idx = left := Fin.ext hleft
    have hv_eq : v = a := by
      rw [← hidx_contact, hidx_eq]
    simpa [GraphPath.segmentOfBefore_source, hab] using hv_eq
  · right
    have hidx_eq : idx = right := Fin.ext hright
    have hv_eq : v = b := by
      rw [← hidx_contact, hidx_eq]
    simpa [GraphPath.segmentOfBefore_target, hab] using hv_eq

/-- A complete row-contact trace for one selected terminal column.  It records
all contacts with the current row family, in column order, and the row
containing each contact.  Consecutive contacts are clean relative to the current
rows, and their row numbers form the terminal unit-step trace supplied by the
no-bump/no-cross strip analysis. -/
structure ClaimB3RowContactTrace
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (j : Fin h) where
  len : ℕ
  contact : Fin (len + 1) → V
  row : Fin (len + 1) → Fin (z h)
  contact_mem_column :
    ∀ r, contact r ∈ (claimB3ColumnPath I inv j).vertexSet
  contact_mem_row :
    ∀ r, contact r ∈ (claimB3RowPath I inv (row r)).vertexSet
  contact_row_unique :
    ∀ r k, contact r ∈ (claimB3RowPath I inv k).vertexSet → k = row r
  contact_complete :
    ∀ ⦃v : V⦄,
      v ∈ (claimB3ColumnPath I inv j).vertexSet →
        v ∈ I.rowVertexSet →
          ∃ r : Fin (len + 1), contact r = v
  contact_before_iff_le :
    ∀ r s : Fin (len + 1),
      (claimB3ColumnPath I inv j).Before (contact r) (contact s) ↔
        r.1 ≤ s.1
  consecutive_clean_rows : ∀ r : Fin len,
    ((claimB3ColumnPath I inv j).segmentOfBefore
      ((contact_before_iff_le
        ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self len)⟩
        ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩).2 (Nat.le_succ r.1))).InternallyDisjointFromSet
        I.rowVertexSet
  consecutive_row_step : ∀ r : Fin len,
    row ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self len)⟩ =
        row ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩ ∨
      FinConsecutive
        (row ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self len)⟩)
        (row ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩)
  same_row_segment_subset : ∀ r : Fin len,
    row ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self len)⟩ =
        row ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩ →
      ((claimB3ColumnPath I inv j).segmentOfBefore
        ((contact_before_iff_le
          ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self len)⟩
          ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩).2 (Nat.le_succ r.1))).vertexSet ⊆
        (claimB3RowPath I inv
          (row ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self len)⟩)).vertexSet
  same_row_segment_edgeSet_subset : ∀ r : Fin len,
    row ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self len)⟩ =
        row ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩ →
      ((claimB3ColumnPath I inv j).segmentOfBefore
        ((contact_before_iff_le
          ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self len)⟩
          ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩).2 (Nat.le_succ r.1))).edgeSet ⊆
        (claimB3RowPath I inv
          (row ⟨r.1, Nat.lt_trans r.2 (Nat.lt_succ_self len)⟩)).edgeSet

/-- Build the complete row-contact trace from the concrete filtered support
list.  The row-clean part is proved by the filtered-list argument above; the
row-step and same-row segment parts are the terminal no-bump/no-cross strip
facts. -/
noncomputable def claimB3RowContactTraceOfList
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (j : Fin h)
    (hrow_step :
      ∀ r : Fin (claimB3RowContactTraceLen I inv j),
        claimB3RowContactRow I inv j
            ⟨r.1, Nat.lt_trans r.2
              (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩ =
            claimB3RowContactRow I inv j
              ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩ ∨
          FinConsecutive
            (claimB3RowContactRow I inv j
              ⟨r.1, Nat.lt_trans r.2
                (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩)
            (claimB3RowContactRow I inv j
              ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩))
    (hsame_row_segment_subset :
      ∀ r : Fin (claimB3RowContactTraceLen I inv j),
        claimB3RowContactRow I inv j
            ⟨r.1, Nat.lt_trans r.2
              (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩ =
            claimB3RowContactRow I inv j
              ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩ →
          ((claimB3ColumnPath I inv j).segmentOfBefore
            ((claimB3RowContact_before_iff_le_of_list I inv j
              ⟨r.1, Nat.lt_trans r.2
                (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩
              ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩).2
                (Nat.le_succ r.1))).vertexSet ⊆
            (claimB3RowPath I inv
              (claimB3RowContactRow I inv j
                ⟨r.1, Nat.lt_trans r.2
                  (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩)).vertexSet)
    (hsame_row_segment_edgeSet_subset :
      ∀ r : Fin (claimB3RowContactTraceLen I inv j),
        claimB3RowContactRow I inv j
            ⟨r.1, Nat.lt_trans r.2
              (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩ =
            claimB3RowContactRow I inv j
              ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩ →
          ((claimB3ColumnPath I inv j).segmentOfBefore
            ((claimB3RowContact_before_iff_le_of_list I inv j
              ⟨r.1, Nat.lt_trans r.2
                (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩
              ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩).2
                (Nat.le_succ r.1))).edgeSet ⊆
            (claimB3RowPath I inv
              (claimB3RowContactRow I inv j
                ⟨r.1, Nat.lt_trans r.2
                  (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩)).edgeSet) :
    ClaimB3RowContactTrace I inv j where
  len := claimB3RowContactTraceLen I inv j
  contact := claimB3RowContact I inv j
  row := claimB3RowContactRow I inv j
  contact_mem_column := claimB3RowContact_mem_column I inv j
  contact_mem_row := claimB3RowContact_mem_row I inv j
  contact_row_unique := claimB3RowContact_row_unique I inv j
  contact_complete := by
    classical
    intro v hvcol hvrow
    have hmem : v ∈ claimB3RowContactVertexList I inv j :=
      (mem_claimB3RowContactVertexList_iff (I := I) (inv := inv)
        (j := j) (v := v)).2 ⟨hvcol, hvrow⟩
    rcases List.mem_iff_get.mp hmem with ⟨r, hr⟩
    refine ⟨⟨r.1, by
      simp [claimB3RowContactTraceLen_add_one] at r ⊢⟩, ?_⟩
    simpa [claimB3RowContact] using hr
  contact_before_iff_le := claimB3RowContact_before_iff_le_of_list I inv j
  consecutive_clean_rows := claimB3RowContactsCleanConsecutiveRows_of_list I inv j
  consecutive_row_step := hrow_step
  same_row_segment_subset := hsame_row_segment_subset
  same_row_segment_edgeSet_subset := hsame_row_segment_edgeSet_subset

/-- Atomization of consecutive row contacts of one selected terminal column.
For each adjacent pair in the raw row-contact list, this structure supplies
the corresponding `ClaimB2Atom`.  This is the interface that connects the
Claim B.2 no-bump/no-cross strip analysis to the Claim B.3 finite trace
machinery. -/
structure ClaimB3ConsecutiveContactAtomization
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (j : Fin h) where
  atom :
    ∀ _ : Fin (claimB3RowContactTraceLen I inv j), ClaimB2Atom I
  atom_qIndex :
    ∀ r : Fin (claimB3RowContactTraceLen I inv j),
      (atom r).qIndex = Q0.selectedColumn j
  atom_rowStart_order :
    ∀ r : Fin (claimB3RowContactTraceLen I inv j),
      inv.orderedRows.order (atom r).rowStart =
        claimB3RowContactRow I inv j
          ⟨r.1, Nat.lt_trans r.2
            (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩
  atom_rowStop_order :
    ∀ r : Fin (claimB3RowContactTraceLen I inv j),
      inv.orderedRows.order (atom r).rowStop =
        claimB3RowContactRow I inv j
          ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩
  atom_start_eq :
    ∀ r : Fin (claimB3RowContactTraceLen I inv j),
      (atom r).start =
        claimB3RowContact I inv j
          ⟨r.1, Nat.lt_trans r.2
            (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩
  atom_stop_eq :
    ∀ r : Fin (claimB3RowContactTraceLen I inv j),
      (atom r).stop =
        claimB3RowContact I inv j
          ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩
  atom_segment_vertexSet_eq :
    ∀ r : Fin (claimB3RowContactTraceLen I inv j),
      (atom r).segment.vertexSet =
        ((claimB3ColumnPath I inv j).segmentOfBefore
          ((claimB3RowContact_before_iff_le_of_list I inv j
            ⟨r.1, Nat.lt_trans r.2
              (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩
            ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩).2
              (Nat.le_succ r.1))).vertexSet
  atom_segment_edgeSet_eq :
    ∀ r : Fin (claimB3RowContactTraceLen I inv j),
      (atom r).segment.edgeSet =
        ((claimB3ColumnPath I inv j).segmentOfBefore
          ((claimB3RowContact_before_iff_le_of_list I inv j
            ⟨r.1, Nat.lt_trans r.2
              (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩
            ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩).2
              (Nat.le_succ r.1))).edgeSet

namespace ClaimB3ConsecutiveContactAtomization

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}
variable {j : Fin h}

/-- The remaining full-clean input needed to turn raw consecutive row-contact
segments into Claim B.2 atoms: each consecutive row-contact subpath is clean
with respect to the whole current linkage, not just with respect to the row
family.  The maintained successor invariant of the bump/cross loop is meant
to supply this fact. -/
def ConsecutiveContactSegmentsLinkageClean
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (j : Fin h) : Prop :=
  ∀ r : Fin (claimB3RowContactTraceLen I inv j),
    ((claimB3ColumnPath I inv j).segmentOfBefore
      ((claimB3RowContact_before_iff_le_of_list I inv j
        ⟨r.1, Nat.lt_trans r.2
          (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩
        ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩).2
          (Nat.le_succ r.1))).InternallyDisjointFromSet
      I.linkage.toPathPacking.vertexSet

/-- Construct the consecutive-contact atomization from the concrete filtered
support list, once the full-linkage-clean part of each row-clean segment is
available. -/
noncomputable def ofList
    (hclean :
      ConsecutiveContactSegmentsLinkageClean (I := I) (inv := inv) j) :
    ClaimB3ConsecutiveContactAtomization I inv j where
  atom := by
    intro r
    let left : Fin (claimB3RowContactTraceLen I inv j + 1) :=
      ⟨r.1, Nat.lt_trans r.2
        (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩
    let right : Fin (claimB3RowContactTraceLen I inv j + 1) :=
      ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩
    let hab : (claimB3ColumnPath I inv j).Before
        (claimB3RowContact I inv j left)
        (claimB3RowContact I inv j right) :=
      (claimB3RowContact_before_iff_le_of_list I inv j left right).2
        (Nat.le_succ r.1)
    refine {
      qIndex := Q0.selectedColumn j
      q_mem := Q0.selectedColumn_mem_indices j
      rowStart := inv.orderedRows.order.symm
        (claimB3RowContactRow I inv j left)
      rowStop := inv.orderedRows.order.symm
        (claimB3RowContactRow I inv j right)
      start := claimB3RowContact I inv j left
      stop := claimB3RowContact I inv j right
      start_mem_row := ?_
      stop_mem_row := ?_
      segment := (claimB3ColumnPath I inv j).segmentOfBefore hab
      segment_source := by simp
      segment_target := by simp
      segment_subset_qstar := ?_
      segment_edgeSet_subset_qstar := ?_
      segment_clean_rows := ?_
      segment_clean_linkage := ?_
    }
    · change
        claimB3RowContact I inv j left ∈
          (claimB3RowPath I inv
            (claimB3RowContactRow I inv j left)).vertexSet
      exact claimB3RowContact_mem_row I inv j left
    · change
        claimB3RowContact I inv j right ∈
          (claimB3RowPath I inv
            (claimB3RowContactRow I inv j right)).vertexSet
      exact claimB3RowContact_mem_row I inv j right
    · intro v hv
      exact (claimB3ColumnPath I inv j).segmentOfBefore_vertexSet_subset hab hv
    · intro e he
      exact (claimB3ColumnPath I inv j).segmentOfBefore_edgeSet_subset hab he
    · simpa [left, right, hab] using
        claimB3RowContactsCleanConsecutiveRows_of_list I inv j r
    · simpa [left, right, hab,
        ConsecutiveContactSegmentsLinkageClean] using hclean r
  atom_qIndex := by
    intro r
    simp
  atom_rowStart_order := by
    intro r
    simp
  atom_rowStop_order := by
    intro r
    simp
  atom_start_eq := by
    intro r
    simp
  atom_stop_eq := by
    intro r
    simp
  atom_segment_vertexSet_eq := by
    intro r
    simp
  atom_segment_edgeSet_eq := by
    intro r
    simp

/-- Consecutive extracted row contacts are distinct vertices of the selected
column path. -/
theorem contact_ne
    (r : Fin (claimB3RowContactTraceLen I inv j)) :
    claimB3RowContact I inv j
        ⟨r.1, Nat.lt_trans r.2
          (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩ ≠
      claimB3RowContact I inv j
        ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩ := by
  classical
  intro hEq
  let left : Fin (claimB3RowContactTraceLen I inv j + 1) :=
    ⟨r.1, Nat.lt_trans r.2
      (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩
  let right : Fin (claimB3RowContactTraceLen I inv j + 1) :=
    ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩
  have hright_left :
      (claimB3ColumnPath I inv j).Before
        (claimB3RowContact I inv j right)
        (claimB3RowContact I inv j left) := by
    rw [← hEq]
    exact (claimB3RowContact_before_iff_le_of_list I inv j left left).2 le_rfl
  have hle : right.1 ≤ left.1 :=
    (claimB3RowContact_before_iff_le_of_list I inv j right left).1
      hright_left
  simp [left, right] at hle

/-- The atomization and the Claim B.2 strip certificate prove the unit-step
row fact for the raw row-contact trace. -/
theorem row_step
    (A : ClaimB3ConsecutiveContactAtomization I inv j)
    (S : ClaimB2PlanarStripCertificate I inv) :
    ∀ r : Fin (claimB3RowContactTraceLen I inv j),
      claimB3RowContactRow I inv j
          ⟨r.1, Nat.lt_trans r.2
            (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩ =
          claimB3RowContactRow I inv j
            ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩ ∨
        FinConsecutive
          (claimB3RowContactRow I inv j
            ⟨r.1, Nat.lt_trans r.2
              (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩)
          (claimB3RowContactRow I inv j
            ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩) := by
  intro r
  by_cases hrow : (A.atom r).rowStart = (A.atom r).rowStop
  · left
    calc
      claimB3RowContactRow I inv j
          ⟨r.1, Nat.lt_trans r.2
            (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩
          = inv.orderedRows.order (A.atom r).rowStart :=
            (A.atom_rowStart_order r).symm
      _ = inv.orderedRows.order (A.atom r).rowStop := by rw [hrow]
      _ = claimB3RowContactRow I inv j
          ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩ :=
            A.atom_rowStop_order r
  · right
    have hcon := S.atom_rows_consecutive (A.atom r) hrow
    simpa [A.atom_rowStart_order r, A.atom_rowStop_order r] using hcon

/-- The atomization and the no-bump part of Claim B.2 prove that a consecutive
same-row contact segment is entirely contained in that row. -/
theorem same_row_segment_subset
    (A : ClaimB3ConsecutiveContactAtomization I inv j)
    (S : ClaimB2PlanarStripCertificate I inv) :
    ∀ r : Fin (claimB3RowContactTraceLen I inv j),
      claimB3RowContactRow I inv j
          ⟨r.1, Nat.lt_trans r.2
            (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩ =
          claimB3RowContactRow I inv j
            ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩ →
        ((claimB3ColumnPath I inv j).segmentOfBefore
          ((claimB3RowContact_before_iff_le_of_list I inv j
            ⟨r.1, Nat.lt_trans r.2
              (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩
            ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩).2
              (Nat.le_succ r.1))).vertexSet ⊆
          (claimB3RowPath I inv
            (claimB3RowContactRow I inv j
              ⟨r.1, Nat.lt_trans r.2
                (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩)).vertexSet := by
  classical
  intro r hsame v hvseg
  let left : Fin (claimB3RowContactTraceLen I inv j + 1) :=
    ⟨r.1, Nat.lt_trans r.2
      (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩
  let right : Fin (claimB3RowContactTraceLen I inv j + 1) :=
    ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩
  have hrow_atom : (A.atom r).rowStart = (A.atom r).rowStop := by
    apply inv.orderedRows.order.injective
    calc
      inv.orderedRows.order (A.atom r).rowStart
          = claimB3RowContactRow I inv j left := by
            simpa [left] using A.atom_rowStart_order r
      _ = claimB3RowContactRow I inv j right := by
            simpa [left, right] using hsame
      _ = inv.orderedRows.order (A.atom r).rowStop := by
            simpa [right] using (A.atom_rowStop_order r).symm
  have hstart_ne : (A.atom r).start ≠ (A.atom r).stop := by
    intro hEq
    exact contact_ne (I := I) (inv := inv) (j := j) r (by
      calc
        claimB3RowContact I inv j left
            = (A.atom r).start := by
              simpa [left] using (A.atom_start_eq r).symm
        _ = (A.atom r).stop := hEq
        _ = claimB3RowContact I inv j right := by
              simpa [right] using A.atom_stop_eq r)
  have hno_off := S.same_row_atom_no_off_row (A.atom r) hrow_atom hstart_ne
  have hvAtom : v ∈ (A.atom r).segment.vertexSet := by
    rw [A.atom_segment_vertexSet_eq r]
    simpa [left, right] using hvseg
  have hsymm :
      inv.orderedRows.order.symm (claimB3RowContactRow I inv j left) =
        (A.atom r).rowStart := by
    rw [← A.atom_rowStart_order r]
    simp
  have hrowpath_eq :
      (claimB3RowPath I inv (claimB3RowContactRow I inv j left)).vertexSet =
        (I.rowPath (A.atom r).rowStart).vertexSet := by
    simp [claimB3RowPath, hsymm]
  by_contra hvnot
  have hvnot_atom : v ∉ (I.rowPath (A.atom r).rowStart).vertexSet := by
    intro hvrow
    exact hvnot (by simpa [left, hrowpath_eq] using hvrow)
  exact hno_off ⟨v, hvAtom, hvnot_atom⟩

/-- If two consecutive row contacts lie on the same row, the corresponding
column segment uses only edges of that row path.  This is the edge-level
version needed by Claim B.3's hill-bracket ownership argument. -/
theorem same_row_segment_edgeSet_subset
    (A : ClaimB3ConsecutiveContactAtomization I inv j)
    (S : ClaimB2PlanarStripCertificate I inv) :
    ∀ r : Fin (claimB3RowContactTraceLen I inv j),
      claimB3RowContactRow I inv j
          ⟨r.1, Nat.lt_trans r.2
            (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩ =
          claimB3RowContactRow I inv j
            ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩ →
        ((claimB3ColumnPath I inv j).segmentOfBefore
          ((claimB3RowContact_before_iff_le_of_list I inv j
            ⟨r.1, Nat.lt_trans r.2
              (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩
            ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩).2
              (Nat.le_succ r.1))).edgeSet ⊆
          (claimB3RowPath I inv
            (claimB3RowContactRow I inv j
              ⟨r.1, Nat.lt_trans r.2
                (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩)).edgeSet := by
  classical
  intro r hsame e heseg
  let left : Fin (claimB3RowContactTraceLen I inv j + 1) :=
    ⟨r.1, Nat.lt_trans r.2
      (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩
  let right : Fin (claimB3RowContactTraceLen I inv j + 1) :=
    ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩
  have hrow_atom : (A.atom r).rowStart = (A.atom r).rowStop := by
    apply inv.orderedRows.order.injective
    calc
      inv.orderedRows.order (A.atom r).rowStart
          = claimB3RowContactRow I inv j left := by
            simpa [left] using A.atom_rowStart_order r
      _ = claimB3RowContactRow I inv j right := by
            simpa [left, right] using hsame
      _ = inv.orderedRows.order (A.atom r).rowStop := by
            simpa [right] using (A.atom_rowStop_order r).symm
  have hstart_ne : (A.atom r).start ≠ (A.atom r).stop := by
    intro hEq
    exact contact_ne (I := I) (inv := inv) (j := j) r (by
      calc
        claimB3RowContact I inv j left
            = (A.atom r).start := by
              simpa [left] using (A.atom_start_eq r).symm
        _ = (A.atom r).stop := hEq
        _ = claimB3RowContact I inv j right := by
              simpa [right] using A.atom_stop_eq r)
  have hedge_subset :=
    S.same_row_atom_edgeSet_subset (A.atom r) hrow_atom hstart_ne
  have heAtom : e ∈ (A.atom r).segment.edgeSet := by
    rw [A.atom_segment_edgeSet_eq r]
    simpa [left, right] using heseg
  have hsymm :
      inv.orderedRows.order.symm (claimB3RowContactRow I inv j left) =
        (A.atom r).rowStart := by
    rw [← A.atom_rowStart_order r]
    simp
  have hrowpath_eq :
      (claimB3RowPath I inv (claimB3RowContactRow I inv j left)).edgeSet =
        (I.rowPath (A.atom r).rowStart).edgeSet := by
    simp [claimB3RowPath, hsymm]
  exact by
    simpa [left, hrowpath_eq] using hedge_subset heAtom

/-- Build the complete raw row-contact trace from consecutive-contact atoms
and the terminal strip certificate. -/
noncomputable def toRowContactTrace
    (A : ClaimB3ConsecutiveContactAtomization I inv j)
    (S : ClaimB2PlanarStripCertificate I inv) :
    ClaimB3RowContactTrace I inv j :=
  claimB3RowContactTraceOfList I inv j (A.row_step S)
    (A.same_row_segment_subset S)
    (A.same_row_segment_edgeSet_subset S)

/-- The atom corresponding to an edge of the generated row-contact trace.
This wrapper lets later arguments work with the generated trace length without
repeatedly coercing back to `claimB3RowContactTraceLen`. -/
noncomputable def atomAtTraceEdge
    (A : ClaimB3ConsecutiveContactAtomization I inv j)
  (S : ClaimB2PlanarStripCertificate I inv)
  (r : Fin ((A.toRowContactTrace S).len)) : ClaimB2Atom I :=
  A.atom ⟨r.1, by
    simp [toRowContactTrace, claimB3RowContactTraceOfList] at r ⊢⟩

@[simp] theorem atomAtTraceEdge_qIndex
    (A : ClaimB3ConsecutiveContactAtomization I inv j)
    (S : ClaimB2PlanarStripCertificate I inv)
    (r : Fin ((A.toRowContactTrace S).len)) :
    (A.atomAtTraceEdge S r).qIndex = Q0.selectedColumn j := by
  let r' : Fin (claimB3RowContactTraceLen I inv j) :=
    ⟨r.1, by
      simp [toRowContactTrace, claimB3RowContactTraceOfList] at r ⊢⟩
  change (A.atom r').qIndex = Q0.selectedColumn j
  exact A.atom_qIndex r'

theorem atomAtTraceEdge_rowStart_order
    (A : ClaimB3ConsecutiveContactAtomization I inv j)
    (S : ClaimB2PlanarStripCertificate I inv)
    (r : Fin ((A.toRowContactTrace S).len)) :
    inv.orderedRows.order (A.atomAtTraceEdge S r).rowStart =
      (A.toRowContactTrace S).row
        ⟨r.1, Nat.lt_trans r.2
          (Nat.lt_succ_self (A.toRowContactTrace S).len)⟩ := by
  simpa [atomAtTraceEdge, toRowContactTrace, claimB3RowContactTraceOfList]
    using A.atom_rowStart_order
      ⟨r.1, by
        simp [toRowContactTrace, claimB3RowContactTraceOfList] at r ⊢⟩

theorem atomAtTraceEdge_rowStop_order
    (A : ClaimB3ConsecutiveContactAtomization I inv j)
    (S : ClaimB2PlanarStripCertificate I inv)
    (r : Fin ((A.toRowContactTrace S).len)) :
    inv.orderedRows.order (A.atomAtTraceEdge S r).rowStop =
      (A.toRowContactTrace S).row
        ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩ := by
  simpa [atomAtTraceEdge, toRowContactTrace, claimB3RowContactTraceOfList]
    using A.atom_rowStop_order
      ⟨r.1, by
        simp [toRowContactTrace, claimB3RowContactTraceOfList] at r ⊢⟩

@[simp] theorem atomAtTraceEdge_start_eq
    (A : ClaimB3ConsecutiveContactAtomization I inv j)
    (S : ClaimB2PlanarStripCertificate I inv)
    (r : Fin ((A.toRowContactTrace S).len)) :
    (A.atomAtTraceEdge S r).start =
      (A.toRowContactTrace S).contact
        ⟨r.1, Nat.lt_trans r.2
          (Nat.lt_succ_self (A.toRowContactTrace S).len)⟩ := by
  simpa [atomAtTraceEdge, toRowContactTrace, claimB3RowContactTraceOfList]
    using A.atom_start_eq
      ⟨r.1, by
        simp [toRowContactTrace, claimB3RowContactTraceOfList] at r ⊢⟩

@[simp] theorem atomAtTraceEdge_stop_eq
    (A : ClaimB3ConsecutiveContactAtomization I inv j)
    (S : ClaimB2PlanarStripCertificate I inv)
    (r : Fin ((A.toRowContactTrace S).len)) :
    (A.atomAtTraceEdge S r).stop =
      (A.toRowContactTrace S).contact
        ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩ := by
  simpa [atomAtTraceEdge, toRowContactTrace, claimB3RowContactTraceOfList]
    using A.atom_stop_eq
      ⟨r.1, by
        simp [toRowContactTrace, claimB3RowContactTraceOfList] at r ⊢⟩

end ClaimB3ConsecutiveContactAtomization

/-- Future-clean-segment invariant used by Claim B.3.  Any subpath of a fixed
selected terminal column that is clean with respect to the current row family
is clean with respect to the whole current linkage.  This is the local
invariant preserved by the nonterminating bump/cross successor branch in the
paper. -/
def ClaimB3FutureRowCleanSegmentsFullClean
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) : Prop :=
  ∀ j : Fin h,
    ClaimB3ConsecutiveContactAtomization.ConsecutiveContactSegmentsLinkageClean
      (I := I) (inv := inv) j

/-- Future-clean-segment invariant for the whole fixed type-1 family `Q₀`.

The bump/cross loop may choose witnesses from any fixed `Q ∈ Q₀`, not only
from the terminal `h` columns selected for the grid model.  This is the
paper's invariant in the form needed by the local Figure 7/Figure 8
operations: if a `Q₀` subpath has both endpoints on current active rows and is
internally clean with respect to the current row family, then it is clean with
respect to the whole current linkage. -/
def TypeOneAllQ0RowCleanSubsegmentsFullClean
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0) : Prop :=
  ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
    ∀ {a b : V} (hab : (Q0.data i hi).qstar.Before a b),
      ((Q0.data i hi).qstar.segmentOfBefore hab).source ∈ I.rowVertexSet →
        ((Q0.data i hi).qstar.segmentOfBefore hab).target ∈ I.rowVertexSet →
          ((Q0.data i hi).qstar.segmentOfBefore hab).InternallyDisjointFromSet
            I.rowVertexSet →
            ((Q0.data i hi).qstar.segmentOfBefore hab).InternallyDisjointFromSet
              I.linkage.toPathPacking.vertexSet

/-- Full-linkage-cleanliness for all consecutive row-contact segments of all
selected terminal columns.  This is the precise invariant needed to construct
the raw Claim B.3 traces from the concrete row-contact lists. -/
def ClaimB3AllConsecutiveContactSegmentsLinkageClean
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) : Prop :=
  ∀ j : Fin h,
    ClaimB3ConsecutiveContactAtomization.ConsecutiveContactSegmentsLinkageClean
      (I := I) (inv := inv) j

/-- The future-clean-segment invariant supplies the full-linkage-clean part
for every consecutive row-contact segment. -/
theorem claimB3AllConsecutiveContactSegmentsLinkageClean_of_futureFullClean
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (H : ClaimB3FutureRowCleanSegmentsFullClean I inv) :
    ClaimB3AllConsecutiveContactSegmentsLinkageClean I inv := by
  exact H

/-- The all-`Q₀` future-clean invariant implies the selected-column clean
segments needed in Claim B.3. -/
theorem claimB3FutureRowCleanSegmentsFullClean_of_allQ0
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (H : TypeOneAllQ0RowCleanSubsegmentsFullClean I) :
    ClaimB3FutureRowCleanSegmentsFullClean I inv := by
  classical
  intro j r
  let left : Fin (claimB3RowContactTraceLen I inv j + 1) :=
    ⟨r.1, Nat.lt_trans r.2
      (Nat.lt_succ_self (claimB3RowContactTraceLen I inv j))⟩
  let right : Fin (claimB3RowContactTraceLen I inv j + 1) :=
    ⟨r.1 + 1, Nat.succ_lt_succ r.2⟩
  let hab : (claimB3ColumnPath I inv j).Before
      (claimB3RowContact I inv j left)
      (claimB3RowContact I inv j right) :=
    (claimB3RowContact_before_iff_le_of_list I inv j left right).2
      (Nat.le_succ r.1)
  let P : GraphPath G := (claimB3ColumnPath I inv j).segmentOfBefore hab
  have hsource : P.source ∈ I.rowVertexSet := by
    have hrow := claimB3RowContact_mem_rowVertexSet I inv j left
    simpa [P, hab, left] using hrow
  have htarget : P.target ∈ I.rowVertexSet := by
    have hrow := claimB3RowContact_mem_rowVertexSet I inv j right
    simpa [P, hab, right] using hrow
  have hcleanRows : P.InternallyDisjointFromSet I.rowVertexSet := by
    simpa [P, left, right, hab] using
      claimB3RowContactsCleanConsecutiveRows_of_list I inv j r
  simpa [P, claimB3ColumnPath, TypeOneQStarFamily.selectedData,
    TypeOneQStarFamily.selectedColumn_mem_indices] using
    H (Q0.selectedColumn j) (Q0.selectedColumn_mem_indices j) hab
      hsource htarget hcleanRows

/-- The explicit linkage-support invariant and the unique boundary contacts
of the type-1 `Q*` paths prove the all-`Q₀` future-clean invariant.

This is the formal version of the paper sentence used after Figures 7 and 8:
a future candidate segment that is clean with respect to the current active
rows cannot hit an outside linkage path, and it cannot use `P₀` or
`P_{z+1}` internally because the fixed type-1 path has only its endpoint
contact there. -/
theorem TypeOneAllQ0RowCleanSubsegmentsFullClean_of_support
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    (_extended : TypeOneExtendedFullIterationInvariants I)
    (support : IterationInput.TypeOneLinkageSupportInvariant I) :
    TypeOneAllQ0RowCleanSubsegmentsFullClean I := by
  classical
  intro i hi a b hab hsource htarget hcleanRows v hvP hvLink
  let D := Q0.data i hi
  let P : GraphPath G := D.qstar.segmentOfBefore hab
  have hvP' : v ∈ P.vertexSet := by
    simpa [P, D] using hvP
  have hvQ : v ∈ D.qstar.vertexSet := by
    exact D.qstar.segmentOfBefore_vertexSet_subset hab hvP'
  have hsupport := support hvLink
  rcases Finset.mem_union.1 hsupport with hvrow | hvrest
  · exact hcleanRows hvP hvrow
  rcases Finset.mem_union.1 hvrest with hvboundary | hvoutside
  · rcases Finset.mem_union.1 hvboundary with hvP0 | hvPz
    · have hvEndpointQ :
          v = D.qstar.source ∨ v = D.qstar.target := by
        exact D.internallyDisjointFrom_boundaries hvQ
          (Finset.mem_union.2 (Or.inl hvP0))
      rcases hvEndpointQ with hvsrc | hvtgt
      · subst v
        have hsrc_mem_P : D.qstar.source ∈ P.vertexSet := by
          simpa [P] using hvP'
        by_cases hsource_eq : D.qstar.source = P.source
        · exact Or.inl hsource_eq
        · have hsource_mem_q : P.source ∈ D.qstar.vertexSet := by
            simpa [P] using
              D.qstar.segmentOfBefore_vertexSet_subset hab
                (GraphPath.source_mem_vertexSet P)
          have hbefore : D.qstar.Before D.qstar.source P.source :=
            D.qstar.source_before_of_mem hsource_mem_q
          have hnot := D.qstar.not_mem_segmentOfBefore_of_before_source
            hab hbefore hsource_eq
          exact False.elim (hnot (by simpa [P] using hsrc_mem_P))
      · subst v
        have htgt_mem_P : D.qstar.target ∈ P.vertexSet := by
          simpa [P] using hvP'
        by_cases htarget_eq : D.qstar.target = P.target
        · exact Or.inr htarget_eq
        · have htarget_mem_q : P.target ∈ D.qstar.vertexSet := by
            simpa [P] using
              D.qstar.segmentOfBefore_vertexSet_subset hab
                (GraphPath.target_mem_vertexSet P)
          have hbefore : D.qstar.Before P.target D.qstar.target :=
            D.qstar.before_target_of_mem htarget_mem_q
          have hnot := D.qstar.not_mem_segmentOfBefore_of_target_before
            hab hbefore htarget_eq
          exact False.elim (hnot (by simpa [P] using htgt_mem_P))
    · have hvEndpointQ :
          v = D.qstar.source ∨ v = D.qstar.target := by
        exact D.internallyDisjointFrom_boundaries hvQ
          (Finset.mem_union.2 (Or.inr hvPz))
      rcases hvEndpointQ with hvsrc | hvtgt
      · subst v
        have hsrc_mem_P : D.qstar.source ∈ P.vertexSet := by
          simpa [P] using hvP'
        by_cases hsource_eq : D.qstar.source = P.source
        · exact Or.inl hsource_eq
        · have hsource_mem_q : P.source ∈ D.qstar.vertexSet := by
            simpa [P] using
              D.qstar.segmentOfBefore_vertexSet_subset hab
                (GraphPath.source_mem_vertexSet P)
          have hbefore : D.qstar.Before D.qstar.source P.source :=
            D.qstar.source_before_of_mem hsource_mem_q
          have hnot := D.qstar.not_mem_segmentOfBefore_of_before_source
            hab hbefore hsource_eq
          exact False.elim (hnot (by simpa [P] using hsrc_mem_P))
      · subst v
        have htgt_mem_P : D.qstar.target ∈ P.vertexSet := by
          simpa [P] using hvP'
        by_cases htarget_eq : D.qstar.target = P.target
        · exact Or.inr htarget_eq
        · have htarget_mem_q : P.target ∈ D.qstar.vertexSet := by
            simpa [P] using
              D.qstar.segmentOfBefore_vertexSet_subset hab
                (GraphPath.target_mem_vertexSet P)
          have hbefore : D.qstar.Before P.target D.qstar.target :=
            D.qstar.before_target_of_mem htarget_mem_q
          have hnot := D.qstar.not_mem_segmentOfBefore_of_target_before
            hab hbefore htarget_eq
          exact False.elim (hnot (by simpa [P] using htgt_mem_P))
  · rw [IterationInput.typeOneOutsideLinkageVertexSet] at hvoutside
    rcases Finset.mem_biUnion.1 hvoutside with ⟨j, _hj, hvjOutside⟩
    by_cases hjAllowed : j ∈ typeOneAllowedIndexSet R hpos
    · simp [hjAllowed] at hvjOutside
    · have hvj : v ∈ (L.path j).vertexSet := by
        simpa [hjAllowed] using hvjOutside
      exact False.elim
        (Finset.disjoint_left.mp
          (D.qstar_avoids_other_linkage j hjAllowed) hvQ hvj)

/-! ### Paper-level invariant for the bump/cross loop

The local Figure 7/Figure 8 paragraphs preserve more than the displayed
auxiliary two-path.  They also preserve the fact that future row-clean
subsegments of the fixed `Q₀` paths are clean with respect to the whole current
linkage.  The following invariant and one-step packages make that paper
invariant explicit without changing the older orchestration lemmas above. -/

/-- Boundary-aware loop invariant plus the future-clean-segment invariant used
in Claim B.3.

The `extended` field is the formal version of the maintained extended
degree-two path
`P₀, R₁, ..., R_z, P_{z+1}` in the current auxiliary graph.  The
`future_segments_clean` field is the formal version of the paper sentence that
future bump/cross candidates that are clean relative to the current rows are
actually clean relative to the whole current linkage, because the fixed
transversals avoid the unchanged outside paths and have unique boundary
contacts. -/
structure TypeOneExtendedFutureCleanIterationInvariants
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0) where
  extended : TypeOneExtendedFullIterationInvariants I
  linkage_support :
    IterationInput.TypeOneLinkageSupportInvariant I
  all_q0_future_segments_clean :
    TypeOneAllQ0RowCleanSubsegmentsFullClean I
  future_segments_clean :
    ClaimB3FutureRowCleanSegmentsFullClean I extended.full.base

namespace TypeOneExtendedFutureCleanIterationInvariants

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}

/-- Constructor for the paper-level invariant that avoids duplicating the
selected-column future-clean proof: it is a direct consequence of the
all-`Q₀` future-clean invariant. -/
def mkOfAllQ0
    (extended : TypeOneExtendedFullIterationInvariants I)
    (support : IterationInput.TypeOneLinkageSupportInvariant I)
    (all_q0 :
      TypeOneAllQ0RowCleanSubsegmentsFullClean I) :
    TypeOneExtendedFutureCleanIterationInvariants I where
  extended := extended
  linkage_support := support
  all_q0_future_segments_clean := all_q0
  future_segments_clean :=
    claimB3FutureRowCleanSegmentsFullClean_of_allQ0 all_q0

/-- Forget the future-clean field and keep the boundary-aware extended
invariant. -/
def toExtendedFull
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I) :
    TypeOneExtendedFullIterationInvariants I :=
  Inv.extended

/-- The row-order/row-disjointness part of the paper invariant. -/
def base
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I) :
    TypeOneIterationInvariants I :=
  Inv.extended.full.base

/-- Claim B.3's consecutive-contact clean-segment package follows immediately
from the future-clean field. -/
theorem allConsecutiveContactSegmentsLinkageClean
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I) :
    ClaimB3AllConsecutiveContactSegmentsLinkageClean I Inv.base :=
  claimB3AllConsecutiveContactSegmentsLinkageClean_of_futureFullClean
    Inv.future_segments_clean

/-- The all-`Q₀` future-clean field also supplies Claim B.3's selected-column
future-clean invariant.  This projection is useful after successor updates:
the loop invariant is maintained for every fixed `Q₀` path, while the terminal
grid proof consumes only the selected `h` columns. -/
theorem futureSegmentsClean_of_allQ0
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I) :
    ClaimB3FutureRowCleanSegmentsFullClean I Inv.base :=
  claimB3FutureRowCleanSegmentsFullClean_of_allQ0
    Inv.all_q0_future_segments_clean

/-- The explicit support invariant carried by the paper-level loop invariant. -/
theorem linkageSupport
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I) :
    IterationInput.TypeOneLinkageSupportInvariant I :=
  Inv.linkage_support

/-! #### Fixed type-1 transversal linkage-contact classification

The no-skip part of the Figure 7/Figure 8 invariant update repeatedly uses
the following small fact.  A fixed type-1 path `Q*` avoids all original
linkage paths outside the selected extended block.  Since the current linkage
is supported by the current active rows, the two fixed boundary rows, and
those outside paths, every current-linkage contact of `Q*` is either a current
row contact or a boundary contact.  If the contact is not one of the two
endpoints of `Q*`, the uniqueness of the boundary contacts rules out the
boundary case, leaving a current-row contact.
-/

theorem qstar_linkage_contact_row_or_boundary
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} {v : V}
    (hvQ : v ∈ (Q0.data i hi).qstar.vertexSet)
    (hvLink : v ∈ I.linkage.toPathPacking.vertexSet) :
    v ∈ I.rowVertexSet ∨
      v ∈ IterationInput.typeOneBoundaryVertexSet (L := L) R hpos := by
  classical
  let D := Q0.data i hi
  have hraw := Inv.linkage_support hvLink
  rcases Finset.mem_union.1 hraw with hrow | hrest
  · exact Or.inl hrow
  rcases Finset.mem_union.1 hrest with hboundary | hvoutside
  · exact Or.inr hboundary
  rw [IterationInput.typeOneOutsideLinkageVertexSet] at hvoutside
  rcases Finset.mem_biUnion.1 hvoutside with ⟨j, _hj, hvjOutside⟩
  by_cases hjAllowed : j ∈ typeOneAllowedIndexSet R hpos
  · simp [hjAllowed] at hvjOutside
  · have hvj : v ∈ (L.path j).vertexSet := by
      simpa [hjAllowed] using hvjOutside
    exact False.elim
      (Finset.disjoint_left.mp
        (D.qstar_avoids_other_linkage j hjAllowed) hvQ hvj)

theorem qstar_internal_linkage_contact_mem_rowVertexSet
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} {v : V}
    (hvQ : v ∈ (Q0.data i hi).qstar.vertexSet)
    (hvLink : v ∈ I.linkage.toPathPacking.vertexSet)
    (hsrc : v ≠ (Q0.data i hi).qstar.source)
    (htgt : v ≠ (Q0.data i hi).qstar.target) :
    v ∈ I.rowVertexSet := by
  classical
  let D := Q0.data i hi
  rcases Inv.qstar_linkage_contact_row_or_boundary hvQ hvLink with hrow | hboundary
  · exact hrow
  · rcases Finset.mem_union.1 hboundary with hp0 | hpz
    · have hendpoint :
          v = D.qstar.source ∨ v = D.qstar.target := by
        exact D.internallyDisjointFrom_boundaries hvQ
          (Finset.mem_union.2 (Or.inl hp0))
      rcases hendpoint with h | h
      · exact False.elim (hsrc h)
      · exact False.elim (htgt h)
    · have hendpoint :
          v = D.qstar.source ∨ v = D.qstar.target := by
        exact D.internallyDisjointFrom_boundaries hvQ
          (Finset.mem_union.2 (Or.inr hpz))
      rcases hendpoint with h | h
      · exact False.elim (hsrc h)
      · exact False.elim (htgt h)

/-- Row-indexed version of
`qstar_internal_linkage_contact_mem_rowVertexSet`: every non-endpoint
current-linkage contact of a fixed type-1 path lies on a specific current
active row. -/
theorem qstar_internal_linkage_contact_exists_row
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} {v : V}
    (hvQ : v ∈ (Q0.data i hi).qstar.vertexSet)
    (hvLink : v ∈ I.linkage.toPathPacking.vertexSet)
    (hsrc : v ≠ (Q0.data i hi).qstar.source)
    (htgt : v ≠ (Q0.data i hi).qstar.target) :
    ∃ r : I.Row, v ∈ (I.rowPath r).vertexSet := by
  classical
  have hvrow :
      v ∈ I.rowVertexSet :=
    Inv.qstar_internal_linkage_contact_mem_rowVertexSet hvQ hvLink hsrc htgt
  rw [IterationInput.rowVertexSet] at hvrow
  rcases Finset.mem_biUnion.1 hvrow with ⟨r, _hr, hvr⟩
  exact ⟨r, hvr⟩

/-- The source of a fixed type-1 `Q*` is on the maintained upper boundary
path of the current linkage. -/
theorem qstar_source_mem_current_upperBoundary
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    (Q0.data i hi).qstar.source ∈
      (I.linkage.path Inv.extended.boundary.upperBoundary).vertexSet := by
  simpa [Inv.extended.boundary.upper_path_eq] using
    (Q0.data i hi).qstar_source_mem_PzPlusOne

/-- The target of a fixed type-1 `Q*` is on the maintained lower boundary
path of the current linkage. -/
theorem qstar_target_mem_current_lowerBoundary
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    (Q0.data i hi).qstar.target ∈
      (I.linkage.path Inv.extended.boundary.lowerBoundary).vertexSet := by
  simpa [Inv.extended.boundary.lower_path_eq] using
    (Q0.data i hi).qstar_target_mem_P0

theorem qstar_source_mem_current_linkage
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    (Q0.data i hi).qstar.source ∈
      I.linkage.toPathPacking.vertexSet := by
  exact (I.linkage.toPathPacking.mem_vertexSet).2
    ⟨Inv.extended.boundary.upperBoundary,
      Inv.qstar_source_mem_current_upperBoundary⟩

theorem qstar_target_mem_current_linkage
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    (Q0.data i hi).qstar.target ∈
      I.linkage.toPathPacking.vertexSet := by
  exact (I.linkage.toPathPacking.mem_vertexSet).2
    ⟨Inv.extended.boundary.lowerBoundary,
      Inv.qstar_target_mem_current_lowerBoundary⟩

/-- The two endpoints of a fixed type-1 path are distinct in the current
linkage: they lie on the two distinct maintained boundary rows. -/
theorem qstar_source_ne_target_current
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    (Q0.data i hi).qstar.source ≠ (Q0.data i hi).qstar.target := by
  intro hst
  have hsrc :
      (Q0.data i hi).qstar.source ∈
        (I.linkage.path Inv.extended.boundary.upperBoundary).vertexSet :=
    Inv.qstar_source_mem_current_upperBoundary
  have htgt :
      (Q0.data i hi).qstar.source ∈
        (I.linkage.path Inv.extended.boundary.lowerBoundary).vertexSet := by
    simpa [hst] using Inv.qstar_target_mem_current_lowerBoundary
  exact Finset.disjoint_left.mp
    (I.linkage.toPathPacking.node_disjoint
      (Inv.extended.boundary.lower_ne_upper.symm))
    hsrc htgt

theorem qstar_endpointContactIndex_zero_current
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    endpointContactIndex I.linkage (Q0.data i hi).qstar
        Inv.qstar_source_mem_current_linkage
        Inv.qstar_target_mem_current_linkage
        ⟨0, by simp [endpointContactTraceLen]⟩ =
      Inv.extended.boundary.upperBoundary := by
  exact endpointContactIndex_zero_eq_of_source_mem
    (L := I.linkage) (Q := (Q0.data i hi).qstar)
    Inv.qstar_source_mem_current_linkage
    Inv.qstar_target_mem_current_linkage
    Inv.qstar_source_mem_current_upperBoundary

theorem qstar_endpointContactIndex_last_current
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    endpointContactIndex I.linkage (Q0.data i hi).qstar
        Inv.qstar_source_mem_current_linkage
        Inv.qstar_target_mem_current_linkage
        ⟨endpointContactTraceLen I.linkage (Q0.data i hi).qstar, by omega⟩ =
      Inv.extended.boundary.lowerBoundary := by
  exact endpointContactIndex_last_eq_of_target_mem
    (L := I.linkage) (Q := (Q0.data i hi).qstar)
    Inv.qstar_source_mem_current_linkage
    Inv.qstar_target_mem_current_linkage
    Inv.qstar_target_mem_current_lowerBoundary

/-- Consecutive endpoint-padded current-linkage contacts of a fixed type-1
path either stay on the same linkage path or form an edge in the current
auxiliary graph. -/
theorem qstar_endpointContactIndex_consecutive_aux_step_current
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen I.linkage (Q0.data i hi).qstar)) :
    endpointContactIndex I.linkage (Q0.data i hi).qstar
        Inv.qstar_source_mem_current_linkage
        Inv.qstar_target_mem_current_linkage
        ⟨r.1, by omega⟩ =
      endpointContactIndex I.linkage (Q0.data i hi).qstar
        Inv.qstar_source_mem_current_linkage
        Inv.qstar_target_mem_current_linkage
        ⟨r.1 + 1, by omega⟩ ∨
      (linkageAuxGraph I.linkage).Adj
        (endpointContactIndex I.linkage (Q0.data i hi).qstar
          Inv.qstar_source_mem_current_linkage
          Inv.qstar_target_mem_current_linkage
          ⟨r.1, by omega⟩)
        (endpointContactIndex I.linkage (Q0.data i hi).qstar
          Inv.qstar_source_mem_current_linkage
          Inv.qstar_target_mem_current_linkage
          ⟨r.1 + 1, by omega⟩) := by
  classical
  exact aux_adj_or_eq_of_clean_segment
    (L := I.linkage)
    ((Q0.data i hi).qstar.segmentOfBefore
      (endpointContact_before_succ_of_source_ne_target I.linkage
        (Q0.data i hi).qstar Inv.qstar_source_ne_target_current r))
    (by
      simpa using
        endpointContact_mem_contactIndex_path I.linkage (Q0.data i hi).qstar
          Inv.qstar_source_mem_current_linkage
          Inv.qstar_target_mem_current_linkage
          ⟨r.1, by omega⟩)
    (by
      simpa using
        endpointContact_mem_contactIndex_path I.linkage (Q0.data i hi).qstar
          Inv.qstar_source_mem_current_linkage
          Inv.qstar_target_mem_current_linkage
          ⟨r.1 + 1, by omega⟩)
    (endpointContactsCleanConsecutive_of_source_ne_target I.linkage
      (Q0.data i hi).qstar Inv.qstar_source_ne_target_current r)

/-- In the endpoint-padded contact list of a fixed type-1 path, only the
zeroth contact can be the source. -/
theorem qstar_endpointContact_ne_source_of_ne_zero
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen I.linkage (Q0.data i hi).qstar + 1))
    (hr : r.1 ≠ 0) :
    endpointContact I.linkage (Q0.data i hi).qstar r ≠
      (Q0.data i hi).qstar.source := by
  classical
  intro hcontact
  let z0 : Fin (endpointContactTraceLen I.linkage (Q0.data i hi).qstar + 1) :=
    ⟨0, by omega⟩
  have hbefore :
      (Q0.data i hi).qstar.Before
        (endpointContact I.linkage (Q0.data i hi).qstar r)
        (endpointContact I.linkage (Q0.data i hi).qstar z0) := by
    have hmem :
        (Q0.data i hi).qstar.source ∈
          (Q0.data i hi).qstar.vertexSet :=
      GraphPath.source_mem_vertexSet _
    simpa [z0, hcontact] using
      (Q0.data i hi).qstar.before_refl hmem
  have hle :=
    (endpointContact_before_iff_le_of_source_ne_target I.linkage
      (Q0.data i hi).qstar Inv.qstar_source_ne_target_current r z0).1
      hbefore
  have hz : z0.1 = 0 := rfl
  omega

/-- In the endpoint-padded contact list of a fixed type-1 path, only the last
contact can be the target. -/
theorem qstar_endpointContact_ne_target_of_ne_last
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen I.linkage (Q0.data i hi).qstar + 1))
    (hr :
      r.1 ≠ endpointContactTraceLen I.linkage (Q0.data i hi).qstar) :
    endpointContact I.linkage (Q0.data i hi).qstar r ≠
      (Q0.data i hi).qstar.target := by
  classical
  intro hcontact
  let last : Fin (endpointContactTraceLen I.linkage (Q0.data i hi).qstar + 1) :=
    ⟨endpointContactTraceLen I.linkage (Q0.data i hi).qstar, by omega⟩
  have hbefore :
      (Q0.data i hi).qstar.Before
        (endpointContact I.linkage (Q0.data i hi).qstar last)
        (endpointContact I.linkage (Q0.data i hi).qstar r) := by
    have hmem :
        (Q0.data i hi).qstar.target ∈
          (Q0.data i hi).qstar.vertexSet :=
      GraphPath.target_mem_vertexSet _
    simpa [last, hcontact] using
      (Q0.data i hi).qstar.before_refl hmem
  have hle :=
    (endpointContact_before_iff_le_of_source_ne_target I.linkage
      (Q0.data i hi).qstar Inv.qstar_source_ne_target_current last r).1
      hbefore
  have hlast : last.1 =
      endpointContactTraceLen I.linkage (Q0.data i hi).qstar := rfl
  omega

/-- Every non-endpoint contact in the current-linkage endpoint contact list
of a fixed type-1 path lies on a concrete current row. -/
theorem qstar_endpointContact_internal_exists_row
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen I.linkage (Q0.data i hi).qstar + 1))
    (hr0 : r.1 ≠ 0)
    (hrlast :
      r.1 ≠ endpointContactTraceLen I.linkage (Q0.data i hi).qstar) :
    ∃ row : I.Row,
      endpointContact I.linkage (Q0.data i hi).qstar r ∈
        (I.rowPath row).vertexSet := by
  classical
  have hvQ :
      endpointContact I.linkage (Q0.data i hi).qstar r ∈
        (Q0.data i hi).qstar.vertexSet :=
    endpointContact_mem_path I.linkage (Q0.data i hi).qstar r
  have hvLink :
      endpointContact I.linkage (Q0.data i hi).qstar r ∈
        I.linkage.toPathPacking.vertexSet :=
    endpointContact_mem_linkage I.linkage (Q0.data i hi).qstar
      Inv.qstar_source_mem_current_linkage
      Inv.qstar_target_mem_current_linkage r
  exact Inv.qstar_internal_linkage_contact_exists_row hvQ hvLink
    (Inv.qstar_endpointContact_ne_source_of_ne_zero r hr0)
    (Inv.qstar_endpointContact_ne_target_of_ne_last r hrlast)

/-- If an internal endpoint-list contact lies on a current row, its current
linkage contact index is exactly that row's linkage index. -/
theorem qstar_endpointContact_internal_index_eq_row
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen I.linkage (Q0.data i hi).qstar + 1))
    {row : I.Row}
    (hrow :
      endpointContact I.linkage (Q0.data i hi).qstar r ∈
        (I.rowPath row).vertexSet) :
    endpointContactIndex I.linkage (Q0.data i hi).qstar
        Inv.qstar_source_mem_current_linkage
        Inv.qstar_target_mem_current_linkage r =
      I.rowIndex row := by
  unfold endpointContactIndex
  apply linkageIndexOfVertex_eq_of_mem (L := I.linkage)
  simpa [I.rowPath_eq_linkage_path row] using hrow

/-- Consecutive endpoint-list contacts that both lie on active rows either
belong to the same row or to consecutive rows in the maintained row order. -/
theorem qstar_endpointContact_rows_eq_or_consecutive_of_succ
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen I.linkage (Q0.data i hi).qstar))
    {row row' : I.Row}
    (hrow :
      endpointContact I.linkage (Q0.data i hi).qstar
          ⟨r.1, by omega⟩ ∈
        (I.rowPath row).vertexSet)
    (hrow' :
      endpointContact I.linkage (Q0.data i hi).qstar
          ⟨r.1 + 1, by omega⟩ ∈
        (I.rowPath row').vertexSet) :
    row = row' ∨
      FinConsecutive (Inv.base.orderedRows.order row)
        (Inv.base.orderedRows.order row') := by
  classical
  have hidx_row :
      endpointContactIndex I.linkage (Q0.data i hi).qstar
          Inv.qstar_source_mem_current_linkage
          Inv.qstar_target_mem_current_linkage
          ⟨r.1, by omega⟩ =
        I.rowIndex row :=
    Inv.qstar_endpointContact_internal_index_eq_row
      ⟨r.1, by omega⟩ hrow
  have hidx_row' :
      endpointContactIndex I.linkage (Q0.data i hi).qstar
          Inv.qstar_source_mem_current_linkage
          Inv.qstar_target_mem_current_linkage
          ⟨r.1 + 1, by omega⟩ =
        I.rowIndex row' :=
    Inv.qstar_endpointContact_internal_index_eq_row
      ⟨r.1 + 1, by omega⟩ hrow'
  rcases Inv.qstar_endpointContactIndex_consecutive_aux_step_current
      (i := i) (hi := hi) r with heq | hadj
  · left
    apply Inv.base.rowIndexInjective
    simpa [hidx_row, hidx_row'] using heq
  · right
    exact Inv.extended.full.active_aux.no_chord
      (by simpa [hidx_row, hidx_row'] using hadj)

/-- If the contact immediately after the upper-boundary source lies on an
active row, that row is the last active row. -/
theorem qstar_endpointContact_one_row_eq_last
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    {row : I.Row}
    (hrow :
      endpointContact I.linkage (Q0.data i hi).qstar
          ⟨1, by
            have hlen :
                0 < endpointContactTraceLen I.linkage
                    (Q0.data i hi).qstar := by
              simp [endpointContactTraceLen]
            omega⟩ ∈
        (I.rowPath row).vertexSet) :
    Inv.base.orderedRows.order row =
      (⟨z h - 1, by dsimp [z]; omega⟩ : Fin (z h)) := by
  classical
  have hlen :
      0 < endpointContactTraceLen I.linkage (Q0.data i hi).qstar := by
    simp [endpointContactTraceLen]
  let r0 : Fin (endpointContactTraceLen I.linkage (Q0.data i hi).qstar) :=
    ⟨0, by simp [endpointContactTraceLen]⟩
  have hidx0 :
      endpointContactIndex I.linkage (Q0.data i hi).qstar
          Inv.qstar_source_mem_current_linkage
          Inv.qstar_target_mem_current_linkage
          ⟨0, by omega⟩ =
        Inv.extended.boundary.upperBoundary :=
    Inv.qstar_endpointContactIndex_zero_current
  have hidx1 :
      endpointContactIndex I.linkage (Q0.data i hi).qstar
          Inv.qstar_source_mem_current_linkage
          Inv.qstar_target_mem_current_linkage
          ⟨1, by omega⟩ =
        I.rowIndex row :=
    Inv.qstar_endpointContact_internal_index_eq_row
      ⟨1, by omega⟩ hrow
  have hidx0' :
      endpointContactIndex I.linkage (Q0.data i hi).qstar
          Inv.qstar_source_mem_current_linkage
          Inv.qstar_target_mem_current_linkage
          ⟨r0.1, by omega⟩ =
        Inv.extended.boundary.upperBoundary := by
    simpa [r0] using hidx0
  have hidx1' :
      endpointContactIndex I.linkage (Q0.data i hi).qstar
          Inv.qstar_source_mem_current_linkage
          Inv.qstar_target_mem_current_linkage
          ⟨r0.1 + 1, by omega⟩ =
        I.rowIndex row := by
    simpa [r0] using hidx1
  rcases Inv.qstar_endpointContactIndex_consecutive_aux_step_current
      (i := i) (hi := hi) r0 with heq | hadj
  · have hrow_upper : I.rowIndex row = Inv.extended.boundary.upperBoundary := by
      simpa [hidx0', hidx1'] using heq.symm
    exact False.elim (Inv.extended.boundary.upper_ne_row row hrow_upper.symm)
  · exact Inv.extended.boundary.row_adj_upperBoundary_eq_last
      ((linkageAuxGraph I.linkage).symm (by
        simpa [hidx0', hidx1'] using hadj))

/-- If the contact immediately before the lower-boundary target lies on an
active row, that row is the first active row. -/
theorem qstar_endpointContact_pred_last_row_eq_first
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    {row : I.Row}
    (hrow :
      endpointContact I.linkage (Q0.data i hi).qstar
          ⟨endpointContactTraceLen I.linkage (Q0.data i hi).qstar - 1,
            by
              have hlen :
                  0 < endpointContactTraceLen I.linkage
                      (Q0.data i hi).qstar := by
                simp [endpointContactTraceLen]
              omega⟩ ∈
        (I.rowPath row).vertexSet) :
    Inv.base.orderedRows.order row =
      (⟨0, by dsimp [z]; omega⟩ : Fin (z h)) := by
  classical
  let n := endpointContactTraceLen I.linkage (Q0.data i hi).qstar
  have hnpos : 0 < n := by
    simp [n, endpointContactTraceLen]
  let rlast : Fin n := ⟨n - 1, by omega⟩
  have hidx_pred :
      endpointContactIndex I.linkage (Q0.data i hi).qstar
          Inv.qstar_source_mem_current_linkage
          Inv.qstar_target_mem_current_linkage
          ⟨n - 1, by omega⟩ =
        I.rowIndex row := by
    simpa [n] using
      Inv.qstar_endpointContact_internal_index_eq_row
        ⟨endpointContactTraceLen I.linkage (Q0.data i hi).qstar - 1,
          by omega⟩ hrow
  have hidx_last :
      endpointContactIndex I.linkage (Q0.data i hi).qstar
          Inv.qstar_source_mem_current_linkage
          Inv.qstar_target_mem_current_linkage
          ⟨n, by omega⟩ =
        Inv.extended.boundary.lowerBoundary := by
    simpa [n] using Inv.qstar_endpointContactIndex_last_current
  have hidx_pred' :
      endpointContactIndex I.linkage (Q0.data i hi).qstar
          Inv.qstar_source_mem_current_linkage
          Inv.qstar_target_mem_current_linkage
          ⟨rlast.1, by omega⟩ =
        I.rowIndex row := by
    simpa [rlast] using hidx_pred
  have hidx_last' :
      endpointContactIndex I.linkage (Q0.data i hi).qstar
          Inv.qstar_source_mem_current_linkage
          Inv.qstar_target_mem_current_linkage
          ⟨rlast.1 + 1, by omega⟩ =
        Inv.extended.boundary.lowerBoundary := by
    simpa [rlast, n, hnpos] using hidx_last
  rcases Inv.qstar_endpointContactIndex_consecutive_aux_step_current
      (i := i) (hi := hi) rlast with heq | hadj
  · have hrow_lower : I.rowIndex row = Inv.extended.boundary.lowerBoundary := by
      simpa [hidx_pred', hidx_last'] using heq
    exact False.elim (Inv.extended.boundary.lower_ne_row row hrow_lower.symm)
  · exact Inv.extended.boundary.row_adj_lowerBoundary_eq_first
      ((linkageAuxGraph I.linkage).symm (by
        simpa [hidx_pred', hidx_last'] using hadj))

/-- The endpoint-padded linkage-contact list of a fixed type-1 path has at
least one genuine internal linkage contact.  Indeed, every fixed `Q*` meets
every current active row, and active rows are disjoint from both maintained
boundary rows. -/
theorem qstar_endpointContactTraceLen_two_le_current
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    2 ≤ endpointContactTraceLen I.linkage (Q0.data i hi).qstar := by
  classical
  let row0 : I.Row :=
    Inv.base.orderedRows.order.symm
      (⟨0, by dsimp [z]; omega⟩ : Fin (z h))
  rcases (I.q0_intersection_invariant i hi).1 row0 with
    ⟨v, hvQrow⟩
  have hvQ : v ∈ (Q0.data i hi).qstar.vertexSet :=
    (Finset.mem_inter.1 hvQrow).1
  have hvrow : v ∈ (I.rowPath row0).vertexSet :=
    (Finset.mem_inter.1 hvQrow).2
  have hvLink : v ∈ I.linkage.toPathPacking.vertexSet := by
    exact (I.linkage.toPathPacking.mem_vertexSet).2
      ⟨I.rowIndex row0, by
        simpa [I.rowPath_eq_linkage_path row0] using hvrow⟩
  have hv_ne_source :
      v ≠ (Q0.data i hi).qstar.source := by
    intro hvsrc
    have hsrc_upper :
        v ∈
          (I.linkage.path Inv.extended.boundary.upperBoundary).vertexSet := by
      simpa [hvsrc] using
        Inv.qstar_source_mem_current_upperBoundary (i := i) (hi := hi)
    have hsrc_row :
        v ∈ (I.linkage.path (I.rowIndex row0)).vertexSet := by
      simpa [I.rowPath_eq_linkage_path row0] using hvrow
    exact Finset.disjoint_left.mp
      (I.linkage.toPathPacking.node_disjoint
        (Inv.extended.boundary.upper_ne_row row0))
      hsrc_upper hsrc_row
  have hv_ne_target :
      v ≠ (Q0.data i hi).qstar.target := by
    intro hvtgt
    have htgt_lower :
        v ∈
          (I.linkage.path Inv.extended.boundary.lowerBoundary).vertexSet := by
      simpa [hvtgt] using
        Inv.qstar_target_mem_current_lowerBoundary (i := i) (hi := hi)
    have htgt_row :
        v ∈ (I.linkage.path (I.rowIndex row0)).vertexSet := by
      simpa [I.rowPath_eq_linkage_path row0] using hvrow
    exact Finset.disjoint_left.mp
      (I.linkage.toPathPacking.node_disjoint
        (Inv.extended.boundary.lower_ne_row row0))
      htgt_lower htgt_row
  have hvMid :
      v ∈
        internalLinkageContactVertexList I.linkage
          (Q0.data i hi).qstar := by
    have hvSupportMid :
        v ∈ (Q0.data i hi).qstar.walk.support.tail.dropLast :=
      mem_support_tail_dropLast_of_mem_vertexSet_of_ne_endpoints
        (Q0.data i hi).qstar hvQ hv_ne_source hv_ne_target
    simp [internalLinkageContactVertexList, hvSupportMid, hvLink]
  have hlen_pos :
      0 <
        (internalLinkageContactVertexList I.linkage
          (Q0.data i hi).qstar).length :=
    List.length_pos_of_mem hvMid
  simp [endpointContactTraceLen]
  omega

/-- The active row containing an internal endpoint-padded contact of a fixed
type-1 path. -/
noncomputable def qstar_endpointContactInternalRow
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen I.linkage (Q0.data i hi).qstar + 1))
    (hr0 : r.1 ≠ 0)
    (hrlast :
      r.1 ≠ endpointContactTraceLen I.linkage (Q0.data i hi).qstar) :
    I.Row :=
  Classical.choose
    (Inv.qstar_endpointContact_internal_exists_row r hr0 hrlast)

/-- The chosen active row for an internal contact really contains that
contact. -/
theorem qstar_endpointContactInternalRow_mem
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen I.linkage (Q0.data i hi).qstar + 1))
    (hr0 : r.1 ≠ 0)
    (hrlast :
      r.1 ≠ endpointContactTraceLen I.linkage (Q0.data i hi).qstar) :
    endpointContact I.linkage (Q0.data i hi).qstar r ∈
      (I.rowPath
        (Inv.qstar_endpointContactInternalRow r hr0 hrlast)).vertexSet :=
  Classical.choose_spec
    (Inv.qstar_endpointContact_internal_exists_row r hr0 hrlast)

/-- Extended row-position assigned to an endpoint-padded linkage contact:
upper boundary is `z+1`, lower boundary is `0`, and internal contacts use the
active-row order plus one. -/
noncomputable def qstar_endpointContactExtendedPos
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} (hi : i ∈ Q0.indices)
    (r : Fin (endpointContactTraceLen I.linkage (Q0.data i hi).qstar + 1)) :
    ℕ :=
  if hr0 : r.1 = 0 then
    z h + 1
  else if hrlast :
      r.1 = endpointContactTraceLen I.linkage (Q0.data i hi).qstar then
    0
  else
    (Inv.base.orderedRows.order
      (Inv.qstar_endpointContactInternalRow r hr0 hrlast)).1 + 1

@[simp] theorem qstar_endpointContactExtendedPos_zero
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    Inv.qstar_endpointContactExtendedPos hi
        ⟨0, by simp [endpointContactTraceLen]⟩ =
      z h + 1 := by
  simp [qstar_endpointContactExtendedPos]

@[simp] theorem qstar_endpointContactExtendedPos_last
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    Inv.qstar_endpointContactExtendedPos hi
        ⟨endpointContactTraceLen I.linkage (Q0.data i hi).qstar,
          by omega⟩ =
      0 := by
  have hpos :
      0 < endpointContactTraceLen I.linkage (Q0.data i hi).qstar := by
    simp [endpointContactTraceLen]
  simp [qstar_endpointContactExtendedPos, hpos.ne']

theorem qstar_endpointContactExtendedPos_internal
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen I.linkage (Q0.data i hi).qstar + 1))
    (hr0 : r.1 ≠ 0)
    (hrlast :
      r.1 ≠ endpointContactTraceLen I.linkage (Q0.data i hi).qstar) :
    Inv.qstar_endpointContactExtendedPos hi r =
      (Inv.base.orderedRows.order
        (Inv.qstar_endpointContactInternalRow r hr0 hrlast)).1 + 1 := by
  simp [qstar_endpointContactExtendedPos, hr0, hrlast]

/-- The extended positions of consecutive endpoint-padded linkage contacts
change by at most one.  This is the finite no-skip trace in the current
iteration state. -/
theorem qstar_endpointContactExtendedPos_unit_step_current
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    UnitStepNatTrace
      (endpointContactTraceLen I.linkage (Q0.data i hi).qstar)
      (fun r =>
        Inv.qstar_endpointContactExtendedPos hi r) := by
  classical
  let n := endpointContactTraceLen I.linkage (Q0.data i hi).qstar
  have hn_two : 2 ≤ n := by
    simpa [n] using
      Inv.qstar_endpointContactTraceLen_two_le_current
        (i := i) (hi := hi)
  intro r
  let cur :
      Fin (endpointContactTraceLen I.linkage
        (Q0.data i hi).qstar + 1) := ⟨r.1, by omega⟩
  let nxt :
      Fin (endpointContactTraceLen I.linkage
        (Q0.data i hi).qstar + 1) := ⟨r.1 + 1, by omega⟩
  change
    Inv.qstar_endpointContactExtendedPos hi nxt ≤
        Inv.qstar_endpointContactExtendedPos hi cur + 1 ∧
      Inv.qstar_endpointContactExtendedPos hi cur ≤
        Inv.qstar_endpointContactExtendedPos hi nxt + 1
  by_cases hcur0 : r.1 = 0
  ·
    have hnxt_not_last : nxt.1 ≠ n := by
      simp [nxt, n]
      omega
    have hnxt_not_zero : nxt.1 ≠ 0 := by
      simp [nxt]
    let row :=
      Inv.qstar_endpointContactInternalRow
        (i := i) (hi := hi) nxt hnxt_not_zero hnxt_not_last
    have hrowmem :
        endpointContact I.linkage (Q0.data i hi).qstar
            ⟨1, by
              simp [endpointContactTraceLen]⟩ ∈
          (I.rowPath row).vertexSet := by
      simpa [row, nxt, hcur0] using
        Inv.qstar_endpointContactInternalRow_mem
          (i := i) (hi := hi) nxt hnxt_not_zero hnxt_not_last
    have hrow_last :
        Inv.base.orderedRows.order row =
          (⟨z h - 1, by dsimp [z]; omega⟩ : Fin (z h)) :=
      Inv.qstar_endpointContact_one_row_eq_last
        (hpos := hpos) (i := i) (hi := hi) hrowmem
    have hrow_val :
        (Inv.base.orderedRows.order row).1 = z h - 1 := by
      exact congrArg Fin.val hrow_last
    have hpos_cur :
        Inv.qstar_endpointContactExtendedPos hi cur = z h + 1 := by
      have hcur_eq :
          cur =
            (⟨0, by simp [endpointContactTraceLen]⟩ :
              Fin (endpointContactTraceLen I.linkage
                (Q0.data i hi).qstar + 1)) := by
        exact Fin.ext (by simp [cur, hcur0])
      simpa [hcur_eq] using
        Inv.qstar_endpointContactExtendedPos_zero
          (i := i) (hi := hi)
    have hpos_nxt :
        Inv.qstar_endpointContactExtendedPos hi nxt = z h := by
      have hchosen_val :
          (Inv.base.orderedRows.order
            (Inv.qstar_endpointContactInternalRow
              (i := i) (hi := hi) nxt hnxt_not_zero hnxt_not_last)).1 =
            z h - 1 := by
        simpa [row] using hrow_val
      rw [Inv.qstar_endpointContactExtendedPos_internal
        (i := i) (hi := hi) (r := nxt) hnxt_not_zero hnxt_not_last]
      omega
    constructor <;> simp [hpos_cur, hpos_nxt] <;> omega
  · by_cases hnext_last : r.1 + 1 = n
    · have hcur_not_zero : cur.1 ≠ 0 := by
        simp [cur]
        omega
      have hcur_not_last : cur.1 ≠ n := by
        simp [cur]
        omega
      let row :=
        Inv.qstar_endpointContactInternalRow
          (i := i) (hi := hi) cur hcur_not_zero hcur_not_last
      have hcur_eq_pred :
          cur =
            (⟨endpointContactTraceLen I.linkage
                    (Q0.data i hi).qstar - 1,
                by
                  simp [endpointContactTraceLen]⟩ :
              Fin (endpointContactTraceLen I.linkage
                (Q0.data i hi).qstar + 1)) := by
        apply Fin.ext
        simp [cur]
        omega
      have hrowmem :
          endpointContact I.linkage (Q0.data i hi).qstar
              ⟨endpointContactTraceLen I.linkage
                    (Q0.data i hi).qstar - 1,
                by
                  simp [endpointContactTraceLen]⟩ ∈
            (I.rowPath row).vertexSet := by
        simpa [row, hcur_eq_pred] using
          Inv.qstar_endpointContactInternalRow_mem
            (i := i) (hi := hi) cur hcur_not_zero hcur_not_last
      have hrow_first :
          Inv.base.orderedRows.order row =
            (⟨0, by dsimp [z]; omega⟩ : Fin (z h)) :=
      Inv.qstar_endpointContact_pred_last_row_eq_first
          (hpos := hpos) (i := i) (hi := hi) hrowmem
      have hrow_val :
          (Inv.base.orderedRows.order row).1 = 0 := by
        exact congrArg Fin.val hrow_first
      have hpos_cur :
          Inv.qstar_endpointContactExtendedPos hi cur = 1 := by
        rw [Inv.qstar_endpointContactExtendedPos_internal
          (i := i) (hi := hi) (r := cur) hcur_not_zero hcur_not_last]
        simp [row, hrow_val]
      have hpos_nxt :
          Inv.qstar_endpointContactExtendedPos hi nxt = 0 := by
        have hnxt_eq :
            nxt =
              (⟨endpointContactTraceLen I.linkage
                    (Q0.data i hi).qstar, by omega⟩ :
                Fin (endpointContactTraceLen I.linkage
                  (Q0.data i hi).qstar + 1)) := by
          apply Fin.ext
          simp [nxt, n, hnext_last]
        simp [hnxt_eq]
      constructor <;> simp [hpos_cur, hpos_nxt]
    · have hcur_not_last : cur.1 ≠ n := by
        simp [cur]
        omega
      have hnxt_not_zero : nxt.1 ≠ 0 := by
        simp [nxt]
      have hnxt_not_last : nxt.1 ≠ n := by
        simpa [nxt] using hnext_last
      let row :=
        Inv.qstar_endpointContactInternalRow
          (i := i) (hi := hi) cur hcur0 hcur_not_last
      let row' :=
        Inv.qstar_endpointContactInternalRow
          (i := i) (hi := hi) nxt hnxt_not_zero hnxt_not_last
      have hrowmem :
          endpointContact I.linkage (Q0.data i hi).qstar
              ⟨r.1, by omega⟩ ∈
            (I.rowPath row).vertexSet := by
        simpa [row, cur, n] using
          Inv.qstar_endpointContactInternalRow_mem
            (i := i) (hi := hi) cur hcur0 hcur_not_last
      have hrowmem' :
          endpointContact I.linkage (Q0.data i hi).qstar
              ⟨r.1 + 1, by omega⟩ ∈
            (I.rowPath row').vertexSet := by
        simpa [row', nxt, n] using
          Inv.qstar_endpointContactInternalRow_mem
            (i := i) (hi := hi) nxt hnxt_not_zero hnxt_not_last
      have hpos_cur :
          Inv.qstar_endpointContactExtendedPos hi cur =
            (Inv.base.orderedRows.order row).1 + 1 := by
        rw [Inv.qstar_endpointContactExtendedPos_internal
          (i := i) (hi := hi) (r := cur) hcur0 hcur_not_last]
      have hpos_nxt :
          Inv.qstar_endpointContactExtendedPos hi nxt =
            (Inv.base.orderedRows.order row').1 + 1 := by
        rw [Inv.qstar_endpointContactExtendedPos_internal
          (i := i) (hi := hi) (r := nxt) hnxt_not_zero hnxt_not_last]
      rcases Inv.qstar_endpointContact_rows_eq_or_consecutive_of_succ
          (i := i) (hi := hi) r hrowmem hrowmem' with hsame | hcon
      · have hval_eq :
            (Inv.base.orderedRows.order row).1 =
              (Inv.base.orderedRows.order row').1 := by
          rw [hsame]
        constructor <;> simp [hpos_cur, hpos_nxt] <;> omega
      · rcases hcon with hsucc | hpred
        · constructor <;>
            simp [hpos_cur, hpos_nxt] <;> omega
        · constructor <;>
            simp [hpos_cur, hpos_nxt] <;> omega

/-- The current iteration invariant gives a genuine extended-row contact
trace for every fixed type-1 path. -/
noncomputable def qstar_currentExtendedRowContactTrace
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} (hi : i ∈ Q0.indices) :
    TypeOneExtendedRowContactTrace Inv.base (Q0.data i hi).qstar where
  len := endpointContactTraceLen I.linkage (Q0.data i hi).qstar
  contact := endpointContact I.linkage (Q0.data i hi).qstar
  pos := fun r => Inv.qstar_endpointContactExtendedPos hi r
  contact_mem_path := endpointContact_mem_path I.linkage (Q0.data i hi).qstar
  first_pos := by
    exact
      Inv.qstar_endpointContactExtendedPos_zero (i := i) (hi := hi)
  last_pos := by
    exact
      Inv.qstar_endpointContactExtendedPos_last (i := i) (hi := hi)
  unit_step := Inv.qstar_endpointContactExtendedPos_unit_step_current
    (i := i) (hi := hi)
  contact_mem_row_of_pos := by
    classical
    intro row r hpos_eq
    by_cases hr0 : r.1 = 0
    · have hrowlt : (Inv.base.orderedRows.order row).1 < z h :=
        (Inv.base.orderedRows.order row).2
      have hpos0 :
          Inv.qstar_endpointContactExtendedPos hi r = z h + 1 := by
        have hr_eq :
            r =
              (⟨0, by simp [endpointContactTraceLen]⟩ :
                Fin (endpointContactTraceLen I.linkage
                  (Q0.data i hi).qstar + 1)) := by
          exact Fin.ext hr0
        simpa [hr_eq] using
          Inv.qstar_endpointContactExtendedPos_zero
            (i := i) (hi := hi)
      omega
    · by_cases hrlast :
        r.1 = endpointContactTraceLen I.linkage (Q0.data i hi).qstar
      · have hposlast :
            Inv.qstar_endpointContactExtendedPos hi r = 0 := by
          have hr_eq :
              r =
                (⟨endpointContactTraceLen I.linkage
                    (Q0.data i hi).qstar, by omega⟩ :
                  Fin (endpointContactTraceLen I.linkage
                    (Q0.data i hi).qstar + 1)) := by
            exact Fin.ext hrlast
          simp [hr_eq]
        omega
      · let row0 :=
          Inv.qstar_endpointContactInternalRow
            (i := i) (hi := hi) r hr0 hrlast
        have hmem :
            endpointContact I.linkage (Q0.data i hi).qstar r ∈
              (I.rowPath row0).vertexSet := by
          simpa [row0] using
            Inv.qstar_endpointContactInternalRow_mem
              (i := i) (hi := hi) r hr0 hrlast
        have hpos_internal :
            Inv.qstar_endpointContactExtendedPos hi r =
              (Inv.base.orderedRows.order row0).1 + 1 := by
          simpa [row0] using
            Inv.qstar_endpointContactExtendedPos_internal
              (i := i) (hi := hi) r hr0 hrlast
        have hval :
            (Inv.base.orderedRows.order row0).1 =
              (Inv.base.orderedRows.order row).1 := by
          omega
        have hfin :
            Inv.base.orderedRows.order row0 =
              Inv.base.orderedRows.order row := Fin.ext hval
        have hrow_eq : row0 = row :=
          Inv.base.orderedRows.order.injective hfin
        simpa [hrow_eq] using hmem

/-- Every fixed type-1 path has a current extended-row contact trace. -/
theorem qstar_currentExtendedRowContactTraces
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I) :
    ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
      Nonempty
        (TypeOneExtendedRowContactTrace Inv.base
          (Q0.data i hi).qstar) := by
  intro i hi
  exact ⟨Inv.qstar_currentExtendedRowContactTrace hi⟩

end TypeOneExtendedFutureCleanIterationInvariants

/-- In any endpoint-padded contact list, only the zeroth contact can be the
path source, provided the path has distinct endpoints. -/
theorem endpointContact_ne_source_of_ne_zero_of_source_ne_target
    {L' : PerfectPathPacking G A B} {P : GraphPath G}
    (hne : P.source ≠ P.target)
    (r : Fin (endpointContactTraceLen L' P + 1))
    (hr : r.1 ≠ 0) :
    endpointContact L' P r ≠ P.source := by
  classical
  intro hcontact
  let z0 : Fin (endpointContactTraceLen L' P + 1) :=
    ⟨0, by omega⟩
  have hbefore :
      P.Before (endpointContact L' P r) (endpointContact L' P z0) := by
    have hmem : P.source ∈ P.vertexSet :=
      GraphPath.source_mem_vertexSet P
    simpa [z0, hcontact] using P.before_refl hmem
  have hle :=
    (endpointContact_before_iff_le_of_source_ne_target L' P hne r z0).1
      hbefore
  have hz : z0.1 = 0 := rfl
  omega

/-- In any endpoint-padded contact list, only the last contact can be the path
target, provided the path has distinct endpoints. -/
theorem endpointContact_ne_target_of_ne_last_of_source_ne_target
    {L' : PerfectPathPacking G A B} {P : GraphPath G}
    (hne : P.source ≠ P.target)
    (r : Fin (endpointContactTraceLen L' P + 1))
    (hr : r.1 ≠ endpointContactTraceLen L' P) :
    endpointContact L' P r ≠ P.target := by
  classical
  intro hcontact
  let last : Fin (endpointContactTraceLen L' P + 1) :=
    ⟨endpointContactTraceLen L' P, by omega⟩
  have hbefore :
      P.Before (endpointContact L' P last) (endpointContact L' P r) := by
    have hmem : P.target ∈ P.vertexSet :=
      GraphPath.target_mem_vertexSet P
    simpa [last, hcontact] using P.before_refl hmem
  have hle :=
    (endpointContact_before_iff_le_of_source_ne_target L' P hne last r).1
      hbefore
  have hlast : last.1 = endpointContactTraceLen L' P := rfl
  omega

namespace BumpWitness

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable (Bump : BumpWitness I)

/-- Direct support statement for the bump replacement linkage, independent of
the successor `IterationInput`.

This is the support half of the no-skip proof: after replacing the bumped row,
every replacement-linkage vertex is on a successor active row, on one of the
two fixed type-1 boundary rows, or on an unchanged outside linkage path. -/
theorem replacementLinkageConcrete_vertex_mem_successor_row_or_boundary_or_outside
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {v : V}
    (hv :
      v ∈ Bump.replacementLinkageConcrete.toPathPacking.vertexSet) :
    v ∈
        (Finset.univ.biUnion fun r : I.Row =>
          (Bump.successorRowPath r).vertexSet) ∨
      v ∈ IterationInput.typeOneBoundaryVertexSet (L := L) R hpos ∨
        v ∈ IterationInput.typeOneOutsideLinkageVertexSet (L := L) R hpos := by
  classical
  rcases (Bump.replacementLinkageConcrete.toPathPacking.mem_vertexSet).1 hv with
    ⟨j, hvj⟩
  by_cases hj : j = I.rowIndex Bump.row
  · subst j
    left
    exact Finset.mem_biUnion.2
      ⟨Bump.row, Finset.mem_univ _, by
        simpa [Bump.successorRowPath_row] using hvj⟩
  · have hvOldPath : v ∈ (I.linkage.path j).vertexSet := by
      change v ∈ (Bump.replacementLinkageConcrete.path j).vertexSet at hvj
      rwa [Bump.replacementLinkageConcrete_path_of_ne hj] at hvj
    have hvOldLink : v ∈ I.linkage.toPathPacking.vertexSet :=
      (I.linkage.toPathPacking.mem_vertexSet).2 ⟨j, hvOldPath⟩
    have hraw := Inv.linkage_support hvOldLink
    rcases Finset.mem_union.1 hraw with hrow | hrest
    · rw [IterationInput.rowVertexSet] at hrow
      rcases Finset.mem_biUnion.1 hrow with ⟨r, _hr, hvr⟩
      have hr_ne : r ≠ Bump.row := by
        intro hr
        subst r
        have hvbump :
            v ∈ (I.linkage.path (I.rowIndex Bump.row)).vertexSet := by
          simpa [I.rowPath_eq_linkage_path Bump.row] using hvr
        exact Finset.disjoint_left.mp
          (I.linkage.toPathPacking.node_disjoint hj) hvOldPath hvbump
      left
      exact Finset.mem_biUnion.2
        ⟨r, Finset.mem_univ _, by
          simpa [Bump.successorRowPath_of_ne hr_ne] using hvr⟩
    · rcases Finset.mem_union.1 hrest with hboundary | houtside
      · exact Or.inr (Or.inl hboundary)
      · exact Or.inr (Or.inr houtside)

/-- A fixed type-1 path source lies on the upper boundary path of the bump
replacement linkage. -/
theorem qstar_source_mem_replacement_upperBoundary
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    (Q0.data i hi).qstar.source ∈
      (Bump.replacementLinkageConcrete.path
        Inv.extended.boundary.upperBoundary).vertexSet := by
  have hne :
      Inv.extended.boundary.upperBoundary ≠ I.rowIndex Bump.row :=
    Inv.extended.boundary.upper_ne_row Bump.row
  rw [Bump.replacementLinkageConcrete_path_of_ne hne]
  exact Inv.qstar_source_mem_current_upperBoundary (i := i) (hi := hi)

/-- A fixed type-1 path target lies on the lower boundary path of the bump
replacement linkage. -/
theorem qstar_target_mem_replacement_lowerBoundary
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    (Q0.data i hi).qstar.target ∈
      (Bump.replacementLinkageConcrete.path
        Inv.extended.boundary.lowerBoundary).vertexSet := by
  have hne :
      Inv.extended.boundary.lowerBoundary ≠ I.rowIndex Bump.row :=
    Inv.extended.boundary.lower_ne_row Bump.row
  rw [Bump.replacementLinkageConcrete_path_of_ne hne]
  exact Inv.qstar_target_mem_current_lowerBoundary (i := i) (hi := hi)

theorem qstar_source_mem_replacement_linkage
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    (Q0.data i hi).qstar.source ∈
      Bump.replacementLinkageConcrete.toPathPacking.vertexSet := by
  exact (Bump.replacementLinkageConcrete.toPathPacking.mem_vertexSet).2
    ⟨Inv.extended.boundary.upperBoundary,
      Bump.qstar_source_mem_replacement_upperBoundary Inv⟩

theorem qstar_target_mem_replacement_linkage
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    (Q0.data i hi).qstar.target ∈
      Bump.replacementLinkageConcrete.toPathPacking.vertexSet := by
  exact (Bump.replacementLinkageConcrete.toPathPacking.mem_vertexSet).2
    ⟨Inv.extended.boundary.lowerBoundary,
      Bump.qstar_target_mem_replacement_lowerBoundary Inv⟩

/-- Every non-endpoint contact of a fixed type-1 path with the bump
replacement linkage lies on a concrete successor active row. -/
theorem qstar_replacement_internal_contact_exists_successor_row
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen
      Bump.replacementLinkageConcrete (Q0.data i hi).qstar + 1))
    (hr0 : r.1 ≠ 0)
    (hrlast :
      r.1 ≠ endpointContactTraceLen
        Bump.replacementLinkageConcrete (Q0.data i hi).qstar) :
    ∃ row : I.Row,
      endpointContact Bump.replacementLinkageConcrete
          (Q0.data i hi).qstar r ∈
        (Bump.successorRowPath row).vertexSet := by
  classical
  let D := Q0.data i hi
  have hvQ :
      endpointContact Bump.replacementLinkageConcrete D.qstar r ∈
        D.qstar.vertexSet :=
    endpointContact_mem_path Bump.replacementLinkageConcrete D.qstar r
  have hvLink :
      endpointContact Bump.replacementLinkageConcrete D.qstar r ∈
        Bump.replacementLinkageConcrete.toPathPacking.vertexSet :=
    endpointContact_mem_linkage Bump.replacementLinkageConcrete D.qstar
      (Bump.qstar_source_mem_replacement_linkage Inv)
      (Bump.qstar_target_mem_replacement_linkage Inv) r
  rcases Bump.replacementLinkageConcrete_vertex_mem_successor_row_or_boundary_or_outside
      Inv hvLink with hrow | hrest
  · rw [Finset.mem_biUnion] at hrow
    rcases hrow with ⟨row, _hrow, hvrow⟩
    exact ⟨row, hvrow⟩
  rcases hrest with hboundary | houtside
  · rcases Finset.mem_union.1 hboundary with hp0 | hpz
    · have hendpoint :
          endpointContact Bump.replacementLinkageConcrete D.qstar r =
              D.qstar.source ∨
            endpointContact Bump.replacementLinkageConcrete D.qstar r =
              D.qstar.target := by
        exact D.internallyDisjointFrom_boundaries hvQ
          (Finset.mem_union.2 (Or.inl hp0))
      rcases hendpoint with hsrc | htgt
      · exact False.elim
          (endpointContact_ne_source_of_ne_zero_of_source_ne_target
            Inv.qstar_source_ne_target_current r hr0 hsrc)
      · exact False.elim
          (endpointContact_ne_target_of_ne_last_of_source_ne_target
            Inv.qstar_source_ne_target_current r hrlast htgt)
    · have hendpoint :
          endpointContact Bump.replacementLinkageConcrete D.qstar r =
              D.qstar.source ∨
            endpointContact Bump.replacementLinkageConcrete D.qstar r =
              D.qstar.target := by
        exact D.internallyDisjointFrom_boundaries hvQ
          (Finset.mem_union.2 (Or.inr hpz))
      rcases hendpoint with hsrc | htgt
      · exact False.elim
          (endpointContact_ne_source_of_ne_zero_of_source_ne_target
            Inv.qstar_source_ne_target_current r hr0 hsrc)
      · exact False.elim
          (endpointContact_ne_target_of_ne_last_of_source_ne_target
            Inv.qstar_source_ne_target_current r hrlast htgt)
  · rw [IterationInput.typeOneOutsideLinkageVertexSet] at houtside
    rcases Finset.mem_biUnion.1 houtside with ⟨j, _hj, hvjOutside⟩
    by_cases hjAllowed : j ∈ typeOneAllowedIndexSet R hpos
    · simp [hjAllowed] at hvjOutside
    · have hvj :
          endpointContact Bump.replacementLinkageConcrete D.qstar r ∈
            (L.path j).vertexSet := by
        simpa [hjAllowed] using hvjOutside
      exact False.elim
        (Finset.disjoint_left.mp
          (D.qstar_avoids_other_linkage j hjAllowed) hvQ hvj)

/-- The successor row family of a bump is exactly the row family of the
concrete replacement linkage, with the same row-index map. -/
theorem successorRowPath_eq_replacementLinkageConcrete_path
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (row : I.Row) :
    Bump.successorRowPath row =
      Bump.replacementLinkageConcrete.path (I.rowIndex row) := by
  change Bump.successorRowPath row =
    (Bump.replacementLinkage
      Bump.replacementPath_nodeDisjoint_unchanged_all).path
        (I.rowIndex row)
  exact Bump.successorRowPath_eq_linkage_path
    Bump.replacementPath_nodeDisjoint_unchanged_all
    Inv.base.rowIndexInjective row

/-- If an internal endpoint-list contact with the bump replacement linkage
lies on a successor row, its replacement-linkage contact index is exactly that
row's linkage index. -/
theorem qstar_replacement_internal_index_eq_row
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen
      Bump.replacementLinkageConcrete (Q0.data i hi).qstar + 1))
    {row : I.Row}
    (hrow :
      endpointContact Bump.replacementLinkageConcrete
          (Q0.data i hi).qstar r ∈
        (Bump.successorRowPath row).vertexSet) :
    endpointContactIndex Bump.replacementLinkageConcrete
        (Q0.data i hi).qstar
        (Bump.qstar_source_mem_replacement_linkage Inv)
        (Bump.qstar_target_mem_replacement_linkage Inv) r =
      I.rowIndex row := by
  unfold endpointContactIndex
  apply linkageIndexOfVertex_eq_of_mem
    (L := Bump.replacementLinkageConcrete)
  simpa [Bump.successorRowPath_eq_replacementLinkageConcrete_path Inv row]
    using hrow

/-- Consecutive endpoint-padded contacts with the bump replacement linkage
either stay on the same replacement-linkage path or form an edge in the
replacement auxiliary graph. -/
theorem qstar_replacementContactIndex_consecutive_aux_step
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen
      Bump.replacementLinkageConcrete (Q0.data i hi).qstar)) :
    endpointContactIndex Bump.replacementLinkageConcrete
        (Q0.data i hi).qstar
        (Bump.qstar_source_mem_replacement_linkage Inv)
        (Bump.qstar_target_mem_replacement_linkage Inv)
        ⟨r.1, by omega⟩ =
      endpointContactIndex Bump.replacementLinkageConcrete
        (Q0.data i hi).qstar
        (Bump.qstar_source_mem_replacement_linkage Inv)
        (Bump.qstar_target_mem_replacement_linkage Inv)
        ⟨r.1 + 1, by omega⟩ ∨
      (linkageAuxGraph Bump.replacementLinkageConcrete).Adj
        (endpointContactIndex Bump.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Bump.qstar_source_mem_replacement_linkage Inv)
          (Bump.qstar_target_mem_replacement_linkage Inv)
          ⟨r.1, by omega⟩)
        (endpointContactIndex Bump.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Bump.qstar_source_mem_replacement_linkage Inv)
          (Bump.qstar_target_mem_replacement_linkage Inv)
          ⟨r.1 + 1, by omega⟩) := by
  classical
  exact aux_adj_or_eq_of_clean_segment
    (L := Bump.replacementLinkageConcrete)
    ((Q0.data i hi).qstar.segmentOfBefore
      (endpointContact_before_succ_of_source_ne_target
        Bump.replacementLinkageConcrete
        (Q0.data i hi).qstar Inv.qstar_source_ne_target_current r))
    (by
      simpa using
        endpointContact_mem_contactIndex_path
          Bump.replacementLinkageConcrete (Q0.data i hi).qstar
          (Bump.qstar_source_mem_replacement_linkage Inv)
          (Bump.qstar_target_mem_replacement_linkage Inv)
          ⟨r.1, by omega⟩)
    (by
      simpa using
        endpointContact_mem_contactIndex_path
          Bump.replacementLinkageConcrete (Q0.data i hi).qstar
          (Bump.qstar_source_mem_replacement_linkage Inv)
          (Bump.qstar_target_mem_replacement_linkage Inv)
          ⟨r.1 + 1, by omega⟩)
    (endpointContactsCleanConsecutive_of_source_ne_target
      Bump.replacementLinkageConcrete
      (Q0.data i hi).qstar Inv.qstar_source_ne_target_current r)

/-- Consecutive replacement-linkage contacts that both lie on successor active
rows either lie on the same row or on consecutive rows. -/
theorem qstar_replacement_contacts_rows_eq_or_consecutive_of_succ
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Bump.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen
      Bump.replacementLinkageConcrete (Q0.data i hi).qstar))
    {row row' : I.Row}
    (hrow :
      endpointContact Bump.replacementLinkageConcrete
          (Q0.data i hi).qstar ⟨r.1, by omega⟩ ∈
        (Bump.successorRowPath row).vertexSet)
    (hrow' :
      endpointContact Bump.replacementLinkageConcrete
          (Q0.data i hi).qstar ⟨r.1 + 1, by omega⟩ ∈
        (Bump.successorRowPath row').vertexSet) :
    row = row' ∨
      FinConsecutive (Inv.base.orderedRows.order row)
        (Inv.base.orderedRows.order row') := by
  classical
  have hidx_row :
      endpointContactIndex Bump.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Bump.qstar_source_mem_replacement_linkage Inv)
          (Bump.qstar_target_mem_replacement_linkage Inv)
          ⟨r.1, by omega⟩ =
        I.rowIndex row :=
    Bump.qstar_replacement_internal_index_eq_row Inv
      ⟨r.1, by omega⟩ hrow
  have hidx_row' :
      endpointContactIndex Bump.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Bump.qstar_source_mem_replacement_linkage Inv)
          (Bump.qstar_target_mem_replacement_linkage Inv)
          ⟨r.1 + 1, by omega⟩ =
        I.rowIndex row' :=
    Bump.qstar_replacement_internal_index_eq_row Inv
      ⟨r.1 + 1, by omega⟩ hrow'
  rcases Bump.qstar_replacementContactIndex_consecutive_aux_step
      Inv (i := i) (hi := hi) r with heq | hadj
  · left
    apply Inv.base.rowIndexInjective
    simpa [hidx_row, hidx_row'] using heq
  · right
    exact Inv.extended.full.active_aux.no_chord
      ((hadj_iff (I.rowIndex row) (I.rowIndex row')).1
        (by simpa [hidx_row, hidx_row'] using hadj))

/-- If the replacement contact immediately after the upper-boundary source
lies on a successor active row, that row is the last active row. -/
theorem qstar_replacementContact_one_row_eq_last
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Bump.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    {row : I.Row}
    (hrow :
      endpointContact Bump.replacementLinkageConcrete
          (Q0.data i hi).qstar
          ⟨1, by
            have hlen :
                0 < endpointContactTraceLen
                    Bump.replacementLinkageConcrete
                    (Q0.data i hi).qstar := by
              simp [endpointContactTraceLen]
            omega⟩ ∈
        (Bump.successorRowPath row).vertexSet) :
    Inv.base.orderedRows.order row =
      (⟨z h - 1, by dsimp [z]; omega⟩ : Fin (z h)) := by
  classical
  have hlen_pos :
      0 < endpointContactTraceLen
        Bump.replacementLinkageConcrete (Q0.data i hi).qstar := by
    simp [endpointContactTraceLen]
  let r0 : Fin (endpointContactTraceLen
      Bump.replacementLinkageConcrete (Q0.data i hi).qstar) :=
    ⟨0, by simp [endpointContactTraceLen]⟩
  have hidx0 :
      endpointContactIndex Bump.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Bump.qstar_source_mem_replacement_linkage Inv)
          (Bump.qstar_target_mem_replacement_linkage Inv)
          ⟨0, by omega⟩ =
        Inv.extended.boundary.upperBoundary :=
    endpointContactIndex_zero_eq_of_source_mem
      (L := Bump.replacementLinkageConcrete)
      (Q := (Q0.data i hi).qstar)
      (Bump.qstar_source_mem_replacement_linkage Inv)
      (Bump.qstar_target_mem_replacement_linkage Inv)
      (Bump.qstar_source_mem_replacement_upperBoundary Inv)
  have hidx1 :
      endpointContactIndex Bump.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Bump.qstar_source_mem_replacement_linkage Inv)
          (Bump.qstar_target_mem_replacement_linkage Inv)
          ⟨1, by omega⟩ =
        I.rowIndex row :=
    Bump.qstar_replacement_internal_index_eq_row Inv
      ⟨1, by omega⟩ hrow
  have hidx0' :
      endpointContactIndex Bump.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Bump.qstar_source_mem_replacement_linkage Inv)
          (Bump.qstar_target_mem_replacement_linkage Inv)
          ⟨r0.1, by omega⟩ =
        Inv.extended.boundary.upperBoundary := by
    simpa [r0] using hidx0
  have hidx1' :
      endpointContactIndex Bump.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Bump.qstar_source_mem_replacement_linkage Inv)
          (Bump.qstar_target_mem_replacement_linkage Inv)
          ⟨r0.1 + 1, by omega⟩ =
        I.rowIndex row := by
    simpa [r0] using hidx1
  rcases Bump.qstar_replacementContactIndex_consecutive_aux_step
      Inv (i := i) (hi := hi) r0 with heq | hadj
  · have hrow_upper : I.rowIndex row = Inv.extended.boundary.upperBoundary := by
      simpa [hidx0', hidx1'] using heq.symm
    exact False.elim (Inv.extended.boundary.upper_ne_row row hrow_upper.symm)
  · exact Inv.extended.boundary.row_adj_upperBoundary_eq_last
      ((linkageAuxGraph I.linkage).symm
        ((hadj_iff Inv.extended.boundary.upperBoundary (I.rowIndex row)).1
          (by simpa [hidx0', hidx1'] using hadj)))

/-- If the replacement contact immediately before the lower-boundary target
lies on a successor active row, that row is the first active row. -/
theorem qstar_replacementContact_pred_last_row_eq_first
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Bump.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    {row : I.Row}
    (hrow :
      endpointContact Bump.replacementLinkageConcrete
          (Q0.data i hi).qstar
          ⟨endpointContactTraceLen Bump.replacementLinkageConcrete
                (Q0.data i hi).qstar - 1,
            by
              have hlen :
                  0 < endpointContactTraceLen
                      Bump.replacementLinkageConcrete
                      (Q0.data i hi).qstar := by
                simp [endpointContactTraceLen]
              omega⟩ ∈
        (Bump.successorRowPath row).vertexSet) :
    Inv.base.orderedRows.order row =
      (⟨0, by dsimp [z]; omega⟩ : Fin (z h)) := by
  classical
  let n := endpointContactTraceLen
    Bump.replacementLinkageConcrete (Q0.data i hi).qstar
  have hnpos : 0 < n := by
    simp [n, endpointContactTraceLen]
  let rlast : Fin n := ⟨n - 1, by omega⟩
  have hidx_pred :
      endpointContactIndex Bump.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Bump.qstar_source_mem_replacement_linkage Inv)
          (Bump.qstar_target_mem_replacement_linkage Inv)
          ⟨n - 1, by omega⟩ =
        I.rowIndex row := by
    simpa [n] using
      Bump.qstar_replacement_internal_index_eq_row Inv
        ⟨endpointContactTraceLen Bump.replacementLinkageConcrete
              (Q0.data i hi).qstar - 1,
          by omega⟩ hrow
  have hidx_last :
      endpointContactIndex Bump.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Bump.qstar_source_mem_replacement_linkage Inv)
          (Bump.qstar_target_mem_replacement_linkage Inv)
          ⟨n, by omega⟩ =
        Inv.extended.boundary.lowerBoundary := by
    simpa [n] using
      endpointContactIndex_last_eq_of_target_mem
        (L := Bump.replacementLinkageConcrete)
        (Q := (Q0.data i hi).qstar)
        (Bump.qstar_source_mem_replacement_linkage Inv)
        (Bump.qstar_target_mem_replacement_linkage Inv)
        (Bump.qstar_target_mem_replacement_lowerBoundary Inv)
  have hidx_pred' :
      endpointContactIndex Bump.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Bump.qstar_source_mem_replacement_linkage Inv)
          (Bump.qstar_target_mem_replacement_linkage Inv)
          ⟨rlast.1, by omega⟩ =
        I.rowIndex row := by
    simpa [rlast] using hidx_pred
  have hidx_last' :
      endpointContactIndex Bump.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Bump.qstar_source_mem_replacement_linkage Inv)
          (Bump.qstar_target_mem_replacement_linkage Inv)
          ⟨rlast.1 + 1, by omega⟩ =
        Inv.extended.boundary.lowerBoundary := by
    simpa [rlast, n, hnpos] using hidx_last
  rcases Bump.qstar_replacementContactIndex_consecutive_aux_step
      Inv (i := i) (hi := hi) rlast with heq | hadj
  · have hrow_lower : I.rowIndex row = Inv.extended.boundary.lowerBoundary := by
      simpa [hidx_pred', hidx_last'] using heq
    exact False.elim (Inv.extended.boundary.lower_ne_row row hrow_lower.symm)
  · exact Inv.extended.boundary.row_adj_lowerBoundary_eq_first
      ((linkageAuxGraph I.linkage).symm
        ((hadj_iff (I.rowIndex row) Inv.extended.boundary.lowerBoundary).1
          (by simpa [hidx_pred', hidx_last'] using hadj)))

/-- The endpoint-padded contact list with the bump replacement linkage has an
internal contact: pick any unchanged active row distinct from the bumped row,
which every fixed type-1 path still meets. -/
theorem qstar_replacementContactTraceLen_two_le
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    2 ≤ endpointContactTraceLen
      Bump.replacementLinkageConcrete (Q0.data i hi).qstar := by
  classical
  let order := Inv.base.orderedRows.order
  have hrow_exists : ∃ row0 : I.Row, row0 ≠ Bump.row := by
    by_cases hbump_zero : (order Bump.row).1 = 0
    · let row0 : I.Row :=
        order.symm (⟨1, by dsimp [z]; omega⟩ : Fin (z h))
      refine ⟨row0, ?_⟩
      intro hrow
      have hfin :
          (⟨1, by dsimp [z]; omega⟩ : Fin (z h)) =
            order Bump.row := by
        calc
          (⟨1, by dsimp [z]; omega⟩ : Fin (z h)) =
              order row0 := by simp [row0]
          _ = order Bump.row := by rw [hrow]
      have hval := congrArg Fin.val hfin
      simp [hbump_zero] at hval
    · let row0 : I.Row :=
        order.symm (⟨0, by dsimp [z]; omega⟩ : Fin (z h))
      refine ⟨row0, ?_⟩
      intro hrow
      have hfin :
          (⟨0, by dsimp [z]; omega⟩ : Fin (z h)) =
            order Bump.row := by
        calc
          (⟨0, by dsimp [z]; omega⟩ : Fin (z h)) =
              order row0 := by simp [row0]
          _ = order Bump.row := by rw [hrow]
      exact hbump_zero (congrArg Fin.val hfin).symm
  rcases hrow_exists with ⟨row0, hrow0_ne⟩
  rcases (I.q0_intersection_invariant i hi).1 row0 with
    ⟨v, hvQrow⟩
  have hvQ : v ∈ (Q0.data i hi).qstar.vertexSet :=
    (Finset.mem_inter.1 hvQrow).1
  have hvrow : v ∈ (I.rowPath row0).vertexSet :=
    (Finset.mem_inter.1 hvQrow).2
  have hidx_ne : I.rowIndex row0 ≠ I.rowIndex Bump.row := by
    intro hidx
    exact hrow0_ne (Inv.base.rowIndexInjective hidx)
  have hvRepPath :
      v ∈ (Bump.replacementLinkageConcrete.path
        (I.rowIndex row0)).vertexSet := by
    rw [Bump.replacementLinkageConcrete_path_of_ne hidx_ne]
    simpa [I.rowPath_eq_linkage_path row0] using hvrow
  have hvRepLink :
      v ∈ Bump.replacementLinkageConcrete.toPathPacking.vertexSet :=
    (Bump.replacementLinkageConcrete.toPathPacking.mem_vertexSet).2
      ⟨I.rowIndex row0, hvRepPath⟩
  have hv_ne_source :
      v ≠ (Q0.data i hi).qstar.source := by
    intro hvsrc
    have hsrc_upper :
        v ∈
          (Bump.replacementLinkageConcrete.path
            Inv.extended.boundary.upperBoundary).vertexSet := by
      simpa [hvsrc] using
        Bump.qstar_source_mem_replacement_upperBoundary
          Inv (i := i) (hi := hi)
    exact Finset.disjoint_left.mp
      (Bump.replacementLinkageConcrete.toPathPacking.node_disjoint
        (Inv.extended.boundary.upper_ne_row row0))
      hsrc_upper hvRepPath
  have hv_ne_target :
      v ≠ (Q0.data i hi).qstar.target := by
    intro hvtgt
    have htgt_lower :
        v ∈
          (Bump.replacementLinkageConcrete.path
            Inv.extended.boundary.lowerBoundary).vertexSet := by
      simpa [hvtgt] using
        Bump.qstar_target_mem_replacement_lowerBoundary
          Inv (i := i) (hi := hi)
    exact Finset.disjoint_left.mp
      (Bump.replacementLinkageConcrete.toPathPacking.node_disjoint
        (Inv.extended.boundary.lower_ne_row row0))
      htgt_lower hvRepPath
  have hvMid :
      v ∈ internalLinkageContactVertexList
        Bump.replacementLinkageConcrete (Q0.data i hi).qstar := by
    have hvSupportMid :
        v ∈ (Q0.data i hi).qstar.walk.support.tail.dropLast :=
      mem_support_tail_dropLast_of_mem_vertexSet_of_ne_endpoints
        (Q0.data i hi).qstar hvQ hv_ne_source hv_ne_target
    simp [internalLinkageContactVertexList, hvSupportMid, hvRepLink]
  have hlen_pos :
      0 < (internalLinkageContactVertexList
        Bump.replacementLinkageConcrete (Q0.data i hi).qstar).length :=
    List.length_pos_of_mem hvMid
  simp [endpointContactTraceLen]
  omega

noncomputable def qstar_replacementContactInternalRow
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen
      Bump.replacementLinkageConcrete (Q0.data i hi).qstar + 1))
    (hr0 : r.1 ≠ 0)
    (hrlast :
      r.1 ≠ endpointContactTraceLen
        Bump.replacementLinkageConcrete (Q0.data i hi).qstar) :
    I.Row :=
  Classical.choose
    (Bump.qstar_replacement_internal_contact_exists_successor_row
      Inv r hr0 hrlast)

theorem qstar_replacementContactInternalRow_mem
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen
      Bump.replacementLinkageConcrete (Q0.data i hi).qstar + 1))
    (hr0 : r.1 ≠ 0)
    (hrlast :
      r.1 ≠ endpointContactTraceLen
        Bump.replacementLinkageConcrete (Q0.data i hi).qstar) :
    endpointContact Bump.replacementLinkageConcrete
        (Q0.data i hi).qstar r ∈
      (Bump.successorRowPath
        (Bump.qstar_replacementContactInternalRow Inv r hr0 hrlast)).vertexSet :=
  Classical.choose_spec
    (Bump.qstar_replacement_internal_contact_exists_successor_row
      Inv r hr0 hrlast)

noncomputable def qstar_replacementContactExtendedPos
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} (hi : i ∈ Q0.indices)
    (r : Fin (endpointContactTraceLen
      Bump.replacementLinkageConcrete (Q0.data i hi).qstar + 1)) :
    ℕ :=
  if hr0 : r.1 = 0 then
    z h + 1
  else if hrlast :
      r.1 = endpointContactTraceLen
        Bump.replacementLinkageConcrete (Q0.data i hi).qstar then
    0
  else
    (Inv.base.orderedRows.order
      (Bump.qstar_replacementContactInternalRow Inv r hr0 hrlast)).1 + 1

@[simp] theorem qstar_replacementContactExtendedPos_zero
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    Bump.qstar_replacementContactExtendedPos Inv hi
        ⟨0, by simp [endpointContactTraceLen]⟩ =
      z h + 1 := by
  simp [qstar_replacementContactExtendedPos]

@[simp] theorem qstar_replacementContactExtendedPos_last
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    Bump.qstar_replacementContactExtendedPos Inv hi
        ⟨endpointContactTraceLen Bump.replacementLinkageConcrete
            (Q0.data i hi).qstar, by omega⟩ =
      0 := by
  have hpos :
      0 < endpointContactTraceLen
        Bump.replacementLinkageConcrete (Q0.data i hi).qstar := by
    simp [endpointContactTraceLen]
  simp [qstar_replacementContactExtendedPos, hpos.ne']

theorem qstar_replacementContactExtendedPos_internal
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen
      Bump.replacementLinkageConcrete (Q0.data i hi).qstar + 1))
    (hr0 : r.1 ≠ 0)
    (hrlast :
      r.1 ≠ endpointContactTraceLen
        Bump.replacementLinkageConcrete (Q0.data i hi).qstar) :
    Bump.qstar_replacementContactExtendedPos Inv hi r =
      (Inv.base.orderedRows.order
        (Bump.qstar_replacementContactInternalRow Inv r hr0 hrlast)).1 + 1 := by
  simp [qstar_replacementContactExtendedPos, hr0, hrlast]

/-- The bump replacement contact positions form a unit-step trace from the
upper boundary to the lower boundary. -/
theorem qstar_replacementContactExtendedPos_unit_step
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Bump.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    UnitStepNatTrace
      (endpointContactTraceLen
        Bump.replacementLinkageConcrete (Q0.data i hi).qstar)
      (fun r =>
        Bump.qstar_replacementContactExtendedPos Inv hi r) := by
  classical
  let n := endpointContactTraceLen
    Bump.replacementLinkageConcrete (Q0.data i hi).qstar
  have hn_two : 2 ≤ n := by
    simpa [n] using
      Bump.qstar_replacementContactTraceLen_two_le
        Inv (i := i) (hi := hi)
  intro r
  let cur : Fin (endpointContactTraceLen
      Bump.replacementLinkageConcrete (Q0.data i hi).qstar + 1) :=
    ⟨r.1, by omega⟩
  let nxt : Fin (endpointContactTraceLen
      Bump.replacementLinkageConcrete (Q0.data i hi).qstar + 1) :=
    ⟨r.1 + 1, by omega⟩
  change
    Bump.qstar_replacementContactExtendedPos Inv hi nxt ≤
        Bump.qstar_replacementContactExtendedPos Inv hi cur + 1 ∧
      Bump.qstar_replacementContactExtendedPos Inv hi cur ≤
        Bump.qstar_replacementContactExtendedPos Inv hi nxt + 1
  by_cases hcur0 : r.1 = 0
  · have hnxt_not_last : nxt.1 ≠ n := by
      simp [nxt, n]
      omega
    have hnxt_not_zero : nxt.1 ≠ 0 := by
      simp [nxt]
    let row :=
      Bump.qstar_replacementContactInternalRow
        Inv (i := i) (hi := hi) nxt hnxt_not_zero hnxt_not_last
    have hrowmem :
        endpointContact Bump.replacementLinkageConcrete
            (Q0.data i hi).qstar
            ⟨1, by simp [endpointContactTraceLen]⟩ ∈
          (Bump.successorRowPath row).vertexSet := by
      simpa [row, nxt, hcur0] using
        Bump.qstar_replacementContactInternalRow_mem
          Inv (i := i) (hi := hi) nxt hnxt_not_zero hnxt_not_last
    have hrow_last :
        Inv.base.orderedRows.order row =
          (⟨z h - 1, by dsimp [z]; omega⟩ : Fin (z h)) :=
      Bump.qstar_replacementContact_one_row_eq_last
        (hpos := hpos) Inv hadj_iff (i := i) (hi := hi) hrowmem
    have hrow_val :
        (Inv.base.orderedRows.order row).1 = z h - 1 :=
      congrArg Fin.val hrow_last
    have hpos_cur :
        Bump.qstar_replacementContactExtendedPos Inv hi cur = z h + 1 := by
      have hcur_eq :
          cur =
            (⟨0, by simp [endpointContactTraceLen]⟩ :
              Fin (endpointContactTraceLen
                Bump.replacementLinkageConcrete
                (Q0.data i hi).qstar + 1)) := by
        exact Fin.ext (by simp [cur, hcur0])
      simpa [hcur_eq] using
        Bump.qstar_replacementContactExtendedPos_zero
          Inv (i := i) (hi := hi)
    have hpos_nxt :
        Bump.qstar_replacementContactExtendedPos Inv hi nxt = z h := by
      have hchosen_val :
          (Inv.base.orderedRows.order
            (Bump.qstar_replacementContactInternalRow
              Inv (i := i) (hi := hi) nxt hnxt_not_zero
                hnxt_not_last)).1 =
            z h - 1 := by
        simpa [row] using hrow_val
      rw [Bump.qstar_replacementContactExtendedPos_internal
        Inv (i := i) (hi := hi) (r := nxt) hnxt_not_zero
        hnxt_not_last]
      omega
    constructor <;> simp [hpos_cur, hpos_nxt] <;> omega
  · by_cases hnext_last : r.1 + 1 = n
    · have hcur_not_zero : cur.1 ≠ 0 := by
        simp [cur, n]
        omega
      have hcur_not_last : cur.1 ≠ n := by
        simp [cur]
        omega
      let row :=
        Bump.qstar_replacementContactInternalRow
          Inv (i := i) (hi := hi) cur hcur_not_zero hcur_not_last
      have hcur_eq_pred :
          cur =
            (⟨endpointContactTraceLen Bump.replacementLinkageConcrete
                    (Q0.data i hi).qstar - 1,
                by simp [endpointContactTraceLen]⟩ :
              Fin (endpointContactTraceLen
                Bump.replacementLinkageConcrete
                (Q0.data i hi).qstar + 1)) := by
        apply Fin.ext
        simp [cur]
        omega
      have hrowmem :
          endpointContact Bump.replacementLinkageConcrete
              (Q0.data i hi).qstar
              ⟨endpointContactTraceLen Bump.replacementLinkageConcrete
                    (Q0.data i hi).qstar - 1,
                by simp [endpointContactTraceLen]⟩ ∈
            (Bump.successorRowPath row).vertexSet := by
        simpa [row, hcur_eq_pred] using
          Bump.qstar_replacementContactInternalRow_mem
            Inv (i := i) (hi := hi) cur hcur_not_zero hcur_not_last
      have hrow_first :
          Inv.base.orderedRows.order row =
            (⟨0, by dsimp [z]; omega⟩ : Fin (z h)) :=
        Bump.qstar_replacementContact_pred_last_row_eq_first
          (hpos := hpos) Inv hadj_iff (i := i) (hi := hi) hrowmem
      have hrow_val :
          (Inv.base.orderedRows.order row).1 = 0 :=
        congrArg Fin.val hrow_first
      have hpos_cur :
          Bump.qstar_replacementContactExtendedPos Inv hi cur = 1 := by
        rw [Bump.qstar_replacementContactExtendedPos_internal
          Inv (i := i) (hi := hi) (r := cur) hcur_not_zero hcur_not_last]
        simpa [row, hrow_val] using hrow_val
      have hpos_nxt :
          Bump.qstar_replacementContactExtendedPos Inv hi nxt = 0 := by
        have hnxt_eq :
            nxt =
              (⟨endpointContactTraceLen Bump.replacementLinkageConcrete
                    (Q0.data i hi).qstar, by omega⟩ :
                Fin (endpointContactTraceLen
                  Bump.replacementLinkageConcrete
                  (Q0.data i hi).qstar + 1)) := by
          apply Fin.ext
          simp [nxt, n, hnext_last]
        simpa [hnxt_eq] using
          Bump.qstar_replacementContactExtendedPos_last
            Inv (i := i) (hi := hi)
      constructor <;> simp [hpos_cur, hpos_nxt] <;> omega
    · have hcur_not_last : cur.1 ≠ n := by
        simp [cur]
        omega
      have hnxt_not_zero : nxt.1 ≠ 0 := by
        simp [nxt]
      have hnxt_not_last : nxt.1 ≠ n := by
        simpa [nxt] using hnext_last
      let row :=
        Bump.qstar_replacementContactInternalRow
          Inv (i := i) (hi := hi) cur hcur0 hcur_not_last
      let row' :=
        Bump.qstar_replacementContactInternalRow
          Inv (i := i) (hi := hi) nxt hnxt_not_zero hnxt_not_last
      have hrowmem :
          endpointContact Bump.replacementLinkageConcrete
              (Q0.data i hi).qstar ⟨r.1, by omega⟩ ∈
            (Bump.successorRowPath row).vertexSet := by
        simpa [row, cur, n] using
          Bump.qstar_replacementContactInternalRow_mem
            Inv (i := i) (hi := hi) cur hcur0 hcur_not_last
      have hrowmem' :
          endpointContact Bump.replacementLinkageConcrete
              (Q0.data i hi).qstar ⟨r.1 + 1, by omega⟩ ∈
            (Bump.successorRowPath row').vertexSet := by
        simpa [row', nxt, n] using
          Bump.qstar_replacementContactInternalRow_mem
            Inv (i := i) (hi := hi) nxt hnxt_not_zero hnxt_not_last
      have hpos_cur :
          Bump.qstar_replacementContactExtendedPos Inv hi cur =
            (Inv.base.orderedRows.order row).1 + 1 := by
        rw [Bump.qstar_replacementContactExtendedPos_internal
          Inv (i := i) (hi := hi) (r := cur) hcur0 hcur_not_last]
      have hpos_nxt :
          Bump.qstar_replacementContactExtendedPos Inv hi nxt =
            (Inv.base.orderedRows.order row').1 + 1 := by
        rw [Bump.qstar_replacementContactExtendedPos_internal
          Inv (i := i) (hi := hi) (r := nxt) hnxt_not_zero hnxt_not_last]
      rcases Bump.qstar_replacement_contacts_rows_eq_or_consecutive_of_succ
          Inv hadj_iff (i := i) (hi := hi) r hrowmem hrowmem'
        with hsame | hcon
      · have hval_eq :
            (Inv.base.orderedRows.order row).1 =
              (Inv.base.orderedRows.order row').1 := by
          rw [hsame]
        constructor <;> simp [hpos_cur, hpos_nxt] <;> omega
      · rcases hcon with hsucc | hpred
        · constructor <;> simp [hpos_cur, hpos_nxt] <;> omega
        · constructor <;> simp [hpos_cur, hpos_nxt] <;> omega

noncomputable def qstar_replacementBareExtendedRowContactTrace
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Bump.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j)
    {i : Q.Index} (hi : i ∈ Q0.indices) :
    TypeOneBareExtendedRowContactTrace
      (h := h) I.Row Inv.base.orderedRows.order
      Bump.successorRowPath (Q0.data i hi).qstar where
  len := endpointContactTraceLen
    Bump.replacementLinkageConcrete (Q0.data i hi).qstar
  contact := endpointContact Bump.replacementLinkageConcrete
    (Q0.data i hi).qstar
  pos := fun r => Bump.qstar_replacementContactExtendedPos Inv hi r
  contact_mem_path :=
    endpointContact_mem_path Bump.replacementLinkageConcrete
      (Q0.data i hi).qstar
  first_pos := by
    simpa using
      Bump.qstar_replacementContactExtendedPos_zero
        Inv (i := i) (hi := hi)
  last_pos := by
    simpa using
      Bump.qstar_replacementContactExtendedPos_last
        Inv (i := i) (hi := hi)
  unit_step :=
    Bump.qstar_replacementContactExtendedPos_unit_step
      Inv hadj_iff (i := i) (hi := hi)
  contact_mem_row_of_pos := by
    classical
    intro row r hpos_eq
    by_cases hr0 : r.1 = 0
    · have hrowlt : (Inv.base.orderedRows.order row).1 < z h :=
        (Inv.base.orderedRows.order row).2
      have hpos0 :
          Bump.qstar_replacementContactExtendedPos Inv hi r = z h + 1 := by
        have hr_eq :
            r =
              (⟨0, by simp [endpointContactTraceLen]⟩ :
                Fin (endpointContactTraceLen
                  Bump.replacementLinkageConcrete
                  (Q0.data i hi).qstar + 1)) := by
          exact Fin.ext hr0
        simpa [hr_eq] using
          Bump.qstar_replacementContactExtendedPos_zero
            Inv (i := i) (hi := hi)
      omega
    · by_cases hrlast :
        r.1 = endpointContactTraceLen
          Bump.replacementLinkageConcrete (Q0.data i hi).qstar
      · have hposlast :
            Bump.qstar_replacementContactExtendedPos Inv hi r = 0 := by
          have hr_eq :
              r =
                (⟨endpointContactTraceLen
                    Bump.replacementLinkageConcrete
                    (Q0.data i hi).qstar, by omega⟩ :
                  Fin (endpointContactTraceLen
                    Bump.replacementLinkageConcrete
                    (Q0.data i hi).qstar + 1)) := by
            exact Fin.ext hrlast
          simpa [hr_eq] using
            Bump.qstar_replacementContactExtendedPos_last
              Inv (i := i) (hi := hi)
        omega
      · let row0 :=
          Bump.qstar_replacementContactInternalRow
            Inv (i := i) (hi := hi) r hr0 hrlast
        have hmem :
            endpointContact Bump.replacementLinkageConcrete
                (Q0.data i hi).qstar r ∈
              (Bump.successorRowPath row0).vertexSet := by
          simpa [row0] using
            Bump.qstar_replacementContactInternalRow_mem
              Inv (i := i) (hi := hi) r hr0 hrlast
        have hpos_internal :
            Bump.qstar_replacementContactExtendedPos Inv hi r =
              (Inv.base.orderedRows.order row0).1 + 1 := by
          simpa [row0] using
            Bump.qstar_replacementContactExtendedPos_internal
              Inv (i := i) (hi := hi) r hr0 hrlast
        have hval :
            (Inv.base.orderedRows.order row0).1 =
              (Inv.base.orderedRows.order row).1 := by
          omega
        have hfin :
            Inv.base.orderedRows.order row0 =
              Inv.base.orderedRows.order row := Fin.ext hval
        have hrow_eq : row0 = row :=
          Inv.base.orderedRows.order.injective hfin
        simpa [hrow_eq] using hmem

/-- The no-skip replacement-row contact survival for a bump. -/
theorem replacement_hit_of_aux_adjacency_preserved
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Bump.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j) :
    ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
      HitsGraphPath (Q0.data i hi).qstar Bump.replacementPath.path := by
  intro i hi
  let T :=
    Bump.qstar_replacementBareExtendedRowContactTrace
      Inv hadj_iff (i := i) hi
  have hhit := T.hits_all_rows Bump.row
  simpa [Bump.successorRowPath_row] using hhit

end BumpWitness

/-! #### Immediate old auxiliary data for crosses -/

namespace CrossWitness

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}

/-! ##### No-skip successor traces for the left-to-right cross branch -/

variable (Cross : CrossWitness I)

/-- Direct support statement for the left-to-right cross replacement linkage.
Every successor-linkage vertex is either on a displayed successor active row, on
one of the two fixed type-1 boundary rows, or on an unchanged outside linkage
path. -/
theorem replacementLinkageConcrete_vertex_mem_successorRowPathLeftRight_or_boundary_or_outside
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {v : V}
    (hv :
      v ∈ Cross.replacementLinkageConcrete.toPathPacking.vertexSet) :
    v ∈
        (Finset.univ.biUnion fun r : I.Row =>
          (Cross.successorRowPathLeftRight r).vertexSet) ∨
      v ∈ IterationInput.typeOneBoundaryVertexSet (L := L) R hpos ∨
        v ∈ IterationInput.typeOneOutsideLinkageVertexSet (L := L) R hpos := by
  classical
  rcases (Cross.replacementLinkageConcrete.toPathPacking.mem_vertexSet).1 hv with
    ⟨j, hvj⟩
  by_cases hleft : j = I.rowIndex Cross.rowLeft
  · subst j
    left
    exact Finset.mem_biUnion.2
      ⟨Cross.rowLeft, Finset.mem_univ _, by
        simpa [Cross.successorRowPathLeftRight_left] using hvj⟩
  · by_cases hright : j = I.rowIndex Cross.rowRight
    · subst j
      left
      exact Finset.mem_biUnion.2
        ⟨Cross.rowRight, Finset.mem_univ _, by
          simpa [Cross.successorRowPathLeftRight_right] using hvj⟩
    · have hvOldPath : v ∈ (I.linkage.path j).vertexSet := by
        change v ∈ (Cross.replacementLinkageConcrete.path j).vertexSet at hvj
        rwa [Cross.replacementLinkageConcrete_path_of_ne hleft hright] at hvj
      have hvOldLink : v ∈ I.linkage.toPathPacking.vertexSet :=
        (I.linkage.toPathPacking.mem_vertexSet).2 ⟨j, hvOldPath⟩
      have hraw := Inv.linkage_support hvOldLink
      rcases Finset.mem_union.1 hraw with hrow | hrest
      · rw [IterationInput.rowVertexSet] at hrow
        rcases Finset.mem_biUnion.1 hrow with ⟨r, _hr, hvr⟩
        have hr_ne_left : r ≠ Cross.rowLeft := by
          intro hr
          subst r
          have hvleft :
              v ∈ (I.linkage.path (I.rowIndex Cross.rowLeft)).vertexSet := by
            simpa [I.rowPath_eq_linkage_path Cross.rowLeft] using hvr
          exact Finset.disjoint_left.mp
            (I.linkage.toPathPacking.node_disjoint hleft) hvOldPath hvleft
        have hr_ne_right : r ≠ Cross.rowRight := by
          intro hr
          subst r
          have hvright :
              v ∈ (I.linkage.path (I.rowIndex Cross.rowRight)).vertexSet := by
            simpa [I.rowPath_eq_linkage_path Cross.rowRight] using hvr
          exact Finset.disjoint_left.mp
            (I.linkage.toPathPacking.node_disjoint hright) hvOldPath hvright
        left
        exact Finset.mem_biUnion.2
          ⟨r, Finset.mem_univ _, by
            simpa [Cross.successorRowPathLeftRight_of_ne
              hr_ne_left hr_ne_right] using hvr⟩
      · rcases Finset.mem_union.1 hrest with hboundary | houtside
        · exact Or.inr (Or.inl hboundary)
        · exact Or.inr (Or.inr houtside)

/-- A fixed type-1 path source lies on the upper boundary path of the cross
replacement linkage. -/
theorem qstar_source_mem_replacement_upperBoundary
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    (Q0.data i hi).qstar.source ∈
      (Cross.replacementLinkageConcrete.path
        Inv.extended.boundary.upperBoundary).vertexSet := by
  have hne_left :
      Inv.extended.boundary.upperBoundary ≠ I.rowIndex Cross.rowLeft :=
    Inv.extended.boundary.upper_ne_row Cross.rowLeft
  have hne_right :
      Inv.extended.boundary.upperBoundary ≠ I.rowIndex Cross.rowRight :=
    Inv.extended.boundary.upper_ne_row Cross.rowRight
  rw [Cross.replacementLinkageConcrete_path_of_ne hne_left hne_right]
  exact Inv.qstar_source_mem_current_upperBoundary (i := i) (hi := hi)

/-- A fixed type-1 path target lies on the lower boundary path of the cross
replacement linkage. -/
theorem qstar_target_mem_replacement_lowerBoundary
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    (Q0.data i hi).qstar.target ∈
      (Cross.replacementLinkageConcrete.path
        Inv.extended.boundary.lowerBoundary).vertexSet := by
  have hne_left :
      Inv.extended.boundary.lowerBoundary ≠ I.rowIndex Cross.rowLeft :=
    Inv.extended.boundary.lower_ne_row Cross.rowLeft
  have hne_right :
      Inv.extended.boundary.lowerBoundary ≠ I.rowIndex Cross.rowRight :=
    Inv.extended.boundary.lower_ne_row Cross.rowRight
  rw [Cross.replacementLinkageConcrete_path_of_ne hne_left hne_right]
  exact Inv.qstar_target_mem_current_lowerBoundary (i := i) (hi := hi)

theorem qstar_source_mem_replacement_linkage
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    (Q0.data i hi).qstar.source ∈
      Cross.replacementLinkageConcrete.toPathPacking.vertexSet := by
  exact (Cross.replacementLinkageConcrete.toPathPacking.mem_vertexSet).2
    ⟨Inv.extended.boundary.upperBoundary,
      Cross.qstar_source_mem_replacement_upperBoundary Inv⟩

theorem qstar_target_mem_replacement_linkage
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    (Q0.data i hi).qstar.target ∈
      Cross.replacementLinkageConcrete.toPathPacking.vertexSet := by
  exact (Cross.replacementLinkageConcrete.toPathPacking.mem_vertexSet).2
    ⟨Inv.extended.boundary.lowerBoundary,
      Cross.qstar_target_mem_replacement_lowerBoundary Inv⟩

/-- The fixed lower and upper boundary vertices are not adjacent in the old
auxiliary graph. -/
theorem no_old_aux_adj_lower_upper
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I) :
    ¬ (linkageAuxGraph I.linkage).Adj
      Inv.extended.boundary.lowerBoundary
      Inv.extended.boundary.upperBoundary := by
  classical
  intro hadj
  let firstRow : I.Row :=
    Inv.base.orderedRows.order.symm
      (⟨0, by dsimp [z]; omega⟩ : Fin (z h))
  have hfirst_idx_ne_outside :
      Inv.extended.boundary.lowerOutside ≠ I.rowIndex firstRow :=
    Inv.extended.boundary.lowerOutside_ne_row firstRow
  have hneighbors :=
    DegreeEquals.two_adj_eq_or_eq Inv.extended.boundary.lower_degree_two
      Inv.extended.boundary.lower_adj_outside
      Inv.extended.boundary.lower_adj_first hfirst_idx_ne_outside hadj
  rcases hneighbors with hupper_outside | hupper_first
  · exact Inv.extended.boundary.lowerOutside_ne_upper hupper_outside.symm
  · exact Inv.extended.boundary.upper_ne_row firstRow hupper_first

/-- Every non-endpoint contact of a fixed type-1 path with the left-to-right
cross replacement linkage lies on a concrete successor active row. -/
theorem qstar_replacement_internal_contact_exists_successor_row_leftRight
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen
      Cross.replacementLinkageConcrete (Q0.data i hi).qstar + 1))
    (hr0 : r.1 ≠ 0)
    (hrlast :
      r.1 ≠ endpointContactTraceLen
        Cross.replacementLinkageConcrete (Q0.data i hi).qstar) :
    ∃ row : I.Row,
      endpointContact Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar r ∈
        (Cross.successorRowPathLeftRight row).vertexSet := by
  classical
  let D := Q0.data i hi
  have hvQ :
      endpointContact Cross.replacementLinkageConcrete D.qstar r ∈
        D.qstar.vertexSet :=
    endpointContact_mem_path Cross.replacementLinkageConcrete D.qstar r
  have hvLink :
      endpointContact Cross.replacementLinkageConcrete D.qstar r ∈
        Cross.replacementLinkageConcrete.toPathPacking.vertexSet :=
    endpointContact_mem_linkage Cross.replacementLinkageConcrete D.qstar
      (Cross.qstar_source_mem_replacement_linkage Inv)
      (Cross.qstar_target_mem_replacement_linkage Inv) r
  rcases Cross.replacementLinkageConcrete_vertex_mem_successorRowPathLeftRight_or_boundary_or_outside
      Inv hvLink with hrow | hrest
  · rw [Finset.mem_biUnion] at hrow
    rcases hrow with ⟨row, _hrow, hvrow⟩
    exact ⟨row, hvrow⟩
  rcases hrest with hboundary | houtside
  · rcases Finset.mem_union.1 hboundary with hp0 | hpz
    · have hendpoint :
          endpointContact Cross.replacementLinkageConcrete D.qstar r =
              D.qstar.source ∨
            endpointContact Cross.replacementLinkageConcrete D.qstar r =
              D.qstar.target := by
        exact D.internallyDisjointFrom_boundaries hvQ
          (Finset.mem_union.2 (Or.inl hp0))
      rcases hendpoint with hsrc | htgt
      · exact False.elim
          (endpointContact_ne_source_of_ne_zero_of_source_ne_target
            Inv.qstar_source_ne_target_current r hr0 hsrc)
      · exact False.elim
          (endpointContact_ne_target_of_ne_last_of_source_ne_target
            Inv.qstar_source_ne_target_current r hrlast htgt)
    · have hendpoint :
          endpointContact Cross.replacementLinkageConcrete D.qstar r =
              D.qstar.source ∨
            endpointContact Cross.replacementLinkageConcrete D.qstar r =
              D.qstar.target := by
        exact D.internallyDisjointFrom_boundaries hvQ
          (Finset.mem_union.2 (Or.inr hpz))
      rcases hendpoint with hsrc | htgt
      · exact False.elim
          (endpointContact_ne_source_of_ne_zero_of_source_ne_target
            Inv.qstar_source_ne_target_current r hr0 hsrc)
      · exact False.elim
          (endpointContact_ne_target_of_ne_last_of_source_ne_target
            Inv.qstar_source_ne_target_current r hrlast htgt)
  · rw [IterationInput.typeOneOutsideLinkageVertexSet] at houtside
    rcases Finset.mem_biUnion.1 houtside with ⟨j, _hj, hvjOutside⟩
    by_cases hjAllowed : j ∈ typeOneAllowedIndexSet R hpos
    · simp [hjAllowed] at hvjOutside
    · have hvj :
          endpointContact Cross.replacementLinkageConcrete D.qstar r ∈
            (L.path j).vertexSet := by
        simpa [hjAllowed] using hvjOutside
      exact False.elim
        (Finset.disjoint_left.mp
          (D.qstar_avoids_other_linkage j hjAllowed) hvQ hvj)

/-- If an internal endpoint-list contact with the left-to-right cross
replacement linkage lies on a successor row, its replacement-linkage contact
index is exactly that row's linkage index. -/
theorem qstar_replacement_internal_index_eq_row_leftRight
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen
      Cross.replacementLinkageConcrete (Q0.data i hi).qstar + 1))
    {row : I.Row}
    (hrow :
      endpointContact Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar r ∈
        (Cross.successorRowPathLeftRight row).vertexSet) :
    endpointContactIndex Cross.replacementLinkageConcrete
        (Q0.data i hi).qstar
        (Cross.qstar_source_mem_replacement_linkage Inv)
        (Cross.qstar_target_mem_replacement_linkage Inv) r =
      I.rowIndex row := by
  unfold endpointContactIndex
  apply linkageIndexOfVertex_eq_of_mem (L := Cross.replacementLinkageConcrete)
  simpa [Cross.successorRowPathLeftRight_eq_linkage_path row] using hrow

/-- Consecutive endpoint-padded contacts with the cross replacement linkage
either stay on the same replacement-linkage path or form an edge in the
replacement auxiliary graph. -/
theorem qstar_replacementContactIndex_consecutive_aux_step
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen
      Cross.replacementLinkageConcrete (Q0.data i hi).qstar)) :
    endpointContactIndex Cross.replacementLinkageConcrete
        (Q0.data i hi).qstar
        (Cross.qstar_source_mem_replacement_linkage Inv)
        (Cross.qstar_target_mem_replacement_linkage Inv)
        ⟨r.1, by omega⟩ =
      endpointContactIndex Cross.replacementLinkageConcrete
        (Q0.data i hi).qstar
        (Cross.qstar_source_mem_replacement_linkage Inv)
        (Cross.qstar_target_mem_replacement_linkage Inv)
        ⟨r.1 + 1, by omega⟩ ∨
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        (endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨r.1, by omega⟩)
        (endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨r.1 + 1, by omega⟩) := by
  classical
  exact aux_adj_or_eq_of_clean_segment
    (L := Cross.replacementLinkageConcrete)
    ((Q0.data i hi).qstar.segmentOfBefore
      (endpointContact_before_succ_of_source_ne_target
        Cross.replacementLinkageConcrete
        (Q0.data i hi).qstar Inv.qstar_source_ne_target_current r))
    (by
      simpa using
        endpointContact_mem_contactIndex_path
          Cross.replacementLinkageConcrete (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨r.1, by omega⟩)
    (by
      simpa using
        endpointContact_mem_contactIndex_path
          Cross.replacementLinkageConcrete (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨r.1 + 1, by omega⟩)
    (endpointContactsCleanConsecutive_of_source_ne_target
      Cross.replacementLinkageConcrete
      (Q0.data i hi).qstar Inv.qstar_source_ne_target_current r)

/-- Consecutive left-to-right replacement-linkage contacts that both lie on
successor active rows either lie on the same row or on consecutive rows. -/
theorem qstar_replacement_contacts_rows_eq_or_consecutive_leftRight
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen
      Cross.replacementLinkageConcrete (Q0.data i hi).qstar))
    {row row' : I.Row}
    (hrow :
      endpointContact Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar ⟨r.1, by omega⟩ ∈
        (Cross.successorRowPathLeftRight row).vertexSet)
    (hrow' :
      endpointContact Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar ⟨r.1 + 1, by omega⟩ ∈
        (Cross.successorRowPathLeftRight row').vertexSet) :
    row = row' ∨
      FinConsecutive (Inv.base.orderedRows.order row)
        (Inv.base.orderedRows.order row') := by
  classical
  have hidx_row :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨r.1, by omega⟩ =
        I.rowIndex row :=
    Cross.qstar_replacement_internal_index_eq_row_leftRight Inv
      ⟨r.1, by omega⟩ hrow
  have hidx_row' :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨r.1 + 1, by omega⟩ =
        I.rowIndex row' :=
    Cross.qstar_replacement_internal_index_eq_row_leftRight Inv
      ⟨r.1 + 1, by omega⟩ hrow'
  rcases Cross.qstar_replacementContactIndex_consecutive_aux_step
      Inv (i := i) (hi := hi) r with heq | hadj
  · left
    apply Inv.base.rowIndexInjective
    simpa [hidx_row, hidx_row'] using heq
  · right
    exact Inv.extended.full.active_aux.no_chord
      ((hadj_iff (I.rowIndex row) (I.rowIndex row')).1
        (by simpa [hidx_row, hidx_row'] using hadj))

/-- If the first contact after the upper boundary lies on a left-to-right
successor row, then that row is the last active row. -/
theorem qstar_replacementContact_one_row_eq_last_leftRight
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    {row : I.Row}
    (hrow :
      endpointContact Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          ⟨1, by
            have hlen :
                0 < endpointContactTraceLen
                    Cross.replacementLinkageConcrete
                    (Q0.data i hi).qstar := by
              simp [endpointContactTraceLen]
            omega⟩ ∈
        (Cross.successorRowPathLeftRight row).vertexSet) :
    Inv.base.orderedRows.order row =
      (⟨z h - 1, by dsimp [z]; omega⟩ : Fin (z h)) := by
  classical
  let r0 : Fin (endpointContactTraceLen
      Cross.replacementLinkageConcrete (Q0.data i hi).qstar) :=
    ⟨0, by simp [endpointContactTraceLen]⟩
  have hlen_pos :
      0 < endpointContactTraceLen
        Cross.replacementLinkageConcrete (Q0.data i hi).qstar := by
    simp [endpointContactTraceLen]
  have hidx0 :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨0, by omega⟩ =
        Inv.extended.boundary.upperBoundary :=
    endpointContactIndex_zero_eq_of_source_mem
      (L := Cross.replacementLinkageConcrete)
      (Q := (Q0.data i hi).qstar)
      (Cross.qstar_source_mem_replacement_linkage Inv)
      (Cross.qstar_target_mem_replacement_linkage Inv)
      (Cross.qstar_source_mem_replacement_upperBoundary Inv)
  have hidx1 :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨1, by omega⟩ =
        I.rowIndex row :=
    Cross.qstar_replacement_internal_index_eq_row_leftRight Inv
      ⟨1, by omega⟩ hrow
  have hidx0' :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨r0.1, by omega⟩ =
        Inv.extended.boundary.upperBoundary := by
    simpa [r0] using hidx0
  have hidx1' :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨r0.1 + 1, by omega⟩ =
        I.rowIndex row := by
    simpa [r0] using hidx1
  rcases Cross.qstar_replacementContactIndex_consecutive_aux_step
      Inv (i := i) (hi := hi) r0 with heq | hadj
  · have hrow_upper : I.rowIndex row = Inv.extended.boundary.upperBoundary := by
      simpa [hidx0', hidx1'] using heq.symm
    exact False.elim (Inv.extended.boundary.upper_ne_row row hrow_upper.symm)
  · exact Inv.extended.boundary.row_adj_upperBoundary_eq_last
      ((linkageAuxGraph I.linkage).symm
        ((hadj_iff Inv.extended.boundary.upperBoundary (I.rowIndex row)).1
          (by simpa [hidx0', hidx1'] using hadj)))

/-- If the last contact before the lower boundary lies on a left-to-right
successor row, then that row is the first active row. -/
theorem qstar_replacementContact_pred_last_row_eq_first_leftRight
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    {row : I.Row}
    (hrow :
      endpointContact Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          ⟨endpointContactTraceLen Cross.replacementLinkageConcrete
                (Q0.data i hi).qstar - 1,
            by
              have hlen :
                  0 < endpointContactTraceLen
                      Cross.replacementLinkageConcrete
                      (Q0.data i hi).qstar := by
                simp [endpointContactTraceLen]
              omega⟩ ∈
        (Cross.successorRowPathLeftRight row).vertexSet) :
    Inv.base.orderedRows.order row =
      (⟨0, by dsimp [z]; omega⟩ : Fin (z h)) := by
  classical
  let n := endpointContactTraceLen
    Cross.replacementLinkageConcrete (Q0.data i hi).qstar
  have hnpos : 0 < n := by
    simp [n, endpointContactTraceLen]
  let rlast : Fin n := ⟨n - 1, by omega⟩
  have hidx_pred :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨n - 1, by omega⟩ =
        I.rowIndex row := by
    simpa [n] using
      Cross.qstar_replacement_internal_index_eq_row_leftRight Inv
        ⟨endpointContactTraceLen Cross.replacementLinkageConcrete
              (Q0.data i hi).qstar - 1,
          by omega⟩ hrow
  have hidx_last :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨n, by omega⟩ =
        Inv.extended.boundary.lowerBoundary := by
    simpa [n] using
      endpointContactIndex_last_eq_of_target_mem
        (L := Cross.replacementLinkageConcrete)
        (Q := (Q0.data i hi).qstar)
        (Cross.qstar_source_mem_replacement_linkage Inv)
        (Cross.qstar_target_mem_replacement_linkage Inv)
        (Cross.qstar_target_mem_replacement_lowerBoundary Inv)
  have hidx_pred' :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨rlast.1, by omega⟩ =
        I.rowIndex row := by
    simpa [rlast] using hidx_pred
  have hidx_last' :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨rlast.1 + 1, by omega⟩ =
        Inv.extended.boundary.lowerBoundary := by
    simpa [rlast, n, hnpos] using hidx_last
  rcases Cross.qstar_replacementContactIndex_consecutive_aux_step
      Inv (i := i) (hi := hi) rlast with heq | hadj
  · have hrow_lower : I.rowIndex row = Inv.extended.boundary.lowerBoundary := by
      simpa [hidx_pred', hidx_last'] using heq
    exact False.elim (Inv.extended.boundary.lower_ne_row row hrow_lower.symm)
  · exact Inv.extended.boundary.row_adj_lowerBoundary_eq_first
      ((linkageAuxGraph I.linkage).symm
        ((hadj_iff (I.rowIndex row) Inv.extended.boundary.lowerBoundary).1
          (by simpa [hidx_pred', hidx_last'] using hadj)))

/-- The left-to-right cross replacement endpoint-contact list has length at
least two in the nonterminating branch. -/
theorem qstar_replacementContactTraceLen_two_le_leftRight
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    2 ≤ endpointContactTraceLen
      Cross.replacementLinkageConcrete (Q0.data i hi).qstar := by
  classical
  let n := endpointContactTraceLen
    Cross.replacementLinkageConcrete (Q0.data i hi).qstar
  have hnpos : 0 < n := by
    simp [n, endpointContactTraceLen]
  by_contra hnot
  have hn_eq_one : n = 1 := by omega
  let r0 : Fin n := ⟨0, by omega⟩
  have hidx0 :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨r0.1, by omega⟩ =
        Inv.extended.boundary.upperBoundary := by
    simpa [r0] using
      endpointContactIndex_zero_eq_of_source_mem
        (L := Cross.replacementLinkageConcrete)
        (Q := (Q0.data i hi).qstar)
        (Cross.qstar_source_mem_replacement_linkage Inv)
        (Cross.qstar_target_mem_replacement_linkage Inv)
        (Cross.qstar_source_mem_replacement_upperBoundary Inv)
  have hidx1 :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨r0.1 + 1, by omega⟩ =
        Inv.extended.boundary.lowerBoundary := by
    have hone :
        (⟨r0.1 + 1, by omega⟩ :
          Fin (endpointContactTraceLen
            Cross.replacementLinkageConcrete (Q0.data i hi).qstar + 1)) =
          ⟨endpointContactTraceLen Cross.replacementLinkageConcrete
            (Q0.data i hi).qstar, by omega⟩ := by
      apply Fin.ext
      simp [r0, n, hn_eq_one]
    simpa [hone] using
      endpointContactIndex_last_eq_of_target_mem
        (L := Cross.replacementLinkageConcrete)
        (Q := (Q0.data i hi).qstar)
        (Cross.qstar_source_mem_replacement_linkage Inv)
        (Cross.qstar_target_mem_replacement_linkage Inv)
        (Cross.qstar_target_mem_replacement_lowerBoundary Inv)
  rcases Cross.qstar_replacementContactIndex_consecutive_aux_step
      Inv (i := i) (hi := hi) r0 with heq | hadj
  · have hbad :
        Inv.extended.boundary.upperBoundary =
          Inv.extended.boundary.lowerBoundary := by
      simpa [hidx0, hidx1] using heq
    exact Inv.extended.boundary.lower_ne_upper hbad.symm
  · have hold :
        (linkageAuxGraph I.linkage).Adj
          Inv.extended.boundary.lowerBoundary
          Inv.extended.boundary.upperBoundary := by
      exact (linkageAuxGraph I.linkage).symm
        ((hadj_iff Inv.extended.boundary.upperBoundary
          Inv.extended.boundary.lowerBoundary).1
          (by simpa [hidx0, hidx1] using hadj))
    exact no_old_aux_adj_lower_upper Inv hold

noncomputable def qstar_replacementContactInternalRow_leftRight
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen
      Cross.replacementLinkageConcrete (Q0.data i hi).qstar + 1))
    (hr0 : r.1 ≠ 0)
    (hrlast :
      r.1 ≠ endpointContactTraceLen
        Cross.replacementLinkageConcrete (Q0.data i hi).qstar) :
    I.Row :=
  Classical.choose
    (Cross.qstar_replacement_internal_contact_exists_successor_row_leftRight
      Inv r hr0 hrlast)

theorem qstar_replacementContactInternalRow_mem_leftRight
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen
      Cross.replacementLinkageConcrete (Q0.data i hi).qstar + 1))
    (hr0 : r.1 ≠ 0)
    (hrlast :
      r.1 ≠ endpointContactTraceLen
        Cross.replacementLinkageConcrete (Q0.data i hi).qstar) :
    endpointContact Cross.replacementLinkageConcrete
        (Q0.data i hi).qstar r ∈
      (Cross.successorRowPathLeftRight
        (Cross.qstar_replacementContactInternalRow_leftRight
          Inv r hr0 hrlast)).vertexSet :=
  Classical.choose_spec
    (Cross.qstar_replacement_internal_contact_exists_successor_row_leftRight
      Inv r hr0 hrlast)

noncomputable def qstar_replacementContactExtendedPos_leftRight
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} (hi : i ∈ Q0.indices)
    (r : Fin (endpointContactTraceLen
      Cross.replacementLinkageConcrete (Q0.data i hi).qstar + 1)) :
    ℕ :=
  if hr0 : r.1 = 0 then
    z h + 1
  else if hrlast :
      r.1 = endpointContactTraceLen
        Cross.replacementLinkageConcrete (Q0.data i hi).qstar then
    0
  else
    (Inv.base.orderedRows.order
      (Cross.qstar_replacementContactInternalRow_leftRight
        Inv r hr0 hrlast)).1 + 1

@[simp] theorem qstar_replacementContactExtendedPos_zero_leftRight
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    Cross.qstar_replacementContactExtendedPos_leftRight Inv hi
        ⟨0, by simp [endpointContactTraceLen]⟩ =
      z h + 1 := by
  simp [qstar_replacementContactExtendedPos_leftRight]

@[simp] theorem qstar_replacementContactExtendedPos_last_leftRight
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    Cross.qstar_replacementContactExtendedPos_leftRight Inv hi
        ⟨endpointContactTraceLen Cross.replacementLinkageConcrete
            (Q0.data i hi).qstar, by omega⟩ =
      0 := by
  have hpos :
      0 < endpointContactTraceLen
        Cross.replacementLinkageConcrete (Q0.data i hi).qstar := by
    simp [endpointContactTraceLen]
  simp [qstar_replacementContactExtendedPos_leftRight, hpos.ne']

theorem qstar_replacementContactExtendedPos_internal_leftRight
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen
      Cross.replacementLinkageConcrete (Q0.data i hi).qstar + 1))
    (hr0 : r.1 ≠ 0)
    (hrlast :
      r.1 ≠ endpointContactTraceLen
        Cross.replacementLinkageConcrete (Q0.data i hi).qstar) :
    Cross.qstar_replacementContactExtendedPos_leftRight Inv hi r =
      (Inv.base.orderedRows.order
        (Cross.qstar_replacementContactInternalRow_leftRight
          Inv r hr0 hrlast)).1 + 1 := by
  simp [qstar_replacementContactExtendedPos_leftRight, hr0, hrlast]

/-- The left-to-right cross replacement contact positions form a unit-step trace
from the upper boundary to the lower boundary. -/
theorem qstar_replacementContactExtendedPos_unit_step_leftRight
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    UnitStepNatTrace
      (endpointContactTraceLen
        Cross.replacementLinkageConcrete (Q0.data i hi).qstar)
      (fun r =>
        Cross.qstar_replacementContactExtendedPos_leftRight Inv hi r) := by
  classical
  let n := endpointContactTraceLen
    Cross.replacementLinkageConcrete (Q0.data i hi).qstar
  have hn_two : 2 ≤ n := by
    simpa [n] using
      Cross.qstar_replacementContactTraceLen_two_le_leftRight
        Inv hadj_iff (i := i) (hi := hi)
  intro r
  let cur : Fin (endpointContactTraceLen
      Cross.replacementLinkageConcrete (Q0.data i hi).qstar + 1) :=
    ⟨r.1, by omega⟩
  let nxt : Fin (endpointContactTraceLen
      Cross.replacementLinkageConcrete (Q0.data i hi).qstar + 1) :=
    ⟨r.1 + 1, by omega⟩
  change
    Cross.qstar_replacementContactExtendedPos_leftRight Inv hi nxt ≤
        Cross.qstar_replacementContactExtendedPos_leftRight Inv hi cur + 1 ∧
      Cross.qstar_replacementContactExtendedPos_leftRight Inv hi cur ≤
        Cross.qstar_replacementContactExtendedPos_leftRight Inv hi nxt + 1
  by_cases hcur0 : r.1 = 0
  · have hnxt_not_last : nxt.1 ≠ n := by
      simp [nxt, n]
      omega
    have hnxt_not_zero : nxt.1 ≠ 0 := by
      simp [nxt]
    let row :=
      Cross.qstar_replacementContactInternalRow_leftRight
        Inv (i := i) (hi := hi) nxt hnxt_not_zero hnxt_not_last
    have hrowmem :
        endpointContact Cross.replacementLinkageConcrete
            (Q0.data i hi).qstar
            ⟨1, by simp [endpointContactTraceLen]⟩ ∈
          (Cross.successorRowPathLeftRight row).vertexSet := by
      simpa [row, nxt, hcur0] using
        Cross.qstar_replacementContactInternalRow_mem_leftRight
          Inv (i := i) (hi := hi) nxt hnxt_not_zero hnxt_not_last
    have hrow_last :
        Inv.base.orderedRows.order row =
          (⟨z h - 1, by dsimp [z]; omega⟩ : Fin (z h)) :=
      Cross.qstar_replacementContact_one_row_eq_last_leftRight
        (hpos := hpos) Inv hadj_iff (i := i) (hi := hi) hrowmem
    have hrow_val :
        (Inv.base.orderedRows.order row).1 = z h - 1 :=
      congrArg Fin.val hrow_last
    have hpos_cur :
        Cross.qstar_replacementContactExtendedPos_leftRight Inv hi cur =
          z h + 1 := by
      have hcur_eq :
          cur =
            (⟨0, by simp [endpointContactTraceLen]⟩ :
              Fin (endpointContactTraceLen
                Cross.replacementLinkageConcrete
                (Q0.data i hi).qstar + 1)) := by
        exact Fin.ext (by simp [cur, hcur0])
      simpa [hcur_eq] using
        Cross.qstar_replacementContactExtendedPos_zero_leftRight
          Inv (i := i) (hi := hi)
    have hpos_nxt :
        Cross.qstar_replacementContactExtendedPos_leftRight Inv hi nxt =
          z h := by
      have hchosen_val :
          (Inv.base.orderedRows.order
            (Cross.qstar_replacementContactInternalRow_leftRight
              Inv (i := i) (hi := hi) nxt hnxt_not_zero
                hnxt_not_last)).1 =
            z h - 1 := by
        simpa [row] using hrow_val
      rw [Cross.qstar_replacementContactExtendedPos_internal_leftRight
        Inv (i := i) (hi := hi) (r := nxt) hnxt_not_zero
        hnxt_not_last]
      omega
    constructor <;> simp [hpos_cur, hpos_nxt] <;> omega
  · by_cases hnext_last : r.1 + 1 = n
    · have hcur_not_zero : cur.1 ≠ 0 := by
        simp [cur, n]
        omega
      have hcur_not_last : cur.1 ≠ n := by
        simp [cur]
        omega
      let row :=
        Cross.qstar_replacementContactInternalRow_leftRight
          Inv (i := i) (hi := hi) cur hcur_not_zero hcur_not_last
      have hcur_eq_pred :
          cur =
            (⟨endpointContactTraceLen Cross.replacementLinkageConcrete
                    (Q0.data i hi).qstar - 1,
                by simp [endpointContactTraceLen]⟩ :
              Fin (endpointContactTraceLen
                Cross.replacementLinkageConcrete
                (Q0.data i hi).qstar + 1)) := by
        apply Fin.ext
        simp [cur]
        omega
      have hrowmem :
          endpointContact Cross.replacementLinkageConcrete
              (Q0.data i hi).qstar
              ⟨endpointContactTraceLen Cross.replacementLinkageConcrete
                    (Q0.data i hi).qstar - 1,
                by simp [endpointContactTraceLen]⟩ ∈
            (Cross.successorRowPathLeftRight row).vertexSet := by
        simpa [row, hcur_eq_pred] using
          Cross.qstar_replacementContactInternalRow_mem_leftRight
            Inv (i := i) (hi := hi) cur hcur_not_zero hcur_not_last
      have hrow_first :
          Inv.base.orderedRows.order row =
            (⟨0, by dsimp [z]; omega⟩ : Fin (z h)) :=
        Cross.qstar_replacementContact_pred_last_row_eq_first_leftRight
          (hpos := hpos) Inv hadj_iff (i := i) (hi := hi) hrowmem
      have hrow_val :
          (Inv.base.orderedRows.order row).1 = 0 :=
        congrArg Fin.val hrow_first
      have hpos_cur :
          Cross.qstar_replacementContactExtendedPos_leftRight Inv hi cur = 1 := by
        rw [Cross.qstar_replacementContactExtendedPos_internal_leftRight
          Inv (i := i) (hi := hi) (r := cur) hcur_not_zero hcur_not_last]
        simpa [row, hrow_val] using hrow_val
      have hpos_nxt :
          Cross.qstar_replacementContactExtendedPos_leftRight Inv hi nxt = 0 := by
        have hnxt_eq :
            nxt =
              (⟨endpointContactTraceLen Cross.replacementLinkageConcrete
                    (Q0.data i hi).qstar, by omega⟩ :
                Fin (endpointContactTraceLen
                  Cross.replacementLinkageConcrete
                  (Q0.data i hi).qstar + 1)) := by
          apply Fin.ext
          simp [nxt, n, hnext_last]
        simpa [hnxt_eq] using
          Cross.qstar_replacementContactExtendedPos_last_leftRight
            Inv (i := i) (hi := hi)
      constructor <;> simp [hpos_cur, hpos_nxt] <;> omega
    · have hcur_not_last : cur.1 ≠ n := by
        simp [cur]
        omega
      have hnxt_not_zero : nxt.1 ≠ 0 := by
        simp [nxt]
      have hnxt_not_last : nxt.1 ≠ n := by
        simpa [nxt] using hnext_last
      let row :=
        Cross.qstar_replacementContactInternalRow_leftRight
          Inv (i := i) (hi := hi) cur hcur0 hcur_not_last
      let row' :=
        Cross.qstar_replacementContactInternalRow_leftRight
          Inv (i := i) (hi := hi) nxt hnxt_not_zero hnxt_not_last
      have hrowmem :
          endpointContact Cross.replacementLinkageConcrete
              (Q0.data i hi).qstar ⟨r.1, by omega⟩ ∈
            (Cross.successorRowPathLeftRight row).vertexSet := by
        simpa [row, cur, n] using
          Cross.qstar_replacementContactInternalRow_mem_leftRight
            Inv (i := i) (hi := hi) cur hcur0 hcur_not_last
      have hrowmem' :
          endpointContact Cross.replacementLinkageConcrete
              (Q0.data i hi).qstar ⟨r.1 + 1, by omega⟩ ∈
            (Cross.successorRowPathLeftRight row').vertexSet := by
        simpa [row', nxt, n] using
          Cross.qstar_replacementContactInternalRow_mem_leftRight
            Inv (i := i) (hi := hi) nxt hnxt_not_zero hnxt_not_last
      have hpos_cur :
          Cross.qstar_replacementContactExtendedPos_leftRight Inv hi cur =
            (Inv.base.orderedRows.order row).1 + 1 := by
        rw [Cross.qstar_replacementContactExtendedPos_internal_leftRight
          Inv (i := i) (hi := hi) (r := cur) hcur0 hcur_not_last]
      have hpos_nxt :
          Cross.qstar_replacementContactExtendedPos_leftRight Inv hi nxt =
            (Inv.base.orderedRows.order row').1 + 1 := by
        rw [Cross.qstar_replacementContactExtendedPos_internal_leftRight
          Inv (i := i) (hi := hi) (r := nxt) hnxt_not_zero hnxt_not_last]
      rcases Cross.qstar_replacement_contacts_rows_eq_or_consecutive_leftRight
          Inv hadj_iff (i := i) (hi := hi) r hrowmem hrowmem'
        with hsame | hcon
      · have hval_eq :
            (Inv.base.orderedRows.order row).1 =
              (Inv.base.orderedRows.order row').1 := by
          rw [hsame]
        constructor <;> simp [hpos_cur, hpos_nxt] <;> omega
      · rcases hcon with hsucc | hpred
        · constructor <;> simp [hpos_cur, hpos_nxt] <;> omega
        · constructor <;> simp [hpos_cur, hpos_nxt] <;> omega

noncomputable def qstar_replacementBareExtendedRowContactTrace_leftRight
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j)
    {i : Q.Index} (hi : i ∈ Q0.indices) :
    TypeOneBareExtendedRowContactTrace
      (h := h) I.Row Inv.base.orderedRows.order
      Cross.successorRowPathLeftRight (Q0.data i hi).qstar where
  len := endpointContactTraceLen
    Cross.replacementLinkageConcrete (Q0.data i hi).qstar
  contact := endpointContact Cross.replacementLinkageConcrete
    (Q0.data i hi).qstar
  pos := fun r => Cross.qstar_replacementContactExtendedPos_leftRight Inv hi r
  contact_mem_path :=
    endpointContact_mem_path Cross.replacementLinkageConcrete
      (Q0.data i hi).qstar
  first_pos := by
    simpa using
      Cross.qstar_replacementContactExtendedPos_zero_leftRight
        Inv (i := i) (hi := hi)
  last_pos := by
    simpa using
      Cross.qstar_replacementContactExtendedPos_last_leftRight
        Inv (i := i) (hi := hi)
  unit_step :=
    Cross.qstar_replacementContactExtendedPos_unit_step_leftRight
      Inv hadj_iff (i := i) (hi := hi)
  contact_mem_row_of_pos := by
    classical
    intro row r hpos_eq
    by_cases hr0 : r.1 = 0
    · have hrowlt : (Inv.base.orderedRows.order row).1 < z h :=
        (Inv.base.orderedRows.order row).2
      have hpos0 :
          Cross.qstar_replacementContactExtendedPos_leftRight Inv hi r =
            z h + 1 := by
        have hr_eq :
            r =
              (⟨0, by simp [endpointContactTraceLen]⟩ :
                Fin (endpointContactTraceLen
                  Cross.replacementLinkageConcrete
                  (Q0.data i hi).qstar + 1)) := by
          exact Fin.ext hr0
        simpa [hr_eq] using
          Cross.qstar_replacementContactExtendedPos_zero_leftRight
            Inv (i := i) (hi := hi)
      omega
    · by_cases hrlast :
        r.1 = endpointContactTraceLen
          Cross.replacementLinkageConcrete (Q0.data i hi).qstar
      · have hposlast :
            Cross.qstar_replacementContactExtendedPos_leftRight Inv hi r = 0 := by
          have hr_eq :
              r =
                (⟨endpointContactTraceLen
                    Cross.replacementLinkageConcrete
                    (Q0.data i hi).qstar, by omega⟩ :
                  Fin (endpointContactTraceLen
                    Cross.replacementLinkageConcrete
                    (Q0.data i hi).qstar + 1)) := by
            exact Fin.ext hrlast
          simpa [hr_eq] using
            Cross.qstar_replacementContactExtendedPos_last_leftRight
              Inv (i := i) (hi := hi)
        omega
      · let row0 :=
          Cross.qstar_replacementContactInternalRow_leftRight
            Inv (i := i) (hi := hi) r hr0 hrlast
        have hmem :
            endpointContact Cross.replacementLinkageConcrete
                (Q0.data i hi).qstar r ∈
              (Cross.successorRowPathLeftRight row0).vertexSet := by
          simpa [row0] using
            Cross.qstar_replacementContactInternalRow_mem_leftRight
              Inv (i := i) (hi := hi) r hr0 hrlast
        have hpos_internal :
            Cross.qstar_replacementContactExtendedPos_leftRight Inv hi r =
              (Inv.base.orderedRows.order row0).1 + 1 := by
          simpa [row0] using
            Cross.qstar_replacementContactExtendedPos_internal_leftRight
              Inv (i := i) (hi := hi) r hr0 hrlast
        have hval :
            (Inv.base.orderedRows.order row0).1 =
              (Inv.base.orderedRows.order row).1 := by
          omega
        have hfin :
            Inv.base.orderedRows.order row0 =
              Inv.base.orderedRows.order row := Fin.ext hval
        have hrow_eq : row0 = row :=
          Inv.base.orderedRows.order.injective hfin
        simpa [hrow_eq] using hmem

/-- The left-to-right no-skip successor-row contact survival for a cross. -/
theorem successorCurrentRowsInvariantLeftRight_of_aux_adjacency_preserved
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j) :
    TypeOneCurrentRowsInvariant R hpos Q0 I.Row
      Cross.successorRowPathLeftRight :=
  TypeOneCurrentRowsInvariant_of_bareExtendedRowContactTraces
    (fun i hi =>
      ⟨Cross.qstar_replacementBareExtendedRowContactTrace_leftRight
        Inv hadj_iff (i := i) hi⟩)

/-- The switched cross successor has the same displayed replacement paths as
the left-to-right successor, with the two crossed row labels exchanged.  Hence
the no-skip trace proof for the left-to-right successor also gives the
right-to-left successor-row contact invariant. -/
theorem successorCurrentRowsInvariantRightLeft_of_aux_adjacency_preserved
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j) :
    TypeOneCurrentRowsInvariant R hpos Q0 I.Row
      Cross.successorRowPathRightLeft := by
  classical
  have hleftRight :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathLeftRight :=
    Cross.successorCurrentRowsInvariantLeftRight_of_aux_adjacency_preserved
      Inv hadj_iff
  intro i hi
  rcases hleftRight i hi with ⟨hrows, hp0, hpz, havoid⟩
  refine ⟨?_, hp0, hpz, havoid⟩
  intro r
  by_cases hleft : r = Cross.rowLeft
  · subst r
    simpa [Cross.successorRowPathRightLeft_left] using
      hrows Cross.rowRight
  · by_cases hright : r = Cross.rowRight
    · subst r
      simpa [Cross.successorRowPathRightLeft_right] using
        hrows Cross.rowLeft
    · simpa [Cross.successorRowPathRightLeft_of_ne hleft hright,
        Cross.successorRowPathLeftRight_of_ne hleft hright] using hrows r

@[simp] theorem successorRowPathRightLeft_swap
    (row : I.Row) :
    Cross.successorRowPathRightLeft
        ((Equiv.swap Cross.rowLeft Cross.rowRight) row) =
      Cross.successorRowPathLeftRight row := by
  classical
  by_cases hleft : row = Cross.rowLeft
  · subst row
    simp [Cross.rowLeft_ne_rowRight.symm]
  · by_cases hright : row = Cross.rowRight
    · subst row
      simp [Cross.rowLeft_ne_rowRight]
    · rw [Equiv.swap_apply_of_ne_of_ne hleft hright]
      rw [Cross.successorRowPathRightLeft_of_ne hleft hright]
      rw [Cross.successorRowPathLeftRight_of_ne hleft hright]

/-- Applying the switched-branch index transposition to a successor row index
recovers the old index of that row. -/
theorem successorIndexSwap_apply_successorRowIndexRightLeft
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (row : I.Row) :
    (Equiv.swap (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight))
        (Cross.successorRowIndexRightLeft row) =
      I.rowIndex row := by
  classical
  let erow : I.Row ≃ I.Row := Equiv.swap Cross.rowLeft Cross.rowRight
  let eidx : I.linkage.Index ≃ I.linkage.Index :=
    Equiv.swap (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
  have hsucc :
      Cross.successorRowIndexRightLeft row = I.rowIndex (erow row) := by
    simpa [erow] using Cross.successorRowIndexRightLeft_eq_swap row
  have hidx :
      eidx (I.rowIndex (erow row)) =
        I.rowIndex (erow (erow row)) := by
    simpa [eidx, erow] using
      Cross.successorIndexSwap_apply_rowIndex
        Inv.base.rowIndexInjective (erow row)
  calc
    eidx (Cross.successorRowIndexRightLeft row)
        = eidx (I.rowIndex (erow row)) := by rw [hsucc]
    _ = I.rowIndex (erow (erow row)) := hidx
    _ = I.rowIndex row := by simp [erow]

/-- Re-use the left-to-right internal-row extraction for the switched branch by
swapping the two crossed row labels. -/
noncomputable def qstar_replacementContactInternalRow_rightLeft
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen
      Cross.replacementLinkageConcrete (Q0.data i hi).qstar + 1))
    (hr0 : r.1 ≠ 0)
    (hrlast :
      r.1 ≠ endpointContactTraceLen
        Cross.replacementLinkageConcrete (Q0.data i hi).qstar) :
    I.Row :=
  (Equiv.swap Cross.rowLeft Cross.rowRight)
    (Cross.qstar_replacementContactInternalRow_leftRight Inv r hr0 hrlast)

theorem qstar_replacementContactInternalRow_mem_rightLeft
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen
      Cross.replacementLinkageConcrete (Q0.data i hi).qstar + 1))
    (hr0 : r.1 ≠ 0)
    (hrlast :
      r.1 ≠ endpointContactTraceLen
        Cross.replacementLinkageConcrete (Q0.data i hi).qstar) :
    endpointContact Cross.replacementLinkageConcrete
        (Q0.data i hi).qstar r ∈
      (Cross.successorRowPathRightLeft
        (Cross.qstar_replacementContactInternalRow_rightLeft
          Inv r hr0 hrlast)).vertexSet := by
  classical
  simpa [qstar_replacementContactInternalRow_rightLeft] using
    Cross.qstar_replacementContactInternalRow_mem_leftRight
      Inv (i := i) (hi := hi) r hr0 hrlast

/-- If an internal contact lies on a switched-order successor row, its contact
index is exactly the corresponding switched successor linkage index. -/
theorem qstar_replacement_internal_index_eq_row_rightLeft
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen
      Cross.replacementLinkageConcrete (Q0.data i hi).qstar + 1))
    {row : I.Row}
    (hrow :
      endpointContact Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar r ∈
        (Cross.successorRowPathRightLeft row).vertexSet) :
    endpointContactIndex Cross.replacementLinkageConcrete
        (Q0.data i hi).qstar
        (Cross.qstar_source_mem_replacement_linkage Inv)
        (Cross.qstar_target_mem_replacement_linkage Inv) r =
      Cross.successorRowIndexRightLeft row := by
  unfold endpointContactIndex
  apply linkageIndexOfVertex_eq_of_mem (L := Cross.replacementLinkageConcrete)
  simpa [Cross.successorRowPathRightLeft_eq_linkage_path row] using hrow

/-- Consecutive switched-order replacement contacts on active rows either stay
on one row or move to a consecutive row. -/
theorem qstar_replacement_contacts_rows_eq_or_consecutive_rightLeft
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hadj_swap :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) i)
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) j))
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen
      Cross.replacementLinkageConcrete (Q0.data i hi).qstar))
    {row row' : I.Row}
    (hrow :
      endpointContact Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar ⟨r.1, by omega⟩ ∈
        (Cross.successorRowPathRightLeft row).vertexSet)
    (hrow' :
      endpointContact Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar ⟨r.1 + 1, by omega⟩ ∈
        (Cross.successorRowPathRightLeft row').vertexSet) :
    row = row' ∨
      FinConsecutive (Inv.base.orderedRows.order row)
        (Inv.base.orderedRows.order row') := by
  classical
  let eidx : I.linkage.Index ≃ I.linkage.Index :=
    Equiv.swap (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
  have hidx_row :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨r.1, by omega⟩ =
        Cross.successorRowIndexRightLeft row :=
    Cross.qstar_replacement_internal_index_eq_row_rightLeft Inv
      ⟨r.1, by omega⟩ hrow
  have hidx_row' :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨r.1 + 1, by omega⟩ =
        Cross.successorRowIndexRightLeft row' :=
    Cross.qstar_replacement_internal_index_eq_row_rightLeft Inv
      ⟨r.1 + 1, by omega⟩ hrow'
  rcases Cross.qstar_replacementContactIndex_consecutive_aux_step
      Inv (i := i) (hi := hi) r with heq | hadj
  · left
    have hsucc :
        Cross.successorRowIndexRightLeft row =
          Cross.successorRowIndexRightLeft row' := by
      simpa [hidx_row, hidx_row'] using heq
    have hswap_rows :
        (Equiv.swap Cross.rowLeft Cross.rowRight) row =
          (Equiv.swap Cross.rowLeft Cross.rowRight) row' := by
      apply Inv.base.rowIndexInjective
      simpa [Cross.successorRowIndexRightLeft_eq_swap row,
        Cross.successorRowIndexRightLeft_eq_swap row'] using hsucc
    exact (Equiv.swap Cross.rowLeft Cross.rowRight).injective hswap_rows
  · right
    have hnew :
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
          (Cross.successorRowIndexRightLeft row)
          (Cross.successorRowIndexRightLeft row') := by
      simpa [hidx_row, hidx_row'] using hadj
    have hold_swapped :
        (linkageAuxGraph I.linkage).Adj
          (eidx (Cross.successorRowIndexRightLeft row))
          (eidx (Cross.successorRowIndexRightLeft row')) :=
      (hadj_swap
        (Cross.successorRowIndexRightLeft row)
        (Cross.successorRowIndexRightLeft row')).1 hnew
    have hold :
        (linkageAuxGraph I.linkage).Adj
          (I.rowIndex row) (I.rowIndex row') := by
      simpa [eidx,
        Cross.successorIndexSwap_apply_successorRowIndexRightLeft Inv row,
        Cross.successorIndexSwap_apply_successorRowIndexRightLeft Inv row']
        using hold_swapped
    exact Inv.extended.full.active_aux.no_chord hold

/-- If the first contact after the upper boundary lies on a switched-order
successor row, then that row is the last active row. -/
theorem qstar_replacementContact_one_row_eq_last_rightLeft
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hadj_swap :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) i)
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) j))
    {i : Q.Index} {hi : i ∈ Q0.indices}
    {row : I.Row}
    (hrow :
      endpointContact Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          ⟨1, by
            have hlen :
                0 < endpointContactTraceLen
                    Cross.replacementLinkageConcrete
                    (Q0.data i hi).qstar := by
              simp [endpointContactTraceLen]
            omega⟩ ∈
        (Cross.successorRowPathRightLeft row).vertexSet) :
    Inv.base.orderedRows.order row =
      (⟨z h - 1, by dsimp [z]; omega⟩ : Fin (z h)) := by
  classical
  let eidx : I.linkage.Index ≃ I.linkage.Index :=
    Equiv.swap (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
  let r0 : Fin (endpointContactTraceLen
      Cross.replacementLinkageConcrete (Q0.data i hi).qstar) :=
    ⟨0, by simp [endpointContactTraceLen]⟩
  have hlen_pos :
      0 < endpointContactTraceLen
        Cross.replacementLinkageConcrete (Q0.data i hi).qstar := by
    simp [endpointContactTraceLen]
  have hidx0 :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨0, by omega⟩ =
        Inv.extended.boundary.upperBoundary :=
    endpointContactIndex_zero_eq_of_source_mem
      (L := Cross.replacementLinkageConcrete)
      (Q := (Q0.data i hi).qstar)
      (Cross.qstar_source_mem_replacement_linkage Inv)
      (Cross.qstar_target_mem_replacement_linkage Inv)
      (Cross.qstar_source_mem_replacement_upperBoundary Inv)
  have hidx1 :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨1, by omega⟩ =
        Cross.successorRowIndexRightLeft row :=
    Cross.qstar_replacement_internal_index_eq_row_rightLeft Inv
      ⟨1, by omega⟩ hrow
  have hidx0' :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨r0.1, by omega⟩ =
        Inv.extended.boundary.upperBoundary := by
    simpa [r0] using hidx0
  have hidx1' :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨r0.1 + 1, by omega⟩ =
        Cross.successorRowIndexRightLeft row := by
    simpa [r0] using hidx1
  rcases Cross.qstar_replacementContactIndex_consecutive_aux_step
      Inv (i := i) (hi := hi) r0 with heq | hadj
  · have hsucc_upper :
        Cross.successorRowIndexRightLeft row =
          Inv.extended.boundary.upperBoundary := by
      simpa [hidx0', hidx1'] using heq.symm
    have hrow_upper : I.rowIndex row = Inv.extended.boundary.upperBoundary := by
      have hcong := congrArg eidx hsucc_upper
      have hfix :
          eidx Inv.extended.boundary.upperBoundary =
            Inv.extended.boundary.upperBoundary := by
        simpa [eidx] using
          Cross.successorIndexSwap_apply_upperBoundary Inv.extended
      simpa [eidx, hfix,
        Cross.successorIndexSwap_apply_successorRowIndexRightLeft Inv row]
        using hcong
    exact False.elim (Inv.extended.boundary.upper_ne_row row hrow_upper.symm)
  · have hnew :
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
          Inv.extended.boundary.upperBoundary
          (Cross.successorRowIndexRightLeft row) := by
      simpa [hidx0', hidx1'] using hadj
    have hold_swapped :
        (linkageAuxGraph I.linkage).Adj
          (eidx Inv.extended.boundary.upperBoundary)
          (eidx (Cross.successorRowIndexRightLeft row)) :=
      (hadj_swap Inv.extended.boundary.upperBoundary
        (Cross.successorRowIndexRightLeft row)).1 hnew
    have hold :
        (linkageAuxGraph I.linkage).Adj
          Inv.extended.boundary.upperBoundary (I.rowIndex row) := by
      have hfix :
          eidx Inv.extended.boundary.upperBoundary =
            Inv.extended.boundary.upperBoundary := by
        simpa [eidx] using
          Cross.successorIndexSwap_apply_upperBoundary Inv.extended
      simpa [eidx, hfix,
        Cross.successorIndexSwap_apply_successorRowIndexRightLeft Inv row]
        using hold_swapped
    exact Inv.extended.boundary.row_adj_upperBoundary_eq_last
      ((linkageAuxGraph I.linkage).symm hold)

/-- If the last contact before the lower boundary lies on a switched-order
successor row, then that row is the first active row. -/
theorem qstar_replacementContact_pred_last_row_eq_first_rightLeft
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hadj_swap :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) i)
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) j))
    {i : Q.Index} {hi : i ∈ Q0.indices}
    {row : I.Row}
    (hrow :
      endpointContact Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          ⟨endpointContactTraceLen Cross.replacementLinkageConcrete
                (Q0.data i hi).qstar - 1,
            by
              have hlen :
                  0 < endpointContactTraceLen
                      Cross.replacementLinkageConcrete
                      (Q0.data i hi).qstar := by
                simp [endpointContactTraceLen]
              omega⟩ ∈
        (Cross.successorRowPathRightLeft row).vertexSet) :
    Inv.base.orderedRows.order row =
      (⟨0, by dsimp [z]; omega⟩ : Fin (z h)) := by
  classical
  let eidx : I.linkage.Index ≃ I.linkage.Index :=
    Equiv.swap (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
  let n := endpointContactTraceLen
    Cross.replacementLinkageConcrete (Q0.data i hi).qstar
  have hnpos : 0 < n := by
    simp [n, endpointContactTraceLen]
  let rlast : Fin n := ⟨n - 1, by omega⟩
  have hidx_pred :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨n - 1, by omega⟩ =
        Cross.successorRowIndexRightLeft row := by
    simpa [n] using
      Cross.qstar_replacement_internal_index_eq_row_rightLeft Inv
        ⟨endpointContactTraceLen Cross.replacementLinkageConcrete
              (Q0.data i hi).qstar - 1,
          by omega⟩ hrow
  have hidx_last :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨n, by omega⟩ =
        Inv.extended.boundary.lowerBoundary := by
    simpa [n] using
      endpointContactIndex_last_eq_of_target_mem
        (L := Cross.replacementLinkageConcrete)
        (Q := (Q0.data i hi).qstar)
        (Cross.qstar_source_mem_replacement_linkage Inv)
        (Cross.qstar_target_mem_replacement_linkage Inv)
        (Cross.qstar_target_mem_replacement_lowerBoundary Inv)
  have hidx_pred' :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨rlast.1, by omega⟩ =
        Cross.successorRowIndexRightLeft row := by
    simpa [rlast] using hidx_pred
  have hidx_last' :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨rlast.1 + 1, by omega⟩ =
        Inv.extended.boundary.lowerBoundary := by
    simpa [rlast, n, hnpos] using hidx_last
  rcases Cross.qstar_replacementContactIndex_consecutive_aux_step
      Inv (i := i) (hi := hi) rlast with heq | hadj
  · have hsucc_lower :
        Cross.successorRowIndexRightLeft row =
          Inv.extended.boundary.lowerBoundary := by
      simpa [hidx_pred', hidx_last'] using heq
    have hrow_lower : I.rowIndex row = Inv.extended.boundary.lowerBoundary := by
      have hcong := congrArg eidx hsucc_lower
      have hfix :
          eidx Inv.extended.boundary.lowerBoundary =
            Inv.extended.boundary.lowerBoundary := by
        simpa [eidx] using
          Cross.successorIndexSwap_apply_lowerBoundary Inv.extended
      simpa [eidx, hfix,
        Cross.successorIndexSwap_apply_successorRowIndexRightLeft Inv row]
        using hcong
    exact False.elim (Inv.extended.boundary.lower_ne_row row hrow_lower.symm)
  · have hnew :
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
          (Cross.successorRowIndexRightLeft row)
          Inv.extended.boundary.lowerBoundary := by
      simpa [hidx_pred', hidx_last'] using hadj
    have hold_swapped :
        (linkageAuxGraph I.linkage).Adj
          (eidx (Cross.successorRowIndexRightLeft row))
          (eidx Inv.extended.boundary.lowerBoundary) :=
      (hadj_swap (Cross.successorRowIndexRightLeft row)
        Inv.extended.boundary.lowerBoundary).1 hnew
    have hold :
        (linkageAuxGraph I.linkage).Adj
          (I.rowIndex row) Inv.extended.boundary.lowerBoundary := by
      have hfix :
          eidx Inv.extended.boundary.lowerBoundary =
            Inv.extended.boundary.lowerBoundary := by
        simpa [eidx] using
          Cross.successorIndexSwap_apply_lowerBoundary Inv.extended
      simpa [eidx, hfix,
        Cross.successorIndexSwap_apply_successorRowIndexRightLeft Inv row]
        using hold_swapped
    exact Inv.extended.boundary.row_adj_lowerBoundary_eq_first
      ((linkageAuxGraph I.linkage).symm hold)

/-- The switched-order cross replacement endpoint-contact list has length at
least two in the nonterminating branch. -/
theorem qstar_replacementContactTraceLen_two_le_rightLeft
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hadj_swap :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) i)
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) j))
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    2 ≤ endpointContactTraceLen
      Cross.replacementLinkageConcrete (Q0.data i hi).qstar := by
  classical
  let eidx : I.linkage.Index ≃ I.linkage.Index :=
    Equiv.swap (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
  let n := endpointContactTraceLen
    Cross.replacementLinkageConcrete (Q0.data i hi).qstar
  have hnpos : 0 < n := by
    simp [n, endpointContactTraceLen]
  by_contra hnot
  have hn_eq_one : n = 1 := by omega
  let r0 : Fin n := ⟨0, by omega⟩
  have hidx0 :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨r0.1, by omega⟩ =
        Inv.extended.boundary.upperBoundary := by
    simpa [r0] using
      endpointContactIndex_zero_eq_of_source_mem
        (L := Cross.replacementLinkageConcrete)
        (Q := (Q0.data i hi).qstar)
        (Cross.qstar_source_mem_replacement_linkage Inv)
        (Cross.qstar_target_mem_replacement_linkage Inv)
        (Cross.qstar_source_mem_replacement_upperBoundary Inv)
  have hidx1 :
      endpointContactIndex Cross.replacementLinkageConcrete
          (Q0.data i hi).qstar
          (Cross.qstar_source_mem_replacement_linkage Inv)
          (Cross.qstar_target_mem_replacement_linkage Inv)
          ⟨r0.1 + 1, by omega⟩ =
        Inv.extended.boundary.lowerBoundary := by
    have hone :
        (⟨r0.1 + 1, by omega⟩ :
          Fin (endpointContactTraceLen
            Cross.replacementLinkageConcrete (Q0.data i hi).qstar + 1)) =
          ⟨endpointContactTraceLen Cross.replacementLinkageConcrete
            (Q0.data i hi).qstar, by omega⟩ := by
      apply Fin.ext
      simp [r0, n, hn_eq_one]
    simpa [hone] using
      endpointContactIndex_last_eq_of_target_mem
        (L := Cross.replacementLinkageConcrete)
        (Q := (Q0.data i hi).qstar)
        (Cross.qstar_source_mem_replacement_linkage Inv)
        (Cross.qstar_target_mem_replacement_linkage Inv)
        (Cross.qstar_target_mem_replacement_lowerBoundary Inv)
  rcases Cross.qstar_replacementContactIndex_consecutive_aux_step
      Inv (i := i) (hi := hi) r0 with heq | hadj
  · have hbad :
        Inv.extended.boundary.upperBoundary =
          Inv.extended.boundary.lowerBoundary := by
      simpa [hidx0, hidx1] using heq
    exact Inv.extended.boundary.lower_ne_upper hbad.symm
  · have hnew :
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
          Inv.extended.boundary.upperBoundary
          Inv.extended.boundary.lowerBoundary := by
      simpa [hidx0, hidx1] using hadj
    have hold_swapped :
        (linkageAuxGraph I.linkage).Adj
          (eidx Inv.extended.boundary.upperBoundary)
          (eidx Inv.extended.boundary.lowerBoundary) :=
      (hadj_swap Inv.extended.boundary.upperBoundary
        Inv.extended.boundary.lowerBoundary).1 hnew
    have hold :
        (linkageAuxGraph I.linkage).Adj
          Inv.extended.boundary.lowerBoundary
          Inv.extended.boundary.upperBoundary := by
      have hfixUpper :
          eidx Inv.extended.boundary.upperBoundary =
            Inv.extended.boundary.upperBoundary := by
        simpa [eidx] using
          Cross.successorIndexSwap_apply_upperBoundary Inv.extended
      have hfixLower :
          eidx Inv.extended.boundary.lowerBoundary =
            Inv.extended.boundary.lowerBoundary := by
        simpa [eidx] using
          Cross.successorIndexSwap_apply_lowerBoundary Inv.extended
      exact (linkageAuxGraph I.linkage).symm
        (by simpa [eidx, hfixUpper, hfixLower] using hold_swapped)
    exact no_old_aux_adj_lower_upper Inv hold

noncomputable def qstar_replacementContactExtendedPos_rightLeft
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} (hi : i ∈ Q0.indices)
    (r : Fin (endpointContactTraceLen
      Cross.replacementLinkageConcrete (Q0.data i hi).qstar + 1)) :
    ℕ :=
  if hr0 : r.1 = 0 then
    z h + 1
  else if hrlast :
      r.1 = endpointContactTraceLen
        Cross.replacementLinkageConcrete (Q0.data i hi).qstar then
    0
  else
    (Inv.base.orderedRows.order
      (Cross.qstar_replacementContactInternalRow_rightLeft
        Inv r hr0 hrlast)).1 + 1

@[simp] theorem qstar_replacementContactExtendedPos_zero_rightLeft
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    Cross.qstar_replacementContactExtendedPos_rightLeft Inv hi
        ⟨0, by simp [endpointContactTraceLen]⟩ =
      z h + 1 := by
  simp [qstar_replacementContactExtendedPos_rightLeft]

@[simp] theorem qstar_replacementContactExtendedPos_last_rightLeft
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    Cross.qstar_replacementContactExtendedPos_rightLeft Inv hi
        ⟨endpointContactTraceLen Cross.replacementLinkageConcrete
            (Q0.data i hi).qstar, by omega⟩ =
      0 := by
  have hpos :
      0 < endpointContactTraceLen
        Cross.replacementLinkageConcrete (Q0.data i hi).qstar := by
    simp [endpointContactTraceLen]
  simp [qstar_replacementContactExtendedPos_rightLeft, hpos.ne']

theorem qstar_replacementContactExtendedPos_internal_rightLeft
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    {i : Q.Index} {hi : i ∈ Q0.indices}
    (r : Fin (endpointContactTraceLen
      Cross.replacementLinkageConcrete (Q0.data i hi).qstar + 1))
    (hr0 : r.1 ≠ 0)
    (hrlast :
      r.1 ≠ endpointContactTraceLen
        Cross.replacementLinkageConcrete (Q0.data i hi).qstar) :
    Cross.qstar_replacementContactExtendedPos_rightLeft Inv hi r =
      (Inv.base.orderedRows.order
        (Cross.qstar_replacementContactInternalRow_rightLeft
          Inv r hr0 hrlast)).1 + 1 := by
  simp [qstar_replacementContactExtendedPos_rightLeft, hr0, hrlast]

/-- The switched-order replacement contact positions form a unit-step trace from
the upper boundary to the lower boundary. -/
theorem qstar_replacementContactExtendedPos_unit_step_rightLeft
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hadj_swap :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) i)
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) j))
    {i : Q.Index} {hi : i ∈ Q0.indices} :
    UnitStepNatTrace
      (endpointContactTraceLen
        Cross.replacementLinkageConcrete (Q0.data i hi).qstar)
      (fun r =>
        Cross.qstar_replacementContactExtendedPos_rightLeft Inv hi r) := by
  classical
  let n := endpointContactTraceLen
    Cross.replacementLinkageConcrete (Q0.data i hi).qstar
  have hn_two : 2 ≤ n := by
    simpa [n] using
      Cross.qstar_replacementContactTraceLen_two_le_rightLeft
        Inv hadj_swap (i := i) (hi := hi)
  intro r
  let cur : Fin (endpointContactTraceLen
      Cross.replacementLinkageConcrete (Q0.data i hi).qstar + 1) :=
    ⟨r.1, by omega⟩
  let nxt : Fin (endpointContactTraceLen
      Cross.replacementLinkageConcrete (Q0.data i hi).qstar + 1) :=
    ⟨r.1 + 1, by omega⟩
  change
    Cross.qstar_replacementContactExtendedPos_rightLeft Inv hi nxt ≤
        Cross.qstar_replacementContactExtendedPos_rightLeft Inv hi cur + 1 ∧
      Cross.qstar_replacementContactExtendedPos_rightLeft Inv hi cur ≤
        Cross.qstar_replacementContactExtendedPos_rightLeft Inv hi nxt + 1
  by_cases hcur0 : r.1 = 0
  · have hnxt_not_last : nxt.1 ≠ n := by
      simp [nxt, n]
      omega
    have hnxt_not_zero : nxt.1 ≠ 0 := by
      simp [nxt]
    let row :=
      Cross.qstar_replacementContactInternalRow_rightLeft
        Inv (i := i) (hi := hi) nxt hnxt_not_zero hnxt_not_last
    have hrowmem :
        endpointContact Cross.replacementLinkageConcrete
            (Q0.data i hi).qstar
            ⟨1, by simp [endpointContactTraceLen]⟩ ∈
          (Cross.successorRowPathRightLeft row).vertexSet := by
      simpa [row, nxt, hcur0] using
        Cross.qstar_replacementContactInternalRow_mem_rightLeft
          Inv (i := i) (hi := hi) nxt hnxt_not_zero hnxt_not_last
    have hrow_last :
        Inv.base.orderedRows.order row =
          (⟨z h - 1, by dsimp [z]; omega⟩ : Fin (z h)) :=
      Cross.qstar_replacementContact_one_row_eq_last_rightLeft
        (hpos := hpos) Inv hadj_swap (i := i) (hi := hi) hrowmem
    have hrow_val :
        (Inv.base.orderedRows.order row).1 = z h - 1 :=
      congrArg Fin.val hrow_last
    have hpos_cur :
        Cross.qstar_replacementContactExtendedPos_rightLeft Inv hi cur =
          z h + 1 := by
      have hcur_eq :
          cur =
            (⟨0, by simp [endpointContactTraceLen]⟩ :
              Fin (endpointContactTraceLen
                Cross.replacementLinkageConcrete
                (Q0.data i hi).qstar + 1)) := by
        exact Fin.ext (by simp [cur, hcur0])
      simpa [hcur_eq] using
        Cross.qstar_replacementContactExtendedPos_zero_rightLeft
          Inv (i := i) (hi := hi)
    have hpos_nxt :
        Cross.qstar_replacementContactExtendedPos_rightLeft Inv hi nxt =
          z h := by
      have hchosen_val :
          (Inv.base.orderedRows.order
            (Cross.qstar_replacementContactInternalRow_rightLeft
              Inv (i := i) (hi := hi) nxt hnxt_not_zero
                hnxt_not_last)).1 =
            z h - 1 := by
        simpa [row] using hrow_val
      rw [Cross.qstar_replacementContactExtendedPos_internal_rightLeft
        Inv (i := i) (hi := hi) (r := nxt) hnxt_not_zero
        hnxt_not_last]
      omega
    constructor <;> simp [hpos_cur, hpos_nxt] <;> omega
  · by_cases hnext_last : r.1 + 1 = n
    · have hcur_not_zero : cur.1 ≠ 0 := by
        simp [cur]
        omega
      have hcur_not_last : cur.1 ≠ n := by
        simp [cur]
        omega
      let row :=
        Cross.qstar_replacementContactInternalRow_rightLeft
          Inv (i := i) (hi := hi) cur hcur_not_zero hcur_not_last
      have hcur_eq_pred :
          cur =
            (⟨endpointContactTraceLen Cross.replacementLinkageConcrete
                    (Q0.data i hi).qstar - 1,
                by simp [endpointContactTraceLen]⟩ :
              Fin (endpointContactTraceLen
                Cross.replacementLinkageConcrete
                (Q0.data i hi).qstar + 1)) := by
        apply Fin.ext
        simp [cur, n]
        omega
      have hrowmem :
          endpointContact Cross.replacementLinkageConcrete
              (Q0.data i hi).qstar
              ⟨endpointContactTraceLen Cross.replacementLinkageConcrete
                    (Q0.data i hi).qstar - 1,
                by simp [endpointContactTraceLen]⟩ ∈
            (Cross.successorRowPathRightLeft row).vertexSet := by
        simpa [row, hcur_eq_pred] using
          Cross.qstar_replacementContactInternalRow_mem_rightLeft
            Inv (i := i) (hi := hi) cur hcur_not_zero hcur_not_last
      have hrow_first :
          Inv.base.orderedRows.order row =
            (⟨0, by dsimp [z]; omega⟩ : Fin (z h)) :=
        Cross.qstar_replacementContact_pred_last_row_eq_first_rightLeft
          (hpos := hpos) Inv hadj_swap (i := i) (hi := hi) hrowmem
      have hrow_val :
          (Inv.base.orderedRows.order row).1 = 0 :=
        congrArg Fin.val hrow_first
      have hpos_cur :
          Cross.qstar_replacementContactExtendedPos_rightLeft Inv hi cur = 1 := by
        rw [Cross.qstar_replacementContactExtendedPos_internal_rightLeft
          Inv (i := i) (hi := hi) (r := cur) hcur_not_zero hcur_not_last]
        simpa [row, hrow_val] using hrow_val
      have hpos_nxt :
          Cross.qstar_replacementContactExtendedPos_rightLeft Inv hi nxt = 0 := by
        have hnxt_eq :
            nxt =
              (⟨endpointContactTraceLen Cross.replacementLinkageConcrete
                    (Q0.data i hi).qstar, by omega⟩ :
                Fin (endpointContactTraceLen
                  Cross.replacementLinkageConcrete
                  (Q0.data i hi).qstar + 1)) := by
          apply Fin.ext
          simp [nxt, n, hnext_last]
        simpa [hnxt_eq] using
          Cross.qstar_replacementContactExtendedPos_last_rightLeft
            Inv (i := i) (hi := hi)
      constructor <;> simp [hpos_cur, hpos_nxt] <;> omega
    · have hcur_not_last : cur.1 ≠ n := by
        simp [cur]
        omega
      have hnxt_not_zero : nxt.1 ≠ 0 := by
        simp [nxt]
      have hnxt_not_last : nxt.1 ≠ n := by
        simpa [nxt] using hnext_last
      let row :=
        Cross.qstar_replacementContactInternalRow_rightLeft
          Inv (i := i) (hi := hi) cur hcur0 hcur_not_last
      let row' :=
        Cross.qstar_replacementContactInternalRow_rightLeft
          Inv (i := i) (hi := hi) nxt hnxt_not_zero hnxt_not_last
      have hrowmem :
          endpointContact Cross.replacementLinkageConcrete
              (Q0.data i hi).qstar ⟨r.1, by omega⟩ ∈
            (Cross.successorRowPathRightLeft row).vertexSet := by
        simpa [row, cur, n] using
          Cross.qstar_replacementContactInternalRow_mem_rightLeft
            Inv (i := i) (hi := hi) cur hcur0 hcur_not_last
      have hrowmem' :
          endpointContact Cross.replacementLinkageConcrete
              (Q0.data i hi).qstar ⟨r.1 + 1, by omega⟩ ∈
            (Cross.successorRowPathRightLeft row').vertexSet := by
        simpa [row', nxt, n] using
          Cross.qstar_replacementContactInternalRow_mem_rightLeft
            Inv (i := i) (hi := hi) nxt hnxt_not_zero hnxt_not_last
      have hpos_cur :
          Cross.qstar_replacementContactExtendedPos_rightLeft Inv hi cur =
            (Inv.base.orderedRows.order row).1 + 1 := by
        rw [Cross.qstar_replacementContactExtendedPos_internal_rightLeft
          Inv (i := i) (hi := hi) (r := cur) hcur0 hcur_not_last]
      have hpos_nxt :
          Cross.qstar_replacementContactExtendedPos_rightLeft Inv hi nxt =
            (Inv.base.orderedRows.order row').1 + 1 := by
        rw [Cross.qstar_replacementContactExtendedPos_internal_rightLeft
          Inv (i := i) (hi := hi) (r := nxt) hnxt_not_zero hnxt_not_last]
      rcases Cross.qstar_replacement_contacts_rows_eq_or_consecutive_rightLeft
          Inv hadj_swap (i := i) (hi := hi) r hrowmem hrowmem'
        with hsame | hcon
      · have hval_eq :
            (Inv.base.orderedRows.order row).1 =
              (Inv.base.orderedRows.order row').1 := by
          rw [hsame]
        constructor <;> simp [hpos_cur, hpos_nxt] <;> omega
      · rcases hcon with hsucc | hpred
        · constructor <;> simp [hpos_cur, hpos_nxt] <;> omega
        · constructor <;> simp [hpos_cur, hpos_nxt] <;> omega

noncomputable def qstar_replacementBareExtendedRowContactTrace_rightLeft
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hadj_swap :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) i)
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) j))
    {i : Q.Index} (hi : i ∈ Q0.indices) :
    TypeOneBareExtendedRowContactTrace
      (h := h) I.Row Inv.base.orderedRows.order
      Cross.successorRowPathRightLeft (Q0.data i hi).qstar where
  len := endpointContactTraceLen
    Cross.replacementLinkageConcrete (Q0.data i hi).qstar
  contact := endpointContact Cross.replacementLinkageConcrete
    (Q0.data i hi).qstar
  pos := fun r => Cross.qstar_replacementContactExtendedPos_rightLeft Inv hi r
  contact_mem_path :=
    endpointContact_mem_path Cross.replacementLinkageConcrete
      (Q0.data i hi).qstar
  first_pos := by
    simpa using
      Cross.qstar_replacementContactExtendedPos_zero_rightLeft
        Inv (i := i) (hi := hi)
  last_pos := by
    simpa using
      Cross.qstar_replacementContactExtendedPos_last_rightLeft
        Inv (i := i) (hi := hi)
  unit_step :=
    Cross.qstar_replacementContactExtendedPos_unit_step_rightLeft
      Inv hadj_swap (i := i) (hi := hi)
  contact_mem_row_of_pos := by
    classical
    intro row r hpos_eq
    by_cases hr0 : r.1 = 0
    · have hrowlt : (Inv.base.orderedRows.order row).1 < z h :=
        (Inv.base.orderedRows.order row).2
      have hpos0 :
          Cross.qstar_replacementContactExtendedPos_rightLeft Inv hi r =
            z h + 1 := by
        have hr_eq :
            r =
              (⟨0, by simp [endpointContactTraceLen]⟩ :
                Fin (endpointContactTraceLen
                  Cross.replacementLinkageConcrete
                  (Q0.data i hi).qstar + 1)) := by
          exact Fin.ext hr0
        simpa [hr_eq] using
          Cross.qstar_replacementContactExtendedPos_zero_rightLeft
            Inv (i := i) (hi := hi)
      omega
    · by_cases hrlast :
        r.1 = endpointContactTraceLen
          Cross.replacementLinkageConcrete (Q0.data i hi).qstar
      · have hposlast :
            Cross.qstar_replacementContactExtendedPos_rightLeft Inv hi r = 0 := by
          have hr_eq :
              r =
                (⟨endpointContactTraceLen
                    Cross.replacementLinkageConcrete
                    (Q0.data i hi).qstar, by omega⟩ :
                  Fin (endpointContactTraceLen
                    Cross.replacementLinkageConcrete
                    (Q0.data i hi).qstar + 1)) := by
            exact Fin.ext hrlast
          simpa [hr_eq] using
            Cross.qstar_replacementContactExtendedPos_last_rightLeft
              Inv (i := i) (hi := hi)
        omega
      · let row0 :=
          Cross.qstar_replacementContactInternalRow_rightLeft
            Inv (i := i) (hi := hi) r hr0 hrlast
        have hmem :
            endpointContact Cross.replacementLinkageConcrete
                (Q0.data i hi).qstar r ∈
              (Cross.successorRowPathRightLeft row0).vertexSet := by
          simpa [row0] using
            Cross.qstar_replacementContactInternalRow_mem_rightLeft
              Inv (i := i) (hi := hi) r hr0 hrlast
        have hpos_internal :
            Cross.qstar_replacementContactExtendedPos_rightLeft Inv hi r =
              (Inv.base.orderedRows.order row0).1 + 1 := by
          simpa [row0] using
            Cross.qstar_replacementContactExtendedPos_internal_rightLeft
              Inv (i := i) (hi := hi) r hr0 hrlast
        have hval :
            (Inv.base.orderedRows.order row0).1 =
              (Inv.base.orderedRows.order row).1 := by
          omega
        have hfin :
            Inv.base.orderedRows.order row0 =
              Inv.base.orderedRows.order row := Fin.ext hval
        have hrow_eq : row0 = row :=
          Inv.base.orderedRows.order.injective hfin
        simpa [hrow_eq] using hmem

/-- The right-to-left no-skip successor-row contact survival for a cross. -/
theorem successorCurrentRowsInvariantRightLeft_of_aux_adjacency_swapped
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hadj_swap :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) i)
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) j)) :
    TypeOneCurrentRowsInvariant R hpos Q0 I.Row
      Cross.successorRowPathRightLeft :=
  TypeOneCurrentRowsInvariant_of_bareExtendedRowContactTraces
    (fun i hi =>
      ⟨Cross.qstar_replacementBareExtendedRowContactTrace_rightLeft
        Inv hadj_swap (i := i) hi⟩)




/-- The first clean cross segment itself witnesses the old auxiliary edge
between the two crossed rows. -/
theorem old_aux_adj_left_right (Cross : CrossWitness I) :
    (linkageAuxGraph I.linkage).Adj
      (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight) := by
  classical
  have hsource :
      Cross.orientedSegment1.source ∈
        (I.linkage.path (I.rowIndex Cross.rowLeft)).vertexSet := by
    simpa [Cross.orientedSegment1_source,
      I.rowPath_eq_linkage_path Cross.rowLeft] using Cross.s1_mem_left
  have htarget :
      Cross.orientedSegment1.target ∈
        (I.linkage.path (I.rowIndex Cross.rowRight)).vertexSet := by
    simpa [Cross.orientedSegment1_target,
      I.rowPath_eq_linkage_path Cross.rowRight] using Cross.t1_mem_right
  rcases aux_adj_or_eq_of_clean_segment
      (L := I.linkage) Cross.orientedSegment1 hsource htarget
      Cross.orientedSegment1_clean_linkage with heq | hadj
  · exact False.elim (Cross.rowIndex_ne heq)
  · exact hadj

/-- In any state satisfying the active auxiliary no-chord invariant, the two
rows of a cross occupy consecutive positions in the maintained row order. -/
theorem old_rows_consecutive
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Cross : CrossWitness I) :
    FinConsecutive (Inv.base.orderedRows.order Cross.rowLeft)
      (Inv.base.orderedRows.order Cross.rowRight) :=
  Inv.extended.full.active_aux.no_chord
    Cross.old_aux_adj_left_right

/-- Expanded disjunction form of `old_rows_consecutive`. -/
theorem old_rows_forward_or_backward
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Cross : CrossWitness I) :
    (Inv.base.orderedRows.order Cross.rowLeft).1 + 1 =
        (Inv.base.orderedRows.order Cross.rowRight).1 ∨
      (Inv.base.orderedRows.order Cross.rowRight).1 + 1 =
        (Inv.base.orderedRows.order Cross.rowLeft).1 :=
  Cross.old_rows_consecutive Inv

end CrossWitness

/-! #### Forward local quadruple data for crosses -/

/-- The old local quadruple around a forward-oriented cross.

This is the boundary-aware version of the paper's notation
`P_{j-1}, P_j, P_{j+1}, P_{j+2}` for the case where `rowLeft` is immediately
before `rowRight` in the maintained row order. -/
structure TypeOneCrossForwardLocalQuadData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Cross : CrossWitness I) where
  auxA : I.linkage.Index
  auxD : I.linkage.Index
  hAU_old :
    (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Cross.rowLeft)
  hUV_old :
    (linkageAuxGraph I.linkage).Adj
      (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
  hVD_old :
    (linkageAuxGraph I.linkage).Adj
      (I.rowIndex Cross.rowRight) auxD
  hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2
  hU_old :
    DegreeEquals (linkageAuxGraph I.linkage)
      (I.rowIndex Cross.rowLeft) 2
  hV_old :
    DegreeEquals (linkageAuxGraph I.linkage)
      (I.rowIndex Cross.rowRight) 2
  hD_old : DegreeEquals (linkageAuxGraph I.linkage) auxD 2
  hAV : auxA ≠ I.rowIndex Cross.rowRight
  hUD : I.rowIndex Cross.rowLeft ≠ auxD
  hAD : auxA ≠ auxD

namespace TypeOneExtendedFutureCleanIterationInvariants

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}

/-- Extract the old local quadruple around a cross when the crossed rows occur
in the forward order of the maintained active row path. -/
noncomputable def crossForwardLocalQuadData
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Cross : CrossWitness I)
    (hforward :
      (Inv.base.orderedRows.order Cross.rowLeft).1 + 1 =
        (Inv.base.orderedRows.order Cross.rowRight).1) :
    TypeOneCrossForwardLocalQuadData Inv Cross := by
  classical
  let order := Inv.base.orderedRows.order
  let pL : Fin (z h) := order Cross.rowLeft
  let pR : Fin (z h) := order Cross.rowRight
  have hforward_val : pL.1 + 1 = pR.1 := by
    simpa [pL, pR] using hforward
  have hUV : (linkageAuxGraph I.linkage).Adj
      (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight) :=
    Cross.old_aux_adj_left_right
  by_cases hleft_first : pL.1 = 0
  · let auxA : I.linkage.Index := Inv.extended.boundary.lowerBoundary
    have hrow_left_first :
        Cross.rowLeft =
          order.symm (⟨0, by
            dsimp [z]
            omega⟩ : Fin (z h)) := by
      apply order.injective
      apply Fin.ext
      simp [pL, hleft_first]
    by_cases hright_last : pR.1 + 1 = z h
    · let auxD : I.linkage.Index := Inv.extended.boundary.upperBoundary
      have hrow_right_last :
          Cross.rowRight =
            order.symm
              (⟨z h - 1, by
                dsimp [z]
                omega⟩ : Fin (z h)) := by
        apply order.injective
        apply Fin.ext
        simp
        omega
      refine
        { auxA := auxA
          auxD := auxD
          hAU_old := ?_
          hUV_old := hUV
          hVD_old := ?_
          hA_old := Inv.extended.boundary.lower_degree_two
          hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
          hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
          hD_old := Inv.extended.boundary.upper_degree_two
          hAV := ?_
          hUD := ?_
          hAD := ?_ }
      · simpa [auxA, hrow_left_first] using
          Inv.extended.boundary.lower_adj_first
      · simpa [auxD, hrow_right_last] using
          Inv.extended.boundary.last_adj_upper
      · exact Inv.extended.boundary.lower_ne_row Cross.rowRight
      · exact (Inv.extended.boundary.upper_ne_row Cross.rowLeft).symm
      · exact Inv.extended.boundary.lower_ne_upper
    · let nextFin : Fin (z h) := ⟨pR.1 + 1, by omega⟩
      let nextRow : I.Row := order.symm nextFin
      have hnext_order : order nextRow = nextFin := by
        simp [nextRow]
      have hcon_next :
          FinConsecutive (order Cross.rowRight) (order nextRow) := by
        rw [hnext_order]
        left
        simp [nextFin, pR]
      refine
        { auxA := auxA
          auxD := I.rowIndex nextRow
          hAU_old := ?_
          hUV_old := hUV
          hVD_old := ?_
          hA_old := Inv.extended.boundary.lower_degree_two
          hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
          hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
          hD_old := Inv.extended.full.active_aux.degree_two nextRow
          hAV := ?_
          hUD := ?_
          hAD := ?_ }
      · simpa [auxA, hrow_left_first] using
          Inv.extended.boundary.lower_adj_first
      · simpa using Inv.extended.full.active_aux.consecutive_adj hcon_next
      · exact Inv.extended.boundary.lower_ne_row Cross.rowRight
      · intro hidx
        have hrow : Cross.rowLeft = nextRow :=
          Inv.base.rowIndexInjective hidx
        have hpos_eq :
            (order Cross.rowLeft).1 = (order nextRow).1 := by
          simp [hrow]
        simp [hnext_order, nextFin, pR] at hpos_eq
        omega
      · exact Inv.extended.boundary.lower_ne_row nextRow
  · let prevFin : Fin (z h) := ⟨pL.1 - 1, by omega⟩
    let prevRow : I.Row := order.symm prevFin
    have hprev_order : order prevRow = prevFin := by
      simp [prevRow]
    have hcon_prev :
        FinConsecutive (order prevRow) (order Cross.rowLeft) := by
      rw [hprev_order]
      left
      simp [prevFin, pL]
      omega
    by_cases hright_last : pR.1 + 1 = z h
    · let auxD : I.linkage.Index := Inv.extended.boundary.upperBoundary
      have hrow_right_last :
          Cross.rowRight =
            order.symm
              (⟨z h - 1, by
                dsimp [z]
                omega⟩ : Fin (z h)) := by
        apply order.injective
        apply Fin.ext
        simp
        omega
      refine
        { auxA := I.rowIndex prevRow
          auxD := auxD
          hAU_old := ?_
          hUV_old := hUV
          hVD_old := ?_
          hA_old := Inv.extended.full.active_aux.degree_two prevRow
          hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
          hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
          hD_old := Inv.extended.boundary.upper_degree_two
          hAV := ?_
          hUD := ?_
          hAD := ?_ }
      · simpa using Inv.extended.full.active_aux.consecutive_adj hcon_prev
      · simpa [auxD, hrow_right_last] using
          Inv.extended.boundary.last_adj_upper
      · intro hidx
        have hrow : prevRow = Cross.rowRight :=
          Inv.base.rowIndexInjective hidx
        have hpos_eq :
            (order prevRow).1 = (order Cross.rowRight).1 := by
          simp [hrow]
        simp [hprev_order, prevFin, pL] at hpos_eq
        omega
      · exact (Inv.extended.boundary.upper_ne_row Cross.rowLeft).symm
      · exact (Inv.extended.boundary.upper_ne_row prevRow).symm
    · let nextFin : Fin (z h) := ⟨pR.1 + 1, by omega⟩
      let nextRow : I.Row := order.symm nextFin
      have hnext_order : order nextRow = nextFin := by
        simp [nextRow]
      have hcon_next :
          FinConsecutive (order Cross.rowRight) (order nextRow) := by
        rw [hnext_order]
        left
        simp [nextFin, pR]
      refine
        { auxA := I.rowIndex prevRow
          auxD := I.rowIndex nextRow
          hAU_old := ?_
          hUV_old := hUV
          hVD_old := ?_
          hA_old := Inv.extended.full.active_aux.degree_two prevRow
          hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
          hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
          hD_old := Inv.extended.full.active_aux.degree_two nextRow
          hAV := ?_
          hUD := ?_
          hAD := ?_ }
      · simpa using Inv.extended.full.active_aux.consecutive_adj hcon_prev
      · simpa using Inv.extended.full.active_aux.consecutive_adj hcon_next
      · intro hidx
        have hrow : prevRow = Cross.rowRight :=
          Inv.base.rowIndexInjective hidx
        have hpos_eq :
            (order prevRow).1 = (order Cross.rowRight).1 := by
          simp [hrow]
        simp [hprev_order, prevFin, pL] at hpos_eq
        omega
      · intro hidx
        have hrow : Cross.rowLeft = nextRow :=
          Inv.base.rowIndexInjective hidx
        have hpos_eq :
            (order Cross.rowLeft).1 = (order nextRow).1 := by
          simp [hrow]
        simp [hnext_order, nextFin, pR] at hpos_eq
        omega
      · intro hidx
        have hrow : prevRow = nextRow :=
          Inv.base.rowIndexInjective hidx
        have hpos_eq :
            (order prevRow).1 = (order nextRow).1 := by
          simp [hrow]
        simp [hprev_order, hnext_order, prevFin, nextFin, pL, pR] at hpos_eq
        omega

end TypeOneExtendedFutureCleanIterationInvariants

/-! #### Backward local quadruple data for crosses -/

/-- The old local quadruple around a backward-oriented cross.

This is the same finite local data as `TypeOneCrossForwardLocalQuadData`, but
for the case where `rowRight` is immediately before `rowLeft` in the maintained
row order.  The names `auxA` and `auxD` still refer to the neighbors of
`rowLeft` and `rowRight`, respectively, that are not the other crossed row. -/
structure TypeOneCrossBackwardLocalQuadData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Cross : CrossWitness I) where
  auxA : I.linkage.Index
  auxD : I.linkage.Index
  hAU_old :
    (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Cross.rowLeft)
  hUV_old :
    (linkageAuxGraph I.linkage).Adj
      (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
  hVD_old :
    (linkageAuxGraph I.linkage).Adj
      (I.rowIndex Cross.rowRight) auxD
  hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2
  hU_old :
    DegreeEquals (linkageAuxGraph I.linkage)
      (I.rowIndex Cross.rowLeft) 2
  hV_old :
    DegreeEquals (linkageAuxGraph I.linkage)
      (I.rowIndex Cross.rowRight) 2
  hD_old : DegreeEquals (linkageAuxGraph I.linkage) auxD 2
  hAV : auxA ≠ I.rowIndex Cross.rowRight
  hUD : I.rowIndex Cross.rowLeft ≠ auxD
  hAD : auxA ≠ auxD

namespace TypeOneExtendedFutureCleanIterationInvariants

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}

/-- Extract the old local quadruple around a cross when the crossed rows occur
in the reverse order of the maintained active row path. -/
noncomputable def crossBackwardLocalQuadData
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Cross : CrossWitness I)
    (hbackward :
      (Inv.base.orderedRows.order Cross.rowRight).1 + 1 =
        (Inv.base.orderedRows.order Cross.rowLeft).1) :
    TypeOneCrossBackwardLocalQuadData Inv Cross := by
  classical
  let order := Inv.base.orderedRows.order
  let pL : Fin (z h) := order Cross.rowLeft
  let pR : Fin (z h) := order Cross.rowRight
  have hbackward_val : pR.1 + 1 = pL.1 := by
    simpa [pL, pR] using hbackward
  have hUV : (linkageAuxGraph I.linkage).Adj
      (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight) :=
    Cross.old_aux_adj_left_right
  by_cases hleft_last : pL.1 + 1 = z h
  · let auxA : I.linkage.Index := Inv.extended.boundary.upperBoundary
    have hrow_left_last :
        Cross.rowLeft =
          order.symm
            (⟨z h - 1, by
              dsimp [z]
              omega⟩ : Fin (z h)) := by
      apply order.injective
      apply Fin.ext
      simp
      omega
    by_cases hright_first : pR.1 = 0
    · let auxD : I.linkage.Index := Inv.extended.boundary.lowerBoundary
      have hrow_right_first :
          Cross.rowRight =
            order.symm (⟨0, by
              dsimp [z]
              omega⟩ : Fin (z h)) := by
        apply order.injective
        apply Fin.ext
        simp [pR, hright_first]
      refine
        { auxA := auxA
          auxD := auxD
          hAU_old := ?_
          hUV_old := hUV
          hVD_old := ?_
          hA_old := Inv.extended.boundary.upper_degree_two
          hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
          hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
          hD_old := Inv.extended.boundary.lower_degree_two
          hAV := ?_
          hUD := ?_
          hAD := ?_ }
      · exact (linkageAuxGraph I.linkage).symm (by
          simpa [auxA, hrow_left_last] using
            Inv.extended.boundary.last_adj_upper)
      · exact (linkageAuxGraph I.linkage).symm (by
          simpa [auxD, hrow_right_first] using
            Inv.extended.boundary.lower_adj_first)
      · exact Inv.extended.boundary.upper_ne_row Cross.rowRight
      · exact (Inv.extended.boundary.lower_ne_row Cross.rowLeft).symm
      · exact Inv.extended.boundary.lower_ne_upper.symm
    · let prevFin : Fin (z h) := ⟨pR.1 - 1, by omega⟩
      let prevRow : I.Row := order.symm prevFin
      have hprev_order : order prevRow = prevFin := by
        simp [prevRow]
      have hcon_prev :
          FinConsecutive (order prevRow) (order Cross.rowRight) := by
        rw [hprev_order]
        left
        simp [prevFin, pR]
        omega
      refine
        { auxA := auxA
          auxD := I.rowIndex prevRow
          hAU_old := ?_
          hUV_old := hUV
          hVD_old := ?_
          hA_old := Inv.extended.boundary.upper_degree_two
          hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
          hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
          hD_old := Inv.extended.full.active_aux.degree_two prevRow
          hAV := ?_
          hUD := ?_
          hAD := ?_ }
      · exact (linkageAuxGraph I.linkage).symm (by
          simpa [auxA, hrow_left_last] using
            Inv.extended.boundary.last_adj_upper)
      · exact (linkageAuxGraph I.linkage).symm
          (Inv.extended.full.active_aux.consecutive_adj hcon_prev)
      · exact Inv.extended.boundary.upper_ne_row Cross.rowRight
      · intro hidx
        have hrow : Cross.rowLeft = prevRow :=
          Inv.base.rowIndexInjective hidx
        have hpos_eq :
            (order Cross.rowLeft).1 = (order prevRow).1 := by
          simp [hrow]
        simp [hprev_order, prevFin, pR] at hpos_eq
        omega
      · exact Inv.extended.boundary.upper_ne_row prevRow
  · let nextFin : Fin (z h) := ⟨pL.1 + 1, by omega⟩
    let nextRow : I.Row := order.symm nextFin
    have hnext_order : order nextRow = nextFin := by
      simp [nextRow]
    have hcon_next :
        FinConsecutive (order Cross.rowLeft) (order nextRow) := by
      rw [hnext_order]
      left
      simp [nextFin, pL]
    by_cases hright_first : pR.1 = 0
    · let auxD : I.linkage.Index := Inv.extended.boundary.lowerBoundary
      have hrow_right_first :
          Cross.rowRight =
            order.symm (⟨0, by
              dsimp [z]
              omega⟩ : Fin (z h)) := by
        apply order.injective
        apply Fin.ext
        simp [pR, hright_first]
      refine
        { auxA := I.rowIndex nextRow
          auxD := auxD
          hAU_old := ?_
          hUV_old := hUV
          hVD_old := ?_
          hA_old := Inv.extended.full.active_aux.degree_two nextRow
          hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
          hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
          hD_old := Inv.extended.boundary.lower_degree_two
          hAV := ?_
          hUD := ?_
          hAD := ?_ }
      · exact (linkageAuxGraph I.linkage).symm
          (Inv.extended.full.active_aux.consecutive_adj hcon_next)
      · exact (linkageAuxGraph I.linkage).symm (by
          simpa [auxD, hrow_right_first] using
            Inv.extended.boundary.lower_adj_first)
      · intro hidx
        have hrow : nextRow = Cross.rowRight :=
          Inv.base.rowIndexInjective hidx
        have hpos_eq :
            (order nextRow).1 = (order Cross.rowRight).1 := by
          simp [hrow]
        simp [hnext_order, nextFin, pL] at hpos_eq
        omega
      · exact (Inv.extended.boundary.lower_ne_row Cross.rowLeft).symm
      · exact (Inv.extended.boundary.lower_ne_row nextRow).symm
    · let prevFin : Fin (z h) := ⟨pR.1 - 1, by omega⟩
      let prevRow : I.Row := order.symm prevFin
      have hprev_order : order prevRow = prevFin := by
        simp [prevRow]
      have hcon_prev :
          FinConsecutive (order prevRow) (order Cross.rowRight) := by
        rw [hprev_order]
        left
        simp [prevFin, pR]
        omega
      refine
        { auxA := I.rowIndex nextRow
          auxD := I.rowIndex prevRow
          hAU_old := ?_
          hUV_old := hUV
          hVD_old := ?_
          hA_old := Inv.extended.full.active_aux.degree_two nextRow
          hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
          hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
          hD_old := Inv.extended.full.active_aux.degree_two prevRow
          hAV := ?_
          hUD := ?_
          hAD := ?_ }
      · exact (linkageAuxGraph I.linkage).symm
          (Inv.extended.full.active_aux.consecutive_adj hcon_next)
      · exact (linkageAuxGraph I.linkage).symm
          (Inv.extended.full.active_aux.consecutive_adj hcon_prev)
      · intro hidx
        have hrow : nextRow = Cross.rowRight :=
          Inv.base.rowIndexInjective hidx
        have hpos_eq :
            (order nextRow).1 = (order Cross.rowRight).1 := by
          simp [hrow]
        simp [hnext_order, nextFin, pL] at hpos_eq
        omega
      · intro hidx
        have hrow : Cross.rowLeft = prevRow :=
          Inv.base.rowIndexInjective hidx
        have hpos_eq :
            (order Cross.rowLeft).1 = (order prevRow).1 := by
          simp [hrow]
        simp [hprev_order, prevFin, pR] at hpos_eq
        omega
      · intro hidx
        have hrow : nextRow = prevRow :=
          Inv.base.rowIndexInjective hidx
        have hpos_eq :
            (order nextRow).1 = (order prevRow).1 := by
          simp [hrow]
        simp [hnext_order, hprev_order, nextFin, prevFin, pL, pR] at hpos_eq
        omega

end TypeOneExtendedFutureCleanIterationInvariants

/-! #### Local row-neighbor data from the extended invariant -/

/-- The old local triple around a bump row, extracted from the maintained
extended degree-two path.

The endpoints may be either active rows or the fixed boundary rows `P₀` and
`P_{z+1}`.  This is the formal boundary-aware version of the paper's notation
`P_{j-1}, P_j, P_{j+1}` in the bump paragraph. -/
structure TypeOneBumpLocalTripleData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Bump : BumpWitness I) where
  left : I.linkage.Index
  right : I.linkage.Index
  left_adj_mid :
    (linkageAuxGraph I.linkage).Adj left (I.rowIndex Bump.row)
  mid_adj_right :
    (linkageAuxGraph I.linkage).Adj (I.rowIndex Bump.row) right
  left_degree_two :
    DegreeEquals (linkageAuxGraph I.linkage) left 2
  mid_degree_two :
    DegreeEquals (linkageAuxGraph I.linkage) (I.rowIndex Bump.row) 2
  right_degree_two :
    DegreeEquals (linkageAuxGraph I.linkage) right 2
  left_ne_mid : left ≠ I.rowIndex Bump.row
  mid_ne_right : I.rowIndex Bump.row ≠ right
  left_ne_right : left ≠ right

namespace TypeOneExtendedFutureCleanIterationInvariants

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}

/-- Extract the old local triple around a bump row from the extended path
invariant.

If the bumped row is first or last, the corresponding neighbor is one of the
two fixed boundary rows; otherwise it is the adjacent active row in the stored
row order. -/
noncomputable def bumpLocalTripleData
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Bump : BumpWitness I) :
    TypeOneBumpLocalTripleData Inv Bump := by
  classical
  let order := Inv.base.orderedRows.order
  let p : Fin (z h) := order Bump.row
  let H := linkageAuxGraph I.linkage
  have hzpos : 0 < z h := by
    dsimp [z]
    omega
  by_cases hfirst : p.1 = 0
  · by_cases hlast : p.1 + 1 = z h
    · have hzle : z h ≤ 1 := by
        omega
      have hztwo : 2 ≤ z h := by
        dsimp [z]
        omega
      omega
    · let nextFin : Fin (z h) := ⟨p.1 + 1, by omega⟩
      let nextRow : I.Row := order.symm nextFin
      have hrow_first :
          Bump.row =
            order.symm (⟨0, by omega⟩ : Fin (z h)) := by
        apply order.injective
        apply Fin.ext
        simp [p, hfirst]
      have hnext_order : order nextRow = nextFin := by
        simp [nextRow]
      have hcon_next :
          FinConsecutive (order Bump.row) (order nextRow) := by
        rw [hnext_order]
        left
        simp [nextFin, p]
      refine
        { left := Inv.extended.boundary.lowerBoundary
          right := I.rowIndex nextRow
          left_adj_mid := ?_
          mid_adj_right := ?_
          left_degree_two := Inv.extended.boundary.lower_degree_two
          mid_degree_two := Inv.extended.full.active_aux.degree_two Bump.row
          right_degree_two := Inv.extended.full.active_aux.degree_two nextRow
          left_ne_mid := Inv.extended.boundary.lower_ne_row Bump.row
          mid_ne_right := ?_
          left_ne_right := ?_ }
      · simpa [hrow_first] using
          Inv.extended.boundary.lower_adj_first
      · simpa using
          Inv.extended.full.active_aux.consecutive_adj hcon_next
      · intro hidx
        have hrow : Bump.row = nextRow :=
          Inv.base.rowIndexInjective hidx
        have hpos_eq :
            (order Bump.row).1 = (order nextRow).1 := by
          simp [hrow]
        simp [hnext_order, p, hfirst] at hpos_eq
      · exact Inv.extended.boundary.lower_ne_row nextRow
  · let prevFin : Fin (z h) := ⟨p.1 - 1, by omega⟩
    let prevRow : I.Row := order.symm prevFin
    have hprev_order : order prevRow = prevFin := by
      simp [prevRow]
    have hcon_prev :
        FinConsecutive (order prevRow) (order Bump.row) := by
      rw [hprev_order]
      exact Or.inl (by
        simp [prevFin, p]
        omega)
    by_cases hlast : p.1 + 1 = z h
    · have hrow_last :
          Bump.row =
            order.symm
              (⟨z h - 1, by
                dsimp [z]
                omega⟩ : Fin (z h)) := by
        apply order.injective
        apply Fin.ext
        simp
        omega
      refine
        { left := I.rowIndex prevRow
          right := Inv.extended.boundary.upperBoundary
          left_adj_mid := ?_
          mid_adj_right := ?_
          left_degree_two := Inv.extended.full.active_aux.degree_two prevRow
          mid_degree_two := Inv.extended.full.active_aux.degree_two Bump.row
          right_degree_two := Inv.extended.boundary.upper_degree_two
          left_ne_mid := ?_
          mid_ne_right := ?_
          left_ne_right := ?_ }
      · simpa using
          Inv.extended.full.active_aux.consecutive_adj hcon_prev
      · simpa [hrow_last] using
          Inv.extended.boundary.last_adj_upper
      · intro hidx
        have hrow : prevRow = Bump.row :=
          Inv.base.rowIndexInjective hidx
        have hpos_eq :
            (order prevRow).1 = (order Bump.row).1 := by
          simp [hrow]
        simp [hprev_order, prevFin, p] at hpos_eq
        omega
      · exact (Inv.extended.boundary.upper_ne_row Bump.row).symm
      · intro hidx
        exact Inv.extended.boundary.upper_ne_row prevRow hidx.symm
    · let nextFin : Fin (z h) := ⟨p.1 + 1, by omega⟩
      let nextRow : I.Row := order.symm nextFin
      have hnext_order : order nextRow = nextFin := by
        simp [nextRow]
      have hcon_next :
          FinConsecutive (order Bump.row) (order nextRow) := by
        rw [hnext_order]
        left
        simp [nextFin, p]
      refine
        { left := I.rowIndex prevRow
          right := I.rowIndex nextRow
          left_adj_mid := ?_
          mid_adj_right := ?_
          left_degree_two := Inv.extended.full.active_aux.degree_two prevRow
          mid_degree_two := Inv.extended.full.active_aux.degree_two Bump.row
          right_degree_two := Inv.extended.full.active_aux.degree_two nextRow
          left_ne_mid := ?_
          mid_ne_right := ?_
          left_ne_right := ?_ }
      · simpa using
          Inv.extended.full.active_aux.consecutive_adj hcon_prev
      · simpa using
          Inv.extended.full.active_aux.consecutive_adj hcon_next
      · intro hidx
        have hrow : prevRow = Bump.row :=
          Inv.base.rowIndexInjective hidx
        have hpos_eq :
            (order prevRow).1 = (order Bump.row).1 := by
          simp [hrow]
        simp [hprev_order, prevFin, p] at hpos_eq
        omega
      · intro hidx
        have hrow : Bump.row = nextRow :=
          Inv.base.rowIndexInjective hidx
        have hpos_eq :
            (order Bump.row).1 = (order nextRow).1 := by
          simp [hrow]
        simp [hnext_order, nextFin, p] at hpos_eq
      · intro hidx
        have hrow : prevRow = nextRow :=
          Inv.base.rowIndexInjective hidx
        have hpos_eq :
            (order prevRow).1 = (order nextRow).1 := by
          simp [hrow]
        simp [hprev_order, hnext_order, prevFin, nextFin, p] at hpos_eq

end TypeOneExtendedFutureCleanIterationInvariants

namespace TypeOneQStarFamily

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}

/-- Initial paper-level invariant for the type-1 block, reduced to the
support and boundary-contact facts for all initially selected `Q₀` paths.

The row/auxiliary/boundary part is the previously formalized initial extended
invariant, and the linkage support part is the explicit decomposition of the
initial linkage into active rows, boundary rows, and outside paths. -/
noncomputable def initialExtendedFutureCleanIterationInvariants_of_allQ0
    (Q0 : TypeOneQStarFamily R hpos Q) :
    TypeOneExtendedFutureCleanIterationInvariants
      (initialIterationInput Q0) :=
  let full := Q0.initialExtendedFullIterationInvariants
  let support := initialIterationInput_typeOneLinkageSupportInvariant Q0
  TypeOneExtendedFutureCleanIterationInvariants.mkOfAllQ0 full support
    (TypeOneAllQ0RowCleanSubsegmentsFullClean_of_support full support)

end TypeOneQStarFamily

