/-- The old ordered type-2 terminal package is a post-hill terminal package
for the degenerate hill-elimination run where the selected columns are
unchanged. -/
noncomputable def ofOrderedPathHillTerminalData
    (D : TypeTwoOrderedPathHillTerminalData I inv) :
    TypeTwoTerminalPathOrderedHillTerminalData I inv where
  columns :=
    TypeTwoTerminalPathColumnOrder.ofTerminalColumnOrder
      (I := I) (inv := inv) D.columns
  claimB2 :=
    TypeTwoClaimB2TerminalPathOrderedGridAdjacencies.ofOrderedTerminalGridAdjacencies
      D.claimB2
  claimB3 := by
    rcases D.claimB3 with ⟨C⟩
    exact ⟨
      TypeTwoClaimB3TerminalPathOrderedHillNormalCertificate.ofOrderedPathHillNormalCertificate
        C⟩

end TypeTwoTerminalPathOrderedHillTerminalData

/-- Hill-elimination proof data for the symmetric type-2 terminal branch. -/
structure TypeTwoTerminalPathHillEliminationData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    (I : TypeTwoIterationInput R hpos Q0)
    (inv : TypeTwoIterationInvariants I) where
  State : Type u
  initial : State
  measure : State → ℕ
  Terminal : State → Prop
  step :
    ∀ s : State, ¬ Terminal s →
      ∃ s' : State, measure s' < measure s
  terminalData :
    ∀ s : State, Terminal s →
      TypeTwoTerminalPathOrderedHillTerminalData I inv

namespace TypeTwoTerminalPathHillEliminationData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeTwoQStarFamily R hpos Q}
variable {I : TypeTwoIterationInput R hpos Q0}
variable {inv : TypeTwoIterationInvariants I}

/-- Execute the abstract finite type-2 hill-elimination descent. -/
noncomputable def toTerminalPathOrderedHillTerminalData
    (D : TypeTwoTerminalPathHillEliminationData I inv) :
    TypeTwoTerminalPathOrderedHillTerminalData I inv := by
  classical
  let H : ∃ s : D.State, D.Terminal s :=
    exists_terminal_of_nat_descent D.measure D.Terminal D.step D.initial
  exact D.terminalData (Classical.choose H) (Classical.choose_spec H)

/-- Type-2 hill-elimination data directly gives the terminal grid minor. -/
theorem containsGridMinor
    (D : TypeTwoTerminalPathHillEliminationData I inv) :
    ContainsGridMinor G h :=
  D.toTerminalPathOrderedHillTerminalData.containsGridMinor

/-- A completed type-2 post-hill terminal package is a degenerate
hill-elimination proof with a one-state descent system. -/
noncomputable def ofTerminalData
    (D : TypeTwoTerminalPathOrderedHillTerminalData I inv) :
    TypeTwoTerminalPathHillEliminationData I inv where
  State := PUnit
  initial := PUnit.unit
  measure := fun _ => 0
  Terminal := fun _ => True
  step := by
    intro s hterm
    exact False.elim (hterm trivial)
  terminalData := by
    intro s hterm
    exact D

end TypeTwoTerminalPathHillEliminationData

