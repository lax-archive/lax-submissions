    (by simpa [hEq] using B.rightAtom.stop_mem_qstar)

/-- A blocker connector oriented from the candidate row to the lower row is
impossible once it lies between the bracketing hill connectors. -/
theorem impossible_topToLower
    (S : ClaimB2PlanarStripCertificate I inv)
    (B : ClaimB3HillBracketAtomData inv C)
    (M : ClaimB2Atom I)
    (hM_qIndex : M.qIndex = Q0.selectedColumn j')
    (hj' : j' ≠ C.col)
    (hM_top : M.rowStart = B.top)
    (hM_lower : M.rowStop = B.lowerRow)
    (hleft_middle_top :
      (I.rowPath B.top).Before B.leftAtom.start M.start)
    (hmiddle_right_top :
      (I.rowPath B.top).Before M.start B.rightAtom.start)
    (hleft_start_ne_middle : B.leftAtom.start ≠ M.start)
    (hmiddle_start_ne_right : M.start ≠ B.rightAtom.start)
    (hmiddle_stop_ne_left : M.stop ≠ B.leftAtom.stop)
    (hright_stop_ne_middle : B.rightAtom.stop ≠ M.stop) :
    False :=
  S.no_middle_connector_to_lower_between_hill_brackets
    B.leftAtom M B.rightAtom B.top B.lowerRow
    B.left_top B.left_lower hM_top hM_lower
    B.right_top B.right_lower B.top_ne_lower
    (B.left_middle_qIndex_ne hM_qIndex hj')
    (B.middle_right_qIndex_ne hM_qIndex hj')
    hleft_middle_top hmiddle_right_top
    hleft_start_ne_middle hmiddle_start_ne_right
    hmiddle_stop_ne_left hright_stop_ne_middle
    B.left_right_lower B.lower_interval_subset_left_qstar

/-- A blocker connector stored in the reverse direction is also impossible;
the lower-to-top atom is consumed by reversing it once. -/
theorem impossible_lowerToTop
    (S : ClaimB2PlanarStripCertificate I inv)
    (B : ClaimB3HillBracketAtomData inv C)
    (M : ClaimB2Atom I)
    (hM_qIndex : M.qIndex = Q0.selectedColumn j')
    (hj' : j' ≠ C.col)
    (hM_lower : M.rowStart = B.lowerRow)
    (hM_top : M.rowStop = B.top)
    (hleft_middle_top :
      (I.rowPath B.top).Before B.leftAtom.start M.stop)
    (hmiddle_right_top :
      (I.rowPath B.top).Before M.stop B.rightAtom.start)
    (hleft_start_ne_middle : B.leftAtom.start ≠ M.stop)
    (hmiddle_start_ne_right : M.stop ≠ B.rightAtom.start)
    (hmiddle_stop_ne_left : M.start ≠ B.leftAtom.stop)
    (hright_stop_ne_middle : B.rightAtom.stop ≠ M.start) :
    False :=
  S.no_reversed_middle_connector_to_lower_between_hill_brackets
    B.leftAtom M B.rightAtom B.top B.lowerRow
    B.left_top B.left_lower hM_lower hM_top
    B.right_top B.right_lower B.top_ne_lower
    (B.left_middle_qIndex_ne hM_qIndex hj')
    (B.middle_right_qIndex_ne hM_qIndex hj')
    hleft_middle_top hmiddle_right_top
    hleft_start_ne_middle hmiddle_start_ne_right
    hmiddle_stop_ne_left hright_stop_ne_middle
    B.left_right_lower B.lower_interval_subset_left_qstar

/-- A vertex strictly inside the hill row interval lies between the two
bracketing top endpoints. -/
theorem top_between_of_mem_rowInterval
    (B : ClaimB3HillBracketAtomData inv C)
    {v : V}
    (hv : v ∈ C.rowInterval.vertexSet) :
    (I.rowPath B.top).Before B.leftAtom.start v ∧
      (I.rowPath B.top).Before v B.rightAtom.start := by
  classical
  have hleft_before_v_row :
      (claimB3RowPath I inv C.row).Before C.left v :=
    (claimB3RowPath I inv C.row).before_of_mem_segmentOfBefore_left
      C.left_before_right hv
  have hv_before_right_row :
      (claimB3RowPath I inv C.row).Before v C.right :=
    (claimB3RowPath I inv C.row).before_of_mem_segmentOfBefore_right
      C.left_before_right hv
  have htop_eq : B.top = inv.orderedRows.order.symm C.row := by
    rw [← B.top_order]
    simp
  have hrowpath_eq :
      I.rowPath B.top = claimB3RowPath I inv C.row := by
    simp [claimB3RowPath, htop_eq]
  constructor
  · simpa [hrowpath_eq, B.left_start_eq] using hleft_before_v_row
  · simpa [hrowpath_eq, B.right_start_eq] using hv_before_right_row

theorem left_start_ne_of_mem_rowInterval
    (B : ClaimB3HillBracketAtomData inv C)
    {v : V}
    (hv_ne_left : v ≠ C.left) :
    B.leftAtom.start ≠ v := by
  intro h
  exact hv_ne_left (by simpa [B.left_start_eq] using h.symm)

theorem right_start_ne_of_mem_rowInterval
    (B : ClaimB3HillBracketAtomData inv C)
    {v : V}
    (hv_ne_right : v ≠ C.right) :
    v ≠ B.rightAtom.start := by
  intro h
  exact hv_ne_right (by simpa [B.right_start_eq] using h)

end ClaimB3HillBracketAtomData

/-- Flexible bracketing atoms for a Claim B.3 hill candidate.

The earlier `ClaimB3HillBracketAtomData` stored a fixed orientation of the
lower row interval.  Trace-generated hills naturally determine the two
top-to-lower boundary atoms, while the lower endpoints may appear in either
row order.  The flexible version records ownership for whichever lower
orientation is later forced by the no-cross comparison with a blocker atom. -/
structure ClaimB3FlexibleHillBracketAtomData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    (inv : TypeOneIterationInvariants I)
    (C : ClaimB3HillCandidateData I inv) where
  top : I.Row
  lowerRow : I.Row
  top_order : inv.orderedRows.order top = C.row
  lower_order : inv.orderedRows.order lowerRow = C.lower
  leftAtom : ClaimB2Atom I
  rightAtom : ClaimB2Atom I
  left_qIndex : leftAtom.qIndex = Q0.selectedColumn C.col
  right_qIndex : rightAtom.qIndex = Q0.selectedColumn C.col
  left_top : leftAtom.rowStart = top
  left_lower : leftAtom.rowStop = lowerRow
  right_top : rightAtom.rowStart = top
  right_lower : rightAtom.rowStop = lowerRow
  left_start_eq : leftAtom.start = C.left
  right_start_eq : rightAtom.start = C.right
  top_ne_lower : top ≠ lowerRow
  lower_interval_subset_left_qstar :
    ∀ hLR : (I.rowPath lowerRow).Before leftAtom.stop rightAtom.stop,
      ((I.rowPath lowerRow).segmentOfBefore hLR).vertexSet ⊆
        (Q0.data leftAtom.qIndex leftAtom.q_mem).qstar.vertexSet

namespace ClaimB3FlexibleHillBracketAtomData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}
variable {C : ClaimB3HillCandidateData I inv} {j' : Fin h}

theorem left_middle_qIndex_ne
    (B : ClaimB3FlexibleHillBracketAtomData inv C)
    {M : ClaimB2Atom I}
    (hM : M.qIndex = Q0.selectedColumn j')
    (hj' : j' ≠ C.col) :
    B.leftAtom.qIndex ≠ M.qIndex := by
  intro hidx
  have hsel : Q0.selectedColumn C.col = Q0.selectedColumn j' := by
    calc
      Q0.selectedColumn C.col = B.leftAtom.qIndex := B.left_qIndex.symm
      _ = M.qIndex := hidx
      _ = Q0.selectedColumn j' := hM
  exact hj' ((Q0.selectedColumn_injective) hsel.symm)

theorem middle_right_qIndex_ne
    (B : ClaimB3FlexibleHillBracketAtomData inv C)
    {M : ClaimB2Atom I}
    (hM : M.qIndex = Q0.selectedColumn j')
    (hj' : j' ≠ C.col) :
    M.qIndex ≠ B.rightAtom.qIndex := by
  intro hidx
  have hsel : Q0.selectedColumn j' = Q0.selectedColumn C.col := by
    calc
      Q0.selectedColumn j' = M.qIndex := hM.symm
      _ = B.rightAtom.qIndex := hidx
      _ = Q0.selectedColumn C.col := B.right_qIndex
  exact hj' ((Q0.selectedColumn_injective) hsel)

theorem blocker_start_ne_left_start
    (B : ClaimB3FlexibleHillBracketAtomData inv C)
    {M : ClaimB2Atom I}
    (hM : M.qIndex = Q0.selectedColumn j')
    (hj' : j' ≠ C.col) :
    B.leftAtom.start ≠ M.start := by
  intro hEq
  have hne : B.leftAtom.qIndex ≠ M.qIndex :=
    B.left_middle_qIndex_ne hM hj'
  have hdisj :=
    Q0.qstar_nodeDisjoint_of_ne
      (i := B.leftAtom.qIndex) (j := M.qIndex)
      (hi := B.leftAtom.q_mem) (hj := M.q_mem) hne
  exact Finset.disjoint_left.mp hdisj B.leftAtom.start_mem_qstar
    (by simpa [hEq] using M.start_mem_qstar)

theorem blocker_start_ne_right_start
    (B : ClaimB3FlexibleHillBracketAtomData inv C)
    {M : ClaimB2Atom I}
    (hM : M.qIndex = Q0.selectedColumn j')
    (hj' : j' ≠ C.col) :
    M.start ≠ B.rightAtom.start := by
  intro hEq
  have hne : M.qIndex ≠ B.rightAtom.qIndex :=
    B.middle_right_qIndex_ne hM hj'
  have hdisj :=
    Q0.qstar_nodeDisjoint_of_ne
      (i := M.qIndex) (j := B.rightAtom.qIndex)
      (hi := M.q_mem) (hj := B.rightAtom.q_mem) hne
  exact Finset.disjoint_left.mp hdisj M.start_mem_qstar
    (by simpa [hEq] using B.rightAtom.start_mem_qstar)

theorem blocker_stop_ne_left_stop
    (B : ClaimB3FlexibleHillBracketAtomData inv C)
    {M : ClaimB2Atom I}
    (hM : M.qIndex = Q0.selectedColumn j')
    (hj' : j' ≠ C.col) :
    M.stop ≠ B.leftAtom.stop := by
  intro hEq
  have hne : M.qIndex ≠ B.leftAtom.qIndex := by
    exact fun h => B.left_middle_qIndex_ne hM hj' h.symm
  have hdisj :=
    Q0.qstar_nodeDisjoint_of_ne
      (i := M.qIndex) (j := B.leftAtom.qIndex)
      (hi := M.q_mem) (hj := B.leftAtom.q_mem) hne
  exact Finset.disjoint_left.mp hdisj M.stop_mem_qstar
    (by simpa [hEq] using B.leftAtom.stop_mem_qstar)

theorem blocker_stop_ne_right_stop
    (B : ClaimB3FlexibleHillBracketAtomData inv C)
    {M : ClaimB2Atom I}
    (hM : M.qIndex = Q0.selectedColumn j')
    (hj' : j' ≠ C.col) :
    B.rightAtom.stop ≠ M.stop := by
  intro hEq
  have hne : M.qIndex ≠ B.rightAtom.qIndex :=
    B.middle_right_qIndex_ne hM hj'
  have hdisj :=
    Q0.qstar_nodeDisjoint_of_ne
      (i := M.qIndex) (j := B.rightAtom.qIndex)
      (hi := M.q_mem) (hj := B.rightAtom.q_mem) hne
  exact Finset.disjoint_left.mp hdisj M.stop_mem_qstar
    (by simpa [hEq] using B.rightAtom.stop_mem_qstar)

theorem blocker_stop_ne_left_start
    (B : ClaimB3FlexibleHillBracketAtomData inv C)
    {M : ClaimB2Atom I}
    (hM : M.qIndex = Q0.selectedColumn j')
    (hj' : j' ≠ C.col) :
    B.leftAtom.start ≠ M.stop := by
  intro hEq
  have hne : B.leftAtom.qIndex ≠ M.qIndex :=
    B.left_middle_qIndex_ne hM hj'
  have hdisj :=
    Q0.qstar_nodeDisjoint_of_ne
      (i := B.leftAtom.qIndex) (j := M.qIndex)
      (hi := B.leftAtom.q_mem) (hj := M.q_mem) hne
  exact Finset.disjoint_left.mp hdisj B.leftAtom.start_mem_qstar
    (by simpa [hEq] using M.stop_mem_qstar)

theorem blocker_stop_ne_right_start
    (B : ClaimB3FlexibleHillBracketAtomData inv C)
    {M : ClaimB2Atom I}
    (hM : M.qIndex = Q0.selectedColumn j')
    (hj' : j' ≠ C.col) :
    M.stop ≠ B.rightAtom.start := by
  intro hEq
  have hne : M.qIndex ≠ B.rightAtom.qIndex :=
    B.middle_right_qIndex_ne hM hj'
  have hdisj :=
    Q0.qstar_nodeDisjoint_of_ne
      (i := M.qIndex) (j := B.rightAtom.qIndex)
      (hi := M.q_mem) (hj := B.rightAtom.q_mem) hne
  exact Finset.disjoint_left.mp hdisj M.stop_mem_qstar
    (by simpa [hEq] using B.rightAtom.start_mem_qstar)

theorem blocker_start_ne_left_stop
    (B : ClaimB3FlexibleHillBracketAtomData inv C)
    {M : ClaimB2Atom I}
    (hM : M.qIndex = Q0.selectedColumn j')
    (hj' : j' ≠ C.col) :
    M.start ≠ B.leftAtom.stop := by
  intro hEq
  have hne : M.qIndex ≠ B.leftAtom.qIndex := by
    exact fun h => B.left_middle_qIndex_ne hM hj' h.symm
