/-- Page-60 orchestration when the local type-1 loop has already been
internalized as a single full-invariant step.

This is the narrowest remaining interface for the type-1 branch: for every
nonterminal invariant state, the caller supplies exactly the action outcome
that the bump/cross paragraphs prove, and the terminal branch supplies the
sparse-grid proof package.  The symmetric type-2 branch is still separate,
matching the paper's “without loss of generality” split. -/
theorem reroutingConclusion_of_page60_full_step_terminal_proof_data
    [Fintype V] {L : PerfectPathPacking G A B} {h : ℕ}
    (hbad : ¬ GoodLinkage L h)
    (hlink : NodeLinkedIn G Finset.univ A B)
    (hpos : 0 < h)
    (hstep :
      ∀ {R : IndexedAuxiliaryPrefix L h}
        {Q : PerfectPathPacking G R.X R.Y}
        (S : TypeOneIterationSetup R hpos Q)
        (I : IterationInput R hpos S.Q0)
        (_Inv : TypeOneFullIterationInvariants I),
          ¬ NoBumpNoCross I → FullInvariantSimplifyingActionOutcome I)
    (hterminal :
      ∀ {R : IndexedAuxiliaryPrefix L h}
        {Q : PerfectPathPacking G R.X R.Y}
        (S : TypeOneIterationSetup R hpos Q)
        (I : IterationInput R hpos S.Q0)
        (Inv : TypeOneFullIterationInvariants I),
          NoBumpNoCross I →
            TerminalSparseGridFullProofData (hpos := hpos) I Inv)
    (hTypeTwo :
      ∀ {R : IndexedAuxiliaryPrefix L h}
        {Q : PerfectPathPacking G R.X R.Y},
        TypeTwoIterationSetup R hpos Q → ReroutingConclusion G h L) :
    ReroutingConclusion G h L := by
  refine reroutingConclusion_of_page60_branch_handlers
    (L := L) (h := h) hbad hlink hpos ?_ hTypeTwo
  intro R Q S
  exact S.gridMinor_or_degree_drop_of_full_invariant_actions
    (fun I Inv hnot => hstep S I Inv hnot)
    (fun I Inv hterm => (hterminal S I Inv hterm).containsGridMinor hterm)

