/-- Terminal proof data for Claim B.3 with the paper hypotheses kept visible:
the bump/cross loop is terminal, the displayed rows are the chordless
auxiliary two-path, hill elimination is in normal form, and the two local
geometric steps turn a maximal non-convex trace into higher hill
candidates. -/
structure ClaimB3TerminalProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  terminal_noBumpNoCross : NoBumpNoCross I
  terminal_aux_noChord : TerminalRowsAuxNoChord I inv
  no_hill : ClaimB3NoHill I inv
  candidate_of_nonconvex_trace :
    (∃ i : Fin (z h), ∃ j : Fin h,
      Nonempty (ClaimB3NonconvexTrace I inv i j)) →
      Nonempty (ClaimB3HillCandidateData I inv)
  higher_candidate_of_blocker :
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          ∃ C' : ClaimB3HillCandidateData I inv, C.row.1 < C'.row.1

namespace ClaimB3TerminalProofData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Forget the visible terminal hypotheses down to the path-level
blocker/barrier package
that directly feeds the finite maximality argument. -/
def toPathBlockerBarrierCertificate
    (C : ClaimB3TerminalProofData I inv) :
    ClaimB3PathBlockerBarrierCertificate I inv where
  no_hill := C.no_hill
  candidate_of_nonconvex_trace := C.candidate_of_nonconvex_trace
  higher_candidate_of_blocker := C.higher_candidate_of_blocker

end ClaimB3TerminalProofData

/-- Claim B.3 from terminal no-bump/no-cross, auxiliary no-chord, no-hill, and
the two local geometric steps of the paper's Claim B.3 argument.  The
candidate-extraction hypothesis is stated for the existence of a non-convex
trace, because the paper chooses a maximal offending row before extracting the
local valley. -/
noncomputable def claimB3_pathIntersections_of_terminalProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (C : ClaimB3TerminalProofData I inv) :
    ClaimB3PathIntersections I inv :=
  claimB3_pathIntersections_of_pathBlockerBarrierCertificate
    C.toPathBlockerBarrierCertificate

/-- Connected-branch consequence of
`claimB3_pathIntersections_of_terminalProofData`. -/
theorem claimB3_connectedIntersections_of_terminalProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (C : ClaimB3TerminalProofData I inv) :
    ClaimB3ConnectedIntersections I inv :=
  ClaimB3ConnectedIntersections.of_pathIntersections
    (claimB3_pathIntersections_of_terminalProofData C)

/-! ### Terminal sparse-grid assembly

The terminal picture in Appendix B.1 gives a sparse-grid subdivision, not
literal edges between adjacent row-column intersections.  The sparse-grid path
certificate above is the minor-theoretic endpoint of that argument.  The
following terminal data keeps the certificate tied to the actual rows and
selected `Q*` paths of the iteration, and records the hill-normal hypotheses
from which Claim B.3 has already been proved. -/

/-- Embed one of the `h` retained terminal rows into the `z h = 2h` active
rows.  This is the final “delete the extra `h` rows” step of Appendix B.1. -/
def terminalTopRowIndex (h : ℕ) (r : Fin h) : Fin (z h) :=
  ⟨r.1, by
    have hr := r.2
    dsimp [z]
    omega⟩

/-- Sparse-grid path assembly from the terminal rows and selected
transversals.

Each valid sparse-grid port is mapped to a vertex lying in the corresponding
row/transversal intersection.  The `pathCert` fields realize all sparse-grid
edges by host paths; `branch_disjoint` is the usual disjointness check for the
allocated branch sets after suppressing those paths. -/
structure TerminalSparseGridAssemblyData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  pathCert : TerminalSparseGridPathCertificate G h
  port_mem_branch :
    ∀ x : SparseGrid.ValidVertex h,
      pathCert.image x ∈
        claimB3BranchSet I inv
          ⟨x.1.row.1, by
            have hr := x.1.row.2
            dsimp [z]
            omega⟩ x.1.col
  branch_disjoint :
    ∀ ⦃x y : SparseGrid.ValidVertex h⦄,
      x ≠ y →
        Disjoint (pathCert.orientedBranchSet x)
          (pathCert.orientedBranchSet y)

namespace TerminalSparseGridAssemblyData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Forget the row/transversal provenance and keep the minor-theoretic sparse
grid certificate. -/
noncomputable def toTerminalSparseGridTraceCertificate
    (D : TerminalSparseGridAssemblyData (hpos := hpos) I inv) :
    TerminalSparseGridTraceCertificate I where
  model :=
    { pathCert := D.pathCert
      branch_disjoint := D.branch_disjoint }

theorem containsGridMinor
    (D : TerminalSparseGridAssemblyData (hpos := hpos) I inv) :
    ContainsGridMinor G h :=
  D.toTerminalSparseGridTraceCertificate.containsGridMinor

end TerminalSparseGridAssemblyData

/-- Full terminal proof package for the type-1 branch.

The first five fields are exactly the flexible hill-normal proof of Claim B.3:
terminal no-bump/no-cross, no auxiliary row chord, no remaining hill, the
atomized row-contact traces, and the endpoint condition that the traces finish
at the bottom row.  The final field is the sparse-grid path assembly obtained
from the terminal row/transversal picture. -/
structure TerminalSparseGridProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  terminal_noBumpNoCross : NoBumpNoCross I
  terminal_aux_noChord : TerminalRowsAuxNoChord I inv
  no_hill : ClaimB3NoHill I inv
  atomized_trace : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv
  trace_last_zero :
    ∀ j : Fin h,
      ((atomized_trace.blocks j).blockRow
        ⟨(atomized_trace.blocks j).len, by omega⟩).1 = 0
  assembly : TerminalSparseGridAssemblyData (hpos := hpos) I inv

namespace TerminalSparseGridProofData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Claim B.3 is a theorem from the terminal proof data, not an extra
terminal assumption. -/
theorem claimB3ConnectedIntersections
    (D : TerminalSparseGridProofData (hpos := hpos) I inv) :
    ClaimB3ConnectedIntersections I inv :=
  claimB3_connectedIntersections_of_trace_valley_flexible
    D.terminal_noBumpNoCross D.terminal_aux_noChord D.no_hill
    D.atomized_trace D.trace_last_zero

/-- The terminal proof data proves the stronger path-shaped form of Claim
B.3.  The connected-intersection theorem above is only the consequence needed
by the older rectangular-grid API. -/
noncomputable def claimB3PathIntersections
    (D : TerminalSparseGridProofData (hpos := hpos) I inv) :
    ClaimB3PathIntersections I inv :=
  claimB3_pathIntersections_of_trace_valley_flexible
    D.terminal_noBumpNoCross D.terminal_aux_noChord D.no_hill
    D.atomized_trace D.trace_last_zero

/-- The same data gives the sparse-grid terminal certificate used by the
rerouting loop. -/
noncomputable def toTerminalSparseGridTraceCertificate
    (D : TerminalSparseGridProofData (hpos := hpos) I inv) :
    TerminalSparseGridTraceCertificate I :=
  D.assembly.toTerminalSparseGridTraceCertificate

theorem containsGridMinor
    (D : TerminalSparseGridProofData (hpos := hpos) I inv) :
    ContainsGridMinor G h :=
  D.toTerminalSparseGridTraceCertificate.containsGridMinor

end TerminalSparseGridProofData

/-- Terminal proof package for the full-invariant loop.

The no-chord hypothesis is intentionally absent: it is derived from
`Inv.active_aux`.  The caller still supplies the hill-normal and sparse-grid
assembly data produced after the terminal bump/cross state is reached. -/
structure TerminalSparseGridFullProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (Inv : TypeOneFullIterationInvariants I) where
  no_hill : ClaimB3NoHill I Inv.base
  atomized_trace :
    ClaimB3AtomizedTraceCompressionExtractionCertificate I Inv.base
  trace_last_zero :
    ∀ j : Fin h,
      ((atomized_trace.blocks j).blockRow
        ⟨(atomized_trace.blocks j).len, by omega⟩).1 = 0
  assembly : TerminalSparseGridAssemblyData (hpos := hpos) I Inv.base

namespace TerminalSparseGridFullProofData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {Inv : TypeOneFullIterationInvariants I}

/-- Convert the full-invariant terminal package to the older terminal package
by deriving the terminal auxiliary no-chord fact from `Inv.active_aux`. -/
def toTerminalSparseGridProofData
    (D : TerminalSparseGridFullProofData (hpos := hpos) I Inv)
    (hterm : NoBumpNoCross I) :
    TerminalSparseGridProofData (hpos := hpos) I Inv.base where
  terminal_noBumpNoCross := hterm
  terminal_aux_noChord :=
    Inv.active_aux.terminalRowsAuxNoChord
  no_hill := D.no_hill
  atomized_trace := D.atomized_trace
  trace_last_zero := D.trace_last_zero
  assembly := D.assembly

/-- Claim B.3 follows from the full-invariant terminal package, with the
auxiliary no-chord hypothesis derived from `Inv.active_aux`. -/
theorem claimB3ConnectedIntersections
    (D : TerminalSparseGridFullProofData (hpos := hpos) I Inv)
    (hterm : NoBumpNoCross I) :
    ClaimB3ConnectedIntersections I Inv.base :=
  (D.toTerminalSparseGridProofData hterm).claimB3ConnectedIntersections

/-- Full-invariant terminal data also proves the path-shaped Claim B.3 once
the bump/cross loop is in a no-bump/no-cross state. -/
noncomputable def claimB3PathIntersections
    (D : TerminalSparseGridFullProofData (hpos := hpos) I Inv)
    (hterm : NoBumpNoCross I) :
    ClaimB3PathIntersections I Inv.base :=
  (D.toTerminalSparseGridProofData hterm).claimB3PathIntersections

/-- Forget the terminal proof internals down to the sparse-grid trace
certificate consumed by the minor construction. -/
noncomputable def toTerminalSparseGridTraceCertificate
    (D : TerminalSparseGridFullProofData (hpos := hpos) I Inv) :
    TerminalSparseGridTraceCertificate I :=
  D.assembly.toTerminalSparseGridTraceCertificate

/-- The full-invariant terminal package contains the desired grid minor once
the bump/cross loop has reached a no-bump/no-cross state. -/
theorem containsGridMinor
    (D : TerminalSparseGridFullProofData (hpos := hpos) I Inv)
    (_hterm : NoBumpNoCross I) :
    ContainsGridMinor G h :=
  D.toTerminalSparseGridTraceCertificate.containsGridMinor

end TerminalSparseGridFullProofData

/-- Hill-elimination proof data for the sparse-grid terminal route.

This is the sparse-grid analogue of `TerminalPathHillEliminationData`.  A
state records the current post-bump/cross terminal picture during hill
elimination; every nonterminal state admits a hill replacement with strictly
smaller natural measure, and every terminal state supplies the full sparse-grid
terminal package. -/
structure TerminalSparseGridFullHillEliminationData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (Inv : TypeOneFullIterationInvariants I) where
  State : Type u
  initial : State
  measure : State → ℕ
  Terminal : State → Prop
  step :
    ∀ s : State, ¬ Terminal s →
      ∃ s' : State, measure s' < measure s
  terminalData :
    ∀ s : State, Terminal s →
      TerminalSparseGridFullProofData (hpos := hpos) I Inv

namespace TerminalSparseGridFullHillEliminationData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {Inv : TypeOneFullIterationInvariants I}

/-- Execute the terminal hill-elimination descent in the sparse-grid route. -/
noncomputable def toTerminalSparseGridFullProofData
    (D : TerminalSparseGridFullHillEliminationData (hpos := hpos) I Inv) :
    TerminalSparseGridFullProofData (hpos := hpos) I Inv := by
  classical
  let H : ∃ s : D.State, D.Terminal s :=
    exists_terminal_of_nat_descent D.measure D.Terminal D.step D.initial
  exact D.terminalData (Classical.choose H) (Classical.choose_spec H)

/-- Sparse-grid terminal hill elimination directly gives the grid minor. -/
theorem containsGridMinor
    (D : TerminalSparseGridFullHillEliminationData (hpos := hpos) I Inv)
    (hterm : NoBumpNoCross I) :
    ContainsGridMinor G h :=
  D.toTerminalSparseGridFullProofData.containsGridMinor hterm

/-- A completed sparse-grid terminal package is a degenerate one-state
hill-elimination proof. -/
noncomputable def ofTerminalData
    (D : TerminalSparseGridFullProofData (hpos := hpos) I Inv) :
    TerminalSparseGridFullHillEliminationData (hpos := hpos) I Inv where
  State := PUnit
  initial := PUnit.unit
  measure := fun _ => 0
  Terminal := fun _ => True
  step := by
    intro s hterm
    exact False.elim (hterm trivial)
  terminalData := by
    intro s hterm
    exact D

end TerminalSparseGridFullHillEliminationData

/-- Terminal proof package for the future-clean loop invariant.

This is the terminal interface that matches the paper-level loop invariant:
the current invariant already knows that future row-clean `Q₀` subsegments are
clean in the whole linkage, so Claim B.3 is obtained through
`ClaimB3FutureCleanTerminalEndpointProofData` instead of requiring the caller to
prepackage atomized traces.  The sparse-grid assembly remains the explicit
minor model built after Claim B.3. -/
structure TerminalSparseGridFutureCleanProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I) where
  no_hill : ClaimB3NoHill I Inv.base
  trace_first_max :
    ∀ hterm : NoBumpNoCross I,
      let S : ClaimB2PlanarStripCertificate I Inv.base :=
        claimB2_planarStripCertificate_of_noBumpNoCross
          Inv.extended.full.active_aux.terminalRowsAuxNoChord hterm
      let hclean : ClaimB3AllConsecutiveContactSegmentsLinkageClean I Inv.base :=
        claimB3AllConsecutiveContactSegmentsLinkageClean_of_futureFullClean
          Inv.future_segments_clean
      let trace : ∀ j : Fin h, ClaimB3RowContactTrace I Inv.base j :=
        claimB3RowContactTraceOfLinkageClean S hclean
      ∀ j : Fin h, ∀ k : Fin ((trace j).len + 1),
        ((trace j).row k).1 ≤ ((trace j).row ⟨0, by omega⟩).1
  higher_hill_data_of_blocker :
    ∀ C : ClaimB3HillCandidateData I Inv.base,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I Inv.base j').vertexSet →
          Nonempty (ClaimB3HigherHillFromBlockerData Inv.base C j')
  assembly : TerminalSparseGridAssemblyData (hpos := hpos) I Inv.base

namespace TerminalSparseGridFutureCleanProofData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {Inv : TypeOneExtendedFutureCleanIterationInvariants I}

/-- Convert the future-clean terminal package to the dedicated Claim B.3
future-clean proof data. -/
noncomputable def toClaimB3FutureCleanTerminalEndpointProofData
    (D : TerminalSparseGridFutureCleanProofData (hpos := hpos) I Inv)
