sparse-grid proof package.

The conversion below turns these replacement-row hit facts into the synthetic
successor traces required by the current local-update wrappers. -/
structure TheoremB1Page60PaperSparseFullProofDataTypeTwoInputByReplacementHits
    [Fintype V]
    {G : _root_.SimpleGraph V} {A B : Finset V}
    (L : PerfectPathPacking G A B) (h : ℕ) (hpos : 0 < h) where
  hbump_replacementHit :
    ∀ {R : IndexedAuxiliaryPrefix L h}
      {Q : PerfectPathPacking G R.X R.Y}
      (S : TypeOneIterationSetup R hpos Q)
      {I : IterationInput R hpos S.Q0}
      (_Inv : TypeOneExtendedFutureCleanIterationInvariants I)
      (Bump : BumpWitness I),
        ∀ i : Q.Index, ∀ hi : i ∈ S.Q0.indices,
          HitsGraphPath (S.Q0.data i hi).qstar Bump.replacementPath.path
  hcross_leftReplacementHit :
    ∀ {R : IndexedAuxiliaryPrefix L h}
      {Q : PerfectPathPacking G R.X R.Y}
      (S : TypeOneIterationSetup R hpos Q)
      {I : IterationInput R hpos S.Q0}
      (_Inv : TypeOneExtendedFutureCleanIterationInvariants I)
      (Cross : CrossWitness I),
        ∀ i : Q.Index, ∀ hi : i ∈ S.Q0.indices,
          HitsGraphPath (S.Q0.data i hi).qstar
            Cross.replacementPaths.leftPath
  hcross_rightReplacementHit :
    ∀ {R : IndexedAuxiliaryPrefix L h}
      {Q : PerfectPathPacking G R.X R.Y}
      (S : TypeOneIterationSetup R hpos Q)
      {I : IterationInput R hpos S.Q0}
      (_Inv : TypeOneExtendedFutureCleanIterationInvariants I)
      (Cross : CrossWitness I),
        ∀ i : Q.Index, ∀ hi : i ∈ S.Q0.indices,
          HitsGraphPath (S.Q0.data i hi).qstar
            Cross.replacementPaths.rightPath
  hterminal :
    ∀ {R : IndexedAuxiliaryPrefix L h}
      {Q : PerfectPathPacking G R.X R.Y}
      (S : TypeOneIterationSetup R hpos Q)
      (I : IterationInput R hpos S.Q0)
      (Inv : TypeOneExtendedFutureCleanIterationInvariants I),
        NoBumpNoCross I →
          TerminalSparseGridFullProofData (hpos := hpos) I Inv.extended.full
  hTypeTwo :
    ∀ {R : IndexedAuxiliaryPrefix L h}
      {Q : PerfectPathPacking G R.X R.Y},
      TypeTwoIterationSetup R hpos Q → ReroutingConclusion G h L

