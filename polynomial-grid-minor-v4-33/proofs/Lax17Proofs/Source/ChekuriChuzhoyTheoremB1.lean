/-- Self-contained construction of the type-1 branch data from a complete
contact trace, once the last middle-boundary hit is known to lie on
`P_{z+1}`. -/
noncomputable def typeOneLastHitBranchData_of_completeTrace
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    (T : CompleteLinkageContactTrace R Q)
    (hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty)
    (hend : T.toLinkageContactTrace.EndsIn R.block4IndexSet)
    (hsource :
      (middleBoundarySuffix (L := L) R hpos Q hmid).source ∈
        (L.path (R.pZPlusOneIndex hpos)).vertexSet) :
    TypeOneLastHitBranchData R hpos Q hmid := by
  classical
  let hp0 :=
    middleBoundarySuffix_hits_p0_of_source_pZPlusOne
      (L := L) (R := R) (hpos := hpos) T hmid hend hsource
  exact {
    hp0 := hp0
    hits_block1 :=
      typeOneQStarFromLastFirst_hits_block1_of_completeTrace
        (L := L) (R := R) (hpos := hpos) T hmid hsource hp0
    avoids_other_linkage :=
      typeOneQStarFromLastFirst_avoids_other_linkage_of_completeTrace
        (L := L) (R := R) (hpos := hpos) T hmid hsource hp0
  }

