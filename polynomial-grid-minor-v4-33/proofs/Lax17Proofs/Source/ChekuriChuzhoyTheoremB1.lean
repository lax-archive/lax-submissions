/-- Outside-neighbor data for the endpoints of a Figure 8 local quadruple.

For a local block `A -- rowLeft -- rowRight -- D`, the finite-graph
left-to-right cross dichotomy needs an old neighbor of `A` outside the
quadruple and an old neighbor of `D` outside the quadruple. -/
structure EndpointOutsideNeighborData
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Cross : CrossWitness I)
    (auxA auxD : I.linkage.Index) where
  auxL : I.linkage.Index
  auxR : I.linkage.Index
  left_adj_auxL : (linkageAuxGraph I.linkage).Adj auxA auxL
  right_adj_auxR : (linkageAuxGraph I.linkage).Adj auxD auxR
  auxL_not :
    auxL ∉ ({auxA, I.rowIndex Cross.rowLeft,
      I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index)
  auxR_not :
    auxR ∉ ({auxA, I.rowIndex Cross.rowLeft,
      I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index)
  auxL_ne_leftRow : auxL ≠ I.rowIndex Cross.rowLeft
  auxR_ne_rightRow : auxR ≠ I.rowIndex Cross.rowRight
  auxL_ne_auxD : auxL ≠ auxD

/-- All old auxiliary-graph data needed for the finite Figure 8 local
dichotomy.

The fields are intentionally the arguments of
`paperActionUpdate_of_localDegreeTest_constructedSuccessor_byLeftLocalRightAttachments`:
the record packages the two outside endpoint neighbors, the old local path
`A--U--V--D`, degree-two facts, and the distinctness facts needed by degree
saturation. -/
structure CrossLocalOutsideData
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Cross : CrossWitness I) where
  auxL : I.linkage.Index
  auxA : I.linkage.Index
  auxD : I.linkage.Index
  auxR : I.linkage.Index
  hLA_old : (linkageAuxGraph I.linkage).Adj auxA auxL
  hAU_old :
    (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Cross.rowLeft)
  hUV_old :
    (linkageAuxGraph I.linkage).Adj
      (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
  hVD_old :
    (linkageAuxGraph I.linkage).Adj
      (I.rowIndex Cross.rowRight) auxD
  hDR_old : (linkageAuxGraph I.linkage).Adj auxD auxR
  hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2
  hU_old :
    DegreeEquals (linkageAuxGraph I.linkage)
      (I.rowIndex Cross.rowLeft) 2
  hV_old :
    DegreeEquals (linkageAuxGraph I.linkage)
      (I.rowIndex Cross.rowRight) 2
  hD_old : DegreeEquals (linkageAuxGraph I.linkage) auxD 2
  hL_not :
    auxL ∉ ({auxA, I.rowIndex Cross.rowLeft,
      I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index)
