        Or.resolve_left (Cross.old_rows_forward_or_backward Inv) hforward
      exact D.hcross_backwardLocalOutside S Inv Cross hbackward
  hcross_leftReplacementHit := D.hcross_leftReplacementHit
  hcross_rightReplacementHit := D.hcross_rightReplacementHit
  hterminal := D.hterminal
