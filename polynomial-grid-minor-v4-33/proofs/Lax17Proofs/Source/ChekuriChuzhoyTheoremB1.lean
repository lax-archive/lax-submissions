/-- A single-path version of the paper's last-middle-boundary case split. -/
structure LastHitBranchData
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h)
    (Q : GraphPath G) where
  hmid :
    (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty
  type_one :
    (middleBoundarySuffix (L := L) R hpos Q hmid).source ∈
        (L.path (R.pZPlusOneIndex hpos)).vertexSet →
      TypeOneLastHitBranchData R hpos Q hmid
  type_two :
    (middleBoundarySuffix (L := L) R hpos Q hmid).source ∈
        (L.path (R.pTwoZIndex hpos)).vertexSet →
      TypeTwoLastHitBranchData R hpos Q hmid

/-- A complete page-59 contact trace supplies all data for the paper's split
according to the last hit of `P_{z+1} ∪ P_{2z}`.  This closes the local
extraction up to the line before “A bump”: the middle boundary is forced by
the second-to-fourth block trace, and the two possible last-hit branches were
proved separately above. -/
noncomputable def lastHitBranchData_of_completeTrace
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    (T : CompleteLinkageContactTrace R Q)
    (hstart : T.toLinkageContactTrace.StartsIn R.block2IndexSet)
    (hend : T.toLinkageContactTrace.EndsIn R.block4IndexSet) :
    LastHitBranchData R hpos Q := by
  classical
  have hhit :
      HitsLinkagePath Q (R.pZPlusOneIndex hpos) ∨
        HitsLinkagePath Q (R.pTwoZIndex hpos) :=
    T.toLinkageContactTrace.hitsMiddleBoundary_of_startsIn_block2_endsIn_block4
      hstart hend
  have hmid :
      (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty := by
    rcases hhit with hz | h2z
    · rcases hz with ⟨v, hv⟩
      rcases Finset.mem_inter.1 hv with ⟨hvQ, hvP⟩
      exact ⟨v, Finset.mem_inter.2
        ⟨hvQ, pZPlusOne_vertexSet_subset_middleBoundaryVertexSet
          (L := L) R hpos hvP⟩⟩
    · rcases h2z with ⟨v, hv⟩
      rcases Finset.mem_inter.1 hv with ⟨hvQ, hvP⟩
      exact ⟨v, Finset.mem_inter.2
        ⟨hvQ, pTwoZ_vertexSet_subset_middleBoundaryVertexSet
          (L := L) R hpos hvP⟩⟩
  exact {
    hmid := hmid
    type_one := fun hsource =>
      typeOneLastHitBranchData_of_completeTrace
        (L := L) (R := R) (hpos := hpos) T hmid hend hsource
    type_two := fun hsource =>
      typeTwoLastHitBranchData_of_completeTrace
        (L := L) (R := R) (hpos := hpos) T hmid hend hsource
  }

/-- The last middle-boundary vertex is on `P_{z+1}` or on `P_{2z}`, so branch
data for those two cases gives the pathwise type-1/type-2 alternative. -/
theorem lastFirstWitness_dichotomy_of_lastHitBranchData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    (D : LastHitBranchData R hpos Q) :
    Nonempty (TypeOneLastFirstWitness R hpos Q) ∨
      Nonempty (TypeTwoLastFirstWitness R hpos Q) := by
  rcases middleBoundarySuffix_source_mem_pZPlusOne_or_pTwoZ
      (L := L) R hpos Q D.hmid with hv1 | hv2
  · exact Or.inl ⟨(D.type_one hv1).toWitness hv1⟩
  · exact Or.inr ⟨(D.type_two hv2).toWitness hv2⟩

/-- The last/first-hit construction in the type-1 branch gives exactly the
`Q*` segment required by the page-60 majority argument. -/
theorem hasTypeOneQStarSegment_of_lastFirstWitness
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    (W : TypeOneLastFirstWitness R hpos Q) :
    HasTypeOneQStarSegment R hpos Q := by
  classical
  let suffix : GraphPath G :=
    middleBoundarySuffix (L := L) R hpos Q W.hmid
  let qstar : GraphPath G :=
    typeOneQStarFromLastFirst (L := L) R hpos Q W.hmid W.hp0
  have hqstar_def :
      qstar = suffix.cleanPrefixToSet (L.path R.p0Index).vertexSet W.hp0 := rfl
  have hsub_suffix : qstar.vertexSet ⊆ suffix.vertexSet := by
    intro v hv
    simpa [qstar, typeOneQStarFromLastFirst, suffix] using
      (suffix.cleanPrefixToSet_vertexSet_subset
        (L.path R.p0Index).vertexSet W.hp0 hv)
  have hsub_Q : qstar.vertexSet ⊆ Q.vertexSet := by
    intro v hv
    exact Q.cleanSuffixFromSet_vertexSet_subset
      (middleBoundaryVertexSet (L := L) R hpos) W.hmid (hsub_suffix hv)
  have hsource :
      qstar.source ∈ (L.path (R.pZPlusOneIndex hpos)).vertexSet := by
    simpa [qstar, typeOneQStarFromLastFirst, suffix] using
      W.last_mem_PzPlusOne
  have htarget :
      qstar.target ∈ (L.path R.p0Index).vertexSet := by
    simpa [qstar, typeOneQStarFromLastFirst, suffix] using
      suffix.cleanPrefixToSet_target_mem (L.path R.p0Index).vertexSet W.hp0
  have huniq0 :
      (qstar.vertexSet ∩ (L.path R.p0Index).vertexSet).card = 1 := by
    have hleft :
        (L.path R.p0Index).vertexSet ∩ qstar.vertexSet =
          {qstar.target} := by
      simpa [qstar, typeOneQStarFromLastFirst, suffix] using
        suffix.cleanPrefixToSet_inter_eq_singleton_target
          (L.path R.p0Index).vertexSet W.hp0
    have hright :
        qstar.vertexSet ∩ (L.path R.p0Index).vertexSet =
          {qstar.target} := by
      rw [Finset.inter_comm]
      exact hleft
    rw [hright]
    simp
  have huniqz :
      (qstar.vertexSet ∩
        (L.path (R.pZPlusOneIndex hpos)).vertexSet).card = 1 := by
    have hsuffix :
        middleBoundaryVertexSet (L := L) R hpos ∩ suffix.vertexSet =
          {suffix.source} := by
      simpa [suffix, middleBoundarySuffix] using
        Q.cleanSuffixFromSet_inter_eq_singleton_source
          (middleBoundaryVertexSet (L := L) R hpos) W.hmid
    have hset :
        qstar.vertexSet ∩
            (L.path (R.pZPlusOneIndex hpos)).vertexSet =
          {qstar.source} := by
      ext v
      constructor
      · intro hv
        rcases Finset.mem_inter.1 hv with ⟨hvq, hvP⟩
        have hvSuffix : v ∈ suffix.vertexSet := hsub_suffix hvq
        have hvMid :
            v ∈ middleBoundaryVertexSet (L := L) R hpos :=
          pZPlusOne_vertexSet_subset_middleBoundaryVertexSet
            (L := L) R hpos hvP
        have hvSingle : v ∈ ({suffix.source} : Finset V) := by
          rw [← hsuffix]
          exact Finset.mem_inter.2 ⟨hvMid, hvSuffix⟩
        have hvEq : v = suffix.source := by simpa using hvSingle
        have hsource_eq : qstar.source = suffix.source := rfl
        simpa [hsource_eq] using hvEq
      · intro hv
        have hvEq : v = qstar.source := by simpa using hv
        subst hvEq
        exact Finset.mem_inter.2
          ⟨GraphPath.source_mem_vertexSet qstar, hsource⟩
    rw [hset]
    simp
  exact ⟨qstar, hsub_Q, hsource, htarget, W.hits_block1,
    W.avoids_other_linkage, huniq0, huniqz⟩

/-- The type-2 last/first-hit construction gives the corresponding `Q*`
segment. -/
theorem hasTypeTwoQStarSegment_of_lastFirstWitness
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    (W : TypeTwoLastFirstWitness R hpos Q) :
    HasTypeTwoQStarSegment R hpos Q := by
  classical
  let suffix : GraphPath G :=
    middleBoundarySuffix (L := L) R hpos Q W.hmid
  let qstar : GraphPath G :=
    typeTwoQStarFromLastFirst (L := L) R hpos Q W.hmid W.hp3
  have hsub_suffix : qstar.vertexSet ⊆ suffix.vertexSet := by
    intro v hv
    simpa [qstar, typeTwoQStarFromLastFirst, suffix] using
      (suffix.cleanPrefixToSet_vertexSet_subset
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet W.hp3 hv)
  have hsub_Q : qstar.vertexSet ⊆ Q.vertexSet := by
    intro v hv
    exact Q.cleanSuffixFromSet_vertexSet_subset
      (middleBoundaryVertexSet (L := L) R hpos) W.hmid (hsub_suffix hv)
  have hsource :
      qstar.source ∈ (L.path (R.pTwoZIndex hpos)).vertexSet := by
    simpa [qstar, typeTwoQStarFromLastFirst, suffix] using
      W.last_mem_PtwoZ
  have htarget :
      qstar.target ∈
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet := by
    simpa [qstar, typeTwoQStarFromLastFirst, suffix] using
      suffix.cleanPrefixToSet_target_mem
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet W.hp3
  have huniq3 :
      (qstar.vertexSet ∩
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet).card = 1 := by
    have hleft :
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet ∩
            qstar.vertexSet =
          {qstar.target} := by
      simpa [qstar, typeTwoQStarFromLastFirst, suffix] using
        suffix.cleanPrefixToSet_inter_eq_singleton_target
          (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet W.hp3
    have hright :
        qstar.vertexSet ∩
            (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet =
          {qstar.target} := by
      rw [Finset.inter_comm]
      exact hleft
    rw [hright]
    simp
  have huniq2 :
      (qstar.vertexSet ∩
        (L.path (R.pTwoZIndex hpos)).vertexSet).card = 1 := by
    have hsuffix :
        middleBoundaryVertexSet (L := L) R hpos ∩ suffix.vertexSet =
          {suffix.source} := by
      simpa [suffix, middleBoundarySuffix] using
        Q.cleanSuffixFromSet_inter_eq_singleton_source
          (middleBoundaryVertexSet (L := L) R hpos) W.hmid
    have hset :
        qstar.vertexSet ∩
            (L.path (R.pTwoZIndex hpos)).vertexSet =
          {qstar.source} := by
      ext v
      constructor
      · intro hv
        rcases Finset.mem_inter.1 hv with ⟨hvq, hvP⟩
        have hvSuffix : v ∈ suffix.vertexSet := hsub_suffix hvq
        have hvMid :
            v ∈ middleBoundaryVertexSet (L := L) R hpos :=
          pTwoZ_vertexSet_subset_middleBoundaryVertexSet
            (L := L) R hpos hvP
        have hvSingle : v ∈ ({suffix.source} : Finset V) := by
          rw [← hsuffix]
          exact Finset.mem_inter.2 ⟨hvMid, hvSuffix⟩
        have hvEq : v = suffix.source := by simpa using hvSingle
        have hsource_eq : qstar.source = suffix.source := rfl
        simpa [hsource_eq] using hvEq
      · intro hv
        have hvEq : v = qstar.source := by simpa using hv
        subst hvEq
        exact Finset.mem_inter.2
          ⟨GraphPath.source_mem_vertexSet qstar, hsource⟩
    rw [hset]
    simp
  exact ⟨qstar, hsub_Q, hsource, htarget, W.hits_block3,
    W.avoids_other_linkage, huniq2, huniq3⟩

/-- Pathwise last/first-hit classification: each transversal path has either
the type-1 or type-2 page-59 construction.  This is closer to the paper than
the older ordered-segment interface: it explicitly stores the last contact
with `P_{z+1} ∪ P_{2z}` and the first later contact with the appropriate
boundary path. -/
def PathwiseLastFirstClassification
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h)
    (Q : PerfectPathPacking G R.X R.Y) : Prop :=
  ∀ i : Q.Index,
    Nonempty (TypeOneLastFirstWitness R hpos (Q.path i)) ∨
      Nonempty (TypeTwoLastFirstWitness R hpos (Q.path i))

/-- Pathwise branch data for the page-59 last-boundary split. -/
def PathwiseLastHitBranchData
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h)
    (Q : PerfectPathPacking G R.X R.Y) : Prop :=
  ∀ i : Q.Index, LastHitBranchData R hpos (Q.path i)

/-- Pathwise branch data yields the last/first-hit classification. -/
theorem pathwiseLastFirstClassification_of_lastHitBranchData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (h : PathwiseLastHitBranchData R hpos Q) :
    PathwiseLastFirstClassification R hpos Q := by
  intro i
  exact lastFirstWitness_dichotomy_of_lastHitBranchData (h i)

/-- Ordered-contact witness for a type-1 segment: the contact on
`P_{z+1}` occurs before the contact on `P_0`, and the intervening segment is
already certified to have the exact allowed linkage intersections from the
paper. -/
def HasTypeOneOrderedSegmentWitness (R : IndexedAuxiliaryPrefix L h)
    (hpos : 0 < h) (Q : GraphPath G) : Prop :=
  ∃ a b : V, ∃ hab : Q.Before a b,
    a ∈ (L.path (R.pZPlusOneIndex hpos)).vertexSet ∧
      b ∈ (L.path R.p0Index).vertexSet ∧
        R.HitsBlock1 (Q.segmentOfBefore hab) ∧
          (∀ j : L.Index, j ∉ typeOneAllowedIndexSet R hpos →
            Disjoint (Q.segmentOfBefore hab).vertexSet (L.path j).vertexSet) ∧
            ((Q.segmentOfBefore hab).vertexSet ∩
              (L.path R.p0Index).vertexSet).card = 1 ∧
              ((Q.segmentOfBefore hab).vertexSet ∩
                (L.path (R.pZPlusOneIndex hpos)).vertexSet).card = 1

/-- Ordered-contact witness for a type-2 segment. -/
def HasTypeTwoOrderedSegmentWitness (R : IndexedAuxiliaryPrefix L h)
    (hpos : 0 < h) (Q : GraphPath G) : Prop :=
  ∃ a b : V, ∃ hab : Q.Before a b,
    a ∈ (L.path (R.pTwoZIndex hpos)).vertexSet ∧
      b ∈ (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet ∧
        R.HitsBlock3 (Q.segmentOfBefore hab) ∧
          (∀ j : L.Index, j ∉ typeTwoAllowedIndexSet R hpos →
            Disjoint (Q.segmentOfBefore hab).vertexSet (L.path j).vertexSet) ∧
            ((Q.segmentOfBefore hab).vertexSet ∩
              (L.path (R.pTwoZIndex hpos)).vertexSet).card = 1 ∧
              ((Q.segmentOfBefore hab).vertexSet ∩
                (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet).card = 1

/-- An ordered type-1 witness gives the corresponding clean-segment
classification. -/
theorem hasTypeOneQStarSegment_of_orderedSegmentWitness
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    (h : HasTypeOneOrderedSegmentWitness R hpos Q) :
    HasTypeOneQStarSegment R hpos Q := by
  rcases h with ⟨a, b, hab, ha, hb, hhits, havoid, huniq0, huniqz⟩
  exact ⟨Q.segmentOfBefore hab,
    Q.segmentOfBefore_vertexSet_subset hab,
    by simpa using ha,
    by simpa using hb,
    hhits,
    havoid,
    huniq0,
    huniqz⟩

/-- An ordered type-2 witness gives the corresponding clean-segment
classification. -/
theorem hasTypeTwoQStarSegment_of_orderedSegmentWitness
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    (h : HasTypeTwoOrderedSegmentWitness R hpos Q) :
    HasTypeTwoQStarSegment R hpos Q := by
  rcases h with ⟨a, b, hab, ha, hb, hhits, havoid, huniq2z, huniq3z1⟩
  exact ⟨Q.segmentOfBefore hab,
    Q.segmentOfBefore_vertexSet_subset hab,
    by simpa using ha,
    by simpa using hb,
    hhits,
    havoid,
    huniq2z,
    huniq3z1⟩

/-- A type-1 `Q*` segment gives the full type-1 `Q*` certificate. -/
theorem exists_typeOneQStarData_of_qstarSegment
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    (h : HasTypeOneQStarSegment R hpos Q) :
    Nonempty (TypeOneQStarData R hpos Q) := by
  rcases h with
    ⟨qstar, hsub, hsource, htarget, hhits, havoid, huniq0, huniqz⟩
  exact ⟨{
    v := qstar.source
    u := qstar.target
    v_mem_Q := hsub (GraphPath.source_mem_vertexSet qstar)
    v_mem_PzPlusOne := hsource
    u_mem_Q := hsub (GraphPath.target_mem_vertexSet qstar)
    u_mem_P0 := htarget
    qstar := qstar
    qstar_source_eq_v := rfl
    qstar_target_eq_u := rfl
    qstar_subset_Q := hsub
    qstar_hits_block1 := hhits
    qstar_hits_P0 := ⟨qstar.target, Finset.mem_inter.2
      ⟨GraphPath.target_mem_vertexSet qstar, htarget⟩⟩
    qstar_hits_PzPlusOne := ⟨qstar.source, Finset.mem_inter.2
      ⟨GraphPath.source_mem_vertexSet qstar, hsource⟩⟩
    qstar_avoids_other_linkage := havoid
    qstar_unique_P0 := huniq0
    qstar_unique_PzPlusOne := huniqz }⟩

/-- A type-2 `Q*` segment gives the full type-2 `Q*` certificate. -/
theorem exists_typeTwoQStarData_of_qstarSegment
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    (h : HasTypeTwoQStarSegment R hpos Q) :
    Nonempty (TypeTwoQStarData R hpos Q) := by
  rcases h with
    ⟨qstar, hsub, hsource, htarget, hhits, havoid, huniq2z, huniq3z1⟩
  exact ⟨{
    v := qstar.source
    u := qstar.target
    v_mem_Q := hsub (GraphPath.source_mem_vertexSet qstar)
    v_mem_PtwoZ := hsource
    u_mem_Q := hsub (GraphPath.target_mem_vertexSet qstar)
    u_mem_PthreeZPlusOne := htarget
    qstar := qstar
    qstar_source_eq_v := rfl
    qstar_target_eq_u := rfl
    qstar_subset_Q := hsub
    qstar_hits_block3 := hhits
    qstar_hits_PtwoZ := ⟨qstar.source, Finset.mem_inter.2
      ⟨GraphPath.source_mem_vertexSet qstar, hsource⟩⟩
    qstar_hits_PthreeZPlusOne := ⟨qstar.target, Finset.mem_inter.2
      ⟨GraphPath.target_mem_vertexSet qstar, htarget⟩⟩
    qstar_avoids_other_linkage := havoid
    qstar_unique_PtwoZ := huniq2z
    qstar_unique_PthreeZPlusOne := huniq3z1 }⟩

/-- Segment-extraction form of the pathwise classification.  This is the
remaining geometric/path-ordering work after the endpoint-clean packaging has
been isolated. -/
def PathwiseCleanSegmentClassification
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h)
    (Q : PerfectPathPacking G R.X R.Y) : Prop :=
  ∀ i : Q.Index,
    HasTypeOneQStarSegment R hpos (Q.path i) ∨
      HasTypeTwoQStarSegment R hpos (Q.path i)

/-- Last/first-hit classification implies the `Q*` segment classification. -/
theorem pathwiseCleanSegmentClassification_of_lastFirstClassification
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (h : PathwiseLastFirstClassification R hpos Q) :
    PathwiseCleanSegmentClassification R hpos Q := by
  intro i
  rcases h i with h1 | h2
  · rcases h1 with ⟨W⟩
    exact Or.inl (hasTypeOneQStarSegment_of_lastFirstWitness W)
  · rcases h2 with ⟨W⟩
    exact Or.inr (hasTypeTwoQStarSegment_of_lastFirstWitness W)

/-- Ordered-segment form of the pathwise classification: for every
transversal path we have already found the ordered pair of contacts whose
intervening segment is the desired `Q*`. -/
def PathwiseOrderedSegmentClassification
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h)
    (Q : PerfectPathPacking G R.X R.Y) : Prop :=
  ∀ i : Q.Index,
    HasTypeOneOrderedSegmentWitness R hpos (Q.path i) ∨
      HasTypeTwoOrderedSegmentWitness R hpos (Q.path i)

/-- Ordered-segment classification implies clean-segment classification. -/
theorem pathwiseCleanSegmentClassification_of_orderedSegmentClassification
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (h : PathwiseOrderedSegmentClassification R hpos Q) :
    PathwiseCleanSegmentClassification R hpos Q := by
  intro i
  rcases h i with h1 | h2
  · exact Or.inl (hasTypeOneQStarSegment_of_orderedSegmentWitness h1)
  · exact Or.inr (hasTypeTwoQStarSegment_of_orderedSegmentWitness h2)

namespace TypeOneQStarData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Qpath : GraphPath G}

/-- A type-1 `Q*` certificate implies that the original transversal path hits
every linkage path in the first block. -/
theorem hitsBlock1 (D : TypeOneQStarData R hpos Qpath) :
    R.HitsBlock1 Qpath := by
  intro i
  exact HitsLinkagePath.mono_left D.qstar_subset_Q (D.qstar_hits_block1 i)

/-- A type-1 `Q*` certificate implies that the original transversal path hits
the type-1 middle boundary `P_{z+1}`. -/
theorem hitsMiddleBoundary (D : TypeOneQStarData R hpos Qpath) :
    HitsMiddleBoundary R hpos Qpath := by
  exact Or.inl
    (HitsLinkagePath.mono_left D.qstar_subset_Q D.qstar_hits_PzPlusOne)

/-- A type-1 `Q*` certificate gives the first half of the page-59 block
dichotomy. -/
theorem page59BlockDichotomy (D : TypeOneQStarData R hpos Qpath) :
    Page59BlockDichotomy R Qpath := by
  exact Or.inl D.hitsBlock1

end TypeOneQStarData

namespace TypeTwoQStarData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Qpath : GraphPath G}

/-- A type-2 `Q*` certificate implies that the original transversal path hits
every linkage path in the third block. -/
theorem hitsBlock3 (D : TypeTwoQStarData R hpos Qpath) :
    R.HitsBlock3 Qpath := by
  intro i
  exact HitsLinkagePath.mono_left D.qstar_subset_Q (D.qstar_hits_block3 i)

/-- A type-2 `Q*` certificate implies that the original transversal path hits
the type-2 middle boundary `P_{2z}`. -/
theorem hitsMiddleBoundary (D : TypeTwoQStarData R hpos Qpath) :
    HitsMiddleBoundary R hpos Qpath := by
  exact Or.inr
    (HitsLinkagePath.mono_left D.qstar_subset_Q D.qstar_hits_PtwoZ)

/-- A type-2 `Q*` certificate gives the second half of the page-59 block
dichotomy. -/
theorem page59BlockDichotomy (D : TypeTwoQStarData R hpos Qpath) :
    Page59BlockDichotomy R Qpath := by
  exact Or.inr D.hitsBlock3

end TypeTwoQStarData

/-- The type-1/type-2 pathwise classification implies exactly the block
dichotomy stated in the proof. -/
theorem page59BlockDichotomy_of_type_dichotomy
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Qpath : GraphPath G}
    (h :
      Nonempty (TypeOneQStarData R hpos Qpath) ∨
        Nonempty (TypeTwoQStarData R hpos Qpath)) :
    Page59BlockDichotomy R Qpath := by
  rcases h with h1 | h2
  · rcases h1 with ⟨D⟩
    exact D.page59BlockDichotomy
  · rcases h2 with ⟨D⟩
    exact D.page59BlockDichotomy

/-- The type-1/type-2 pathwise classification also implies the middle-boundary
hit used to define the last such vertex `v`. -/
theorem hitsMiddleBoundary_of_type_dichotomy
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Qpath : GraphPath G}
    (h :
      Nonempty (TypeOneQStarData R hpos Qpath) ∨
        Nonempty (TypeTwoQStarData R hpos Qpath)) :
    HitsMiddleBoundary R hpos Qpath := by
  rcases h with h1 | h2
  · rcases h1 with ⟨D⟩
    exact D.hitsMiddleBoundary
  · rcases h2 with ⟨D⟩
    exact D.hitsMiddleBoundary

/-- The pathwise page-60 statement for a fixed transversal packing: every
transversal path has either the type-1 or the type-2 `Q*` segment described in
the proof.  The preceding lemmas now derive this from the more faithful
last/first-hit branch data. -/
def PathwiseTypeClassification
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h)
    (Q : PerfectPathPacking G R.X R.Y) : Prop :=
  ∀ i : Q.Index,
    Nonempty (TypeOneQStarData R hpos (Q.path i)) ∨
      Nonempty (TypeTwoQStarData R hpos (Q.path i))

/-- Clean-segment classification implies the `Q*`-data classification used by
the page-60 selection and majority argument. -/
theorem pathwiseTypeClassification_of_cleanSegmentClassification
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (h : PathwiseCleanSegmentClassification R hpos Q) :
    PathwiseTypeClassification R hpos Q := by
  intro i
  rcases h i with h1 | h2
  · exact Or.inl (exists_typeOneQStarData_of_qstarSegment h1)
  · exact Or.inr (exists_typeTwoQStarData_of_qstarSegment h2)

/-- Last/first-hit classification directly gives the type data used by the
majority split. -/
theorem pathwiseTypeClassification_of_lastFirstClassification
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (h : PathwiseLastFirstClassification R hpos Q) :
    PathwiseTypeClassification R hpos Q := by
  exact pathwiseTypeClassification_of_cleanSegmentClassification
    (pathwiseCleanSegmentClassification_of_lastFirstClassification h)

/-- Every transversal path has a displayed contact trace along the chosen
auxiliary prefix.  This is the trace-level statement preceding the actual
`Q*` subpath extraction. -/
def PathwiseDisplayedContactTraces
    (R : IndexedAuxiliaryPrefix L h)
    (Q : PerfectPathPacking G R.X R.Y) : Prop :=
  ∀ i : Q.Index, Nonempty (DisplayedContactTrace R (Q.path i))

/-- Every nontrivial transversal path has a complete linkage-contact trace.
This is the self-contained bookkeeping part of extracting the auxiliary walk
from the graph path. -/
theorem pathwiseCompleteContactTracesOfEndpointContacts
    {R : IndexedAuxiliaryPrefix L h}
    {Q : PerfectPathPacking G R.X R.Y}
    (hne : ∀ i : Q.Index, (Q.path i).source ≠ (Q.path i).target) :
    ∀ i : Q.Index, Nonempty (CompleteLinkageContactTrace R (Q.path i)) := by
  intro i
  rcases R.transversal_source_hits_block2 (Qpack := Q) i with
    ⟨jS, _hjS, hsource_j⟩
  rcases R.transversal_target_hits_block4 (Qpack := Q) i with
    ⟨jT, _hjT, htarget_j⟩
  have hsource :
      (Q.path i).source ∈ L.toPathPacking.vertexSet :=
    (L.toPathPacking.mem_vertexSet).2 ⟨jS, hsource_j⟩
  have htarget :
      (Q.path i).target ∈ L.toPathPacking.vertexSet :=
      (L.toPathPacking.mem_vertexSet).2 ⟨jT, htarget_j⟩
  exact ⟨completeLinkageContactTraceOfEndpointContacts R (Q.path i)
    hsource htarget (hne i)⟩

/-- In the actual first-paragraph setup, linkedness supplies the endpoint
disjointness needed to build complete linkage-contact traces for every
transversal path. -/
theorem pathwiseCompleteContactTracesOfEndpointContacts_of_linked [Fintype V]
    (hlink : NodeLinkedIn G Finset.univ A B)
    {R : IndexedAuxiliaryPrefix L h}
    {Q : PerfectPathPacking G R.X R.Y} :
    ∀ i : Q.Index, Nonempty (CompleteLinkageContactTrace R (Q.path i)) := by
  exact pathwiseCompleteContactTracesOfEndpointContacts
    (fun i => R.transversal_source_ne_target hlink i)

/-- The fully proved page-59 setup below the final `Q*` branch extraction.
It contains the displayed auxiliary prefix, the transversal packing from `X`
to `Y`, and for every transversal path the complete clean linkage-contact
trace extracted from its ordered list of linkage contacts. -/
structure Page59CompleteTraceSetup [Fintype V]
    (L : PerfectPathPacking G A B) (h : ℕ) where
  R : IndexedAuxiliaryPrefix L h
  Q : PerfectPathPacking G R.X R.Y
  Q_card : Q.card = z h
  Q_staysIn_univ : Q.toPathPacking.StaysIn Finset.univ
  trace : ∀ i : Q.Index, CompleteLinkageContactTrace R (Q.path i)
  trace_startsIn_block2 :
    ∀ i : Q.Index, (trace i).toLinkageContactTrace.StartsIn R.block2IndexSet
  trace_endsIn_block4 :
    ∀ i : Q.Index, (trace i).toLinkageContactTrace.EndsIn R.block4IndexSet

/-- Self-contained construction of the complete page-59 trace setup from the
first paragraph of Appendix B.1.  No pathwise type classification is assumed
here: the only inputs are the bad linkage and linkedness of `A,B`. -/
theorem exists_page59CompleteTraceSetup [Fintype V]
    {L : PerfectPathPacking G A B} {h : ℕ}
    (hbad : ¬ GoodLinkage L h)
    (hlink : NodeLinkedIn G Finset.univ A B) :
    Nonempty (Page59CompleteTraceSetup L h) := by
  classical
  rcases exists_firstParagraph_setup (L := L) (h := h) hbad hlink with
    ⟨R, Q, hQcard, hQstay⟩
  let trace : ∀ i : Q.Index, CompleteLinkageContactTrace R (Q.path i) :=
    fun i =>
      Classical.choice
        (pathwiseCompleteContactTracesOfEndpointContacts_of_linked
          (L := L) (h := h) hlink (R := R) (Q := Q) i)
  have hstart :
      ∀ i : Q.Index,
        (trace i).toLinkageContactTrace.StartsIn R.block2IndexSet := by
    intro i
    exact LinkageContactTrace.startsIn_block2_of_transversal
      (R := R) (Qpack := Q) i (trace i).toLinkageContactTrace
  have hend :
      ∀ i : Q.Index,
        (trace i).toLinkageContactTrace.EndsIn R.block4IndexSet := by
    intro i
    exact LinkageContactTrace.endsIn_block4_of_transversal
      (R := R) (Qpack := Q) i (trace i).toLinkageContactTrace
  exact ⟨{
    R := R
    Q := Q
    Q_card := hQcard
    Q_staysIn_univ := hQstay
    trace := trace
    trace_startsIn_block2 := hstart
    trace_endsIn_block4 := hend
  }⟩

/-- The complete page-59 trace setup already contains enough information to
perform the last-middle-boundary split path by path. -/
noncomputable def Page59CompleteTraceSetup.pathwiseLastHitBranchData
    [Fintype V] {L : PerfectPathPacking G A B} {h : ℕ}
    (S : Page59CompleteTraceSetup L h) (hpos : 0 < h) :
    PathwiseLastHitBranchData S.R hpos S.Q := by
  intro i
  exact lastHitBranchData_of_completeTrace
    (L := L) (R := S.R) (hpos := hpos) (S.trace i)
    (S.trace_startsIn_block2 i) (S.trace_endsIn_block4 i)

/-- Displayed contact traces already prove the page-59 block dichotomy and the
middle-boundary hit for every path of the transversal packing.  The remaining
work in `PathwiseTypeClassification` is precisely to trim each such path to
the `Q*` segment with the required uniqueness and avoidance properties. -/
theorem pathwise_page59_consequences_of_displayed_traces
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (htrace : PathwiseDisplayedContactTraces R Q) :
    ∀ i : Q.Index,
      Page59BlockDichotomy R (Q.path i) ∧
        HitsMiddleBoundary R hpos (Q.path i) := by
  intro i
  rcases htrace i with ⟨T⟩
  have hstart :
      T.toLinkageContactTrace.StartsIn R.block2IndexSet :=
    LinkageContactTrace.startsIn_block2_of_transversal (R := R) (Qpack := Q)
      i T.toLinkageContactTrace
  have hend :
      T.toLinkageContactTrace.EndsIn R.block4IndexSet :=
    LinkageContactTrace.endsIn_block4_of_transversal (R := R) (Qpack := Q)
      i T.toLinkageContactTrace
  exact ⟨T.page59BlockDichotomy_of_startsIn_block2_endsIn_block4 hstart hend,
    T.hitsMiddleBoundary_of_startsIn_block2_endsIn_block4 hstart hend⟩

/-- A typed transversal system records, for every path in `Q`, whether the
page-60 construction is type 1 or type 2 and stores the corresponding `Q*`
certificate. -/
structure TypedTransversalSystem (R : IndexedAuxiliaryPrefix L h)
    (hpos : 0 < h) (Q : PerfectPathPacking G R.X R.Y) where
  kind : Q.Index → Bool
  type_one_data :
    ∀ i : Q.Index, kind i = true → TypeOneQStarData R hpos (Q.path i)
  type_two_data :
    ∀ i : Q.Index, kind i = false → TypeTwoQStarData R hpos (Q.path i)

/-- If every transversal path has been classified by the page-60 construction
as type 1 or type 2, choose these classifications simultaneously. -/
noncomputable def TypedTransversalSystem.of_pathwise_dichotomy
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h)
    (Q : PerfectPathPacking G R.X R.Y)
    (hpath : PathwiseTypeClassification R hpos Q) :
    TypedTransversalSystem R hpos Q where
  kind i := by
    classical
    exact if Nonempty (TypeOneQStarData R hpos (Q.path i)) then true else false
  type_one_data := by
    classical
    intro i hi
    change
      (if Nonempty (TypeOneQStarData R hpos (Q.path i)) then true else false) =
        true at hi
    by_cases h1 : Nonempty (TypeOneQStarData R hpos (Q.path i))
    · exact Classical.choice h1
    · simp [h1] at hi
  type_two_data := by
    classical
    intro i hi
    change
      (if Nonempty (TypeOneQStarData R hpos (Q.path i)) then true else false) =
        false at hi
    by_cases h1 : Nonempty (TypeOneQStarData R hpos (Q.path i))
    · simp [h1] at hi
    · have h2 : Nonempty (TypeTwoQStarData R hpos (Q.path i)) := by
        rcases hpath i with h1' | h2
        · exact False.elim (h1 h1')
        · exact h2
      exact Classical.choice h2

namespace TypedTransversalSystem

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}

/-- The indices of the transversal paths classified as type 1. -/
noncomputable def typeOneIndexSet (T : TypedTransversalSystem R hpos Q) :
    Finset Q.Index :=
  Finset.univ.filter fun i : Q.Index => T.kind i = true

/-- The indices of the transversal paths classified as type 2. -/
noncomputable def typeTwoIndexSet (T : TypedTransversalSystem R hpos Q) :
    Finset Q.Index :=
  Finset.univ.filter fun i : Q.Index => T.kind i = false

theorem typeOne_mem_kind {T : TypedTransversalSystem R hpos Q}
    {i : Q.Index} (hi : i ∈ T.typeOneIndexSet) :
    T.kind i = true := by
  exact (Finset.mem_filter.mp hi).2

theorem typeTwo_mem_kind {T : TypedTransversalSystem R hpos Q}
    {i : Q.Index} (hi : i ∈ T.typeTwoIndexSet) :
    T.kind i = false := by
  exact (Finset.mem_filter.mp hi).2

/-- Type 1 and type 2 indices partition the transversal system. -/
theorem type_card_sum (T : TypedTransversalSystem R hpos Q) :
    T.typeOneIndexSet.card + T.typeTwoIndexSet.card = Q.card := by
  classical
  have hsplit :=
    Finset.card_filter_add_card_filter_not
      (s := (Finset.univ : Finset Q.Index))
      (p := fun i : Q.Index => T.kind i = true)
  rw [PerfectPathPacking.card]
  simpa [typeOneIndexSet, typeTwoIndexSet] using hsplit

end TypedTransversalSystem

/-- The selected family `Q0` in the type-1 majority case, represented by the
indices of the original transversal paths and their `Q*` subpath data. -/
structure TypeOneQStarFamily (R : IndexedAuxiliaryPrefix L h)
    (hpos : 0 < h) (Q : PerfectPathPacking G R.X R.Y) where
  indices : Finset Q.Index
  data : ∀ i : Q.Index, i ∈ indices → TypeOneQStarData R hpos (Q.path i)
  large : h ≤ indices.card

/-- The analogous selected family in the type-2 majority case.  The paper
chooses the type-1 case without loss of generality; this structure records the
alternative branch. -/
structure TypeTwoQStarFamily (R : IndexedAuxiliaryPrefix L h)
    (hpos : 0 < h) (Q : PerfectPathPacking G R.X R.Y) where
  indices : Finset Q.Index
  data : ∀ i : Q.Index, i ∈ indices → TypeTwoQStarData R hpos (Q.path i)
  large : h ≤ indices.card

namespace TypedTransversalSystem

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}

/-- Package the type-1 side of the dichotomy as the family `Q0`. -/
noncomputable def toTypeOneFamily (T : TypedTransversalSystem R hpos Q)
    (hlarge : h ≤ T.typeOneIndexSet.card) :
    TypeOneQStarFamily R hpos Q where
  indices := T.typeOneIndexSet
  data := by
    intro i hi
    exact T.type_one_data i (typeOne_mem_kind hi)
  large := hlarge

/-- Package the type-2 side of the dichotomy. -/
noncomputable def toTypeTwoFamily (T : TypedTransversalSystem R hpos Q)
    (hlarge : h ≤ T.typeTwoIndexSet.card) :
    TypeTwoQStarFamily R hpos Q where
  indices := T.typeTwoIndexSet
  data := by
    intro i hi
    exact T.type_two_data i (typeTwo_mem_kind hi)
  large := hlarge

/-- The page-60 counting sentence: since `|Q| = z = 2h`, at least half the
transversal paths have the same type. -/
theorem majority_type_dichotomy (T : TypedTransversalSystem R hpos Q)
    (hQcard : Q.card = z h) :
    h ≤ T.typeOneIndexSet.card ∨ h ≤ T.typeTwoIndexSet.card := by
  classical
  by_cases hone : h ≤ T.typeOneIndexSet.card
  · exact Or.inl hone
  · right
    have hlt : T.typeOneIndexSet.card < h := Nat.lt_of_not_ge hone
    have hsum := T.type_card_sum
    have hsum_two :
        T.typeOneIndexSet.card + T.typeTwoIndexSet.card = 2 * h := by
      rw [hsum, hQcard, z]
    omega

/-- A constructive version of the "without loss of generality" split: either
we obtain the type-1 family used in the rest of the proof, or the symmetric
type-2 family. -/
theorem exists_large_uniform_qstar_family
    (T : TypedTransversalSystem R hpos Q) (hQcard : Q.card = z h) :
    Nonempty (TypeOneQStarFamily R hpos Q) ∨
      Nonempty (TypeTwoQStarFamily R hpos Q) := by
  rcases T.majority_type_dichotomy hQcard with hlarge | hlarge
  · exact Or.inl ⟨T.toTypeOneFamily hlarge⟩
  · exact Or.inr ⟨T.toTypeTwoFamily hlarge⟩

end TypedTransversalSystem

namespace TypeOneQStarFamily

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}

/-- The edge set of the fixed family `Q0` of type-1 subpaths. -/
noncomputable def edgeSet (F : TypeOneQStarFamily R hpos Q) :
    Finset (Sym2 V) :=
  F.indices.attach.biUnion fun i => (F.data i.1 i.2).qstar.edgeSet

theorem mem_edgeSet_iff
    (F : TypeOneQStarFamily R hpos Q) {e : Sym2 V} :
    e ∈ F.edgeSet ↔
      ∃ i : Q.Index, ∃ hi : i ∈ F.indices,
        e ∈ (F.data i hi).qstar.edgeSet := by
  classical
  constructor
  · intro he
    rw [edgeSet] at he
    rcases Finset.mem_biUnion.1 he with
      ⟨i, _hi, hei⟩
    exact ⟨i.1, i.2, hei⟩
  · rintro ⟨i, hi, hei⟩
    rw [edgeSet]
    exact Finset.mem_biUnion.2
      ⟨⟨i, hi⟩, Finset.mem_attach _ _, hei⟩

/-- Distinct selected `Q*` paths are vertex-disjoint because they are
subpaths of distinct paths in the original transversal packing `Q`. -/
theorem qstar_nodeDisjoint_of_ne
    (F : TypeOneQStarFamily R hpos Q)
    {i j : Q.Index} {hi : i ∈ F.indices} {hj : j ∈ F.indices}
    (hne : i ≠ j) :
    (F.data i hi).qstar.NodeDisjoint (F.data j hj).qstar := by
  rw [GraphPath.NodeDisjoint, Finset.disjoint_left]
  intro v hvi hvj
  have hviQ : v ∈ (Q.path i).vertexSet :=
    (F.data i hi).qstar_subset_Q hvi
  have hvjQ : v ∈ (Q.path j).vertexSet :=
    (F.data j hj).qstar_subset_Q hvj
  exact Finset.disjoint_left.mp (Q.toPathPacking.node_disjoint hne)
    hviQ hvjQ

/-- The selected `Q*` data is proof-irrelevant in its membership proof once
the underlying path-packing index is fixed. -/
theorem qstar_vertexSet_eq_of_index_eq
    (F : TypeOneQStarFamily R hpos Q)
    {i j : Q.Index} {hi : i ∈ F.indices} {hj : j ∈ F.indices}
    (hij : i = j) :
    (F.data i hi).qstar.vertexSet = (F.data j hj).qstar.vertexSet := by
  subst j
  simp

/-- The invariant about the initial `Q0`: every selected subpath hits all
paths in `P_1 ∪ {P_0, P_{z+1}}` and avoids every other original linkage path. -/
def InitialIntersectionInvariant (F : TypeOneQStarFamily R hpos Q) : Prop :=
  ∀ i : Q.Index, ∀ hi : i ∈ F.indices,
    let D := F.data i hi;
    R.HitsBlock1 D.qstar ∧
      HitsLinkagePath D.qstar R.p0Index ∧
        HitsLinkagePath D.qstar (R.pZPlusOneIndex hpos) ∧
          ∀ j : L.Index, j ∉ typeOneAllowedIndexSet R hpos →
            Disjoint D.qstar.vertexSet (L.path j).vertexSet

theorem initialIntersectionInvariant
    (F : TypeOneQStarFamily R hpos Q) :
    F.InitialIntersectionInvariant := by
  intro i hi
  exact ⟨(F.data i hi).qstar_hits_block1,
    (F.data i hi).qstar_hits_P0,
    (F.data i hi).qstar_hits_PzPlusOne,
    (F.data i hi).qstar_avoids_other_linkage⟩

end TypeOneQStarFamily

/-- The concrete invariant about the fixed type-1 family `Q0` and a current
row family.  This is the non-opaque version of the page-60 sentence saying
that every fixed `Q*` intersects every current row, also intersects `P_0` and
`P_{z+1}`, and avoids every linkage path outside
`P_1 ∪ {P_0, P_{z+1}}`. -/
def TypeOneCurrentRowsInvariant
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h)
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeOneQStarFamily R hpos Q)
    (Row : Type*) (rowPath : Row → GraphPath G) : Prop :=
  ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
    let D := Q0.data i hi
    (∀ r : Row, HitsGraphPath D.qstar (rowPath r)) ∧
      HitsLinkagePath D.qstar R.p0Index ∧
        HitsLinkagePath D.qstar (R.pZPlusOneIndex hpos) ∧
          ∀ j : L.Index, j ∉ typeOneAllowedIndexSet R hpos →
            Disjoint D.qstar.vertexSet (L.path j).vertexSet

/-- Strengthened current-row invariant for the type-1 branch.  In addition to
the paper's maintained row contacts and outside-linkage avoidance, this keeps
the uniqueness of the two boundary contacts of each fixed type-1 path `Q*`.
Those uniqueness facts are what make future row-clean subsegments avoid
`P₀` and `P_{z+1}` internally. -/
def TypeOneCurrentRowsFullInvariant
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h)
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeOneQStarFamily R hpos Q)
    (Row : Type*) (rowPath : Row → GraphPath G) : Prop :=
  ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
    let D := Q0.data i hi
    (∀ r : Row, HitsGraphPath D.qstar (rowPath r)) ∧
      HitsLinkagePath D.qstar R.p0Index ∧
        HitsLinkagePath D.qstar (R.pZPlusOneIndex hpos) ∧
          (∀ j : L.Index, j ∉ typeOneAllowedIndexSet R hpos →
            Disjoint D.qstar.vertexSet (L.path j).vertexSet) ∧
            (D.qstar.vertexSet ∩ (L.path R.p0Index).vertexSet).card = 1 ∧
              (D.qstar.vertexSet ∩
                (L.path (R.pZPlusOneIndex hpos)).vertexSet).card = 1

theorem TypeOneCurrentRowsFullInvariant.toCurrentRowsInvariant
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {Row : Type*} {rowPath : Row → GraphPath G}
    (H : TypeOneCurrentRowsFullInvariant R hpos Q0 Row rowPath) :
    TypeOneCurrentRowsInvariant R hpos Q0 Row rowPath := by
  intro i hi
  rcases H i hi with ⟨hrows, hp0, hpz, havoid, _huniq0, _huniqz⟩
  exact ⟨hrows, hp0, hpz, havoid⟩

/-- Fixed type-1 `Q*` paths have a unique contact with `P₀`, in the
pairwise-equality form that is useful for ruling out internal boundary
contacts. -/
theorem TypeOneQStarData.unique_P0_vertices
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Qpath : GraphPath G} (D : TypeOneQStarData R hpos Qpath)
    {v w : V} (hv : v ∈ D.qstar.vertexSet)
    (hp0v : v ∈ (L.path R.p0Index).vertexSet)
    (hw : w ∈ D.qstar.vertexSet)
    (hp0w : w ∈ (L.path R.p0Index).vertexSet) :
    v = w := by
  classical
  have hv_inter : v ∈ D.qstar.vertexSet ∩ (L.path R.p0Index).vertexSet :=
    Finset.mem_inter.2 ⟨hv, hp0v⟩
  have hw_inter : w ∈ D.qstar.vertexSet ∩ (L.path R.p0Index).vertexSet :=
    Finset.mem_inter.2 ⟨hw, hp0w⟩
  rcases Finset.card_eq_one.mp D.qstar_unique_P0 with ⟨x, hx⟩
  have hvx : v = x := by simpa [hx] using hv_inter
  have hwx : w = x := by simpa [hx] using hw_inter
  exact hvx.trans hwx.symm

/-- Fixed type-1 `Q*` paths have a unique contact with `P_{z+1}`. -/
theorem TypeOneQStarData.unique_PzPlusOne_vertices
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Qpath : GraphPath G} (D : TypeOneQStarData R hpos Qpath)
    {v w : V} (hv : v ∈ D.qstar.vertexSet)
    (hpzv : v ∈ (L.path (R.pZPlusOneIndex hpos)).vertexSet)
    (hw : w ∈ D.qstar.vertexSet)
    (hpzw : w ∈ (L.path (R.pZPlusOneIndex hpos)).vertexSet) :
    v = w := by
  classical
  have hv_inter :
      v ∈ D.qstar.vertexSet ∩
        (L.path (R.pZPlusOneIndex hpos)).vertexSet :=
    Finset.mem_inter.2 ⟨hv, hpzv⟩
  have hw_inter :
      w ∈ D.qstar.vertexSet ∩
        (L.path (R.pZPlusOneIndex hpos)).vertexSet := by
    exact Finset.mem_inter.2 ⟨hw, hpzw⟩
  rcases Finset.card_eq_one.mp D.qstar_unique_PzPlusOne with ⟨x, hx⟩
  have hvx : v = x := by simpa [hx] using hv_inter
  have hwx : w = x := by simpa [hx] using hw_inter
  exact hvx.trans hwx.symm

theorem TypeOneQStarData.qstar_target_mem_P0
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Qpath : GraphPath G} (D : TypeOneQStarData R hpos Qpath) :
    D.qstar.target ∈ (L.path R.p0Index).vertexSet := by
  simpa [D.qstar_target_eq_u] using D.u_mem_P0

theorem TypeOneQStarData.qstar_source_mem_PzPlusOne
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Qpath : GraphPath G} (D : TypeOneQStarData R hpos Qpath) :
    D.qstar.source ∈
      (L.path (R.pZPlusOneIndex hpos)).vertexSet := by
  simpa [D.qstar_source_eq_v] using D.v_mem_PzPlusOne

/-- The only `P₀` contact of a fixed type-1 `Q*` is its target, so `Q*` is
endpoint-clean with respect to `P₀`. -/
theorem TypeOneQStarData.internallyDisjointFrom_P0
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Qpath : GraphPath G} (D : TypeOneQStarData R hpos Qpath) :
    D.qstar.InternallyDisjointFromSet (L.path R.p0Index).vertexSet := by
  intro v hv hp0
  right
  exact D.unique_P0_vertices hv hp0
    (GraphPath.target_mem_vertexSet D.qstar) D.qstar_target_mem_P0

/-- The only `P_{z+1}` contact of a fixed type-1 `Q*` is its source. -/
theorem TypeOneQStarData.internallyDisjointFrom_PzPlusOne
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Qpath : GraphPath G} (D : TypeOneQStarData R hpos Qpath) :
    D.qstar.InternallyDisjointFromSet
      (L.path (R.pZPlusOneIndex hpos)).vertexSet := by
  intro v hv hpz
  left
  exact D.unique_PzPlusOne_vertices hv hpz
    (GraphPath.source_mem_vertexSet D.qstar) D.qstar_source_mem_PzPlusOne

/-- A fixed type-1 `Q*` is endpoint-clean with respect to the two boundary
paths `P₀` and `P_{z+1}`. -/
theorem TypeOneQStarData.internallyDisjointFrom_boundaries
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Qpath : GraphPath G} (D : TypeOneQStarData R hpos Qpath) :
    D.qstar.InternallyDisjointFromSet
      ((L.path R.p0Index).vertexSet ∪
        (L.path (R.pZPlusOneIndex hpos)).vertexSet) := by
  intro v hv hboundary
  rcases Finset.mem_union.1 hboundary with hp0 | hpz
  · exact D.internallyDisjointFrom_P0 hv hp0
  · exact D.internallyDisjointFrom_PzPlusOne hv hpz

/-- Fixed type-2 `Q*` paths have a unique contact with `P_{2z}`. -/
theorem TypeTwoQStarData.unique_PtwoZ_vertices
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Qpath : GraphPath G} (D : TypeTwoQStarData R hpos Qpath)
    {v w : V} (hv : v ∈ D.qstar.vertexSet)
    (hpv : v ∈ (L.path (R.pTwoZIndex hpos)).vertexSet)
    (hw : w ∈ D.qstar.vertexSet)
    (hpw : w ∈ (L.path (R.pTwoZIndex hpos)).vertexSet) :
    v = w := by
  classical
  have hv_inter :
      v ∈ D.qstar.vertexSet ∩
        (L.path (R.pTwoZIndex hpos)).vertexSet :=
    Finset.mem_inter.2 ⟨hv, hpv⟩
  have hw_inter :
      w ∈ D.qstar.vertexSet ∩
        (L.path (R.pTwoZIndex hpos)).vertexSet :=
    Finset.mem_inter.2 ⟨hw, hpw⟩
  rcases Finset.card_eq_one.mp D.qstar_unique_PtwoZ with ⟨x, hx⟩
  have hvx : v = x := by simpa [hx] using hv_inter
  have hwx : w = x := by simpa [hx] using hw_inter
  exact hvx.trans hwx.symm

/-- Fixed type-2 `Q*` paths have a unique contact with `P_{3z+1}`. -/
theorem TypeTwoQStarData.unique_PthreeZPlusOne_vertices
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Qpath : GraphPath G} (D : TypeTwoQStarData R hpos Qpath)
    {v w : V} (hv : v ∈ D.qstar.vertexSet)
    (hpv : v ∈ (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet)
    (hw : w ∈ D.qstar.vertexSet)
    (hpw : w ∈ (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet) :
    v = w := by
  classical
  have hv_inter :
      v ∈ D.qstar.vertexSet ∩
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet :=
    Finset.mem_inter.2 ⟨hv, hpv⟩
  have hw_inter :
      w ∈ D.qstar.vertexSet ∩
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet :=
    Finset.mem_inter.2 ⟨hw, hpw⟩
  rcases Finset.card_eq_one.mp D.qstar_unique_PthreeZPlusOne with ⟨x, hx⟩
  have hvx : v = x := by simpa [hx] using hv_inter
  have hwx : w = x := by simpa [hx] using hw_inter
  exact hvx.trans hwx.symm

theorem TypeTwoQStarData.qstar_source_mem_PtwoZ
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Qpath : GraphPath G} (D : TypeTwoQStarData R hpos Qpath) :
    D.qstar.source ∈ (L.path (R.pTwoZIndex hpos)).vertexSet := by
  simpa [D.qstar_source_eq_v] using D.v_mem_PtwoZ

theorem TypeTwoQStarData.qstar_target_mem_PthreeZPlusOne
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Qpath : GraphPath G} (D : TypeTwoQStarData R hpos Qpath) :
    D.qstar.target ∈
      (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet := by
  simpa [D.qstar_target_eq_u] using D.u_mem_PthreeZPlusOne

/-- The only `P_{2z}` contact of a fixed type-2 `Q*` is its source. -/
theorem TypeTwoQStarData.internallyDisjointFrom_PtwoZ
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Qpath : GraphPath G} (D : TypeTwoQStarData R hpos Qpath) :
    D.qstar.InternallyDisjointFromSet
      (L.path (R.pTwoZIndex hpos)).vertexSet := by
  intro v hv hp
  left
  exact D.unique_PtwoZ_vertices hv hp
    (GraphPath.source_mem_vertexSet D.qstar) D.qstar_source_mem_PtwoZ

/-- The only `P_{3z+1}` contact of a fixed type-2 `Q*` is its target. -/
theorem TypeTwoQStarData.internallyDisjointFrom_PthreeZPlusOne
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Qpath : GraphPath G} (D : TypeTwoQStarData R hpos Qpath) :
    D.qstar.InternallyDisjointFromSet
      (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet := by
  intro v hv hp
  right
  exact D.unique_PthreeZPlusOne_vertices hv hp
    (GraphPath.target_mem_vertexSet D.qstar)
    D.qstar_target_mem_PthreeZPlusOne

/-- A fixed type-2 `Q*` is endpoint-clean with respect to its two boundary
paths `P_{2z}` and `P_{3z+1}`. -/
theorem TypeTwoQStarData.internallyDisjointFrom_boundaries
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Qpath : GraphPath G} (D : TypeTwoQStarData R hpos Qpath) :
    D.qstar.InternallyDisjointFromSet
      ((L.path (R.pTwoZIndex hpos)).vertexSet ∪
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet) := by
  intro v hv hboundary
  rcases Finset.mem_union.1 hboundary with hp2 | hp3
  · exact D.internallyDisjointFrom_PtwoZ hv hp2
  · exact D.internallyDisjointFrom_PthreeZPlusOne hv hp3

namespace TypeOneQStarFamily

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}

/-- Choose exactly `h` fixed type-1 transversal subpaths from the large
family `Q0`.  These are the columns used in the terminal grid model. -/
noncomputable def selectedIndexSet
    (F : TypeOneQStarFamily R hpos Q) : Finset Q.Index :=
  Classical.choose (Finset.exists_subset_card_eq F.large)

/-- The selected terminal columns are drawn from the original large family. -/
theorem selectedIndexSet_subset_indices
    (F : TypeOneQStarFamily R hpos Q) :
    F.selectedIndexSet ⊆ F.indices :=
  (Classical.choose_spec (Finset.exists_subset_card_eq F.large)).1

/-- Exactly `h` terminal columns are selected. -/
theorem selectedIndexSet_card
    (F : TypeOneQStarFamily R hpos Q) :
    F.selectedIndexSet.card = h :=
  (Classical.choose_spec (Finset.exists_subset_card_eq F.large)).2

/-- The `Q*` certificate attached to a selected terminal column. -/
noncomputable def selectedData
    (F : TypeOneQStarFamily R hpos Q)
    (i : Q.Index) (hi : i ∈ F.selectedIndexSet) :
    TypeOneQStarData R hpos (Q.path i) :=
  F.data i (F.selectedIndexSet_subset_indices hi)

/-- Reindex the selected terminal columns by `Fin h`. -/
noncomputable def selectedColumnEquiv
    (F : TypeOneQStarFamily R hpos Q) :
    F.selectedIndexSet ≃ Fin h :=
  Finset.equivFinOfCardEq F.selectedIndexSet_card

/-- The `j`-th selected terminal column as an index of the original
transversal packing. -/
noncomputable def selectedColumn
    (F : TypeOneQStarFamily R hpos Q) (j : Fin h) : Q.Index :=
  ((F.selectedColumnEquiv).symm j).1

/-- The selected column really belongs to the exact-size selected set. -/
theorem selectedColumn_mem_selectedIndexSet
    (F : TypeOneQStarFamily R hpos Q) (j : Fin h) :
    F.selectedColumn j ∈ F.selectedIndexSet :=
  ((F.selectedColumnEquiv).symm j).2

/-- The selected column belongs to the original large type-1 family. -/
theorem selectedColumn_mem_indices
    (F : TypeOneQStarFamily R hpos Q) (j : Fin h) :
    F.selectedColumn j ∈ F.indices :=
  F.selectedIndexSet_subset_indices (F.selectedColumn_mem_selectedIndexSet j)

/-- Distinct `Fin h` labels select distinct original transversal paths. -/
theorem selectedColumn_injective
    (F : TypeOneQStarFamily R hpos Q) :
    Function.Injective F.selectedColumn := by
  intro j k hcols
  have hsub :
      (F.selectedColumnEquiv).symm j =
        (F.selectedColumnEquiv).symm k := by
    exact Subtype.ext hcols
  have hfin :=
    congrArg F.selectedColumnEquiv hsub
  simpa using hfin

/-- A selected `Q*` column is a subpath of its parent transversal path. -/
theorem selectedColumn_qstar_subset_parent
    (F : TypeOneQStarFamily R hpos Q) (j : Fin h) :
    (F.selectedData (F.selectedColumn j)
        (F.selectedColumn_mem_selectedIndexSet j)).qstar.vertexSet ⊆
      (Q.path (F.selectedColumn j)).vertexSet := by
  exact
    (F.selectedData (F.selectedColumn j)
      (F.selectedColumn_mem_selectedIndexSet j)).qstar_subset_Q

/-- The selected `Q*` columns are pairwise vertex-disjoint.  This is inherited
from the disjointness of the original transversal packing, because every
`Q*` is a subpath of its parent transversal. -/
theorem selectedColumn_qstar_nodeDisjoint
    (F : TypeOneQStarFamily R hpos Q) {j k : Fin h} (hjk : j ≠ k) :
    (F.selectedData (F.selectedColumn j)
        (F.selectedColumn_mem_selectedIndexSet j)).qstar.NodeDisjoint
      (F.selectedData (F.selectedColumn k)
        (F.selectedColumn_mem_selectedIndexSet k)).qstar := by
  classical
  rw [GraphPath.NodeDisjoint, Finset.disjoint_left]
  intro v hvj hvk
  let Dj :=
    F.selectedData (F.selectedColumn j)
      (F.selectedColumn_mem_selectedIndexSet j)
  let Dk :=
    F.selectedData (F.selectedColumn k)
      (F.selectedColumn_mem_selectedIndexSet k)
  have hvj_parent : v ∈ (Q.path (F.selectedColumn j)).vertexSet := by
    exact F.selectedColumn_qstar_subset_parent j hvj
  have hvk_parent : v ∈ (Q.path (F.selectedColumn k)).vertexSet := by
    exact F.selectedColumn_qstar_subset_parent k hvk
  have hcols_ne : F.selectedColumn j ≠ F.selectedColumn k := by
    intro hcols
    exact hjk (F.selectedColumn_injective hcols)
  exact Finset.disjoint_left.mp (Q.toPathPacking.node_disjoint hcols_ne)
    hvj_parent hvk_parent

/-- A selected terminal column hits every current row, by the maintained
type-1 row-intersection invariant. -/
theorem selectedColumn_hits_currentRow
    (F : TypeOneQStarFamily R hpos Q)
    {Row : Type*} {rowPath : Row → GraphPath G}
    (H : TypeOneCurrentRowsInvariant R hpos F Row rowPath)
    (j : Fin h) (r : Row) :
    HitsGraphPath
      (F.selectedData (F.selectedColumn j)
        (F.selectedColumn_mem_selectedIndexSet j)).qstar
      (rowPath r) := by
  exact (H (F.selectedColumn j)
    (F.selectedColumn_mem_indices j)).1 r

/-- A selected terminal column still hits the lower boundary row `P₀`. -/
theorem selectedColumn_hits_P0
    (F : TypeOneQStarFamily R hpos Q)
    {Row : Type*} {rowPath : Row → GraphPath G}
    (H : TypeOneCurrentRowsInvariant R hpos F Row rowPath)
    (j : Fin h) :
    HitsLinkagePath
      (F.selectedData (F.selectedColumn j)
        (F.selectedColumn_mem_selectedIndexSet j)).qstar
      R.p0Index := by
  exact (H (F.selectedColumn j)
    (F.selectedColumn_mem_indices j)).2.1

/-- A selected terminal column still hits the upper boundary row
`P_{z+1}`. -/
theorem selectedColumn_hits_PzPlusOne
    (F : TypeOneQStarFamily R hpos Q)
    {Row : Type*} {rowPath : Row → GraphPath G}
    (H : TypeOneCurrentRowsInvariant R hpos F Row rowPath)
    (j : Fin h) :
    HitsLinkagePath
      (F.selectedData (F.selectedColumn j)
        (F.selectedColumn_mem_selectedIndexSet j)).qstar
      (R.pZPlusOneIndex hpos) := by
  exact (H (F.selectedColumn j)
    (F.selectedColumn_mem_indices j)).2.2.1

/-- A selected terminal column avoids all original linkage paths outside the
type-1 block and its two boundary paths. -/
theorem selectedColumn_avoids_other_linkage
    (F : TypeOneQStarFamily R hpos Q)
    {Row : Type*} {rowPath : Row → GraphPath G}
    (H : TypeOneCurrentRowsInvariant R hpos F Row rowPath)
    (j : Fin h) :
    ∀ l : L.Index, l ∉ typeOneAllowedIndexSet R hpos →
      Disjoint
        (F.selectedData (F.selectedColumn j)
          (F.selectedColumn_mem_selectedIndexSet j)).qstar.vertexSet
        (L.path l).vertexSet := by
  exact (H (F.selectedColumn j)
    (F.selectedColumn_mem_indices j)).2.2.2

/-- A selected terminal column is endpoint-clean with respect to the two
fixed boundary linkage paths `P₀` and `P_{z+1}`. -/
theorem selectedColumn_internallyDisjointFrom_boundaries
    (F : TypeOneQStarFamily R hpos Q) (j : Fin h) :
    (F.selectedData (F.selectedColumn j)
      (F.selectedColumn_mem_selectedIndexSet j)).qstar.InternallyDisjointFromSet
      ((L.path R.p0Index).vertexSet ∪
        (L.path (R.pZPlusOneIndex hpos)).vertexSet) := by
  exact
    (F.selectedData (F.selectedColumn j)
      (F.selectedColumn_mem_selectedIndexSet j)).internallyDisjointFrom_boundaries

/-- The initial first-block rows satisfy the concrete current-row invariant for
the type-1 family selected on page 60. -/
theorem initialCurrentRowsInvariant
    (F : TypeOneQStarFamily R hpos Q) :
    TypeOneCurrentRowsInvariant R hpos F (Fin (z h))
      (fun i : Fin (z h) =>
        L.path (R.index (windowPos h 1 (by
          dsimp [z]
          omega) i))) := by
  intro i hi
  refine ⟨?_, (F.data i hi).qstar_hits_P0,
    (F.data i hi).qstar_hits_PzPlusOne,
    (F.data i hi).qstar_avoids_other_linkage⟩
  intro r
  exact (F.data i hi).qstar_hits_block1 r

/-- The initial type-1 rows satisfy the strengthened current-row invariant,
including the unique boundary contacts supplied by the `Q*` certificates. -/
theorem initialCurrentRowsFullInvariant
    (F : TypeOneQStarFamily R hpos Q) :
    TypeOneCurrentRowsFullInvariant R hpos F (Fin (z h))
      (fun i : Fin (z h) =>
        L.path (R.index (windowPos h 1 (by
          dsimp [z]
          omega) i))) := by
  intro i hi
  refine ⟨?_, (F.data i hi).qstar_hits_P0,
    (F.data i hi).qstar_hits_PzPlusOne,
    (F.data i hi).qstar_avoids_other_linkage,
    (F.data i hi).qstar_unique_P0,
    (F.data i hi).qstar_unique_PzPlusOne⟩
  intro r
  exact (F.data i hi).qstar_hits_block1 r

end TypeOneQStarFamily

/-- Symmetric current-row invariant for the type-2 majority branch: every
fixed `Q*` intersects each row of the third block, also intersects
`P_{2z}` and `P_{3z+1}`, and avoids every linkage path outside
`P_3 ∪ {P_{2z}, P_{3z+1}}`. -/
def TypeTwoCurrentRowsInvariant
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h)
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeTwoQStarFamily R hpos Q)
    (Row : Type*) (rowPath : Row → GraphPath G) : Prop :=
  ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
    let D := Q0.data i hi
    (∀ r : Row, HitsGraphPath D.qstar (rowPath r)) ∧
      HitsLinkagePath D.qstar (R.pTwoZIndex hpos) ∧
        HitsLinkagePath D.qstar (R.pThreeZPlusOneIndex hpos) ∧
          ∀ j : L.Index, j ∉ typeTwoAllowedIndexSet R hpos →
            Disjoint D.qstar.vertexSet (L.path j).vertexSet

/-- Strengthened current-row invariant for the symmetric type-2 branch.

This is the analogue of `TypeOneCurrentRowsFullInvariant`: besides the row
contacts and outside-linkage avoidance, each fixed type-2 `Q*` keeps a unique
contact with the two boundary rows `P_{2z}` and `P_{3z+1}`.  Those uniqueness
facts are the endpoint-clean input needed when future row-clean subsegments
are promoted to full-linkage-clean subsegments in the type-2 loop. -/
def TypeTwoCurrentRowsFullInvariant
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h)
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeTwoQStarFamily R hpos Q)
    (Row : Type*) (rowPath : Row → GraphPath G) : Prop :=
  ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
    let D := Q0.data i hi
    (∀ r : Row, HitsGraphPath D.qstar (rowPath r)) ∧
      HitsLinkagePath D.qstar (R.pTwoZIndex hpos) ∧
        HitsLinkagePath D.qstar (R.pThreeZPlusOneIndex hpos) ∧
          (∀ j : L.Index, j ∉ typeTwoAllowedIndexSet R hpos →
            Disjoint D.qstar.vertexSet (L.path j).vertexSet) ∧
            (D.qstar.vertexSet ∩
              (L.path (R.pTwoZIndex hpos)).vertexSet).card = 1 ∧
              (D.qstar.vertexSet ∩
                (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet).card = 1

theorem TypeTwoCurrentRowsFullInvariant.toCurrentRowsInvariant
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    {Row : Type*} {rowPath : Row → GraphPath G}
    (H : TypeTwoCurrentRowsFullInvariant R hpos Q0 Row rowPath) :
    TypeTwoCurrentRowsInvariant R hpos Q0 Row rowPath := by
  intro i hi
  rcases H i hi with ⟨hrows, hp2, hp3, havoid, _huniq2, _huniq3⟩
  exact ⟨hrows, hp2, hp3, havoid⟩

namespace TypeTwoQStarFamily

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}

/-- The edge set of the fixed family `Q0` of type-2 subpaths. -/
noncomputable def edgeSet (F : TypeTwoQStarFamily R hpos Q) :
    Finset (Sym2 V) :=
  F.indices.attach.biUnion fun i => (F.data i.1 i.2).qstar.edgeSet

theorem mem_edgeSet_iff
    (F : TypeTwoQStarFamily R hpos Q) {e : Sym2 V} :
    e ∈ F.edgeSet ↔
      ∃ i : Q.Index, ∃ hi : i ∈ F.indices,
        e ∈ (F.data i hi).qstar.edgeSet := by
  classical
  constructor
  · intro he
    rw [edgeSet] at he
    rcases Finset.mem_biUnion.1 he with
      ⟨i, _hi, hei⟩
    exact ⟨i.1, i.2, hei⟩
  · rintro ⟨i, hi, hei⟩
    rw [edgeSet]
    exact Finset.mem_biUnion.2
      ⟨⟨i, hi⟩, Finset.mem_attach _ _, hei⟩

/-- Distinct selected type-2 `Q*` paths are vertex-disjoint because they are
subpaths of distinct paths in the original transversal packing `Q`. -/
theorem qstar_nodeDisjoint_of_ne
    (F : TypeTwoQStarFamily R hpos Q)
    {i j : Q.Index} {hi : i ∈ F.indices} {hj : j ∈ F.indices}
    (hne : i ≠ j) :
    (F.data i hi).qstar.NodeDisjoint (F.data j hj).qstar := by
  rw [GraphPath.NodeDisjoint, Finset.disjoint_left]
  intro v hvi hvj
  have hviQ : v ∈ (Q.path i).vertexSet :=
    (F.data i hi).qstar_subset_Q hvi
  have hvjQ : v ∈ (Q.path j).vertexSet :=
    (F.data j hj).qstar_subset_Q hvj
  exact Finset.disjoint_left.mp (Q.toPathPacking.node_disjoint hne)
    hviQ hvjQ

/-- The selected type-2 `Q*` data is proof-irrelevant in its membership proof
once the underlying path-packing index is fixed. -/
theorem qstar_vertexSet_eq_of_index_eq
    (F : TypeTwoQStarFamily R hpos Q)
    {i j : Q.Index} {hi : i ∈ F.indices} {hj : j ∈ F.indices}
    (hij : i = j) :
    (F.data i hi).qstar.vertexSet = (F.data j hj).qstar.vertexSet := by
  subst j
  simp

/-- The invariant about the initial type-2 `Q0`: every selected subpath hits
all paths in `P₃ ∪ {P_{2z}, P_{3z+1}}` and avoids every other original
linkage path. -/
def InitialIntersectionInvariant (F : TypeTwoQStarFamily R hpos Q) : Prop :=
  ∀ i : Q.Index, ∀ hi : i ∈ F.indices,
    let D := F.data i hi;
    R.HitsBlock3 D.qstar ∧
      HitsLinkagePath D.qstar (R.pTwoZIndex hpos) ∧
        HitsLinkagePath D.qstar (R.pThreeZPlusOneIndex hpos) ∧
          ∀ j : L.Index, j ∉ typeTwoAllowedIndexSet R hpos →
            Disjoint D.qstar.vertexSet (L.path j).vertexSet

theorem initialIntersectionInvariant
    (F : TypeTwoQStarFamily R hpos Q) :
    F.InitialIntersectionInvariant := by
  intro i hi
  exact ⟨(F.data i hi).qstar_hits_block3,
    (F.data i hi).qstar_hits_PtwoZ,
    (F.data i hi).qstar_hits_PthreeZPlusOne,
    (F.data i hi).qstar_avoids_other_linkage⟩

/-- Choose exactly `h` fixed type-2 transversal subpaths from the large
family.  This is the symmetric analogue of the type-1 column selection. -/
noncomputable def selectedIndexSet
    (F : TypeTwoQStarFamily R hpos Q) : Finset Q.Index :=
  Classical.choose (Finset.exists_subset_card_eq F.large)

/-- The selected type-2 terminal columns come from the large type-2 family. -/
theorem selectedIndexSet_subset_indices
    (F : TypeTwoQStarFamily R hpos Q) :
    F.selectedIndexSet ⊆ F.indices :=
  (Classical.choose_spec (Finset.exists_subset_card_eq F.large)).1

/-- Exactly `h` type-2 terminal columns are selected. -/
theorem selectedIndexSet_card
    (F : TypeTwoQStarFamily R hpos Q) :
    F.selectedIndexSet.card = h :=
  (Classical.choose_spec (Finset.exists_subset_card_eq F.large)).2

/-- The `Q*` certificate attached to a selected type-2 terminal column. -/
noncomputable def selectedData
    (F : TypeTwoQStarFamily R hpos Q)
    (i : Q.Index) (hi : i ∈ F.selectedIndexSet) :
    TypeTwoQStarData R hpos (Q.path i) :=
  F.data i (F.selectedIndexSet_subset_indices hi)

/-- Reindex the selected type-2 terminal columns by `Fin h`. -/
noncomputable def selectedColumnEquiv
    (F : TypeTwoQStarFamily R hpos Q) :
    F.selectedIndexSet ≃ Fin h :=
  Finset.equivFinOfCardEq F.selectedIndexSet_card

/-- The `j`-th selected type-2 column as an index of the original transversal
packing. -/
noncomputable def selectedColumn
    (F : TypeTwoQStarFamily R hpos Q) (j : Fin h) : Q.Index :=
  ((F.selectedColumnEquiv).symm j).1

/-- The selected type-2 column belongs to the exact-size selected set. -/
theorem selectedColumn_mem_selectedIndexSet
    (F : TypeTwoQStarFamily R hpos Q) (j : Fin h) :
    F.selectedColumn j ∈ F.selectedIndexSet :=
  ((F.selectedColumnEquiv).symm j).2

/-- The selected type-2 column belongs to the large type-2 family. -/
theorem selectedColumn_mem_indices
    (F : TypeTwoQStarFamily R hpos Q) (j : Fin h) :
    F.selectedColumn j ∈ F.indices :=
  F.selectedIndexSet_subset_indices (F.selectedColumn_mem_selectedIndexSet j)

/-- Distinct `Fin h` labels select distinct type-2 transversal paths. -/
theorem selectedColumn_injective
    (F : TypeTwoQStarFamily R hpos Q) :
    Function.Injective F.selectedColumn := by
  intro j k hcols
  have hsub :
      (F.selectedColumnEquiv).symm j =
        (F.selectedColumnEquiv).symm k := by
    exact Subtype.ext hcols
  have hfin :=
    congrArg F.selectedColumnEquiv hsub
  simpa using hfin

/-- A selected type-2 `Q*` column is a subpath of its parent transversal. -/
theorem selectedColumn_qstar_subset_parent
    (F : TypeTwoQStarFamily R hpos Q) (j : Fin h) :
    (F.selectedData (F.selectedColumn j)
        (F.selectedColumn_mem_selectedIndexSet j)).qstar.vertexSet ⊆
      (Q.path (F.selectedColumn j)).vertexSet := by
  exact
    (F.selectedData (F.selectedColumn j)
      (F.selectedColumn_mem_selectedIndexSet j)).qstar_subset_Q

/-- The selected type-2 `Q*` columns are pairwise vertex-disjoint. -/
theorem selectedColumn_qstar_nodeDisjoint
    (F : TypeTwoQStarFamily R hpos Q) {j k : Fin h} (hjk : j ≠ k) :
    (F.selectedData (F.selectedColumn j)
        (F.selectedColumn_mem_selectedIndexSet j)).qstar.NodeDisjoint
      (F.selectedData (F.selectedColumn k)
        (F.selectedColumn_mem_selectedIndexSet k)).qstar := by
  classical
  rw [GraphPath.NodeDisjoint, Finset.disjoint_left]
  intro v hvj hvk
  have hvj_parent : v ∈ (Q.path (F.selectedColumn j)).vertexSet := by
    exact F.selectedColumn_qstar_subset_parent j hvj
  have hvk_parent : v ∈ (Q.path (F.selectedColumn k)).vertexSet := by
    exact F.selectedColumn_qstar_subset_parent k hvk
  have hcols_ne : F.selectedColumn j ≠ F.selectedColumn k := by
    intro hcols
    exact hjk (F.selectedColumn_injective hcols)
  exact Finset.disjoint_left.mp (Q.toPathPacking.node_disjoint hcols_ne)
    hvj_parent hvk_parent

/-- A selected type-2 terminal column hits every current third-block row. -/
theorem selectedColumn_hits_currentRow
    (F : TypeTwoQStarFamily R hpos Q)
    {Row : Type*} {rowPath : Row → GraphPath G}
    (H : TypeTwoCurrentRowsInvariant R hpos F Row rowPath)
    (j : Fin h) (r : Row) :
    HitsGraphPath
      (F.selectedData (F.selectedColumn j)
        (F.selectedColumn_mem_selectedIndexSet j)).qstar
      (rowPath r) := by
  exact (H (F.selectedColumn j)
    (F.selectedColumn_mem_indices j)).1 r

/-- A selected type-2 terminal column hits the lower symmetric boundary
`P_{2z}`. -/
theorem selectedColumn_hits_PtwoZ
    (F : TypeTwoQStarFamily R hpos Q)
    {Row : Type*} {rowPath : Row → GraphPath G}
    (H : TypeTwoCurrentRowsInvariant R hpos F Row rowPath)
    (j : Fin h) :
    HitsLinkagePath
      (F.selectedData (F.selectedColumn j)
        (F.selectedColumn_mem_selectedIndexSet j)).qstar
      (R.pTwoZIndex hpos) := by
  exact (H (F.selectedColumn j)
    (F.selectedColumn_mem_indices j)).2.1

/-- A selected type-2 terminal column hits the upper symmetric boundary
`P_{3z+1}`. -/
theorem selectedColumn_hits_PthreeZPlusOne
    (F : TypeTwoQStarFamily R hpos Q)
    {Row : Type*} {rowPath : Row → GraphPath G}
    (H : TypeTwoCurrentRowsInvariant R hpos F Row rowPath)
    (j : Fin h) :
    HitsLinkagePath
      (F.selectedData (F.selectedColumn j)
        (F.selectedColumn_mem_selectedIndexSet j)).qstar
      (R.pThreeZPlusOneIndex hpos) := by
  exact (H (F.selectedColumn j)
    (F.selectedColumn_mem_indices j)).2.2.1

/-- A selected type-2 terminal column avoids every linkage path outside the
third block and its two symmetric boundary paths. -/
theorem selectedColumn_avoids_other_linkage
    (F : TypeTwoQStarFamily R hpos Q)
    {Row : Type*} {rowPath : Row → GraphPath G}
    (H : TypeTwoCurrentRowsInvariant R hpos F Row rowPath)
    (j : Fin h) :
    ∀ l : L.Index, l ∉ typeTwoAllowedIndexSet R hpos →
      Disjoint
        (F.selectedData (F.selectedColumn j)
          (F.selectedColumn_mem_selectedIndexSet j)).qstar.vertexSet
        (L.path l).vertexSet := by
  exact (H (F.selectedColumn j)
    (F.selectedColumn_mem_indices j)).2.2.2

/-- A selected type-2 terminal column has a unique contact with the lower
symmetric boundary `P_{2z}`. -/
theorem selectedColumn_unique_PtwoZ
    (F : TypeTwoQStarFamily R hpos Q) (j : Fin h) :
    ((F.selectedData (F.selectedColumn j)
      (F.selectedColumn_mem_selectedIndexSet j)).qstar.vertexSet ∩
        (L.path (R.pTwoZIndex hpos)).vertexSet).card = 1 := by
  exact
    (F.selectedData (F.selectedColumn j)
      (F.selectedColumn_mem_selectedIndexSet j)).qstar_unique_PtwoZ

/-- A selected type-2 terminal column has a unique contact with the upper
symmetric boundary `P_{3z+1}`. -/
theorem selectedColumn_unique_PthreeZPlusOne
    (F : TypeTwoQStarFamily R hpos Q) (j : Fin h) :
    ((F.selectedData (F.selectedColumn j)
      (F.selectedColumn_mem_selectedIndexSet j)).qstar.vertexSet ∩
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet).card = 1 := by
  exact
    (F.selectedData (F.selectedColumn j)
      (F.selectedColumn_mem_selectedIndexSet j)).qstar_unique_PthreeZPlusOne

/-- A selected type-2 terminal column is endpoint-clean with respect to its
two fixed symmetric boundary linkage paths. -/
theorem selectedColumn_internallyDisjointFrom_boundaries
    (F : TypeTwoQStarFamily R hpos Q) (j : Fin h) :
    (F.selectedData (F.selectedColumn j)
      (F.selectedColumn_mem_selectedIndexSet j)).qstar.InternallyDisjointFromSet
      ((L.path (R.pTwoZIndex hpos)).vertexSet ∪
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet) := by
  exact
    (F.selectedData (F.selectedColumn j)
      (F.selectedColumn_mem_selectedIndexSet j)).internallyDisjointFrom_boundaries

/-- The initial third-block rows satisfy the concrete current-row invariant for
the type-2 family selected by the majority argument. -/
theorem initialCurrentRowsInvariant
    (F : TypeTwoQStarFamily R hpos Q) :
    TypeTwoCurrentRowsInvariant R hpos F (Fin (z h))
      (fun i : Fin (z h) =>
        L.path (R.index (windowPos h (2 * z h + 1) (by
          dsimp [z]
          omega) i))) := by
  intro i hi
  refine ⟨?_, (F.data i hi).qstar_hits_PtwoZ,
    (F.data i hi).qstar_hits_PthreeZPlusOne,
    (F.data i hi).qstar_avoids_other_linkage⟩
  intro r
  exact (F.data i hi).qstar_hits_block3 r

/-- The initial third-block rows satisfy the strengthened type-2 current-row
invariant, including the unique boundary contacts supplied by the type-2
`Q*` certificates. -/
theorem initialCurrentRowsFullInvariant
    (F : TypeTwoQStarFamily R hpos Q) :
    TypeTwoCurrentRowsFullInvariant R hpos F (Fin (z h))
      (fun i : Fin (z h) =>
        L.path (R.index (windowPos h (2 * z h + 1) (by
          dsimp [z]
          omega) i))) := by
  intro i hi
  refine ⟨?_, (F.data i hi).qstar_hits_PtwoZ,
    (F.data i hi).qstar_hits_PthreeZPlusOne,
    (F.data i hi).qstar_avoids_other_linkage,
    (F.data i hi).qstar_unique_PtwoZ,
    (F.data i hi).qstar_unique_PthreeZPlusOne⟩
  intro r
  exact (F.data i hi).qstar_hits_block3 r

end TypeTwoQStarFamily

/-- Isomorphism of the auxiliary graphs of two linkages, stated directly as an
adjacency-preserving equivalence of path indices. -/
def AuxGraphsIsomorphic {A B : Finset V}
    (L L' : PerfectPathPacking G A B) : Prop :=
  ∃ e : L.Index ≃ L'.Index,
    ∀ i j : L.Index,
      (linkageAuxGraph L).Adj i j ↔ (linkageAuxGraph L').Adj (e i) (e j)

theorem auxGraphsIsomorphic_refl {L : PerfectPathPacking G A B} :
    AuxGraphsIsomorphic L L := by
  refine ⟨Equiv.refl L.Index, ?_⟩
  intro i j
  simp

theorem auxGraphsIsomorphic_trans {L₁ L₂ L₃ : PerfectPathPacking G A B}
    (h₁₂ : AuxGraphsIsomorphic L₁ L₂)
    (h₂₃ : AuxGraphsIsomorphic L₂ L₃) :
    AuxGraphsIsomorphic L₁ L₃ := by
  rcases h₁₂ with ⟨e₁₂, hadj₁₂⟩
  rcases h₂₃ with ⟨e₂₃, hadj₂₃⟩
  refine ⟨e₁₂.trans e₂₃, ?_⟩
  intro i j
  exact (hadj₁₂ i j).trans (hadj₂₃ (e₁₂ i) (e₁₂ j))

theorem auxGraphsIsomorphic_of_equiv_adj
    {L L' : PerfectPathPacking G A B} (e : L.Index ≃ L'.Index)
    (hadj : ∀ i j : L.Index,
      (linkageAuxGraph L).Adj i j ↔
        (linkageAuxGraph L').Adj (e i) (e j)) :
    AuxGraphsIsomorphic L L' :=
  ⟨e, hadj⟩

/-- Exact degree is preserved by an adjacency-preserving equivalence of vertex
types. -/
theorem degreeEquals_equiv_iff
    {α β : Type*} [DecidableEq α] [DecidableEq β]
    {H : _root_.SimpleGraph α} {H' : _root_.SimpleGraph β}
    (e : α ≃ β)
    (hadj : ∀ x y : α, H.Adj x y ↔ H'.Adj (e x) (e y))
    {x : α} {d : ℕ} :
    DegreeEquals H x d ↔ DegreeEquals H' (e x) d := by
  classical
  constructor
  · rintro ⟨N, hN, hcard⟩
    refine ⟨N.image e.toEmbedding, ?_, ?_⟩
    · intro y
      constructor
      · intro hy
        rcases Finset.mem_image.mp hy with ⟨z, hz, rfl⟩
        exact (hadj x z).1 ((hN z).1 hz)
      · intro hy
        refine Finset.mem_image.mpr ⟨e.symm y, ?_, by simp⟩
        exact (hN (e.symm y)).2 ((hadj x (e.symm y)).2 (by
          simpa using hy))
    · simpa using (Finset.card_image_of_injective N e.injective).trans hcard
  · rintro ⟨N, hN, hcard⟩
    refine ⟨N.image e.symm.toEmbedding, ?_, ?_⟩
    · intro y
      constructor
      · intro hy
        rcases Finset.mem_image.mp hy with ⟨z, hz, rfl⟩
        exact (hadj x (e.symm z)).2 (by
          simpa using ((hN z).1 hz))
      · intro hy
        refine Finset.mem_image.mpr ⟨e y, ?_, by simp⟩
        exact (hN (e y)).2 ((hadj x y).1 hy)
    · simpa using
        (Finset.card_image_of_injective N e.symm.injective).trans hcard

/-- The number of degree-two vertices is invariant under an adjacency-
preserving equivalence. -/
theorem degreeTwoVertexCount_eq_of_equiv_adj
    {α β : Type*} [Fintype α] [Fintype β]
    [DecidableEq α] [DecidableEq β]
    {H : _root_.SimpleGraph α} {H' : _root_.SimpleGraph β}
    (e : α ≃ β)
    (hadj : ∀ x y : α, H.Adj x y ↔ H'.Adj (e x) (e y)) :
    degreeTwoVertexCount H = degreeTwoVertexCount H' := by
  classical
  rw [degreeTwoVertexCount, degreeTwoVertexCount]
  refine Finset.card_bij
    (fun x _hx => e x) ?maps_to ?injective ?surjective
  · intro x hx
    rw [Finset.mem_filter] at hx ⊢
    exact ⟨Finset.mem_univ _, (degreeEquals_equiv_iff e hadj).1 hx.2⟩
  · intro x _hx y _hy hxy
    exact e.injective hxy
  · intro y hy
    refine ⟨e.symm y, ?_, by simp⟩
    rw [Finset.mem_filter] at hy ⊢
    exact ⟨Finset.mem_univ _,
      (degreeEquals_equiv_iff e hadj).2 (by simpa using hy.2)⟩

/-- Auxiliary graph isomorphism preserves the auxiliary degree-two count. -/
theorem AuxGraphsIsomorphic.degreeTwoCount_eq
    {L L' : PerfectPathPacking G A B}
    (hiso : AuxGraphsIsomorphic L L') :
    linkageAuxDegreeTwoCount L = linkageAuxDegreeTwoCount L' := by
  rcases hiso with ⟨e, hadj⟩
  exact degreeTwoVertexCount_eq_of_equiv_adj e hadj

/-- The current input to one iteration, immediately before the proof starts
looking for a bump or a cross.  The fields are exactly the three bullets on
page 60, with the set `Q0` kept fixed. -/
structure IterationInput (R : IndexedAuxiliaryPrefix L h)
    (hpos : 0 < h) {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeOneQStarFamily R hpos Q) where
  Row : Type
  rowFintype : Fintype Row
  rowDecidableEq : DecidableEq Row
  rowPath : Row → GraphPath G
  linkage : PerfectPathPacking G A B
  rowIndex : Row → linkage.Index
  rowPath_eq_linkage_path :
    ∀ r : Row, rowPath r = linkage.path (rowIndex r)
  linkage_is_block_replacement : Prop
  aux_iso_fixed_outside : AuxGraphsIsomorphic L linkage
  q0_intersection_invariant :
    TypeOneCurrentRowsInvariant R hpos Q0 Row rowPath

namespace IterationInput

attribute [instance] rowFintype rowDecidableEq

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}

/-- The edge set of the current rows in an iteration. -/
noncomputable def rowEdgeSet (I : IterationInput R hpos Q0) :
    Finset (Sym2 V) :=
  Finset.univ.biUnion fun r : I.Row => (I.rowPath r).edgeSet

/-- The maintained graph `Htilde`, represented by its edge set: the union of
the current rows and the fixed paths in `Q0`. -/
noncomputable def tildeEdgeSet (I : IterationInput R hpos Q0) :
    Finset (Sym2 V) :=
  I.rowEdgeSet ∪ Q0.edgeSet

/-- The current row paths are pairwise vertex-disjoint.  This is implicit in
the fact that they are paths of the current linkage; it is kept as a named
invariant because the terminal grid branch sets use it directly. -/
def RowsNodeDisjoint (I : IterationInput R hpos Q0) : Prop :=
  Pairwise fun r s : I.Row => (I.rowPath r).NodeDisjoint (I.rowPath s)

/-- The current row labels inject into the current linkage index type. -/
def RowIndexInjective (I : IterationInput R hpos Q0) : Prop :=
  Function.Injective I.rowIndex

/-- A chosen order of the maintained row family by the `z = 2h` active row
positions. -/
structure OrderedRows (I : IterationInput R hpos Q0) where
  order : I.Row ≃ Fin (z h)

/-- Injective row indices imply row-path disjointness, because the row paths
are distinct paths of the current linkage. -/
theorem rowsNodeDisjoint_of_rowIndexInjective
    (I : IterationInput R hpos Q0) (hinj : I.RowIndexInjective) :
    I.RowsNodeDisjoint := by
  intro r s hrs
  have hidx : I.rowIndex r ≠ I.rowIndex s := by
    intro h
    exact hrs (hinj h)
  rw [I.rowPath_eq_linkage_path r, I.rowPath_eq_linkage_path s]
  exact I.linkage.toPathPacking.node_disjoint hidx

end IterationInput

/-- The first iteration has `P_1' = P_1`, the original linkage, and the
type-1 family `Q0` selected above. -/
noncomputable def initialIterationInput
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeOneQStarFamily R hpos Q) :
    IterationInput R hpos Q0 where
  Row := Fin (z h)
  rowFintype := inferInstance
  rowDecidableEq := inferInstance
  rowPath := fun i : Fin (z h) =>
    L.path (R.index (windowPos h 1 (by
      dsimp [z]
      omega) i))
  linkage := L
  rowIndex := fun i : Fin (z h) =>
    R.index (windowPos h 1 (by
      dsimp [z]
      omega) i)
  rowPath_eq_linkage_path := by
    intro i
    rfl
  linkage_is_block_replacement := True
  aux_iso_fixed_outside := auxGraphsIsomorphic_refl
  q0_intersection_invariant := Q0.initialCurrentRowsInvariant

/-- In the initial state, the displayed first-block rows are pairwise
vertex-disjoint because they are distinct paths of the original linkage. -/
theorem initialIterationInput_rowsNodeDisjoint
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeOneQStarFamily R hpos Q) :
    (initialIterationInput Q0).RowsNodeDisjoint := by
  classical
  intro i j hij
  have hidx_ne :
      R.index (windowPos h 1 (by
        dsimp [z]
        omega) i) ≠
        R.index (windowPos h 1 (by
          dsimp [z]
          omega) j) := by
    intro hidx
    apply hij
    apply Fin.ext
    have hpos :=
      congrArg Fin.val (R.index_injective hidx)
    simp [windowPos] at hpos
    omega
  simpa [IterationInput.RowsNodeDisjoint, initialIterationInput] using
    L.toPathPacking.node_disjoint hidx_ne

/-- The initial displayed first-block row labels are injective in the linkage
index type. -/
theorem initialIterationInput_rowIndexInjective
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeOneQStarFamily R hpos Q) :
    (initialIterationInput Q0).RowIndexInjective := by
  intro i j hij
  apply Fin.ext
  have hpos :=
    congrArg Fin.val (R.index_injective hij)
  simp [windowPos] at hpos
  omega

/-- The initial row family has its displayed order by construction. -/
noncomputable def initialIterationInput_orderedRows
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeOneQStarFamily R hpos Q) :
    (initialIterationInput Q0).OrderedRows where
  order := Equiv.refl (Fin (z h))

/-- The concrete type-1 setup that the proof keeps after the page-60
"without loss of generality" sentence: a large fixed family `Q0`, together
with the initial iteration input whose current rows are the original first
block. -/
structure TypeOneIterationSetup (R : IndexedAuxiliaryPrefix L h)
    (hpos : 0 < h) (Q : PerfectPathPacking G R.X R.Y) where
  Q0 : TypeOneQStarFamily R hpos Q
  input : IterationInput R hpos Q0
  input_is_initial : input = initialIterationInput Q0

/-- The invariant package that is visibly true for the first type-1
iteration state and should be preserved by the nonterminating bump/cross
successor branch. -/
structure TypeOneIterationInvariants
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0) where
  orderedRows : I.OrderedRows
  rowIndexInjective : I.RowIndexInjective
  rowsNodeDisjoint : I.RowsNodeDisjoint

namespace TypeOneIterationInvariants

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}

/-- Distinct row-order positions give distinct linkage indices. -/
theorem rowIndex_ne_of_order_ne
    (Inv : TypeOneIterationInvariants I) {r s : I.Row}
    (hpos_ne : Inv.orderedRows.order r ≠ Inv.orderedRows.order s) :
    I.rowIndex r ≠ I.rowIndex s := by
  intro hidx
  exact hpos_ne (by
    simp [Inv.rowIndexInjective hidx])

/-- A convenient numeric form of `rowIndex_ne_of_order_ne`. -/
theorem rowIndex_ne_of_order_val_ne
    (Inv : TypeOneIterationInvariants I) {r s : I.Row}
    (hpos_ne : (Inv.orderedRows.order r).1 ≠
      (Inv.orderedRows.order s).1) :
    I.rowIndex r ≠ I.rowIndex s := by
  exact Inv.rowIndex_ne_of_order_ne (by
    intro h
    exact hpos_ne (congrArg Fin.val h))

end TypeOneIterationInvariants

/-- The auxiliary two-path invariant for the currently active type-1 rows.

This is the graph-theoretic content behind the paper's statement that the
current rows continue to correspond to the same degree-two path in the
auxiliary graph.  It is kept separate from `TypeOneIterationInvariants` for now
because many existing lemmas only need the lighter row-order/disjointness
package. -/
structure TypeOneActiveAuxiliaryInvariant
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  degree_two :
    ∀ r : I.Row,
      DegreeEquals (linkageAuxGraph I.linkage) (I.rowIndex r) 2
  consecutive_adj :
    ∀ ⦃r s : I.Row⦄,
      FinConsecutive (inv.orderedRows.order r) (inv.orderedRows.order s) →
        (linkageAuxGraph I.linkage).Adj (I.rowIndex r) (I.rowIndex s)
  no_chord :
    ∀ ⦃r s : I.Row⦄,
      (linkageAuxGraph I.linkage).Adj (I.rowIndex r) (I.rowIndex s) →
        FinConsecutive (inv.orderedRows.order r) (inv.orderedRows.order s)

/-- The full invariant package for the type-1 bump/cross loop.

The lighter `TypeOneIterationInvariants` package records the row-order and
disjointness bookkeeping.  The `active_aux` field records the substantive
auxiliary-graph invariant: the current rows still form the displayed
degree-two path in the current auxiliary graph.  This is exactly the invariant
consumed by the no-chord hypotheses in Claims B.2 and B.3. -/
structure TypeOneFullIterationInvariants
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0) where
  base : TypeOneIterationInvariants I
  active_aux : TypeOneActiveAuxiliaryInvariant I base

/-- Boundary auxiliary data for the type-1 loop.

The paper's invariant is not only that the active rows form a degree-two path:
the fixed boundary rows `P₀` and `P_{z+1}` remain attached at the two ends of
that active path.  This data is needed in the local bump/cross analysis at the
first and last active rows, where the local triple/quadruple contains a
boundary row rather than another active row. -/
structure TypeOneBoundaryAuxiliaryInvariant
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  lowerBoundary : I.linkage.Index
  upperBoundary : I.linkage.Index
  lower_path_eq :
    I.linkage.path lowerBoundary = L.path R.p0Index
  upper_path_eq :
    I.linkage.path upperBoundary = L.path (R.pZPlusOneIndex hpos)
  lower_ne_row :
    ∀ r : I.Row, lowerBoundary ≠ I.rowIndex r
  upper_ne_row :
    ∀ r : I.Row, upperBoundary ≠ I.rowIndex r
  lower_degree_two :
    DegreeEquals (linkageAuxGraph I.linkage) lowerBoundary 2
  upper_degree_two :
    DegreeEquals (linkageAuxGraph I.linkage) upperBoundary 2
  lower_adj_first :
    (linkageAuxGraph I.linkage).Adj lowerBoundary
      (I.rowIndex
        (inv.orderedRows.order.symm
          (⟨0, by dsimp [z]; omega⟩ : Fin (z h))))
  last_adj_upper :
    (linkageAuxGraph I.linkage).Adj
      (I.rowIndex
        (inv.orderedRows.order.symm
          (⟨z h - 1, by dsimp [z]; omega⟩ : Fin (z h))))
      upperBoundary
  lowerOutside : I.linkage.Index
  upperOutside : I.linkage.Index
  lower_adj_outside :
    (linkageAuxGraph I.linkage).Adj lowerBoundary lowerOutside
  upper_adj_outside :
    (linkageAuxGraph I.linkage).Adj upperBoundary upperOutside
  lowerOutside_ne_row :
    ∀ r : I.Row, lowerOutside ≠ I.rowIndex r
  upperOutside_ne_row :
    ∀ r : I.Row, upperOutside ≠ I.rowIndex r
  lowerOutside_ne_lower : lowerOutside ≠ lowerBoundary
  lowerOutside_ne_upper : lowerOutside ≠ upperBoundary
  upperOutside_ne_lower : upperOutside ≠ lowerBoundary
  upperOutside_ne_upper : upperOutside ≠ upperBoundary

namespace TypeOneBoundaryAuxiliaryInvariant

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- The lower and upper boundary rows represent distinct linkage paths. -/
theorem lower_ne_upper
    (Bnd : TypeOneBoundaryAuxiliaryInvariant I inv) :
    Bnd.lowerBoundary ≠ Bnd.upperBoundary := by
  intro hEq
  have hpath :
      L.path R.p0Index = L.path (R.pZPlusOneIndex hpos) := by
    calc
      L.path R.p0Index = I.linkage.path Bnd.lowerBoundary :=
        Bnd.lower_path_eq.symm
      _ = I.linkage.path Bnd.upperBoundary := by rw [hEq]
      _ = L.path (R.pZPlusOneIndex hpos) := Bnd.upper_path_eq
  let v : V := (L.path R.p0Index).source
  have hv0 : v ∈ (L.path R.p0Index).vertexSet := by
    simp [v]
  have hvz : v ∈ (L.path (R.pZPlusOneIndex hpos)).vertexSet := by
    simp [v, hpath]
  exact Finset.disjoint_left.mp
    (L.toPathPacking.node_disjoint (R.p0Index_ne_pZPlusOneIndex hpos))
    hv0 hvz

/-- A current row adjacent to the lower boundary row must be the first active
row in the maintained extended degree-two path.  The proof is pure degree-two
saturation: the lower boundary already has its outside neighbor and the first
active row as its two neighbors. -/
theorem row_adj_lowerBoundary_eq_first
    (Bnd : TypeOneBoundaryAuxiliaryInvariant I inv) {r : I.Row}
    (hadj :
      (linkageAuxGraph I.linkage).Adj Bnd.lowerBoundary (I.rowIndex r)) :
    inv.orderedRows.order r =
      (⟨0, by dsimp [z]; omega⟩ : Fin (z h)) := by
  classical
  let firstRow : I.Row :=
    inv.orderedRows.order.symm
      (⟨0, by dsimp [z]; omega⟩ : Fin (z h))
  have hfirst_idx_ne_outside :
      Bnd.lowerOutside ≠ I.rowIndex firstRow := by
    exact Bnd.lowerOutside_ne_row firstRow
  have hneighbors :=
    DegreeEquals.two_adj_eq_or_eq Bnd.lower_degree_two
      Bnd.lower_adj_outside Bnd.lower_adj_first hfirst_idx_ne_outside hadj
  rcases hneighbors with houtside | hfirst
  · exact False.elim (Bnd.lowerOutside_ne_row r houtside.symm)
  · have hrfirst : r = firstRow := by
      apply inv.rowIndexInjective
      exact hfirst
    subst r
    simp [firstRow]

/-- Symmetric upper-boundary form: a current row adjacent to the upper
boundary row must be the last active row in the maintained extended path. -/
theorem row_adj_upperBoundary_eq_last
    (Bnd : TypeOneBoundaryAuxiliaryInvariant I inv) {r : I.Row}
    (hadj :
      (linkageAuxGraph I.linkage).Adj (I.rowIndex r) Bnd.upperBoundary) :
    inv.orderedRows.order r =
      (⟨z h - 1, by dsimp [z]; omega⟩ : Fin (z h)) := by
  classical
  let lastRow : I.Row :=
    inv.orderedRows.order.symm
      (⟨z h - 1, by dsimp [z]; omega⟩ : Fin (z h))
  have hlast_idx_ne_outside :
      Bnd.upperOutside ≠ I.rowIndex lastRow := by
    exact Bnd.upperOutside_ne_row lastRow
  have hneighbors :=
    DegreeEquals.two_adj_eq_or_eq Bnd.upper_degree_two
      Bnd.upper_adj_outside ((linkageAuxGraph I.linkage).symm Bnd.last_adj_upper)
      hlast_idx_ne_outside ((linkageAuxGraph I.linkage).symm hadj)
  rcases hneighbors with houtside | hlast
  · exact False.elim (Bnd.upperOutside_ne_row r houtside.symm)
  · have hrlast : r = lastRow := by
      apply inv.rowIndexInjective
      exact hlast
    subst r
    simp [lastRow]

end TypeOneBoundaryAuxiliaryInvariant

/-- Full type-1 invariant with explicit boundary rows.  This is the invariant
shape needed to turn the local Figure 7/Figure 8 lemmas into a global
one-step theorem without special-casing the two ends informally. -/
structure TypeOneExtendedFullIterationInvariants
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0) where
  full : TypeOneFullIterationInvariants I
  boundary : TypeOneBoundaryAuxiliaryInvariant I full.base

/-- Bare finite trace through a type-1 extended row path.

Unlike `TypeOneExtendedRowContactTrace`, this version does not depend on an
`IterationInput`.  It is the right interface for constructing the successor
`Q₀` row-contact invariant: before the successor input can be packaged, the
proof only knows a row type, a row order, and a successor row-path function. -/
structure TypeOneBareExtendedRowContactTrace
    (Row : Type*) (order : Row ≃ Fin (z h))
    (rowPath : Row → GraphPath G) (P : GraphPath G) where
  len : ℕ
  contact : Fin (len + 1) → V
  pos : Fin (len + 1) → ℕ
  contact_mem_path : ∀ r, contact r ∈ P.vertexSet
  first_pos : pos ⟨0, by omega⟩ = z h + 1
  last_pos : pos ⟨len, by omega⟩ = 0
  unit_step : UnitStepNatTrace len pos
  contact_mem_row_of_pos :
    ∀ (row : Row) (r : Fin (len + 1)),
      pos r = (order row).1 + 1 →
        contact r ∈ (rowPath row).vertexSet

namespace TypeOneBareExtendedRowContactTrace

variable {Row : Type*} {order : Row ≃ Fin (z h)}
variable {rowPath : Row → GraphPath G} {P : GraphPath G}

/-- Build a bare extended-row trace from plain hits of every active row.

This is a deliberately weak trace constructor: the bare trace interface only
needs one vertex of `P` on each displayed active row and a unit-step list of
row positions.  It does not assert that those contacts occur in this order on
`P`.  The paper's no-skip argument therefore only has to prove the surviving
row hits; this constructor turns those hits into the trace interface used by
the invariant-update wrappers. -/
noncomputable def of_hits
    (hpos : 0 < h)
    (hrow : ∀ row : Row, HitsGraphPath P (rowPath row)) :
    TypeOneBareExtendedRowContactTrace (h := h) Row order rowPath P where
  len := z h + 1
  contact := fun r =>
    if hactive : 0 < r.1 ∧ r.1 ≤ z h then
      Classical.choose
        (hrow (order.symm ⟨z h - r.1, by omega⟩))
    else
      Classical.choose
        (hrow (order.symm ⟨0, by dsimp [z]; omega⟩))
  pos := fun r => z h + 1 - r.1
  contact_mem_path := by
    intro r
    by_cases hactive : 0 < r.1 ∧ r.1 ≤ z h
    · have hspec :=
        Classical.choose_spec
          (hrow (order.symm ⟨z h - r.1, by omega⟩))
      change
        (if hactive' : 0 < r.1 ∧ r.1 ≤ z h then
            Classical.choose
              (hrow (order.symm ⟨z h - r.1, by omega⟩))
          else
            Classical.choose
              (hrow (order.symm ⟨0, by dsimp [z]; omega⟩))) ∈
          P.vertexSet
      rw [dif_pos hactive]
      exact (Finset.mem_inter.1 hspec).1
    · have hspec :=
        Classical.choose_spec
          (hrow (order.symm ⟨0, by dsimp [z]; omega⟩))
      change
        (if hactive' : 0 < r.1 ∧ r.1 ≤ z h then
            Classical.choose
              (hrow (order.symm ⟨z h - r.1, by omega⟩))
          else
            Classical.choose
              (hrow (order.symm ⟨0, by dsimp [z]; omega⟩))) ∈
          P.vertexSet
      rw [dif_neg hactive]
      exact (Finset.mem_inter.1 hspec).1
  first_pos := by
    simp
  last_pos := by
    simp
  unit_step := by
    intro r
    constructor <;> simp <;> omega
  contact_mem_row_of_pos := by
    intro row r hpos_eq
    have hrowlt : (order row).1 < z h := (order row).2
    have hactive : 0 < r.1 ∧ r.1 ≤ z h := by
      constructor <;> omega
    have hval : z h - r.1 = (order row).1 := by
      omega
    have hfin : (⟨z h - r.1, by omega⟩ : Fin (z h)) = order row :=
      Fin.ext hval
    have hrow_eq : order.symm ⟨z h - r.1, by omega⟩ = row := by
      rw [hfin]
      simp
    have hspec :=
      Classical.choose_spec
        (hrow (order.symm ⟨z h - r.1, by omega⟩))
    have hmem :
        Classical.choose
            (hrow (order.symm ⟨z h - r.1, by omega⟩)) ∈
          (rowPath (order.symm ⟨z h - r.1, by omega⟩)).vertexSet :=
      (Finset.mem_inter.1 hspec).2
    simpa [hactive, hrow_eq] using hmem

/-- A bare unit-step extended-row contact trace from the upper boundary to the
lower boundary hits every active row. -/
theorem hits_all_rows
    (T : TypeOneBareExtendedRowContactTrace (h := h) Row order rowPath P) :
    ∀ row : Row, HitsGraphPath P (rowPath row) := by
  intro row
  let k : ℕ := (order row).1 + 1
  have hk_le_first : k ≤ T.pos ⟨0, by omega⟩ := by
    have hrowlt : (order row).1 < z h := (order row).2
    rw [T.first_pos]
    omega
  have hlast_le_k : T.pos ⟨T.len, by omega⟩ ≤ k := by
    rw [T.last_pos]
    simp [k]
  rcases UnitStepNatTrace.exists_eq_of_ge
      (f := T.pos) T.unit_step hk_le_first hlast_le_k with ⟨r, hr⟩
  refine ⟨T.contact r, Finset.mem_inter.2 ⟨T.contact_mem_path r, ?_⟩⟩
  exact T.contact_mem_row_of_pos row r (by simpa [k] using hr)

end TypeOneBareExtendedRowContactTrace

/-- Build the maintained `Q₀` row-contact invariant from bare extended-row
contact traces for every fixed type-1 path.

This is the no-skip handoff in invariant form: the trace supplies all active
row hits, while the two boundary hits and avoidance of original outside
linkage paths are part of the original type-1 `Q*` data. -/
theorem TypeOneCurrentRowsInvariant_of_bareExtendedRowContactTraces
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Qpack : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Qpack}
    {Row : Type*} {rowPath : Row → GraphPath G}
    {order : Row ≃ Fin (z h)}
    (htrace :
      ∀ i : Qpack.Index, ∀ hi : i ∈ Q0.indices,
        Nonempty
          (TypeOneBareExtendedRowContactTrace
            (h := h) Row order rowPath (Q0.data i hi).qstar)) :
    TypeOneCurrentRowsInvariant R hpos Q0 Row rowPath := by
  intro i hi
  refine ⟨?_, (Q0.data i hi).qstar_hits_P0,
    (Q0.data i hi).qstar_hits_PzPlusOne,
    (Q0.data i hi).qstar_avoids_other_linkage⟩
  rcases htrace i hi with ⟨T⟩
  exact T.hits_all_rows

/-- Build bare extended-row traces from an already established current-row
intersection invariant.

This packages the observation that, for the bare trace API, row hits are
enough: choose one contact on each row and use the canonical decreasing
position trace `z+1, z, ..., 1, 0`. -/
theorem TypeOneBareExtendedRowContactTrace.nonempty_of_currentRowsInvariant
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Qpack : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Qpack}
    {Row : Type*} {rowPath : Row → GraphPath G}
    {order : Row ≃ Fin (z h)}
    (H : TypeOneCurrentRowsInvariant R hpos Q0 Row rowPath) :
    ∀ i : Qpack.Index, ∀ hi : i ∈ Q0.indices,
      Nonempty
        (TypeOneBareExtendedRowContactTrace
          (h := h) Row order rowPath (Q0.data i hi).qstar) := by
  intro i hi
  exact ⟨TypeOneBareExtendedRowContactTrace.of_hits
    (h := h) (order := order) (rowPath := rowPath)
    (P := (Q0.data i hi).qstar) hpos (H i hi).1⟩

/-- A contact trace through the extended type-1 row path
`P₀, R₁, ..., R_z, P_{z+1}`.

This is the finite trace interface for the paper's no-skip argument after a
bump/cross successor: once all linkage contacts of a fixed `Q₀` path are
classified by extended-row position, the unit-step property forces every
active row position to occur. -/
structure TypeOneExtendedRowContactTrace
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Qpack : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Qpack}
    {I : IterationInput R hpos Q0}
    (inv : TypeOneIterationInvariants I)
    (P : GraphPath G) where
  len : ℕ
  contact : Fin (len + 1) → V
  pos : Fin (len + 1) → ℕ
  contact_mem_path : ∀ r, contact r ∈ P.vertexSet
  first_pos : pos ⟨0, by omega⟩ = z h + 1
  last_pos : pos ⟨len, by omega⟩ = 0
  unit_step : UnitStepNatTrace len pos
  contact_mem_row_of_pos :
    ∀ (row : I.Row) (r : Fin (len + 1)),
      pos r = (inv.orderedRows.order row).1 + 1 →
        contact r ∈ (I.rowPath row).vertexSet

namespace TypeOneExtendedRowContactTrace

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Qpack : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Qpack}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}
variable {P : GraphPath G}

/-- Forget the `IterationInput` wrapper on an extended row-contact trace. -/
def toBare
    (T : TypeOneExtendedRowContactTrace inv P) :
    TypeOneBareExtendedRowContactTrace
      (h := h) I.Row inv.orderedRows.order I.rowPath P where
  len := T.len
  contact := T.contact
  pos := T.pos
  contact_mem_path := T.contact_mem_path
  first_pos := T.first_pos
  last_pos := T.last_pos
  unit_step := T.unit_step
  contact_mem_row_of_pos := T.contact_mem_row_of_pos

/-- The finite no-skip conclusion: a unit-step extended-row contact trace from
the upper boundary to the lower boundary visits every active row position. -/
theorem hits_all_current_rows
    (T : TypeOneExtendedRowContactTrace inv P) :
    ∀ row : I.Row, HitsGraphPath P (I.rowPath row) := by
  intro row
  let k : ℕ := (inv.orderedRows.order row).1 + 1
  have hk_le_first : k ≤ T.pos ⟨0, by omega⟩ := by
    have hrowlt : (inv.orderedRows.order row).1 < z h :=
      (inv.orderedRows.order row).2
    rw [T.first_pos]
    omega
  have hlast_le_k : T.pos ⟨T.len, by omega⟩ ≤ k := by
    rw [T.last_pos]
    simp [k]
  rcases UnitStepNatTrace.exists_eq_of_ge
      (f := T.pos) T.unit_step hk_le_first hlast_le_k with ⟨r, hr⟩
  refine ⟨T.contact r, Finset.mem_inter.2 ⟨T.contact_mem_path r, ?_⟩⟩
  exact T.contact_mem_row_of_pos row r (by simpa [k] using hr)

end TypeOneExtendedRowContactTrace

/-- Build the maintained `Q₀` row-contact invariant from iteration-dependent
extended-row contact traces. -/
theorem TypeOneCurrentRowsInvariant_of_extendedRowContactTraces
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Qpack : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Qpack}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (htrace :
      ∀ i : Qpack.Index, ∀ hi : i ∈ Q0.indices,
        Nonempty
          (TypeOneExtendedRowContactTrace inv (Q0.data i hi).qstar)) :
    TypeOneCurrentRowsInvariant R hpos Q0 I.Row I.rowPath := by
  exact TypeOneCurrentRowsInvariant_of_bareExtendedRowContactTraces
    (fun i hi =>
      let T := Classical.choice (htrace i hi)
      ⟨T.toBare⟩)

/-- Build the type-1 iteration setup from a large type-1 subfamily. -/
noncomputable def TypeOneQStarFamily.toIterationSetup
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeOneQStarFamily R hpos Q) :
    TypeOneIterationSetup R hpos Q where
  Q0 := Q0
  input := initialIterationInput Q0
  input_is_initial := rfl

/-- The initial type-1 iteration state satisfies the ordered-row,
row-index-injective, and row-disjointness invariants. -/
noncomputable def TypeOneQStarFamily.initialIterationInvariants
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeOneQStarFamily R hpos Q) :
    TypeOneIterationInvariants (initialIterationInput Q0) where
  orderedRows := initialIterationInput_orderedRows Q0
  rowIndexInjective := initialIterationInput_rowIndexInjective Q0
  rowsNodeDisjoint := initialIterationInput_rowsNodeDisjoint Q0

/-- The initial type-1 rows inherit the active auxiliary two-path invariant
from the displayed indexed prefix `R*`. -/
noncomputable def TypeOneQStarFamily.initialActiveAuxiliaryInvariant
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeOneQStarFamily R hpos Q) :
    TypeOneActiveAuxiliaryInvariant
      (initialIterationInput Q0) Q0.initialIterationInvariants where
  degree_two := by
    intro r
    simpa [initialIterationInput] using
      R.degree_two (windowPos h 1 (by dsimp [z]; omega) r)
  consecutive_adj := by
    intro r s hcon
    change (linkageAuxGraph L).Adj
      (R.index (windowPos h 1 (by dsimp [z]; omega) r))
      (R.index (windowPos h 1 (by dsimp [z]; omega) s))
    have hcon_rs : FinConsecutive r s := by
      simpa [TypeOneQStarFamily.initialIterationInvariants,
        initialIterationInput_orderedRows] using hcon
    rcases hcon_rs with hnext | hprev
    · have hadj := R.adj_indexAt_succ
        (k := 1 + r.1) (by
          have hr := r.2
          dsimp [z] at hr ⊢
          omega)
      have hsval : s.1 = r.1 + 1 := by omega
      simpa [R.block1_index_eq_indexAt r,
        R.block1_index_eq_indexAt s, hsval, Nat.add_assoc,
        Nat.add_comm, Nat.add_left_comm] using hadj
    · have hadj := R.adj_indexAt_succ
        (k := 1 + s.1) (by
          have hs := s.2
          dsimp [z] at hs ⊢
          omega)
      have hrval : r.1 = s.1 + 1 := by omega
      simpa [R.block1_index_eq_indexAt r,
        R.block1_index_eq_indexAt s, hrval, Nat.add_assoc,
        Nat.add_comm, Nat.add_left_comm] using hadj.symm
  no_chord := by
    intro r s hadj
    change FinConsecutive r s
    by_cases hrs : r = s
    · subst s
      have hloop :
          (linkageAuxGraph L).Adj
            (R.index (windowPos h 1 (by dsimp [z]; omega) r))
            (R.index (windowPos h 1 (by dsimp [z]; omega) r)) := by
        exact hadj
      exact False.elim ((linkageAuxGraph L).loopless.irrefl
        (R.index (windowPos h 1 (by dsimp [z]; omega) r)) hloop)
    · have hadj' :
          (linkageAuxGraph L).Adj
            (R.indexAt (1 + r.1) (by
              have hr := r.2
              dsimp [z] at hr ⊢
              omega))
            (R.indexAt (1 + s.1) (by
              have hs := s.2
              dsimp [z] at hs ⊢
              omega)) := by
        simpa [initialIterationInput, R.block1_index_eq_indexAt r,
          R.block1_index_eq_indexAt s] using hadj
      rcases R.neighbor_of_interior_indexAt
          (k := 1 + r.1)
          (by omega)
          (by
            have hr := r.2
            dsimp [z] at hr ⊢
            omega)
          (j := R.indexAt (1 + s.1) (by
            have hs := s.2
            dsimp [z] at hs ⊢
            omega))
          hadj' with hleft | hright
      · have hpos :
            1 + s.1 = 1 + r.1 - 1 := by
          exact (R.indexAt_eq_indexAt_iff _ _).1 hleft
        right
        omega
      · have hpos :
            1 + s.1 = 1 + r.1 + 1 := by
          exact (R.indexAt_eq_indexAt_iff _ _).1 hright
        left
        omega

/-- The initial type-1 iteration state satisfies the full invariant package. -/
noncomputable def TypeOneQStarFamily.initialFullIterationInvariants
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeOneQStarFamily R hpos Q) :
    TypeOneFullIterationInvariants (initialIterationInput Q0) where
  base := Q0.initialIterationInvariants
  active_aux := Q0.initialActiveAuxiliaryInvariant

/-- The initial type-1 state also has the two fixed boundary rows attached to
the displayed active row path. -/
noncomputable def TypeOneQStarFamily.initialBoundaryAuxiliaryInvariant
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeOneQStarFamily R hpos Q) :
    TypeOneBoundaryAuxiliaryInvariant
      (initialIterationInput Q0) Q0.initialIterationInvariants where
  lowerBoundary := R.p0Index
  upperBoundary := R.pZPlusOneIndex hpos
  lower_path_eq := rfl
  upper_path_eq := rfl
  lower_ne_row := by
    intro r hidx
    have hpos_eq := congrArg Fin.val (R.index_injective hidx)
    simp [p0Pos, windowPos] at hpos_eq
    omega
  upper_ne_row := by
    intro r hidx
    have hpos_eq := congrArg Fin.val (R.index_injective hidx)
    simp [pZPlusOnePos, windowPos] at hpos_eq
    have hr := r.2
    dsimp [z] at hr
    omega
  lower_degree_two := R.p0Index_degree_two
  upper_degree_two := R.degree_two (pZPlusOnePos h hpos)
  lower_adj_first := by
    have hadj := R.adj_indexAt_succ (k := 0) (by omega)
    simpa [initialIterationInput, p0Index, p0Pos, windowPos,
      IndexedAuxiliaryPrefix.indexAt, IndexedAuxiliaryPrefix.posOfNat]
      using hadj
  last_adj_upper := by
    have hadj := R.adj_indexAt_succ (k := z h) (by
      dsimp [z]
      omega)
    change (linkageAuxGraph L).Adj
      (R.index (windowPos h 1 (by dsimp [z]; omega)
        (⟨z h - 1, by dsimp [z]; omega⟩ : Fin (z h))))
      (R.pZPlusOneIndex hpos)
    have hleft :
        R.index (windowPos h 1 (by dsimp [z]; omega)
          (⟨z h - 1, by dsimp [z]; omega⟩ : Fin (z h))) =
          R.indexAt (z h) (by dsimp [z]; omega) := by
      apply congrArg R.index
      apply Fin.ext
      have hzpos : 0 < z h := by
        dsimp [z]
        omega
      simp [windowPos, IndexedAuxiliaryPrefix.posOfNat]
      omega
    have hright :
        R.pZPlusOneIndex hpos =
          R.indexAt (z h + 1) (by dsimp [z]; omega) := by
      apply congrArg R.index
      apply Fin.ext
      simp [pZPlusOnePos, IndexedAuxiliaryPrefix.posOfNat]
    rw [hleft, hright]
    exact hadj
  lowerOutside := R.p0OutsideIndex hpos
  upperOutside := R.indexAt (z h + 2) (by dsimp [z]; omega)
  lower_adj_outside := R.p0_adj_outsideIndex hpos
  upper_adj_outside := by
    have hadj := R.adj_indexAt_succ (k := z h + 1) (by
      dsimp [z]
      omega)
    have hleft :
        R.pZPlusOneIndex hpos =
          R.indexAt (z h + 1) (by dsimp [z]; omega) := by
      apply congrArg R.index
      apply Fin.ext
      simp [pZPlusOnePos, IndexedAuxiliaryPrefix.posOfNat]
    rw [hleft]
    exact hadj
  lowerOutside_ne_row := by
    intro r
    have hk8 : 1 + r.1 < 8 * h := by
      have hr := r.2
      dsimp [z] at hr ⊢
      omega
    have hne :
        R.p0OutsideIndex hpos ≠
          R.indexAt (1 + r.1) (by
            have hr := r.2
            dsimp [z] at hr ⊢
            omega) :=
      R.p0OutsideIndex_ne_indexAt hpos (k := 1 + r.1) (by omega) hk8
    simpa [initialIterationInput, R.block1_index_eq_indexAt r] using hne
  upperOutside_ne_row := by
    intro r hidx
    have hpos_eq := congrArg Fin.val (R.index_injective hidx)
    simp [windowPos, IndexedAuxiliaryPrefix.posOfNat] at hpos_eq
    have hr := r.2
    dsimp [z] at hr ⊢
    omega
  lowerOutside_ne_lower := by
    exact (R.p0_adj_outsideIndex hpos).1.symm
  lowerOutside_ne_upper := by
    have hne :
        R.p0OutsideIndex hpos ≠
          R.indexAt (z h + 1) (by dsimp [z]; omega) :=
      R.p0OutsideIndex_ne_indexAt hpos (k := z h + 1)
        (by dsimp [z]; omega)
        (by dsimp [z]; omega)
    simpa [pZPlusOneIndex, pZPlusOnePos, IndexedAuxiliaryPrefix.indexAt,
      IndexedAuxiliaryPrefix.posOfNat] using hne
  upperOutside_ne_lower := by
    intro hidx
    have hpos_eq := congrArg Fin.val (R.index_injective hidx.symm)
    simp [p0Pos, IndexedAuxiliaryPrefix.posOfNat] at hpos_eq
  upperOutside_ne_upper := by
    intro hidx
    have hpos_eq := congrArg Fin.val (R.index_injective hidx)
    simp [pZPlusOnePos, IndexedAuxiliaryPrefix.posOfNat] at hpos_eq

/-- Initial extended full invariant for the type-1 loop. -/
noncomputable def TypeOneQStarFamily.initialExtendedFullIterationInvariants
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeOneQStarFamily R hpos Q) :
    TypeOneExtendedFullIterationInvariants (initialIterationInput Q0) where
  full := Q0.initialFullIterationInvariants
  boundary := Q0.initialBoundaryAuxiliaryInvariant

/-- The symmetric current input to a type-2 iteration, immediately before the
proof starts looking for bumps or crosses in the third block.  This is the
type-2 analogue of `IterationInput`; it is kept separate for now because the
existing bump/cross action API is still specialized to the type-1 family. -/
structure TypeTwoIterationInput (R : IndexedAuxiliaryPrefix L h)
    (hpos : 0 < h) {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeTwoQStarFamily R hpos Q) where
  Row : Type
  rowFintype : Fintype Row
  rowDecidableEq : DecidableEq Row
  rowPath : Row → GraphPath G
  linkage : PerfectPathPacking G A B
  rowIndex : Row → linkage.Index
  rowPath_eq_linkage_path :
    ∀ r : Row, rowPath r = linkage.path (rowIndex r)
  linkage_is_block_replacement : Prop
  aux_iso_fixed_outside : AuxGraphsIsomorphic L linkage
  q0_intersection_invariant :
    TypeTwoCurrentRowsInvariant R hpos Q0 Row rowPath

namespace TypeTwoIterationInput

attribute [instance] rowFintype rowDecidableEq

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeTwoQStarFamily R hpos Q}

/-- The edge set of the current type-2 rows in an iteration. -/
noncomputable def rowEdgeSet (I : TypeTwoIterationInput R hpos Q0) :
    Finset (Sym2 V) :=
  Finset.univ.biUnion fun r : I.Row => (I.rowPath r).edgeSet

/-- The maintained graph `Htilde` in the type-2 branch: current rows plus the
fixed type-2 paths. -/
noncomputable def tildeEdgeSet (I : TypeTwoIterationInput R hpos Q0) :
    Finset (Sym2 V) :=
  I.rowEdgeSet ∪ Q0.edgeSet

/-- The current type-2 row paths are pairwise vertex-disjoint. -/
def RowsNodeDisjoint (I : TypeTwoIterationInput R hpos Q0) : Prop :=
  Pairwise fun r s : I.Row => (I.rowPath r).NodeDisjoint (I.rowPath s)

/-- The current type-2 row labels inject into the current linkage index type. -/
def RowIndexInjective (I : TypeTwoIterationInput R hpos Q0) : Prop :=
  Function.Injective I.rowIndex

/-- A chosen order of the maintained type-2 row family by the `z = 2h`
active row positions. -/
structure OrderedRows (I : TypeTwoIterationInput R hpos Q0) where
  order : I.Row ≃ Fin (z h)

/-- Injective row indices imply row-path disjointness for the type-2 current
rows, because they are distinct paths of the current linkage. -/
theorem rowsNodeDisjoint_of_rowIndexInjective
    (I : TypeTwoIterationInput R hpos Q0) (hinj : I.RowIndexInjective) :
    I.RowsNodeDisjoint := by
  intro r s hrs
  have hidx : I.rowIndex r ≠ I.rowIndex s := by
    intro h
    exact hrs (hinj h)
  rw [I.rowPath_eq_linkage_path r, I.rowPath_eq_linkage_path s]
  exact I.linkage.toPathPacking.node_disjoint hidx

end TypeTwoIterationInput

/-- The first symmetric type-2 iteration has rows
`P_{2z+1}, ..., P_{3z}`, the original linkage, and the selected type-2
family `Q0`. -/
noncomputable def initialTypeTwoIterationInput
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeTwoQStarFamily R hpos Q) :
    TypeTwoIterationInput R hpos Q0 where
  Row := Fin (z h)
  rowFintype := inferInstance
  rowDecidableEq := inferInstance
  rowPath := fun i : Fin (z h) =>
    L.path (R.index (windowPos h (2 * z h + 1) (by
      dsimp [z]
      omega) i))
  linkage := L
  rowIndex := fun i : Fin (z h) =>
    R.index (windowPos h (2 * z h + 1) (by
      dsimp [z]
      omega) i)
  rowPath_eq_linkage_path := by
    intro i
    rfl
  linkage_is_block_replacement := True
  aux_iso_fixed_outside := auxGraphsIsomorphic_refl
  q0_intersection_invariant := Q0.initialCurrentRowsInvariant

/-- In the initial symmetric type-2 state, the displayed third-block rows are
pairwise vertex-disjoint because they are distinct paths of the original
linkage. -/
theorem initialTypeTwoIterationInput_rowsNodeDisjoint
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeTwoQStarFamily R hpos Q) :
    (initialTypeTwoIterationInput Q0).RowsNodeDisjoint := by
  classical
  intro i j hij
  have hidx_ne :
      R.index (windowPos h (2 * z h + 1) (by
        dsimp [z]
        omega) i) ≠
        R.index (windowPos h (2 * z h + 1) (by
          dsimp [z]
          omega) j) := by
    intro hidx
    apply hij
    apply Fin.ext
    have hpos :=
      congrArg Fin.val (R.index_injective hidx)
    simp [windowPos] at hpos
    omega
  simpa [TypeTwoIterationInput.RowsNodeDisjoint,
    initialTypeTwoIterationInput] using
    L.toPathPacking.node_disjoint hidx_ne

/-- The initial displayed third-block row labels are injective in the linkage
index type. -/
theorem initialTypeTwoIterationInput_rowIndexInjective
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeTwoQStarFamily R hpos Q) :
    (initialTypeTwoIterationInput Q0).RowIndexInjective := by
  intro i j hij
  apply Fin.ext
  have hpos :=
    congrArg Fin.val (R.index_injective hij)
  simp [windowPos] at hpos
  omega

/-- The initial type-2 row family has its displayed third-block order by
construction. -/
noncomputable def initialTypeTwoIterationInput_orderedRows
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeTwoQStarFamily R hpos Q) :
    (initialTypeTwoIterationInput Q0).OrderedRows where
  order := Equiv.refl (Fin (z h))

/-- The visible row-order and disjointness invariant for a type-2 iteration
state.  This is the symmetric counterpart of
`TypeOneIterationInvariants`. -/
structure TypeTwoIterationInvariants
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    (I : TypeTwoIterationInput R hpos Q0) where
  orderedRows : I.OrderedRows
  rowIndexInjective : I.RowIndexInjective
  rowsNodeDisjoint : I.RowsNodeDisjoint

/-- The auxiliary two-path invariant for the currently active type-2 rows. -/
structure TypeTwoActiveAuxiliaryInvariant
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    (I : TypeTwoIterationInput R hpos Q0)
    (inv : TypeTwoIterationInvariants I) where
  degree_two :
    ∀ r : I.Row,
      DegreeEquals (linkageAuxGraph I.linkage) (I.rowIndex r) 2
  consecutive_adj :
    ∀ ⦃r s : I.Row⦄,
      FinConsecutive (inv.orderedRows.order r) (inv.orderedRows.order s) →
        (linkageAuxGraph I.linkage).Adj (I.rowIndex r) (I.rowIndex s)
  no_chord :
    ∀ ⦃r s : I.Row⦄,
      (linkageAuxGraph I.linkage).Adj (I.rowIndex r) (I.rowIndex s) →
        FinConsecutive (inv.orderedRows.order r) (inv.orderedRows.order s)

/-- Full invariant package for the symmetric type-2 loop. -/
structure TypeTwoFullIterationInvariants
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    (I : TypeTwoIterationInput R hpos Q0) where
  base : TypeTwoIterationInvariants I
  active_aux : TypeTwoActiveAuxiliaryInvariant I base

/-- Boundary auxiliary data for the type-2 loop.

The active type-2 rows are `P_{2z+1}, ..., P_{3z}`; this records that
`P_{2z}` and `P_{3z+1}` remain the two degree-two boundary rows attached to
that active path. -/
structure TypeTwoBoundaryAuxiliaryInvariant
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    (I : TypeTwoIterationInput R hpos Q0)
    (inv : TypeTwoIterationInvariants I) where
  lowerBoundary : I.linkage.Index
  upperBoundary : I.linkage.Index
  lower_path_eq :
    I.linkage.path lowerBoundary = L.path (R.pTwoZIndex hpos)
  upper_path_eq :
    I.linkage.path upperBoundary = L.path (R.pThreeZPlusOneIndex hpos)
  lower_ne_row :
    ∀ r : I.Row, lowerBoundary ≠ I.rowIndex r
  upper_ne_row :
    ∀ r : I.Row, upperBoundary ≠ I.rowIndex r
  lower_degree_two :
    DegreeEquals (linkageAuxGraph I.linkage) lowerBoundary 2
  upper_degree_two :
    DegreeEquals (linkageAuxGraph I.linkage) upperBoundary 2
  lower_adj_first :
    (linkageAuxGraph I.linkage).Adj lowerBoundary
      (I.rowIndex
        (inv.orderedRows.order.symm
          (⟨0, by dsimp [z]; omega⟩ : Fin (z h))))
  last_adj_upper :
    (linkageAuxGraph I.linkage).Adj
      (I.rowIndex
        (inv.orderedRows.order.symm
          (⟨z h - 1, by dsimp [z]; omega⟩ : Fin (z h))))
      upperBoundary

/-- Full type-2 invariant with explicit boundary rows. -/
structure TypeTwoExtendedFullIterationInvariants
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    (I : TypeTwoIterationInput R hpos Q0) where
  full : TypeTwoFullIterationInvariants I
  boundary : TypeTwoBoundaryAuxiliaryInvariant I full.base

/-- The initial type-2 iteration state satisfies the ordered-row,
row-index-injective, and row-disjointness invariants. -/
noncomputable def TypeTwoQStarFamily.initialIterationInvariants
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeTwoQStarFamily R hpos Q) :
    TypeTwoIterationInvariants (initialTypeTwoIterationInput Q0) where
  orderedRows := initialTypeTwoIterationInput_orderedRows Q0
  rowIndexInjective := initialTypeTwoIterationInput_rowIndexInjective Q0
  rowsNodeDisjoint := initialTypeTwoIterationInput_rowsNodeDisjoint Q0

/-- The initial type-2 rows inherit the active auxiliary two-path invariant
from the displayed indexed prefix `R*`, restricted to the third block. -/
noncomputable def TypeTwoQStarFamily.initialActiveAuxiliaryInvariant
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeTwoQStarFamily R hpos Q) :
    TypeTwoActiveAuxiliaryInvariant
      (initialTypeTwoIterationInput Q0) Q0.initialIterationInvariants where
  degree_two := by
    intro r
    simpa [initialTypeTwoIterationInput] using
      R.degree_two (windowPos h (2 * z h + 1) (by dsimp [z]; omega) r)
  consecutive_adj := by
    intro r s hcon
    change (linkageAuxGraph L).Adj
      (R.index (windowPos h (2 * z h + 1) (by dsimp [z]; omega) r))
      (R.index (windowPos h (2 * z h + 1) (by dsimp [z]; omega) s))
    have hcon_rs : FinConsecutive r s := by
      simpa [TypeTwoQStarFamily.initialIterationInvariants,
        initialTypeTwoIterationInput_orderedRows] using hcon
    rcases hcon_rs with hnext | hprev
    · have hadj := R.adj_indexAt_succ
        (k := 2 * z h + 1 + r.1) (by
          have hr := r.2
          dsimp [z] at hr ⊢
          omega)
      have hsval : s.1 = r.1 + 1 := by omega
      rw [R.block3_index_eq_indexAt r, R.block3_index_eq_indexAt s]
      have hright :
          R.indexAt (2 * z h + 1 + s.1) (by
            have hs := s.2
            dsimp [z] at hs ⊢
            omega) =
            R.indexAt (2 * z h + 1 + r.1 + 1) (by
              have hr := r.2
              dsimp [z] at hr ⊢
              omega) := by
        apply congrArg R.index
        apply Fin.ext
        simp [IndexedAuxiliaryPrefix.posOfNat]
        omega
      rw [hright]
      exact hadj
    · have hadj := R.adj_indexAt_succ
        (k := 2 * z h + 1 + s.1) (by
          have hs := s.2
          dsimp [z] at hs ⊢
          omega)
      have hrval : r.1 = s.1 + 1 := by omega
      rw [R.block3_index_eq_indexAt r, R.block3_index_eq_indexAt s]
      have hleft :
          R.indexAt (2 * z h + 1 + r.1) (by
            have hr := r.2
            dsimp [z] at hr ⊢
            omega) =
            R.indexAt (2 * z h + 1 + s.1 + 1) (by
              have hs := s.2
              dsimp [z] at hs ⊢
              omega) := by
        apply congrArg R.index
        apply Fin.ext
        simp [IndexedAuxiliaryPrefix.posOfNat]
        omega
      rw [hleft]
      exact hadj.symm
  no_chord := by
    intro r s hadj
    change FinConsecutive r s
    by_cases hrs : r = s
    · subst s
      have hloop :
          (linkageAuxGraph L).Adj
            (R.index (windowPos h (2 * z h + 1) (by dsimp [z]; omega) r))
            (R.index (windowPos h (2 * z h + 1) (by dsimp [z]; omega) r)) := by
        exact hadj
      exact False.elim ((linkageAuxGraph L).loopless.irrefl
        (R.index (windowPos h (2 * z h + 1) (by dsimp [z]; omega) r)) hloop)
    · have hadj' :
          (linkageAuxGraph L).Adj
            (R.indexAt (2 * z h + 1 + r.1) (by
              have hr := r.2
              dsimp [z] at hr ⊢
              omega))
            (R.indexAt (2 * z h + 1 + s.1) (by
              have hs := s.2
              dsimp [z] at hs ⊢
              omega)) := by
        simpa [initialTypeTwoIterationInput, R.block3_index_eq_indexAt r,
          R.block3_index_eq_indexAt s] using hadj
      rcases R.neighbor_of_interior_indexAt
          (k := 2 * z h + 1 + r.1)
          (by
            dsimp [z]
            omega)
          (by
            have hr := r.2
            dsimp [z] at hr ⊢
            omega)
          (j := R.indexAt (2 * z h + 1 + s.1) (by
            have hs := s.2
            dsimp [z] at hs ⊢
            omega))
          hadj' with hleft | hright
      · have hpos :
            2 * z h + 1 + s.1 =
              2 * z h + 1 + r.1 - 1 := by
          exact (R.indexAt_eq_indexAt_iff _ _).1 hleft
        right
        omega
      · have hpos :
            2 * z h + 1 + s.1 =
              2 * z h + 1 + r.1 + 1 := by
          exact (R.indexAt_eq_indexAt_iff _ _).1 hright
        left
        omega

/-- The initial type-2 iteration state satisfies the full invariant package. -/
noncomputable def TypeTwoQStarFamily.initialFullIterationInvariants
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeTwoQStarFamily R hpos Q) :
    TypeTwoFullIterationInvariants (initialTypeTwoIterationInput Q0) where
  base := Q0.initialIterationInvariants
  active_aux := Q0.initialActiveAuxiliaryInvariant

/-- The initial type-2 state also has the two symmetric fixed boundary rows
attached to the displayed third-block active row path. -/
noncomputable def TypeTwoQStarFamily.initialBoundaryAuxiliaryInvariant
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeTwoQStarFamily R hpos Q) :
    TypeTwoBoundaryAuxiliaryInvariant
      (initialTypeTwoIterationInput Q0) Q0.initialIterationInvariants where
  lowerBoundary := R.pTwoZIndex hpos
  upperBoundary := R.pThreeZPlusOneIndex hpos
  lower_path_eq := rfl
  upper_path_eq := rfl
  lower_ne_row := by
    intro r hidx
    have hpos_eq := congrArg Fin.val (R.index_injective hidx)
    simp [pTwoZPos, windowPos] at hpos_eq
    omega
  upper_ne_row := by
    intro r hidx
    have hpos_eq := congrArg Fin.val (R.index_injective hidx)
    simp [pThreeZPlusOnePos, windowPos] at hpos_eq
    have hr := r.2
    dsimp [z] at hr
    omega
  lower_degree_two := by
    simpa [initialTypeTwoIterationInput, pTwoZIndex] using
      R.degree_two (pTwoZPos h hpos)
  upper_degree_two := by
    simpa [initialTypeTwoIterationInput, pThreeZPlusOneIndex] using
      R.degree_two (pThreeZPlusOnePos h hpos)
  lower_adj_first := by
    have hadj := R.adj_indexAt_succ (k := 2 * z h) (by
      dsimp [z]
      omega)
    change (linkageAuxGraph L).Adj
      (R.pTwoZIndex hpos)
      (R.index (windowPos h (2 * z h + 1) (by dsimp [z]; omega)
        (⟨0, by dsimp [z]; omega⟩ : Fin (z h))))
    have hleft :
        R.pTwoZIndex hpos =
          R.indexAt (2 * z h) (by dsimp [z]; omega) := by
      apply congrArg R.index
      apply Fin.ext
      simp [pTwoZPos, IndexedAuxiliaryPrefix.posOfNat]
    have hright :
        R.index (windowPos h (2 * z h + 1) (by dsimp [z]; omega)
          (⟨0, by dsimp [z]; omega⟩ : Fin (z h))) =
          R.indexAt (2 * z h + 1) (by dsimp [z]; omega) := by
      apply congrArg R.index
      apply Fin.ext
      simp [windowPos, IndexedAuxiliaryPrefix.posOfNat]
    rw [hleft, hright]
    exact hadj
  last_adj_upper := by
    have hadj := R.adj_indexAt_succ (k := 3 * z h) (by
      dsimp [z]
      omega)
    change (linkageAuxGraph L).Adj
      (R.index (windowPos h (2 * z h + 1) (by dsimp [z]; omega)
        (⟨z h - 1, by dsimp [z]; omega⟩ : Fin (z h))))
      (R.pThreeZPlusOneIndex hpos)
    have hleft :
        R.index (windowPos h (2 * z h + 1) (by dsimp [z]; omega)
          (⟨z h - 1, by dsimp [z]; omega⟩ : Fin (z h))) =
          R.indexAt (3 * z h) (by dsimp [z]; omega) := by
      apply congrArg R.index
      apply Fin.ext
      have hzpos : 0 < z h := by
        dsimp [z]
        omega
      simp [windowPos, IndexedAuxiliaryPrefix.posOfNat]
      omega
    have hright :
        R.pThreeZPlusOneIndex hpos =
          R.indexAt (3 * z h + 1) (by dsimp [z]; omega) := by
      apply congrArg R.index
      apply Fin.ext
      simp [pThreeZPlusOnePos, IndexedAuxiliaryPrefix.posOfNat]
    rw [hleft, hright]
    exact hadj

/-- Initial extended full invariant for the type-2 loop. -/
noncomputable def TypeTwoQStarFamily.initialExtendedFullIterationInvariants
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeTwoQStarFamily R hpos Q) :
    TypeTwoExtendedFullIterationInvariants (initialTypeTwoIterationInput Q0) where
  full := Q0.initialFullIterationInvariants
  boundary := Q0.initialBoundaryAuxiliaryInvariant

/-- Symmetric initial setup for the type-2 majority branch.  The later proof
can either handle this branch symmetrically or normalize it by reversing the
chosen displayed prefix; this structure keeps the branch explicit instead of
discarding it under an informal “without loss of generality”. -/
structure TypeTwoIterationSetup (R : IndexedAuxiliaryPrefix L h)
    (hpos : 0 < h) (Q : PerfectPathPacking G R.X R.Y) where
  Q0 : TypeTwoQStarFamily R hpos Q
  row_invariant :
    TypeTwoCurrentRowsInvariant R hpos Q0 (Fin (z h))
      (fun i : Fin (z h) =>
        L.path (R.index (windowPos h (2 * z h + 1) (by
          dsimp [z]
          omega) i)))

/-- Build the symmetric type-2 setup from a large type-2 subfamily. -/
noncomputable def TypeTwoQStarFamily.toIterationSetup
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeTwoQStarFamily R hpos Q) :
    TypeTwoIterationSetup R hpos Q where
  Q0 := Q0
  row_invariant := Q0.initialCurrentRowsInvariant

namespace TypeTwoIterationSetup

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}

/-- The explicit initial iteration input carried by a type-2 setup. -/
noncomputable def input (S : TypeTwoIterationSetup R hpos Q) :
    TypeTwoIterationInput R hpos S.Q0 :=
  initialTypeTwoIterationInput S.Q0

/-- The explicit type-2 setup input is the canonical initial third-block
input by construction. -/
theorem input_is_initial (S : TypeTwoIterationSetup R hpos Q) :
    S.input = initialTypeTwoIterationInput S.Q0 := rfl

/-- The row-order/disjointness invariant of the explicit type-2 input. -/
noncomputable def initialIterationInvariants
    (S : TypeTwoIterationSetup R hpos Q) :
    TypeTwoIterationInvariants S.input :=
  S.Q0.initialIterationInvariants

/-- The active auxiliary invariant of the explicit type-2 input. -/
noncomputable def initialFullIterationInvariants
    (S : TypeTwoIterationSetup R hpos Q) :
    TypeTwoFullIterationInvariants S.input :=
  S.Q0.initialFullIterationInvariants

/-- The boundary-aware full invariant of the explicit type-2 input. -/
noncomputable def initialExtendedFullIterationInvariants
    (S : TypeTwoIterationSetup R hpos Q) :
    TypeTwoExtendedFullIterationInvariants S.input :=
  S.Q0.initialExtendedFullIterationInvariants

end TypeTwoIterationSetup

namespace TypedTransversalSystem

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}

/-- The page-60 majority sentence in the form needed to start the iteration:
either the type-1 case supplies the initial iteration input, or the symmetric
type-2 majority case is available. -/
theorem exists_typeOneIterationSetup_or_typeTwoFamily
    (T : TypedTransversalSystem R hpos Q) (hQcard : Q.card = z h) :
    Nonempty (TypeOneIterationSetup R hpos Q) ∨
      Nonempty (TypeTwoQStarFamily R hpos Q) := by
  rcases T.exists_large_uniform_qstar_family hQcard with h1 | h2
  · rcases h1 with ⟨Q0⟩
    exact Or.inl ⟨Q0.toIterationSetup⟩
  · exact Or.inr h2

/-- Fully packaged version of the page-60 majority split: either the type-1
iteration setup starts immediately, or the symmetric type-2 iteration setup
does. -/
theorem exists_typeOneIterationSetup_or_typeTwoIterationSetup
    (T : TypedTransversalSystem R hpos Q) (hQcard : Q.card = z h) :
    Nonempty (TypeOneIterationSetup R hpos Q) ∨
      Nonempty (TypeTwoIterationSetup R hpos Q) := by
  rcases T.exists_typeOneIterationSetup_or_typeTwoFamily hQcard with h1 | h2
  · exact Or.inl h1
  · rcases h2 with ⟨Q0⟩
    exact Or.inr ⟨Q0.toIterationSetup⟩

/-- Combined form of the page-60 selection step: once every transversal path
has a type-1 or type-2 `Q*` certificate, and there are `z = 2h` transversal
paths, the proof can start the type-1 iteration or keep the symmetric type-2
majority branch. -/
theorem exists_typeOneIterationSetup_or_typeTwoFamily_of_pathwise_dichotomy
    (hpath : PathwiseTypeClassification R hpos Q)
    (hQcard : Q.card = z h) :
    Nonempty (TypeOneIterationSetup R hpos Q) ∨
      Nonempty (TypeTwoQStarFamily R hpos Q) := by
  let T := TypedTransversalSystem.of_pathwise_dichotomy R hpos Q hpath
  exact T.exists_typeOneIterationSetup_or_typeTwoFamily hQcard

/-- Fully packaged page-60 selection step from the pathwise `Q*`
classification. -/
theorem exists_typeOneIterationSetup_or_typeTwoIterationSetup_of_pathwise_dichotomy
    (hpath : PathwiseTypeClassification R hpos Q)
    (hQcard : Q.card = z h) :
    Nonempty (TypeOneIterationSetup R hpos Q) ∨
      Nonempty (TypeTwoIterationSetup R hpos Q) := by
  let T := TypedTransversalSystem.of_pathwise_dichotomy R hpos Q hpath
  exact T.exists_typeOneIterationSetup_or_typeTwoIterationSetup hQcard

end TypedTransversalSystem

/-- The package of data available immediately before the proof introduces
bumps, assuming the page-60 pathwise type classification has been proved for
the chosen transversal packing. -/
structure Page60BeforeBumpSetup [Fintype V]
    (L : PerfectPathPacking G A B) (h : ℕ) (hpos : 0 < h) where
  R : IndexedAuxiliaryPrefix L h
  Q : PerfectPathPacking G R.X R.Y
  Q_card : Q.card = z h
  Q_staysIn_univ : Q.toPathPacking.StaysIn Finset.univ
  trace : ∀ i : Q.Index, CompleteLinkageContactTrace R (Q.path i)
  trace_startsIn_block2 :
    ∀ i : Q.Index, (trace i).toLinkageContactTrace.StartsIn R.block2IndexSet
  trace_endsIn_block4 :
    ∀ i : Q.Index, (trace i).toLinkageContactTrace.EndsIn R.block4IndexSet
  branch :
    Nonempty (TypeOneIterationSetup R hpos Q) ∨
      Nonempty (TypeTwoIterationSetup R hpos Q)

/-- Full orchestration of the proof up to the line before “A bump”, once the
pathwise `Q*` type classification has been established.  This theorem combines
the bad-linkage prefix, linkedness, transversal packing, pathwise type
selection, majority counting, and initial iteration input construction. -/
theorem exists_page60BeforeBumpSetup_of_pathwise_dichotomy [Fintype V]
    {L : PerfectPathPacking G A B} {h : ℕ}
    (hbad : ¬ GoodLinkage L h)
    (hlink : NodeLinkedIn G Finset.univ A B)
    (hpos : 0 < h)
    (hclassify :
      ∀ (R : IndexedAuxiliaryPrefix L h)
        (Q : PerfectPathPacking G R.X R.Y),
        Q.card = z h →
          Q.toPathPacking.StaysIn Finset.univ →
            PathwiseTypeClassification R hpos Q) :
    Nonempty (Page60BeforeBumpSetup L h hpos) := by
  classical
  rcases exists_firstParagraph_setup (L := L) (h := h) hbad hlink with
    ⟨R, Q, hQcard, hQstay⟩
  let trace : ∀ i : Q.Index, CompleteLinkageContactTrace R (Q.path i) :=
    fun i =>
      Classical.choice
        (pathwiseCompleteContactTracesOfEndpointContacts_of_linked
          (L := L) (h := h) hlink (R := R) (Q := Q) i)
  have hstart :
      ∀ i : Q.Index,
        (trace i).toLinkageContactTrace.StartsIn R.block2IndexSet := by
    intro i
    exact LinkageContactTrace.startsIn_block2_of_transversal
      (R := R) (Qpack := Q) i (trace i).toLinkageContactTrace
  have hend :
      ∀ i : Q.Index,
        (trace i).toLinkageContactTrace.EndsIn R.block4IndexSet := by
    intro i
    exact LinkageContactTrace.endsIn_block4_of_transversal
      (R := R) (Qpack := Q) i (trace i).toLinkageContactTrace
  have hbranch :
      Nonempty (TypeOneIterationSetup R hpos Q) ∨
        Nonempty (TypeTwoIterationSetup R hpos Q) :=
    TypedTransversalSystem.exists_typeOneIterationSetup_or_typeTwoIterationSetup_of_pathwise_dichotomy
        (R := R) (hpos := hpos) (Q := Q)
        (hclassify R Q hQcard hQstay) hQcard
  exact ⟨{
    R := R
    Q := Q
    Q_card := hQcard
    Q_staysIn_univ := hQstay
    trace := trace
    trace_startsIn_block2 := hstart
    trace_endsIn_block4 := hend
    branch := hbranch
  }⟩

/-- Same orchestration as
`exists_page60BeforeBumpSetup_of_pathwise_dichotomy`, but with the local
extraction stated in the sharper `Q*`-segment form. -/
theorem exists_page60BeforeBumpSetup_of_cleanSegmentClassification [Fintype V]
    {L : PerfectPathPacking G A B} {h : ℕ}
    (hbad : ¬ GoodLinkage L h)
    (hlink : NodeLinkedIn G Finset.univ A B)
    (hpos : 0 < h)
    (hclassify :
      ∀ (R : IndexedAuxiliaryPrefix L h)
        (Q : PerfectPathPacking G R.X R.Y),
        Q.card = z h →
          Q.toPathPacking.StaysIn Finset.univ →
            PathwiseCleanSegmentClassification R hpos Q) :
    Nonempty (Page60BeforeBumpSetup L h hpos) := by
  refine exists_page60BeforeBumpSetup_of_pathwise_dichotomy
    (L := L) (h := h) hbad hlink hpos ?_
  intro R Q hQcard hQstay
  exact pathwiseTypeClassification_of_cleanSegmentClassification
    (hclassify R Q hQcard hQstay)

/-- Orchestration from the paper-faithful last/first-hit extraction form. -/
theorem exists_page60BeforeBumpSetup_of_lastFirstClassification [Fintype V]
    {L : PerfectPathPacking G A B} {h : ℕ}
    (hbad : ¬ GoodLinkage L h)
    (hlink : NodeLinkedIn G Finset.univ A B)
    (hpos : 0 < h)
    (hclassify :
      ∀ (R : IndexedAuxiliaryPrefix L h)
        (Q : PerfectPathPacking G R.X R.Y),
        Q.card = z h →
          Q.toPathPacking.StaysIn Finset.univ →
            PathwiseLastFirstClassification R hpos Q) :
    Nonempty (Page60BeforeBumpSetup L h hpos) := by
  refine exists_page60BeforeBumpSetup_of_cleanSegmentClassification
    (L := L) (h := h) hbad hlink hpos ?_
  intro R Q hQcard hQstay
  exact pathwiseCleanSegmentClassification_of_lastFirstClassification
    (hclassify R Q hQcard hQstay)

/-- Orchestration from the page-59 branch-data form: for each transversal
path, it is enough to provide the data needed in the two possible cases for
the last middle-boundary hit. -/
theorem exists_page60BeforeBumpSetup_of_lastHitBranchData [Fintype V]
    {L : PerfectPathPacking G A B} {h : ℕ}
    (hbad : ¬ GoodLinkage L h)
    (hlink : NodeLinkedIn G Finset.univ A B)
    (hpos : 0 < h)
    (hclassify :
      ∀ (R : IndexedAuxiliaryPrefix L h)
        (Q : PerfectPathPacking G R.X R.Y),
        Q.card = z h →
          Q.toPathPacking.StaysIn Finset.univ →
            PathwiseLastHitBranchData R hpos Q) :
    Nonempty (Page60BeforeBumpSetup L h hpos) := by
  refine exists_page60BeforeBumpSetup_of_lastFirstClassification
    (L := L) (h := h) hbad hlink hpos ?_
  intro R Q hQcard hQstay
  exact pathwiseLastFirstClassification_of_lastHitBranchData
    (hclassify R Q hQcard hQstay)

/-- Self-contained page-59/page-60 construction up to the line before
“A bump”.  Starting from a bad linkage and linked terminal sets, we obtain the
displayed auxiliary prefix, the `X`--`Y` transversal packing, the complete
contact traces, the last-middle-boundary split for every transversal path, and
finally the majority type-1/type-2 iteration setup. -/
theorem exists_page60BeforeBumpSetup [Fintype V]
    {L : PerfectPathPacking G A B} {h : ℕ}
    (hbad : ¬ GoodLinkage L h)
    (hlink : NodeLinkedIn G Finset.univ A B)
    (hpos : 0 < h) :
    Nonempty (Page60BeforeBumpSetup L h hpos) := by
  classical
  refine exists_page60BeforeBumpSetup_of_lastHitBranchData
    (L := L) (h := h) hbad hlink hpos ?_
  intro R Q _hQcard _hQstay i
  let T : CompleteLinkageContactTrace R (Q.path i) :=
    Classical.choice
      (pathwiseCompleteContactTracesOfEndpointContacts_of_linked
        (L := L) (h := h) hlink (R := R) (Q := Q) i)
  have hstart :
      T.toLinkageContactTrace.StartsIn R.block2IndexSet :=
    LinkageContactTrace.startsIn_block2_of_transversal
      (R := R) (Qpack := Q) i T.toLinkageContactTrace
  have hend :
      T.toLinkageContactTrace.EndsIn R.block4IndexSet :=
    LinkageContactTrace.endsIn_block4_of_transversal
      (R := R) (Qpack := Q) i T.toLinkageContactTrace
  exact lastHitBranchData_of_completeTrace
    (L := L) (R := R) (hpos := hpos) T hstart hend

/-- Orchestration from the ordered-contact extraction form. -/
theorem exists_page60BeforeBumpSetup_of_orderedSegmentClassification [Fintype V]
    {L : PerfectPathPacking G A B} {h : ℕ}
    (hbad : ¬ GoodLinkage L h)
    (hlink : NodeLinkedIn G Finset.univ A B)
    (hpos : 0 < h)
    (hclassify :
      ∀ (R : IndexedAuxiliaryPrefix L h)
        (Q : PerfectPathPacking G R.X R.Y),
        Q.card = z h →
          Q.toPathPacking.StaysIn Finset.univ →
            PathwiseOrderedSegmentClassification R hpos Q) :
    Nonempty (Page60BeforeBumpSetup L h hpos) := by
  refine exists_page60BeforeBumpSetup_of_cleanSegmentClassification
    (L := L) (h := h) hbad hlink hpos ?_
  intro R Q hQcard hQstay
  exact pathwiseCleanSegmentClassification_of_orderedSegmentClassification
    (hclassify R Q hQcard hQstay)

/-- Consume the page-60 majority split by supplying handlers for the type-1
and symmetric type-2 branches.  This isolates the only remaining branch-level
choice after the proof reaches the line before “A bump”. -/
theorem Page60BeforeBumpSetup.reroutingConclusion_of_branch_handlers
    [Fintype V] {L : PerfectPathPacking G A B} {h : ℕ}
    {hpos : 0 < h} (S : Page60BeforeBumpSetup L h hpos)
    (hTypeOne :
      ∀ (_T : TypeOneIterationSetup S.R hpos S.Q),
        ReroutingConclusion G h L)
    (hTypeTwo :
      ∀ (_T : TypeTwoIterationSetup S.R hpos S.Q),
        ReroutingConclusion G h L) :
    ReroutingConclusion G h L := by
  rcases S.branch with h1 | h2
  · rcases h1 with ⟨T⟩
    exact hTypeOne T
  · rcases h2 with ⟨T⟩
    exact hTypeTwo T

/-- Branch orchestration where the symmetric type-2 handler receives the
explicit third-block initial iteration input and its boundary-aware full
invariant.  This is the first non-opaque interface for the type-2 branch. -/
theorem Page60BeforeBumpSetup.reroutingConclusion_of_branch_handlers_typeTwoInput
    [Fintype V] {L : PerfectPathPacking G A B} {h : ℕ}
    {hpos : 0 < h} (S : Page60BeforeBumpSetup L h hpos)
    (hTypeOne :
      ∀ (_T : TypeOneIterationSetup S.R hpos S.Q),
        ReroutingConclusion G h L)
    (hTypeTwo :
      ∀ (T : TypeTwoIterationSetup S.R hpos S.Q),
        TypeTwoExtendedFullIterationInvariants T.input →
          ReroutingConclusion G h L) :
    ReroutingConclusion G h L :=
  S.reroutingConclusion_of_branch_handlers hTypeOne
    (fun T => hTypeTwo T T.initialExtendedFullIterationInvariants)

/-- Theorem-shaped orchestration after the page-59/page-60 construction:
to prove the rerouting conclusion, it remains to prove it for both majority
branches produced by the selected transversal system. -/
theorem reroutingConclusion_of_page60_branch_handlers [Fintype V]
    {L : PerfectPathPacking G A B} {h : ℕ}
    (hbad : ¬ GoodLinkage L h)
    (hlink : NodeLinkedIn G Finset.univ A B)
    (hpos : 0 < h)
    (hTypeOne :
      ∀ {R : IndexedAuxiliaryPrefix L h}
        {Q : PerfectPathPacking G R.X R.Y},
        TypeOneIterationSetup R hpos Q → ReroutingConclusion G h L)
    (hTypeTwo :
      ∀ {R : IndexedAuxiliaryPrefix L h}
        {Q : PerfectPathPacking G R.X R.Y},
        TypeTwoIterationSetup R hpos Q → ReroutingConclusion G h L) :
    ReroutingConclusion G h L := by
  rcases exists_page60BeforeBumpSetup
      (L := L) (h := h) hbad hlink hpos with ⟨S⟩
  exact S.reroutingConclusion_of_branch_handlers
    (fun T => hTypeOne T) (fun T => hTypeTwo T)

/-- Theorem-shaped orchestration with a concrete type-2 initial input and
extended invariant exposed to the symmetric branch handler. -/
theorem reroutingConclusion_of_page60_branch_handlers_typeTwoInput [Fintype V]
    {L : PerfectPathPacking G A B} {h : ℕ}
    (hbad : ¬ GoodLinkage L h)
    (hlink : NodeLinkedIn G Finset.univ A B)
    (hpos : 0 < h)
    (hTypeOne :
      ∀ {R : IndexedAuxiliaryPrefix L h}
        {Q : PerfectPathPacking G R.X R.Y},
        TypeOneIterationSetup R hpos Q → ReroutingConclusion G h L)
    (hTypeTwo :
      ∀ {R : IndexedAuxiliaryPrefix L h}
        {Q : PerfectPathPacking G R.X R.Y}
        (T : TypeTwoIterationSetup R hpos Q),
        TypeTwoExtendedFullIterationInvariants T.input →
          ReroutingConclusion G h L) :
    ReroutingConclusion G h L := by
  rcases exists_page60BeforeBumpSetup
      (L := L) (h := h) hbad hlink hpos with ⟨S⟩
  exact S.reroutingConclusion_of_branch_handlers_typeTwoInput
    (fun T => hTypeOne T) (fun T Inv => hTypeTwo T Inv)

/-- The initial maintained graph `Htilde` is the union of the original first
block `P_1` and the fixed type-1 family `Q0`. -/
noncomputable def initialTildeEdgeSet
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeOneQStarFamily R hpos Q) : Finset (Sym2 V) :=
  (initialIterationInput Q0).tildeEdgeSet

/-- The outcome promised for a single simplifying action before the bump/cross
definitions are introduced: either the current linkage is rerouted to one with
fewer degree-two vertices in the auxiliary graph, or the action produces a
valid next iteration input with a strictly smaller maintained graph `Htilde`. -/
def SimplifyingActionOutcome
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0) : Prop :=
  (∃ L'' : PerfectPathPacking G A B,
    linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount I.linkage) ∨
    ∃ I' : IterationInput R hpos Q0,
      I'.tildeEdgeSet.card < I.tildeEdgeSet.card

/-- The strict descent relation used in the bump/cross loop: the maintained
graph `H̃` loses at least one edge. -/
def TildeEdgeDescent
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I' I : IterationInput R hpos Q0) : Prop :=
  I'.tildeEdgeSet.card < I.tildeEdgeSet.card

/-- The `H̃`-descent branch is well-founded, because it is measured by a
natural-number edge count. -/
theorem tildeEdgeDescent_wf
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q} :
    WellFounded
      (fun I' I : IterationInput R hpos Q0 => TildeEdgeDescent I' I) :=
  InvImage.wf (fun I : IterationInput R hpos Q0 =>
    I.tildeEdgeSet.card) <| (Nat.lt_wfRel).2

/-- If no immediate degree-drop branch is available, a simplifying action
must move to a strictly smaller maintained graph. -/
theorem SimplifyingActionOutcome.exists_tilde_descent_of_no_degree_drop
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    (H : SimplifyingActionOutcome I)
    (hno_drop :
      ¬ ∃ L'' : PerfectPathPacking G A B,
        linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount I.linkage) :
    ∃ I' : IterationInput R hpos Q0, TildeEdgeDescent I' I := by
  rcases H with hdrop | hdesc
  · exact False.elim (hno_drop hdrop)
  · exact hdesc

/-- Abstract termination principle for the bump/cross loop.  If every
nonterminal iteration either gives a degree drop or a strict `H̃` descent, then
starting from any iteration we eventually reach a terminal iteration or a
degree-drop iteration.  This is the finite-descent core of the paper's loop
termination argument. -/
theorem exists_terminal_or_degree_drop_of_simplifying_actions
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (Terminal : IterationInput R hpos Q0 → Prop)
    (hstep :
      ∀ I : IterationInput R hpos Q0,
        ¬ Terminal I → SimplifyingActionOutcome I)
    (I₀ : IterationInput R hpos Q0) :
    ∃ I : IterationInput R hpos Q0,
      Terminal I ∨
        ∃ L'' : PerfectPathPacking G A B,
          linkageAuxDegreeTwoCount L'' <
            linkageAuxDegreeTwoCount I.linkage := by
  classical
  let motive : IterationInput R hpos Q0 → Prop := fun I =>
    ∃ J : IterationInput R hpos Q0,
      Terminal J ∨
        ∃ L'' : PerfectPathPacking G A B,
          linkageAuxDegreeTwoCount L'' <
            linkageAuxDegreeTwoCount J.linkage
  change motive I₀
  refine (tildeEdgeDescent_wf (R := R) (hpos := hpos)
    (Q0 := Q0)).induction (C := motive) I₀ ?_
  intro I ih
  by_cases hterm : Terminal I
  · exact ⟨I, Or.inl hterm⟩
  · rcases hstep I hterm with hdrop | hnext
    · exact ⟨I, Or.inr hdrop⟩
    · rcases hnext with ⟨I', hlt⟩
      exact ih I' hlt

/-- Invariant-preserving variant of a simplifying action: the degree-drop
branch is unchanged, but the successor branch carries the explicit row-order,
row-index-injectivity, and row-disjointness invariant needed later by the
terminal grid construction. -/
def InvariantSimplifyingActionOutcome
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0) : Prop :=
  (∃ L'' : PerfectPathPacking G A B,
    linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount I.linkage) ∨
    ∃ I' : IterationInput R hpos Q0,
      Nonempty (TypeOneIterationInvariants I') ∧ TildeEdgeDescent I' I

/-- Full-invariant-preserving variant of a simplifying action.

Compared with `InvariantSimplifyingActionOutcome`, the successor branch carries
the active auxiliary two-path invariant as well as the row bookkeeping.  This
is the loop form needed once the terminal no-chord condition is no longer
passed as separate proof data. -/
def FullInvariantSimplifyingActionOutcome
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0) : Prop :=
  (∃ L'' : PerfectPathPacking G A B,
    linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount I.linkage) ∨
    ∃ I' : IterationInput R hpos Q0,
      Nonempty (TypeOneFullIterationInvariants I') ∧ TildeEdgeDescent I' I

/-- Boundary-aware full-invariant-preserving variant of a simplifying action.

The successor branch carries the active row two-path together with the two
fixed boundary rows `P₀` and `P_{z+1}`.  This is the exact invariant shape
needed for the first/last-row instances of the Figure 7 and Figure 8 local
arguments. -/
def ExtendedFullInvariantSimplifyingActionOutcome
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0) : Prop :=
  (∃ L'' : PerfectPathPacking G A B,
    linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount I.linkage) ∨
    ∃ I' : IterationInput R hpos Q0,
      Nonempty (TypeOneExtendedFullIterationInvariants I') ∧
        TildeEdgeDescent I' I

/-- Invariant-aware finite descent for the bump/cross loop.

This is the loop form needed for the fully self-contained terminal argument:
starting from an invariant state, every nonterminal non-degree-drop action
must return an invariant successor with a strictly smaller maintained graph
`H̃`.  The well-founded measure is still just `|E(H̃)|`. -/
theorem exists_terminal_or_degree_drop_of_invariant_actions
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (Terminal : IterationInput R hpos Q0 → Prop)
    (hstep :
      ∀ I : IterationInput R hpos Q0,
        TypeOneIterationInvariants I →
          ¬ Terminal I → InvariantSimplifyingActionOutcome I)
    (I₀ : IterationInput R hpos Q0)
    (Inv₀ : TypeOneIterationInvariants I₀) :
    ∃ I : IterationInput R hpos Q0,
      Nonempty (TypeOneIterationInvariants I) ∧
        (Terminal I ∨
          ∃ L'' : PerfectPathPacking G A B,
            linkageAuxDegreeTwoCount L'' <
              linkageAuxDegreeTwoCount I.linkage) := by
  classical
  let motive : IterationInput R hpos Q0 → Prop := fun I =>
    Nonempty (TypeOneIterationInvariants I) →
      ∃ J : IterationInput R hpos Q0,
        Nonempty (TypeOneIterationInvariants J) ∧
          (Terminal J ∨
            ∃ L'' : PerfectPathPacking G A B,
              linkageAuxDegreeTwoCount L'' <
                linkageAuxDegreeTwoCount J.linkage)
  have hmain : motive I₀ := by
    refine (tildeEdgeDescent_wf (R := R) (hpos := hpos)
      (Q0 := Q0)).induction (C := motive) I₀ ?_
    intro I ih InvNE
    rcases InvNE with ⟨Inv⟩
    by_cases hterm : Terminal I
    · exact ⟨I, ⟨Inv⟩, Or.inl hterm⟩
    · rcases hstep I Inv hterm with hdrop | hnext
      · exact ⟨I, ⟨Inv⟩, Or.inr hdrop⟩
      · rcases hnext with ⟨I', Inv', hlt⟩
        exact ih I' hlt Inv'
  exact hmain ⟨Inv₀⟩

/-- Full-invariant finite descent for the bump/cross loop.

This is the same well-founded `|E(H̃)|` descent as
`exists_terminal_or_degree_drop_of_invariant_actions`, but every successor in
the nonterminating branch preserves the active auxiliary two-path invariant.
Consequently the terminal state carries enough data to prove the no-chord
hypothesis used in Claims B.2 and B.3. -/
theorem exists_terminal_or_degree_drop_of_full_invariant_actions
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (Terminal : IterationInput R hpos Q0 → Prop)
    (hstep :
      ∀ I : IterationInput R hpos Q0,
        TypeOneFullIterationInvariants I →
          ¬ Terminal I → FullInvariantSimplifyingActionOutcome I)
    (I₀ : IterationInput R hpos Q0)
    (Inv₀ : TypeOneFullIterationInvariants I₀) :
    ∃ I : IterationInput R hpos Q0,
      Nonempty (TypeOneFullIterationInvariants I) ∧
        (Terminal I ∨
          ∃ L'' : PerfectPathPacking G A B,
            linkageAuxDegreeTwoCount L'' <
              linkageAuxDegreeTwoCount I.linkage) := by
  classical
  let motive : IterationInput R hpos Q0 → Prop := fun I =>
    Nonempty (TypeOneFullIterationInvariants I) →
      ∃ J : IterationInput R hpos Q0,
        Nonempty (TypeOneFullIterationInvariants J) ∧
          (Terminal J ∨
            ∃ L'' : PerfectPathPacking G A B,
              linkageAuxDegreeTwoCount L'' <
                linkageAuxDegreeTwoCount J.linkage)
  have hmain : motive I₀ := by
    refine (tildeEdgeDescent_wf (R := R) (hpos := hpos)
      (Q0 := Q0)).induction (C := motive) I₀ ?_
    intro I ih InvNE
    rcases InvNE with ⟨Inv⟩
    by_cases hterm : Terminal I
    · exact ⟨I, ⟨Inv⟩, Or.inl hterm⟩
    · rcases hstep I Inv hterm with hdrop | hnext
      · exact ⟨I, ⟨Inv⟩, Or.inr hdrop⟩
      · rcases hnext with ⟨I', Inv', hlt⟩
        exact ih I' hlt Inv'
  exact hmain ⟨Inv₀⟩

/-- Boundary-aware full-invariant finite descent for the bump/cross loop.

This is the same descent on `|E(H̃)|`, but the nonterminating branch preserves
the boundary auxiliary data as well as the active two-path. -/
theorem exists_terminal_or_degree_drop_of_extended_full_invariant_actions
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (Terminal : IterationInput R hpos Q0 → Prop)
    (hstep :
      ∀ I : IterationInput R hpos Q0,
        TypeOneExtendedFullIterationInvariants I →
          ¬ Terminal I → ExtendedFullInvariantSimplifyingActionOutcome I)
    (I₀ : IterationInput R hpos Q0)
    (Inv₀ : TypeOneExtendedFullIterationInvariants I₀) :
    ∃ I : IterationInput R hpos Q0,
      Nonempty (TypeOneExtendedFullIterationInvariants I) ∧
        (Terminal I ∨
          ∃ L'' : PerfectPathPacking G A B,
            linkageAuxDegreeTwoCount L'' <
              linkageAuxDegreeTwoCount I.linkage) := by
  classical
  let motive : IterationInput R hpos Q0 → Prop := fun I =>
    Nonempty (TypeOneExtendedFullIterationInvariants I) →
      ∃ J : IterationInput R hpos Q0,
        Nonempty (TypeOneExtendedFullIterationInvariants J) ∧
          (Terminal J ∨
            ∃ L'' : PerfectPathPacking G A B,
              linkageAuxDegreeTwoCount L'' <
                linkageAuxDegreeTwoCount J.linkage)
  have hmain : motive I₀ := by
    refine (tildeEdgeDescent_wf (R := R) (hpos := hpos)
      (Q0 := Q0)).induction (C := motive) I₀ ?_
    intro I ih InvNE
    rcases InvNE with ⟨Inv⟩
    by_cases hterm : Terminal I
    · exact ⟨I, ⟨Inv⟩, Or.inl hterm⟩
    · rcases hstep I Inv hterm with hdrop | hnext
      · exact ⟨I, ⟨Inv⟩, Or.inr hdrop⟩
      · rcases hnext with ⟨I', Inv', hlt⟩
        exact ih I' hlt Inv'
  exact hmain ⟨Inv₀⟩

/-- The terminal alternative described just before the bump definition: if the
maintained graph has no bump and no cross, then the proof will extract an
`h x h` grid minor.  The actual no-bump/no-cross predicates are introduced in
the next part of the proof, so this definition records only the promised
terminal conclusion. -/
def TerminalNoBumpNoCrossOutcome
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (_I : IterationInput R hpos Q0) : Prop :=
  ContainsGridMinor G h

/-- Branch-set data for the final terminal grid-minor construction.  This is
the formal target of Claim B.3 and the no-cross common-order argument:
`branch i j` is the connected intersection of row `i` with transversal `j`,
and the horizontal/vertical fields provide the grid adjacencies. -/
structure TerminalGridBranchModel (G : _root_.SimpleGraph V) (g : ℕ) where
  branch : Fin g → Fin g → Finset V
  branch_nonempty : ∀ i j, (branch i j).Nonempty
  branch_connected :
    ∀ i j, (G.induce {v : V | v ∈ branch i j}).Connected
  branch_disjoint :
    ∀ ⦃i j i' j' : Fin g⦄,
      (i, j) ≠ (i', j') → Disjoint (branch i j) (branch i' j')
  horizontal_adj :
    ∀ i ⦃j j' : Fin g⦄, FinConsecutive j j' →
      ∃ u ∈ branch i j, ∃ v ∈ branch i j', G.Adj u v
  vertical_adj :
    ∀ ⦃i i' : Fin g⦄, FinConsecutive i i' → ∀ j,
      ∃ u ∈ branch i j, ∃ v ∈ branch i' j, G.Adj u v

namespace TerminalGridBranchModel

variable {g : ℕ}

omit [DecidableEq V] in
/-- Convert terminal branch-set data into the standard grid-minor predicate. -/
theorem containsGridMinor (T : TerminalGridBranchModel G g) :
    ContainsGridMinor G g := by
  classical
  refine ContainsGridMinor.of_grid_branchSets
    (G := G) (g := g)
    (fun x : GridVertex g => TerminalGridBranchModel.branch T x.1 x.2)
    ?nonempty ?connected ?disjoint ?adjacent
  · intro x
    exact TerminalGridBranchModel.branch_nonempty T x.1 x.2
  · intro x
    exact TerminalGridBranchModel.branch_connected T x.1 x.2
  · intro x y hxy
    exact TerminalGridBranchModel.branch_disjoint T (by
      intro hpair
      exact hxy hpair)
  · intro x y hxy
    rcases hxy with hrow | hcol
    · rcases hrow with ⟨hrow, hcon⟩
      simpa [hrow] using TerminalGridBranchModel.horizontal_adj T x.1 hcon
    · rcases hcol with ⟨hcol, hcon⟩
      simpa [hcol] using TerminalGridBranchModel.vertical_adj T hcon x.2

end TerminalGridBranchModel

/-- Branch-set data for a rectangular `rows × cols` grid minor.  Appendix B.1
first obtains a `2h × h` rectangular grid from the terminal row/column
intersections, then deletes the extra rows. -/
structure RectangularGridBranchModel
    (G : _root_.SimpleGraph V) (rows cols : ℕ) where
  branch : Fin rows → Fin cols → Finset V
  branch_nonempty : ∀ i j, (branch i j).Nonempty
  branch_connected :
    ∀ i j, (G.induce {v : V | v ∈ branch i j}).Connected
  branch_disjoint :
    ∀ ⦃i j i' j'⦄,
      (i, j) ≠ (i', j') → Disjoint (branch i j) (branch i' j')
  horizontal_adj :
    ∀ i ⦃j j'⦄, FinConsecutive j j' →
      ∃ u ∈ branch i j, ∃ v ∈ branch i j', G.Adj u v
  vertical_adj :
    ∀ ⦃i i'⦄, FinConsecutive i i' → ∀ j,
      ∃ u ∈ branch i j, ∃ v ∈ branch i' j, G.Adj u v

namespace RectangularGridBranchModel

variable {rows cols g : ℕ}

/-- Keep the first `g` rows and all `g` columns of a rectangular model. -/
noncomputable def topSquare
    (M : RectangularGridBranchModel G rows g) (hrows : g ≤ rows) :
    TerminalGridBranchModel G g where
  branch i j :=
    M.branch ⟨i.1, lt_of_lt_of_le i.2 hrows⟩ j
  branch_nonempty := by
    intro i j
    exact M.branch_nonempty ⟨i.1, lt_of_lt_of_le i.2 hrows⟩ j
  branch_connected := by
    intro i j
    exact M.branch_connected ⟨i.1, lt_of_lt_of_le i.2 hrows⟩ j
  branch_disjoint := by
    intro i j i' j' hne
    refine M.branch_disjoint ?_
    intro hpair
    apply hne
    rcases i with ⟨i, hi⟩
    rcases i' with ⟨i', hi'⟩
    rcases j with ⟨j, hj⟩
    rcases j' with ⟨j', hj'⟩
    simp at hpair ⊢
    exact hpair
  horizontal_adj := by
    intro i j j' hcon
    exact M.horizontal_adj ⟨i.1, lt_of_lt_of_le i.2 hrows⟩ hcon
  vertical_adj := by
    intro i i' hcon j
    exact M.vertical_adj (FinConsecutive.castLE hrows hcon) j

omit [DecidableEq V] in
/-- A rectangular `rows × g` model with at least `g` rows contains a
`g × g` grid minor. -/
theorem containsGridMinor_topSquare
    (M : RectangularGridBranchModel G rows g) (hrows : g ≤ rows) :
    ContainsGridMinor G g :=
  (M.topSquare hrows).containsGridMinor

omit [DecidableEq V] in
/-- The terminal `2h × h` rectangular grid immediately yields the paper's
`h × h` grid minor by deleting the extra rows. -/
theorem containsGridMinor_of_two_mul
    (M : RectangularGridBranchModel G (2 * g) g) :
    ContainsGridMinor G g :=
  M.containsGridMinor_topSquare (by omega)

end RectangularGridBranchModel

/-- Concrete terminal certificate left after Claim B.3: the connected
row/transversal intersections have already been assembled into the
`2h × h` rectangular branch-set model. -/
structure TerminalTraceGridCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (_I : IterationInput R hpos Q0) where
  model : RectangularGridBranchModel G (z h) h

namespace TerminalTraceGridCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}

/-- The terminal trace certificate implies the terminal grid-minor outcome. -/
theorem containsGridMinor (C : TerminalTraceGridCertificate I) :
    ContainsGridMinor G h := by
  have hrows : h ≤ z h := by
    dsimp [z]
    omega
  exact C.model.containsGridMinor_topSquare hrows

/-- A terminal trace certificate is exactly the concrete content needed for
the abstract terminal outcome. -/
theorem terminalOutcome (C : TerminalTraceGridCertificate I) :
    TerminalNoBumpNoCrossOutcome I :=
  TerminalTraceGridCertificate.containsGridMinor C

end TerminalTraceGridCertificate

/-! ### Terminal sparse-grid path certificates

The row/transversal terminal picture does not usually give literal host edges
between consecutive row-column intersections.  It gives subpaths along rows and
transversals, and the paper then suppresses the degree-two vertices on those
subpaths.  The following certificate is the minor-theoretic form of that
operation: every edge of the valid sparse grid is realized by a host path, and
the realized paths are allocated to one endpoint according to an injective
rank. -/

/-- A subdivision-style certificate for the valid sparse grid inside the host
graph.  Each valid sparse-grid port has an image vertex, and each sparse-grid
edge is realized by a graph path between the corresponding images.  The
injective `rank` chooses which endpoint absorbs the drop-last part of a
realized edge path in the branch-set minor model. -/
structure TerminalSparseGridPathCertificate
    (G : _root_.SimpleGraph V) (g : ℕ) where
  image : SparseGrid.ValidVertex g → V
  image_injective : Function.Injective image
  rank : SparseGrid.ValidVertex g → ℕ
  rank_injective : Function.Injective rank
  edgePath :
    ∀ ⦃x y : SparseGrid.ValidVertex g⦄,
      (SparseGrid.validGraph g).Adj x y → GraphPath G
  edgePath_source :
    ∀ ⦃x y : SparseGrid.ValidVertex g⦄
      (hxy : (SparseGrid.validGraph g).Adj x y),
        (edgePath hxy).source = image x
  edgePath_target :
    ∀ ⦃x y : SparseGrid.ValidVertex g⦄
      (hxy : (SparseGrid.validGraph g).Adj x y),
        (edgePath hxy).target = image y

namespace TerminalSparseGridPathCertificate

variable {g : ℕ}

omit [DecidableEq V] in
theorem rank_lt_or_gt_of_ne (C : TerminalSparseGridPathCertificate G g)
    {x y : SparseGrid.ValidVertex g} (hxy : x ≠ y) :
    C.rank x < C.rank y ∨ C.rank y < C.rank x := by
  have hrank_ne : C.rank x ≠ C.rank y := by
    intro h
    exact hxy (C.rank_injective h)
  exact lt_or_gt_of_ne hrank_ne

omit [DecidableEq V] in
theorem rank_lt_or_gt_of_adj (C : TerminalSparseGridPathCertificate G g)
    {x y : SparseGrid.ValidVertex g}
    (hxy : (SparseGrid.validGraph g).Adj x y) :
    C.rank x < C.rank y ∨ C.rank y < C.rank x :=
  C.rank_lt_or_gt_of_ne ((SparseGrid.validGraph g).ne_of_adj hxy)

omit [DecidableEq V] in
theorem edgePath_source_ne_target
    (C : TerminalSparseGridPathCertificate G g)
    {x y : SparseGrid.ValidVertex g}
    (hxy : (SparseGrid.validGraph g).Adj x y) :
    (C.edgePath hxy).source ≠ (C.edgePath hxy).target := by
  intro h
  have himage : C.image x = C.image y := by
    rw [← C.edgePath_source hxy, ← C.edgePath_target hxy]
    exact h
  exact (SparseGrid.validGraph g).ne_of_adj hxy
    (C.image_injective himage)

/-- Branch set obtained by allocating each realized sparse-grid edge path to
its lower-ranked endpoint, with the final target vertex removed.  The final
edge of the path then witnesses adjacency to the neighboring branch set. -/
noncomputable def orientedBranchSet
    (C : TerminalSparseGridPathCertificate G g)
    (x : SparseGrid.ValidVertex g) : Finset V := by
  classical
  exact {C.image x} ∪
    Finset.univ.biUnion (fun y : SparseGrid.ValidVertex g =>
      if hxy : (SparseGrid.validGraph g).Adj x y ∧ C.rank x < C.rank y then
        (C.edgePath hxy.1).dropLast.vertexSet
      else
        ∅)

@[simp] theorem image_mem_orientedBranchSet
    (C : TerminalSparseGridPathCertificate G g)
    (x : SparseGrid.ValidVertex g) :
    C.image x ∈ C.orientedBranchSet x := by
  classical
  simp [orientedBranchSet]

theorem mem_orientedBranchSet_iff
    (C : TerminalSparseGridPathCertificate G g)
    {x : SparseGrid.ValidVertex g} {v : V} :
    v ∈ C.orientedBranchSet x ↔
      v = C.image x ∨
        ∃ (y : SparseGrid.ValidVertex g)
          (hxy : (SparseGrid.validGraph g).Adj x y),
            C.rank x < C.rank y ∧
              v ∈ (C.edgePath hxy).dropLast.vertexSet := by
  classical
  constructor
  · intro hv
    rw [orientedBranchSet] at hv
    rw [Finset.mem_union] at hv
    rcases hv with hv | hv
    · left
      simpa using hv
    · rw [Finset.mem_biUnion] at hv
      rcases hv with ⟨y, _hy, hvif⟩
      by_cases hcond :
          (SparseGrid.validGraph g).Adj x y ∧ C.rank x < C.rank y
      · right
        exact ⟨y, hcond.1, hcond.2, by simpa [hcond] using hvif⟩
      · simp [hcond] at hvif
  · intro hv
    rcases hv with hv | hv
    · rw [orientedBranchSet]
      exact Finset.mem_union_left _ (by simp [hv])
    · rcases hv with ⟨y, hxy, hrank, hvpath⟩
      rw [orientedBranchSet]
      exact Finset.mem_union_right _ <|
        Finset.mem_biUnion.mpr ⟨y, Finset.mem_univ y, by
          have hcond :
              (SparseGrid.validGraph g).Adj x y ∧ C.rank x < C.rank y :=
            ⟨hxy, hrank⟩
          simpa [hcond] using hvpath⟩

theorem edge_penultimate_mem_orientedBranchSet
    (C : TerminalSparseGridPathCertificate G g)
    {x y : SparseGrid.ValidVertex g}
    (hxy : (SparseGrid.validGraph g).Adj x y)
    (hrank : C.rank x < C.rank y) :
    (C.edgePath hxy).penultimate ∈ C.orientedBranchSet x := by
  classical
  have hmem :
      (C.edgePath hxy).penultimate ∈
        (C.edgePath hxy).dropLast.vertexSet := by
    simpa using GraphPath.target_mem_vertexSet ((C.edgePath hxy).dropLast)
  rw [orientedBranchSet]
  exact Finset.mem_union_right _ <|
    Finset.mem_biUnion.mpr ⟨y, Finset.mem_univ y, by
      have hcond :
          (SparseGrid.validGraph g).Adj x y ∧ C.rank x < C.rank y :=
        ⟨hxy, hrank⟩
      simpa [hcond] using hmem⟩

theorem orientedBranchSet_connected
    (C : TerminalSparseGridPathCertificate G g)
    (x : SparseGrid.ValidVertex g) :
    (G.induce {v : V | v ∈ C.orientedBranchSet x}).Connected := by
  classical
  refine G.induce_connected_of_patches (C.image x)
    (C.image_mem_orientedBranchSet x) ?_
  intro v hv
  change v ∈ C.orientedBranchSet x at hv
  rw [orientedBranchSet] at hv
  rw [Finset.mem_union] at hv
  rcases hv with hv | hv
  · have hv_eq : v = C.image x := by
      simpa using hv
    subst v
    refine ⟨({C.image x} : Set V), ?_, ?_, ?_, ?_⟩
    · intro z hz
      simp only [Set.mem_singleton_iff] at hz
      simp [hz, C.image_mem_orientedBranchSet x]
    · simp
    · simp
    · exact _root_.SimpleGraph.Reachable.refl _
  · rw [Finset.mem_biUnion] at hv
    rcases hv with ⟨y, _hy, hvif⟩
    by_cases hcond :
        (SparseGrid.validGraph g).Adj x y ∧ C.rank x < C.rank y
    · have hvpath :
          v ∈ (C.edgePath hcond.1).dropLast.vertexSet := by
        simpa [hcond] using hvif
      let S : Set V := {z : V | z ∈ (C.edgePath hcond.1).dropLast.vertexSet}
      refine ⟨S, ?_, ?_, hvpath, ?_⟩
      · intro z hz
        rw [orientedBranchSet]
        exact Finset.mem_union_right _ <|
          Finset.mem_biUnion.mpr ⟨y, Finset.mem_univ y, by
            simpa [hcond] using hz⟩
      · have hsource :
            (C.edgePath hcond.1).dropLast.source = C.image x := by
          rw [GraphPath.dropLast_source, C.edgePath_source hcond.1]
        simpa [S, ← hsource] using
          GraphPath.source_mem_vertexSet ((C.edgePath hcond.1).dropLast)
      · have hconn :=
          GraphPath.connected_induce_vertexSet ((C.edgePath hcond.1).dropLast)
        exact hconn ⟨C.image x, by
          have hsource :
              (C.edgePath hcond.1).dropLast.source = C.image x := by
            rw [GraphPath.dropLast_source, C.edgePath_source hcond.1]
          simpa [S, ← hsource] using
            GraphPath.source_mem_vertexSet ((C.edgePath hcond.1).dropLast)⟩
          ⟨v, hvpath⟩
    · simp [hcond] at hvif

theorem orientedBranchSet_adjacent
    (C : TerminalSparseGridPathCertificate G g)
    {x y : SparseGrid.ValidVertex g}
    (hxy : (SparseGrid.validGraph g).Adj x y) :
    ∃ u ∈ C.orientedBranchSet x,
      ∃ v ∈ C.orientedBranchSet y, G.Adj u v := by
  rcases C.rank_lt_or_gt_of_adj hxy with hrank | hrank
  · refine ⟨(C.edgePath hxy).penultimate,
      C.edge_penultimate_mem_orientedBranchSet hxy hrank,
      C.image y, C.image_mem_orientedBranchSet y, ?_⟩
    have hne := C.edgePath_source_ne_target hxy
    have hadj := (C.edgePath hxy).penultimate_adj_target hne
    simpa [C.edgePath_target hxy] using hadj
  · have hyx : (SparseGrid.validGraph g).Adj y x :=
      (SparseGrid.validGraph g).symm hxy
    refine ⟨C.image x, C.image_mem_orientedBranchSet x,
      (C.edgePath hyx).penultimate,
      C.edge_penultimate_mem_orientedBranchSet hyx hrank, ?_⟩
    have hne := C.edgePath_source_ne_target hyx
    have hadj := (C.edgePath hyx).penultimate_adj_target hne
    simpa [C.edgePath_target hyx] using G.symm hadj

end TerminalSparseGridPathCertificate

/-- A terminal sparse-grid path certificate plus the disjointness of its
allocated branch sets. -/
structure TerminalSparseGridMinorCertificate
    (G : _root_.SimpleGraph V) (g : ℕ) where
  pathCert : TerminalSparseGridPathCertificate G g
  branch_disjoint :
    ∀ ⦃x y : SparseGrid.ValidVertex g⦄,
      x ≠ y →
        Disjoint (pathCert.orientedBranchSet x)
          (pathCert.orientedBranchSet y)

namespace TerminalSparseGridMinorCertificate

variable {g : ℕ}

/-- Convert the terminal sparse-grid path certificate into a standard branch
set minor model of the valid sparse grid. -/
noncomputable def toMinorModel
    (C : TerminalSparseGridMinorCertificate G g) :
    MinorModel (SparseGrid.validGraph g) G where
  branchSet := C.pathCert.orientedBranchSet
  branch_nonempty := by
    intro x
    exact ⟨C.pathCert.image x,
      C.pathCert.image_mem_orientedBranchSet x⟩
  branch_connected := by
    intro x
    exact C.pathCert.orientedBranchSet_connected x
  branch_disjoint := by
    intro x y hxy
    exact C.branch_disjoint hxy
  adjacent := by
    intro x y hxy
    exact C.pathCert.orientedBranchSet_adjacent hxy

theorem isMinor (C : TerminalSparseGridMinorCertificate G g) :
    IsMinor (SparseGrid.validGraph g) G :=
  ⟨C.toMinorModel⟩

theorem containsGridMinor (C : TerminalSparseGridMinorCertificate G g) :
    ContainsGridMinor G g :=
  SparseGrid.validContainsGridMinor_of_minor C.isMinor

end TerminalSparseGridMinorCertificate

/-- Terminal certificate in the exact shape produced by the paper's final
subpath/suppression step.  Unlike `TerminalTraceGridCertificate`, this
certificate does not require literal host adjacencies between row-column
intersections; it records the sparse-grid edge paths before suppression. -/
structure TerminalSparseGridTraceCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (_I : IterationInput R hpos Q0) where
  model : TerminalSparseGridMinorCertificate G h

namespace TerminalSparseGridTraceCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}

theorem containsGridMinor (C : TerminalSparseGridTraceCertificate I) :
    ContainsGridMinor G h :=
  C.model.containsGridMinor

theorem terminalOutcome (C : TerminalSparseGridTraceCertificate I) :
    TerminalNoBumpNoCrossOutcome I :=
  C.containsGridMinor

end TerminalSparseGridTraceCertificate

/-- The maintained `Q0` intersection invariant already gives nonemptiness of
the terminal row-column intersections. -/
theorem selectedColumn_currentRow_inter_nonempty
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0) (O : I.OrderedRows)
    (i : Fin (z h)) (j : Fin h) :
    (((I.rowPath (O.order.symm i)).vertexSet) ∩
      ((Q0.selectedData (Q0.selectedColumn j)
        (Q0.selectedColumn_mem_selectedIndexSet j)).qstar.vertexSet)).Nonempty := by
  rcases Q0.selectedColumn_hits_currentRow
      I.q0_intersection_invariant j (O.order.symm i) with ⟨v, hv⟩
  exact ⟨v, Finset.mem_inter.2
    ⟨(Finset.mem_inter.1 hv).2, (Finset.mem_inter.1 hv).1⟩⟩

omit [DecidableEq V] in
/-- If branch sets are contained in both a row family and a column family, and
both families are pairwise disjoint, then different row-column branch sets are
disjoint.  This is the disjointness argument in the final grid-minor
construction. -/
theorem branch_disjoint_of_row_column_disjoint
    {rows cols : ℕ}
    (rowSet : Fin rows → Finset V) (colSet : Fin cols → Finset V)
    (branch : Fin rows → Fin cols → Finset V)
    (hrow_subset : ∀ i j, branch i j ⊆ rowSet i)
    (hcol_subset : ∀ i j, branch i j ⊆ colSet j)
    (hrow_disj : ∀ ⦃i i' : Fin rows⦄, i ≠ i' →
      Disjoint (rowSet i) (rowSet i'))
    (hcol_disj : ∀ ⦃j j' : Fin cols⦄, j ≠ j' →
      Disjoint (colSet j) (colSet j'))
    ⦃i i' : Fin rows⦄ ⦃j j' : Fin cols⦄
    (hij : (i, j) ≠ (i', j')) :
    Disjoint (branch i j) (branch i' j') := by
  classical
  rw [Finset.disjoint_left]
  intro v hv hv'
  by_cases hi : i = i'
  · have hj : j ≠ j' := by
      intro hjeq
      exact hij (by simp [hi, hjeq])
    exact Finset.disjoint_left.mp (hcol_disj hj)
      (hcol_subset i j hv) (hcol_subset i' j' hv')
  · exact Finset.disjoint_left.mp (hrow_disj hi)
      (hrow_subset i j hv) (hrow_subset i' j' hv')

/-- An explicit left-to-right order on the `h` terminal transversal columns.

The earlier `Q0.selectedColumn` API chooses an arbitrary equivalence between a
cardinality-`h` subset and `Fin h`.  The terminal grid model, however, needs
the `Fin h` labels to be the common order of the transversals on every row,
which is proved only in the terminal no-cross state.  This structure records
that terminal order directly. -/
structure TerminalColumnOrder
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeOneQStarFamily R hpos Q) where
  col : Fin h → Q.Index
  col_mem : ∀ j : Fin h, col j ∈ Q0.indices
  col_injective : Function.Injective col

namespace TerminalColumnOrder

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}

/-- The historical arbitrary selected-column order, packaged as an explicit
terminal column order.  The terminal no-cross proof will usually provide a
better order; this adapter keeps older terminal certificates compatible with
the corrected ordered interface. -/
noncomputable def selected (Q0 : TypeOneQStarFamily R hpos Q) :
    TerminalColumnOrder Q0 where
  col := Q0.selectedColumn
  col_mem := Q0.selectedColumn_mem_indices
  col_injective := Q0.selectedColumn_injective

/-- The `j`-th terminal column path in the explicit terminal order. -/
noncomputable def qstar (C : TerminalColumnOrder Q0) (j : Fin h) :
    GraphPath G :=
  (Q0.data (C.col j) (C.col_mem j)).qstar

/-- The ordered terminal columns are subpaths of their parent transversal
packing paths. -/
theorem qstar_subset_parent (C : TerminalColumnOrder Q0) (j : Fin h) :
    (C.qstar j).vertexSet ⊆ (Q.path (C.col j)).vertexSet :=
  (Q0.data (C.col j) (C.col_mem j)).qstar_subset_Q

/-- Distinct terminal column labels give vertex-disjoint `Q*` paths. -/
theorem qstar_nodeDisjoint (C : TerminalColumnOrder Q0)
    {j k : Fin h} (hjk : j ≠ k) :
    (C.qstar j).NodeDisjoint (C.qstar k) := by
  classical
  rw [GraphPath.NodeDisjoint, Finset.disjoint_left]
  intro v hvj hvk
  have hvj_parent : v ∈ (Q.path (C.col j)).vertexSet :=
    C.qstar_subset_parent j hvj
  have hvk_parent : v ∈ (Q.path (C.col k)).vertexSet :=
    C.qstar_subset_parent k hvk
  have hcols_ne : C.col j ≠ C.col k := by
    intro hcols
    exact hjk (C.col_injective hcols)
  exact Finset.disjoint_left.mp (Q.toPathPacking.node_disjoint hcols_ne)
    hvj_parent hvk_parent

/-- The maintained `Q0` intersection invariant gives nonemptiness for any
explicit terminal column order. -/
theorem currentRow_inter_nonempty
    (C : TerminalColumnOrder Q0)
    (I : IterationInput R hpos Q0) (O : I.OrderedRows)
    (i : Fin (z h)) (j : Fin h) :
    (((I.rowPath (O.order.symm i)).vertexSet) ∩
      ((C.qstar j).vertexSet)).Nonempty := by
  rcases I.q0_intersection_invariant (C.col j) (C.col_mem j) with hhit
  rcases hhit.1 (O.order.symm i) with ⟨v, hv⟩
  exact ⟨v, Finset.mem_inter.2
    ⟨(Finset.mem_inter.1 hv).2, (Finset.mem_inter.1 hv).1⟩⟩

end TerminalColumnOrder

/-! ### Symmetric type-2 terminal grid interface

The type-2 majority branch uses the same terminal grid-minor construction as
the type-1 branch, but with the active rows `P_{2z+1}, ..., P_{3z}` and the
boundary paths `P_{2z}, P_{3z+1}`.  The following declarations mirror the
explicit ordered-column terminal interface above, without pretending that a
type-2 family is a type-1 family. -/

/-- An explicit left-to-right order on the selected type-2 terminal columns.

As in the type-1 branch, this order is not the arbitrary equivalence coming
from a finite subset; it is the order produced by the terminal no-cross
argument. -/
structure TypeTwoTerminalColumnOrder
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeTwoQStarFamily R hpos Q) where
  col : Fin h → Q.Index
  col_mem : ∀ j : Fin h, col j ∈ Q0.indices
  col_injective : Function.Injective col

namespace TypeTwoTerminalColumnOrder

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeTwoQStarFamily R hpos Q}

/-- The arbitrary selected type-2 column order, kept only as a compatibility
adapter for older terminal certificates. -/
noncomputable def selected (Q0 : TypeTwoQStarFamily R hpos Q) :
    TypeTwoTerminalColumnOrder Q0 where
  col := Q0.selectedColumn
  col_mem := Q0.selectedColumn_mem_indices
  col_injective := Q0.selectedColumn_injective

/-- The `j`-th selected type-2 terminal column. -/
noncomputable def qstar (C : TypeTwoTerminalColumnOrder Q0) (j : Fin h) :
    GraphPath G :=
  (Q0.data (C.col j) (C.col_mem j)).qstar

/-- Ordered type-2 terminal columns are subpaths of their parent transversal
packing paths. -/
theorem qstar_subset_parent (C : TypeTwoTerminalColumnOrder Q0) (j : Fin h) :
    (C.qstar j).vertexSet ⊆ (Q.path (C.col j)).vertexSet :=
  (Q0.data (C.col j) (C.col_mem j)).qstar_subset_Q

/-- Distinct type-2 terminal column labels give vertex-disjoint `Q*` paths. -/
theorem qstar_nodeDisjoint (C : TypeTwoTerminalColumnOrder Q0)
    {j k : Fin h} (hjk : j ≠ k) :
    (C.qstar j).NodeDisjoint (C.qstar k) := by
  classical
  rw [GraphPath.NodeDisjoint, Finset.disjoint_left]
  intro v hvj hvk
  have hvj_parent : v ∈ (Q.path (C.col j)).vertexSet :=
    C.qstar_subset_parent j hvj
  have hvk_parent : v ∈ (Q.path (C.col k)).vertexSet :=
    C.qstar_subset_parent k hvk
  have hcols_ne : C.col j ≠ C.col k := by
    intro hcols
    exact hjk (C.col_injective hcols)
  exact Finset.disjoint_left.mp (Q.toPathPacking.node_disjoint hcols_ne)
    hvj_parent hvk_parent

/-- The maintained type-2 current-row invariant gives nonemptiness for any
explicit terminal column order. -/
theorem currentRow_inter_nonempty
    (C : TypeTwoTerminalColumnOrder Q0)
    (I : TypeTwoIterationInput R hpos Q0) (O : I.OrderedRows)
    (i : Fin (z h)) (j : Fin h) :
    (((I.rowPath (O.order.symm i)).vertexSet) ∩
      ((C.qstar j).vertexSet)).Nonempty := by
  rcases I.q0_intersection_invariant (C.col j) (C.col_mem j) with hhit
  rcases hhit.1 (O.order.symm i) with ⟨v, hv⟩
  exact ⟨v, Finset.mem_inter.2
    ⟨(Finset.mem_inter.1 hv).2, (Finset.mem_inter.1 hv).1⟩⟩

end TypeTwoTerminalColumnOrder

/-! ### Post-hill terminal columns

Hill elimination changes the terminal transversal paths.  The original
`TerminalColumnOrder Q0` interface is therefore too rigid for the final
no-hill state: it can only order the immutable `Q₀.qstar` paths.  The following
small interface is the post-hill analogue used by the terminal grid
construction.  It keeps only the properties of the terminal column paths that
the grid model consumes: pairwise disjointness and a nonempty intersection
with each current row. -/

/-- Explicit terminal column paths after hill elimination. -/
structure TerminalPathColumnOrder
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  qstar : Fin h → GraphPath G
  qstar_nodeDisjoint :
    ∀ ⦃j k : Fin h⦄, j ≠ k → (qstar j).NodeDisjoint (qstar k)
  currentRow_inter_nonempty :
    ∀ i : Fin (z h), ∀ j : Fin h,
      (((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
        ((qstar j).vertexSet)).Nonempty

namespace TerminalPathColumnOrder

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- The old selected-column order is a post-hill column order in the special
case where no hill replacement has changed the selected paths. -/
noncomputable def ofTerminalColumnOrder
    (C : TerminalColumnOrder Q0) :
    TerminalPathColumnOrder I inv where
  qstar := C.qstar
  qstar_nodeDisjoint := by
    intro j k hjk
    exact C.qstar_nodeDisjoint hjk
  currentRow_inter_nonempty := by
    intro i j
    exact C.currentRow_inter_nonempty I inv.orderedRows i j

end TerminalPathColumnOrder

/-- The terminal row path indexed by the ordered active row number.  This local
helper is used before the later Claim B.3 section introduces the public
`claimB3RowPath` abbreviation. -/
private abbrev terminalPathRowPath
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    (inv : TypeOneIterationInvariants I) (row : Fin (z h)) : GraphPath G :=
  I.rowPath (inv.orderedRows.order.symm row)

/-- A concrete hill candidate for the actual post-hill terminal column paths.

This is the post-hill analogue of `ClaimB3HillCandidateData`: the selected
column is `columns.qstar col`, not the immutable original `Q₀` path.  This is
the level at which the hill-elimination loop really acts. -/
structure TerminalPathHillCandidateData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (columns : TerminalPathColumnOrder I inv) where
  row : Fin (z h)
  col : Fin h
  lower : Fin (z h)
  lower_succ : lower.1 + 1 = row.1
  left : V
  right : V
  left_mem_row : left ∈ (terminalPathRowPath inv row).vertexSet
  right_mem_row : right ∈ (terminalPathRowPath inv row).vertexSet
  left_before_right : (terminalPathRowPath inv row).Before left right
  segment : GraphPath G
  segment_connects : segment.Connects {left} {right}
  segment_subset_column :
    segment.vertexSet ⊆ (columns.qstar col).vertexSet
  segment_edgeSet_subset_column :
    segment.edgeSet ⊆ (columns.qstar col).edgeSet
  hits_lower : HitsGraphPath segment (terminalPathRowPath inv lower)
  internally_disjoint_from_other_rows :
    segment.InternallyDisjointFromSet
      (Finset.univ.biUnion fun r : Fin (z h) =>
        if r = lower then ∅ else (terminalPathRowPath inv r).vertexSet)

namespace TerminalPathHillCandidateData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}
variable {columns : TerminalPathColumnOrder I inv}

/-- The row interval between the endpoints of a post-hill candidate. -/
noncomputable def rowInterval
    (C : TerminalPathHillCandidateData columns) : GraphPath G :=
  (terminalPathRowPath inv C.row).segmentOfBefore C.left_before_right

@[simp] theorem rowInterval_source
    (C : TerminalPathHillCandidateData columns) :
    C.rowInterval.source = C.left := rfl

@[simp] theorem rowInterval_target
    (C : TerminalPathHillCandidateData columns) :
    C.rowInterval.target = C.right := rfl

/-- A concrete post-hill hill candidate lies above the first active row. -/
theorem row_pos (C : TerminalPathHillCandidateData columns) :
    0 < C.row.1 := by
  have h := C.lower_succ
  omega

/-- The lower row of a concrete post-hill candidate is strictly below its
top row. -/
theorem lower_lt_row (C : TerminalPathHillCandidateData columns) :
    C.lower.1 < C.row.1 := by
  have h := C.lower_succ
  omega

/-- The candidate segment oriented from the left row endpoint to the right row
endpoint.  The stored segment is unoriented because the terminal column may
traverse the hill in either direction. -/
noncomputable def orientedSegment
    (C : TerminalPathHillCandidateData columns) : GraphPath G :=
  C.segment.orient C.segment_connects

@[simp] theorem orientedSegment_vertexSet
    (C : TerminalPathHillCandidateData columns) :
    C.orientedSegment.vertexSet = C.segment.vertexSet := by
  simp [orientedSegment]

@[simp] theorem orientedSegment_edgeSet
    (C : TerminalPathHillCandidateData columns) :
    C.orientedSegment.edgeSet = C.segment.edgeSet := by
  simp [orientedSegment]

@[simp] theorem orientedSegment_source
    (C : TerminalPathHillCandidateData columns) :
    C.orientedSegment.source = C.left := by
  have hleft : C.orientedSegment.source ∈ ({C.left} : Finset V) :=
    GraphPath.orient_source_mem C.segment C.segment_connects
  simpa [orientedSegment] using hleft

@[simp] theorem orientedSegment_target
    (C : TerminalPathHillCandidateData columns) :
    C.orientedSegment.target = C.right := by
  have hright : C.orientedSegment.target ∈ ({C.right} : Finset V) :=
    GraphPath.orient_target_mem C.segment C.segment_connects
  simpa [orientedSegment] using hright

/-- The left endpoint of a post-hill candidate lies on its selected current
column. -/
theorem left_mem_column (C : TerminalPathHillCandidateData columns) :
    C.left ∈ (columns.qstar C.col).vertexSet := by
  classical
  have hleft_seg : C.left ∈ C.segment.vertexSet := by
    rcases C.segment_connects with h | h
    · have hs : C.segment.source = C.left := by
        simpa using h.1
      simpa [hs] using GraphPath.source_mem_vertexSet C.segment
    · have ht : C.segment.target = C.left := by
        simpa using h.2
      simpa [ht] using GraphPath.target_mem_vertexSet C.segment
  exact C.segment_subset_column hleft_seg

/-- The right endpoint of a post-hill candidate lies on its selected current
column. -/
theorem right_mem_column (C : TerminalPathHillCandidateData columns) :
    C.right ∈ (columns.qstar C.col).vertexSet := by
  classical
  have hright_seg : C.right ∈ C.segment.vertexSet := by
    rcases C.segment_connects with h | h
    · have ht : C.segment.target = C.right := by
        simpa using h.2
      simpa [ht] using GraphPath.target_mem_vertexSet C.segment
    · have hs : C.segment.source = C.right := by
        simpa using h.1
      simpa [hs] using GraphPath.source_mem_vertexSet C.segment
  exact C.segment_subset_column hright_seg

/-- The oriented candidate segment still lies on its selected current
terminal column. -/
theorem orientedSegment_vertexSet_subset_column
    (C : TerminalPathHillCandidateData columns) :
    C.orientedSegment.vertexSet ⊆ (columns.qstar C.col).vertexSet := by
  intro v hv
  exact C.segment_subset_column (by simpa using hv)

/-- The oriented candidate segment uses only edges of its selected current
terminal column. -/
theorem orientedSegment_edgeSet_subset_column
    (C : TerminalPathHillCandidateData columns) :
    C.orientedSegment.edgeSet ⊆ (columns.qstar C.col).edgeSet := by
  intro e he
  exact C.segment_edgeSet_subset_column (by simpa using he)

/-- On the selected current column, the hill endpoints occur in one of the
two possible orders. -/
theorem column_left_before_right_or_right_before_left
    (C : TerminalPathHillCandidateData columns) :
    (columns.qstar C.col).Before C.left C.right ∨
      (columns.qstar C.col).Before C.right C.left := by
  classical
  let Col : GraphPath G := columns.qstar C.col
  have hleft : C.left ∈ Col.vertexSet := by
    simpa [Col] using C.left_mem_column
  have hright : C.right ∈ Col.vertexSet := by
    simpa [Col] using C.right_mem_column
  rcases le_total (Col.vertexIndex C.left) (Col.vertexIndex C.right) with hle | hle
  · exact Or.inl ((Col.before_iff_vertexIndex_le).2 ⟨hleft, hright, hle⟩)
  · exact Or.inr ((Col.before_iff_vertexIndex_le).2 ⟨hright, hleft, hle⟩)

/-- Path data for replacing a post-hill column's hill excursion by the
corresponding row interval. -/
structure ReplacementColumnPath
    (C : TerminalPathHillCandidateData columns) where
  path : GraphPath G
  source_eq : path.source = (columns.qstar C.col).source
  target_eq : path.target = (columns.qstar C.col).target
  vertexSet_subset :
    path.vertexSet ⊆
      (columns.qstar C.col).vertexSet ∪ C.rowInterval.vertexSet
  edgeSet_subset :
    path.edgeSet ⊆
      (columns.qstar C.col).edgeSet ∪ C.rowInterval.edgeSet

/-- Construct the post-hill replacement column path.  This is the formal hill
replacement: keep the old column prefix and suffix, insert the row interval in
the orientation needed by the column, then erase any cycle. -/
noncomputable def replacementColumnPath
    (C : TerminalPathHillCandidateData columns) :
    ReplacementColumnPath C := by
  classical
  let Col : GraphPath G := columns.qstar C.col
  by_cases hLR : Col.Before C.left C.right
  · let pre : GraphPath G := Col.takeUntil (by simpa [Col] using C.left_mem_column)
    let mid : GraphPath G := C.rowInterval
    let suf : GraphPath G := Col.dropUntil (by simpa [Col] using C.right_mem_column)
    have hpre_mid : pre.target = mid.source := by
      simp [pre, mid, Col]
    have hmid_suf : mid.target = suf.source := by
      simp [mid, suf, Col]
    let whole : GraphPath G :=
      pre.append3WithEqToPath mid suf hpre_mid hmid_suf
    refine
      { path := whole
        source_eq := ?_
        target_eq := ?_
        vertexSet_subset := ?_
        edgeSet_subset := ?_ }
    · simp [whole, pre, Col]
    · simp [whole, suf, Col]
    · intro v hv
      have hvparts :
          v ∈ pre.vertexSet ∪ mid.vertexSet ∪ suf.vertexSet :=
        GraphPath.append3WithEqToPath_vertexSet_subset
          pre mid suf hpre_mid hmid_suf hv
      rcases Finset.mem_union.1 hvparts with hvpm | hvsuf
      · rcases Finset.mem_union.1 hvpm with hvpre | hvmid
        · exact Finset.mem_union.2 <| Or.inl <|
            Col.takeUntil_vertexSet_subset
              (by simpa [Col] using C.left_mem_column)
              (by simpa [pre] using hvpre)
        · exact Finset.mem_union.2 <| Or.inr <|
            by simpa [mid] using hvmid
      · exact Finset.mem_union.2 <| Or.inl <|
          Col.dropUntil_vertexSet_subset
            (by simpa [Col] using C.right_mem_column)
            (by simpa [suf] using hvsuf)
    · intro e he
      have heparts :
          e ∈ pre.edgeSet ∪ mid.edgeSet ∪ suf.edgeSet :=
        GraphPath.append3WithEqToPath_edgeSet_subset
          pre mid suf hpre_mid hmid_suf he
      rcases Finset.mem_union.1 heparts with hepm | hesuf
      · rcases Finset.mem_union.1 hepm with hepre | hemid
        · exact Finset.mem_union.2 <| Or.inl <|
            Col.takeUntil_edgeSet_subset
              (by simpa [Col] using C.left_mem_column)
              (by simpa [pre] using hepre)
        · exact Finset.mem_union.2 <| Or.inr <|
            by simpa [mid] using hemid
      · exact Finset.mem_union.2 <| Or.inl <|
          Col.dropUntil_edgeSet_subset
            (by simpa [Col] using C.right_mem_column)
            (by simpa [suf] using hesuf)
  · let pre : GraphPath G := Col.takeUntil (by simpa [Col] using C.right_mem_column)
    let mid : GraphPath G := C.rowInterval.reverse
    let suf : GraphPath G := Col.dropUntil (by simpa [Col] using C.left_mem_column)
    have hpre_mid : pre.target = mid.source := by
      simp [pre, mid, Col]
    have hmid_suf : mid.target = suf.source := by
      simp [mid, suf, Col]
    let whole : GraphPath G :=
      pre.append3WithEqToPath mid suf hpre_mid hmid_suf
    refine
      { path := whole
        source_eq := ?_
        target_eq := ?_
        vertexSet_subset := ?_
        edgeSet_subset := ?_ }
    · simp [whole, pre, Col]
    · simp [whole, suf, Col]
    · intro v hv
      have hvparts :
          v ∈ pre.vertexSet ∪ mid.vertexSet ∪ suf.vertexSet :=
        GraphPath.append3WithEqToPath_vertexSet_subset
          pre mid suf hpre_mid hmid_suf hv
      rcases Finset.mem_union.1 hvparts with hvpm | hvsuf
      · rcases Finset.mem_union.1 hvpm with hvpre | hvmid
        · exact Finset.mem_union.2 <| Or.inl <|
            Col.takeUntil_vertexSet_subset
              (by simpa [Col] using C.right_mem_column)
              (by simpa [pre] using hvpre)
        · exact Finset.mem_union.2 <| Or.inr <|
            by simpa [mid] using hvmid
      · exact Finset.mem_union.2 <| Or.inl <|
          Col.dropUntil_vertexSet_subset
            (by simpa [Col] using C.left_mem_column)
            (by simpa [suf] using hvsuf)
    · intro e he
      have heparts :
          e ∈ pre.edgeSet ∪ mid.edgeSet ∪ suf.edgeSet :=
        GraphPath.append3WithEqToPath_edgeSet_subset
          pre mid suf hpre_mid hmid_suf he
      rcases Finset.mem_union.1 heparts with hepm | hesuf
      · rcases Finset.mem_union.1 hepm with hepre | hemid
        · exact Finset.mem_union.2 <| Or.inl <|
            Col.takeUntil_edgeSet_subset
              (by simpa [Col] using C.right_mem_column)
              (by simpa [pre] using hepre)
        · exact Finset.mem_union.2 <| Or.inr <|
            by simpa [mid] using hemid
      · exact Finset.mem_union.2 <| Or.inl <|
          Col.dropUntil_edgeSet_subset
            (by simpa [Col] using C.left_mem_column)
            (by simpa [suf] using hesuf)

end TerminalPathHillCandidateData

/-- A post-hill hill is a concrete hill candidate whose row interval is free of
every other current terminal column.  This is the exact row-segment replacement
condition after the terminal column family has already been allowed to change
by previous hill eliminations. -/
structure TerminalPathHill
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (columns : TerminalPathColumnOrder I inv) where
  candidate : TerminalPathHillCandidateData columns
  rowInterval_free_of_other_columns :
    ∀ j' : Fin h, j' ≠ candidate.col →
      Disjoint candidate.rowInterval.vertexSet
        (columns.qstar j').vertexSet

/-- The post-hill normal form: no free hill remains for the current terminal
column family. -/
def TerminalPathNoHill
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (columns : TerminalPathColumnOrder I inv) : Prop :=
  ¬ Nonempty (TerminalPathHill columns)

namespace TerminalPathNoHill

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}
variable {columns : TerminalPathColumnOrder I inv}

/-- If no post-hill hill remains, then every concrete candidate has a blocker:
some other current terminal column meets the row interval that would have been
used for the hill replacement. -/
theorem exists_blocker (hno : TerminalPathNoHill columns)
    (C : TerminalPathHillCandidateData columns) :
    ∃ j' : Fin h, j' ≠ C.col ∧
      ¬ Disjoint C.rowInterval.vertexSet (columns.qstar j').vertexSet := by
  classical
  by_contra hblock
  apply hno
  refine ⟨{
    candidate := C
    rowInterval_free_of_other_columns := ?_
  }⟩
  intro j' hj'
  by_contra hdisj
  exact hblock ⟨j', hj', hdisj⟩

/-- Vertex form of the post-hill blocker statement. -/
theorem exists_blocker_vertex (hno : TerminalPathNoHill columns)
    (C : TerminalPathHillCandidateData columns) :
    ∃ j' : Fin h, ∃ v : V,
      j' ≠ C.col ∧ v ∈ C.rowInterval.vertexSet ∧
        v ∈ (columns.qstar j').vertexSet := by
  classical
  rcases hno.exists_blocker C with ⟨j', hj', hblock⟩
  rcases (Finset.not_disjoint_iff.1 hblock) with ⟨v, hvrow, hvcol⟩
  exact ⟨j', v, hj', hvrow, hvcol⟩

end TerminalPathNoHill

/-- Post-hill endpoint data produced by the no-cross blocker barrier.

Starting from a current-column hill candidate on `C.row`, a blocker column
supplies a segment with endpoints on the immediately higher row and with only
the old hill row as its lower-row contact.  This is the post-hill analogue of
`ClaimB3HigherHillFromBlockerData`. -/
structure TerminalPathHigherHillFromBlockerData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    {columns : TerminalPathColumnOrder I inv}
    (C : TerminalPathHillCandidateData columns) (j' : Fin h) where
  upper : Fin (z h)
  upper_succ : C.row.1 + 1 = upper.1
  left : V
  right : V
  left_mem_upper : left ∈ (terminalPathRowPath inv upper).vertexSet
  right_mem_upper : right ∈ (terminalPathRowPath inv upper).vertexSet
  left_before_right : (terminalPathRowPath inv upper).Before left right
  segment : GraphPath G
  segment_connects : segment.Connects {left} {right}
  segment_subset_column :
    segment.vertexSet ⊆ (columns.qstar j').vertexSet
  segment_edgeSet_subset_column :
    segment.edgeSet ⊆ (columns.qstar j').edgeSet
  hits_lower : HitsGraphPath segment (terminalPathRowPath inv C.row)
  internally_disjoint_from_other_rows :
    segment.InternallyDisjointFromSet
      (Finset.univ.biUnion fun r : Fin (z h) =>
        if r = C.row then ∅ else (terminalPathRowPath inv r).vertexSet)

namespace TerminalPathHigherHillFromBlockerData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}
variable {columns : TerminalPathColumnOrder I inv}
variable {C : TerminalPathHillCandidateData columns} {j' : Fin h}

/-- The blocker-barrier endpoint data is itself a concrete post-hill candidate
one row higher. -/
noncomputable def toHillCandidateData
    (D : TerminalPathHigherHillFromBlockerData C j') :
    TerminalPathHillCandidateData columns where
  row := D.upper
  col := j'
  lower := C.row
  lower_succ := D.upper_succ
  left := D.left
  right := D.right
  left_mem_row := D.left_mem_upper
  right_mem_row := D.right_mem_upper
  left_before_right := D.left_before_right
  segment := D.segment
  segment_connects := D.segment_connects
  segment_subset_column := D.segment_subset_column
  segment_edgeSet_subset_column := D.segment_edgeSet_subset_column
  hits_lower := D.hits_lower
  internally_disjoint_from_other_rows := D.internally_disjoint_from_other_rows

/-- The blocker-produced post-hill candidate is strictly higher than the
candidate it blocks. -/
theorem row_lt_toHillCandidateData
    (D : TerminalPathHigherHillFromBlockerData C j') :
    C.row.1 < (D.toHillCandidateData).row.1 := by
  dsimp [toHillCandidateData]
  have h := D.upper_succ
  omega

end TerminalPathHigherHillFromBlockerData

namespace TerminalPathColumnOrder

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Replace one post-hill terminal column by a path with the same endpoints.

The caller supplies the two preservation facts that are specific to hill
replacement: disjointness from the other terminal columns, and surviving hits
on every current row.  This is the reusable state update for the
hill-elimination descent. -/
noncomputable def replaceColumnSameEndpoints
    (columns : TerminalPathColumnOrder I inv) (j₀ : Fin h)
    (P' : GraphPath G)
    (hdisj :
      ∀ j : Fin h, j ≠ j₀ → P'.NodeDisjoint (columns.qstar j))
    (hhit :
      ∀ i : Fin (z h),
        (((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          P'.vertexSet).Nonempty) :
    TerminalPathColumnOrder I inv where
  qstar := fun j => if j = j₀ then P' else columns.qstar j
  qstar_nodeDisjoint := by
    intro j k hjk
    by_cases hj : j = j₀
    · subst j
      have hk : k ≠ j₀ := by
        intro hk
        exact hjk (by simpa [hk])
      simpa [hk] using hdisj k hk
    · by_cases hk : k = j₀
      · subst k
        exact GraphPath.nodeDisjoint_symm (by simpa [hj] using hdisj j hj)
      · simpa [hj, hk] using columns.qstar_nodeDisjoint hjk
  currentRow_inter_nonempty := by
    intro i j
    by_cases hj : j = j₀
    · subst j
      simpa using hhit i
    · simpa [hj] using columns.currentRow_inter_nonempty i j

/-- Replace the selected column of a concrete post-hill hill candidate by the
constructed hill-replacement path. -/
noncomputable def replaceColumnByHill
    (columns : TerminalPathColumnOrder I inv)
    (C : TerminalPathHillCandidateData columns)
    (hdisj :
      ∀ j : Fin h, j ≠ C.col →
        (C.replacementColumnPath.path).NodeDisjoint (columns.qstar j))
    (hhit :
      ∀ i : Fin (z h),
        (((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          (C.replacementColumnPath.path).vertexSet).Nonempty) :
    TerminalPathColumnOrder I inv :=
  columns.replaceColumnSameEndpoints C.col C.replacementColumnPath.path
    hdisj hhit

end TerminalPathColumnOrder

/-- Terminal branch-set data after hill elimination, using the actual terminal
column paths rather than the original selected `Q₀` paths. -/
structure TerminalPathOrderedIntersectionGridData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0) where
  inv : TypeOneIterationInvariants I
  columns : TerminalPathColumnOrder I inv
  branch_connected :
    ∀ i : Fin (z h), ∀ j : Fin h,
      (G.induce {v : V |
        v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j).vertexSet)}).Connected
  horizontal_adj :
    ∀ i : Fin (z h), ∀ ⦃j j' : Fin h⦄, FinConsecutive j j' →
      ∃ u ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j).vertexSet),
        ∃ v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j').vertexSet),
          G.Adj u v
  vertical_adj :
    ∀ ⦃i i' : Fin (z h)⦄, FinConsecutive i i' → ∀ j : Fin h,
      ∃ u ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j).vertexSet),
        ∃ v ∈ ((I.rowPath (inv.orderedRows.order.symm i')).vertexSet) ∩
          ((columns.qstar j).vertexSet),
          G.Adj u v

namespace TerminalPathOrderedIntersectionGridData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}

/-- Branch set at terminal row `i` and post-hill column `j`. -/
noncomputable def branch (D : TerminalPathOrderedIntersectionGridData I)
    (i : Fin (z h)) (j : Fin h) : Finset V :=
  (I.rowPath (D.inv.orderedRows.order.symm i)).vertexSet ∩
    (D.columns.qstar j).vertexSet

noncomputable def rowSet (D : TerminalPathOrderedIntersectionGridData I)
    (i : Fin (z h)) : Finset V :=
  (I.rowPath (D.inv.orderedRows.order.symm i)).vertexSet

noncomputable def colSet (D : TerminalPathOrderedIntersectionGridData I)
    (j : Fin h) : Finset V :=
  (D.columns.qstar j).vertexSet

theorem branch_nonempty (D : TerminalPathOrderedIntersectionGridData I)
    (i : Fin (z h)) (j : Fin h) :
    (D.branch i j).Nonempty :=
  D.columns.currentRow_inter_nonempty i j

theorem branch_subset_row (D : TerminalPathOrderedIntersectionGridData I)
    (i : Fin (z h)) (j : Fin h) :
    D.branch i j ⊆ D.rowSet i := by
  intro v hv
  exact (Finset.mem_inter.1 hv).1

theorem branch_subset_col (D : TerminalPathOrderedIntersectionGridData I)
    (i : Fin (z h)) (j : Fin h) :
    D.branch i j ⊆ D.colSet j := by
  intro v hv
  exact (Finset.mem_inter.1 hv).2

theorem rowSet_disjoint (D : TerminalPathOrderedIntersectionGridData I)
    ⦃i i' : Fin (z h)⦄ (hii : i ≠ i') :
    Disjoint (D.rowSet i) (D.rowSet i') := by
  classical
  have hrow_ne :
      D.inv.orderedRows.order.symm i ≠
        D.inv.orderedRows.order.symm i' := by
    intro h
    exact hii (by
      have := congrArg D.inv.orderedRows.order h
      simpa using this)
  exact D.inv.rowsNodeDisjoint hrow_ne

theorem colSet_disjoint (D : TerminalPathOrderedIntersectionGridData I)
    ⦃j j' : Fin h⦄ (hjj : j ≠ j') :
    Disjoint (D.colSet j) (D.colSet j') := by
  change Disjoint (D.columns.qstar j).vertexSet
    (D.columns.qstar j').vertexSet
  simpa [GraphPath.NodeDisjoint] using D.columns.qstar_nodeDisjoint hjj

theorem branch_disjoint (D : TerminalPathOrderedIntersectionGridData I)
    ⦃i i' : Fin (z h)⦄ ⦃j j' : Fin h⦄
    (hij : (i, j) ≠ (i', j')) :
    Disjoint (D.branch i j) (D.branch i' j') :=
  branch_disjoint_of_row_column_disjoint
    D.rowSet D.colSet D.branch D.branch_subset_row D.branch_subset_col
    (fun _ _ h => D.rowSet_disjoint h)
    (fun _ _ h => D.colSet_disjoint h) hij

/-- Convert post-hill terminal intersection data into a rectangular grid
branch model. -/
noncomputable def toRectangularGridBranchModel
    (D : TerminalPathOrderedIntersectionGridData I) :
    RectangularGridBranchModel G (z h) h where
  branch := D.branch
  branch_nonempty := D.branch_nonempty
  branch_connected := D.branch_connected
  branch_disjoint := by
    intro i j i' j' hne
    exact D.branch_disjoint hne
  horizontal_adj := D.horizontal_adj
  vertical_adj := D.vertical_adj

/-- The post-hill terminal grid data gives the desired `h × h` grid minor. -/
theorem containsGridMinor (D : TerminalPathOrderedIntersectionGridData I) :
    ContainsGridMinor G h := by
  have hrows : h ≤ z h := by
    dsimp [z]
    omega
  exact D.toRectangularGridBranchModel.containsGridMinor_topSquare hrows

end TerminalPathOrderedIntersectionGridData

