/-- Build the exact Figure 8 local record from actual-endpoint data in the
forward/backward row-order cases. -/
noncomputable def ofActualEndpointData
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Cross : CrossWitness I)
    (hforwardEndpoint :
      ∀ hforward :
        (Inv.base.orderedRows.order Cross.rowLeft).1 + 1 =
          (Inv.base.orderedRows.order Cross.rowRight).1,
        let D :=
          TypeOneExtendedFutureCleanIterationInvariants.crossForwardLocalQuadData
            (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
            Inv Cross hforward
        EndpointOutsideNeighborData Inv Cross D.auxA D.auxD)
    (hbackwardEndpoint :
      ∀ hbackward :
        (Inv.base.orderedRows.order Cross.rowRight).1 + 1 =
          (Inv.base.orderedRows.order Cross.rowLeft).1,
        let D :=
          TypeOneExtendedFutureCleanIterationInvariants.crossBackwardLocalQuadData
            (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
            Inv Cross hbackward
        EndpointOutsideNeighborData Inv Cross D.auxA D.auxD) :
    CrossLocalOutsideData Inv Cross := by
  classical
  by_cases hforward :
      (Inv.base.orderedRows.order Cross.rowLeft).1 + 1 =
        (Inv.base.orderedRows.order Cross.rowRight).1
  · let D :=
      TypeOneExtendedFutureCleanIterationInvariants.crossForwardLocalQuadData
        (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
        Inv Cross hforward
    exact CrossLocalOutsideData.ofForwardQuadAndEndpoint Inv Cross D
      (hforwardEndpoint hforward)
  · have hbackward :
        (Inv.base.orderedRows.order Cross.rowRight).1 + 1 =
          (Inv.base.orderedRows.order Cross.rowLeft).1 :=
      Or.resolve_left (Cross.old_rows_forward_or_backward Inv) hforward
    let D :=
      TypeOneExtendedFutureCleanIterationInvariants.crossBackwardLocalQuadData
        (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
        Inv Cross hbackward
    exact CrossLocalOutsideData.ofBackwardQuadAndEndpoint Inv Cross D
      (hbackwardEndpoint hbackward)

/-- Forward Figure 8 local outside data in the fully interior case.

Here the crossed rows have active rows on both sides, and those endpoint rows
also have active outside neighbors.  This is the main finite arithmetic case;
boundary variants replace one of these four active neighbors by the stored
lower/upper boundary or outside boundary neighbor. -/
noncomputable def ofForwardInteriorInvariant
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Cross : CrossWitness I)
    (hforward :
      (Inv.base.orderedRows.order Cross.rowLeft).1 + 1 =
        (Inv.base.orderedRows.order Cross.rowRight).1)
    (hleft_not_first :
      (Inv.base.orderedRows.order Cross.rowLeft).1 ≠ 0)
    (hprev_not_first :
      (Inv.base.orderedRows.order Cross.rowLeft).1 ≠ 1)
    (hright_not_last :
      (Inv.base.orderedRows.order Cross.rowRight).1 + 1 ≠ z h)
    (hnext_not_last :
      (Inv.base.orderedRows.order Cross.rowRight).1 + 2 ≠ z h) :
    CrossLocalOutsideData Inv Cross := by
  classical
  let order := Inv.base.orderedRows.order
  let pL : Fin (z h) := order Cross.rowLeft
  let pR : Fin (z h) := order Cross.rowRight
  have hforward_val : pL.1 + 1 = pR.1 := by
    simpa [pL, pR] using hforward
  have hleft_not_first_val : pL.1 ≠ 0 := by
    simpa [pL] using hleft_not_first
  have hprev_not_first_val : pL.1 ≠ 1 := by
    simpa [pL] using hprev_not_first
  have hright_not_last_val : pR.1 + 1 ≠ z h := by
    simpa [pR] using hright_not_last
  have hnext_not_last_val : pR.1 + 2 ≠ z h := by
    simpa [pR] using hnext_not_last
  let prevFin : Fin (z h) := ⟨pL.1 - 1, by omega⟩
  let prevRow : I.Row := order.symm prevFin
  have hprev_order : order prevRow = prevFin := by
    simp [prevRow]
  let prevPrevFin : Fin (z h) := ⟨pL.1 - 2, by omega⟩
  let prevPrevRow : I.Row := order.symm prevPrevFin
  have hprevPrev_order : order prevPrevRow = prevPrevFin := by
    simp [prevPrevRow]
  let nextFin : Fin (z h) := ⟨pR.1 + 1, by
    have hpRlt : pR.1 < z h := pR.2
    omega⟩
  let nextRow : I.Row := order.symm nextFin
  have hnext_order : order nextRow = nextFin := by
    simp [nextRow]
  let nextNextFin : Fin (z h) := ⟨pR.1 + 2, by
    have hpRlt : pR.1 < z h := pR.2
    omega⟩
  let nextNextRow : I.Row := order.symm nextNextFin
  have hnextNext_order : order nextNextRow = nextNextFin := by
    simp [nextNextRow]
  have hcon_prevPrev :
      FinConsecutive (order prevPrevRow) (order prevRow) := by
    rw [hprevPrev_order, hprev_order]
    change prevPrevFin.1 + 1 = prevFin.1 ∨
      prevFin.1 + 1 = prevPrevFin.1
    left
    simp [prevPrevFin, prevFin]
    omega
  have hcon_prev :
      FinConsecutive (order prevRow) (order Cross.rowLeft) := by
    rw [hprev_order]
    change prevFin.1 + 1 = pL.1 ∨ pL.1 + 1 = prevFin.1
    left
    simp [prevFin, pL]
    omega
  have hcon_next :
      FinConsecutive (order Cross.rowRight) (order nextRow) := by
    rw [hnext_order]
    change pR.1 + 1 = nextFin.1 ∨ nextFin.1 + 1 = pR.1
    left
    simp [nextFin, pR]
  have hcon_nextNext :
      FinConsecutive (order nextRow) (order nextNextRow) := by
    rw [hnext_order, hnextNext_order]
    change nextFin.1 + 1 = nextNextFin.1 ∨
      nextNextFin.1 + 1 = nextFin.1
    left
    simp [nextFin, nextNextFin]
  have h_auxL_ne_auxA :
      I.rowIndex prevPrevRow ≠ I.rowIndex prevRow :=
    Inv.base.rowIndex_ne_of_order_val_ne (by
      change (order prevPrevRow).1 ≠ (order prevRow).1
      rw [hprevPrev_order, hprev_order]
      simp [prevPrevFin, prevFin]
      omega)
  have h_auxL_ne_left :
      I.rowIndex prevPrevRow ≠ I.rowIndex Cross.rowLeft :=
    Inv.base.rowIndex_ne_of_order_val_ne (by
      change (order prevPrevRow).1 ≠ (order Cross.rowLeft).1
      rw [hprevPrev_order]
      change prevPrevFin.1 ≠ pL.1
      simp [prevPrevFin]
      omega)
  have h_auxL_ne_right :
      I.rowIndex prevPrevRow ≠ I.rowIndex Cross.rowRight :=
    Inv.base.rowIndex_ne_of_order_val_ne (by
      change (order prevPrevRow).1 ≠ (order Cross.rowRight).1
      rw [hprevPrev_order]
      change prevPrevFin.1 ≠ pR.1
      simp [prevPrevFin]
      omega)
  have h_auxL_ne_auxD :
      I.rowIndex prevPrevRow ≠ I.rowIndex nextRow :=
    Inv.base.rowIndex_ne_of_order_val_ne (by
      change (order prevPrevRow).1 ≠ (order nextRow).1
      rw [hprevPrev_order, hnext_order]
      simp [prevPrevFin, nextFin]
      omega)
  have h_auxR_ne_auxA :
      I.rowIndex nextNextRow ≠ I.rowIndex prevRow :=
    Inv.base.rowIndex_ne_of_order_val_ne (by
      change (order nextNextRow).1 ≠ (order prevRow).1
      rw [hnextNext_order, hprev_order]
      simp [nextNextFin, prevFin]
      omega)
  have h_auxR_ne_left :
      I.rowIndex nextNextRow ≠ I.rowIndex Cross.rowLeft :=
    Inv.base.rowIndex_ne_of_order_val_ne (by
      change (order nextNextRow).1 ≠ (order Cross.rowLeft).1
      rw [hnextNext_order]
      change nextNextFin.1 ≠ pL.1
      simp [nextNextFin]
      omega)
  have h_auxR_ne_right :
      I.rowIndex nextNextRow ≠ I.rowIndex Cross.rowRight :=
    Inv.base.rowIndex_ne_of_order_val_ne (by
      change (order nextNextRow).1 ≠ (order Cross.rowRight).1
      rw [hnextNext_order]
      change nextNextFin.1 ≠ pR.1
      simp [nextNextFin])
  have h_auxR_ne_auxD :
      I.rowIndex nextNextRow ≠ I.rowIndex nextRow :=
    Inv.base.rowIndex_ne_of_order_val_ne (by
      change (order nextNextRow).1 ≠ (order nextRow).1
      rw [hnextNext_order, hnext_order]
      simp [nextNextFin, nextFin])
  have h_auxA_ne_left :
      I.rowIndex prevRow ≠ I.rowIndex Cross.rowLeft :=
    Inv.base.rowIndex_ne_of_order_val_ne (by
      change (order prevRow).1 ≠ (order Cross.rowLeft).1
      rw [hprev_order]
      change prevFin.1 ≠ pL.1
      simp [prevFin]
      omega)
  have h_auxA_ne_right :
      I.rowIndex prevRow ≠ I.rowIndex Cross.rowRight :=
    Inv.base.rowIndex_ne_of_order_val_ne (by
      change (order prevRow).1 ≠ (order Cross.rowRight).1
      rw [hprev_order]
      change prevFin.1 ≠ pR.1
      simp [prevFin]
      omega)
  have h_auxA_ne_auxD :
      I.rowIndex prevRow ≠ I.rowIndex nextRow :=
    Inv.base.rowIndex_ne_of_order_val_ne (by
      change (order prevRow).1 ≠ (order nextRow).1
      rw [hprev_order, hnext_order]
      simp [prevFin, nextFin]
      omega)
  have h_left_ne_auxD :
      I.rowIndex Cross.rowLeft ≠ I.rowIndex nextRow :=
    Inv.base.rowIndex_ne_of_order_val_ne (by
      change (order Cross.rowLeft).1 ≠ (order nextRow).1
      rw [hnext_order]
      change pL.1 ≠ nextFin.1
      simp [nextFin]
      omega)
  have h_auxD_ne_right :
      I.rowIndex nextRow ≠ I.rowIndex Cross.rowRight :=
    Inv.base.rowIndex_ne_of_order_val_ne (by
      change (order nextRow).1 ≠ (order Cross.rowRight).1
      rw [hnext_order]
      change nextFin.1 ≠ pR.1
      simp [nextFin])
  refine
    { auxL := I.rowIndex prevPrevRow
      auxA := I.rowIndex prevRow
      auxD := I.rowIndex nextRow
      auxR := I.rowIndex nextNextRow
      hLA_old := ?_
      hAU_old := ?_
      hUV_old := Cross.old_aux_adj_left_right
      hVD_old := ?_
      hDR_old := ?_
      hA_old := Inv.extended.full.active_aux.degree_two prevRow
      hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
      hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
      hD_old := Inv.extended.full.active_aux.degree_two nextRow
      hL_not := ?_
      hR_not := ?_
      hLU := h_auxL_ne_left
      hRV := h_auxR_ne_right
      hAU_ne := h_auxA_ne_left
      hAD := h_auxA_ne_auxD
      hUD := h_left_ne_auxD
      hAV := h_auxA_ne_right
      hDV := h_auxD_ne_right
      hLD := h_auxL_ne_auxD }
  · exact (linkageAuxGraph I.linkage).symm
      (Inv.extended.full.active_aux.consecutive_adj hcon_prevPrev)
  · exact Inv.extended.full.active_aux.consecutive_adj hcon_prev
  · exact Inv.extended.full.active_aux.consecutive_adj hcon_next
  · exact Inv.extended.full.active_aux.consecutive_adj hcon_nextNext
  · simp [h_auxL_ne_auxA, h_auxL_ne_left, h_auxL_ne_right,
      h_auxL_ne_auxD]
  · simp [h_auxR_ne_auxA, h_auxR_ne_left, h_auxR_ne_right,
      h_auxR_ne_auxD]

/-- Forward Figure 8 local outside data when the crossed pair starts at the
first active row. -/
noncomputable def ofForwardLeftBoundaryInvariant
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Cross : CrossWitness I)
    (hforward :
      (Inv.base.orderedRows.order Cross.rowLeft).1 + 1 =
        (Inv.base.orderedRows.order Cross.rowRight).1)
    (hleft_first : (Inv.base.orderedRows.order Cross.rowLeft).1 = 0) :
    CrossLocalOutsideData Inv Cross := by
  classical
  let order := Inv.base.orderedRows.order
  let pL : Fin (z h) := order Cross.rowLeft
  let pR : Fin (z h) := order Cross.rowRight
  have hforward_val : pL.1 + 1 = pR.1 := by
    simpa [pL, pR] using hforward
  have hleft_first_val : pL.1 = 0 := by
    simpa [pL] using hleft_first
  have hrow_left_first :
      Cross.rowLeft =
        order.symm (⟨0, by
          dsimp [z]
          omega⟩ : Fin (z h)) := by
    apply order.injective
    apply Fin.ext
    simp [pL, hleft_first_val]
  let H := linkageAuxGraph I.linkage
  by_cases hright_last : pR.1 + 1 = z h
  · have hrow_right_last :
        Cross.rowRight =
          order.symm
            (⟨z h - 1, by
              dsimp [z]
              omega⟩ : Fin (z h)) := by
      apply order.injective
      apply Fin.ext
      simp
      omega
    refine
      { auxL := Inv.extended.boundary.lowerOutside
        auxA := Inv.extended.boundary.lowerBoundary
        auxD := Inv.extended.boundary.upperBoundary
        auxR := Inv.extended.boundary.upperOutside
        hLA_old := Inv.extended.boundary.lower_adj_outside
        hAU_old := ?_
        hUV_old := Cross.old_aux_adj_left_right
        hVD_old := ?_
        hDR_old := Inv.extended.boundary.upper_adj_outside
        hA_old := Inv.extended.boundary.lower_degree_two
        hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
        hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
        hD_old := Inv.extended.boundary.upper_degree_two
        hL_not := ?_
        hR_not := ?_
        hLU := Inv.extended.boundary.lowerOutside_ne_row Cross.rowLeft
        hRV := Inv.extended.boundary.upperOutside_ne_row Cross.rowRight
        hAU_ne := Inv.extended.boundary.lower_ne_row Cross.rowLeft
        hAD := Inv.extended.boundary.lower_ne_upper
        hUD := (Inv.extended.boundary.upper_ne_row Cross.rowLeft).symm
        hAV := Inv.extended.boundary.lower_ne_row Cross.rowRight
        hDV := Inv.extended.boundary.upper_ne_row Cross.rowRight
        hLD := Inv.extended.boundary.lowerOutside_ne_upper }
    · simpa [hrow_left_first] using Inv.extended.boundary.lower_adj_first
    · simpa [hrow_right_last] using Inv.extended.boundary.last_adj_upper
    · simp [Inv.extended.boundary.lowerOutside_ne_lower,
        Inv.extended.boundary.lowerOutside_ne_row Cross.rowLeft,
        Inv.extended.boundary.lowerOutside_ne_row Cross.rowRight,
        Inv.extended.boundary.lowerOutside_ne_upper]
    · simp [Inv.extended.boundary.upperOutside_ne_lower,
        Inv.extended.boundary.upperOutside_ne_row Cross.rowLeft,
        Inv.extended.boundary.upperOutside_ne_row Cross.rowRight,
        Inv.extended.boundary.upperOutside_ne_upper]
  · let nextFin : Fin (z h) := ⟨pR.1 + 1, by
      have hpRlt : pR.1 < z h := pR.2
      omega⟩
    let nextRow : I.Row := order.symm nextFin
    have hnext_order : order nextRow = nextFin := by
      simp [nextRow]
    have hcon_next :
        FinConsecutive (order Cross.rowRight) (order nextRow) := by
      rw [hnext_order]
      change pR.1 + 1 = nextFin.1 ∨ nextFin.1 + 1 = pR.1
      left
      simp [nextFin, pR]
    have h_left_ne_next :
        I.rowIndex Cross.rowLeft ≠ I.rowIndex nextRow :=
      Inv.base.rowIndex_ne_of_order_val_ne (by
        change (order Cross.rowLeft).1 ≠ (order nextRow).1
        rw [hnext_order]
        change pL.1 ≠ nextFin.1
        simp [nextFin]
        omega)
    have h_next_ne_right :
        I.rowIndex nextRow ≠ I.rowIndex Cross.rowRight :=
      Inv.base.rowIndex_ne_of_order_val_ne (by
        change (order nextRow).1 ≠ (order Cross.rowRight).1
        rw [hnext_order]
        change nextFin.1 ≠ pR.1
        simp [nextFin])
    by_cases hnext_last : pR.1 + 2 = z h
    · have hnext_row_last :
          nextRow =
            order.symm
              (⟨z h - 1, by
                dsimp [z]
                omega⟩ : Fin (z h)) := by
        apply order.injective
        apply Fin.ext
        simp [hnext_order, nextFin]
        omega
      refine
        { auxL := Inv.extended.boundary.lowerOutside
          auxA := Inv.extended.boundary.lowerBoundary
          auxD := I.rowIndex nextRow
          auxR := Inv.extended.boundary.upperBoundary
          hLA_old := Inv.extended.boundary.lower_adj_outside
          hAU_old := ?_
          hUV_old := Cross.old_aux_adj_left_right
          hVD_old := ?_
          hDR_old := ?_
          hA_old := Inv.extended.boundary.lower_degree_two
          hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
          hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
          hD_old := Inv.extended.full.active_aux.degree_two nextRow
          hL_not := ?_
          hR_not := ?_
          hLU := Inv.extended.boundary.lowerOutside_ne_row Cross.rowLeft
          hRV := Inv.extended.boundary.upper_ne_row Cross.rowRight
          hAU_ne := Inv.extended.boundary.lower_ne_row Cross.rowLeft
          hAD := Inv.extended.boundary.lower_ne_row nextRow
          hUD := h_left_ne_next
          hAV := Inv.extended.boundary.lower_ne_row Cross.rowRight
          hDV := h_next_ne_right
          hLD := Inv.extended.boundary.lowerOutside_ne_row nextRow }
      · simpa [hrow_left_first] using Inv.extended.boundary.lower_adj_first
      · exact Inv.extended.full.active_aux.consecutive_adj hcon_next
      · have hadj :
            H.Adj (I.rowIndex nextRow) Inv.extended.boundary.upperBoundary := by
          simpa [hnext_row_last] using Inv.extended.boundary.last_adj_upper
        exact hadj
      · simp [Inv.extended.boundary.lowerOutside_ne_lower,
          Inv.extended.boundary.lowerOutside_ne_row Cross.rowLeft,
          Inv.extended.boundary.lowerOutside_ne_row Cross.rowRight,
          Inv.extended.boundary.lowerOutside_ne_row nextRow]
      · simp [Inv.extended.boundary.lower_ne_upper.symm,
          Inv.extended.boundary.upper_ne_row Cross.rowLeft,
          Inv.extended.boundary.upper_ne_row Cross.rowRight,
          Inv.extended.boundary.upper_ne_row nextRow]
    · let nextNextFin : Fin (z h) := ⟨pR.1 + 2, by
        have hpRlt : pR.1 < z h := pR.2
        omega⟩
      let nextNextRow : I.Row := order.symm nextNextFin
      have hnextNext_order : order nextNextRow = nextNextFin := by
        simp [nextNextRow]
      have hcon_nextNext :
          FinConsecutive (order nextRow) (order nextNextRow) := by
        rw [hnext_order, hnextNext_order]
        change nextFin.1 + 1 = nextNextFin.1 ∨
          nextNextFin.1 + 1 = nextFin.1
        left
        simp [nextFin, nextNextFin]
      have h_auxR_ne_left :
          I.rowIndex nextNextRow ≠ I.rowIndex Cross.rowLeft :=
        Inv.base.rowIndex_ne_of_order_val_ne (by
          change (order nextNextRow).1 ≠ (order Cross.rowLeft).1
          rw [hnextNext_order]
          change nextNextFin.1 ≠ pL.1
          simp [nextNextFin]
          omega)
      have h_auxR_ne_right :
          I.rowIndex nextNextRow ≠ I.rowIndex Cross.rowRight :=
        Inv.base.rowIndex_ne_of_order_val_ne (by
          change (order nextNextRow).1 ≠ (order Cross.rowRight).1
          rw [hnextNext_order]
          change nextNextFin.1 ≠ pR.1
          simp [nextNextFin])
      have h_auxR_ne_next :
          I.rowIndex nextNextRow ≠ I.rowIndex nextRow :=
        Inv.base.rowIndex_ne_of_order_val_ne (by
          change (order nextNextRow).1 ≠ (order nextRow).1
          rw [hnextNext_order, hnext_order]
          simp [nextNextFin, nextFin])
      refine
        { auxL := Inv.extended.boundary.lowerOutside
          auxA := Inv.extended.boundary.lowerBoundary
          auxD := I.rowIndex nextRow
          auxR := I.rowIndex nextNextRow
          hLA_old := Inv.extended.boundary.lower_adj_outside
          hAU_old := ?_
          hUV_old := Cross.old_aux_adj_left_right
          hVD_old := ?_
          hDR_old := ?_
          hA_old := Inv.extended.boundary.lower_degree_two
          hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
          hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
          hD_old := Inv.extended.full.active_aux.degree_two nextRow
          hL_not := ?_
          hR_not := ?_
          hLU := Inv.extended.boundary.lowerOutside_ne_row Cross.rowLeft
          hRV := h_auxR_ne_right
          hAU_ne := Inv.extended.boundary.lower_ne_row Cross.rowLeft
          hAD := Inv.extended.boundary.lower_ne_row nextRow
          hUD := h_left_ne_next
          hAV := Inv.extended.boundary.lower_ne_row Cross.rowRight
          hDV := h_next_ne_right
          hLD := Inv.extended.boundary.lowerOutside_ne_row nextRow }
      · simpa [hrow_left_first] using Inv.extended.boundary.lower_adj_first
      · exact Inv.extended.full.active_aux.consecutive_adj hcon_next
      · exact Inv.extended.full.active_aux.consecutive_adj hcon_nextNext
      · simp [Inv.extended.boundary.lowerOutside_ne_lower,
          Inv.extended.boundary.lowerOutside_ne_row Cross.rowLeft,
          Inv.extended.boundary.lowerOutside_ne_row Cross.rowRight,
          Inv.extended.boundary.lowerOutside_ne_row nextRow]
      · simp [h_auxR_ne_left, h_auxR_ne_right, h_auxR_ne_next,
          (Inv.extended.boundary.lower_ne_row nextNextRow).symm]

/-- Forward Figure 8 local outside data when the crossed pair ends at the
last active row. -/
noncomputable def ofForwardRightBoundaryInvariant
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Cross : CrossWitness I)
    (hforward :
      (Inv.base.orderedRows.order Cross.rowLeft).1 + 1 =
        (Inv.base.orderedRows.order Cross.rowRight).1)
    (hright_last :
      (Inv.base.orderedRows.order Cross.rowRight).1 + 1 = z h) :
    CrossLocalOutsideData Inv Cross := by
  classical
  let order := Inv.base.orderedRows.order
  let pL : Fin (z h) := order Cross.rowLeft
  let pR : Fin (z h) := order Cross.rowRight
  have hforward_val : pL.1 + 1 = pR.1 := by
    simpa [pL, pR] using hforward
  have hright_last_val : pR.1 + 1 = z h := by
    simpa [pR] using hright_last
  by_cases hleft_first : pL.1 = 0
  · exact
      CrossLocalOutsideData.ofForwardLeftBoundaryInvariant
        (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
        Inv Cross hforward (by simpa [pL] using hleft_first)
  · let H := linkageAuxGraph I.linkage
    have hrow_right_last :
        Cross.rowRight =
          order.symm
            (⟨z h - 1, by
              dsimp [z]
              omega⟩ : Fin (z h)) := by
      apply order.injective
      apply Fin.ext
      simp
      omega
    let prevFin : Fin (z h) := ⟨pL.1 - 1, by omega⟩
    let prevRow : I.Row := order.symm prevFin
    have hprev_order : order prevRow = prevFin := by
      simp [prevRow]
    have hcon_prev :
        FinConsecutive (order prevRow) (order Cross.rowLeft) := by
      rw [hprev_order]
      change prevFin.1 + 1 = pL.1 ∨ pL.1 + 1 = prevFin.1
      left
      simp [prevFin, pL]
      omega
    have h_prev_ne_left :
        I.rowIndex prevRow ≠ I.rowIndex Cross.rowLeft :=
      Inv.base.rowIndex_ne_of_order_val_ne (by
        change (order prevRow).1 ≠ (order Cross.rowLeft).1
        rw [hprev_order]
        change prevFin.1 ≠ pL.1
        simp [prevFin]
        omega)
    have h_prev_ne_right :
        I.rowIndex prevRow ≠ I.rowIndex Cross.rowRight :=
      Inv.base.rowIndex_ne_of_order_val_ne (by
        change (order prevRow).1 ≠ (order Cross.rowRight).1
        rw [hprev_order]
        change prevFin.1 ≠ pR.1
        simp [prevFin]
        omega)
    by_cases hprev_first : pL.1 = 1
    · have hprev_row_first :
          prevRow =
            order.symm (⟨0, by
              dsimp [z]
              omega⟩ : Fin (z h)) := by
        apply order.injective
        apply Fin.ext
        simp [hprev_order, prevFin]
        omega
      refine
        { auxL := Inv.extended.boundary.lowerBoundary
          auxA := I.rowIndex prevRow
          auxD := Inv.extended.boundary.upperBoundary
          auxR := Inv.extended.boundary.upperOutside
          hLA_old := ?_
          hAU_old := ?_
          hUV_old := Cross.old_aux_adj_left_right
          hVD_old := ?_
          hDR_old := Inv.extended.boundary.upper_adj_outside
          hA_old := Inv.extended.full.active_aux.degree_two prevRow
          hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
          hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
          hD_old := Inv.extended.boundary.upper_degree_two
          hL_not := ?_
          hR_not := ?_
          hLU := Inv.extended.boundary.lower_ne_row Cross.rowLeft
          hRV := Inv.extended.boundary.upperOutside_ne_row Cross.rowRight
          hAU_ne := h_prev_ne_left
          hAD := (Inv.extended.boundary.upper_ne_row prevRow).symm
          hUD := (Inv.extended.boundary.upper_ne_row Cross.rowLeft).symm
          hAV := h_prev_ne_right
          hDV := Inv.extended.boundary.upper_ne_row Cross.rowRight
          hLD := Inv.extended.boundary.lower_ne_upper }
      · exact H.symm (by
          simpa [hprev_row_first] using
            Inv.extended.boundary.lower_adj_first)
      · exact Inv.extended.full.active_aux.consecutive_adj hcon_prev
      · simpa [hrow_right_last] using Inv.extended.boundary.last_adj_upper
      · simp [Inv.extended.boundary.lower_ne_row prevRow,
          Inv.extended.boundary.lower_ne_row Cross.rowLeft,
          Inv.extended.boundary.lower_ne_row Cross.rowRight,
          Inv.extended.boundary.lower_ne_upper]
      · simp [Inv.extended.boundary.upperOutside_ne_row prevRow,
          Inv.extended.boundary.upperOutside_ne_row Cross.rowLeft,
          Inv.extended.boundary.upperOutside_ne_row Cross.rowRight,
          Inv.extended.boundary.upperOutside_ne_upper]
    · let prevPrevFin : Fin (z h) := ⟨pL.1 - 2, by omega⟩
      let prevPrevRow : I.Row := order.symm prevPrevFin
      have hprevPrev_order : order prevPrevRow = prevPrevFin := by
        simp [prevPrevRow]
      have hcon_prevPrev :
          FinConsecutive (order prevPrevRow) (order prevRow) := by
        rw [hprevPrev_order, hprev_order]
        change prevPrevFin.1 + 1 = prevFin.1 ∨
          prevFin.1 + 1 = prevPrevFin.1
        left
        simp [prevPrevFin, prevFin]
        omega
      have h_prevPrev_ne_prev :
          I.rowIndex prevPrevRow ≠ I.rowIndex prevRow :=
        Inv.base.rowIndex_ne_of_order_val_ne (by
          change (order prevPrevRow).1 ≠ (order prevRow).1
          rw [hprevPrev_order, hprev_order]
          simp [prevPrevFin, prevFin]
          omega)
      have h_prevPrev_ne_left :
          I.rowIndex prevPrevRow ≠ I.rowIndex Cross.rowLeft :=
        Inv.base.rowIndex_ne_of_order_val_ne (by
          change (order prevPrevRow).1 ≠ (order Cross.rowLeft).1
          rw [hprevPrev_order]
          change prevPrevFin.1 ≠ pL.1
          simp [prevPrevFin]
          omega)
      have h_prevPrev_ne_right :
          I.rowIndex prevPrevRow ≠ I.rowIndex Cross.rowRight :=
        Inv.base.rowIndex_ne_of_order_val_ne (by
          change (order prevPrevRow).1 ≠ (order Cross.rowRight).1
          rw [hprevPrev_order]
          change prevPrevFin.1 ≠ pR.1
          simp [prevPrevFin]
          omega)
      refine
        { auxL := I.rowIndex prevPrevRow
          auxA := I.rowIndex prevRow
          auxD := Inv.extended.boundary.upperBoundary
          auxR := Inv.extended.boundary.upperOutside
          hLA_old := ?_
          hAU_old := ?_
          hUV_old := Cross.old_aux_adj_left_right
          hVD_old := ?_
          hDR_old := Inv.extended.boundary.upper_adj_outside
          hA_old := Inv.extended.full.active_aux.degree_two prevRow
          hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
          hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
          hD_old := Inv.extended.boundary.upper_degree_two
          hL_not := ?_
          hR_not := ?_
          hLU := h_prevPrev_ne_left
          hRV := Inv.extended.boundary.upperOutside_ne_row Cross.rowRight
          hAU_ne := h_prev_ne_left
          hAD := (Inv.extended.boundary.upper_ne_row prevRow).symm
          hUD := (Inv.extended.boundary.upper_ne_row Cross.rowLeft).symm
          hAV := h_prev_ne_right
          hDV := Inv.extended.boundary.upper_ne_row Cross.rowRight
          hLD := (Inv.extended.boundary.upper_ne_row prevPrevRow).symm }
      · exact H.symm (Inv.extended.full.active_aux.consecutive_adj
          hcon_prevPrev)
      · exact Inv.extended.full.active_aux.consecutive_adj hcon_prev
      · simpa [hrow_right_last] using Inv.extended.boundary.last_adj_upper
      · simp [h_prevPrev_ne_prev, h_prevPrev_ne_left, h_prevPrev_ne_right,
          (Inv.extended.boundary.upper_ne_row prevPrevRow).symm]
      · simp [Inv.extended.boundary.upperOutside_ne_row prevRow,
          Inv.extended.boundary.upperOutside_ne_row Cross.rowLeft,
          Inv.extended.boundary.upperOutside_ne_row Cross.rowRight,
          Inv.extended.boundary.upperOutside_ne_upper]

/-- Forward Figure 8 local outside data when the crossed pair starts at the
second active row.  The left local endpoint is then the first active row, whose
outside neighbor is the fixed lower boundary row. -/
noncomputable def ofForwardSecondRowInvariant
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Cross : CrossWitness I)
    (hforward :
      (Inv.base.orderedRows.order Cross.rowLeft).1 + 1 =
        (Inv.base.orderedRows.order Cross.rowRight).1)
    (hleft_second :
      (Inv.base.orderedRows.order Cross.rowLeft).1 = 1) :
    CrossLocalOutsideData Inv Cross := by
  classical
  let order := Inv.base.orderedRows.order
  let pL : Fin (z h) := order Cross.rowLeft
  let pR : Fin (z h) := order Cross.rowRight
  have hforward_val : pL.1 + 1 = pR.1 := by
    simpa [pL, pR] using hforward
  have hleft_second_val : pL.1 = 1 := by
    simpa [pL] using hleft_second
  by_cases hright_last : pR.1 + 1 = z h
  · exact
      CrossLocalOutsideData.ofForwardRightBoundaryInvariant
        (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
        Inv Cross hforward (by simpa [pR] using hright_last)
  · let H := linkageAuxGraph I.linkage
    let prevFin : Fin (z h) := ⟨pL.1 - 1, by omega⟩
    let prevRow : I.Row := order.symm prevFin
    have hprev_order : order prevRow = prevFin := by
      simp [prevRow]
    have hprev_row_first :
        prevRow =
          order.symm (⟨0, by
            dsimp [z]
            omega⟩ : Fin (z h)) := by
      apply order.injective
      apply Fin.ext
      simp [hprev_order, prevFin]
      omega
    have hcon_prev :
        FinConsecutive (order prevRow) (order Cross.rowLeft) := by
      rw [hprev_order]
      change prevFin.1 + 1 = pL.1 ∨ pL.1 + 1 = prevFin.1
      left
      simp [prevFin, pL]
      omega
    let nextFin : Fin (z h) := ⟨pR.1 + 1, by
      have hpRlt : pR.1 < z h := pR.2
      omega⟩
    let nextRow : I.Row := order.symm nextFin
    have hnext_order : order nextRow = nextFin := by
      simp [nextRow]
    have hcon_next :
        FinConsecutive (order Cross.rowRight) (order nextRow) := by
      rw [hnext_order]
      change pR.1 + 1 = nextFin.1 ∨ nextFin.1 + 1 = pR.1
      left
      simp [nextFin, pR]
    have h_prev_ne_left :
        I.rowIndex prevRow ≠ I.rowIndex Cross.rowLeft :=
      Inv.base.rowIndex_ne_of_order_val_ne (by
        change (order prevRow).1 ≠ (order Cross.rowLeft).1
        rw [hprev_order]
        change prevFin.1 ≠ pL.1
        simp [prevFin]
        omega)
    have h_prev_ne_right :
        I.rowIndex prevRow ≠ I.rowIndex Cross.rowRight :=
      Inv.base.rowIndex_ne_of_order_val_ne (by
        change (order prevRow).1 ≠ (order Cross.rowRight).1
        rw [hprev_order]
        change prevFin.1 ≠ pR.1
        simp [prevFin]
        omega)
    have h_prev_ne_next :
        I.rowIndex prevRow ≠ I.rowIndex nextRow :=
      Inv.base.rowIndex_ne_of_order_val_ne (by
        change (order prevRow).1 ≠ (order nextRow).1
        rw [hprev_order, hnext_order]
        simp [prevFin, nextFin]
        omega)
    have h_left_ne_next :
        I.rowIndex Cross.rowLeft ≠ I.rowIndex nextRow :=
      Inv.base.rowIndex_ne_of_order_val_ne (by
        change (order Cross.rowLeft).1 ≠ (order nextRow).1
        rw [hnext_order]
        change pL.1 ≠ nextFin.1
        simp [nextFin]
        omega)
    have h_next_ne_right :
        I.rowIndex nextRow ≠ I.rowIndex Cross.rowRight :=
      Inv.base.rowIndex_ne_of_order_val_ne (by
        change (order nextRow).1 ≠ (order Cross.rowRight).1
        rw [hnext_order]
        change nextFin.1 ≠ pR.1
        simp [nextFin])
    by_cases hnext_last : pR.1 + 2 = z h
    · have hnext_row_last :
          nextRow =
            order.symm
              (⟨z h - 1, by
                dsimp [z]
                omega⟩ : Fin (z h)) := by
        apply order.injective
        apply Fin.ext
        simp [hnext_order, nextFin]
        omega
      refine
        { auxL := Inv.extended.boundary.lowerBoundary
          auxA := I.rowIndex prevRow
          auxD := I.rowIndex nextRow
          auxR := Inv.extended.boundary.upperBoundary
          hLA_old := ?_
          hAU_old := ?_
          hUV_old := Cross.old_aux_adj_left_right
          hVD_old := ?_
          hDR_old := ?_
          hA_old := Inv.extended.full.active_aux.degree_two prevRow
          hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
          hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
          hD_old := Inv.extended.full.active_aux.degree_two nextRow
          hL_not := ?_
          hR_not := ?_
          hLU := Inv.extended.boundary.lower_ne_row Cross.rowLeft
          hRV := Inv.extended.boundary.upper_ne_row Cross.rowRight
          hAU_ne := h_prev_ne_left
          hAD := h_prev_ne_next
          hUD := h_left_ne_next
          hAV := h_prev_ne_right
          hDV := h_next_ne_right
          hLD := Inv.extended.boundary.lower_ne_row nextRow }
      · exact H.symm (by
          simpa [hprev_row_first] using
            Inv.extended.boundary.lower_adj_first)
      · exact Inv.extended.full.active_aux.consecutive_adj hcon_prev
      · exact Inv.extended.full.active_aux.consecutive_adj hcon_next
      · simpa [hnext_row_last] using Inv.extended.boundary.last_adj_upper
      · simp [Inv.extended.boundary.lower_ne_row prevRow,
          Inv.extended.boundary.lower_ne_row Cross.rowLeft,
          Inv.extended.boundary.lower_ne_row Cross.rowRight,
          Inv.extended.boundary.lower_ne_row nextRow]
      · simp [Inv.extended.boundary.upper_ne_row prevRow,
          Inv.extended.boundary.upper_ne_row Cross.rowLeft,
          Inv.extended.boundary.upper_ne_row Cross.rowRight,
          Inv.extended.boundary.upper_ne_row nextRow]
    · let nextNextFin : Fin (z h) := ⟨pR.1 + 2, by
        have hpRlt : pR.1 < z h := pR.2
        omega⟩
      let nextNextRow : I.Row := order.symm nextNextFin
      have hnextNext_order : order nextNextRow = nextNextFin := by
        simp [nextNextRow]
      have hcon_nextNext :
          FinConsecutive (order nextRow) (order nextNextRow) := by
        rw [hnext_order, hnextNext_order]
        change nextFin.1 + 1 = nextNextFin.1 ∨
          nextNextFin.1 + 1 = nextFin.1
        left
        simp [nextFin, nextNextFin]
      have h_nextNext_ne_prev :
          I.rowIndex nextNextRow ≠ I.rowIndex prevRow :=
        Inv.base.rowIndex_ne_of_order_val_ne (by
          change (order nextNextRow).1 ≠ (order prevRow).1
          rw [hnextNext_order, hprev_order]
          simp [nextNextFin, prevFin]
          omega)
      have h_nextNext_ne_left :
          I.rowIndex nextNextRow ≠ I.rowIndex Cross.rowLeft :=
        Inv.base.rowIndex_ne_of_order_val_ne (by
          change (order nextNextRow).1 ≠ (order Cross.rowLeft).1
          rw [hnextNext_order]
          change nextNextFin.1 ≠ pL.1
          simp [nextNextFin]
          omega)
      have h_nextNext_ne_right :
          I.rowIndex nextNextRow ≠ I.rowIndex Cross.rowRight :=
        Inv.base.rowIndex_ne_of_order_val_ne (by
          change (order nextNextRow).1 ≠ (order Cross.rowRight).1
          rw [hnextNext_order]
          change nextNextFin.1 ≠ pR.1
          simp [nextNextFin])
      have h_nextNext_ne_next :
          I.rowIndex nextNextRow ≠ I.rowIndex nextRow :=
        Inv.base.rowIndex_ne_of_order_val_ne (by
          change (order nextNextRow).1 ≠ (order nextRow).1
          rw [hnextNext_order, hnext_order]
          simp [nextNextFin, nextFin])
      refine
        { auxL := Inv.extended.boundary.lowerBoundary
          auxA := I.rowIndex prevRow
          auxD := I.rowIndex nextRow
          auxR := I.rowIndex nextNextRow
          hLA_old := ?_
          hAU_old := ?_
          hUV_old := Cross.old_aux_adj_left_right
          hVD_old := ?_
          hDR_old := ?_
          hA_old := Inv.extended.full.active_aux.degree_two prevRow
          hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
          hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
          hD_old := Inv.extended.full.active_aux.degree_two nextRow
          hL_not := ?_
          hR_not := ?_
          hLU := Inv.extended.boundary.lower_ne_row Cross.rowLeft
          hRV := h_nextNext_ne_right
          hAU_ne := h_prev_ne_left
          hAD := h_prev_ne_next
          hUD := h_left_ne_next
          hAV := h_prev_ne_right
          hDV := h_next_ne_right
          hLD := Inv.extended.boundary.lower_ne_row nextRow }
      · exact H.symm (by
          simpa [hprev_row_first] using
            Inv.extended.boundary.lower_adj_first)
      · exact Inv.extended.full.active_aux.consecutive_adj hcon_prev
      · exact Inv.extended.full.active_aux.consecutive_adj hcon_next
      · exact Inv.extended.full.active_aux.consecutive_adj hcon_nextNext
      · simp [Inv.extended.boundary.lower_ne_row prevRow,
          Inv.extended.boundary.lower_ne_row Cross.rowLeft,
          Inv.extended.boundary.lower_ne_row Cross.rowRight,
          Inv.extended.boundary.lower_ne_row nextRow]
      · simp [h_nextNext_ne_prev, h_nextNext_ne_left, h_nextNext_ne_right,
          h_nextNext_ne_next]

/-- Forward Figure 8 local outside data when the row immediately after the
crossed pair is the last active row.  The right local endpoint is active, and
its outside neighbor is the fixed upper boundary row. -/
noncomputable def ofForwardNextToRightBoundaryInvariant
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Cross : CrossWitness I)
    (hforward :
      (Inv.base.orderedRows.order Cross.rowLeft).1 + 1 =
        (Inv.base.orderedRows.order Cross.rowRight).1)
    (hnext_last :
      (Inv.base.orderedRows.order Cross.rowRight).1 + 2 = z h) :
    CrossLocalOutsideData Inv Cross := by
  classical
  let order := Inv.base.orderedRows.order
  let pL : Fin (z h) := order Cross.rowLeft
  let pR : Fin (z h) := order Cross.rowRight
  have hforward_val : pL.1 + 1 = pR.1 := by
    simpa [pL, pR] using hforward
  have hnext_last_val : pR.1 + 2 = z h := by
    simpa [pR] using hnext_last
  by_cases hleft_first : pL.1 = 0
  · exact
      CrossLocalOutsideData.ofForwardLeftBoundaryInvariant
        (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
        Inv Cross hforward (by simpa [pL] using hleft_first)
  · by_cases hright_last : pR.1 + 1 = z h
    · exact
        CrossLocalOutsideData.ofForwardRightBoundaryInvariant
          (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
          Inv Cross hforward (by simpa [pR] using hright_last)
    · by_cases hleft_second : pL.1 = 1
      · exact
          CrossLocalOutsideData.ofForwardSecondRowInvariant
            (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
            Inv Cross hforward (by simpa [pL] using hleft_second)
      · let H := linkageAuxGraph I.linkage
        let prevFin : Fin (z h) := ⟨pL.1 - 1, by omega⟩
        let prevRow : I.Row := order.symm prevFin
        have hprev_order : order prevRow = prevFin := by
          simp [prevRow]
        let prevPrevFin : Fin (z h) := ⟨pL.1 - 2, by omega⟩
        let prevPrevRow : I.Row := order.symm prevPrevFin
        have hprevPrev_order : order prevPrevRow = prevPrevFin := by
          simp [prevPrevRow]
        let nextFin : Fin (z h) := ⟨pR.1 + 1, by
          have hpRlt : pR.1 < z h := pR.2
          omega⟩
        let nextRow : I.Row := order.symm nextFin
        have hnext_order : order nextRow = nextFin := by
          simp [nextRow]
        have hnext_row_last :
            nextRow =
              order.symm
                (⟨z h - 1, by
                  dsimp [z]
                  omega⟩ : Fin (z h)) := by
          apply order.injective
          apply Fin.ext
          simp [hnext_order, nextFin]
          omega
        have hcon_prevPrev :
            FinConsecutive (order prevPrevRow) (order prevRow) := by
          rw [hprevPrev_order, hprev_order]
          change prevPrevFin.1 + 1 = prevFin.1 ∨
            prevFin.1 + 1 = prevPrevFin.1
          left
          simp [prevPrevFin, prevFin]
          omega
        have hcon_prev :
            FinConsecutive (order prevRow) (order Cross.rowLeft) := by
          rw [hprev_order]
          change prevFin.1 + 1 = pL.1 ∨ pL.1 + 1 = prevFin.1
          left
          simp [prevFin, pL]
          omega
        have hcon_next :
            FinConsecutive (order Cross.rowRight) (order nextRow) := by
          rw [hnext_order]
          change pR.1 + 1 = nextFin.1 ∨ nextFin.1 + 1 = pR.1
          left
          simp [nextFin, pR]
        have h_prevPrev_ne_prev :
            I.rowIndex prevPrevRow ≠ I.rowIndex prevRow :=
          Inv.base.rowIndex_ne_of_order_val_ne (by
            change (order prevPrevRow).1 ≠ (order prevRow).1
            rw [hprevPrev_order, hprev_order]
            simp [prevPrevFin, prevFin]
            omega)
        have h_prevPrev_ne_left :
            I.rowIndex prevPrevRow ≠ I.rowIndex Cross.rowLeft :=
          Inv.base.rowIndex_ne_of_order_val_ne (by
            change (order prevPrevRow).1 ≠ (order Cross.rowLeft).1
            rw [hprevPrev_order]
            change prevPrevFin.1 ≠ pL.1
            simp [prevPrevFin]
            omega)
        have h_prevPrev_ne_right :
            I.rowIndex prevPrevRow ≠ I.rowIndex Cross.rowRight :=
          Inv.base.rowIndex_ne_of_order_val_ne (by
            change (order prevPrevRow).1 ≠ (order Cross.rowRight).1
            rw [hprevPrev_order]
            change prevPrevFin.1 ≠ pR.1
            simp [prevPrevFin]
            omega)
        have h_prevPrev_ne_next :
            I.rowIndex prevPrevRow ≠ I.rowIndex nextRow :=
          Inv.base.rowIndex_ne_of_order_val_ne (by
            change (order prevPrevRow).1 ≠ (order nextRow).1
            rw [hprevPrev_order, hnext_order]
            simp [prevPrevFin, nextFin]
            omega)
        have h_prev_ne_left :
            I.rowIndex prevRow ≠ I.rowIndex Cross.rowLeft :=
          Inv.base.rowIndex_ne_of_order_val_ne (by
            change (order prevRow).1 ≠ (order Cross.rowLeft).1
            rw [hprev_order]
            change prevFin.1 ≠ pL.1
            simp [prevFin]
            omega)
        have h_prev_ne_right :
            I.rowIndex prevRow ≠ I.rowIndex Cross.rowRight :=
          Inv.base.rowIndex_ne_of_order_val_ne (by
            change (order prevRow).1 ≠ (order Cross.rowRight).1
            rw [hprev_order]
            change prevFin.1 ≠ pR.1
            simp [prevFin]
            omega)
        have h_prev_ne_next :
            I.rowIndex prevRow ≠ I.rowIndex nextRow :=
          Inv.base.rowIndex_ne_of_order_val_ne (by
            change (order prevRow).1 ≠ (order nextRow).1
            rw [hprev_order, hnext_order]
            simp [prevFin, nextFin]
            omega)
        have h_left_ne_next :
            I.rowIndex Cross.rowLeft ≠ I.rowIndex nextRow :=
          Inv.base.rowIndex_ne_of_order_val_ne (by
            change (order Cross.rowLeft).1 ≠ (order nextRow).1
            rw [hnext_order]
            change pL.1 ≠ nextFin.1
            simp [nextFin]
            omega)
        have h_next_ne_right :
            I.rowIndex nextRow ≠ I.rowIndex Cross.rowRight :=
          Inv.base.rowIndex_ne_of_order_val_ne (by
            change (order nextRow).1 ≠ (order Cross.rowRight).1
            rw [hnext_order]
            change nextFin.1 ≠ pR.1
            simp [nextFin])
        refine
          { auxL := I.rowIndex prevPrevRow
            auxA := I.rowIndex prevRow
            auxD := I.rowIndex nextRow
            auxR := Inv.extended.boundary.upperBoundary
            hLA_old := ?_
            hAU_old := ?_
            hUV_old := Cross.old_aux_adj_left_right
            hVD_old := ?_
            hDR_old := ?_
            hA_old := Inv.extended.full.active_aux.degree_two prevRow
            hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
            hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
            hD_old := Inv.extended.full.active_aux.degree_two nextRow
            hL_not := ?_
            hR_not := ?_
            hLU := h_prevPrev_ne_left
            hRV := Inv.extended.boundary.upper_ne_row Cross.rowRight
            hAU_ne := h_prev_ne_left
            hAD := h_prev_ne_next
            hUD := h_left_ne_next
            hAV := h_prev_ne_right
            hDV := h_next_ne_right
            hLD := h_prevPrev_ne_next }
        · exact H.symm (Inv.extended.full.active_aux.consecutive_adj
            hcon_prevPrev)
        · exact Inv.extended.full.active_aux.consecutive_adj hcon_prev
        · exact Inv.extended.full.active_aux.consecutive_adj hcon_next
        · simpa [hnext_row_last] using Inv.extended.boundary.last_adj_upper
        · simp [h_prevPrev_ne_prev, h_prevPrev_ne_left, h_prevPrev_ne_right,
            h_prevPrev_ne_next]
        · simp [Inv.extended.boundary.upper_ne_row prevRow,
            Inv.extended.boundary.upper_ne_row Cross.rowLeft,
            Inv.extended.boundary.upper_ne_row Cross.rowRight,
            Inv.extended.boundary.upper_ne_row nextRow]

/-- Forward Figure 8 local outside data, extracted entirely from the
maintained extended row-path invariant. -/
noncomputable def ofForwardInvariant
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Cross : CrossWitness I)
    (hforward :
      (Inv.base.orderedRows.order Cross.rowLeft).1 + 1 =
        (Inv.base.orderedRows.order Cross.rowRight).1) :
    CrossLocalOutsideData Inv Cross := by
  classical
  let order := Inv.base.orderedRows.order
  let pL : Fin (z h) := order Cross.rowLeft
  let pR : Fin (z h) := order Cross.rowRight
  by_cases hleft_first : pL.1 = 0
  · exact
      CrossLocalOutsideData.ofForwardLeftBoundaryInvariant
        (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
        Inv Cross hforward (by simpa [pL] using hleft_first)
  · by_cases hright_last : pR.1 + 1 = z h
    · exact
        CrossLocalOutsideData.ofForwardRightBoundaryInvariant
          (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
          Inv Cross hforward (by simpa [pR] using hright_last)
    · by_cases hleft_second : pL.1 = 1
      · exact
          CrossLocalOutsideData.ofForwardSecondRowInvariant
            (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
            Inv Cross hforward (by simpa [pL] using hleft_second)
      · by_cases hnext_last : pR.1 + 2 = z h
        · exact
            CrossLocalOutsideData.ofForwardNextToRightBoundaryInvariant
              (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
              Inv Cross hforward (by simpa [pR] using hnext_last)
        · exact
            CrossLocalOutsideData.ofForwardInteriorInvariant
              (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
              Inv Cross hforward
              (by simpa [pL] using hleft_first)
              (by simpa [pL] using hleft_second)
              (by simpa [pR] using hright_last)
              (by simpa [pR] using hnext_last)

/-- Backward Figure 8 local outside data when `rowLeft` is the last active
row. -/
noncomputable def ofBackwardUpperBoundaryInvariant
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Cross : CrossWitness I)
    (hbackward :
      (Inv.base.orderedRows.order Cross.rowRight).1 + 1 =
        (Inv.base.orderedRows.order Cross.rowLeft).1)
    (hleft_last :
      (Inv.base.orderedRows.order Cross.rowLeft).1 + 1 = z h) :
    CrossLocalOutsideData Inv Cross := by
  classical
  let order := Inv.base.orderedRows.order
  let pL : Fin (z h) := order Cross.rowLeft
  let pR : Fin (z h) := order Cross.rowRight
  have hbackward_val : pR.1 + 1 = pL.1 := by
    simpa [pL, pR] using hbackward
  have hleft_last_val : pL.1 + 1 = z h := by
    simpa [pL] using hleft_last
  let H := linkageAuxGraph I.linkage
  have hrow_left_last :
      Cross.rowLeft =
        order.symm
          (⟨z h - 1, by
            dsimp [z]
            omega⟩ : Fin (z h)) := by
    apply order.injective
    apply Fin.ext
    simp
    omega
  by_cases hright_first : pR.1 = 0
  · have hrow_right_first :
        Cross.rowRight =
          order.symm (⟨0, by
            dsimp [z]
            omega⟩ : Fin (z h)) := by
      apply order.injective
      apply Fin.ext
      simp [pR, hright_first]
    refine
      { auxL := Inv.extended.boundary.upperOutside
        auxA := Inv.extended.boundary.upperBoundary
        auxD := Inv.extended.boundary.lowerBoundary
        auxR := Inv.extended.boundary.lowerOutside
        hLA_old := Inv.extended.boundary.upper_adj_outside
        hAU_old := ?_
        hUV_old := Cross.old_aux_adj_left_right
        hVD_old := ?_
        hDR_old := Inv.extended.boundary.lower_adj_outside
        hA_old := Inv.extended.boundary.upper_degree_two
        hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
        hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
        hD_old := Inv.extended.boundary.lower_degree_two
        hL_not := ?_
        hR_not := ?_
        hLU := Inv.extended.boundary.upperOutside_ne_row Cross.rowLeft
        hRV := Inv.extended.boundary.lowerOutside_ne_row Cross.rowRight
        hAU_ne := Inv.extended.boundary.upper_ne_row Cross.rowLeft
        hAD := Inv.extended.boundary.lower_ne_upper.symm
        hUD := (Inv.extended.boundary.lower_ne_row Cross.rowLeft).symm
        hAV := Inv.extended.boundary.upper_ne_row Cross.rowRight
        hDV := Inv.extended.boundary.lower_ne_row Cross.rowRight
        hLD := Inv.extended.boundary.upperOutside_ne_lower }
    · exact H.symm (by
        simpa [hrow_left_last] using Inv.extended.boundary.last_adj_upper)
    · exact H.symm (by
        simpa [hrow_right_first] using Inv.extended.boundary.lower_adj_first)
    · simp [Inv.extended.boundary.upperOutside_ne_upper,
        Inv.extended.boundary.upperOutside_ne_row Cross.rowLeft,
        Inv.extended.boundary.upperOutside_ne_row Cross.rowRight,
        Inv.extended.boundary.upperOutside_ne_lower]
    · simp [Inv.extended.boundary.lowerOutside_ne_upper,
        Inv.extended.boundary.lowerOutside_ne_row Cross.rowLeft,
        Inv.extended.boundary.lowerOutside_ne_row Cross.rowRight,
        Inv.extended.boundary.lowerOutside_ne_lower]
  · let prevFin : Fin (z h) := ⟨pR.1 - 1, by omega⟩
    let prevRow : I.Row := order.symm prevFin
    have hprev_order : order prevRow = prevFin := by
      simp [prevRow]
    have hcon_prev :
        FinConsecutive (order prevRow) (order Cross.rowRight) := by
      rw [hprev_order]
      change prevFin.1 + 1 = pR.1 ∨ pR.1 + 1 = prevFin.1
      left
      simp [prevFin, pR]
      omega
    have h_prev_ne_left :
        I.rowIndex prevRow ≠ I.rowIndex Cross.rowLeft :=
      Inv.base.rowIndex_ne_of_order_val_ne (by
        change (order prevRow).1 ≠ (order Cross.rowLeft).1
        rw [hprev_order]
        change prevFin.1 ≠ pL.1
        simp [prevFin]
        omega)
    have h_prev_ne_right :
        I.rowIndex prevRow ≠ I.rowIndex Cross.rowRight :=
      Inv.base.rowIndex_ne_of_order_val_ne (by
        change (order prevRow).1 ≠ (order Cross.rowRight).1
        rw [hprev_order]
        change prevFin.1 ≠ pR.1
        simp [prevFin]
        omega)
    by_cases hprev_first : pR.1 = 1
    · have hprev_row_first :
          prevRow =
            order.symm (⟨0, by
              dsimp [z]
              omega⟩ : Fin (z h)) := by
        apply order.injective
        apply Fin.ext
        simp [hprev_order, prevFin]
        omega
      refine
        { auxL := Inv.extended.boundary.upperOutside
          auxA := Inv.extended.boundary.upperBoundary
          auxD := I.rowIndex prevRow
          auxR := Inv.extended.boundary.lowerBoundary
          hLA_old := Inv.extended.boundary.upper_adj_outside
          hAU_old := ?_
          hUV_old := Cross.old_aux_adj_left_right
          hVD_old := ?_
          hDR_old := ?_
          hA_old := Inv.extended.boundary.upper_degree_two
          hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
          hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
          hD_old := Inv.extended.full.active_aux.degree_two prevRow
          hL_not := ?_
          hR_not := ?_
          hLU := Inv.extended.boundary.upperOutside_ne_row Cross.rowLeft
          hRV := Inv.extended.boundary.lower_ne_row Cross.rowRight
          hAU_ne := Inv.extended.boundary.upper_ne_row Cross.rowLeft
          hAD := Inv.extended.boundary.upper_ne_row prevRow
          hUD := h_prev_ne_left.symm
          hAV := Inv.extended.boundary.upper_ne_row Cross.rowRight
          hDV := h_prev_ne_right
          hLD := Inv.extended.boundary.upperOutside_ne_row prevRow }
      · exact H.symm (by
          simpa [hrow_left_last] using Inv.extended.boundary.last_adj_upper)
      · exact H.symm (Inv.extended.full.active_aux.consecutive_adj hcon_prev)
      · exact H.symm (by
          simpa [hprev_row_first] using
            Inv.extended.boundary.lower_adj_first)
      · simp [Inv.extended.boundary.upperOutside_ne_upper,
          Inv.extended.boundary.upperOutside_ne_row Cross.rowLeft,
          Inv.extended.boundary.upperOutside_ne_row Cross.rowRight,
          Inv.extended.boundary.upperOutside_ne_row prevRow]
      · simp [Inv.extended.boundary.lower_ne_upper,
          Inv.extended.boundary.lower_ne_row Cross.rowLeft,
          Inv.extended.boundary.lower_ne_row Cross.rowRight,
          Inv.extended.boundary.lower_ne_row prevRow]
    · let prevPrevFin : Fin (z h) := ⟨pR.1 - 2, by omega⟩
      let prevPrevRow : I.Row := order.symm prevPrevFin
      have hprevPrev_order : order prevPrevRow = prevPrevFin := by
        simp [prevPrevRow]
      have hcon_prevPrev :
          FinConsecutive (order prevPrevRow) (order prevRow) := by
        rw [hprevPrev_order, hprev_order]
        change prevPrevFin.1 + 1 = prevFin.1 ∨
          prevFin.1 + 1 = prevPrevFin.1
        left
        simp [prevPrevFin, prevFin]
        omega
      have h_prevPrev_ne_upper :
          I.rowIndex prevPrevRow ≠ Inv.extended.boundary.upperBoundary :=
        (Inv.extended.boundary.upper_ne_row prevPrevRow).symm
      have h_prevPrev_ne_left :
          I.rowIndex prevPrevRow ≠ I.rowIndex Cross.rowLeft :=
        Inv.base.rowIndex_ne_of_order_val_ne (by
          change (order prevPrevRow).1 ≠ (order Cross.rowLeft).1
          rw [hprevPrev_order]
          change prevPrevFin.1 ≠ pL.1
          simp [prevPrevFin]
          omega)
      have h_prevPrev_ne_right :
          I.rowIndex prevPrevRow ≠ I.rowIndex Cross.rowRight :=
        Inv.base.rowIndex_ne_of_order_val_ne (by
          change (order prevPrevRow).1 ≠ (order Cross.rowRight).1
          rw [hprevPrev_order]
          change prevPrevFin.1 ≠ pR.1
          simp [prevPrevFin]
          omega)
      have h_prevPrev_ne_prev :
          I.rowIndex prevPrevRow ≠ I.rowIndex prevRow :=
        Inv.base.rowIndex_ne_of_order_val_ne (by
          change (order prevPrevRow).1 ≠ (order prevRow).1
          rw [hprevPrev_order, hprev_order]
          simp [prevPrevFin, prevFin]
          omega)
      refine
        { auxL := Inv.extended.boundary.upperOutside
          auxA := Inv.extended.boundary.upperBoundary
          auxD := I.rowIndex prevRow
          auxR := I.rowIndex prevPrevRow
          hLA_old := Inv.extended.boundary.upper_adj_outside
          hAU_old := ?_
          hUV_old := Cross.old_aux_adj_left_right
          hVD_old := ?_
          hDR_old := ?_
          hA_old := Inv.extended.boundary.upper_degree_two
          hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
          hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
          hD_old := Inv.extended.full.active_aux.degree_two prevRow
          hL_not := ?_
          hR_not := ?_
          hLU := Inv.extended.boundary.upperOutside_ne_row Cross.rowLeft
          hRV := h_prevPrev_ne_right
          hAU_ne := Inv.extended.boundary.upper_ne_row Cross.rowLeft
          hAD := Inv.extended.boundary.upper_ne_row prevRow
          hUD := h_prev_ne_left.symm
          hAV := Inv.extended.boundary.upper_ne_row Cross.rowRight
          hDV := h_prev_ne_right
          hLD := Inv.extended.boundary.upperOutside_ne_row prevRow }
      · exact H.symm (by
          simpa [hrow_left_last] using Inv.extended.boundary.last_adj_upper)
      · exact H.symm (Inv.extended.full.active_aux.consecutive_adj hcon_prev)
      · exact H.symm (Inv.extended.full.active_aux.consecutive_adj
          hcon_prevPrev)
      · simp [Inv.extended.boundary.upperOutside_ne_upper,
          Inv.extended.boundary.upperOutside_ne_row Cross.rowLeft,
          Inv.extended.boundary.upperOutside_ne_row Cross.rowRight,
          Inv.extended.boundary.upperOutside_ne_row prevRow]
      · simp [h_prevPrev_ne_upper, h_prevPrev_ne_left,
          h_prevPrev_ne_right, h_prevPrev_ne_prev]

/-- Backward Figure 8 local outside data when `rowRight` is the first active
row. -/
noncomputable def ofBackwardLowerBoundaryInvariant
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Cross : CrossWitness I)
    (hbackward :
      (Inv.base.orderedRows.order Cross.rowRight).1 + 1 =
        (Inv.base.orderedRows.order Cross.rowLeft).1)
    (hright_first :
      (Inv.base.orderedRows.order Cross.rowRight).1 = 0) :
    CrossLocalOutsideData Inv Cross := by
  classical
  let order := Inv.base.orderedRows.order
  let pL : Fin (z h) := order Cross.rowLeft
  let pR : Fin (z h) := order Cross.rowRight
  have hbackward_val : pR.1 + 1 = pL.1 := by
    simpa [pL, pR] using hbackward
  have hright_first_val : pR.1 = 0 := by
    simpa [pR] using hright_first
  by_cases hleft_last : pL.1 + 1 = z h
  · exact
      CrossLocalOutsideData.ofBackwardUpperBoundaryInvariant
        (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
        Inv Cross hbackward (by simpa [pL] using hleft_last)
  · let H := linkageAuxGraph I.linkage
    have hrow_right_first :
        Cross.rowRight =
          order.symm (⟨0, by
            dsimp [z]
            omega⟩ : Fin (z h)) := by
      apply order.injective
      apply Fin.ext
      simp [pR, hright_first_val]
    let nextFin : Fin (z h) := ⟨pL.1 + 1, by
      have hpLlt : pL.1 < z h := pL.2
      omega⟩
    let nextRow : I.Row := order.symm nextFin
    have hnext_order : order nextRow = nextFin := by
      simp [nextRow]
    have hcon_next :
        FinConsecutive (order Cross.rowLeft) (order nextRow) := by
      rw [hnext_order]
      change pL.1 + 1 = nextFin.1 ∨ nextFin.1 + 1 = pL.1
      left
      simp [nextFin, pL]
    have h_next_ne_left :
        I.rowIndex nextRow ≠ I.rowIndex Cross.rowLeft :=
      Inv.base.rowIndex_ne_of_order_val_ne (by
        change (order nextRow).1 ≠ (order Cross.rowLeft).1
        rw [hnext_order]
        change nextFin.1 ≠ pL.1
        simp [nextFin])
    have h_next_ne_right :
        I.rowIndex nextRow ≠ I.rowIndex Cross.rowRight :=
      Inv.base.rowIndex_ne_of_order_val_ne (by
        change (order nextRow).1 ≠ (order Cross.rowRight).1
        rw [hnext_order]
        change nextFin.1 ≠ pR.1
        simp [nextFin]
        omega)
    have h_next_ne_lower :
        I.rowIndex nextRow ≠ Inv.extended.boundary.lowerBoundary :=
      (Inv.extended.boundary.lower_ne_row nextRow).symm
    by_cases hnext_last : pL.1 + 2 = z h
    · have hnext_row_last :
          nextRow =
            order.symm
              (⟨z h - 1, by
                dsimp [z]
                omega⟩ : Fin (z h)) := by
        apply order.injective
        apply Fin.ext
        simp [hnext_order, nextFin]
        omega
      refine
        { auxL := Inv.extended.boundary.upperBoundary
          auxA := I.rowIndex nextRow
          auxD := Inv.extended.boundary.lowerBoundary
          auxR := Inv.extended.boundary.lowerOutside
          hLA_old := ?_
          hAU_old := ?_
          hUV_old := Cross.old_aux_adj_left_right
          hVD_old := ?_
          hDR_old := Inv.extended.boundary.lower_adj_outside
          hA_old := Inv.extended.full.active_aux.degree_two nextRow
          hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
          hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
          hD_old := Inv.extended.boundary.lower_degree_two
          hL_not := ?_
          hR_not := ?_
          hLU := Inv.extended.boundary.upper_ne_row Cross.rowLeft
          hRV := Inv.extended.boundary.lowerOutside_ne_row Cross.rowRight
          hAU_ne := h_next_ne_left
          hAD := h_next_ne_lower
          hUD := (Inv.extended.boundary.lower_ne_row Cross.rowLeft).symm
          hAV := h_next_ne_right
          hDV := Inv.extended.boundary.lower_ne_row Cross.rowRight
          hLD := Inv.extended.boundary.lower_ne_upper.symm }
      · simpa [hnext_row_last] using Inv.extended.boundary.last_adj_upper
      · exact H.symm (Inv.extended.full.active_aux.consecutive_adj hcon_next)
      · exact H.symm (by
          simpa [hrow_right_first] using
            Inv.extended.boundary.lower_adj_first)
      · simp [Inv.extended.boundary.upper_ne_row nextRow,
          Inv.extended.boundary.upper_ne_row Cross.rowLeft,
          Inv.extended.boundary.upper_ne_row Cross.rowRight,
          Inv.extended.boundary.lower_ne_upper.symm]
      · simp [Inv.extended.boundary.lowerOutside_ne_row nextRow,
          Inv.extended.boundary.lowerOutside_ne_row Cross.rowLeft,
          Inv.extended.boundary.lowerOutside_ne_row Cross.rowRight,
          Inv.extended.boundary.lowerOutside_ne_lower]
    · let nextNextFin : Fin (z h) := ⟨pL.1 + 2, by
        have hpLlt : pL.1 < z h := pL.2
        omega⟩
      let nextNextRow : I.Row := order.symm nextNextFin
      have hnextNext_order : order nextNextRow = nextNextFin := by
        simp [nextNextRow]
      have hcon_nextNext :
          FinConsecutive (order nextRow) (order nextNextRow) := by
        rw [hnext_order, hnextNext_order]
        change nextFin.1 + 1 = nextNextFin.1 ∨
          nextNextFin.1 + 1 = nextFin.1
        left
        simp [nextFin, nextNextFin]
      have h_nextNext_ne_next :
          I.rowIndex nextNextRow ≠ I.rowIndex nextRow :=
        Inv.base.rowIndex_ne_of_order_val_ne (by
          change (order nextNextRow).1 ≠ (order nextRow).1
          rw [hnextNext_order, hnext_order]
          simp [nextNextFin, nextFin])
      have h_nextNext_ne_left :
          I.rowIndex nextNextRow ≠ I.rowIndex Cross.rowLeft :=
        Inv.base.rowIndex_ne_of_order_val_ne (by
          change (order nextNextRow).1 ≠ (order Cross.rowLeft).1
          rw [hnextNext_order]
          change nextNextFin.1 ≠ pL.1
          simp [nextNextFin])
      have h_nextNext_ne_right :
          I.rowIndex nextNextRow ≠ I.rowIndex Cross.rowRight :=
        Inv.base.rowIndex_ne_of_order_val_ne (by
          change (order nextNextRow).1 ≠ (order Cross.rowRight).1
          rw [hnextNext_order]
          change nextNextFin.1 ≠ pR.1
          simp [nextNextFin]
          omega)
      have h_nextNext_ne_lower :
          I.rowIndex nextNextRow ≠ Inv.extended.boundary.lowerBoundary :=
        (Inv.extended.boundary.lower_ne_row nextNextRow).symm
      refine
        { auxL := I.rowIndex nextNextRow
          auxA := I.rowIndex nextRow
          auxD := Inv.extended.boundary.lowerBoundary
          auxR := Inv.extended.boundary.lowerOutside
          hLA_old := ?_
          hAU_old := ?_
          hUV_old := Cross.old_aux_adj_left_right
          hVD_old := ?_
          hDR_old := Inv.extended.boundary.lower_adj_outside
          hA_old := Inv.extended.full.active_aux.degree_two nextRow
          hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
          hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
          hD_old := Inv.extended.boundary.lower_degree_two
          hL_not := ?_
          hR_not := ?_
          hLU := h_nextNext_ne_left
          hRV := Inv.extended.boundary.lowerOutside_ne_row Cross.rowRight
          hAU_ne := h_next_ne_left
          hAD := h_next_ne_lower
          hUD := (Inv.extended.boundary.lower_ne_row Cross.rowLeft).symm
          hAV := h_next_ne_right
          hDV := Inv.extended.boundary.lower_ne_row Cross.rowRight
          hLD := h_nextNext_ne_lower }
      · exact Inv.extended.full.active_aux.consecutive_adj hcon_nextNext
      · exact H.symm (Inv.extended.full.active_aux.consecutive_adj hcon_next)
      · exact H.symm (by
          simpa [hrow_right_first] using
            Inv.extended.boundary.lower_adj_first)
      · simp [h_nextNext_ne_next, h_nextNext_ne_left, h_nextNext_ne_right,
          h_nextNext_ne_lower]
      · simp [Inv.extended.boundary.lowerOutside_ne_row nextRow,
          Inv.extended.boundary.lowerOutside_ne_row Cross.rowLeft,
          Inv.extended.boundary.lowerOutside_ne_row Cross.rowRight,
          Inv.extended.boundary.lowerOutside_ne_lower]

/-- Backward Figure 8 local outside data when the row immediately after
`rowLeft` is the last active row. -/
noncomputable def ofBackwardNextToUpperBoundaryInvariant
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Cross : CrossWitness I)
    (hbackward :
      (Inv.base.orderedRows.order Cross.rowRight).1 + 1 =
        (Inv.base.orderedRows.order Cross.rowLeft).1)
    (hnext_last :
      (Inv.base.orderedRows.order Cross.rowLeft).1 + 2 = z h) :
    CrossLocalOutsideData Inv Cross := by
  classical
  let order := Inv.base.orderedRows.order
  let pL : Fin (z h) := order Cross.rowLeft
  let pR : Fin (z h) := order Cross.rowRight
  have hbackward_val : pR.1 + 1 = pL.1 := by
    simpa [pL, pR] using hbackward
  have hnext_last_val : pL.1 + 2 = z h := by
    simpa [pL] using hnext_last
  by_cases hleft_last : pL.1 + 1 = z h
  · exact
      CrossLocalOutsideData.ofBackwardUpperBoundaryInvariant
        (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
        Inv Cross hbackward (by simpa [pL] using hleft_last)
  · by_cases hright_first : pR.1 = 0
    · exact
        CrossLocalOutsideData.ofBackwardLowerBoundaryInvariant
          (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
          Inv Cross hbackward (by simpa [pR] using hright_first)
    · let H := linkageAuxGraph I.linkage
      let nextFin : Fin (z h) := ⟨pL.1 + 1, by
        have hpLlt : pL.1 < z h := pL.2
        omega⟩
      let nextRow : I.Row := order.symm nextFin
      have hnext_order : order nextRow = nextFin := by
