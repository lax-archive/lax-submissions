/-- Upgrade a cross action certificate to the boundary-aware full-invariant
action outcome once each successor certificate preserves the extended
invariant package. -/
theorem CrossActionCertificate.extendedFullInvariantSimplifyingActionOutcome
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
