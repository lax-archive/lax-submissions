/-! ### Symmetric type-2 finite-descent shell

The local bump/cross witness structures are still specialized to the type-1
family below.  The following declarations isolate the part of the type-2
branch that does not depend on those concrete witnesses: once a type-2
nonterminal step either drops a degree-two auxiliary vertex or strictly
decreases the maintained graph `Htilde`, the same well-founded descent proves
the terminal-or-rerouted alternative. -/

/-- Strict descent of the maintained type-2 graph `Htilde`. -/
def TypeTwoTildeEdgeDescent
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    (I' I : TypeTwoIterationInput R hpos Q0) : Prop :=
  I'.tildeEdgeSet.card < I.tildeEdgeSet.card

/-- The type-2 `Htilde`-descent relation is well-founded, measured by edge
count. -/
theorem typeTwoTildeEdgeDescent_wf
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q} :
    WellFounded
      (fun I' I : TypeTwoIterationInput R hpos Q0 =>
        TypeTwoTildeEdgeDescent I' I) :=
  InvImage.wf (fun I : TypeTwoIterationInput R hpos Q0 =>
    I.tildeEdgeSet.card) <| (Nat.lt_wfRel).2

/-- Boundary-aware full-invariant-preserving type-2 simplifying action.

The nonterminating branch carries the explicit type-2 boundary/full invariant
for the successor and strictly decreases `Htilde`. -/
def TypeTwoExtendedFullInvariantSimplifyingActionOutcome
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    (I : TypeTwoIterationInput R hpos Q0) : Prop :=
  (∃ L'' : PerfectPathPacking G A B,
    linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount I.linkage) ∨
    ∃ I' : TypeTwoIterationInput R hpos Q0,
      Nonempty (TypeTwoExtendedFullIterationInvariants I') ∧
        TypeTwoTildeEdgeDescent I' I

/-- Boundary-aware full-invariant finite descent for the symmetric type-2
branch. -/
theorem exists_typeTwo_terminal_or_degree_drop_of_extended_full_invariant_actions
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    (Terminal : TypeTwoIterationInput R hpos Q0 → Prop)
    (hstep :
      ∀ I : TypeTwoIterationInput R hpos Q0,
        TypeTwoExtendedFullIterationInvariants I →
          ¬ Terminal I →
            TypeTwoExtendedFullInvariantSimplifyingActionOutcome I)
    (I₀ : TypeTwoIterationInput R hpos Q0)
    (Inv₀ : TypeTwoExtendedFullIterationInvariants I₀) :
    ∃ I : TypeTwoIterationInput R hpos Q0,
      Nonempty (TypeTwoExtendedFullIterationInvariants I) ∧
        (Terminal I ∨
          ∃ L'' : PerfectPathPacking G A B,
            linkageAuxDegreeTwoCount L'' <
              linkageAuxDegreeTwoCount I.linkage) := by
  classical
  let motive : TypeTwoIterationInput R hpos Q0 → Prop := fun I =>
    Nonempty (TypeTwoExtendedFullIterationInvariants I) →
      ∃ J : TypeTwoIterationInput R hpos Q0,
        Nonempty (TypeTwoExtendedFullIterationInvariants J) ∧
          (Terminal J ∨
            ∃ L'' : PerfectPathPacking G A B,
              linkageAuxDegreeTwoCount L'' <
                linkageAuxDegreeTwoCount J.linkage)
  have hmain : motive I₀ := by
    refine (typeTwoTildeEdgeDescent_wf (R := R) (hpos := hpos)
      (Q0 := Q0)).induction (C := motive) I₀ ?_
    intro I ih InvNE
    rcases InvNE with ⟨Inv⟩
    by_cases hterm : Terminal I
    · exact ⟨I, ⟨Inv⟩, Or.inl hterm⟩
    · rcases hstep I Inv hterm with hdrop | hnext
      · exact ⟨I, ⟨Inv⟩, Or.inr hdrop⟩
      · rcases hnext with ⟨I', Inv', hlt⟩
        exact ih I' hlt Inv'
  exact hmain ⟨Inv₀⟩

namespace TypeTwoIterationInput

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeTwoQStarFamily R hpos Q}

/-- A degree drop found in a type-2 iteration is a degree drop relative to the
original linkage `L`, because every type-2 iteration carries an auxiliary
graph isomorphism back to `L`. -/
theorem degree_drop_lt_original
    (I : TypeTwoIterationInput R hpos Q0)
    {L'' : PerfectPathPacking G A B}
    (hdrop :
      linkageAuxDegreeTwoCount L'' <
        linkageAuxDegreeTwoCount I.linkage) :
    linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount L := by
  rw [I.aux_iso_fixed_outside.degreeTwoCount_eq]
  exact hdrop

end TypeTwoIterationInput

/-- Type-2 loop conclusion in the exact rerouting shape.  The terminal proof
may use the boundary-aware full invariant of the terminal state. -/
theorem typeTwo_gridMinor_or_degree_drop_of_extended_full_invariant_actions
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    (Terminal : TypeTwoIterationInput R hpos Q0 → Prop)
    (hstep :
      ∀ I : TypeTwoIterationInput R hpos Q0,
        TypeTwoExtendedFullIterationInvariants I →
          ¬ Terminal I →
            TypeTwoExtendedFullInvariantSimplifyingActionOutcome I)
    (hterminal :
      ∀ I : TypeTwoIterationInput R hpos Q0,
        TypeTwoExtendedFullIterationInvariants I → Terminal I →
          ContainsGridMinor G h)
    (I₀ : TypeTwoIterationInput R hpos Q0)
    (Inv₀ : TypeTwoExtendedFullIterationInvariants I₀) :
    ContainsGridMinor G h ∨
      ∃ L'' : PerfectPathPacking G A B,
        linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount L := by
  rcases
    exists_typeTwo_terminal_or_degree_drop_of_extended_full_invariant_actions
      (Terminal := Terminal) hstep I₀ Inv₀ with
    ⟨I, InvNE, hterm | hdrop⟩
  · rcases InvNE with ⟨Inv⟩
    exact Or.inl (hterminal I Inv hterm)
  · rcases hdrop with ⟨L'', hlt⟩
    exact Or.inr ⟨L'', by
      rw [I.aux_iso_fixed_outside.degreeTwoCount_eq]
      exact hlt⟩

/-- Type-2 branch proof data in the same concrete shape as the type-1
boundary-aware loop: a terminal predicate, an invariant-preserving descent
step, and a terminal grid-minor proof. -/
structure TypeTwoBranchExtendedProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (S : TypeTwoIterationSetup R hpos Q) where
  Terminal : TypeTwoIterationInput R hpos S.Q0 → Prop
  hstep :
    ∀ I : TypeTwoIterationInput R hpos S.Q0,
      TypeTwoExtendedFullIterationInvariants I →
        ¬ Terminal I →
          TypeTwoExtendedFullInvariantSimplifyingActionOutcome I
  hterminal :
    ∀ I : TypeTwoIterationInput R hpos S.Q0,
      TypeTwoExtendedFullIterationInvariants I → Terminal I →
        ContainsGridMinor G h

namespace TypeTwoBranchExtendedProofData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {S : TypeTwoIterationSetup R hpos Q}

/-- Consume the type-2 branch proof data to obtain the rerouting conclusion. -/
theorem reroutingConclusion [Fintype V]
    (D : TypeTwoBranchExtendedProofData S) :
    ReroutingConclusion G h L :=
  typeTwo_gridMinor_or_degree_drop_of_extended_full_invariant_actions
    (Terminal := D.Terminal) D.hstep D.hterminal
    S.input S.initialExtendedFullIterationInvariants

end TypeTwoBranchExtendedProofData

/-- Type-2 branch proof data whose terminal branch is stated by the explicit
ordered intersection core data, i.e. by the type-2 analogues of Claims B.2 and
B.3. -/
structure TypeTwoBranchOrderedTerminalProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (S : TypeTwoIterationSetup R hpos Q) where
  Terminal : TypeTwoIterationInput R hpos S.Q0 → Prop
  hstep :
    ∀ I : TypeTwoIterationInput R hpos S.Q0,
      TypeTwoExtendedFullIterationInvariants I →
        ¬ Terminal I →
          TypeTwoExtendedFullInvariantSimplifyingActionOutcome I
  hterminal :
    ∀ I : TypeTwoIterationInput R hpos S.Q0,
      ∀ _Inv : TypeTwoExtendedFullIterationInvariants I,
        Terminal I →
          TypeTwoTerminalOrderedIntersectionCoreData I

namespace TypeTwoBranchOrderedTerminalProofData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {S : TypeTwoIterationSetup R hpos Q}

/-- Forget the ordered terminal internals to the grid-minor terminal proof
expected by the finite-descent shell. -/
def toExtendedProofData (D : TypeTwoBranchOrderedTerminalProofData S) :
    TypeTwoBranchExtendedProofData S where
  Terminal := D.Terminal
  hstep := D.hstep
  hterminal := by
    intro I Inv hterm
    exact (D.hterminal I Inv hterm).containsGridMinor

/-- Consume the ordered type-2 terminal proof data to obtain the rerouting
conclusion. -/
theorem reroutingConclusion [Fintype V]
    (D : TypeTwoBranchOrderedTerminalProofData S) :
    ReroutingConclusion G h L :=
  D.toExtendedProofData.reroutingConclusion

end TypeTwoBranchOrderedTerminalProofData

/-- Terminal branch sets using an explicit no-cross terminal column order.

This is the corrected terminal grid interface: consecutive `Fin h` columns are
not an arbitrary selected subset order, but the order obtained from the
terminal no-cross/common-row-order argument. -/
structure TerminalOrderedIntersectionGridData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0) where
  inv : TypeOneIterationInvariants I
  columns : TerminalColumnOrder Q0
  branch_nonempty :
    ∀ i : Fin (z h), ∀ j : Fin h,
      (((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
        ((columns.qstar j).vertexSet)).Nonempty
  branch_connected :
    ∀ i : Fin (z h), ∀ j : Fin h,
      (G.induce {v : V |
        v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j).vertexSet)}).Connected
  horizontal_adj :
    ∀ i : Fin (z h), ∀ ⦃j j' : Fin h⦄, FinConsecutive j j' →
      ∃ u ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j).vertexSet),
        ∃ v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j').vertexSet),
          G.Adj u v
  vertical_adj :
    ∀ ⦃i i' : Fin (z h)⦄, FinConsecutive i i' → ∀ j : Fin h,
      ∃ u ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j).vertexSet),
        ∃ v ∈ ((I.rowPath (inv.orderedRows.order.symm i')).vertexSet) ∩
          ((columns.qstar j).vertexSet),
          G.Adj u v

namespace TerminalOrderedIntersectionGridData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}

/-- Branch set at terminal row `i` and explicitly ordered column `j`. -/
noncomputable def branch (D : TerminalOrderedIntersectionGridData I)
    (i : Fin (z h)) (j : Fin h) : Finset V :=
  (I.rowPath (D.inv.orderedRows.order.symm i)).vertexSet ∩
    (D.columns.qstar j).vertexSet

noncomputable def rowSet (D : TerminalOrderedIntersectionGridData I)
    (i : Fin (z h)) : Finset V :=
  (I.rowPath (D.inv.orderedRows.order.symm i)).vertexSet

noncomputable def colSet (D : TerminalOrderedIntersectionGridData I)
    (j : Fin h) : Finset V :=
  (D.columns.qstar j).vertexSet

theorem branch_subset_row (D : TerminalOrderedIntersectionGridData I)
    (i : Fin (z h)) (j : Fin h) :
    D.branch i j ⊆ D.rowSet i := by
  intro v hv
  exact (Finset.mem_inter.1 hv).1

theorem branch_subset_col (D : TerminalOrderedIntersectionGridData I)
    (i : Fin (z h)) (j : Fin h) :
    D.branch i j ⊆ D.colSet j := by
  intro v hv
  exact (Finset.mem_inter.1 hv).2

theorem rowSet_disjoint (D : TerminalOrderedIntersectionGridData I)
    ⦃i i' : Fin (z h)⦄ (hii : i ≠ i') :
    Disjoint (D.rowSet i) (D.rowSet i') := by
  classical
  have hrow_ne :
      D.inv.orderedRows.order.symm i ≠
        D.inv.orderedRows.order.symm i' := by
    intro h
    exact hii (by
      have := congrArg D.inv.orderedRows.order h
      simpa using this)
  exact D.inv.rowsNodeDisjoint hrow_ne

theorem colSet_disjoint (D : TerminalOrderedIntersectionGridData I)
    ⦃j j' : Fin h⦄ (hjj : j ≠ j') :
    Disjoint (D.colSet j) (D.colSet j') :=
  D.columns.qstar_nodeDisjoint hjj

theorem branch_disjoint (D : TerminalOrderedIntersectionGridData I)
    ⦃i i' : Fin (z h)⦄ ⦃j j' : Fin h⦄
    (hij : (i, j) ≠ (i', j')) :
    Disjoint (D.branch i j) (D.branch i' j') :=
  branch_disjoint_of_row_column_disjoint
    D.rowSet D.colSet D.branch D.branch_subset_row D.branch_subset_col
    (fun _ _ h => D.rowSet_disjoint h)
    (fun _ _ h => D.colSet_disjoint h) hij

/-- Convert explicitly ordered terminal intersection data into the rectangular
grid branch model. -/
noncomputable def toRectangularGridBranchModel
    (D : TerminalOrderedIntersectionGridData I) :
    RectangularGridBranchModel G (z h) h where
  branch := D.branch
  branch_nonempty := D.branch_nonempty
  branch_connected := D.branch_connected
  branch_disjoint := by
    intro i j i' j' hne
    exact D.branch_disjoint hne
  horizontal_adj := D.horizontal_adj
  vertical_adj := D.vertical_adj

/-- Explicitly ordered terminal intersection data gives the terminal trace
grid certificate. -/
noncomputable def toTerminalTraceGridCertificate
    (D : TerminalOrderedIntersectionGridData I) :
    TerminalTraceGridCertificate I where
  model := D.toRectangularGridBranchModel

theorem containsGridMinor (D : TerminalOrderedIntersectionGridData I) :
    ContainsGridMinor G h :=
  D.toTerminalTraceGridCertificate.containsGridMinor

end TerminalOrderedIntersectionGridData

/-- Claim-B.2-style terminal adjacencies for an explicit terminal column
order.  The no-cross/common-order proof should construct the `columns` order
and then prove these horizontal and vertical edge witnesses for consecutive
labels in that order. -/
structure ClaimB2OrderedTerminalGridAdjacencies
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (columns : TerminalColumnOrder Q0) where
  horizontal_adj :
    ∀ i : Fin (z h), ∀ ⦃j j' : Fin h⦄, FinConsecutive j j' →
      ∃ u ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j).vertexSet),
        ∃ v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j').vertexSet),
          G.Adj u v
  vertical_adj :
    ∀ ⦃i i' : Fin (z h)⦄, FinConsecutive i i' → ∀ j : Fin h,
      ∃ u ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j).vertexSet),
        ∃ v ∈ ((I.rowPath (inv.orderedRows.order.symm i')).vertexSet) ∩
          ((columns.qstar j).vertexSet),
          G.Adj u v

/-- Claim-B.3-style connected intersections for an explicit terminal column
order.  This is the corrected version of the terminal connectedness statement:
the row/transversal intersections are taken with the terminal common-order
columns. -/
structure ClaimB3OrderedConnectedIntersections
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (columns : TerminalColumnOrder Q0) where
  branch_connected :
    ∀ i : Fin (z h), ∀ j : Fin h,
      (G.induce {v : V |
        v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j).vertexSet)}).Connected

/-- Core terminal data with the correct, explicit column order.  Branch
nonemptiness is omitted because it follows from the maintained `Q0`
row-intersection invariant for any ordered subfamily. -/
structure TerminalOrderedIntersectionCoreData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0) where
  inv : TypeOneIterationInvariants I
  columns : TerminalColumnOrder Q0
  branch_connected :
    ∀ i : Fin (z h), ∀ j : Fin h,
      (G.induce {v : V |
        v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j).vertexSet)}).Connected
  horizontal_adj :
    ∀ i : Fin (z h), ∀ ⦃j j' : Fin h⦄, FinConsecutive j j' →
      ∃ u ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j).vertexSet),
        ∃ v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j').vertexSet),
          G.Adj u v
  vertical_adj :
    ∀ ⦃i i' : Fin (z h)⦄, FinConsecutive i i' → ∀ j : Fin h,
      ∃ u ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j).vertexSet),
        ∃ v ∈ ((I.rowPath (inv.orderedRows.order.symm i')).vertexSet) ∩
          ((columns.qstar j).vertexSet),
          G.Adj u v

namespace TerminalOrderedIntersectionCoreData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}

/-- Bundle the explicitly ordered terminal versions of Claims B.2 and B.3 into
the ordered terminal core data. -/
def of_claimB2_B3
    (inv : TypeOneIterationInvariants I)
    (columns : TerminalColumnOrder Q0)
    (claimB2 : ClaimB2OrderedTerminalGridAdjacencies I inv columns)
    (claimB3 : ClaimB3OrderedConnectedIntersections I inv columns) :
    TerminalOrderedIntersectionCoreData I where
  inv := inv
  columns := columns
  branch_connected := claimB3.branch_connected
  horizontal_adj := claimB2.horizontal_adj
  vertical_adj := claimB2.vertical_adj

/-- Fill branch nonemptiness from the maintained row-contact invariant and the
explicit terminal column order. -/
noncomputable def toTerminalOrderedIntersectionGridData
    (D : TerminalOrderedIntersectionCoreData I) :
    TerminalOrderedIntersectionGridData I where
  inv := D.inv
  columns := D.columns
  branch_nonempty := by
    intro i j
    exact D.columns.currentRow_inter_nonempty I D.inv.orderedRows i j
  branch_connected := D.branch_connected
  horizontal_adj := D.horizontal_adj
  vertical_adj := D.vertical_adj

noncomputable def toTerminalTraceGridCertificate
    (D : TerminalOrderedIntersectionCoreData I) :
    TerminalTraceGridCertificate I :=
  D.toTerminalOrderedIntersectionGridData.toTerminalTraceGridCertificate

theorem containsGridMinor (D : TerminalOrderedIntersectionCoreData I) :
    ContainsGridMinor G h :=
  D.toTerminalTraceGridCertificate.containsGridMinor

end TerminalOrderedIntersectionCoreData

/-- Terminal branch sets defined as intersections of the ordered rows with the
selected type-1 `Q*` columns.  The nontrivial geometric content of the terminal
stage is isolated in the connectedness and adjacency fields: Claim B.3 gives
connectedness, no-cross gives horizontal order, and the trace gives vertical
adjacency. -/
structure TerminalIntersectionGridData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0) where
  inv : TypeOneIterationInvariants I
  branch_nonempty :
    ∀ i : Fin (z h), ∀ j : Fin h,
      (((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
        ((Q0.selectedData (Q0.selectedColumn j)
          (Q0.selectedColumn_mem_selectedIndexSet j)).qstar.vertexSet)).Nonempty
  branch_connected :
    ∀ i : Fin (z h), ∀ j : Fin h,
      (G.induce {v : V |
        v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((Q0.selectedData (Q0.selectedColumn j)
            (Q0.selectedColumn_mem_selectedIndexSet j)).qstar.vertexSet)}).Connected
  horizontal_adj :
    ∀ i : Fin (z h), ∀ ⦃j j' : Fin h⦄, FinConsecutive j j' →
      ∃ u ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((Q0.selectedData (Q0.selectedColumn j)
            (Q0.selectedColumn_mem_selectedIndexSet j)).qstar.vertexSet),
        ∃ v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((Q0.selectedData (Q0.selectedColumn j')
            (Q0.selectedColumn_mem_selectedIndexSet j')).qstar.vertexSet),
          G.Adj u v
  vertical_adj :
    ∀ ⦃i i' : Fin (z h)⦄, FinConsecutive i i' → ∀ j : Fin h,
      ∃ u ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((Q0.selectedData (Q0.selectedColumn j)
            (Q0.selectedColumn_mem_selectedIndexSet j)).qstar.vertexSet),
        ∃ v ∈ ((I.rowPath (inv.orderedRows.order.symm i')).vertexSet) ∩
          ((Q0.selectedData (Q0.selectedColumn j)
            (Q0.selectedColumn_mem_selectedIndexSet j)).qstar.vertexSet),
          G.Adj u v

/-- The terminal geometric data after no-bump/no-cross and hill elimination,
with branch nonemptiness omitted because it follows from the maintained
`Q0` row-intersection invariant. -/
structure TerminalIntersectionCoreData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0) where
  inv : TypeOneIterationInvariants I
  branch_connected :
    ∀ i : Fin (z h), ∀ j : Fin h,
      (G.induce {v : V |
        v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((Q0.selectedData (Q0.selectedColumn j)
            (Q0.selectedColumn_mem_selectedIndexSet j)).qstar.vertexSet)}).Connected
  horizontal_adj :
    ∀ i : Fin (z h), ∀ ⦃j j' : Fin h⦄, FinConsecutive j j' →
      ∃ u ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((Q0.selectedData (Q0.selectedColumn j)
            (Q0.selectedColumn_mem_selectedIndexSet j)).qstar.vertexSet),
        ∃ v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((Q0.selectedData (Q0.selectedColumn j')
            (Q0.selectedColumn_mem_selectedIndexSet j')).qstar.vertexSet),
          G.Adj u v
  vertical_adj :
    ∀ ⦃i i' : Fin (z h)⦄, FinConsecutive i i' → ∀ j : Fin h,
      ∃ u ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((Q0.selectedData (Q0.selectedColumn j)
            (Q0.selectedColumn_mem_selectedIndexSet j)).qstar.vertexSet),
      ∃ v ∈ ((I.rowPath (inv.orderedRows.order.symm i')).vertexSet) ∩
          ((Q0.selectedData (Q0.selectedColumn j)
            (Q0.selectedColumn_mem_selectedIndexSet j)).qstar.vertexSet),
          G.Adj u v

/-- The row-column intersection used as a terminal branch set in Claim B.3:
the `i`-th current row intersected with the `j`-th selected trimmed
transversal `Q*`. -/
noncomputable def claimB3BranchSet
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (i : Fin (z h)) (j : Fin h) : Finset V :=
  ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
    ((Q0.selectedData (Q0.selectedColumn j)
      (Q0.selectedColumn_mem_selectedIndexSet j)).qstar.vertexSet)

/-- The `i`-th current row in the ordered terminal row family. -/
noncomputable def claimB3RowPath
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (i : Fin (z h)) : GraphPath G :=
  I.rowPath (inv.orderedRows.order.symm i)

/-- The `j`-th selected trimmed transversal `Q*`. -/
noncomputable def claimB3ColumnPath
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (_inv : TypeOneIterationInvariants I)
    (j : Fin h) : GraphPath G :=
  (Q0.selectedData (Q0.selectedColumn j)
    (Q0.selectedColumn_mem_selectedIndexSet j)).qstar

/-- The terminal columns as used in Claim B.3 are pairwise vertex-disjoint. -/
theorem claimB3ColumnPath_vertexSet_disjoint_of_ne
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    {j k : Fin h} (hjk : j ≠ k) :
    Disjoint (claimB3ColumnPath I inv j).vertexSet
      (claimB3ColumnPath I inv k).vertexSet := by
  simpa [claimB3ColumnPath, GraphPath.NodeDisjoint] using
    Q0.selectedColumn_qstar_nodeDisjoint hjk

/-- Connectedness of one terminal row-column branch set. -/
def claimB3BranchConnected
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (i : Fin (z h)) (j : Fin h) : Prop :=
  (G.induce {v : V | v ∈ claimB3BranchSet I inv i j}).Connected

/-- A finite set of vertices is convex along a graph path if every path vertex
between two of its vertices also lies in the set.  This is the path-theoretic
normal-form content of Claim B.3 after all hills have been eliminated. -/
def GraphPathTraceConvex (P : GraphPath G) (U : Finset V) : Prop :=
  ∀ ⦃a b c : V⦄,
    a ∈ P.vertexSet ∩ U → c ∈ P.vertexSet ∩ U →
      b ∈ P.vertexSet → P.Before a b → P.Before b c → b ∈ U

variable {P : GraphPath G} {U : Finset V}

/-- A nonempty convex trace on a path is itself path-shaped: it is the segment
from the first hit of the set to the last hit of the set. -/
noncomputable def graphPath_traceOn_of_traceConvex
    (hne : (P.vertexSet ∩ U).Nonempty)
    (hconv : GraphPathTraceConvex P U) :
    P.TraceOn U := by
  let first := P.firstHitVertex U hne
  let last := P.lastHitVertex U hne
  have hfirst : first ∈ P.vertexSet ∩ U := by
    simpa [first] using (P.firstHitVertex_spec U hne).1
  have hlast : last ∈ P.vertexSet ∩ U := by
    simpa [last] using (P.lastHitVertex_spec U hne).1
  have hfirst_before_last : P.Before first last := by
    exact P.firstHitVertex_before_of_mem_set U hne
      (by simpa [last] using P.lastHitVertex_mem_vertexSet U hne)
      (by simpa [last] using P.lastHitVertex_mem_set U hne)
  refine ⟨P.segmentOfBefore hfirst_before_last, ?_⟩
  ext v
  constructor
  · intro hv
    have hvP : v ∈ P.vertexSet :=
      P.segmentOfBefore_vertexSet_subset hfirst_before_last hv
    have hfirst_before_v : P.Before first v :=
      P.before_of_mem_segmentOfBefore_left hfirst_before_last hv
    have hv_before_last : P.Before v last :=
      P.before_of_mem_segmentOfBefore_right hfirst_before_last hv
    exact Finset.mem_inter.2
      ⟨hvP, hconv hfirst hlast hvP hfirst_before_v hv_before_last⟩
  · intro hv
    rcases Finset.mem_inter.1 hv with ⟨hvP, hvU⟩
    have hfirst_before_v : P.Before first v := by
      exact P.firstHitVertex_before_of_mem_set U hne hvP hvU
    have hv_before_last : P.Before v last := by
      exact P.before_lastHitVertex_of_mem_set U hne hvP hvU
    exact P.mem_segmentOfBefore_of_before_of_before
      hfirst_before_last hfirst_before_v hv_before_last

/-- Ordered-column version of the Claim B.3 convex trace normal form.  The
terminal no-cross proof supplies the explicit `columns` order; hill
elimination then says that every selected transversal meets every row in a
convex interval of that transversal. -/
def ClaimB3OrderedTraceConvexNormalForm
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (columns : TerminalColumnOrder Q0) : Prop :=
  ∀ i : Fin (z h), ∀ j : Fin h,
    GraphPathTraceConvex (columns.qstar j)
      (claimB3RowPath I inv i).vertexSet

namespace ClaimB3OrderedConnectedIntersections

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}
variable {columns : TerminalColumnOrder Q0}

/-- Ordered-column Claim B.3 from the convex trace normal form.  This is the
ordered analogue of `claimB3_connectedIntersections_of_traceConvexNormalForm`
and is the form needed after the no-cross/common-order refactor. -/
theorem of_traceConvexNormalForm
    (H : ClaimB3OrderedTraceConvexNormalForm I inv columns) :
    ClaimB3OrderedConnectedIntersections I inv columns where
  branch_connected := by
    intro i j
    have hne_row_col :=
      columns.currentRow_inter_nonempty I inv.orderedRows i j
    have hne_col_row :
        (((columns.qstar j).vertexSet) ∩
          (claimB3RowPath I inv i).vertexSet).Nonempty := by
      rcases hne_row_col with ⟨v, hv⟩
      exact ⟨v, by
        simpa [claimB3RowPath, Finset.mem_inter, and_comm] using hv⟩
    have htrace :
        (columns.qstar j).TraceOn
          (claimB3RowPath I inv i).vertexSet :=
      graphPath_traceOn_of_traceConvex hne_col_row (H i j)
    let P : GraphPath G := Classical.choose htrace
    have hP : P.vertexSet =
        (columns.qstar j).vertexSet ∩
          (claimB3RowPath I inv i).vertexSet := by
      simpa [P] using Classical.choose_spec htrace
    have hset :
        (↑P.vertexSet : Set V) =
          {v : V |
            v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
              ((columns.qstar j).vertexSet)} := by
      ext v
      simp [hP, claimB3RowPath, Finset.mem_inter, and_comm]
    change
      (G.induce
        {v : V |
          v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
            ((columns.qstar j).vertexSet)}).Connected
    rw [← hset]
    exact GraphPath.connected_induce_vertexSet P

end ClaimB3OrderedConnectedIntersections

/-! ### Ordered-column finite-ascent form of Claim B.3 -/

/-- Ordered-column non-convex trace witness for Claim B.3.

This is the terminal-column-order version of `ClaimB3NonconvexTrace`: along
the ordered transversal column there are two contacts with a row and a vertex
between them that is not on that row.  Ruling these witnesses out is
equivalent to the ordered convex trace normal form. -/
structure ClaimB3OrderedNonconvexTrace
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (columns : TerminalColumnOrder Q0)
    (row : Fin (z h)) (col : Fin h) where
  left : V
  middle : V
  right : V
  left_mem :
    left ∈ (columns.qstar col).vertexSet ∩
      (claimB3RowPath I inv row).vertexSet
  right_mem :
    right ∈ (columns.qstar col).vertexSet ∩
      (claimB3RowPath I inv row).vertexSet
  middle_mem_column : middle ∈ (columns.qstar col).vertexSet
  left_before_middle :
    (columns.qstar col).Before left middle
  middle_before_right :
    (columns.qstar col).Before middle right
  middle_not_mem_row :
    middle ∉ (claimB3RowPath I inv row).vertexSet

/-- Ordered convex trace normal form is exactly the absence of ordered
non-convex trace witnesses. -/
theorem claimB3OrderedTraceConvexNormalForm_iff_no_nonconvex_trace
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    {columns : TerminalColumnOrder Q0} :
    ClaimB3OrderedTraceConvexNormalForm I inv columns ↔
      ∀ i : Fin (z h), ∀ j : Fin h,
        ¬ Nonempty (ClaimB3OrderedNonconvexTrace I inv columns i j) := by
  constructor
  · intro H i j hbad
    rcases hbad with ⟨N⟩
    exact N.middle_not_mem_row
      (H i j N.left_mem N.right_mem N.middle_mem_column
        N.left_before_middle N.middle_before_right)
  · intro H i j a b c ha hc hb hab hbc
    by_contra hbrow
    exact H i j ⟨{
      left := a
      middle := b
      right := c
      left_mem := ha
      right_mem := hc
      middle_mem_column := hb
      left_before_middle := hab
      middle_before_right := hbc
      middle_not_mem_row := hbrow
    }⟩

/-- Local finite-ascent lemma for the ordered Claim B.3 section.

It is intentionally kept separate from the later historical
`no_fin_row_candidate_of_strictly_higher` declaration so this ordered section
can be used before the older path-level Claim B.3 API is introduced. -/
theorem no_ordered_fin_row_candidate_of_strictly_higher
    {rows cols : ℕ} {Candidate : Fin rows → Fin cols → Prop}
    (hstep :
    ∀ i j, Candidate i j →
        ∃ i' j', i.1 < i'.1 ∧ Candidate i' j') :
    ∀ i j, ¬ Candidate i j := by
  classical
  let μ : Fin rows × Fin cols → ℕ := fun x => rows - x.1.1
  intro i j hij
  refine WellFounded.induction
    (C := fun x : Fin rows × Fin cols => Candidate x.1 x.2 → False)
    (InvImage.wf μ <| (Nat.lt_wfRel).2) (i, j) ?_ hij
  intro x ih hx
  rcases hstep x.1 x.2 hx with ⟨i', j', hlt, hcand⟩
  apply ih (i', j') ?_ hcand
  have hi'lt : i'.1 < rows := i'.2
  dsimp [μ]
  exact tsub_lt_tsub_left_of_le (Nat.le_of_lt hi'lt) hlt

/-- Generic finite descent on a natural-number measure.

This is the abstract termination principle used for hill elimination: whenever
a nonterminal state has a successor with strictly smaller measure, some
terminal state is eventually reached. -/
theorem exists_terminal_of_nat_descent
    {State : Type u} (measure : State → ℕ) (Terminal : State → Prop)
    (step : ∀ s : State, ¬ Terminal s →
      ∃ s' : State, measure s' < measure s)
    (s₀ : State) :
    ∃ s : State, Terminal s := by
  classical
  let motive : State → Prop := fun _ => ∃ s : State, Terminal s
  change motive s₀
  refine (InvImage.wf measure <| (Nat.lt_wfRel).2).induction
    (C := motive) s₀ ?_
  intro s ih
  by_cases hterm : Terminal s
  · exact ⟨s, hterm⟩
  · rcases step s hterm with ⟨s', hlt⟩
    exact ih s' hlt

/-- Ordered-column path-level hill-normal certificate for Claim B.3.

This is the ordered analogue of `ClaimB3PathHillNormalCertificate`.  It is the
finite part of the paper's Claim B.3 proof after the no-cross/common-order
argument has chosen the columns: every ordered non-convex trace gives a hill
candidate, and every hill candidate forces one on a strictly higher row. -/
structure ClaimB3OrderedPathHillNormalCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (columns : TerminalColumnOrder Q0) where
  HillCandidate : Fin (z h) → Fin h → Prop
  candidate_of_nonconvex_trace :
    (∃ i : Fin (z h), ∃ j : Fin h,
      Nonempty (ClaimB3OrderedNonconvexTrace I inv columns i j)) →
      ∃ i : Fin (z h), ∃ j : Fin h, HillCandidate i j
  higher_candidate_of_candidate :
    ∀ i : Fin (z h), ∀ j : Fin h, HillCandidate i j →
      ∃ i' : Fin (z h), ∃ j' : Fin h,
        i.1 < i'.1 ∧ HillCandidate i' j'

namespace ClaimB3OrderedPathHillNormalCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}
variable {columns : TerminalColumnOrder Q0}

/-- The ordered finite-ascent proof of Claim B.3: the hill-normal ascent
certificate rules out all ordered non-convex traces. -/
theorem no_nonconvex_trace
    (C : ClaimB3OrderedPathHillNormalCertificate I inv columns) :
    ∀ i : Fin (z h), ∀ j : Fin h,
      ¬ Nonempty (ClaimB3OrderedNonconvexTrace I inv columns i j) := by
  intro i j hbad
  rcases C.candidate_of_nonconvex_trace ⟨i, j, hbad⟩ with
    ⟨i₀, j₀, hcand⟩
  exact no_ordered_fin_row_candidate_of_strictly_higher
      (Candidate := C.HillCandidate)
      C.higher_candidate_of_candidate i₀ j₀ hcand

/-- The ordered hill-normal ascent certificate gives the ordered convex trace
normal form used by the terminal grid-minor model. -/
theorem traceConvexNormalForm
    (C : ClaimB3OrderedPathHillNormalCertificate I inv columns) :
    ClaimB3OrderedTraceConvexNormalForm I inv columns :=
  (claimB3OrderedTraceConvexNormalForm_iff_no_nonconvex_trace).2
    C.no_nonconvex_trace

/-- The ordered hill-normal ascent certificate gives the connected
row/transversal intersections of Claim B.3. -/
theorem connectedIntersections
    (C : ClaimB3OrderedPathHillNormalCertificate I inv columns) :
    ClaimB3OrderedConnectedIntersections I inv columns :=
  ClaimB3OrderedConnectedIntersections.of_traceConvexNormalForm
    C.traceConvexNormalForm

end ClaimB3OrderedPathHillNormalCertificate

/-- Ordered Claim B.3 from the path-level finite-ascent certificate. -/
theorem claimB3_orderedConnectedIntersections_of_pathHillNormalCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    {columns : TerminalColumnOrder Q0}
    (C : ClaimB3OrderedPathHillNormalCertificate I inv columns) :
    ClaimB3OrderedConnectedIntersections I inv columns :=
  C.connectedIntersections

namespace TerminalOrderedIntersectionCoreData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}

/-- Bundle ordered Claim B.2 with the ordered convex trace normal form from
hill elimination.  The connected-intersection part of Claim B.3 is derived
internally from convexity. -/
def of_claimB2_traceConvex
    (inv : TypeOneIterationInvariants I)
    (columns : TerminalColumnOrder Q0)
    (claimB2 : ClaimB2OrderedTerminalGridAdjacencies I inv columns)
    (claimB3 :
      ClaimB3OrderedTraceConvexNormalForm I inv columns) :
    TerminalOrderedIntersectionCoreData I :=
  of_claimB2_B3 inv columns claimB2
    (ClaimB3OrderedConnectedIntersections.of_traceConvexNormalForm claimB3)

/-- Bundle ordered Claim B.2 with the ordered finite-ascent proof of
Claim B.3.  This is the terminal handoff closest to the paper after
hill-elimination: Claim B.2 gives the row/column adjacencies, while the
ordered hill-normal ascent certificate proves connected row-column
intersections. -/
def of_claimB2_pathHillNormalCertificate
    (inv : TypeOneIterationInvariants I)
    (columns : TerminalColumnOrder Q0)
    (claimB2 : ClaimB2OrderedTerminalGridAdjacencies I inv columns)
    (claimB3 :
      ClaimB3OrderedPathHillNormalCertificate I inv columns) :
    TerminalOrderedIntersectionCoreData I :=
  of_claimB2_traceConvex inv columns claimB2
    claimB3.traceConvexNormalForm

end TerminalOrderedIntersectionCoreData

/-- Type-1 terminal proof data stated as ordered Claim B.2 plus the ordered
path-hill-normal proof of Claim B.3. -/
structure OrderedPathHillTerminalData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  columns : TerminalColumnOrder Q0
  claimB2 : ClaimB2OrderedTerminalGridAdjacencies I inv columns
  claimB3 : Nonempty
    (ClaimB3OrderedPathHillNormalCertificate I inv columns)

namespace OrderedPathHillTerminalData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Convert the concrete ordered path-hill terminal package into the terminal
intersection core data used by the grid model. -/
noncomputable def toTerminalOrderedIntersectionCoreData
    (D : OrderedPathHillTerminalData I inv) :
    TerminalOrderedIntersectionCoreData I :=
  TerminalOrderedIntersectionCoreData.of_claimB2_pathHillNormalCertificate
    inv D.columns D.claimB2 D.claimB3.some

/-- The ordered path-hill terminal package directly implies the grid minor. -/
theorem containsGridMinor
    (D : OrderedPathHillTerminalData I inv) :
    ContainsGridMinor G h :=
  D.toTerminalOrderedIntersectionCoreData.containsGridMinor

