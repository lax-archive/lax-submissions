    TypeTwoLastHitBranchData R hpos Q hmid := by
  classical
  let hp3 :=
    middleBoundarySuffix_hits_pThreeZPlusOne_of_source_pTwoZ
      (L := L) (R := R) (hpos := hpos) T hmid hend hsource
  exact {
    hp3 := hp3
    hits_block3 :=
      typeTwoQStarFromLastFirst_hits_block3_of_completeTrace
        (L := L) (R := R) (hpos := hpos) T hmid hsource hp3
    avoids_other_linkage :=
      typeTwoQStarFromLastFirst_avoids_other_linkage_of_completeTrace
        (L := L) (R := R) (hpos := hpos) T hmid hsource hp3
  }

namespace TypeOneLastHitBranchData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : GraphPath G}
variable {hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty}

/-- Package the type-1 branch data as a full last/first-hit witness once the
last middle-boundary vertex is known to lie on `P_{z+1}`. -/
def toWitness (D : TypeOneLastHitBranchData R hpos Q hmid)
    (hv :
      (middleBoundarySuffix (L := L) R hpos Q hmid).source ∈
        (L.path (R.pZPlusOneIndex hpos)).vertexSet) :
    TypeOneLastFirstWitness R hpos Q where
  hmid := hmid
  last_mem_PzPlusOne := hv
  hp0 := D.hp0
  hits_block1 := D.hits_block1
