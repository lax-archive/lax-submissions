  left_start_ne_middle : bracket.leftAtom.start ≠ middleAtom.stop
  middle_start_ne_right : middleAtom.stop ≠ bracket.rightAtom.start
  middle_stop_ne_left : middleAtom.start ≠ bracket.leftAtom.stop
  right_stop_ne_middle : bracket.rightAtom.stop ≠ middleAtom.start

namespace ClaimB3LowerNeighborLowerToTopAtomData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}
variable {C : ClaimB3HillCandidateData I inv} {j' : Fin h}

theorem impossible
    (S : ClaimB2PlanarStripCertificate I inv)
    (D : ClaimB3LowerNeighborLowerToTopAtomData inv C j')
    (hj' : j' ≠ C.col) :
    False :=
  D.bracket.impossible_lowerToTop S D.middleAtom D.middle_qIndex hj'
    D.middle_lower D.middle_top
    D.left_middle_top D.middle_right_top
    D.left_start_ne_middle D.middle_start_ne_right
    D.middle_stop_ne_left D.right_stop_ne_middle

