import Mathlib.Tactic
import Lax17Proofs.Source.Degree
import Lax17Proofs.Source.ChekuriChuzhoyStructural
import Lax17Proofs.Source.SparseGrid

namespace Lax17Proofs

universe u v w

/-!
# Chekuri--Chuzhoy Appendix B.1, rerouting proof

This file formalizes the rerouting part of Theorem B.1 from Appendix B of
`chekuri-chuzhoy.pdf`.

It records the initial long auxiliary 2-path, the four blocks of linkage paths,
the endpoint sets `X` and `Y`, the transversal path packing supplied by
linkedness, the type-1/type-2 subpath certificates `Q*`, the bump and cross
rerouting actions, and the finite descent principle for the bump/cross loop.
-/

namespace SimpleGraph
namespace ChekuriChuzhoy
namespace AppendixB1


variable {V : Type u} [DecidableEq V]
variable {G : _root_.SimpleGraph V} {A B : Finset V}

/-- A finite natural-number trace changes by at most one at each step. -/
def UnitStepNatTrace (n : ℕ) (f : Fin (n + 1) → ℕ) : Prop :=
  ∀ r : Fin n,
    f ⟨r.1 + 1, by omega⟩ ≤ f ⟨r.1, by omega⟩ + 1 ∧
      f ⟨r.1, by omega⟩ ≤ f ⟨r.1 + 1, by omega⟩ + 1

/-- A compressed row trace changes by exactly one at every step.  This is the
finite-list form used in Claim B.3 after maximal equal-index runs have been
removed. -/
def ExactUnitStepNatTrace (n : ℕ) (f : Fin (n + 1) → ℕ) : Prop :=
  ∀ r : Fin n,
    f ⟨r.1 + 1, by omega⟩ + 1 = f ⟨r.1, by omega⟩ ∨
      f ⟨r.1, by omega⟩ + 1 = f ⟨r.1 + 1, by omega⟩

/-- The compressed row trace is strictly moving down at every step. -/
def StrictDownNatTrace (n : ℕ) (f : Fin (n + 1) → ℕ) : Prop :=
  ∀ r : Fin n,
    f ⟨r.1 + 1, by omega⟩ + 1 = f ⟨r.1, by omega⟩

/-- Along a strictly descending unit trace, the value plus the index is
constant. -/
theorem StrictDownNatTrace.value_add_index_eq
    {n : ℕ} {f : Fin (n + 1) → ℕ}
    (hdown : StrictDownNatTrace n f) :
    ∀ r : Fin (n + 1), f r + r.1 = f ⟨0, by omega⟩ := by
  intro r
  have H : ∀ k : ℕ, ∀ hk : k < n + 1,
      f ⟨k, hk⟩ + k = f ⟨0, by omega⟩ := by
    intro k
    induction k with
  | zero =>
      intro hk
      simp
  | succ k ih =>
      intro hk
      have hk_lt : k < n := by omega
      have hstep := hdown ⟨k, hk_lt⟩
      have hstep' :
          f ⟨k + 1, by omega⟩ + 1 = f ⟨k, by omega⟩ := by
        simpa using hstep
      have ihk : f ⟨k, by omega⟩ + k = f ⟨0, by omega⟩ := ih (by omega)
      have hcur :
          f ⟨k + 1, by omega⟩ + (k + 1) =
            f ⟨k, by omega⟩ + k := by
        omega
      calc
        f ⟨k + 1, hk⟩ + (k + 1)
            = f ⟨k + 1, by omega⟩ + (k + 1) := by rfl
        _ = f ⟨k, by omega⟩ + k := hcur
        _ = f ⟨0, by omega⟩ := ihk
  exact H r.1 r.2

/-- In a strictly descending unit trace, later indices have strictly smaller
values. -/
theorem StrictDownNatTrace.value_lt_of_index_lt
    {n : ℕ} {f : Fin (n + 1) → ℕ}
    (hdown : StrictDownNatTrace n f)
    {a b : Fin (n + 1)} (hab : a.1 < b.1) :
    f b < f a := by
  have ha := hdown.value_add_index_eq a
  have hb := hdown.value_add_index_eq b
  omega

/-- Exact unit steps are, in particular, unit steps in the weak sense. -/
theorem ExactUnitStepNatTrace.toUnitStep
    {n : ℕ} {f : Fin (n + 1) → ℕ}
    (hstep : ExactUnitStepNatTrace n f) :
    UnitStepNatTrace n f := by
  intro r
  rcases hstep r with hdown | hup
  · constructor <;> omega
  · constructor <;> omega

/-- In a compressed exact unit-step trace whose first value is maximal, any
failure to move strictly down contains a local down-and-back valley.  This is
the finite trace lemma behind the Claim B.3 sentence “choose a local valley in
the row-index walk.” -/
theorem ExactUnitStepNatTrace.exists_local_valley_of_not_strictDown
    {n : ℕ} {f : Fin (n + 1) → ℕ}
    (hstep : ExactUnitStepNatTrace n f)
    (hmax : ∀ r : Fin (n + 1), f r ≤ f ⟨0, by omega⟩)
    (hnot : ¬ StrictDownNatTrace n f) :
    ∃ r : Fin (n - 1),
      f ⟨r.1, by omega⟩ = f ⟨r.1 + 2, by omega⟩ ∧
        f ⟨r.1 + 1, by omega⟩ + 1 = f ⟨r.1, by omega⟩ := by
  classical
  have hex_up :
      ∃ k : ℕ, ∃ hk : k < n,
        f ⟨k, by omega⟩ + 1 = f ⟨k + 1, by omega⟩ := by
    by_contra hnone
    apply hnot
    intro r
    rcases hstep r with hdown | hup
    · exact hdown
    · exfalso
      exact hnone ⟨r.1, r.2, by simpa using hup⟩
  let k : ℕ := Nat.find hex_up
  have hk_spec :
      ∃ hk : k < n,
        f ⟨k, by omega⟩ + 1 = f ⟨k + 1, by omega⟩ :=
    Nat.find_spec hex_up
  rcases hk_spec with ⟨hk_lt_n, hk_up⟩
  have hk_min :
      ∀ m : ℕ, m < k →
        ¬ (∃ hm : m < n,
          f ⟨m, by omega⟩ + 1 = f ⟨m + 1, by omega⟩) :=
    fun m hm => Nat.find_min hex_up hm
  have hk_pos : 0 < k := by
    by_contra hk0not
    have hk0 : k = 0 := Nat.eq_zero_of_not_pos hk0not
    have hle := hmax ⟨1, by omega⟩
    have hup : f ⟨0, by omega⟩ + 1 = f ⟨1, by omega⟩ := by
      simpa [hk0] using hk_up
    omega
  have hk_prev_lt_n : k - 1 < n := by omega
  have hprev_not_up :
      ¬ (∃ hm : k - 1 < n,
        f ⟨k - 1, by omega⟩ + 1 = f ⟨(k - 1) + 1, by omega⟩) :=
    hk_min (k - 1) (by omega)
  have hprev_down :
      f ⟨(k - 1) + 1, by omega⟩ + 1 =
        f ⟨k - 1, by omega⟩ := by
    rcases hstep ⟨k - 1, hk_prev_lt_n⟩ with hdown | hup
    · exact hdown
    · exact False.elim (hprev_not_up ⟨hk_prev_lt_n, hup⟩)
  have hn_ge_two : 2 ≤ n := by omega
  refine ⟨⟨k - 1, by omega⟩, ?_, ?_⟩
  · have hprev_succ : (k - 1) + 1 = k := by omega
    have hright : (k - 1) + 2 = k + 1 := by omega
    calc
      f ⟨k - 1, by omega⟩
          = f ⟨(k - 1) + 1, by omega⟩ + 1 := hprev_down.symm
      _ = f ⟨k, by omega⟩ + 1 := by simp [hprev_succ]
      _ = f ⟨k + 1, by omega⟩ := by simpa using hk_up
      _ = f ⟨(k - 1) + 2, by omega⟩ := by simp [hright]
  · have hprev_succ : (k - 1) + 1 = k := by omega
    calc
      f ⟨(k - 1) + 1, by omega⟩ + 1
          = f ⟨k, by omega⟩ + 1 := by simp [hprev_succ]
      _ = f ⟨k - 1, by omega⟩ := by
        have hprev_succ' : (k - 1) + 1 = k := by omega
        simpa [hprev_succ'] using hprev_down

/-- Discrete intermediate value theorem for finite unit-step traces. -/
theorem UnitStepNatTrace.exists_eq_of_le
    {n a : ℕ} {f : Fin (n + 1) → ℕ}
    (hstep : UnitStepNatTrace n f)
    (hfirst : f ⟨0, by omega⟩ ≤ a)
    (hlast : a ≤ f ⟨n, by omega⟩) :
    ∃ r : Fin (n + 1), f r = a := by
  induction n with
  | zero =>
      refine ⟨⟨0, by omega⟩, ?_⟩
      omega
  | succ n ih =>
      by_cases ha0 : a ≤ f ⟨0, by omega⟩
      · refine ⟨⟨0, by omega⟩, ?_⟩
        omega
      · have h0lt : f ⟨0, by omega⟩ < a := Nat.lt_of_not_ge ha0
        let g : Fin (n + 1) → ℕ := fun i =>
          f ⟨i.1 + 1, by omega⟩
        have hgstep : UnitStepNatTrace n g := by
          intro r
          exact hstep ⟨r.1 + 1, by omega⟩
        have hgfirst : g ⟨0, by omega⟩ ≤ a := by
          have h01 : f ⟨1, by omega⟩ ≤ f ⟨0, by omega⟩ + 1 := by
            simpa using (hstep ⟨0, by omega⟩).1
          have hsucc : f ⟨0, by omega⟩ + 1 ≤ a :=
            Nat.succ_le_of_lt h0lt
          change f ⟨1, by omega⟩ ≤ a
          exact le_trans h01 hsucc
        have hglast : a ≤ g ⟨n, by omega⟩ := by
          simpa [g] using hlast
        rcases ih hgstep hgfirst hglast with ⟨r, hr⟩
        exact ⟨⟨r.1 + 1, by omega⟩, by simpa [g] using hr⟩

/-- Decreasing-direction version of the discrete intermediate value theorem for
finite unit-step traces. -/
theorem UnitStepNatTrace.exists_eq_of_ge
    {n a : ℕ} {f : Fin (n + 1) → ℕ}
    (hstep : UnitStepNatTrace n f)
    (hfirst : a ≤ f ⟨0, by omega⟩)
    (hlast : f ⟨n, by omega⟩ ≤ a) :
    ∃ r : Fin (n + 1), f r = a := by
  induction n with
  | zero =>
      refine ⟨⟨0, by omega⟩, ?_⟩
      omega
  | succ n ih =>
      by_cases ha0 : f ⟨0, by omega⟩ ≤ a
      · refine ⟨⟨0, by omega⟩, ?_⟩
        omega
      · have h0gt : a < f ⟨0, by omega⟩ := Nat.lt_of_not_ge ha0
        let g : Fin (n + 1) → ℕ := fun i =>
          f ⟨i.1 + 1, by omega⟩
        have hgstep : UnitStepNatTrace n g := by
          intro r
          exact hstep ⟨r.1 + 1, by omega⟩
        have hgfirst : a ≤ g ⟨0, by omega⟩ := by
          have h10 : f ⟨0, by omega⟩ ≤ f ⟨1, by omega⟩ + 1 := by
            simpa using (hstep ⟨0, by omega⟩).2
          change a ≤ f ⟨1, by omega⟩
          omega
        have hglast : g ⟨n, by omega⟩ ≤ a := by
          simpa [g] using hlast
        rcases ih hgstep hgfirst hglast with ⟨r, hr⟩
        exact ⟨⟨r.1 + 1, by omega⟩, by simpa [g] using hr⟩

/-- A non-self-intersecting unit-step trace stays between its endpoint values.

This is the finite-list core of the uniqueness of subpaths inside an ambient
simple path: after mapping a simple path into the vertex-index line of another
simple path, injectivity prevents the trace from going past either endpoint,
because it would have to cross the endpoint value a second time. -/
theorem UnitStepNatTrace.value_between_endpoints_of_injective
    {n : ℕ} {f : Fin (n + 1) → ℕ}
    (hstep : UnitStepNatTrace n f)
    (hinj : Function.Injective f)
    (r : Fin (n + 1)) :
    (f ⟨0, by omega⟩ ≤ f r ∧ f r ≤ f ⟨n, by omega⟩) ∨
      (f ⟨n, by omega⟩ ≤ f r ∧ f r ≤ f ⟨0, by omega⟩) := by
  classical
  let a : ℕ := f ⟨0, by omega⟩
  let b : ℕ := f ⟨n, by omega⟩
  let x : ℕ := f r
  by_cases hab : a ≤ b
  · have hax : a ≤ x := by
      by_contra hnot
      have hxlt : x < a := Nat.lt_of_not_ge hnot
      have hrpos : 0 < r.1 := by
        by_contra hr0not
        have hr0 : r.1 = 0 := Nat.eq_zero_of_not_pos hr0not
        have hr_eq : r = ⟨0, by omega⟩ := Fin.ext hr0
        simp [x, a, hr_eq] at hxlt
      let m : ℕ := n - r.1
      let g : Fin (m + 1) → ℕ := fun t =>
        f ⟨r.1 + t.1, by
          have ht : t.1 ≤ m := Nat.le_of_lt_succ t.2
          dsimp [m] at ht
          omega⟩
      have hgstep : UnitStepNatTrace m g := by
        intro t
        have hidx : r.1 + t.1 < n := by
          have ht : t.1 < m := t.2
          dsimp [m] at ht
          omega
        simpa [g] using hstep ⟨r.1 + t.1, hidx⟩
      have hgfirst : g ⟨0, by omega⟩ ≤ a := by
        change x ≤ a
        exact Nat.le_of_lt hxlt
      have hglast : a ≤ g ⟨m, by omega⟩ := by
        have hfin : r.1 + m = n := by
          dsimp [m]
          omega
        simpa [g, hfin, a, b] using hab
      rcases UnitStepNatTrace.exists_eq_of_le hgstep hgfirst hglast with
        ⟨t, ht⟩
      have hval :
          f ⟨r.1 + t.1, by
            have ht' : t.1 ≤ m := Nat.le_of_lt_succ t.2
            dsimp [m] at ht'
            omega⟩ = f ⟨0, by omega⟩ := by
        simpa [g, a] using ht
      have hfin_eq :
          (⟨r.1 + t.1, by
            have ht' : t.1 ≤ m := Nat.le_of_lt_succ t.2
            dsimp [m] at ht'
            omega⟩ : Fin (n + 1)) = ⟨0, by omega⟩ :=
        hinj hval
      have hsum0 : r.1 + t.1 = 0 := Fin.ext_iff.mp hfin_eq
      omega
    have hxb : x ≤ b := by
      by_contra hnot
      have hbxl : b < x := Nat.lt_of_not_ge hnot
      by_cases hrn : r.1 = n
      · have hr_eq : r = ⟨n, by omega⟩ := Fin.ext hrn
        simp [x, b, hr_eq] at hbxl
      · have hrlt : r.1 < n := by
          have hrle : r.1 ≤ n := by omega
          exact lt_of_le_of_ne hrle hrn
        let m : ℕ := r.1
        let g : Fin (m + 1) → ℕ := fun t => f ⟨t.1, by
          have ht : t.1 ≤ m := Nat.le_of_lt_succ t.2
          dsimp [m] at ht
          omega⟩
        have hgstep : UnitStepNatTrace m g := by
          intro t
          have hidx : t.1 < n := by
            have ht : t.1 < m := t.2
            dsimp [m] at ht
            omega
          simpa [g] using hstep ⟨t.1, hidx⟩
        have hgfirst : g ⟨0, by omega⟩ ≤ b := by
          simpa [g, a, b] using hab
        have hglast : b ≤ g ⟨m, by omega⟩ := by
          change b ≤ x
          exact Nat.le_of_lt hbxl
        rcases UnitStepNatTrace.exists_eq_of_le hgstep hgfirst hglast with
          ⟨t, ht⟩
        have hval :
            f ⟨t.1, by
              have ht' : t.1 ≤ m := Nat.le_of_lt_succ t.2
              dsimp [m] at ht'
              omega⟩ = f ⟨n, by omega⟩ := by
          simpa [g, b] using ht
        have hfin_eq :
            (⟨t.1, by
              have ht' : t.1 ≤ m := Nat.le_of_lt_succ t.2
              dsimp [m] at ht'
              omega⟩ : Fin (n + 1)) = ⟨n, by omega⟩ :=
          hinj hval
        have ht_eq_n : t.1 = n := Fin.ext_iff.mp hfin_eq
        have ht_le_m : t.1 ≤ m := Nat.le_of_lt_succ t.2
        dsimp [m] at ht_le_m
        omega
    exact Or.inl ⟨by simpa [a, x] using hax, by simpa [x, b] using hxb⟩
  · have hba : b ≤ a := Nat.le_of_not_ge hab
    have hbx : b ≤ x := by
      by_contra hnot
      have hxlt : x < b := Nat.lt_of_not_ge hnot
      by_cases hrn : r.1 = n
      · have hr_eq : r = ⟨n, by omega⟩ := Fin.ext hrn
        simp [x, b, hr_eq] at hxlt
      · have hrlt : r.1 < n := by
          have hrle : r.1 ≤ n := by omega
          exact lt_of_le_of_ne hrle hrn
        let m : ℕ := r.1
        let g : Fin (m + 1) → ℕ := fun t => f ⟨t.1, by
          have ht : t.1 ≤ m := Nat.le_of_lt_succ t.2
          dsimp [m] at ht
          omega⟩
        have hgstep : UnitStepNatTrace m g := by
          intro t
          have hidx : t.1 < n := by
            have ht : t.1 < m := t.2
            dsimp [m] at ht
            omega
          simpa [g] using hstep ⟨t.1, hidx⟩
        have hgfirst : b ≤ g ⟨0, by omega⟩ := by
          simpa [g, a, b] using hba
        have hglast : g ⟨m, by omega⟩ ≤ b := by
          change x ≤ b
          exact Nat.le_of_lt hxlt
        rcases UnitStepNatTrace.exists_eq_of_ge hgstep hgfirst hglast with
          ⟨t, ht⟩
        have hval :
            f ⟨t.1, by
              have ht' : t.1 ≤ m := Nat.le_of_lt_succ t.2
              dsimp [m] at ht'
              omega⟩ = f ⟨n, by omega⟩ := by
          simpa [g, b] using ht
        have hfin_eq :
            (⟨t.1, by
              have ht' : t.1 ≤ m := Nat.le_of_lt_succ t.2
              dsimp [m] at ht'
              omega⟩ : Fin (n + 1)) = ⟨n, by omega⟩ :=
          hinj hval
        have ht_eq_n : t.1 = n := Fin.ext_iff.mp hfin_eq
        have ht_le_m : t.1 ≤ m := Nat.le_of_lt_succ t.2
        dsimp [m] at ht_le_m
        omega
    have hxa : x ≤ a := by
      by_contra hnot
      have haltx : a < x := Nat.lt_of_not_ge hnot
      have hrpos : 0 < r.1 := by
        by_contra hr0not
        have hr0 : r.1 = 0 := Nat.eq_zero_of_not_pos hr0not
        have hr_eq : r = ⟨0, by omega⟩ := Fin.ext hr0
        simp [x, a, hr_eq] at haltx
      let m : ℕ := n - r.1
      let g : Fin (m + 1) → ℕ := fun t =>
        f ⟨r.1 + t.1, by
          have ht : t.1 ≤ m := Nat.le_of_lt_succ t.2
          dsimp [m] at ht
          omega⟩
      have hgstep : UnitStepNatTrace m g := by
        intro t
        have hidx : r.1 + t.1 < n := by
          have ht : t.1 < m := t.2
          dsimp [m] at ht
          omega
        simpa [g] using hstep ⟨r.1 + t.1, hidx⟩
      have hgfirst : a ≤ g ⟨0, by omega⟩ := by
        change a ≤ x
        exact Nat.le_of_lt haltx
      have hglast : g ⟨m, by omega⟩ ≤ a := by
        have hfin : r.1 + m = n := by
          dsimp [m]
          omega
        simpa [g, hfin, a, b] using hba
      rcases UnitStepNatTrace.exists_eq_of_ge hgstep hgfirst hglast with
        ⟨t, ht⟩
      have hval :
          f ⟨r.1 + t.1, by
            have ht' : t.1 ≤ m := Nat.le_of_lt_succ t.2
            dsimp [m] at ht'
            omega⟩ = f ⟨0, by omega⟩ := by
        simpa [g, a] using ht
      have hfin_eq :
          (⟨r.1 + t.1, by
            have ht' : t.1 ≤ m := Nat.le_of_lt_succ t.2
            dsimp [m] at ht'
            omega⟩ : Fin (n + 1)) = ⟨0, by omega⟩ :=
        hinj hval
      have hsum0 : r.1 + t.1 = 0 := Fin.ext_iff.mp hfin_eq
      omega
    exact Or.inr ⟨by simpa [b, x] using hbx, by simpa [x, a] using hxa⟩

/-- If every successor step in a finite trace is weakly descending on an
index interval, then the trace is antitone on that interval.  This is the raw
row-trace replacement for compressing equal-row stutters in Claim B.3. -/
theorem nat_trace_antitone_on_of_succ_le
    {n : ℕ} {f : Fin (n + 1) → ℕ} {lo hi : ℕ}
    (hstep :
      ∀ r : Fin n, lo ≤ r.1 → r.1 + 1 ≤ hi →
        f ⟨r.1 + 1, by omega⟩ ≤ f ⟨r.1, by omega⟩)
    {a b : Fin (n + 1)}
    (hlo_a : lo ≤ a.1) (hab : a.1 ≤ b.1) (hb_hi : b.1 ≤ hi) :
    f b ≤ f a := by
  classical
  let d : ℕ := b.1 - a.1
  have hb_eq : a.1 + d = b.1 := by
    dsimp [d]
    omega
  have H : ∀ m : ℕ, m ≤ d → ∀ hidx : a.1 + m < n + 1,
      f ⟨a.1 + m, hidx⟩ ≤ f a := by
    intro m hm
    induction m with
    | zero =>
        intro hidx
        simp
    | succ m ih =>
        intro hidx_succ
        have hm_le_d : m ≤ d := by omega
        have hidx_prev : a.1 + m < n + 1 := by omega
        have hprev_le : f ⟨a.1 + m, hidx_prev⟩ ≤ f a := ih hm_le_d hidx_prev
        have hidx_lt : a.1 + m < n := by omega
        have hstep_m :
            f ⟨(a.1 + m) + 1, by omega⟩ ≤
              f ⟨a.1 + m, hidx_prev⟩ := by
          have hlo : lo ≤ a.1 + m := by omega
          have hhi : (a.1 + m) + 1 ≤ hi := by omega
          simpa using hstep ⟨a.1 + m, hidx_lt⟩ hlo hhi
        have hcur :
            f ⟨a.1 + (m + 1), hidx_succ⟩ ≤
              f ⟨a.1 + m, hidx_prev⟩ := by
          simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hstep_m
        exact le_trans hcur hprev_le
  have hd : d ≤ d := le_rfl
  have hbd :
      (⟨a.1 + d, by omega⟩ : Fin (n + 1)) = b := by
    exact Fin.ext hb_eq
  have hidx_d : a.1 + d < n + 1 := by omega
  simpa [hbd] using H d hd hidx_d

/-- If a finite sequence has one value on or below `c` and a later value on
or above `c`, then some adjacent pair straddles `c` in that direction. -/
theorem exists_adjacent_straddle_up
    {n c : ℕ} {f : Fin (n + 1) → ℕ}
    {p q : Fin (n + 1)} (hpq : p.1 < q.1)
    (hp : f p ≤ c) (hq : c ≤ f q) :
    ∃ r : Fin n,
      p.1 ≤ r.1 ∧ r.1 + 1 ≤ q.1 ∧
        f ⟨r.1, by omega⟩ ≤ c ∧
          c ≤ f ⟨r.1 + 1, by omega⟩ := by
  classical
  let Cross : ℕ → Prop := fun k =>
    ∃ hk : k < n + 1,
      p.1 < k ∧ k ≤ q.1 ∧
        c ≤ f ⟨k, hk⟩
  have hex : ∃ k, Cross k := by
    exact ⟨q.1, q.2, hpq, le_rfl, by simpa using hq⟩
  let k : ℕ := Nat.find hex
  have hk : Cross k := Nat.find_spec hex
  rcases hk with ⟨hk_bound, hp_lt_k, hk_le_q, hc_le_fk⟩
  let r : Fin n := ⟨k - 1, by omega⟩
  refine ⟨r, ?_, ?_, ?_, ?_⟩
  · dsimp [r]
    omega
  · dsimp [r]
    omega
  · by_cases hprev : k - 1 = p.1
    · have hfin : (⟨k - 1, by omega⟩ : Fin (n + 1)) = p := Fin.ext hprev
      simpa [r, hfin] using hp
    · have hp_lt_prev : p.1 < k - 1 := by omega
      have hprev_le_q : k - 1 ≤ q.1 := by omega
      have hnot :
          ¬ Cross (k - 1) :=
        Nat.find_min hex (by omega : k - 1 < k)
      have hnot_le : ¬ c ≤ f ⟨k - 1, by omega⟩ := by
        intro hcprev
        exact hnot ⟨by omega, hp_lt_prev, hprev_le_q, hcprev⟩
      exact Nat.le_of_lt (Nat.lt_of_not_ge hnot_le)
  · have hsucc : (k - 1) + 1 = k := by omega
    simpa [r, hsucc] using hc_le_fk

/-- If two endpoint values lie on opposite sides of `c`, then some adjacent
pair between them straddles `c`, in one of the two possible orientations. -/
theorem exists_adjacent_straddle
    {n c : ℕ} {f : Fin (n + 1) → ℕ}
    {p q : Fin (n + 1)} (hpq : p.1 < q.1)
    (hstraddle :
      (f p ≤ c ∧ c ≤ f q) ∨ (f q ≤ c ∧ c ≤ f p)) :
    ∃ r : Fin n,
      p.1 ≤ r.1 ∧ r.1 + 1 ≤ q.1 ∧
        ((f ⟨r.1, by omega⟩ ≤ c ∧
            c ≤ f ⟨r.1 + 1, by omega⟩) ∨
          (f ⟨r.1 + 1, by omega⟩ ≤ c ∧
            c ≤ f ⟨r.1, by omega⟩)) := by
  classical
  rcases hstraddle with hup | hdown
  · rcases exists_adjacent_straddle_up (f := f) hpq hup.1 hup.2 with
      ⟨r, hpr, hrq, hle, hge⟩
    exact ⟨r, hpr, hrq, Or.inl ⟨hle, hge⟩⟩
  · let Cross : ℕ → Prop := fun k =>
      ∃ hk : k < n + 1,
        p.1 < k ∧ k ≤ q.1 ∧
          f ⟨k, hk⟩ ≤ c
    have hex : ∃ k, Cross k := by
      exact ⟨q.1, q.2, hpq, le_rfl, by simpa using hdown.1⟩
    let k : ℕ := Nat.find hex
    have hk : Cross k := Nat.find_spec hex
    rcases hk with ⟨hk_bound, hp_lt_k, hk_le_q, hfk_le_c⟩
    let r : Fin n := ⟨k - 1, by omega⟩
    refine ⟨r, ?_, ?_, Or.inr ?_⟩
    · dsimp [r]
      omega
    · dsimp [r]
      omega
    · refine ⟨?_, ?_⟩
      · have hsucc : (k - 1) + 1 = k := by omega
        simpa [r, hsucc] using hfk_le_c
      · by_cases hprev : k - 1 = p.1
        · have hfin : (⟨k - 1, by omega⟩ : Fin (n + 1)) = p := Fin.ext hprev
          simpa [r, hfin] using hdown.2
        · have hp_lt_prev : p.1 < k - 1 := by omega
          have hprev_le_q : k - 1 ≤ q.1 := by omega
          have hnot :
              ¬ Cross (k - 1) :=
            Nat.find_min hex (by omega : k - 1 < k)
          have hnot_le : ¬ f ⟨k - 1, by omega⟩ ≤ c := by
            intro hcprev
            exact hnot ⟨by omega, hp_lt_prev, hprev_le_q, hcprev⟩
          exact Nat.le_of_lt (Nat.lt_of_not_ge hnot_le)

/-- Vertices of a simple path are determined by their path index. -/
theorem GraphPath.eq_of_vertexIndex_eq
    (P : GraphPath G) {u v : V}
    (hu : u ∈ P.vertexSet) (hv : v ∈ P.vertexSet)
    (hidx : P.vertexIndex u = P.vertexIndex v) :
    u = v := by
  classical
  rw [GraphPath.vertexIndex] at hidx
  have huSupport : u ∈ P.walk.support := by
    simpa [GraphPath.vertexSet] using hu
  have hvSupport : v ∈ P.walk.support := by
    simpa [GraphPath.vertexSet] using hv
  have hult :
      P.walk.support.idxOf u < P.walk.support.length :=
    List.idxOf_lt_length_iff.2 huSupport
  have hvlt :
      P.walk.support.idxOf v < P.walk.support.length :=
    List.idxOf_lt_length_iff.2 hvSupport
  have huget :
      P.walk.support[P.walk.support.idxOf u]'hult = u :=
    List.getElem_idxOf hult
  have hvget :
      P.walk.support[P.walk.support.idxOf v]'hvlt = v :=
    List.getElem_idxOf hvlt
  calc
    u = P.walk.support[P.walk.support.idxOf u]'hult := huget.symm
    _ = P.walk.support[P.walk.support.idxOf v]'hvlt := by
      exact getElem_congr (c := P.walk.support) (d := P.walk.support)
        rfl hidx hult
    _ = v := hvget

/-- A path whose edges all lie in another simple path cannot skip an
intermediate vertex of the ambient path.

This is the path-graph uniqueness fact needed in Claim B.3 when a blocker
column follows a row path: if a blocker subpath starts at `Q.source`, ends at
`Q.target`, uses only row-path edges, and the row vertex `c` lies between those
endpoints in row order, then `c` lies on the blocker subpath. -/
theorem GraphPath.mem_of_vertexIndex_between_of_edgeSet_subset
    (P Q : GraphPath G)
    (hQv : Q.vertexSet ⊆ P.vertexSet)
    (hQe : Q.edgeSet ⊆ P.edgeSet)
    {c : V}
    (hcP : c ∈ P.vertexSet)
    (hsource_le_c : P.vertexIndex Q.source ≤ P.vertexIndex c)
    (hc_le_target : P.vertexIndex c ≤ P.vertexIndex Q.target) :
    c ∈ Q.vertexSet := by
  classical
  let f : Fin (Q.walk.length + 1) → ℕ := fun r =>
    P.vertexIndex (Q.walk.getVert r.1)
  have hstep : UnitStepNatTrace Q.walk.length f := by
    intro r
    let u : V := Q.walk.getVert r.1
    let v : V := Q.walk.getVert (r.1 + 1)
    have heQ : s(u, v) ∈ Q.edgeSet := by
      have hmem :
          s(u, v) ∈ Q.walk.edges := by
        rw [_root_.SimpleGraph.Walk.edges_eq_zipWith_support]
        let idx :
            Fin (List.zipWith (s(·, ·)) Q.walk.support Q.walk.support.tail).length :=
          ⟨r.1, by
            simp [_root_.SimpleGraph.Walk.length_support]⟩
        refine List.mem_iff_get.2 ⟨idx, ?_⟩
        have h0 :
            Q.walk.support[r.1]'(by
              rw [_root_.SimpleGraph.Walk.length_support]
              omega) = u := by
          simpa [u] using
            (_root_.SimpleGraph.Walk.support_getElem_eq_getVert
              Q.walk (by
                rw [_root_.SimpleGraph.Walk.length_support]
                omega))
        have h1 :
            Q.walk.support.tail[r.1]'(by
              simp [_root_.SimpleGraph.Walk.length_support]) = v := by
          have hsupport :
              Q.walk.support[r.1 + 1]'(by
                rw [_root_.SimpleGraph.Walk.length_support]
                omega) = v := by
            simpa [v] using
              (_root_.SimpleGraph.Walk.support_getElem_eq_getVert
                Q.walk (by
                  rw [_root_.SimpleGraph.Walk.length_support]
                  omega))
          simpa [List.getElem_tail] using hsupport
        simp [idx, h0, h1]
      simpa [GraphPath.edgeSet] using hmem
    have heP : s(u, v) ∈ P.edgeSet := hQe heQ
    constructor
    · change P.vertexIndex v ≤ P.vertexIndex u + 1
      exact P.edge_vertexIndex_le_succ heP
    · change P.vertexIndex u ≤ P.vertexIndex v + 1
      have heP' : s(v, u) ∈ P.edgeSet := by
        simpa [Sym2.eq_swap] using heP
      exact P.edge_vertexIndex_le_succ heP'
  have hfirst : f ⟨0, by omega⟩ ≤ P.vertexIndex c := by
    change P.vertexIndex (Q.walk.getVert 0) ≤ P.vertexIndex c
    simpa using hsource_le_c
  have hlast : P.vertexIndex c ≤ f ⟨Q.walk.length, by omega⟩ := by
    change P.vertexIndex c ≤ P.vertexIndex (Q.walk.getVert Q.walk.length)
    simpa using hc_le_target
  rcases UnitStepNatTrace.exists_eq_of_le hstep hfirst hlast with
    ⟨r, hr⟩
  have hgetQ : Q.walk.getVert r.1 ∈ Q.vertexSet := by
    rw [GraphPath.vertexSet]
    exact List.mem_toFinset.2
      (_root_.SimpleGraph.Walk.mem_support_iff_exists_getVert.2
        ⟨r.1, rfl, Nat.lt_succ_iff.mp r.2⟩)
  have hgetP : Q.walk.getVert r.1 ∈ P.vertexSet := hQv hgetQ
  have hEq : Q.walk.getVert r.1 = c := by
    rw [GraphPath.vertexIndex] at hr
    have hgetSupport :
        Q.walk.getVert r.1 ∈ P.walk.support := by
      simpa [GraphPath.vertexSet] using hgetP
    have hcSupport : c ∈ P.walk.support := by
      simpa [GraphPath.vertexSet] using hcP
    have hget_lt :
        P.walk.support.idxOf (Q.walk.getVert r.1) < P.walk.support.length :=
      List.idxOf_lt_length_iff.2 hgetSupport
    have hc_lt :
        P.walk.support.idxOf c < P.walk.support.length :=
      List.idxOf_lt_length_iff.2 hcSupport
    have hget_get :
        P.walk.support[P.walk.support.idxOf (Q.walk.getVert r.1)]'hget_lt =
          Q.walk.getVert r.1 :=
      List.getElem_idxOf hget_lt
    have hc_get :
        P.walk.support[P.walk.support.idxOf c]'hc_lt = c :=
      List.getElem_idxOf hc_lt
    calc
      Q.walk.getVert r.1
          = P.walk.support[P.walk.support.idxOf (Q.walk.getVert r.1)]'hget_lt := by
            exact hget_get.symm
      _ = P.walk.support[P.walk.support.idxOf c]'hc_lt := by
            exact getElem_congr (c := P.walk.support) (d := P.walk.support)
              rfl hr hget_lt
      _ = c := hc_get
  simpa [hEq] using hgetQ

/-- If a simple path uses only edges from an ambient simple path, then every
one of its vertices lies between its endpoints in the ambient path order,
allowing either orientation. -/
theorem GraphPath.vertexIndex_between_endpoints_of_mem_of_edgeSet_subset
    (P Q : GraphPath G)
    (hQv : Q.vertexSet ⊆ P.vertexSet)
    (hQe : Q.edgeSet ⊆ P.edgeSet)
    {c : V} (hcQ : c ∈ Q.vertexSet) :
      (P.vertexIndex Q.source ≤ P.vertexIndex c ∧
          P.vertexIndex c ≤ P.vertexIndex Q.target) ∨
        (P.vertexIndex Q.target ≤ P.vertexIndex c ∧
          P.vertexIndex c ≤ P.vertexIndex Q.source) := by
  classical
  let f : Fin (Q.walk.length + 1) → ℕ := fun r =>
    P.vertexIndex (Q.walk.getVert r.1)
  have hstep : UnitStepNatTrace Q.walk.length f := by
    intro r
    let u : V := Q.walk.getVert r.1
    let v : V := Q.walk.getVert (r.1 + 1)
    have heQ : s(u, v) ∈ Q.edgeSet := by
      have hmem :
          s(u, v) ∈ Q.walk.edges := by
        rw [_root_.SimpleGraph.Walk.edges_eq_zipWith_support]
        let idx :
            Fin (List.zipWith (s(·, ·)) Q.walk.support Q.walk.support.tail).length :=
          ⟨r.1, by
            simp [_root_.SimpleGraph.Walk.length_support]⟩
        refine List.mem_iff_get.2 ⟨idx, ?_⟩
        have h0 :
            Q.walk.support[r.1]'(by
              rw [_root_.SimpleGraph.Walk.length_support]
              omega) = u := by
          simpa [u] using
            (_root_.SimpleGraph.Walk.support_getElem_eq_getVert
              Q.walk (by
                rw [_root_.SimpleGraph.Walk.length_support]
                omega))
        have h1 :
            Q.walk.support.tail[r.1]'(by
              simp [_root_.SimpleGraph.Walk.length_support]) = v := by
          have hsupport :
              Q.walk.support[r.1 + 1]'(by
                rw [_root_.SimpleGraph.Walk.length_support]
                omega) = v := by
            simpa [v] using
              (_root_.SimpleGraph.Walk.support_getElem_eq_getVert
                Q.walk (by
                  rw [_root_.SimpleGraph.Walk.length_support]
                  omega))
          simpa [List.getElem_tail] using hsupport
        simp [idx, h0, h1]
      simpa [GraphPath.edgeSet] using hmem
    have heP : s(u, v) ∈ P.edgeSet := hQe heQ
    constructor
    · change P.vertexIndex v ≤ P.vertexIndex u + 1
      exact P.edge_vertexIndex_le_succ heP
    · change P.vertexIndex u ≤ P.vertexIndex v + 1
      have heP' : s(v, u) ∈ P.edgeSet := by
        simpa [Sym2.eq_swap] using heP
      exact P.edge_vertexIndex_le_succ heP'
  have hinj : Function.Injective f := by
    intro r s hrs
    have hrQ : Q.walk.getVert r.1 ∈ Q.vertexSet := by
      rw [GraphPath.vertexSet]
      exact List.mem_toFinset.2
        (_root_.SimpleGraph.Walk.mem_support_iff_exists_getVert.2
          ⟨r.1, rfl, by omega⟩)
    have hsQ : Q.walk.getVert s.1 ∈ Q.vertexSet := by
      rw [GraphPath.vertexSet]
      exact List.mem_toFinset.2
        (_root_.SimpleGraph.Walk.mem_support_iff_exists_getVert.2
          ⟨s.1, rfl, by omega⟩)
    have hverts_eq :
        Q.walk.getVert r.1 = Q.walk.getVert s.1 :=
      GraphPath.eq_of_vertexIndex_eq P (hQv hrQ) (hQv hsQ)
        (by simpa [f] using hrs)
    have hrSupport :
        Q.walk.support[r.1]'(by
          rw [_root_.SimpleGraph.Walk.length_support]
          omega) = Q.walk.getVert r.1 := by
      simpa using
        (_root_.SimpleGraph.Walk.support_getElem_eq_getVert Q.walk
          (by
            rw [_root_.SimpleGraph.Walk.length_support]
            omega))
    have hsSupport :
        Q.walk.support[s.1]'(by
          rw [_root_.SimpleGraph.Walk.length_support]
          omega) = Q.walk.getVert s.1 := by
      simpa using
        (_root_.SimpleGraph.Walk.support_getElem_eq_getVert Q.walk
          (by
            rw [_root_.SimpleGraph.Walk.length_support]
            omega))
    have hsupport_eq :
        Q.walk.support[r.1]'(by
          rw [_root_.SimpleGraph.Walk.length_support]
          omega) =
        Q.walk.support[s.1]'(by
          rw [_root_.SimpleGraph.Walk.length_support]
          omega) := by
      calc
        Q.walk.support[r.1]'(by
          rw [_root_.SimpleGraph.Walk.length_support]
          omega)
            = Q.walk.getVert r.1 := hrSupport
        _ = Q.walk.getVert s.1 := hverts_eq
        _ = Q.walk.support[s.1]'(by
          rw [_root_.SimpleGraph.Walk.length_support]
          omega) := hsSupport.symm
    have hnat : r.1 = s.1 :=
      Q.isPath.support_nodup.getElem_inj_iff.mp hsupport_eq
    exact Fin.ext hnat
  have hcSupport : c ∈ Q.walk.support := by
    simpa [GraphPath.vertexSet] using hcQ
  rcases _root_.SimpleGraph.Walk.mem_support_iff_exists_getVert.mp
      hcSupport with ⟨k, hk, hkle⟩
  let r : Fin (Q.walk.length + 1) := ⟨k, by omega⟩
  have hfr : f r = P.vertexIndex c := by
    simpa [f, r] using congrArg P.vertexIndex hk
  rcases UnitStepNatTrace.value_between_endpoints_of_injective
      hstep hinj r with hforward | hback
  · exact Or.inl ⟨by
      simpa [f, hfr] using hforward.1,
      by
        have htarget :
            f ⟨Q.walk.length, by omega⟩ = P.vertexIndex Q.target := by
          simp [f]
        simpa [f, hfr, htarget] using hforward.2⟩
  · exact Or.inr ⟨by
      have htarget :
          f ⟨Q.walk.length, by omega⟩ = P.vertexIndex Q.target := by
        simp [f]
      simpa [f, hfr, htarget] using hback.1,
      by
        simpa [f, hfr] using hback.2⟩

/-- Symmetric endpoint version of
`GraphPath.mem_of_vertexIndex_between_of_edgeSet_subset`.

The blocker column may traverse a row interval in either direction, so the
ambient-row vertex lying between the two segment endpoints belongs to the
blocker segment whenever the segment uses only row edges. -/
theorem GraphPath.mem_of_vertexIndex_between_endpoints_of_edgeSet_subset
    (P Q : GraphPath G)
    (hQv : Q.vertexSet ⊆ P.vertexSet)
    (hQe : Q.edgeSet ⊆ P.edgeSet)
    {c : V}
    (hcP : c ∈ P.vertexSet)
    (hbetween :
      (P.vertexIndex Q.source ≤ P.vertexIndex c ∧
          P.vertexIndex c ≤ P.vertexIndex Q.target) ∨
        (P.vertexIndex Q.target ≤ P.vertexIndex c ∧
          P.vertexIndex c ≤ P.vertexIndex Q.source)) :
    c ∈ Q.vertexSet := by
  classical
  rcases hbetween with hforward | hback
  · exact GraphPath.mem_of_vertexIndex_between_of_edgeSet_subset P Q hQv hQe hcP
      hforward.1 hforward.2
  · have hrv : Q.reverse.vertexSet ⊆ P.vertexSet := by
      intro v hv
      exact hQv (by simpa using hv)
    have hre : Q.reverse.edgeSet ⊆ P.edgeSet := by
      intro e he
      exact hQe (by simpa using he)
    have hc_rev :
        c ∈ Q.reverse.vertexSet :=
      GraphPath.mem_of_vertexIndex_between_of_edgeSet_subset P Q.reverse hrv hre hcP
        (by simpa using hback.1) (by simpa using hback.2)
    simpa using hc_rev

/-- Vertex-set uniqueness for simple subpaths of an ambient simple path.

If `Q` and `R` use only edges of an ambient path `P` and have the same
endpoints, then every vertex of `Q` is a vertex of `R`.  This is the
vertex-level form of uniqueness of the path between two vertices in a path
graph. -/
theorem GraphPath.vertexSet_subset_of_edgeSet_subset_same_endpoints
    (P Q R : GraphPath G)
    (hQv : Q.vertexSet ⊆ P.vertexSet)
    (hQe : Q.edgeSet ⊆ P.edgeSet)
    (hRv : R.vertexSet ⊆ P.vertexSet)
    (hRe : R.edgeSet ⊆ P.edgeSet)
    (hsource : Q.source = R.source)
    (htarget : Q.target = R.target) :
    Q.vertexSet ⊆ R.vertexSet := by
  classical
  intro c hcQ
  have hcP : c ∈ P.vertexSet := hQv hcQ
  have hbetweenQ :
      (P.vertexIndex Q.source ≤ P.vertexIndex c ∧
          P.vertexIndex c ≤ P.vertexIndex Q.target) ∨
        (P.vertexIndex Q.target ≤ P.vertexIndex c ∧
          P.vertexIndex c ≤ P.vertexIndex Q.source) :=
    GraphPath.vertexIndex_between_endpoints_of_mem_of_edgeSet_subset
      P Q hQv hQe hcQ
  have hbetweenR :
      (P.vertexIndex R.source ≤ P.vertexIndex c ∧
          P.vertexIndex c ≤ P.vertexIndex R.target) ∨
        (P.vertexIndex R.target ≤ P.vertexIndex c ∧
          P.vertexIndex c ≤ P.vertexIndex R.source) := by
    simpa [hsource, htarget] using hbetweenQ
  exact GraphPath.mem_of_vertexIndex_between_endpoints_of_edgeSet_subset
    P R hRv hRe hcP hbetweenR

/-- The intended conclusion of Theorem B.1 for a fixed linkage. -/
def ReroutingConclusion [Fintype V] (G : _root_.SimpleGraph V) {A B : Finset V}
    (h : ℕ) (L : PerfectPathPacking G A B) : Prop :=
  ContainsGridMinor G h ∨
    ∃ L' : PerfectPathPacking G A B,
      linkageAuxDegreeTwoCount L' < linkageAuxDegreeTwoCount L

/-- The structural statement of Theorem B.1, kept as a proposition for later
proof work. -/
def TheoremB1Statement [Fintype V] (G : _root_.SimpleGraph V) {A B : Finset V}
    (h : ℕ) (L : PerfectPathPacking G A B) : Prop :=
  G.Connected →
    NodeLinkedIn G Finset.univ A B →
      1 < h → ¬ GoodLinkage L h → ReroutingConclusion G h L

/-- The long unindexed 2-path in the auxiliary graph obtained from a bad
linkage.  This is exactly the first sentence of the proof, before the path is
named as `R* = (u_P0, ..., u_P8h)`. -/
structure InitialLongTwoPath {G : _root_.SimpleGraph V} {A B : Finset V}
    (L : PerfectPathPacking G A B) (h : ℕ) where
  path : GraphPath (linkageAuxGraph L)
  large : 8 * h + 1 ≤ path.vertexSet.card
  degree_two : ∀ i ∈ path.vertexSet, DegreeEquals (linkageAuxGraph L) i 2

/-- A bad linkage supplies the long auxiliary 2-path used at the start of
Appendix B.1. -/
theorem exists_initialLongTwoPath_of_not_good
    {L : PerfectPathPacking G A B} {h : ℕ}
    (hbad : ¬ GoodLinkage L h) :
    Nonempty (InitialLongTwoPath L h) := by
  classical
  have hcontains : ContainsTwoPath (linkageAuxGraph L) (8 * h + 1) := by
    by_contra hnot
    exact hbad hnot
  rcases hcontains with ⟨P, hlarge, hdeg⟩
  exact ⟨{ path := P, large := hlarge, degree_two := hdeg }⟩

/-- The number `z = 2 h_1` used to split the long auxiliary 2-path into four
blocks. -/
def z (h : ℕ) : ℕ := 2 * h

/-- The first position of the displayed sequence
`(u_P0, ..., u_P8h)`. -/
def p0Pos (h : ℕ) : Fin (8 * h + 1) :=
  ⟨0, by omega⟩

/-- The left endpoint of the `r`-th displayed auxiliary edge. -/
def edgeLeftPos (h : ℕ) (r : Fin (8 * h)) : Fin (8 * h + 1) :=
  ⟨r.1, by omega⟩

/-- The right endpoint of the `r`-th displayed auxiliary edge. -/
def edgeRightPos (h : ℕ) (r : Fin (8 * h)) : Fin (8 * h + 1) :=
  ⟨r.1 + 1, by omega⟩

/-- A position in a length-`z h` window of the displayed auxiliary sequence. -/
def windowPos (h offset : ℕ) (hoff : offset + z h ≤ 8 * h + 1)
    (i : Fin (z h)) : Fin (8 * h + 1) :=
  ⟨offset + i.1, by
    have hi : i.1 < z h := i.2
    omega⟩

/-- The position of `P_{z+1}`.  It is only meaningful for `h > 0`, which is
automatic in Theorem B.1 from the stronger assumption `1 < h`. -/
def pZPlusOnePos (h : ℕ) (hpos : 0 < h) : Fin (8 * h + 1) :=
  ⟨z h + 1, by
    dsimp [z]
    omega⟩

/-- The position of `P_{2z}`. -/
def pTwoZPos (h : ℕ) (hpos : 0 < h) : Fin (8 * h + 1) :=
  ⟨2 * z h, by
    dsimp [z]
    omega⟩

/-- The position of `P_{3z+1}`. -/
def pThreeZPlusOnePos (h : ℕ) (hpos : 0 < h) :
    Fin (8 * h + 1) :=
  ⟨3 * z h + 1, by
    dsimp [z]
    omega⟩

/-- The displayed indexed auxiliary 2-path
`R* = (u_P0, ..., u_P8h)`.  The index function stores the linkage path
corresponding to each displayed vertex. -/
structure IndexedAuxiliaryPrefix {G : _root_.SimpleGraph V} {A B : Finset V}
    (L : PerfectPathPacking G A B) (h : ℕ) where
  path : GraphPath (linkageAuxGraph L)
  index : Fin (8 * h + 1) → L.Index
  index_in_path : ∀ r, index r ∈ path.vertexSet
  index_injective : Function.Injective index
  consecutive_adj :
    ∀ r : Fin (8 * h),
      (linkageAuxGraph L).Adj (index (edgeLeftPos h r))
        (index (edgeRightPos h r))
  degree_two : ∀ r : Fin (8 * h + 1),
    DegreeEquals (linkageAuxGraph L) (index r) 2

/-- A simple path has as many vertices in its finite vertex set as in its
support list. -/
theorem graphPath_vertexSet_card_eq_support_length
    {H : _root_.SimpleGraph V} (P : GraphPath H) :
    P.vertexSet.card = P.walk.support.length := by
  classical
  rw [GraphPath.vertexSet]
  exact List.toFinset_card_of_nodup P.isPath.support_nodup

/-- Vertices read from a walk position of a graph path belong to its vertex
set. -/
theorem graphPath_getVert_mem_vertexSet
    {H : _root_.SimpleGraph V} (P : GraphPath H) (i : ℕ) :
    P.walk.getVert i ∈ P.vertexSet := by
  classical
  simp [GraphPath.vertexSet]

/-- The unindexed long auxiliary path can be displayed as the indexed prefix
`R* = (u_P0, ..., u_P8h)` used by the proof. -/
noncomputable def InitialLongTwoPath.toIndexedPrefix
    {G : _root_.SimpleGraph V} {A B : Finset V}
    {L : PerfectPathPacking G A B} {h : ℕ}
    (T : InitialLongTwoPath L h) : IndexedAuxiliaryPrefix L h where
  path := T.path
  index r := T.path.walk.getVert r.1
  index_in_path := by
    intro r
    exact graphPath_getVert_mem_vertexSet T.path r.1
  index_injective := by
    intro r s hrs
    have hcard :
        T.path.vertexSet.card = T.path.walk.support.length :=
      graphPath_vertexSet_card_eq_support_length T.path
    have hlen_card :
        T.path.vertexSet.card = T.path.walk.length + 1 := by
      rw [hcard, _root_.SimpleGraph.Walk.length_support]
    have hlarge_len : 8 * h + 1 ≤ T.path.walk.length + 1 := by
      simpa [hlen_card] using T.large
    have hr_le : r.1 ≤ T.path.walk.length := by
      omega
    have hs_le : s.1 ≤ T.path.walk.length := by
      omega
    have hr_len : r.1 < T.path.walk.support.length := by
      rw [_root_.SimpleGraph.Walk.length_support]
      exact Nat.lt_succ_of_le hr_le
    have hs_len : s.1 < T.path.walk.support.length := by
      rw [_root_.SimpleGraph.Walk.length_support]
      exact Nat.lt_succ_of_le hs_le
    have hget :
        T.path.walk.support.get ⟨r.1, hr_len⟩ =
          T.path.walk.support.get ⟨s.1, hs_len⟩ := by
      have hri :
          T.path.walk.getVert r.1 =
            T.path.walk.support.get ⟨r.1, hr_len⟩ := by
        simpa using T.path.walk.getVert_eq_support_getElem hr_le
      have hsi :
          T.path.walk.getVert s.1 =
            T.path.walk.support.get ⟨s.1, hs_len⟩ := by
        simpa using T.path.walk.getVert_eq_support_getElem hs_le
      rw [← hri, ← hsi]
      exact hrs
    have hfin :
        (⟨r.1, hr_len⟩ : Fin T.path.walk.support.length) =
          ⟨s.1, hs_len⟩ :=
      T.path.isPath.support_nodup.injective_get hget
    have hvals : r.1 = s.1 :=
      congrArg (fun x : Fin T.path.walk.support.length => x.val) hfin
    exact Fin.ext hvals
  consecutive_adj := by
    intro r
    have hcard :
        T.path.vertexSet.card = T.path.walk.support.length :=
      graphPath_vertexSet_card_eq_support_length T.path
    have hlen_card :
        T.path.vertexSet.card = T.path.walk.length + 1 := by
      rw [hcard, _root_.SimpleGraph.Walk.length_support]
    have hlarge_len : 8 * h + 1 ≤ T.path.walk.length + 1 := by
      simpa [hlen_card] using T.large
    have hr_lt : r.1 < T.path.walk.length := by
      have hr_succ_le : r.1 + 1 ≤ 8 * h := by
        exact Nat.succ_le_of_lt r.2
      have hpath_len : 8 * h ≤ T.path.walk.length := by
        omega
      omega
    change (linkageAuxGraph L).Adj (T.path.walk.getVert r.1)
      (T.path.walk.getVert (r.1 + 1))
    exact T.path.walk.adj_getVert_succ hr_lt
  degree_two := by
    intro r
    exact T.degree_two (T.path.walk.getVert r.1)
      (graphPath_getVert_mem_vertexSet T.path r.1)

/-- A bad linkage supplies the displayed indexed auxiliary prefix
`R* = (u_P0, ..., u_P8h)`. -/
theorem exists_indexedAuxiliaryPrefix_of_not_good
    {L : PerfectPathPacking G A B} {h : ℕ}
    (hbad : ¬ GoodLinkage L h) :
    Nonempty (IndexedAuxiliaryPrefix L h) := by
  rcases exists_initialLongTwoPath_of_not_good (L := L) hbad with ⟨T⟩
  exact ⟨T.toIndexedPrefix⟩

namespace IndexedAuxiliaryPrefix

variable {L : PerfectPathPacking G A B} {h : ℕ}

/-- The linkage index `P_0` from the displayed 2-path. -/
def p0Index (R : IndexedAuxiliaryPrefix L h) : L.Index :=
  R.index (p0Pos h)

/-- The linkage index `P_{z+1}`. -/
def pZPlusOneIndex (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h) :
    L.Index :=
  R.index (pZPlusOnePos h hpos)

/-- The linkage index `P_{2z}`. -/
def pTwoZIndex (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h) :
    L.Index :=
  R.index (pTwoZPos h hpos)

/-- The linkage index `P_{3z+1}`. -/
def pThreeZPlusOneIndex (R : IndexedAuxiliaryPrefix L h)
    (hpos : 0 < h) : L.Index :=
  R.index (pThreeZPlusOnePos h hpos)

/-- The displayed position with natural-number value `k`. -/
def posOfNat (_R : IndexedAuxiliaryPrefix L h) (k : ℕ)
    (hk : k < 8 * h + 1) : Fin (8 * h + 1) :=
  ⟨k, hk⟩

/-- The displayed linkage index with natural-number position `k`. -/
def indexAt (R : IndexedAuxiliaryPrefix L h) (k : ℕ)
    (hk : k < 8 * h + 1) : L.Index :=
  R.index (R.posOfNat k hk)

/-- Consecutive displayed vertices are adjacent in the auxiliary graph. -/
theorem adj_indexAt_succ (R : IndexedAuxiliaryPrefix L h)
    {k : ℕ} (hk : k < 8 * h) :
    (linkageAuxGraph L).Adj
      (R.indexAt k (by omega))
      (R.indexAt (k + 1) (by omega)) := by
  simpa [indexAt, posOfNat, edgeLeftPos, edgeRightPos] using
    R.consecutive_adj ⟨k, hk⟩

/-- Distinct displayed positions have distinct linkage indices. -/
theorem indexAt_ne_of_ne (R : IndexedAuxiliaryPrefix L h)
    {a b : ℕ} (ha : a < 8 * h + 1) (hb : b < 8 * h + 1)
    (hne : a ≠ b) :
    R.indexAt a ha ≠ R.indexAt b hb := by
  intro hidx
  have hpos : R.posOfNat a ha = R.posOfNat b hb :=
    R.index_injective hidx
  exact hne (congrArg Fin.val hpos)

/-- Equality of displayed linkage indices is equality of displayed numeric
positions. -/
theorem indexAt_eq_indexAt_iff (R : IndexedAuxiliaryPrefix L h)
    {a b : ℕ} (ha : a < 8 * h + 1) (hb : b < 8 * h + 1) :
    R.indexAt a ha = R.indexAt b hb ↔ a = b := by
  constructor
  · intro hidx
    by_contra hne
    exact R.indexAt_ne_of_ne ha hb hne hidx
  · intro h
    subst h
    rfl

/-- An interior displayed vertex has no auxiliary neighbor except the two
adjacent displayed vertices. -/
theorem neighbor_of_interior_indexAt (R : IndexedAuxiliaryPrefix L h)
    {k : ℕ} (hk0 : 0 < k) (hk8 : k < 8 * h)
    {j : L.Index}
    (hadj : (linkageAuxGraph L).Adj (R.indexAt k (by omega)) j) :
    j = R.indexAt (k - 1) (by omega) ∨
      j = R.indexAt (k + 1) (by omega) := by
  have hdeg : DegreeEquals (linkageAuxGraph L) (R.indexAt k (by omega)) 2 := by
    simpa [indexAt, posOfNat] using R.degree_two (R.posOfNat k (by omega))
  have hprev :
      (linkageAuxGraph L).Adj (R.indexAt k (by omega))
        (R.indexAt (k - 1) (by omega)) := by
    have h := R.adj_indexAt_succ (k := k - 1) (by omega)
    simpa [Nat.sub_add_cancel hk0] using h.symm
  have hnext :
      (linkageAuxGraph L).Adj (R.indexAt k (by omega))
        (R.indexAt (k + 1) (by omega)) :=
    R.adj_indexAt_succ (k := k) hk8
  have hprev_ne_next :
      R.indexAt (k - 1) (by omega) ≠ R.indexAt (k + 1) (by omega) := by
    exact R.indexAt_ne_of_ne (by omega) (by omega) (by omega)
  exact DegreeEquals.two_adj_eq_or_eq hdeg hprev hnext hprev_ne_next hadj

/-- A fixed second auxiliary neighbor of the first displayed vertex `P₀`.

Since `P₀` has degree two and is adjacent to `P₁`, this chooses its other
neighbor.  It may lie outside the displayed prefix; this is exactly the
outside neighbor needed at the lower boundary of the bump/cross loop. -/
noncomputable def p0OutsideIndex (R : IndexedAuxiliaryPrefix L h)
    (hpos : 0 < h) : L.Index :=
  Classical.choose
    (DegreeEquals.two_exists_adj_ne
      (G := linkageAuxGraph L)
      (v := R.p0Index)
      (a := R.indexAt 1 (by omega))
      (by simpa [p0Index] using R.degree_two (p0Pos h))
      (by
        have h := R.adj_indexAt_succ (k := 0) (by omega)
        simpa [p0Index, p0Pos, indexAt, posOfNat] using h))

/-- The chosen lower-boundary outside vertex is adjacent to `P₀`. -/
theorem p0_adj_outsideIndex (R : IndexedAuxiliaryPrefix L h)
    (hpos : 0 < h) :
    (linkageAuxGraph L).Adj R.p0Index (R.p0OutsideIndex hpos) :=
  (Classical.choose_spec
    (DegreeEquals.two_exists_adj_ne
      (G := linkageAuxGraph L)
      (v := R.p0Index)
      (a := R.indexAt 1 (by omega))
      (by simpa [p0Index] using R.degree_two (p0Pos h))
      (by
        have h := R.adj_indexAt_succ (k := 0) (by omega)
        simpa [p0Index, p0Pos, indexAt, posOfNat] using h))).1

/-- The chosen lower-boundary outside vertex is not `P₁`. -/
theorem p0OutsideIndex_ne_first (R : IndexedAuxiliaryPrefix L h)
    (hpos : 0 < h) :
    R.p0OutsideIndex hpos ≠ R.indexAt 1 (by omega) :=
  (Classical.choose_spec
    (DegreeEquals.two_exists_adj_ne
      (G := linkageAuxGraph L)
      (v := R.p0Index)
      (a := R.indexAt 1 (by omega))
      (by simpa [p0Index] using R.degree_two (p0Pos h))
      (by
        have h := R.adj_indexAt_succ (k := 0) (by omega)
        simpa [p0Index, p0Pos, indexAt, posOfNat] using h))).2

/-- The chosen lower-boundary outside vertex is not any later displayed
interior vertex. -/
theorem p0OutsideIndex_ne_indexAt (R : IndexedAuxiliaryPrefix L h)
    (hpos : 0 < h) {k : ℕ} (hk1 : 1 ≤ k) (hk8 : k < 8 * h) :
    R.p0OutsideIndex hpos ≠ R.indexAt k (by omega) := by
  classical
  by_cases hk : k = 1
  · subst k
    exact R.p0OutsideIndex_ne_first hpos
  intro hEq
  have hadj :
      (linkageAuxGraph L).Adj (R.indexAt k (by omega)) R.p0Index := by
    have h := R.p0_adj_outsideIndex hpos
    rw [hEq] at h
    exact h.symm
  rcases R.neighbor_of_interior_indexAt (k := k) (by omega) hk8 hadj
    with hprev | hnext
  · have hpos_eq : 0 = k - 1 := by
      exact (R.indexAt_eq_indexAt_iff (a := 0) (b := k - 1)
        (by omega) (by omega)).1 (by
          simpa [p0Index, p0Pos, indexAt, posOfNat] using hprev)
    omega
  · have hpos_eq : 0 = k + 1 := by
      exact (R.indexAt_eq_indexAt_iff (a := 0) (b := k + 1)
        (by omega) (by omega)).1 (by
          simpa [p0Index, p0Pos, indexAt, posOfNat] using hnext)
    omega

/-- A length-`z` window of linkage indices in the displayed auxiliary path. -/
noncomputable def windowIndexSet (R : IndexedAuxiliaryPrefix L h)
    (offset : ℕ) (hoff : offset + z h ≤ 8 * h + 1) : Finset L.Index :=
  Finset.univ.image fun i : Fin (z h) => R.index (windowPos h offset hoff i)

@[simp] theorem windowIndexSet_card (R : IndexedAuxiliaryPrefix L h)
    (offset : ℕ) (hoff : offset + z h ≤ 8 * h + 1) :
    (R.windowIndexSet offset hoff).card = z h := by
  classical
  have hinj :
      Function.Injective
        (fun i : Fin (z h) => R.index (windowPos h offset hoff i)) := by
    intro i j hij
    apply Fin.ext
    have hpos :
        windowPos h offset hoff i = windowPos h offset hoff j :=
      R.index_injective hij
    have hval := congrArg Fin.val hpos
    simp [windowPos] at hval
    omega
  rw [windowIndexSet, Finset.card_image_of_injective Finset.univ hinj]
  simp

/-- `P_1 = {P_1, ..., P_z}` in the proof. -/
noncomputable def block1IndexSet (R : IndexedAuxiliaryPrefix L h) :
    Finset L.Index :=
  R.windowIndexSet 1 (by
    dsimp [z]
    omega)

/-- `P_2 = {P_{z+1}, ..., P_{2z}}` in the proof. -/
noncomputable def block2IndexSet (R : IndexedAuxiliaryPrefix L h) :
    Finset L.Index :=
  R.windowIndexSet (z h + 1) (by
    dsimp [z]
    omega)

/-- `P_3 = {P_{2z+1}, ..., P_{3z}}` in the proof. -/
noncomputable def block3IndexSet (R : IndexedAuxiliaryPrefix L h) :
    Finset L.Index :=
  R.windowIndexSet (2 * z h + 1) (by
    dsimp [z]
    omega)

/-- `P_4 = {P_{3z+1}, ..., P_{4z}}` in the proof. -/
noncomputable def block4IndexSet (R : IndexedAuxiliaryPrefix L h) :
    Finset L.Index :=
  R.windowIndexSet (3 * z h + 1) (by
    dsimp [z]
    omega)

@[simp] theorem block1IndexSet_card (R : IndexedAuxiliaryPrefix L h) :
    R.block1IndexSet.card = z h := by
  simp [block1IndexSet]

@[simp] theorem block2IndexSet_card (R : IndexedAuxiliaryPrefix L h) :
    R.block2IndexSet.card = z h := by
  simp [block2IndexSet]

@[simp] theorem block3IndexSet_card (R : IndexedAuxiliaryPrefix L h) :
    R.block3IndexSet.card = z h := by
  simp [block3IndexSet]

@[simp] theorem block4IndexSet_card (R : IndexedAuxiliaryPrefix L h) :
    R.block4IndexSet.card = z h := by
  simp [block4IndexSet]

/-- Membership in the first displayed block, with the displayed position made
explicit. -/
theorem mem_block1IndexSet_iff (R : IndexedAuxiliaryPrefix L h)
    {j : L.Index} :
    j ∈ R.block1IndexSet ↔
      ∃ i : Fin (z h),
        j = R.index (windowPos h 1 (by
          dsimp [z]
          omega) i) := by
  classical
  constructor
  · intro hj
    rcases Finset.mem_image.mp hj with ⟨i, _hi, hji⟩
    exact ⟨i, hji.symm⟩
  · rintro ⟨i, rfl⟩
    exact Finset.mem_image.mpr ⟨i, by simp, rfl⟩

/-- Membership in the second displayed block. -/
theorem mem_block2IndexSet_iff (R : IndexedAuxiliaryPrefix L h)
    {j : L.Index} :
    j ∈ R.block2IndexSet ↔
      ∃ i : Fin (z h),
        j = R.index (windowPos h (z h + 1) (by
          dsimp [z]
          omega) i) := by
  classical
  constructor
  · intro hj
    rcases Finset.mem_image.mp hj with ⟨i, _hi, hji⟩
    exact ⟨i, hji.symm⟩
  · rintro ⟨i, rfl⟩
    exact Finset.mem_image.mpr ⟨i, by simp, rfl⟩

/-- Membership in the third displayed block. -/
theorem mem_block3IndexSet_iff (R : IndexedAuxiliaryPrefix L h)
    {j : L.Index} :
    j ∈ R.block3IndexSet ↔
      ∃ i : Fin (z h),
        j = R.index (windowPos h (2 * z h + 1) (by
          dsimp [z]
          omega) i) := by
  classical
  constructor
  · intro hj
    rcases Finset.mem_image.mp hj with ⟨i, _hi, hji⟩
    exact ⟨i, hji.symm⟩
  · rintro ⟨i, rfl⟩
    exact Finset.mem_image.mpr ⟨i, by simp, rfl⟩

/-- Membership in the fourth displayed block. -/
theorem mem_block4IndexSet_iff (R : IndexedAuxiliaryPrefix L h)
    {j : L.Index} :
    j ∈ R.block4IndexSet ↔
      ∃ i : Fin (z h),
        j = R.index (windowPos h (3 * z h + 1) (by
          dsimp [z]
          omega) i) := by
  classical
  constructor
  · intro hj
    rcases Finset.mem_image.mp hj with ⟨i, _hi, hji⟩
    exact ⟨i, hji.symm⟩
  · rintro ⟨i, rfl⟩
    exact Finset.mem_image.mpr ⟨i, by simp, rfl⟩

/-- `P_{z+1}` is the first path of the second block. -/
theorem pZPlusOneIndex_mem_block2 (R : IndexedAuxiliaryPrefix L h)
    (hpos : 0 < h) :
    R.pZPlusOneIndex hpos ∈ R.block2IndexSet := by
  classical
  rw [R.mem_block2IndexSet_iff]
  refine ⟨⟨0, by dsimp [z]; omega⟩, ?_⟩
  apply congrArg R.index
  apply Fin.ext
  simp [pZPlusOnePos, windowPos]

/-- `P_{2z}` is the last path of the second block. -/
theorem pTwoZIndex_mem_block2 (R : IndexedAuxiliaryPrefix L h)
    (hpos : 0 < h) :
    R.pTwoZIndex hpos ∈ R.block2IndexSet := by
  classical
  rw [R.mem_block2IndexSet_iff]
  refine ⟨⟨z h - 1, by dsimp [z]; omega⟩, ?_⟩
  apply congrArg R.index
  apply Fin.ext
  simp [pTwoZPos, windowPos]
  dsimp [z] at *
  omega

/-- `P_{3z+1}` is the first path of the fourth block. -/
theorem pThreeZPlusOneIndex_mem_block4
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h) :
    R.pThreeZPlusOneIndex hpos ∈ R.block4IndexSet := by
  classical
  rw [R.mem_block4IndexSet_iff]
  refine ⟨⟨0, by dsimp [z]; omega⟩, ?_⟩
  apply congrArg R.index
  apply Fin.ext
  simp [pThreeZPlusOnePos, windowPos]

/-- The `i`-th member of the first block is displayed at position `1+i`. -/
theorem block1_index_eq_indexAt (R : IndexedAuxiliaryPrefix L h)
    (i : Fin (z h)) :
    R.index (windowPos h 1 (by dsimp [z]; omega) i) =
      R.indexAt (1 + i.1) (by
        have hi : i.1 < z h := i.2
        dsimp [z] at hi ⊢
        omega) := by
  rfl

/-- The `i`-th member of the second block is displayed at position
`z+1+i`. -/
theorem block2_index_eq_indexAt (R : IndexedAuxiliaryPrefix L h)
    (i : Fin (z h)) :
    R.index (windowPos h (z h + 1) (by dsimp [z]; omega) i) =
      R.indexAt (z h + 1 + i.1) (by
        have hi : i.1 < z h := i.2
        dsimp [z] at hi ⊢
        omega) := by
  rfl

/-- The `i`-th member of the third block is displayed at position
`2z+1+i`. -/
theorem block3_index_eq_indexAt (R : IndexedAuxiliaryPrefix L h)
    (i : Fin (z h)) :
    R.index (windowPos h (2 * z h + 1) (by dsimp [z]; omega) i) =
      R.indexAt (2 * z h + 1 + i.1) (by
        have hi : i.1 < z h := i.2
        dsimp [z] at hi ⊢
        omega) := by
  rfl

/-- The `i`-th member of the fourth block is displayed at position
`3z+1+i`. -/
theorem block4_index_eq_indexAt (R : IndexedAuxiliaryPrefix L h)
    (i : Fin (z h)) :
    R.index (windowPos h (3 * z h + 1) (by dsimp [z]; omega) i) =
      R.indexAt (3 * z h + 1 + i.1) (by
        have hi : i.1 < z h := i.2
        dsimp [z] at hi ⊢
        omega) := by
  rfl

/-- A displayed position whose index lies in `P₂` has numeric position between
`z+1` and `2z`. -/
theorem indexAt_mem_block2_position_range
    (R : IndexedAuxiliaryPrefix L h)
    {k : ℕ} (hk : k < 8 * h + 1)
    (hmem : R.indexAt k hk ∈ R.block2IndexSet) :
    z h + 1 ≤ k ∧ k ≤ 2 * z h := by
  classical
  rw [R.mem_block2IndexSet_iff] at hmem
  rcases hmem with ⟨i, hi⟩
  have hpos :
      R.posOfNat k hk =
        windowPos h (z h + 1) (by dsimp [z]; omega) i := by
    apply R.index_injective
    simpa [indexAt] using hi
  have hval := congrArg Fin.val hpos
  simp [posOfNat, windowPos] at hval
  have hi_lt : i.1 < z h := i.2
  omega

/-- A displayed position whose index lies in `P₁` has numeric position between
`1` and `z`. -/
theorem indexAt_mem_block1_position_range
    (R : IndexedAuxiliaryPrefix L h)
    {k : ℕ} (hk : k < 8 * h + 1)
    (hmem : R.indexAt k hk ∈ R.block1IndexSet) :
    1 ≤ k ∧ k ≤ z h := by
  classical
  rw [R.mem_block1IndexSet_iff] at hmem
  rcases hmem with ⟨i, hi⟩
  have hpos :
      R.posOfNat k hk =
        windowPos h 1 (by dsimp [z]; omega) i := by
    apply R.index_injective
    simpa [indexAt] using hi
  have hval := congrArg Fin.val hpos
  simp [posOfNat, windowPos] at hval
  have hi_lt : i.1 < z h := i.2
  omega

/-- A displayed position whose index lies in `P₃` has numeric position between
`2z+1` and `3z`. -/
theorem indexAt_mem_block3_position_range
    (R : IndexedAuxiliaryPrefix L h)
    {k : ℕ} (hk : k < 8 * h + 1)
    (hmem : R.indexAt k hk ∈ R.block3IndexSet) :
    2 * z h + 1 ≤ k ∧ k ≤ 3 * z h := by
  classical
  rw [R.mem_block3IndexSet_iff] at hmem
  rcases hmem with ⟨i, hi⟩
  have hpos :
      R.posOfNat k hk =
        windowPos h (2 * z h + 1) (by dsimp [z]; omega) i := by
    apply R.index_injective
    simpa [indexAt] using hi
  have hval := congrArg Fin.val hpos
  simp [posOfNat, windowPos] at hval
  have hi_lt : i.1 < z h := i.2
  omega

/-- A displayed position whose index lies in `P₄` has numeric position at least
`3z+1`. -/
theorem indexAt_mem_block4_position_lower
    (R : IndexedAuxiliaryPrefix L h)
    {k : ℕ} (hk : k < 8 * h + 1)
    (hmem : R.indexAt k hk ∈ R.block4IndexSet) :
    3 * z h + 1 ≤ k := by
  classical
  rw [R.mem_block4IndexSet_iff] at hmem
  rcases hmem with ⟨i, hi⟩
  have hpos :
      R.posOfNat k hk =
        windowPos h (3 * z h + 1) (by dsimp [z]; omega) i := by
    apply R.index_injective
    simpa [indexAt] using hi
  have hval := congrArg Fin.val hpos
  simp [posOfNat, windowPos] at hval
  omega

/-- Formal version of the paper's observation that `P_0 ∉ P_1`. -/
theorem p0Index_not_mem_block1 (R : IndexedAuxiliaryPrefix L h) :
    R.p0Index ∉ R.block1IndexSet := by
  classical
  intro hmem
  rcases Finset.mem_image.mp hmem with ⟨i, _hi, hi⟩
  have hpos : windowPos h 1 (by
      dsimp [z]
      omega) i = p0Pos h := by
    exact R.index_injective hi
  have hval := congrArg Fin.val hpos
  simp [windowPos, p0Pos] at hval

/-- The proof later uses that `u_P0` is a degree-two vertex in `H(L)`. -/
theorem p0Index_degree_two (R : IndexedAuxiliaryPrefix L h) :
    DegreeEquals (linkageAuxGraph L) R.p0Index 2 :=
  R.degree_two (p0Pos h)

/-- The displayed paths `P_0` and `P_{z+1}` are distinct. -/
theorem p0Index_ne_pZPlusOneIndex (R : IndexedAuxiliaryPrefix L h)
    (hpos : 0 < h) :
    R.p0Index ≠ R.pZPlusOneIndex hpos := by
  dsimp [p0Index, pZPlusOneIndex, p0Pos, pZPlusOnePos]
  exact R.indexAt_ne_of_ne (by dsimp [z]; omega) (by dsimp [z]; omega)
    (by dsimp [z]; omega)

/-- The displayed paths `P_{2z}` and `P_{3z+1}` are distinct. -/
theorem pTwoZIndex_ne_pThreeZPlusOneIndex
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h) :
    R.pTwoZIndex hpos ≠ R.pThreeZPlusOneIndex hpos := by
  dsimp [pTwoZIndex, pThreeZPlusOneIndex, pTwoZPos, pThreeZPlusOnePos]
  exact R.indexAt_ne_of_ne (by dsimp [z]; omega) (by dsimp [z]; omega)
    (by dsimp [z]; omega)

/-- The two middle-boundary linkage paths `P_{z+1}` and `P_{2z}` are
distinct. -/
theorem pZPlusOneIndex_ne_pTwoZIndex
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h) :
    R.pZPlusOneIndex hpos ≠ R.pTwoZIndex hpos := by
  dsimp [pZPlusOneIndex, pTwoZIndex, pZPlusOnePos, pTwoZPos]
  exact R.indexAt_ne_of_ne (by dsimp [z]; omega) (by dsimp [z]; omega)
    (by dsimp [z]; omega)

/-- The set `X ⊆ A` of `A`-endpoints of the paths in `P_2`. -/
noncomputable def X (R : IndexedAuxiliaryPrefix L h) : Finset V :=
  L.sourceSet R.block2IndexSet

/-- The set `Y ⊆ B` of `B`-endpoints of the paths in `P_4`. -/
noncomputable def Y (R : IndexedAuxiliaryPrefix L h) : Finset V :=
  L.targetSet R.block4IndexSet

theorem X_subset_A (R : IndexedAuxiliaryPrefix L h) :
    R.X ⊆ A := by
  simpa [X] using L.sourceSet_subset_left R.block2IndexSet

theorem Y_subset_B (R : IndexedAuxiliaryPrefix L h) :
    R.Y ⊆ B := by
  simpa [Y] using L.targetSet_subset_right R.block4IndexSet

/-- Linkedness of the original terminal sets makes the derived endpoint sets
`X` and `Y` disjoint.  This is the formal reason the transversal paths chosen
in the first paragraph are nontrivial. -/
theorem X_disjoint_Y [Fintype V] (R : IndexedAuxiliaryPrefix L h)
    (hlink : NodeLinkedIn G Finset.univ A B) :
    Disjoint R.X R.Y :=
  (NodeLinkedIn.mono_terminals hlink R.X_subset_A R.Y_subset_B).2.2.1

/-- A transversal path from `X` to `Y` has distinct endpoints, because
`X ∩ Y = ∅`. -/
theorem transversal_source_ne_target [Fintype V]
    (R : IndexedAuxiliaryPrefix L h)
    (hlink : NodeLinkedIn G Finset.univ A B)
    {Q : PerfectPathPacking G R.X R.Y} (i : Q.Index) :
    (Q.path i).source ≠ (Q.path i).target := by
  intro hst
  have hx : (Q.path i).source ∈ R.X := Q.source_mem i
  have hy : (Q.path i).source ∈ R.Y := by
    simpa [hst] using Q.target_mem i
  exact Finset.disjoint_left.mp (R.X_disjoint_Y hlink) hx hy

@[simp] theorem X_card (R : IndexedAuxiliaryPrefix L h) :
    R.X.card = z h := by
  simp [X]

@[simp] theorem Y_card (R : IndexedAuxiliaryPrefix L h) :
    R.Y.card = z h := by
  simp [Y]

theorem X_card_eq_Y_card (R : IndexedAuxiliaryPrefix L h) :
    R.X.card = R.Y.card := by
  simp

/-- The first paragraph's invocation of linkedness: there is a family `Q` of
`z` disjoint paths connecting `X` to `Y` in `G`, oriented from `X` to `Y`. -/
theorem exists_transversal_packing [Fintype V] (R : IndexedAuxiliaryPrefix L h)
    (hlink : NodeLinkedIn G Finset.univ A B) :
    ∃ Q : PerfectPathPacking G R.X R.Y,
      Q.card = z h ∧ Q.toPathPacking.StaysIn Finset.univ := by
  classical
  rcases NodeLinkedIn.exists_perfectPathPacking_of_card_eq
      (NodeLinkedIn.mono_terminals hlink R.X_subset_A R.Y_subset_B)
      R.X_card_eq_Y_card with ⟨Q, hQcard, hQstay⟩
  exact ⟨Q, by simpa using hQcard, hQstay⟩

/-- The complete formal content of the first paragraph of the proof: from a
bad linkage and linked terminal sets, choose the displayed auxiliary prefix
`R*`, form the four blocks and endpoint sets `X,Y`, and obtain `z` disjoint
paths from `X` to `Y`. -/
theorem exists_firstParagraph_setup [Fintype V]
    {L : PerfectPathPacking G A B} {h : ℕ}
    (hbad : ¬ GoodLinkage L h)
    (hlink : NodeLinkedIn G Finset.univ A B) :
    ∃ R : IndexedAuxiliaryPrefix L h,
      ∃ Q : PerfectPathPacking G R.X R.Y,
        Q.card = z h ∧ Q.toPathPacking.StaysIn Finset.univ := by
  rcases exists_indexedAuxiliaryPrefix_of_not_good (L := L) hbad with ⟨R⟩
  rcases R.exists_transversal_packing hlink with ⟨Q, hQcard, hQstay⟩
  exact ⟨R, Q, hQcard, hQstay⟩


/-- A single graph path meets the linkage path indexed by `i`. -/
def HitsLinkagePath (Q : GraphPath G) (i : L.Index) : Prop :=
  (Q.vertexSet ∩ (L.path i).vertexSet).Nonempty

/-- Hitting a linkage path is monotone under enlarging the left path. -/
theorem HitsLinkagePath.mono_left {Q Q' : GraphPath G} {i : L.Index}
    (hsub : Q.vertexSet ⊆ Q'.vertexSet) (h : HitsLinkagePath (L := L) Q i) :
    HitsLinkagePath (L := L) Q' i := by
  rcases h with ⟨v, hv⟩
  exact ⟨v, Finset.mem_inter.2
    ⟨hsub (Finset.mem_inter.1 hv).1, (Finset.mem_inter.1 hv).2⟩⟩

/-- A single graph path meets another graph path. -/
def HitsGraphPath (Q P : GraphPath G) : Prop :=
  (Q.vertexSet ∩ P.vertexSet).Nonempty

/-- Hitting a graph path is monotone under enlarging the left path. -/
theorem HitsGraphPath.mono_left {Q Q' P : GraphPath G}
    (hsub : Q.vertexSet ⊆ Q'.vertexSet) (h : HitsGraphPath Q P) :
    HitsGraphPath Q' P := by
  rcases h with ⟨v, hv⟩
  exact ⟨v, Finset.mem_inter.2
    ⟨hsub (Finset.mem_inter.1 hv).1, (Finset.mem_inter.1 hv).2⟩⟩

/-- A vertex in the vertex set of a linkage lies on a unique linkage path. -/
theorem exists_unique_linkageIndex_of_mem_vertexSet
    {v : V} (hv : v ∈ L.toPathPacking.vertexSet) :
    ∃! i : L.Index, v ∈ (L.path i).vertexSet := by
  classical
  rcases (L.toPathPacking.mem_vertexSet).1 hv with ⟨i, hvi⟩
  refine ⟨i, hvi, ?_⟩
  intro j hvj
  by_contra hne
  have hne' : i ≠ j := fun hij => hne hij.symm
  have hdisj :
      Disjoint (L.path i).vertexSet (L.path j).vertexSet :=
    L.toPathPacking.node_disjoint hne'
  exact Finset.disjoint_left.mp hdisj hvi hvj

/-- The linkage index containing a specified linkage vertex. -/
noncomputable def linkageIndexOfVertex
    (v : V) (hv : v ∈ L.toPathPacking.vertexSet) : L.Index :=
  Classical.choose (exists_unique_linkageIndex_of_mem_vertexSet (L := L) hv)

theorem linkageIndexOfVertex_mem
    {v : V} (hv : v ∈ L.toPathPacking.vertexSet) :
    v ∈ (L.path (linkageIndexOfVertex (L := L) v hv)).vertexSet :=
  (Classical.choose_spec
    (exists_unique_linkageIndex_of_mem_vertexSet (L := L) hv)).1

theorem linkageIndexOfVertex_eq_of_mem
    {v : V} (hv : v ∈ L.toPathPacking.vertexSet)
    {i : L.Index} (hvi : v ∈ (L.path i).vertexSet) :
    linkageIndexOfVertex (L := L) v hv = i :=
  ((Classical.choose_spec
    (exists_unique_linkageIndex_of_mem_vertexSet (L := L) hv)).2 i hvi).symm

/-- Distinct paths of a linkage are vertex-disjoint, in pointwise form. -/
theorem not_mem_linkage_path_of_mem_other
    {i j : L.Index} (hne : i ≠ j) {v : V}
    (hvi : v ∈ (L.path i).vertexSet) :
    v ∉ (L.path j).vertexSet := by
  intro hvj
  exact Finset.disjoint_left.mp (L.toPathPacking.node_disjoint hne)
    hvi hvj

/-- A vertex on `P_{z+1}` is not on `P_0`. -/
theorem not_mem_p0Index_of_mem_pZPlusOneIndex
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {v : V}
    (hv : v ∈ (L.path (R.pZPlusOneIndex hpos)).vertexSet) :
    v ∉ (L.path R.p0Index).vertexSet :=
  not_mem_linkage_path_of_mem_other
    (L := L) (R.p0Index_ne_pZPlusOneIndex hpos).symm hv

/-- A vertex on `P_0` is not on `P_{z+1}`. -/
theorem not_mem_pZPlusOneIndex_of_mem_p0Index
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {v : V}
    (hv : v ∈ (L.path R.p0Index).vertexSet) :
    v ∉ (L.path (R.pZPlusOneIndex hpos)).vertexSet :=
  not_mem_linkage_path_of_mem_other
    (L := L) (R.p0Index_ne_pZPlusOneIndex hpos) hv

/-- A vertex on `P_{2z}` is not on `P_{3z+1}`. -/
theorem not_mem_pThreeZPlusOneIndex_of_mem_pTwoZIndex
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {v : V}
    (hv : v ∈ (L.path (R.pTwoZIndex hpos)).vertexSet) :
    v ∉ (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet :=
  not_mem_linkage_path_of_mem_other
    (L := L) (R.pTwoZIndex_ne_pThreeZPlusOneIndex hpos) hv

/-- A vertex on `P_{3z+1}` is not on `P_{2z}`. -/
theorem not_mem_pTwoZIndex_of_mem_pThreeZPlusOneIndex
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {v : V}
    (hv : v ∈ (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet) :
    v ∉ (L.path (R.pTwoZIndex hpos)).vertexSet :=
  not_mem_linkage_path_of_mem_other
    (L := L) (R.pTwoZIndex_ne_pThreeZPlusOneIndex hpos).symm hv

/-- A transversal path from `X` starts on one of the linkage paths in `P_2`. -/
theorem transversal_source_hits_block2
    {R : IndexedAuxiliaryPrefix L h}
    {Qpack : PerfectPathPacking G R.X R.Y} (q : Qpack.Index) :
    ∃ j : L.Index, j ∈ R.block2IndexSet ∧
      (Qpack.path q).source ∈ (L.path j).vertexSet := by
  classical
  have hsource : (Qpack.path q).source ∈ R.X := Qpack.source_mem q
  change (Qpack.path q).source ∈ L.sourceSet R.block2IndexSet at hsource
  rw [PerfectPathPacking.sourceSet] at hsource
  rcases Finset.mem_image.mp hsource with ⟨j, hj, hsrc⟩
  exact ⟨j, hj, by
    rw [← hsrc]
    exact GraphPath.source_mem_vertexSet (L.path j)⟩

/-- A transversal path to `Y` ends on one of the linkage paths in `P_4`. -/
theorem transversal_target_hits_block4
    {R : IndexedAuxiliaryPrefix L h}
    {Qpack : PerfectPathPacking G R.X R.Y} (q : Qpack.Index) :
    ∃ j : L.Index, j ∈ R.block4IndexSet ∧
      (Qpack.path q).target ∈ (L.path j).vertexSet := by
  classical
  have htarget : (Qpack.path q).target ∈ R.Y := Qpack.target_mem q
  change (Qpack.path q).target ∈ L.targetSet R.block4IndexSet at htarget
  rw [PerfectPathPacking.targetSet] at htarget
  rcases Finset.mem_image.mp htarget with ⟨j, hj, htgt⟩
  exact ⟨j, hj, by
    rw [← htgt]
    exact GraphPath.target_mem_vertexSet (L.path j)⟩

/-- A clean graph segment between two linkage paths gives the corresponding
auxiliary edge, unless both endpoints lie on the same linkage path. -/
theorem aux_adj_or_eq_of_clean_segment
    {i j : L.Index} (P : GraphPath G)
    (hsource : P.source ∈ (L.path i).vertexSet)
    (htarget : P.target ∈ (L.path j).vertexSet)
    (hclean : P.InternallyDisjointFromSet L.toPathPacking.vertexSet) :
    i = j ∨ (linkageAuxGraph L).Adj i j := by
  by_cases hij : i = j
  · exact Or.inl hij
  · right
    refine ⟨hij, Or.inl ?_⟩
    exact ⟨PathPacking.BridgeBetween.of_orientedPath L.toPathPacking P
      hsource htarget hclean⟩

/-- An endpoint-clean segment of a path cannot meet a linkage path that
contains neither endpoint. -/
theorem disjoint_linkage_path_of_internallyDisjointFromSet
    {j : L.Index} (P : GraphPath G)
    (hclean : P.InternallyDisjointFromSet L.toPathPacking.vertexSet)
    (hsource : P.source ∉ (L.path j).vertexSet)
    (htarget : P.target ∉ (L.path j).vertexSet) :
    Disjoint P.vertexSet (L.path j).vertexSet := by
  rw [Finset.disjoint_left]
  intro v hvP hvj
  have hvPack : v ∈ L.toPathPacking.vertexSet :=
    (L.toPathPacking.mem_vertexSet).2 ⟨j, hvj⟩
  rcases hclean hvP hvPack with rfl | rfl
  · exact hsource hvj
  · exact htarget hvj

/-- If an endpoint-clean segment starts on linkage path `j` and its other
endpoint is not on `j`, then its intersection with `j` is exactly its source. -/
theorem inter_linkage_path_eq_singleton_source_of_internallyDisjointFromSet
    {j : L.Index} (P : GraphPath G)
    (hclean : P.InternallyDisjointFromSet L.toPathPacking.vertexSet)
    (hsource : P.source ∈ (L.path j).vertexSet)
    (htarget : P.target ∉ (L.path j).vertexSet) :
    P.vertexSet ∩ (L.path j).vertexSet = {P.source} := by
  classical
  ext v
  constructor
  · intro hv
    rcases Finset.mem_inter.1 hv with ⟨hvP, hvj⟩
    have hvPack : v ∈ L.toPathPacking.vertexSet :=
      (L.toPathPacking.mem_vertexSet).2 ⟨j, hvj⟩
    rcases hclean hvP hvPack with rfl | rfl
    · simp
    · exact False.elim (htarget hvj)
  · intro hv
    have hvsrc : v = P.source := by simpa using hv
    subst hvsrc
    exact Finset.mem_inter.2 ⟨GraphPath.source_mem_vertexSet P, hsource⟩

/-- If an endpoint-clean segment ends on linkage path `j` and its source is
not on `j`, then its intersection with `j` is exactly its target. -/
theorem inter_linkage_path_eq_singleton_target_of_internallyDisjointFromSet
    {j : L.Index} (P : GraphPath G)
    (hclean : P.InternallyDisjointFromSet L.toPathPacking.vertexSet)
    (hsource : P.source ∉ (L.path j).vertexSet)
    (htarget : P.target ∈ (L.path j).vertexSet) :
    P.vertexSet ∩ (L.path j).vertexSet = {P.target} := by
  classical
  ext v
  constructor
  · intro hv
    rcases Finset.mem_inter.1 hv with ⟨hvP, hvj⟩
    have hvPack : v ∈ L.toPathPacking.vertexSet :=
      (L.toPathPacking.mem_vertexSet).2 ⟨j, hvj⟩
    rcases hclean hvP hvPack with rfl | rfl
    · exact False.elim (hsource hvj)
    · simp
  · intro hv
    have hvtgt : v = P.target := by simpa using hv
    subst hvtgt
    exact Finset.mem_inter.2 ⟨GraphPath.target_mem_vertexSet P, htarget⟩

/-- Cardinal form of
`inter_linkage_path_eq_singleton_source_of_internallyDisjointFromSet`. -/
theorem inter_linkage_path_card_eq_one_source_of_internallyDisjointFromSet
    {j : L.Index} (P : GraphPath G)
    (hclean : P.InternallyDisjointFromSet L.toPathPacking.vertexSet)
    (hsource : P.source ∈ (L.path j).vertexSet)
    (htarget : P.target ∉ (L.path j).vertexSet) :
    (P.vertexSet ∩ (L.path j).vertexSet).card = 1 := by
  classical
  rw [inter_linkage_path_eq_singleton_source_of_internallyDisjointFromSet
    (L := L) P hclean hsource htarget]
  simp

/-- Cardinal form of
`inter_linkage_path_eq_singleton_target_of_internallyDisjointFromSet`. -/
theorem inter_linkage_path_card_eq_one_target_of_internallyDisjointFromSet
    {j : L.Index} (P : GraphPath G)
    (hclean : P.InternallyDisjointFromSet L.toPathPacking.vertexSet)
    (hsource : P.source ∉ (L.path j).vertexSet)
    (htarget : P.target ∈ (L.path j).vertexSet) :
    (P.vertexSet ∩ (L.path j).vertexSet).card = 1 := by
  classical
  rw [inter_linkage_path_eq_singleton_target_of_internallyDisjointFromSet
    (L := L) P hclean hsource htarget]
  simp

/-- A finite sequence of linkage contacts encountered along one transversal
path.  Consecutive contacts either lie on the same linkage path or determine an
edge of the linkage auxiliary graph; this is the finite trace extracted from
the original graph path before applying the 2-path argument in `H(L)`. -/
structure LinkageContactTrace (R : IndexedAuxiliaryPrefix L h)
    (Q : GraphPath G) where
  len : ℕ
  contact : Fin (len + 1) → V
  index : Fin (len + 1) → L.Index
  contact_mem_Q : ∀ r, contact r ∈ Q.vertexSet
  contact_mem_linkage : ∀ r, contact r ∈ (L.path (index r)).vertexSet
  first_contact_eq_source : contact ⟨0, by omega⟩ = Q.source
  last_contact_eq_target : contact ⟨len, by omega⟩ = Q.target
  contact_monotone : ∀ r : Fin len,
    Q.Before (contact ⟨r.1, by omega⟩) (contact ⟨r.1 + 1, by omega⟩)
  consecutive_aux_step : ∀ r : Fin len,
    index ⟨r.1, by omega⟩ = index ⟨r.1 + 1, by omega⟩ ∨
      (linkageAuxGraph L).Adj
        (index ⟨r.1, by omega⟩) (index ⟨r.1 + 1, by omega⟩)

/-- A complete linkage-contact trace remembers that consecutive contacts are
consecutive *as linkage contacts* along the underlying graph path: the segment
between them has no internal vertex on any linkage path.  This is the
formalized content behind the informal phrase that the original transversal
path induces a walk in the auxiliary graph `H(L)`.

The base `LinkageContactTrace` is enough for finite auxiliary-position
arguments.  The extra field here is the API needed to turn such an auxiliary
argument back into the actual `Q*` subpath with the advertised avoidance
properties. -/
structure CompleteLinkageContactTrace (R : IndexedAuxiliaryPrefix L h)
    (Q : GraphPath G) extends LinkageContactTrace R Q where
  contact_complete : ∀ ⦃v : V⦄,
    v ∈ Q.vertexSet → v ∈ L.toPathPacking.vertexSet →
      ∃ r : Fin (len + 1), contact r = v
  contact_before_iff_le : ∀ r s : Fin (len + 1),
    Q.Before (contact r) (contact s) ↔ r.1 ≤ s.1
  consecutive_clean : ∀ r : Fin len,
    (Q.segmentOfBefore (contact_monotone r)).InternallyDisjointFromSet
      L.toPathPacking.vertexSet

/-- The linkage-contact vertices of a graph path, in their order along the
path support.  This is the concrete list from which a complete contact trace
will be built: consecutive entries of this filtered list have no linkage
vertices strictly between them on the original path. -/
noncomputable def linkageContactVertexList
    (L : PerfectPathPacking G A B) (Q : GraphPath G) : List V :=
  Q.walk.support.filter fun v => v ∈ L.toPathPacking.vertexSet

theorem mem_linkageContactVertexList_iff
    (L : PerfectPathPacking G A B) (Q : GraphPath G) {v : V} :
    v ∈ linkageContactVertexList L Q ↔
      v ∈ Q.vertexSet ∧ v ∈ L.toPathPacking.vertexSet := by
  classical
  simp [linkageContactVertexList, GraphPath.vertexSet]

/-- If the source of `Q` is on the linkage, the contact list is nonempty. -/
theorem linkageContactVertexList_nonempty_of_source_mem
    (L : PerfectPathPacking G A B) (Q : GraphPath G)
    (hsource : Q.source ∈ L.toPathPacking.vertexSet) :
    (linkageContactVertexList L Q).length > 0 := by
  classical
  have hmem : Q.source ∈ linkageContactVertexList L Q := by
    rw [mem_linkageContactVertexList_iff]
    exact ⟨GraphPath.source_mem_vertexSet Q, hsource⟩
  exact List.length_pos_of_mem hmem

/-- If the target of `Q` is on the linkage, the contact list is nonempty. -/
theorem linkageContactVertexList_nonempty_of_target_mem
    (L : PerfectPathPacking G A B) (Q : GraphPath G)
    (htarget : Q.target ∈ L.toPathPacking.vertexSet) :
    (linkageContactVertexList L Q).length > 0 := by
  classical
  have hmem : Q.target ∈ linkageContactVertexList L Q := by
    rw [mem_linkageContactVertexList_iff]
    exact ⟨GraphPath.target_mem_vertexSet Q, htarget⟩
  exact List.length_pos_of_mem hmem

/-- Internal linkage-contact vertices of a path, obtained by removing the two
endpoints from the path support before filtering.  The eventual contact trace
is easier to build from
`source :: internalLinkageContactVertexList ++ [target]`, because the first and
last contacts are then definitionally the endpoints required by
`LinkageContactTrace`. -/
noncomputable def internalLinkageContactVertexList
    (L : PerfectPathPacking G A B) (Q : GraphPath G) : List V :=
  Q.walk.support.tail.dropLast.filter fun v => v ∈ L.toPathPacking.vertexSet

/-- Endpoint-padded linkage-contact list.  This list may contain the same
vertex twice for a length-zero path, which is harmless for the auxiliary trace:
the corresponding consecutive auxiliary step is a stutter. -/
noncomputable def endpointContactVertexList
    (L : PerfectPathPacking G A B) (Q : GraphPath G) : List V :=
  Q.source :: internalLinkageContactVertexList L Q ++ [Q.target]

@[simp] theorem endpointContactVertexList_length
    (L : PerfectPathPacking G A B) (Q : GraphPath G) :
    (endpointContactVertexList L Q).length =
      (internalLinkageContactVertexList L Q).length + 2 := by
  simp [endpointContactVertexList]

@[simp] theorem endpointContactVertexList_get_zero
    (L : PerfectPathPacking G A B) (Q : GraphPath G) :
    (endpointContactVertexList L Q).get ⟨0, by simp [endpointContactVertexList]⟩ =
      Q.source := by
  simp [endpointContactVertexList]

theorem endpointContactVertexList_get_last
    (L : PerfectPathPacking G A B) (Q : GraphPath G) :
    (endpointContactVertexList L Q).get
        ⟨(endpointContactVertexList L Q).length - 1, by
          simp [endpointContactVertexList]⟩ =
      Q.target := by
  classical
  simp [endpointContactVertexList]

/-- Every endpoint-padded contact vertex lies on the original graph path. -/
theorem mem_endpointContactVertexList_imp_mem_path
    (L : PerfectPathPacking G A B) (Q : GraphPath G) {v : V}
    (hv : v ∈ endpointContactVertexList L Q) :
    v ∈ Q.vertexSet := by
  classical
  simp [endpointContactVertexList, internalLinkageContactVertexList] at hv
  rcases hv with rfl | hv | rfl
  · exact GraphPath.source_mem_vertexSet Q
  · have hvSupport : v ∈ Q.walk.support := by
      exact List.mem_of_mem_tail (List.mem_of_mem_dropLast hv.1)
    simpa [GraphPath.vertexSet] using hvSupport
  · exact GraphPath.target_mem_vertexSet Q

/-- Every endpoint-padded contact vertex lies on the linkage, provided the two
endpoints do. -/
theorem mem_endpointContactVertexList_imp_mem_linkage
    (L : PerfectPathPacking G A B) (Q : GraphPath G)
    (hsource : Q.source ∈ L.toPathPacking.vertexSet)
    (htarget : Q.target ∈ L.toPathPacking.vertexSet) {v : V}
    (hv : v ∈ endpointContactVertexList L Q) :
    v ∈ L.toPathPacking.vertexSet := by
  classical
  simp [endpointContactVertexList, internalLinkageContactVertexList] at hv
  rcases hv with rfl | hv | rfl
  · exact hsource
  · exact hv.2
  · exact htarget

omit [DecidableEq V] in
/-- The last vertex of the support tail of a nontrivial graph path is the
target of the path. -/
theorem graphPath_support_tail_getLast_eq_target
    (Q : GraphPath G) (htail : Q.walk.support.tail ≠ []) :
    Q.walk.support.tail.getLast htail = Q.target := by
  have hsupport_cons :
      Q.walk.support =
        Q.walk.support.head Q.walk.support_ne_nil :: Q.walk.support.tail :=
    (List.cons_head_tail Q.walk.support_ne_nil).symm
  have hlast := _root_.SimpleGraph.Walk.getLast_support Q.walk
  have hcons_ne :
      Q.walk.support.head Q.walk.support_ne_nil :: Q.walk.support.tail ≠ [] :=
    List.cons_ne_nil _ _
  have hlast_cons :
      (Q.walk.support.head Q.walk.support_ne_nil ::
          Q.walk.support.tail).getLast hcons_ne = Q.target := by
    have hcongr :
        (Q.walk.support.head Q.walk.support_ne_nil ::
            Q.walk.support.tail).getLast hcons_ne =
          Q.walk.support.getLast Q.walk.support_ne_nil :=
      List.getLast_congr hcons_ne Q.walk.support_ne_nil hsupport_cons.symm
    exact hcongr.trans hlast
  rw [List.getLast_cons] at hlast_cons
  exact hlast_cons

/-- A path vertex distinct from both endpoints lies in the middle support list
`support.tail.dropLast`. -/
theorem mem_support_tail_dropLast_of_mem_vertexSet_of_ne_endpoints
    (Q : GraphPath G) {v : V}
    (hvQ : v ∈ Q.vertexSet) (hsource : v ≠ Q.source)
    (htarget : v ≠ Q.target) :
    v ∈ Q.walk.support.tail.dropLast := by
  classical
  have hvSupport : v ∈ Q.walk.support := by
    simpa [GraphPath.vertexSet] using hvQ
  have hsupport_cons :
      Q.walk.support = Q.source :: Q.walk.support.tail := by
    calc
      Q.walk.support =
          Q.walk.support.head Q.walk.support_ne_nil :: Q.walk.support.tail := by
            exact (List.cons_head_tail Q.walk.support_ne_nil).symm
      _ = Q.source :: Q.walk.support.tail := by
            simp [_root_.SimpleGraph.Walk.head_support Q.walk]
  have hvTail : v ∈ Q.walk.support.tail := by
    have hvCons : v ∈ Q.source :: Q.walk.support.tail := by
      rw [← hsupport_cons]
      exact hvSupport
    simp only [List.mem_cons] at hvCons
    rcases hvCons with hvSource | hvTail
    · exact False.elim (hsource hvSource)
    · exact hvTail
  have htail_ne : Q.walk.support.tail ≠ [] := List.ne_nil_of_mem hvTail
  have hlast_tail :
      Q.walk.support.tail.getLast htail_ne = Q.target :=
    graphPath_support_tail_getLast_eq_target Q htail_ne
  exact List.mem_dropLast_of_mem_of_ne_getLast hvTail (by
    rw [hlast_tail]
    exact htarget)

/-- Conversely to `mem_endpointContactVertexList_imp_mem_linkage`, every
vertex of the path that lies on the linkage appears in the endpoint-padded
contact list. -/
theorem mem_endpointContactVertexList_of_mem_path_of_mem_linkage
    (L : PerfectPathPacking G A B) (Q : GraphPath G) {v : V}
    (hvQ : v ∈ Q.vertexSet) (hvL : v ∈ L.toPathPacking.vertexSet) :
    v ∈ endpointContactVertexList L Q := by
  classical
  by_cases hsource : v = Q.source
  · subst hsource
    simp [endpointContactVertexList]
  · by_cases htarget : v = Q.target
    · subst htarget
      simp [endpointContactVertexList]
    · have hmid :
          v ∈ Q.walk.support.tail.dropLast :=
        mem_support_tail_dropLast_of_mem_vertexSet_of_ne_endpoints Q hvQ
          hsource htarget
      simp [endpointContactVertexList, internalLinkageContactVertexList,
        hsource, htarget, hmid, hvL]

/-- The length parameter for the endpoint-padded contact list, so that the
list has length `endpointContactTraceLen + 1`. -/
noncomputable def endpointContactTraceLen
    (L : PerfectPathPacking G A B) (Q : GraphPath G) : ℕ :=
  (internalLinkageContactVertexList L Q).length + 1

@[simp] theorem endpointContactTraceLen_add_one
    (L : PerfectPathPacking G A B) (Q : GraphPath G) :
    endpointContactTraceLen L Q + 1 =
      (endpointContactVertexList L Q).length := by
  simp [endpointContactTraceLen]

/-- The `r`-th endpoint-padded contact.  This is the concrete contact function
used by the eventual complete trace extracted from a transversal path. -/
noncomputable def endpointContact
    (L : PerfectPathPacking G A B) (Q : GraphPath G)
    (r : Fin (endpointContactTraceLen L Q + 1)) : V :=
  (endpointContactVertexList L Q).get
    ⟨r.1, by
      simpa [endpointContactTraceLen_add_one] using r.2⟩

@[simp] theorem endpointContact_zero
    (L : PerfectPathPacking G A B) (Q : GraphPath G) :
    endpointContact L Q ⟨0, by simp [endpointContactTraceLen]⟩ =
      Q.source := by
  simp [endpointContact, endpointContactVertexList]

@[simp] theorem endpointContact_last
    (L : PerfectPathPacking G A B) (Q : GraphPath G) :
    endpointContact L Q
        ⟨endpointContactTraceLen L Q, by omega⟩ =
      Q.target := by
  classical
  simp [endpointContact, endpointContactTraceLen, endpointContactVertexList]

/-- Every indexed endpoint contact lies on the original graph path. -/
theorem endpointContact_mem_path
    (L : PerfectPathPacking G A B) (Q : GraphPath G)
    (r : Fin (endpointContactTraceLen L Q + 1)) :
    endpointContact L Q r ∈ Q.vertexSet := by
  classical
  apply mem_endpointContactVertexList_imp_mem_path (L := L) (Q := Q)
  exact List.get_mem _ _

/-- Every indexed endpoint contact lies on the linkage, assuming the two
endpoints of the graph path do. -/
theorem endpointContact_mem_linkage
    (L : PerfectPathPacking G A B) (Q : GraphPath G)
    (hsource : Q.source ∈ L.toPathPacking.vertexSet)
    (htarget : Q.target ∈ L.toPathPacking.vertexSet)
    (r : Fin (endpointContactTraceLen L Q + 1)) :
    endpointContact L Q r ∈ L.toPathPacking.vertexSet := by
  classical
  apply mem_endpointContactVertexList_imp_mem_linkage
    (L := L) (Q := Q) hsource htarget
  exact List.get_mem _ _

/-- The linkage path containing an endpoint-padded contact. -/
noncomputable def endpointContactIndex
    (L : PerfectPathPacking G A B) (Q : GraphPath G)
    (hsource : Q.source ∈ L.toPathPacking.vertexSet)
    (htarget : Q.target ∈ L.toPathPacking.vertexSet)
    (r : Fin (endpointContactTraceLen L Q + 1)) : L.Index :=
  linkageIndexOfVertex (L := L) (endpointContact L Q r)
    (endpointContact_mem_linkage L Q hsource htarget r)

/-- The endpoint-padded contact lies on its associated linkage path. -/
theorem endpointContact_mem_contactIndex_path
    (L : PerfectPathPacking G A B) (Q : GraphPath G)
    (hsource : Q.source ∈ L.toPathPacking.vertexSet)
    (htarget : Q.target ∈ L.toPathPacking.vertexSet)
    (r : Fin (endpointContactTraceLen L Q + 1)) :
    endpointContact L Q r ∈
      (L.path (endpointContactIndex L Q hsource htarget r)).vertexSet := by
  exact linkageIndexOfVertex_mem
    (L := L)
    (endpointContact_mem_linkage L Q hsource htarget r)

/-- The first endpoint-padded contact index is the linkage path containing the
source. -/
theorem endpointContactIndex_zero_eq_of_source_mem
    (L : PerfectPathPacking G A B) (Q : GraphPath G)
    (hsource : Q.source ∈ L.toPathPacking.vertexSet)
    (htarget : Q.target ∈ L.toPathPacking.vertexSet)
    {i : L.Index} (hsource_i : Q.source ∈ (L.path i).vertexSet) :
    endpointContactIndex L Q hsource htarget
        ⟨0, by simp [endpointContactTraceLen]⟩ = i := by
  apply linkageIndexOfVertex_eq_of_mem (L := L)
  simpa using hsource_i

/-- The last endpoint-padded contact index is the linkage path containing the
target. -/
theorem endpointContactIndex_last_eq_of_target_mem
    (L : PerfectPathPacking G A B) (Q : GraphPath G)
    (hsource : Q.source ∈ L.toPathPacking.vertexSet)
    (htarget : Q.target ∈ L.toPathPacking.vertexSet)
    {i : L.Index} (htarget_i : Q.target ∈ (L.path i).vertexSet) :
    endpointContactIndex L Q hsource htarget
        ⟨endpointContactTraceLen L Q, by omega⟩ = i := by
  apply linkageIndexOfVertex_eq_of_mem (L := L)
  simpa using htarget_i

/-- For a nontrivial path, the endpoint-padded contact list is a sublist of
the path support.  This is the order-theoretic core of the contact-trace
construction: filtering internal linkage contacts preserves their order
between the source and target endpoints. -/
theorem endpointContactVertexList_sublist_support_of_source_ne_target
    (L : PerfectPathPacking G A B) (Q : GraphPath G)
    (hne : Q.source ≠ Q.target) :
    (endpointContactVertexList L Q).Sublist Q.walk.support := by
  classical
  have htail_ne : Q.walk.support.tail ≠ [] := by
    intro htail
    have htarget_eq_source : Q.target = Q.source := by
      have hlast := _root_.SimpleGraph.Walk.getLast_support Q.walk
      have hsupport_cons :
          Q.walk.support =
            Q.walk.support.head Q.walk.support_ne_nil :: Q.walk.support.tail :=
        (List.cons_head_tail Q.walk.support_ne_nil).symm
      have hcons_ne :
          Q.walk.support.head Q.walk.support_ne_nil :: Q.walk.support.tail ≠ [] :=
        List.cons_ne_nil _ _
      have hlast_cons :
          (Q.walk.support.head Q.walk.support_ne_nil ::
              Q.walk.support.tail).getLast hcons_ne = Q.target := by
        have hcongr :
            (Q.walk.support.head Q.walk.support_ne_nil ::
                Q.walk.support.tail).getLast hcons_ne =
              Q.walk.support.getLast Q.walk.support_ne_nil :=
          List.getLast_congr hcons_ne Q.walk.support_ne_nil hsupport_cons.symm
        exact hcongr.trans hlast
      have hhead :
          Q.walk.support.head Q.walk.support_ne_nil = Q.source := by
        simp
      simpa [htail, hhead] using hlast_cons.symm
    exact hne htarget_eq_source.symm
  have htail_decomp :
      Q.walk.support.tail.dropLast ++ [Q.target] = Q.walk.support.tail := by
    have h := List.dropLast_append_getLast (l := Q.walk.support.tail) htail_ne
    have hlast_tail :
        Q.walk.support.tail.getLast htail_ne = Q.target := by
      have hsupport_cons :
          Q.walk.support =
            Q.walk.support.head Q.walk.support_ne_nil :: Q.walk.support.tail :=
        (List.cons_head_tail Q.walk.support_ne_nil).symm
      have hlast := _root_.SimpleGraph.Walk.getLast_support Q.walk
      have hcons_ne :
          Q.walk.support.head Q.walk.support_ne_nil :: Q.walk.support.tail ≠ [] :=
        List.cons_ne_nil _ _
      have hlast_cons :
          (Q.walk.support.head Q.walk.support_ne_nil ::
              Q.walk.support.tail).getLast hcons_ne = Q.target := by
        have hcongr :
            (Q.walk.support.head Q.walk.support_ne_nil ::
                Q.walk.support.tail).getLast hcons_ne =
              Q.walk.support.getLast Q.walk.support_ne_nil :=
          List.getLast_congr hcons_ne Q.walk.support_ne_nil hsupport_cons.symm
        exact hcongr.trans hlast
      rw [List.getLast_cons] at hlast_cons
      exact hlast_cons
    simpa [hlast_tail] using h
  have hsupport_cons :
      Q.walk.support = Q.source :: Q.walk.support.tail := by
    calc
      Q.walk.support =
          Q.walk.support.head Q.walk.support_ne_nil :: Q.walk.support.tail := by
            exact (List.cons_head_tail Q.walk.support_ne_nil).symm
      _ = Q.source :: Q.walk.support.tail := by
            simp [_root_.SimpleGraph.Walk.head_support Q.walk]
  have hmiddle :
      (internalLinkageContactVertexList L Q ++ [Q.target]).Sublist
        (Q.walk.support.tail.dropLast ++ [Q.target]) := by
    exact List.Sublist.append List.filter_sublist (List.Sublist.refl [Q.target])
  have hwith_source :
      (endpointContactVertexList L Q).Sublist
        (Q.source :: (Q.walk.support.tail.dropLast ++ [Q.target])) := by
    simp [endpointContactVertexList, internalLinkageContactVertexList] at hmiddle ⊢
  have hsupport_decomp :
      Q.source :: (Q.walk.support.tail.dropLast ++ [Q.target]) =
        Q.walk.support := by
    rw [htail_decomp]
    exact hsupport_cons.symm
  rw [← hsupport_decomp]
  exact hwith_source

/-- Consecutive endpoint-padded contacts occur in the same order on the
original path. -/
theorem endpointContact_before_succ_of_source_ne_target
    (L : PerfectPathPacking G A B) (Q : GraphPath G)
    (hne : Q.source ≠ Q.target)
    (r : Fin (endpointContactTraceLen L Q)) :
    Q.Before
      (endpointContact L Q ⟨r.1, by omega⟩)
      (endpointContact L Q ⟨r.1 + 1, by omega⟩) := by
  classical
  let contacts := endpointContactVertexList L Q
  have hsub : contacts.Sublist Q.walk.support := by
    simpa [contacts] using
      endpointContactVertexList_sublist_support_of_source_ne_target L Q hne
  rcases List.sublist_iff_exists_fin_orderEmbedding_get_eq.mp hsub with
    ⟨f, hf⟩
  let ir : Fin contacts.length :=
    ⟨r.1, by
      have hr : r.1 < endpointContactTraceLen L Q := r.2
      simp [contacts, endpointContactTraceLen, endpointContactVertexList] at hr ⊢⟩
  let is : Fin contacts.length :=
    ⟨r.1 + 1, by
      have hr : r.1 < endpointContactTraceLen L Q := r.2
      simp [contacts, endpointContactTraceLen, endpointContactVertexList] at hr ⊢
      omega⟩
  have hir_le_is : ir ≤ is := by
    change r.1 ≤ r.1 + 1
    omega
  have hf_le : f ir ≤ f is := by
    exact (OrderEmbedding.le_iff_le f).2 hir_le_is
  have hidx_ir :
      Q.vertexIndex (contacts.get ir) = (f ir).1 := by
    have hget := hf ir
    have hidx :
        Q.vertexIndex (Q.walk.support.get (f ir)) = (f ir).1 := by
      simpa [GraphPath.vertexIndex] using
        Q.isPath.support_nodup.idxOf_getElem (f ir).1 (f ir).2
    rw [hget, hidx]
  have hidx_is :
      Q.vertexIndex (contacts.get is) = (f is).1 := by
    have hget := hf is
    have hidx :
        Q.vertexIndex (Q.walk.support.get (f is)) = (f is).1 := by
      simpa [GraphPath.vertexIndex] using
        Q.isPath.support_nodup.idxOf_getElem (f is).1 (f is).2
    rw [hget, hidx]
  have hcontact_r :
      endpointContact L Q ⟨r.1, by omega⟩ = contacts.get ir := by
    simp [endpointContact, contacts, ir]
  have hcontact_s :
      endpointContact L Q ⟨r.1 + 1, by omega⟩ = contacts.get is := by
    simp [endpointContact, contacts, is]
  refine (Q.before_iff_vertexIndex_le).2 ?_
  refine ⟨endpointContact_mem_path L Q ⟨r.1, by omega⟩,
    endpointContact_mem_path L Q ⟨r.1 + 1, by omega⟩, ?_⟩
  rw [hcontact_r, hcontact_s, hidx_ir, hidx_is]
  exact hf_le

/-- The endpoint-padded contact list reflects the path order: for two recorded
contacts, occurring earlier in the contact list is equivalent to occurring
earlier on the graph path. -/
theorem endpointContact_before_iff_le_of_source_ne_target
    (L : PerfectPathPacking G A B) (Q : GraphPath G)
    (hne : Q.source ≠ Q.target)
    (r s : Fin (endpointContactTraceLen L Q + 1)) :
    Q.Before (endpointContact L Q r) (endpointContact L Q s) ↔
      r.1 ≤ s.1 := by
  classical
  let contacts := endpointContactVertexList L Q
  have hsub : contacts.Sublist Q.walk.support := by
    simpa [contacts] using
      endpointContactVertexList_sublist_support_of_source_ne_target L Q hne
  rcases List.sublist_iff_exists_fin_orderEmbedding_get_eq.mp hsub with
    ⟨f, hf⟩
  let ir : Fin contacts.length :=
    ⟨r.1, by
      have hr : r.1 < endpointContactTraceLen L Q + 1 := r.2
      simpa [contacts, endpointContactTraceLen_add_one] using hr⟩
  let is : Fin contacts.length :=
    ⟨s.1, by
      have hs : s.1 < endpointContactTraceLen L Q + 1 := s.2
      simpa [contacts, endpointContactTraceLen_add_one] using hs⟩
  have hcontact_r :
      endpointContact L Q r = contacts.get ir := by
    simp [endpointContact, contacts, ir]
  have hcontact_s :
      endpointContact L Q s = contacts.get is := by
    simp [endpointContact, contacts, is]
  have hidx_contact :
      ∀ k : Fin contacts.length,
        Q.vertexIndex (contacts.get k) = (f k).1 := by
    intro k
    have hget := hf k
    have hidx :
        Q.vertexIndex (Q.walk.support.get (f k)) = (f k).1 := by
      simpa [GraphPath.vertexIndex] using
        Q.isPath.support_nodup.idxOf_getElem (f k).1 (f k).2
    rw [hget, hidx]
  constructor
  · intro hbefore
    have hidx_le :=
      ((Q.before_iff_vertexIndex_le).1 hbefore).2.2
    have hf_le : f ir ≤ f is := by
      change (f ir).1 ≤ (f is).1
      rw [← hidx_contact ir, ← hidx_contact is]
      simpa [hcontact_r, hcontact_s] using hidx_le
    have hir_le_is : ir ≤ is := (OrderEmbedding.le_iff_le f).1 hf_le
    simpa [ir, is] using hir_le_is
  · intro hrs
    have hir_le_is : ir ≤ is := by
      simpa [ir, is] using hrs
    have hf_le : f ir ≤ f is :=
      (OrderEmbedding.le_iff_le f).2 hir_le_is
    refine (Q.before_iff_vertexIndex_le).2 ?_
    refine ⟨endpointContact_mem_path L Q r, endpointContact_mem_path L Q s, ?_⟩
    change Q.vertexIndex (endpointContact L Q r) ≤
      Q.vertexIndex (endpointContact L Q s)
    rw [hcontact_r, hcontact_s, hidx_contact ir, hidx_contact is]
    exact hf_le

/-- The narrow graph-path fact needed to turn the endpoint-padded contact list
into a complete auxiliary contact trace: consecutive entries of the filtered
linkage-contact list have no further linkage vertex internally between them. -/
def EndpointContactsCleanConsecutive
    (L : PerfectPathPacking G A B) (Q : GraphPath G)
    (hne : Q.source ≠ Q.target) : Prop :=
  ∀ r : Fin (endpointContactTraceLen L Q),
    (Q.segmentOfBefore
      (endpointContact_before_succ_of_source_ne_target L Q hne r)).InternallyDisjointFromSet
        L.toPathPacking.vertexSet

/-- Consecutive endpoint-padded linkage contacts are clean: any linkage vertex
on the segment between them is one of the two endpoints. -/
theorem endpointContactsCleanConsecutive_of_source_ne_target
    (L : PerfectPathPacking G A B) (Q : GraphPath G)
    (hne : Q.source ≠ Q.target) :
    EndpointContactsCleanConsecutive L Q hne := by
  classical
  intro r v hvSeg hvL
  let contacts := endpointContactVertexList L Q
  let a : V := endpointContact L Q ⟨r.1, by omega⟩
  let b : V := endpointContact L Q ⟨r.1 + 1, by omega⟩
  let hab : Q.Before a b :=
    endpointContact_before_succ_of_source_ne_target L Q hne r
  have hsub : contacts.Sublist Q.walk.support := by
    simpa [contacts] using
      endpointContactVertexList_sublist_support_of_source_ne_target L Q hne
  rcases List.sublist_iff_exists_fin_orderEmbedding_get_eq.mp hsub with
    ⟨f, hf⟩
  let ir : Fin contacts.length :=
    ⟨r.1, by
      have hr : r.1 < endpointContactTraceLen L Q := r.2
      simp [contacts, endpointContactTraceLen, endpointContactVertexList] at hr ⊢⟩
  let is : Fin contacts.length :=
    ⟨r.1 + 1, by
      have hr : r.1 < endpointContactTraceLen L Q := r.2
      simp [contacts, endpointContactTraceLen, endpointContactVertexList] at hr ⊢
      omega⟩
  have hcontact_r : a = contacts.get ir := by
    simp [a, endpointContact, contacts, ir]
  have hcontact_s : b = contacts.get is := by
    simp [b, endpointContact, contacts, is]
  have hidx_contact :
      ∀ k : Fin contacts.length,
        Q.vertexIndex (contacts.get k) = (f k).1 := by
    intro k
    have hget := hf k
    have hidx :
        Q.vertexIndex (Q.walk.support.get (f k)) = (f k).1 := by
      simpa [GraphPath.vertexIndex] using
        Q.isPath.support_nodup.idxOf_getElem (f k).1 (f k).2
    rw [hget, hidx]
  have hvQ : v ∈ Q.vertexSet :=
    Q.segmentOfBefore_vertexSet_subset hab hvSeg
  have hvContacts : v ∈ contacts :=
    mem_endpointContactVertexList_of_mem_path_of_mem_linkage L Q hvQ hvL
  rcases List.mem_iff_get.mp hvContacts with ⟨iv, hiv⟩
  have ha_before_v : Q.Before a v :=
    Q.before_of_mem_segmentOfBefore_left hab hvSeg
  have hv_before_b : Q.Before v b :=
    Q.before_of_mem_segmentOfBefore_right hab hvSeg
  have hidx_a_v :
      Q.vertexIndex a ≤ Q.vertexIndex v :=
    ((Q.before_iff_vertexIndex_le).1 ha_before_v).2.2
  have hidx_v_b :
      Q.vertexIndex v ≤ Q.vertexIndex b :=
    ((Q.before_iff_vertexIndex_le).1 hv_before_b).2.2
  have hf_ir_iv : f ir ≤ f iv := by
    change (f ir).1 ≤ (f iv).1
    rw [← hidx_contact ir, ← hidx_contact iv]
    rw [hiv]
    simpa [hcontact_r] using hidx_a_v
  have hf_iv_is : f iv ≤ f is := by
    change (f iv).1 ≤ (f is).1
    rw [← hidx_contact iv, ← hidx_contact is]
    rw [hiv]
    simpa [hcontact_s] using hidx_v_b
  have hir_iv : ir ≤ iv := (OrderEmbedding.le_iff_le f).1 hf_ir_iv
  have hiv_is : iv ≤ is := (OrderEmbedding.le_iff_le f).1 hf_iv_is
  have hiv_val : iv.1 = r.1 ∨ iv.1 = r.1 + 1 := by
    have hleft : r.1 ≤ iv.1 := by
      simpa [ir] using hir_iv
    have hright : iv.1 ≤ r.1 + 1 := by
      simpa [is] using hiv_is
    omega
  rcases hiv_val with hivr | hivs
  · have hiv_eq : iv = ir := by
      apply Fin.ext
      simpa [ir] using hivr
    left
    have hv_eq_a : v = a := by
      rw [hcontact_r]
      simpa [hiv_eq] using hiv.symm
    simpa [GraphPath.segmentOfBefore_source, hab] using hv_eq_a
  · have hiv_eq : iv = is := by
      apply Fin.ext
      simpa [is] using hivs
    right
    have hv_eq_b : v = b := by
      rw [hcontact_s]
      simpa [hiv_eq] using hiv.symm
    simpa [GraphPath.segmentOfBefore_target, hab] using hv_eq_b

/-- Build a complete linkage-contact trace from the endpoint-padded contact
list, once adjacent endpoint contacts have been shown to be clean consecutive
contacts.  This packages all routine endpoint/index bookkeeping. -/
noncomputable def completeLinkageContactTraceOfEndpointContacts
    (R : IndexedAuxiliaryPrefix L h) (Q : GraphPath G)
    (hsource : Q.source ∈ L.toPathPacking.vertexSet)
    (htarget : Q.target ∈ L.toPathPacking.vertexSet)
    (hne : Q.source ≠ Q.target) :
    CompleteLinkageContactTrace R Q where
  len := endpointContactTraceLen L Q
  contact := endpointContact L Q
  index := endpointContactIndex L Q hsource htarget
  contact_mem_Q := endpointContact_mem_path L Q
  contact_mem_linkage := endpointContact_mem_contactIndex_path L Q hsource htarget
  first_contact_eq_source := by
    exact endpointContact_zero L Q
  last_contact_eq_target := by
    exact endpointContact_last L Q
  contact_monotone :=
    endpointContact_before_succ_of_source_ne_target L Q hne
  consecutive_aux_step := by
    intro r
    exact aux_adj_or_eq_of_clean_segment
      (L := L)
      (Q.segmentOfBefore
        (endpointContact_before_succ_of_source_ne_target L Q hne r))
      (by
        simpa using
          endpointContact_mem_contactIndex_path L Q hsource htarget
            ⟨r.1, by omega⟩)
      (by
        simpa using
          endpointContact_mem_contactIndex_path L Q hsource htarget
            ⟨r.1 + 1, by omega⟩)
      (endpointContactsCleanConsecutive_of_source_ne_target L Q hne r)
  contact_complete := by
    intro v hvQ hvL
    have hvList :
        v ∈ endpointContactVertexList L Q :=
      mem_endpointContactVertexList_of_mem_path_of_mem_linkage L Q hvQ hvL
    rcases List.mem_iff_get.mp hvList with ⟨r, hr⟩
    refine ⟨⟨r.1, by
      simpa [endpointContactTraceLen_add_one] using r.2⟩, ?_⟩
    simpa [endpointContact] using hr
  contact_before_iff_le := by
    intro r s
    exact endpointContact_before_iff_le_of_source_ne_target L Q hne r s
  consecutive_clean := by
    intro r
    exact endpointContactsCleanConsecutive_of_source_ne_target L Q hne r

/-- A finite sequence of auxiliary indices whose consecutive entries are equal
or adjacent gives a reachable pair in the auxiliary graph. -/
theorem reachable_of_auxiliary_index_trace_steps
    {n : ℕ} (idx : Fin (n + 1) → L.Index)
    (hstep : ∀ r : Fin n,
      idx ⟨r.1, by omega⟩ = idx ⟨r.1 + 1, by omega⟩ ∨
        (linkageAuxGraph L).Adj
          (idx ⟨r.1, by omega⟩) (idx ⟨r.1 + 1, by omega⟩)) :
    (linkageAuxGraph L).Reachable
      (idx ⟨0, by omega⟩) (idx ⟨n, by omega⟩) := by
  induction n with
  | zero =>
      exact _root_.SimpleGraph.Reachable.refl _
  | succ n ih =>
      let idx' : Fin (n + 1) → L.Index := fun r => idx ⟨r.1, by omega⟩
      have hstep' : ∀ r : Fin n,
          idx' ⟨r.1, by omega⟩ = idx' ⟨r.1 + 1, by omega⟩ ∨
            (linkageAuxGraph L).Adj
              (idx' ⟨r.1, by omega⟩) (idx' ⟨r.1 + 1, by omega⟩) := by
        intro r
        simpa [idx'] using hstep ⟨r.1, by omega⟩
      have hprefix :
          (linkageAuxGraph L).Reachable
            (idx ⟨0, by omega⟩) (idx ⟨n, by omega⟩) := by
        simpa [idx'] using ih idx' hstep'
      have hlast_step :
          idx ⟨n, by omega⟩ = idx ⟨n + 1, by omega⟩ ∨
            (linkageAuxGraph L).Adj
              (idx ⟨n, by omega⟩) (idx ⟨n + 1, by omega⟩) := by
        simpa using hstep ⟨n, by omega⟩
      have hfinal :
          (linkageAuxGraph L).Reachable
            (idx ⟨n, by omega⟩) (idx ⟨n + 1, by omega⟩) := by
        rcases hlast_step with heq | hadj
        · rw [heq]
        · exact _root_.SimpleGraph.Adj.reachable hadj
      exact hprefix.trans hfinal

/-- The endpoint-contact sequence of a nontrivial graph path gives a reachable
pair in the linkage auxiliary graph, from the linkage path containing the
source to the linkage path containing the target. -/
theorem endpointContactIndex_reachable_first_last
    (L : PerfectPathPacking G A B) (Q : GraphPath G)
    (hsource : Q.source ∈ L.toPathPacking.vertexSet)
    (htarget : Q.target ∈ L.toPathPacking.vertexSet)
    (hne : Q.source ≠ Q.target) :
    (linkageAuxGraph L).Reachable
      (endpointContactIndex L Q hsource htarget
        ⟨0, by simp [endpointContactTraceLen]⟩)
      (endpointContactIndex L Q hsource htarget
        ⟨endpointContactTraceLen L Q, by omega⟩) := by
  refine reachable_of_auxiliary_index_trace_steps
    (L := L)
    (idx := endpointContactIndex L Q hsource htarget)
    ?_
  intro r
  exact aux_adj_or_eq_of_clean_segment
    (L := L)
    (Q.segmentOfBefore
      (endpointContact_before_succ_of_source_ne_target L Q hne r))
    (by
      simpa using
        endpointContact_mem_contactIndex_path L Q hsource htarget
          ⟨r.1, by omega⟩)
    (by
      simpa using
        endpointContact_mem_contactIndex_path L Q hsource htarget
          ⟨r.1 + 1, by omega⟩)
    (endpointContactsCleanConsecutive_of_source_ne_target L Q hne r)

/-- A contact trace all of whose linkage contacts lie on the displayed
auxiliary 2-path, recorded by their displayed positions. -/
structure DisplayedContactTrace (R : IndexedAuxiliaryPrefix L h)
    (Q : GraphPath G) extends LinkageContactTrace R Q where
  pos : Fin (len + 1) → ℕ
  pos_lt : ∀ r, pos r < 8 * h + 1
  index_eq_pos : ∀ r, index r = R.indexAt (pos r) (pos_lt r)
  unit_step : UnitStepNatTrace len pos

namespace LinkageContactTrace

variable {R : IndexedAuxiliaryPrefix L h} {Qpath : GraphPath G}

/-- The first linkage index in a contact trace. -/
def firstIndex (T : LinkageContactTrace R Qpath) : L.Index :=
  T.index ⟨0, by omega⟩

/-- The last linkage index in a contact trace. -/
def lastIndex (T : LinkageContactTrace R Qpath) : L.Index :=
  T.index ⟨T.len, by omega⟩

/-- A contact trace starts in a finite set of linkage indices when its first
linkage contact lies in that set. -/
def StartsIn (T : LinkageContactTrace R Qpath) (S : Finset L.Index) : Prop :=
  T.firstIndex ∈ S

/-- A contact trace ends in a finite set of linkage indices when its last
linkage contact lies in that set. -/
def EndsIn (T : LinkageContactTrace R Qpath) (S : Finset L.Index) : Prop :=
  T.lastIndex ∈ S

/-- Every linkage index in a finite set is hit by the transversal path
underlying the trace. -/
def HitsEveryIndex (_T : LinkageContactTrace R Qpath)
    (S : Finset L.Index) : Prop :=
  ∀ i : L.Index, i ∈ S → HitsLinkagePath Qpath i

/-- The trace visits a specified displayed position of the auxiliary 2-path. -/
def HitsDisplayedPosition (T : LinkageContactTrace R Qpath)
    (k : ℕ) (hk : k < 8 * h + 1) : Prop :=
  ∃ r : Fin (T.len + 1), T.index r = R.indexAt k hk

/-- Trace-level version of the page-59 dichotomy: the contact trace visits all
displayed positions of the first block or all displayed positions of the third
block. -/
def PositionBlockDichotomy (T : LinkageContactTrace R Qpath) : Prop :=
  (∀ i : Fin (z h),
      T.HitsDisplayedPosition (1 + i.1) (by
        have hi : i.1 < z h := i.2
        dsimp [z] at hi ⊢
        omega)) ∨
    (∀ i : Fin (z h),
      T.HitsDisplayedPosition (2 * z h + 1 + i.1) (by
        have hi : i.1 < z h := i.2
        dsimp [z] at hi ⊢
        omega))

/-- Trace-level middle-boundary hit: the trace visits `P_{z+1}` or `P_{2z}`. -/
def MiddleBoundaryPositionHit (T : LinkageContactTrace R Qpath)
    (hpos : 0 < h) : Prop :=
  T.HitsDisplayedPosition (z h + 1) (by dsimp [z]; omega) ∨
    T.HitsDisplayedPosition (2 * z h) (by dsimp [z]; omega)

/-- If a trace explicitly contains a linkage index, then the underlying graph
path hits that linkage path. -/
theorem hits_of_index_eq (T : LinkageContactTrace R Qpath)
    {r : Fin (T.len + 1)} {i : L.Index} (hidx : T.index r = i) :
    HitsLinkagePath Qpath i := by
  subst hidx
  exact ⟨T.contact r, Finset.mem_inter.2
    ⟨T.contact_mem_Q r, T.contact_mem_linkage r⟩⟩

/-- Visiting a displayed position in the trace gives a hit of the corresponding
linkage path by the original graph path. -/
theorem hitsLinkagePath_of_hitsDisplayedPosition
    (T : LinkageContactTrace R Qpath)
    {k : ℕ} {hk : k < 8 * h + 1}
    (hhit : T.HitsDisplayedPosition k hk) :
    HitsLinkagePath Qpath (R.indexAt k hk) := by
  rcases hhit with ⟨r, hr⟩
  exact T.hits_of_index_eq hr

/-- Contacts later in the finite contact trace occur later on the underlying
oriented graph path. -/
theorem contact_before_offset
    (T : LinkageContactTrace R Qpath) {s d : ℕ}
    (hsd : s + d ≤ T.len) :
    Qpath.Before
      (T.contact ⟨s, Nat.lt_succ_of_le (by omega)⟩)
      (T.contact ⟨s + d, Nat.lt_succ_of_le hsd⟩) := by
  induction d with
  | zero =>
      simpa using
        Qpath.before_refl (T.contact_mem_Q ⟨s, Nat.lt_succ_of_le hsd⟩)
  | succ d ih =>
      have hprev : s + d ≤ T.len := by omega
      have hbefore_prev :=
        ih hprev
      have hstep :
          Qpath.Before
            (T.contact ⟨s + d, by omega⟩)
            (T.contact ⟨s + d + 1, by omega⟩) := by
        simpa [Nat.add_assoc] using
          T.contact_monotone ⟨s + d, by omega⟩
      exact Qpath.before_trans (by simpa [Nat.add_assoc] using hbefore_prev)
        (by simpa [Nat.add_assoc] using hstep)

/-- Pointwise version of `contact_before_offset`. -/
theorem contact_before_of_le
    (T : LinkageContactTrace R Qpath)
    {a b : Fin (T.len + 1)} (hab : a.1 ≤ b.1) :
    Qpath.Before (T.contact a) (T.contact b) := by
  let d := b.1 - a.1
  have hsum : a.1 + d = b.1 := by
    dsimp [d]
    omega
  have hsd : a.1 + d ≤ T.len := by
    have hb : b.1 ≤ T.len := by omega
    omega
  have h := T.contact_before_offset (s := a.1) (d := d) hsd
  have ha_fin :
      (⟨a.1, Nat.lt_succ_of_le (by omega)⟩ : Fin (T.len + 1)) = a := by
    apply Fin.ext
    simp
  have hb_fin :
      (⟨a.1 + d, Nat.lt_succ_of_le hsd⟩ : Fin (T.len + 1)) = b := by
    apply Fin.ext
    simp [hsum]
  simpa [ha_fin, hb_fin] using h

/-- The first index of the trace is the unique linkage path containing the
source of the transversal path. -/
theorem firstIndex_eq_of_source_mem
    (T : LinkageContactTrace R Qpath)
    {i : L.Index} (hsource : Qpath.source ∈ (L.path i).vertexSet) :
    T.firstIndex = i := by
  have hmem :
      Qpath.source ∈ (L.path T.firstIndex).vertexSet := by
    rw [← T.first_contact_eq_source]
    exact
      T.contact_mem_linkage ⟨0, by omega⟩
  have hsourcePack : Qpath.source ∈ L.toPathPacking.vertexSet :=
    (L.toPathPacking.mem_vertexSet).2 ⟨i, hsource⟩
  have hT :
      linkageIndexOfVertex (L := L) Qpath.source hsourcePack = T.firstIndex :=
    linkageIndexOfVertex_eq_of_mem (L := L) hsourcePack hmem
  have hi :
      linkageIndexOfVertex (L := L) Qpath.source hsourcePack = i :=
    linkageIndexOfVertex_eq_of_mem (L := L) hsourcePack hsource
  exact hT.symm.trans hi

/-- The last index of the trace is the unique linkage path containing the
target of the transversal path. -/
theorem lastIndex_eq_of_target_mem
    (T : LinkageContactTrace R Qpath)
    {i : L.Index} (htarget : Qpath.target ∈ (L.path i).vertexSet) :
    T.lastIndex = i := by
  have hmem :
      Qpath.target ∈ (L.path T.lastIndex).vertexSet := by
    simpa [lastIndex, T.last_contact_eq_target] using
      T.contact_mem_linkage ⟨T.len, by omega⟩
  have htargetPack : Qpath.target ∈ L.toPathPacking.vertexSet :=
    (L.toPathPacking.mem_vertexSet).2 ⟨i, htarget⟩
  have hT :
      linkageIndexOfVertex (L := L) Qpath.target htargetPack = T.lastIndex :=
    linkageIndexOfVertex_eq_of_mem (L := L) htargetPack hmem
  have hi :
      linkageIndexOfVertex (L := L) Qpath.target htargetPack = i :=
    linkageIndexOfVertex_eq_of_mem (L := L) htargetPack htarget
  exact hT.symm.trans hi

/-- Local propagation along the displayed 2-path: from an interior displayed
linkage vertex, the next contact in the trace is either the same displayed
vertex or one of its two displayed neighbors. -/
theorem next_index_eq_or_neighbor_of_displayed
    (T : LinkageContactTrace R Qpath)
    {r : Fin T.len} {k : ℕ} (hk0 : 0 < k) (hk8 : k < 8 * h)
    (hcur : T.index ⟨r.1, by omega⟩ = R.indexAt k (by omega)) :
    T.index ⟨r.1 + 1, by omega⟩ = R.indexAt k (by omega) ∨
      T.index ⟨r.1 + 1, by omega⟩ = R.indexAt (k - 1) (by omega) ∨
        T.index ⟨r.1 + 1, by omega⟩ = R.indexAt (k + 1) (by omega) := by
  rcases T.consecutive_aux_step r with hsame | hadj
  · exact Or.inl (by simpa [hcur] using hsame.symm)
  · right
    have hadj' :
        (linkageAuxGraph L).Adj (R.indexAt k (by omega))
          (T.index ⟨r.1 + 1, by omega⟩) := by
      simpa [hcur] using hadj
    exact R.neighbor_of_interior_indexAt hk0 hk8 hadj'

/-- Corridor step on the left side of the displayed 2-path.  If the current
contact is displayed at a position `1 ≤ k < 2z`, and the next contact is not
`P_0` and not `P_{2z}`, then the next contact is still displayed in the same
left corridor. -/
theorem next_index_displayed_left_corridor
    (T : LinkageContactTrace R Qpath) {hpos : 0 < h}
    {r : Fin T.len} {k : ℕ}
    (hklo : 1 ≤ k) (hkhi : k < 2 * z h)
    (hcur : T.index ⟨r.1, by omega⟩ = R.indexAt k (by
      dsimp [z] at *
      omega))
    (hnot0 :
      T.index ⟨r.1 + 1, by omega⟩ ≠
        R.indexAt 0 (by omega))
    (hnot2z :
      T.index ⟨r.1 + 1, by omega⟩ ≠
        R.indexAt (2 * z h) (by dsimp [z] at *; omega)) :
    ∃ k' : ℕ, ∃ hk' : k' < 8 * h + 1, 1 ≤ k' ∧ k' < 2 * z h ∧
      T.index ⟨r.1 + 1, by omega⟩ =
        R.indexAt k' hk' := by
  have hnext :=
    T.next_index_eq_or_neighbor_of_displayed
      (R := R) (r := r) (k := k)
      (by omega) (by have hz_eq : z h = 2 * h := rfl; omega) (by
        simpa using hcur)
  rcases hnext with hsame | hprev | hsucc
  · exact ⟨k, by have hz_eq : z h = 2 * h := rfl; omega,
      hklo, hkhi, by simpa using hsame⟩
  · by_cases hk1 : k = 1
    · have hzero :
          T.index ⟨r.1 + 1, by omega⟩ =
            R.indexAt 0 (by dsimp [z] at *; omega) := by
        simpa [hk1] using hprev
      exact False.elim (hnot0 hzero)
    · have hk'lo : 1 ≤ k - 1 := by omega
      have hk'hi : k - 1 < 2 * z h := by omega
      exact ⟨k - 1, by have hz_eq : z h = 2 * h := rfl; omega,
        hk'lo, hk'hi, by simpa using hprev⟩
  · by_cases hkmax : k + 1 = 2 * z h
    · have hboundary :
          T.index ⟨r.1 + 1, by omega⟩ =
            R.indexAt (2 * z h) (by dsimp [z] at *; omega) := by
        simpa [hkmax] using hsucc
      exact False.elim (hnot2z hboundary)
    · have hk'lo : 1 ≤ k + 1 := by omega
      have hk'hi : k + 1 < 2 * z h := by omega
      exact ⟨k + 1, by have hz_eq : z h = 2 * h := rfl; omega,
        hk'lo, hk'hi, by simpa using hsucc⟩

/-- General left-side barrier step.  If the current displayed position lies
strictly between a lower displayed barrier `a` and `P_{2z}`, and the next
contact is neither barrier, then the next contact is still strictly between
them. -/
theorem next_index_displayed_between_left_barriers
    (T : LinkageContactTrace R Qpath) {hpos : 0 < h}
    {r : Fin T.len} {a k : ℕ}
    (ha0 : 0 < a) (hahi : a < 2 * z h)
    (hklo : a < k) (hkhi : k < 2 * z h)
    (hcur : T.index ⟨r.1, by omega⟩ = R.indexAt k (by
      have hz_eq : z h = 2 * h := rfl
      omega))
    (hnotA :
      T.index ⟨r.1 + 1, by omega⟩ ≠
        R.indexAt a (by have hz_eq : z h = 2 * h := rfl; omega))
    (hnot2z :
      T.index ⟨r.1 + 1, by omega⟩ ≠
        R.indexAt (2 * z h) (by
          have hz_eq : z h = 2 * h := rfl
          omega)) :
    ∃ k' : ℕ, ∃ hk' : k' < 8 * h + 1, a < k' ∧ k' < 2 * z h ∧
      T.index ⟨r.1 + 1, by omega⟩ = R.indexAt k' hk' := by
  have hpos' : 0 < h := hpos
  have hahi' : a < 2 * z h := hahi
  have hnext :=
    T.next_index_eq_or_neighbor_of_displayed
      (R := R) (r := r) (k := k)
      (by omega) (by have hz_eq : z h = 2 * h := rfl; omega) (by
        simpa using hcur)
  rcases hnext with hsame | hprev | hsucc
  · exact ⟨k, by have hz_eq : z h = 2 * h := rfl; omega,
      hklo, hkhi, by simpa using hsame⟩
  · by_cases hkmin : k - 1 = a
    · have hboundary :
          T.index ⟨r.1 + 1, by omega⟩ =
            R.indexAt a (by have hz_eq : z h = 2 * h := rfl; omega) := by
        simpa [hkmin] using hprev
      exact False.elim (hnotA hboundary)
    · have hk'lo : a < k - 1 := by omega
      have hk'hi : k - 1 < 2 * z h := by omega
      exact ⟨k - 1, by have hz_eq : z h = 2 * h := rfl; omega,
        hk'lo, hk'hi, by simpa using hprev⟩
  · by_cases hkmax : k + 1 = 2 * z h
    · have hboundary :
          T.index ⟨r.1 + 1, by omega⟩ =
            R.indexAt (2 * z h) (by
              have hz_eq : z h = 2 * h := rfl
              omega) := by
        simpa [hkmax] using hsucc
      exact False.elim (hnot2z hboundary)
    · have hk'lo : a < k + 1 := by omega
      have hk'hi : k + 1 < 2 * z h := by omega
      exact ⟨k + 1, by have hz_eq : z h = 2 * h := rfl; omega,
        hk'lo, hk'hi, by simpa using hsucc⟩

/-- Corridor step on the right side of the middle boundary.  If the current
contact is displayed at a position `2z < k ≤ 3z`, and the next contact is not
`P_{2z}` and not `P_{3z+1}`, then the next contact is still displayed in the
same right corridor. -/
theorem next_index_displayed_right_corridor
    (T : LinkageContactTrace R Qpath) {hpos : 0 < h}
    {r : Fin T.len} {k : ℕ}
    (hklo : 2 * z h < k) (hkhi : k ≤ 3 * z h)
    (hcur : T.index ⟨r.1, by omega⟩ = R.indexAt k (by
      dsimp [z] at *
      omega))
    (hnot2z :
      T.index ⟨r.1 + 1, by omega⟩ ≠
        R.indexAt (2 * z h) (by dsimp [z] at *; omega))
    (hnot3z1 :
      T.index ⟨r.1 + 1, by omega⟩ ≠
        R.indexAt (3 * z h + 1) (by dsimp [z] at *; omega)) :
    ∃ k' : ℕ, ∃ hk' : k' < 8 * h + 1, 2 * z h < k' ∧ k' ≤ 3 * z h ∧
      T.index ⟨r.1 + 1, by omega⟩ =
        R.indexAt k' hk' := by
  have hnext :=
    T.next_index_eq_or_neighbor_of_displayed
      (R := R) (r := r) (k := k)
      (by omega) (by have hz_eq : z h = 2 * h := rfl; omega) (by
        simpa using hcur)
  rcases hnext with hsame | hprev | hsucc
  · exact ⟨k, by have hz_eq : z h = 2 * h := rfl; omega,
      hklo, hkhi, by simpa using hsame⟩
  · by_cases hkmin : k - 1 = 2 * z h
    · have hboundary :
          T.index ⟨r.1 + 1, by omega⟩ =
            R.indexAt (2 * z h) (by dsimp [z] at *; omega) := by
        simpa [hkmin] using hprev
      exact False.elim (hnot2z hboundary)
    · have hk'lo : 2 * z h < k - 1 := by omega
      have hk'hi : k - 1 ≤ 3 * z h := by omega
      exact ⟨k - 1, by have hz_eq : z h = 2 * h := rfl; omega,
        hk'lo, hk'hi, by simpa using hprev⟩
  · by_cases hkmax : k = 3 * z h
    · have hboundary :
          T.index ⟨r.1 + 1, by omega⟩ =
            R.indexAt (3 * z h + 1) (by dsimp [z] at *; omega) := by
        simpa [hkmax] using hsucc
      exact False.elim (hnot3z1 hboundary)
    · have hk'lo : 2 * z h < k + 1 := by omega
      have hk'hi : k + 1 ≤ 3 * z h := by omega
      exact ⟨k + 1, by have hz_eq : z h = 2 * h := rfl; omega,
        hk'lo, hk'hi, by simpa using hsucc⟩

/-- General right-side barrier step.  If the current displayed position lies
strictly between `P_{2z}` and an upper displayed barrier `a`, and the next
contact is neither barrier, then the next contact is still strictly between
them. -/
theorem next_index_displayed_between_right_barriers
    (T : LinkageContactTrace R Qpath) {hpos : 0 < h}
    {r : Fin T.len} {a k : ℕ}
    (_ha_lo : 2 * z h < a) (ha_hi : a < 8 * h + 1)
    (hklo : 2 * z h < k) (hkhi : k < a)
    (hcur : T.index ⟨r.1, by omega⟩ = R.indexAt k (by
      omega))
    (hnot2z :
      T.index ⟨r.1 + 1, by omega⟩ ≠
        R.indexAt (2 * z h) (by
          have hz_eq : z h = 2 * h := rfl
          omega))
    (hnotA :
      T.index ⟨r.1 + 1, by omega⟩ ≠ R.indexAt a ha_hi) :
    ∃ k' : ℕ, ∃ hk' : k' < 8 * h + 1, 2 * z h < k' ∧ k' < a ∧
      T.index ⟨r.1 + 1, by omega⟩ = R.indexAt k' hk' := by
  have hnext :=
    T.next_index_eq_or_neighbor_of_displayed
      (R := R) (r := r) (k := k)
      (by have hh : 0 < h := hpos; omega)
      (by have hz_eq : z h = 2 * h := rfl; omega) (by
        simpa using hcur)
  rcases hnext with hsame | hprev | hsucc
  · exact ⟨k, by omega, hklo, hkhi, by simpa using hsame⟩
  · by_cases hkmin : k - 1 = 2 * z h
    · have hboundary :
          T.index ⟨r.1 + 1, by omega⟩ =
            R.indexAt (2 * z h) (by
              have hz_eq : z h = 2 * h := rfl
              omega) := by
        simpa [hkmin] using hprev
      exact False.elim (hnot2z hboundary)
    · have hk'lo : 2 * z h < k - 1 := by omega
      have hk'hi : k - 1 < a := by omega
      exact ⟨k - 1, by omega, hk'lo, hk'hi, by simpa using hprev⟩
  · by_cases hkmax : k + 1 = a
    · have hboundary :
          T.index ⟨r.1 + 1, by omega⟩ = R.indexAt a ha_hi := by
        simpa [hkmax] using hsucc
      exact False.elim (hnotA hboundary)
    · have hk'lo : 2 * z h < k + 1 := by omega
      have hk'hi : k + 1 < a := by omega
      exact ⟨k + 1, by omega, hk'lo, hk'hi, by simpa using hsucc⟩

/-- Bounded finite version of
