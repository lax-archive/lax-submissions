/-- Trace-level forced exit for the type-1 last-hit branch.  If a suffix of
the contact trace starts at `P_{z+1}`, ends in the fourth block, and has no
later `P_{2z}` contact, then it must hit `P_0`. -/
theorem exists_p0_index_after_of_pZPlusOne_start
    (T : LinkageContactTrace R Qpath) {hpos : 0 < h}
    {s : ℕ} (hs : s ≤ T.len)
    (hstart :
      T.index ⟨s, Nat.lt_succ_of_le hs⟩ = R.pZPlusOneIndex hpos)
    (hend : T.EndsIn R.block4IndexSet)
    (hno2z : ∀ (n : ℕ) (_hsn : s ≤ n) (hn : n ≤ T.len),
      T.index ⟨n, Nat.lt_succ_of_le hn⟩ ≠ R.pTwoZIndex hpos) :
    ∃ n : ℕ, ∃ _hsn : s ≤ n, ∃ hn : n ≤ T.len,
      T.index ⟨n, Nat.lt_succ_of_le hn⟩ = R.p0Index := by
  classical
  by_contra hno
  have hno0 : ∀ (n : ℕ) (_hsn : s ≤ n) (hn : n ≤ T.len),
      T.index ⟨n, Nat.lt_succ_of_le hn⟩ ≠ R.indexAt 0 (by omega) := by
    intro n hsn hn hidx
    apply hno
    refine ⟨n, hsn, hn, ?_⟩
    simpa [p0Index, p0Pos, indexAt, posOfNat] using hidx
  have hno2z' : ∀ (n : ℕ) (_hsn : s ≤ n) (hn : n ≤ T.len),
      T.index ⟨n, Nat.lt_succ_of_le hn⟩ ≠
        R.indexAt (2 * z h) (by
          have hz_eq : z h = 2 * h := rfl
          omega) := by
    intro n hsn hn hidx
    exact hno2z n hsn hn (by
      simpa [pTwoZIndex, pTwoZPos, indexAt, posOfNat] using hidx)
  have hstart' :
      T.index ⟨s, Nat.lt_succ_of_le hs⟩ =
        R.indexAt (z h + 1) (by
          have hz_eq : z h = 2 * h := rfl
          omega) := by
    simpa [pZPlusOneIndex, pZPlusOnePos, indexAt, posOfNat] using hstart
  let d := T.len - s
  have hsd : s + d ≤ T.len := by
    dsimp [d]
    omega
  rcases T.left_corridor_offset_of_avoids_boundaries
      (R := R) (hpos := hpos) (hs := hs)
      (k := z h + 1)
      (by omega)
      (by
        have hz_eq : z h = 2 * h := rfl
        omega)
      hstart' hno0 hno2z' d hsd with
    ⟨k', hk'_lt, hk'_lo, hk'_hi, hlast_corridor⟩
  have hsd_eq : s + d = T.len := by
    dsimp [d]
    omega
  have hlast_eq :
      T.index ⟨T.len, by omega⟩ = R.indexAt k' hk'_lt := by
    have hfin :
        (⟨T.len, by omega⟩ : Fin (T.len + 1)) =
          ⟨s + d, Nat.lt_succ_of_le hsd⟩ := by
      apply Fin.ext
      simp [hsd_eq]
    simpa [hfin] using hlast_corridor
  have hend_mem :
      T.index ⟨T.len, by omega⟩ ∈ R.block4IndexSet := by
    simpa [EndsIn, lastIndex] using hend
  have hblock4 : R.indexAt k' hk'_lt ∈ R.block4IndexSet := by
    simpa [hlast_eq] using hend_mem
  have hk'_lower := R.indexAt_mem_block4_position_lower hk'_lt hblock4
  have hz_eq : z h = 2 * h := rfl
  omega

/-- A trace segment from `P_{z+1}` down to `P_0` that avoids `P_{2z}` cannot
skip any displayed position in between. -/
theorem exists_displayed_index_between_pZPlusOne_and_p0
    (T : LinkageContactTrace R Qpath) {hpos : 0 < h}
    {s t a : ℕ} (hs : s ≤ T.len) (ht : t ≤ T.len)
    (hst : s ≤ t)
    (ha0 : 0 < a) (haz : a ≤ z h)
    (hstart :
      T.index ⟨s, Nat.lt_succ_of_le hs⟩ = R.pZPlusOneIndex hpos)
    (hend :
      T.index ⟨t, Nat.lt_succ_of_le ht⟩ = R.p0Index)
    (hno2z : ∀ (n : ℕ) (_hsn : s ≤ n) (_hnt : n ≤ t),
      T.index ⟨n, Nat.lt_succ_of_le (le_trans _hnt ht)⟩ ≠
        R.pTwoZIndex hpos) :
    ∃ n : ℕ, ∃ _hsn : s ≤ n, ∃ hnt : n ≤ t,
      T.index ⟨n, Nat.lt_succ_of_le (le_trans hnt ht)⟩ =
        R.indexAt a (by
          have hz_eq : z h = 2 * h := rfl
          omega) := by
  classical
  by_contra hnoA_exists
  have hnoA : ∀ (n : ℕ) (_hsn : s ≤ n) (hnt : n ≤ t),
      T.index ⟨n, Nat.lt_succ_of_le (le_trans hnt ht)⟩ ≠
        R.indexAt a (by
          have hz_eq : z h = 2 * h := rfl
          omega) := by
    intro n hsn hnt hidx
    exact hnoA_exists ⟨n, hsn, hnt, hidx⟩
  have hno2z' : ∀ (n : ℕ) (_hsn : s ≤ n) (hnt : n ≤ t),
      T.index ⟨n, Nat.lt_succ_of_le (le_trans hnt ht)⟩ ≠
        R.indexAt (2 * z h) (by
          have hz_eq : z h = 2 * h := rfl
          omega) := by
    intro n hsn hnt hidx
    exact hno2z n hsn hnt (by
      simpa [pTwoZIndex, pTwoZPos, indexAt, posOfNat] using hidx)
  have hstart' :
      T.index ⟨s, Nat.lt_succ_of_le hs⟩ =
        R.indexAt (z h + 1) (by
          have hz_eq : z h = 2 * h := rfl
          omega) := by
    simpa [pZPlusOneIndex, pZPlusOnePos, indexAt, posOfNat] using hstart
  let d := t - s
  have hsd : s + d ≤ t := by
    dsimp [d]
    omega
  rcases T.between_left_barriers_offset_of_avoids_until
      (R := R) (hpos := hpos) (hu := ht) (hsu := hst)
      (a := a) (k := z h + 1)
      ha0
      (by omega)
      (by omega)
      (by
        have hz_eq : z h = 2 * h := rfl
        omega)
      hstart' hnoA hno2z' d hsd with
    ⟨k', hk'_lt, hk'_lo, hk'_hi, hlast_corridor⟩
  have hsd_eq : s + d = t := by
    dsimp [d]
    omega
  have hlast_eq :
      T.index ⟨t, Nat.lt_succ_of_le ht⟩ = R.indexAt k' hk'_lt := by
    have hfin :
        (⟨t, Nat.lt_succ_of_le ht⟩ : Fin (T.len + 1)) =
          ⟨s + d, Nat.lt_succ_of_le (le_trans hsd ht)⟩ := by
      apply Fin.ext
      simp [hsd_eq]
    simpa [hfin] using hlast_corridor
  have hp0_display :
      T.index ⟨t, Nat.lt_succ_of_le ht⟩ =
        R.indexAt 0 (by omega) := by
    simpa [p0Index, p0Pos, indexAt, posOfNat] using hend
  have heq : R.indexAt k' hk'_lt = R.indexAt 0 (by omega) := by
    exact hlast_eq.symm.trans hp0_display
  have hk'_eq0 := (R.indexAt_eq_indexAt_iff hk'_lt (by omega)).1 heq
  omega

/-- A trace segment from `P_{2z}` up to `P_{3z+1}` that avoids returning to
the middle boundary cannot skip any displayed position of the third block. -/
theorem exists_displayed_index_between_pTwoZ_and_pThreeZPlusOne
    (T : LinkageContactTrace R Qpath) {hpos : 0 < h}
    {s t a : ℕ} (hs : s ≤ T.len) (ht : t ≤ T.len)
    (hst : s ≤ t)
    (ha_lo : 2 * z h < a) (ha_hi : a ≤ 3 * z h)
    (hstart :
      T.index ⟨s, Nat.lt_succ_of_le hs⟩ = R.pTwoZIndex hpos)
    (hend :
      T.index ⟨t, Nat.lt_succ_of_le ht⟩ = R.pThreeZPlusOneIndex hpos)
    (hnoZ : ∀ (n : ℕ) (_hsn : s ≤ n) (_hnt : n ≤ t),
      T.index ⟨n, Nat.lt_succ_of_le (le_trans _hnt ht)⟩ ≠
        R.pZPlusOneIndex hpos)
    (hno2zStrict : ∀ (n : ℕ) (_hsn : s < n) (_hnt : n ≤ t),
      T.index ⟨n, Nat.lt_succ_of_le (le_trans _hnt ht)⟩ ≠
        R.pTwoZIndex hpos) :
    ∃ n : ℕ, ∃ _hsn : s ≤ n, ∃ hnt : n ≤ t,
      T.index ⟨n, Nat.lt_succ_of_le (le_trans hnt ht)⟩ =
        R.indexAt a (by
          have hz_eq : z h = 2 * h := rfl
          omega) := by
  classical
  by_contra hnoA_exists
  have hnoA : ∀ (n : ℕ) (_hsn : s ≤ n) (hnt : n ≤ t),
      T.index ⟨n, Nat.lt_succ_of_le (le_trans hnt ht)⟩ ≠
        R.indexAt a (by
          have hz_eq : z h = 2 * h := rfl
          omega) := by
    intro n hsn hnt hidx
    exact hnoA_exists ⟨n, hsn, hnt, hidx⟩
  have hs_lt_t : s < t := by
    by_contra hnot
    have hst_eq : s = t := by omega
    have hstart_display :
        T.index ⟨s, Nat.lt_succ_of_le hs⟩ =
          R.indexAt (2 * z h) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      simpa [pTwoZIndex, pTwoZPos, indexAt, posOfNat] using hstart
    have hend_display :
        T.index ⟨s, Nat.lt_succ_of_le hs⟩ =
          R.indexAt (3 * z h + 1) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      have hfin :
          (⟨t, Nat.lt_succ_of_le ht⟩ : Fin (T.len + 1)) =
            ⟨s, Nat.lt_succ_of_le hs⟩ := by
        apply Fin.ext
        simp [hst_eq]
      simpa [hfin, pThreeZPlusOneIndex, pThreeZPlusOnePos, indexAt,
        posOfNat] using hend
    have heq :
        R.indexAt (2 * z h) (by
          have hz_eq : z h = 2 * h := rfl
          omega) =
        R.indexAt (3 * z h + 1) (by
          have hz_eq : z h = 2 * h := rfl
          omega) := by
      exact hstart_display.symm.trans hend_display
    have hpos_eq := (R.indexAt_eq_indexAt_iff
      (by have hz_eq : z h = 2 * h := rfl; omega)
      (by have hz_eq : z h = 2 * h := rfl; omega)).1 heq
    have hz_eq : z h = 2 * h := rfl
    omega
  let r0 : Fin T.len := ⟨s, by omega⟩
  have hcur :
      T.index ⟨r0.1, by omega⟩ =
        R.indexAt (2 * z h) (by
          have hz_eq : z h = 2 * h := rfl
          omega) := by
    simpa [r0, pTwoZIndex, pTwoZPos, indexAt, posOfNat] using hstart
  rcases T.next_index_eq_or_neighbor_of_displayed
      (R := R) (r := r0) (k := 2 * z h)
      (by have hz_eq : z h = 2 * h := rfl; omega)
      (by have hz_eq : z h = 2 * h := rfl; omega)
      hcur with hsame | hprev | hsucc
  · have hbad := hno2zStrict (s + 1) (by omega) (by omega)
    exact hbad (by
      simpa [r0, pTwoZIndex, pTwoZPos, indexAt, posOfNat] using hsame)
  · have hstart_left :
        T.index ⟨s + 1, Nat.lt_succ_of_le (by omega)⟩ =
          R.indexAt (2 * z h - 1) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      simpa [r0] using hprev
    have hleft_gt : z h + 1 < 2 * z h - 1 := by
      by_contra hnot
      have hle : 2 * z h - 1 ≤ z h + 1 := Nat.le_of_not_gt hnot
      have heq : 2 * z h - 1 = z h + 1 := by
        have hz_eq : z h = 2 * h := rfl
        omega
      have hidxZ :
          T.index ⟨s + 1, Nat.lt_succ_of_le (by omega)⟩ =
            R.indexAt (z h + 1) (by
              have hz_eq : z h = 2 * h := rfl
              omega) := by
        simpa [heq] using hstart_left
      have hbad := hnoZ (s + 1) (by omega) (by omega)
      exact hbad (by
        simpa [pZPlusOneIndex, pZPlusOnePos, indexAt, posOfNat] using hidxZ)
    have hnoZ_left : ∀ (n : ℕ) (_hsn : s + 1 ≤ n) (hnt : n ≤ t),
        T.index ⟨n, Nat.lt_succ_of_le (le_trans hnt ht)⟩ ≠
          R.indexAt (z h + 1) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      intro n hsn hnt hidx
      exact hnoZ n (by omega) hnt (by
        simpa [pZPlusOneIndex, pZPlusOnePos, indexAt, posOfNat] using hidx)
    have hno2z_left : ∀ (n : ℕ) (_hsn : s + 1 ≤ n) (hnt : n ≤ t),
        T.index ⟨n, Nat.lt_succ_of_le (le_trans hnt ht)⟩ ≠
          R.indexAt (2 * z h) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      intro n hsn hnt hidx
      exact hno2zStrict n (by omega) hnt (by
        simpa [pTwoZIndex, pTwoZPos, indexAt, posOfNat] using hidx)
    let d := t - (s + 1)
    have hsd : s + 1 + d ≤ t := by
      dsimp [d]
      omega
    rcases T.between_left_barriers_offset_of_avoids_until
        (R := R) (hpos := hpos) (hu := ht) (hsu := by omega)
        (a := z h + 1) (k := 2 * z h - 1)
        (by omega)
        (by have hz_eq : z h = 2 * h := rfl; omega)
        hleft_gt
        (by have hz_eq : z h = 2 * h := rfl; omega)
        hstart_left hnoZ_left hno2z_left d hsd with
      ⟨k', hk'_lt, _hk'_lo, hk'_hi, hlast⟩
    have hsd_eq : s + 1 + d = t := by
      dsimp [d]
      omega
    have hlast_eq :
        T.index ⟨t, Nat.lt_succ_of_le ht⟩ = R.indexAt k' hk'_lt := by
      have hfin :
          (⟨t, Nat.lt_succ_of_le ht⟩ : Fin (T.len + 1)) =
            ⟨s + 1 + d, Nat.lt_succ_of_le (le_trans hsd ht)⟩ := by
        apply Fin.ext
        simp [hsd_eq]
      simpa [hfin] using hlast
    have hend_display :
        T.index ⟨t, Nat.lt_succ_of_le ht⟩ =
          R.indexAt (3 * z h + 1) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      simpa [pThreeZPlusOneIndex, pThreeZPlusOnePos, indexAt, posOfNat] using hend
    have heq :
        R.indexAt k' hk'_lt =
          R.indexAt (3 * z h + 1) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      exact hlast_eq.symm.trans hend_display
    have hk'_eq := (R.indexAt_eq_indexAt_iff hk'_lt
      (by have hz_eq : z h = 2 * h := rfl; omega)).1 heq
    have hz_eq : z h = 2 * h := rfl
    omega
  · have hstart_right :
        T.index ⟨s + 1, Nat.lt_succ_of_le (by omega)⟩ =
          R.indexAt (2 * z h + 1) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      simpa [r0] using hsucc
    by_cases ha_first : a = 2 * z h + 1
    · have hbad := hnoA (s + 1) (by omega) (by omega)
      exact hbad (by
        simpa [ha_first] using hstart_right)
    have ha_first_lt : 2 * z h + 1 < a := by omega
    have hno2z_right : ∀ (n : ℕ) (_hsn : s + 1 ≤ n) (hnt : n ≤ t),
        T.index ⟨n, Nat.lt_succ_of_le (le_trans hnt ht)⟩ ≠
          R.indexAt (2 * z h) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      intro n hsn hnt hidx
      exact hno2zStrict n (by omega) hnt (by
        simpa [pTwoZIndex, pTwoZPos, indexAt, posOfNat] using hidx)
    let ha_lt : a < 8 * h + 1 := by
      have hz_eq : z h = 2 * h := rfl
      omega
    have hnoA_right : ∀ (n : ℕ) (_hsn : s + 1 ≤ n) (hnt : n ≤ t),
        T.index ⟨n, Nat.lt_succ_of_le (le_trans hnt ht)⟩ ≠
          R.indexAt a ha_lt := by
      intro n hsn hnt hidx
      exact hnoA n (by omega) hnt (by
        simpa using hidx)
    let d := t - (s + 1)
    have hsd : s + 1 + d ≤ t := by
      dsimp [d]
      omega
    rcases T.between_right_barriers_offset_of_avoids_until
        (R := R) (hpos := hpos) (hu := ht) (hsu := by omega)
        (a := a) (k := 2 * z h + 1)
        ha_lo ha_lt
        (by omega) ha_first_lt
        hstart_right hno2z_right hnoA_right d hsd with
      ⟨k', hk'_lt, _hk'_lo, hk'_hi, hlast⟩
    have hsd_eq : s + 1 + d = t := by
      dsimp [d]
      omega
    have hlast_eq :
        T.index ⟨t, Nat.lt_succ_of_le ht⟩ = R.indexAt k' hk'_lt := by
      have hfin :
          (⟨t, Nat.lt_succ_of_le ht⟩ : Fin (T.len + 1)) =
            ⟨s + 1 + d, Nat.lt_succ_of_le (le_trans hsd ht)⟩ := by
        apply Fin.ext
        simp [hsd_eq]
      simpa [hfin] using hlast
    have hend_display :
        T.index ⟨t, Nat.lt_succ_of_le ht⟩ =
          R.indexAt (3 * z h + 1) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      simpa [pThreeZPlusOneIndex, pThreeZPlusOnePos, indexAt, posOfNat] using hend
    have heq :
        R.indexAt k' hk'_lt =
          R.indexAt (3 * z h + 1) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      exact hlast_eq.symm.trans hend_display
    have hk'_eq := (R.indexAt_eq_indexAt_iff hk'_lt
      (by have hz_eq : z h = 2 * h := rfl; omega)).1 heq
    have hz_eq : z h = 2 * h := rfl
    omega

/-- Every strict internal contact of a trace segment from `P_{2z}` to
`P_{3z+1}` lies in the displayed third-block corridor, provided the segment
does not return to the middle boundary and has not yet reached `P_{3z+1}`. -/
theorem displayed_right_corridor_of_between_pTwoZ_and_pThreeZPlusOne
    (T : LinkageContactTrace R Qpath) {hpos : 0 < h}
    {s t n : ℕ} (hs : s ≤ T.len) (ht : t ≤ T.len)
    (hst : s ≤ t) (hsn : s < n) (hnt : n < t)
    (hstart :
      T.index ⟨s, Nat.lt_succ_of_le hs⟩ = R.pTwoZIndex hpos)
    (hend :
      T.index ⟨t, Nat.lt_succ_of_le ht⟩ = R.pThreeZPlusOneIndex hpos)
    (hnoZ : ∀ (m : ℕ) (_hsm : s ≤ m) (_hmt : m ≤ t),
      T.index ⟨m, Nat.lt_succ_of_le (le_trans _hmt ht)⟩ ≠
        R.pZPlusOneIndex hpos)
    (hno2zStrict : ∀ (m : ℕ) (_hsm : s < m) (_hmt : m ≤ t),
      T.index ⟨m, Nat.lt_succ_of_le (le_trans _hmt ht)⟩ ≠
        R.pTwoZIndex hpos)
    (hno3Strict : ∀ (m : ℕ) (_hsm : s ≤ m) (_hmt : m < t),
      T.index ⟨m, by omega⟩ ≠ R.pThreeZPlusOneIndex hpos) :
    ∃ k : ℕ, ∃ hk : k < 8 * h + 1, 2 * z h < k ∧ k ≤ 3 * z h ∧
      T.index ⟨n, Nat.lt_succ_of_le (le_trans (le_of_lt hnt) ht)⟩ =
        R.indexAt k hk := by
  classical
  let r0 : Fin T.len := ⟨s, by omega⟩
  have hcur :
      T.index ⟨r0.1, by omega⟩ =
        R.indexAt (2 * z h) (by
          have hz_eq : z h = 2 * h := rfl
          omega) := by
    simpa [r0, pTwoZIndex, pTwoZPos, indexAt, posOfNat] using hstart
  rcases T.next_index_eq_or_neighbor_of_displayed
      (R := R) (r := r0) (k := 2 * z h)
      (by have hz_eq : z h = 2 * h := rfl; omega)
      (by have hz_eq : z h = 2 * h := rfl; omega)
      hcur with hsame | hprev | hsucc
  · have hbad := hno2zStrict (s + 1) (by omega) (by omega)
    exact False.elim (hbad (by
      simpa [r0, pTwoZIndex, pTwoZPos, indexAt, posOfNat] using hsame))
  · have hstart_left :
        T.index ⟨s + 1, Nat.lt_succ_of_le (by omega)⟩ =
          R.indexAt (2 * z h - 1) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      simpa [r0] using hprev
    have hleft_gt : z h + 1 < 2 * z h - 1 := by
      by_contra hnot
      have hle : 2 * z h - 1 ≤ z h + 1 := Nat.le_of_not_gt hnot
      have heq : 2 * z h - 1 = z h + 1 := by
        have hz_eq : z h = 2 * h := rfl
        omega
      have hidxZ :
          T.index ⟨s + 1, Nat.lt_succ_of_le (by omega)⟩ =
            R.indexAt (z h + 1) (by
              have hz_eq : z h = 2 * h := rfl
              omega) := by
        simpa [heq] using hstart_left
      have hbad := hnoZ (s + 1) (by omega) (by omega)
      exact hbad (by
        simpa [pZPlusOneIndex, pZPlusOnePos, indexAt, posOfNat] using hidxZ)
    have hnoZ_left : ∀ (m : ℕ) (_hsm : s + 1 ≤ m) (hmt : m ≤ t),
        T.index ⟨m, Nat.lt_succ_of_le (le_trans hmt ht)⟩ ≠
          R.indexAt (z h + 1) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      intro m hsm hmt hidx
      exact hnoZ m (by omega) hmt (by
        simpa [pZPlusOneIndex, pZPlusOnePos, indexAt, posOfNat] using hidx)
    have hno2z_left : ∀ (m : ℕ) (_hsm : s + 1 ≤ m) (hmt : m ≤ t),
        T.index ⟨m, Nat.lt_succ_of_le (le_trans hmt ht)⟩ ≠
          R.indexAt (2 * z h) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      intro m hsm hmt hidx
      exact hno2zStrict m (by omega) hmt (by
        simpa [pTwoZIndex, pTwoZPos, indexAt, posOfNat] using hidx)
    let d := t - (s + 1)
    have hsd : s + 1 + d ≤ t := by
      dsimp [d]
      omega
    rcases T.between_left_barriers_offset_of_avoids_until
        (R := R) (hpos := hpos) (hu := ht) (hsu := by omega)
        (a := z h + 1) (k := 2 * z h - 1)
        (by omega)
        (by have hz_eq : z h = 2 * h := rfl; omega)
        hleft_gt
        (by have hz_eq : z h = 2 * h := rfl; omega)
        hstart_left hnoZ_left hno2z_left d hsd with
      ⟨k', hk'_lt, _hk'_lo, hk'_hi, hlast⟩
    have hsd_eq : s + 1 + d = t := by
      dsimp [d]
      omega
    have hlast_eq :
        T.index ⟨t, Nat.lt_succ_of_le ht⟩ = R.indexAt k' hk'_lt := by
      have hfin :
          (⟨t, Nat.lt_succ_of_le ht⟩ : Fin (T.len + 1)) =
            ⟨s + 1 + d, Nat.lt_succ_of_le (le_trans hsd ht)⟩ := by
        apply Fin.ext
        simp [hsd_eq]
      simpa [hfin] using hlast
    have hend_display :
        T.index ⟨t, Nat.lt_succ_of_le ht⟩ =
          R.indexAt (3 * z h + 1) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      simpa [pThreeZPlusOneIndex, pThreeZPlusOnePos, indexAt, posOfNat] using hend
    have heq :
        R.indexAt k' hk'_lt =
          R.indexAt (3 * z h + 1) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := hlast_eq.symm.trans hend_display
    have hk'_eq := (R.indexAt_eq_indexAt_iff hk'_lt
      (by have hz_eq : z h = 2 * h := rfl; omega)).1 heq
    have hz_eq : z h = 2 * h := rfl
    omega
  · have hstart_right :
        T.index ⟨s + 1, Nat.lt_succ_of_le (by omega)⟩ =
          R.indexAt (2 * z h + 1) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      simpa [r0] using hsucc
    have hno2z_right : ∀ (m : ℕ) (_hsm : s + 1 ≤ m) (hmn : m ≤ n),
        T.index ⟨m, Nat.lt_succ_of_le (le_trans hmn
          (le_trans (le_of_lt hnt) ht))⟩ ≠
          R.indexAt (2 * z h) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      intro m hsm hmn hidx
      exact hno2zStrict m (by omega) (le_trans hmn (le_of_lt hnt)) (by
        simpa [pTwoZIndex, pTwoZPos, indexAt, posOfNat] using hidx)
    have hno3_right : ∀ (m : ℕ) (_hsm : s + 1 ≤ m) (hmn : m ≤ n),
        T.index ⟨m, Nat.lt_succ_of_le (le_trans hmn
          (le_trans (le_of_lt hnt) ht))⟩ ≠
          R.indexAt (3 * z h + 1) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      intro m hsm hmn hidx
      exact hno3Strict m (by omega) (lt_of_le_of_lt hmn hnt) (by
        simpa [pThreeZPlusOneIndex, pThreeZPlusOnePos, indexAt, posOfNat] using hidx)
    let d := n - (s + 1)
    have hsd : s + 1 + d ≤ n := by
      dsimp [d]
      omega
    rcases T.between_right_barriers_offset_of_avoids_until
        (R := R) (hpos := hpos)
        (hu := le_trans (le_of_lt hnt) ht) (hsu := by omega)
        (a := 3 * z h + 1) (k := 2 * z h + 1)
        (by have hz_eq : z h = 2 * h := rfl; omega)
        (by have hz_eq : z h = 2 * h := rfl; omega)
        (by omega)
        (by have hz_eq : z h = 2 * h := rfl; omega)
        hstart_right hno2z_right hno3_right d hsd with
      ⟨k', hk'_lt, hk'_lo, hk'_hi, hidx⟩
    have hsd_eq : s + 1 + d = n := by
      dsimp [d]
      omega
    exact ⟨k', hk'_lt, hk'_lo, by
      have hz_eq : z h = 2 * h := rfl
      omega, by
      have hfin :
          (⟨n, Nat.lt_succ_of_le (le_trans (le_of_lt hnt) ht)⟩ :
            Fin (T.len + 1)) =
            ⟨s + 1 + d,
              Nat.lt_succ_of_le (le_trans hsd (le_trans (le_of_lt hnt) ht))⟩ := by
        apply Fin.ext
        simp [hsd_eq]
      simpa [hfin] using hidx⟩

/-- A contact trace starting in the second displayed block and ending in the
fourth displayed block must hit one of the two middle-boundary paths
`P_{z+1}` or `P_{2z}`.  This is the non-displayed-trace version needed before
the last-hit split. -/
theorem hitsMiddleBoundary_of_startsIn_block2_endsIn_block4
    (T : LinkageContactTrace R Qpath) {hpos : 0 < h}
    (hstart : T.StartsIn R.block2IndexSet)
    (hend : T.EndsIn R.block4IndexSet) :
    HitsLinkagePath Qpath (R.pZPlusOneIndex hpos) ∨
      HitsLinkagePath Qpath (R.pTwoZIndex hpos) := by
  classical
  by_contra hnohit
  have hnoZ : ∀ (n : ℕ) (_hn : n ≤ T.len),
      T.index ⟨n, Nat.lt_succ_of_le _hn⟩ ≠ R.pZPlusOneIndex hpos := by
    intro n hn hidx
    exact hnohit (Or.inl (T.hits_of_index_eq hidx))
  have hno2z : ∀ (n : ℕ) (_hn : n ≤ T.len),
      T.index ⟨n, Nat.lt_succ_of_le _hn⟩ ≠ R.pTwoZIndex hpos := by
    intro n hn hidx
    exact hnohit (Or.inr (T.hits_of_index_eq hidx))
  have hfirst_mem :
      T.index ⟨0, by omega⟩ ∈ R.block2IndexSet := by
    simpa [StartsIn, firstIndex] using hstart
  rw [R.mem_block2IndexSet_iff] at hfirst_mem
  rcases hfirst_mem with ⟨i, hfirst_eq⟩
  let k : ℕ := z h + 1 + i.1
  have hk_lt : k < 8 * h + 1 := by
    have hi : i.1 < z h := i.2
    have hz_eq : z h = 2 * h := rfl
    omega
  have hfirst_display :
      T.index ⟨0, by omega⟩ = R.indexAt k hk_lt := by
    simpa [k] using hfirst_eq.trans (R.block2_index_eq_indexAt i)
  have hklo : z h + 1 ≤ k := by dsimp [k]; omega
  have hkhi : k ≤ 2 * z h := by
    have hi : i.1 < z h := i.2
    dsimp [k]
    omega
  by_cases hk_left : k = z h + 1
  · have hidxZ :
        T.index ⟨0, by omega⟩ = R.pZPlusOneIndex hpos := by
      rw [hfirst_display]
      have htarget_lt : z h + 1 < 8 * h + 1 := by
        have hz_eq : z h = 2 * h := rfl
        omega
      have hidx :
          R.indexAt k hk_lt = R.indexAt (z h + 1) htarget_lt :=
        (R.indexAt_eq_indexAt_iff hk_lt htarget_lt).2 hk_left
      rw [hidx]
      rfl
    exact hnoZ 0 (by omega) hidxZ
  by_cases hk_right : k = 2 * z h
  · have hidx2z :
        T.index ⟨0, by omega⟩ = R.pTwoZIndex hpos := by
      rw [hfirst_display]
      have htarget_lt : 2 * z h < 8 * h + 1 := by
        have hz_eq : z h = 2 * h := rfl
        omega
      have hidx :
          R.indexAt k hk_lt = R.indexAt (2 * z h) htarget_lt :=
        (R.indexAt_eq_indexAt_iff hk_lt htarget_lt).2 hk_right
      rw [hidx]
      rfl
    exact hno2z 0 (by omega) hidx2z
  have hkgt : z h + 1 < k := by omega
  have hklt : k < 2 * z h := by omega
  have hnoZ' : ∀ (n : ℕ) (_hsn : 0 ≤ n) (hn : n ≤ T.len),
      T.index ⟨n, Nat.lt_succ_of_le hn⟩ ≠
        R.indexAt (z h + 1) (by
          have hz_eq : z h = 2 * h := rfl
          omega) := by
    intro n _ hn hidx
    exact hnoZ n hn (by
      simpa [pZPlusOneIndex, pZPlusOnePos, indexAt, posOfNat] using hidx)
  have hno2z' : ∀ (n : ℕ) (_hsn : 0 ≤ n) (hn : n ≤ T.len),
      T.index ⟨n, Nat.lt_succ_of_le hn⟩ ≠
        R.indexAt (2 * z h) (by
          have hz_eq : z h = 2 * h := rfl
          omega) := by
    intro n _ hn hidx
    exact hno2z n hn (by
      simpa [pTwoZIndex, pTwoZPos, indexAt, posOfNat] using hidx)
  rcases T.between_left_barriers_offset_of_avoids
      (R := R) (hpos := hpos) (hs := by omega)
      (a := z h + 1) (k := k)
      (by omega)
      (by have hz_eq : z h = 2 * h := rfl; omega)
      hkgt hklt
      hfirst_display hnoZ' hno2z' T.len (by omega) with
    ⟨k', hk'_lt, _hk'_lo, hk'_hi, hlast⟩
  have hlast_eq :
      T.index ⟨T.len, by omega⟩ = R.indexAt k' hk'_lt := by
    simpa using hlast
  have hend_mem :
      T.index ⟨T.len, by omega⟩ ∈ R.block4IndexSet := by
    simpa [EndsIn, lastIndex] using hend
  have hblock4 : R.indexAt k' hk'_lt ∈ R.block4IndexSet := by
    simpa [hlast_eq] using hend_mem
  have hk'_lower := R.indexAt_mem_block4_position_lower hk'_lt hblock4
  have hz_eq : z h = 2 * h := rfl
  omega

/-- The auxiliary indices recorded by a linkage-contact trace form a walk in
the linkage auxiliary graph. -/
theorem reachable_firstIndex_lastIndex
    (T : LinkageContactTrace R Qpath) :
    (linkageAuxGraph L).Reachable T.firstIndex T.lastIndex := by
  simpa [firstIndex, lastIndex] using
    reachable_of_auxiliary_index_trace_steps
      (L := L) (idx := T.index) T.consecutive_aux_step

end LinkageContactTrace

namespace CompleteLinkageContactTrace

variable {R : IndexedAuxiliaryPrefix L h} {Qpath : GraphPath G}

/-- A complete trace hits a linkage path exactly when one of its recorded
auxiliary indices is that linkage path.  The forward direction is the extra
coverage information carried by `contact_complete`; the reverse direction is
the basic contact witness. -/
theorem hitsLinkagePath_iff_exists_index
    (T : CompleteLinkageContactTrace R Qpath) {j : L.Index} :
    HitsLinkagePath Qpath j ↔
      ∃ r : Fin (T.len + 1), T.index r = j := by
  constructor
  · rintro ⟨v, hv⟩
    rcases Finset.mem_inter.1 hv with ⟨hvQ, hvj⟩
    have hvL : v ∈ L.toPathPacking.vertexSet :=
      (L.toPathPacking.mem_vertexSet).2 ⟨j, hvj⟩
    rcases T.contact_complete hvQ hvL with ⟨r, hrv⟩
    refine ⟨r, ?_⟩
    by_contra hne
    have hmem_idx :
        v ∈ (L.path (T.index r)).vertexSet := by
      simpa [hrv] using T.contact_mem_linkage r
    exact Finset.disjoint_left.mp (L.toPathPacking.node_disjoint hne)
      hmem_idx hvj
  · rintro ⟨r, hr⟩
    exact T.toLinkageContactTrace.hits_of_index_eq hr

/-- If no recorded contact of a complete trace has index `j`, then the whole
underlying path is disjoint from the `j`-th linkage path. -/
theorem disjoint_linkagePath_of_forall_index_ne
    (T : CompleteLinkageContactTrace R Qpath) {j : L.Index}
    (hno : ∀ r : Fin (T.len + 1), T.index r ≠ j) :
    Disjoint Qpath.vertexSet (L.path j).vertexSet := by
  rw [Finset.disjoint_left]
  intro v hvQ hvj
  have hhit : HitsLinkagePath Qpath j :=
    ⟨v, Finset.mem_inter.2 ⟨hvQ, hvj⟩⟩
  rcases (T.hitsLinkagePath_iff_exists_index).1 hhit with ⟨r, hr⟩
  exact hno r hr

/-- A recorded contact determines its linkage index uniquely. -/
theorem index_eq_of_contact_mem
    (T : CompleteLinkageContactTrace R Qpath)
    {r : Fin (T.len + 1)} {j : L.Index}
    (hj : T.contact r ∈ (L.path j).vertexSet) :
    T.index r = j := by
  by_contra hne
  exact Finset.disjoint_left.mp (L.toPathPacking.node_disjoint hne)
    (T.contact_mem_linkage r) hj

/-- The graph segment between two consecutive contacts has the expected source
linkage endpoint. -/
theorem consecutive_segment_source_mem
    (T : CompleteLinkageContactTrace R Qpath) (r : Fin T.len) :
    (Qpath.segmentOfBefore (T.contact_monotone r)).source ∈
      (L.path (T.index ⟨r.1, by omega⟩)).vertexSet := by
  simpa using T.contact_mem_linkage ⟨r.1, by omega⟩

/-- The graph segment between two consecutive contacts has the expected target
linkage endpoint. -/
theorem consecutive_segment_target_mem
    (T : CompleteLinkageContactTrace R Qpath) (r : Fin T.len) :
    (Qpath.segmentOfBefore (T.contact_monotone r)).target ∈
      (L.path (T.index ⟨r.1 + 1, by omega⟩)).vertexSet := by
  simpa using T.contact_mem_linkage ⟨r.1 + 1, by omega⟩

/-- The clean consecutive-contact segment independently yields the auxiliary
step stored in the trace.  This lemma is useful when a complete trace is
constructed first and the auxiliary walk data is derived afterward. -/
theorem consecutive_aux_step_of_clean
    (T : CompleteLinkageContactTrace R Qpath) (r : Fin T.len) :
    T.index ⟨r.1, by omega⟩ =
        T.index ⟨r.1 + 1, by omega⟩ ∨
      (linkageAuxGraph L).Adj
        (T.index ⟨r.1, by omega⟩)
        (T.index ⟨r.1 + 1, by omega⟩) := by
  exact aux_adj_or_eq_of_clean_segment
    (L := L)
    (Qpath.segmentOfBefore (T.contact_monotone r))
    (T.consecutive_segment_source_mem r)
    (T.consecutive_segment_target_mem r)
    (T.consecutive_clean r)

end CompleteLinkageContactTrace

namespace DisplayedContactTrace

variable {R : IndexedAuxiliaryPrefix L h} {Qpath : GraphPath G}

/-- A displayed trace visits every displayed position between its first and
last positions. -/
theorem hitsDisplayedPosition_of_between
    (T : DisplayedContactTrace R Qpath)
    {k : ℕ} (hk : k < 8 * h + 1)
    (hfirst : T.pos ⟨0, by omega⟩ ≤ k)
    (hlast : k ≤ T.pos ⟨T.len, by omega⟩) :
    T.toLinkageContactTrace.HitsDisplayedPosition k hk := by
  rcases UnitStepNatTrace.exists_eq_of_le
      (f := T.pos) T.unit_step hfirst hlast with ⟨r, hr⟩
  refine ⟨r, ?_⟩
  have hidx := T.index_eq_pos r
  have hkpos : T.pos r = k := hr
  subst hkpos
  simpa using hidx

/-- Decreasing-direction version of
`hitsDisplayedPosition_of_between`. -/
theorem hitsDisplayedPosition_of_between_downwards
    (T : DisplayedContactTrace R Qpath)
    {k : ℕ} (hk : k < 8 * h + 1)
    (hfirst : k ≤ T.pos ⟨0, by omega⟩)
    (hlast : T.pos ⟨T.len, by omega⟩ ≤ k) :
    T.toLinkageContactTrace.HitsDisplayedPosition k hk := by
  rcases UnitStepNatTrace.exists_eq_of_ge
      (f := T.pos) T.unit_step hfirst hlast with ⟨r, hr⟩
  refine ⟨r, ?_⟩
  have hidx := T.index_eq_pos r
  have hkpos : T.pos r = k := hr
  subst hkpos
  simpa using hidx

end DisplayedContactTrace

/-- The contact trace of a path in the transversal packing starts in the second
displayed block `P₂`. -/
theorem LinkageContactTrace.startsIn_block2_of_transversal
    {R : IndexedAuxiliaryPrefix L h}
    {Qpack : PerfectPathPacking G R.X R.Y} (q : Qpack.Index)
    (T : LinkageContactTrace R (Qpack.path q)) :
    T.StartsIn R.block2IndexSet := by
  rcases R.transversal_source_hits_block2 (Qpack := Qpack) q with
    ⟨j, hj, hsource⟩
  have hfirst := T.firstIndex_eq_of_source_mem hsource
  simpa [LinkageContactTrace.StartsIn, hfirst]
    using hj

/-- The contact trace of a path in the transversal packing ends in the fourth
displayed block `P₄`. -/
theorem LinkageContactTrace.endsIn_block4_of_transversal
    {R : IndexedAuxiliaryPrefix L h}
    {Qpack : PerfectPathPacking G R.X R.Y} (q : Qpack.Index)
    (T : LinkageContactTrace R (Qpack.path q)) :
    T.EndsIn R.block4IndexSet := by
  rcases R.transversal_target_hits_block4 (Qpack := Qpack) q with
    ⟨j, hj, htarget⟩
  have hlast := T.lastIndex_eq_of_target_mem htarget
  simpa [LinkageContactTrace.EndsIn, hlast]
    using hj

/-- The path `Q` intersects every path in the first block `P_1`. -/
def HitsBlock1 (R : IndexedAuxiliaryPrefix L h) (Q : GraphPath G) : Prop :=
  ∀ i : Fin (z h),
    HitsLinkagePath Q (R.index (windowPos h 1 (by
      dsimp [z]
      omega) i))

/-- The path `Q` intersects every path in the third block `P_3`. -/
def HitsBlock3 (R : IndexedAuxiliaryPrefix L h) (Q : GraphPath G) : Prop :=
  ∀ i : Fin (z h),
    HitsLinkagePath Q (R.index (windowPos h (2 * z h + 1) (by
      dsimp [z]
      omega) i))

namespace LinkageContactTrace

variable {R : IndexedAuxiliaryPrefix L h} {Qpath : GraphPath G}

/-- If the trace visits every displayed position in the first block, then the
underlying graph path hits `P₁`. -/
theorem hitsBlock1_of_hits_displayed_positions
    (T : LinkageContactTrace R Qpath)
    (hhit : ∀ i : Fin (z h),
      T.HitsDisplayedPosition (1 + i.1) (by
        have hi : i.1 < z h := i.2
        dsimp [z] at hi ⊢
        omega)) :
    R.HitsBlock1 Qpath := by
  intro i
  have hpath :=
    T.hitsLinkagePath_of_hitsDisplayedPosition (hhit i)
  simpa [R.block1_index_eq_indexAt i] using hpath

/-- If the trace visits every displayed position in the third block, then the
underlying graph path hits `P₃`. -/
theorem hitsBlock3_of_hits_displayed_positions
    (T : LinkageContactTrace R Qpath)
    (hhit : ∀ i : Fin (z h),
      T.HitsDisplayedPosition (2 * z h + 1 + i.1) (by
        have hi : i.1 < z h := i.2
        dsimp [z] at hi ⊢
        omega)) :
    R.HitsBlock3 Qpath := by
  intro i
  have hpath :=
    T.hitsLinkagePath_of_hitsDisplayedPosition (hhit i)
  simpa [R.block3_index_eq_indexAt i] using hpath

end LinkageContactTrace

/-- The dichotomy stated at the start of the second paragraph: a transversal
path hits all rows in `P_1` or all rows in `P_3` before reaching `Y`.  The
"before reaching `Y`" order information will be added when subpaths are
formalized; this proposition records the block-hit content of the sentence. -/
def Page59BlockDichotomy (R : IndexedAuxiliaryPrefix L h)
    (Q : GraphPath G) : Prop :=
  R.HitsBlock1 Q ∨ R.HitsBlock3 Q

/-- The boundary consequence stated after the block dichotomy: the path meets
`P_{z+1}` or `P_{2z}`. -/
def HitsMiddleBoundary (R : IndexedAuxiliaryPrefix L h)
    (hpos : 0 < h) (Q : GraphPath G) : Prop :=
  HitsLinkagePath Q (R.pZPlusOneIndex hpos) ∨
    HitsLinkagePath Q (R.pTwoZIndex hpos)

namespace LinkageContactTrace

variable {R : IndexedAuxiliaryPrefix L h} {Qpath : GraphPath G}

/-- The trace-level block dichotomy implies the graph-path block dichotomy. -/
theorem page59BlockDichotomy_of_positionBlockDichotomy
    (T : LinkageContactTrace R Qpath)
    (h : T.PositionBlockDichotomy) :
    Page59BlockDichotomy R Qpath := by
  rcases h with h1 | h3
  · exact Or.inl (T.hitsBlock1_of_hits_displayed_positions h1)
  · exact Or.inr (T.hitsBlock3_of_hits_displayed_positions h3)

/-- The trace-level middle-boundary hit implies the graph-path middle-boundary
hit. -/
theorem hitsMiddleBoundary_of_middleBoundaryPositionHit
    (T : LinkageContactTrace R Qpath) {hpos : 0 < h}
    (h : T.MiddleBoundaryPositionHit hpos) :
    HitsMiddleBoundary R hpos Qpath := by
  rcases h with hz1 | h2z
  · left
    have hpath := T.hitsLinkagePath_of_hitsDisplayedPosition hz1
    simpa [pZPlusOneIndex, pZPlusOnePos, indexAt, posOfNat] using hpath
  · right
    have hpath := T.hitsLinkagePath_of_hitsDisplayedPosition h2z
    simpa [pTwoZIndex, pTwoZPos, indexAt, posOfNat] using hpath

end LinkageContactTrace

namespace DisplayedContactTrace

variable {R : IndexedAuxiliaryPrefix L h} {Qpath : GraphPath G}

/-- If a displayed trace starts no later than `P_{2z}` and ends at or beyond
`P_{3z}`, then the underlying graph path hits every path in the third block. -/
theorem hitsBlock3_of_crosses_third_block
    (T : DisplayedContactTrace R Qpath)
    (hstart : T.pos ⟨0, by omega⟩ ≤ 2 * z h)
    (hend : 3 * z h ≤ T.pos ⟨T.len, by omega⟩) :
    R.HitsBlock3 Qpath := by
  refine T.toLinkageContactTrace.hitsBlock3_of_hits_displayed_positions ?_
  intro i
  exact T.hitsDisplayedPosition_of_between (by
      have hi : i.1 < z h := i.2
      dsimp [z] at hi ⊢
      omega)
    (by
      have hi : i.1 < z h := i.2
      dsimp [z] at hi hstart ⊢
      omega)
    (by
      have hi : i.1 < z h := i.2
      dsimp [z] at hi hend ⊢
      omega)

/-- A displayed contact trace that starts in `P₂` and ends in `P₄` must cross
the whole third block. -/
theorem hitsBlock3_of_startsIn_block2_endsIn_block4
    (T : DisplayedContactTrace R Qpath)
    (hstart : T.toLinkageContactTrace.StartsIn R.block2IndexSet)
    (hend : T.toLinkageContactTrace.EndsIn R.block4IndexSet) :
    R.HitsBlock3 Qpath := by
  have hstart_mem :
      R.indexAt (T.pos ⟨0, by omega⟩) (T.pos_lt ⟨0, by omega⟩) ∈
        R.block2IndexSet := by
    have hidx : T.index ⟨0, by omega⟩ ∈ R.block2IndexSet := by
      simpa [LinkageContactTrace.StartsIn,
        LinkageContactTrace.firstIndex] using hstart
    rw [← T.index_eq_pos ⟨0, by omega⟩]
    exact hidx
  have hend_mem :
      R.indexAt (T.pos ⟨T.len, by omega⟩) (T.pos_lt ⟨T.len, by omega⟩) ∈
        R.block4IndexSet := by
    have hidx : T.index ⟨T.len, by omega⟩ ∈ R.block4IndexSet := by
      simpa [LinkageContactTrace.EndsIn,
        LinkageContactTrace.lastIndex] using hend
    rw [← T.index_eq_pos ⟨T.len, by omega⟩]
    exact hidx
  have hstart_range :=
    R.indexAt_mem_block2_position_range (T.pos_lt ⟨0, by omega⟩) hstart_mem
  have hend_lower :=
    R.indexAt_mem_block4_position_lower (T.pos_lt ⟨T.len, by omega⟩) hend_mem
  exact T.hitsBlock3_of_crosses_third_block
    (by exact hstart_range.2)
    (by omega)

/-- A displayed contact trace from `P₂` to `P₄` visits the middle boundary
`P_{2z}`.  This is the precise trace-level form of the sentence immediately
after the page-59 block dichotomy. -/
theorem middleBoundaryPositionHit_of_startsIn_block2_endsIn_block4
    (T : DisplayedContactTrace R Qpath) {hpos : 0 < h}
    (hstart : T.toLinkageContactTrace.StartsIn R.block2IndexSet)
    (hend : T.toLinkageContactTrace.EndsIn R.block4IndexSet) :
    T.toLinkageContactTrace.MiddleBoundaryPositionHit hpos := by
  have hstart_mem :
      R.indexAt (T.pos ⟨0, by omega⟩) (T.pos_lt ⟨0, by omega⟩) ∈
        R.block2IndexSet := by
    have hidx : T.index ⟨0, by omega⟩ ∈ R.block2IndexSet := by
      simpa [LinkageContactTrace.StartsIn,
        LinkageContactTrace.firstIndex] using hstart
    rw [← T.index_eq_pos ⟨0, by omega⟩]
    exact hidx
  have hend_mem :
      R.indexAt (T.pos ⟨T.len, by omega⟩) (T.pos_lt ⟨T.len, by omega⟩) ∈
        R.block4IndexSet := by
    have hidx : T.index ⟨T.len, by omega⟩ ∈ R.block4IndexSet := by
      simpa [LinkageContactTrace.EndsIn,
        LinkageContactTrace.lastIndex] using hend
    rw [← T.index_eq_pos ⟨T.len, by omega⟩]
    exact hidx
  have hstart_range :=
    R.indexAt_mem_block2_position_range (T.pos_lt ⟨0, by omega⟩) hstart_mem
  have hend_lower :=
    R.indexAt_mem_block4_position_lower (T.pos_lt ⟨T.len, by omega⟩) hend_mem
  right
  exact T.hitsDisplayedPosition_of_between (by dsimp [z]; omega)
    (by exact hstart_range.2)
    (by omega)

/-- The displayed-trace version of the page-59 block dichotomy for an
`X`--`Y` transversal path: it is in the second alternative, because a displayed
trace from `P₂` to `P₄` crosses all of `P₃`. -/
theorem page59BlockDichotomy_of_startsIn_block2_endsIn_block4
    (T : DisplayedContactTrace R Qpath)
    (hstart : T.toLinkageContactTrace.StartsIn R.block2IndexSet)
    (hend : T.toLinkageContactTrace.EndsIn R.block4IndexSet) :
    Page59BlockDichotomy R Qpath := by
  exact Or.inr (T.hitsBlock3_of_startsIn_block2_endsIn_block4 hstart hend)

/-- The graph-path middle-boundary consequence of a displayed trace from
`P₂` to `P₄`. -/
theorem hitsMiddleBoundary_of_startsIn_block2_endsIn_block4
    (T : DisplayedContactTrace R Qpath) {hpos : 0 < h}
    (hstart : T.toLinkageContactTrace.StartsIn R.block2IndexSet)
    (hend : T.toLinkageContactTrace.EndsIn R.block4IndexSet) :
    HitsMiddleBoundary R hpos Qpath :=
  T.toLinkageContactTrace.hitsMiddleBoundary_of_middleBoundaryPositionHit
    (T.middleBoundaryPositionHit_of_startsIn_block2_endsIn_block4 hstart hend)

/-- If a displayed trace starts at or beyond `P_{z+1}` and ends at or before
`P_1`, then the underlying graph path hits every path in the first block. -/
theorem hitsBlock1_of_crosses_first_block_downwards
    (T : DisplayedContactTrace R Qpath)
    (hstart : z h + 1 ≤ T.pos ⟨0, by omega⟩)
    (hend : T.pos ⟨T.len, by omega⟩ ≤ 1) :
    R.HitsBlock1 Qpath := by
  refine T.toLinkageContactTrace.hitsBlock1_of_hits_displayed_positions ?_
  intro i
  exact T.hitsDisplayedPosition_of_between_downwards (by
      have hi : i.1 < z h := i.2
      dsimp [z] at hi ⊢
      omega)
    (by
      have hi : i.1 < z h := i.2
      dsimp [z] at hi hstart ⊢
      omega)
    (by
      have hi : i.1 < z h := i.2
      dsimp [z] at hi hend ⊢
      omega)

end DisplayedContactTrace

/-- The set of linkage paths that the type-1 segment `Q*` is allowed to meet:
`P_1 ∪ {P_0, P_{z+1}}`. -/
noncomputable def typeOneAllowedIndexSet
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h) : Finset L.Index :=
  insert R.p0Index (insert (R.pZPlusOneIndex hpos) R.block1IndexSet)

theorem p0Index_mem_typeOneAllowedIndexSet
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h) :
    R.p0Index ∈ typeOneAllowedIndexSet R hpos := by
  simp [typeOneAllowedIndexSet]

theorem pZPlusOneIndex_mem_typeOneAllowedIndexSet
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h) :
    R.pZPlusOneIndex hpos ∈ typeOneAllowedIndexSet R hpos := by
  simp [typeOneAllowedIndexSet]

theorem block1IndexSet_subset_typeOneAllowedIndexSet
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h) :
    R.block1IndexSet ⊆ typeOneAllowedIndexSet R hpos := by
  intro j hj
  simp [typeOneAllowedIndexSet, hj]

/-- A displayed index in the closed interval from `P_1` through `P_{z+1}` is
one of the linkage paths allowed for a type-1 `Q*` segment. -/
theorem indexAt_mem_typeOneAllowedIndexSet_of_between_one_zPlusOne
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h)
    {k : ℕ} (hk : k < 8 * h + 1)
    (hklo : 1 ≤ k) (hkhi : k ≤ z h + 1) :
    R.indexAt k hk ∈ typeOneAllowedIndexSet R hpos := by
  classical
  by_cases hkz : k = z h + 1
  · have hidx :
        R.indexAt k hk = R.pZPlusOneIndex hpos := by
      subst hkz
      simp [pZPlusOneIndex, pZPlusOnePos, indexAt, posOfNat]
    rw [hidx]
    exact pZPlusOneIndex_mem_typeOneAllowedIndexSet R hpos
  · have hkz_le : k ≤ z h := by omega
    have hk_pred_lt : k - 1 < z h := by omega
    let i : Fin (z h) := ⟨k - 1, hk_pred_lt⟩
    have hblock :
        R.indexAt k hk ∈ R.block1IndexSet := by
      rw [R.mem_block1IndexSet_iff]
      refine ⟨i, ?_⟩
      have hposi : 1 + i.1 < 8 * h + 1 := by
        dsimp [i, z]
        omega
      rw [R.block1_index_eq_indexAt i]
      exact (R.indexAt_eq_indexAt_iff hk hposi).2 (by
        dsimp [i]
        omega)
    exact block1IndexSet_subset_typeOneAllowedIndexSet R hpos hblock

/-- The union of the vertex sets of a finite set of linkage paths. -/
noncomputable def linkageVertexSetOfIndices
    (S : Finset L.Index) : Finset V :=
  S.biUnion fun i : L.Index => (L.path i).vertexSet

theorem mem_linkageVertexSetOfIndices_iff
    {S : Finset L.Index} {v : V} :
    v ∈ linkageVertexSetOfIndices (L := L) S ↔
      ∃ i : L.Index, i ∈ S ∧ v ∈ (L.path i).vertexSet := by
  classical
  simp [linkageVertexSetOfIndices]

/-- The middle boundary `P_{z+1} ∪ P_{2z}` used to define the last vertex
`v` in the second paragraph of Appendix B.1. -/
noncomputable def middleBoundaryIndexSet
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h) :
    Finset L.Index :=
  {R.pZPlusOneIndex hpos, R.pTwoZIndex hpos}

/-- Vertex set of the middle boundary `P_{z+1} ∪ P_{2z}`. -/
noncomputable def middleBoundaryVertexSet
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h) : Finset V :=
  linkageVertexSetOfIndices (L := L) (middleBoundaryIndexSet R hpos)

theorem pZPlusOne_vertexSet_subset_middleBoundaryVertexSet
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h) :
    (L.path (R.pZPlusOneIndex hpos)).vertexSet ⊆
      middleBoundaryVertexSet R hpos := by
  classical
  intro v hv
  change v ∈ linkageVertexSetOfIndices (L := L) (middleBoundaryIndexSet R hpos)
  rw [mem_linkageVertexSetOfIndices_iff]
  exact ⟨R.pZPlusOneIndex hpos, by simp [middleBoundaryIndexSet], hv⟩

theorem pTwoZ_vertexSet_subset_middleBoundaryVertexSet
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h) :
    (L.path (R.pTwoZIndex hpos)).vertexSet ⊆
      middleBoundaryVertexSet R hpos := by
  classical
  intro v hv
  change v ∈ linkageVertexSetOfIndices (L := L) (middleBoundaryIndexSet R hpos)
  rw [mem_linkageVertexSetOfIndices_iff]
  exact ⟨R.pTwoZIndex hpos, by simp [middleBoundaryIndexSet], hv⟩

/-- A vertex on `P_{z+1}` is not on `P_{2z}`. -/
theorem not_mem_pTwoZIndex_of_mem_pZPlusOneIndex
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {v : V}
    (hv : v ∈ (L.path (R.pZPlusOneIndex hpos)).vertexSet) :
    v ∉ (L.path (R.pTwoZIndex hpos)).vertexSet :=
  not_mem_linkage_path_of_mem_other
    (L := L) (R.pZPlusOneIndex_ne_pTwoZIndex hpos) hv

/-- A vertex on `P_{2z}` is not on `P_{z+1}`. -/
theorem not_mem_pZPlusOneIndex_of_mem_pTwoZIndex
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {v : V}
    (hv : v ∈ (L.path (R.pTwoZIndex hpos)).vertexSet) :
    v ∉ (L.path (R.pZPlusOneIndex hpos)).vertexSet :=
  not_mem_linkage_path_of_mem_other
    (L := L) (R.pZPlusOneIndex_ne_pTwoZIndex hpos).symm hv

/-- The suffix of a transversal path starting at its last contact with the
middle boundary `P_{z+1} ∪ P_{2z}`.  This is the formal version of the paper's
choice of the vertex `v`. -/
noncomputable def middleBoundarySuffix
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h)
    (Q : GraphPath G)
    (hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty) :
    GraphPath G :=
  Q.cleanSuffixFromSet (middleBoundaryVertexSet (L := L) R hpos) hmid

/-- The last middle-boundary hit lies on one of the two middle-boundary
linkage paths. -/
theorem middleBoundarySuffix_source_mem_pZPlusOne_or_pTwoZ
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h)
    (Q : GraphPath G)
    (hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty) :
    (middleBoundarySuffix (L := L) R hpos Q hmid).source ∈
        (L.path (R.pZPlusOneIndex hpos)).vertexSet ∨
      (middleBoundarySuffix (L := L) R hpos Q hmid).source ∈
        (L.path (R.pTwoZIndex hpos)).vertexSet := by
  classical
  have hsource_mid :
      (middleBoundarySuffix (L := L) R hpos Q hmid).source ∈
        middleBoundaryVertexSet (L := L) R hpos := by
    simpa [middleBoundarySuffix] using
      Q.cleanSuffixFromSet_source_mem
        (middleBoundaryVertexSet (L := L) R hpos) hmid
  have hsource_mid' :
      (middleBoundarySuffix (L := L) R hpos Q hmid).source ∈
        linkageVertexSetOfIndices (L := L) (middleBoundaryIndexSet R hpos) := by
    simpa [middleBoundaryVertexSet] using hsource_mid
  rw [mem_linkageVertexSetOfIndices_iff] at hsource_mid'
  rcases hsource_mid' with ⟨j, hj, hvj⟩
  simp [middleBoundaryIndexSet] at hj
  rcases hj with rfl | rfl
  · exact Or.inl hvj
  · exact Or.inr hvj

/-- If the last middle-boundary vertex of `Q` lies on `P_{z+1}`, then no
contact of a complete trace at or after that vertex can be on `P_{2z}`. -/
theorem no_later_pTwoZ_index_of_middleBoundarySuffix_source_pZPlusOne
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    (T : CompleteLinkageContactTrace R Q)
    (hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty)
    {s : Fin (T.len + 1)}
    (hs_contact :
      T.contact s = (middleBoundarySuffix (L := L) R hpos Q hmid).source)
    (hsource :
      (middleBoundarySuffix (L := L) R hpos Q hmid).source ∈
        (L.path (R.pZPlusOneIndex hpos)).vertexSet) :
    ∀ (n : ℕ) (_hsn : s.1 ≤ n) (hn : n ≤ T.len),
      T.index ⟨n, Nat.lt_succ_of_le hn⟩ ≠ R.pTwoZIndex hpos := by
  classical
  intro n hsn hn hidx
  let rn : Fin (T.len + 1) := ⟨n, Nat.lt_succ_of_le hn⟩
  have hn_mem_pTwoZ :
      T.contact rn ∈ (L.path (R.pTwoZIndex hpos)).vertexSet := by
    simpa [rn, hidx] using T.contact_mem_linkage rn
  have hn_mid :
      T.contact rn ∈ middleBoundaryVertexSet (L := L) R hpos :=
    pTwoZ_vertexSet_subset_middleBoundaryVertexSet
      (L := L) R hpos hn_mem_pTwoZ
  have hbefore :
      Q.Before
        (middleBoundarySuffix (L := L) R hpos Q hmid).source
        (T.contact rn) := by
    have htrace_before :=
      T.toLinkageContactTrace.contact_before_of_le (a := s) (b := rn) (by
        simpa [rn] using hsn)
    simpa [hs_contact, rn] using htrace_before
  have hn_suffix :
      T.contact rn ∈
        (middleBoundarySuffix (L := L) R hpos Q hmid).vertexSet := by
    simpa [middleBoundarySuffix, GraphPath.cleanSuffixFromSet] using
      hbefore.choose_spec
  have hsuffix_singleton :
      middleBoundaryVertexSet (L := L) R hpos ∩
          (middleBoundarySuffix (L := L) R hpos Q hmid).vertexSet =
        {(middleBoundarySuffix (L := L) R hpos Q hmid).source} := by
    simpa [middleBoundarySuffix] using
      Q.cleanSuffixFromSet_inter_eq_singleton_source
        (middleBoundaryVertexSet (L := L) R hpos) hmid
  have hn_eq_source :
      T.contact rn =
        (middleBoundarySuffix (L := L) R hpos Q hmid).source := by
    have hmem_single :
        T.contact rn ∈
          ({(middleBoundarySuffix (L := L) R hpos Q hmid).source} :
            Finset V) := by
      rw [← hsuffix_singleton]
      exact Finset.mem_inter.2 ⟨hn_mid, hn_suffix⟩
    simpa using hmem_single
  have hsource_not_pTwoZ :
      (middleBoundarySuffix (L := L) R hpos Q hmid).source ∉
        (L.path (R.pTwoZIndex hpos)).vertexSet :=
    not_mem_pTwoZIndex_of_mem_pZPlusOneIndex (L := L) hsource
  exact hsource_not_pTwoZ (by simpa [hn_eq_source] using hn_mem_pTwoZ)

/-- If the last middle-boundary vertex of `Q` lies on `P_{z+1}`, then there
is no *strictly later* complete-trace contact on `P_{z+1}`.  Otherwise the
last-hit suffix would meet the middle boundary again away from its source. -/
theorem no_strict_later_pZPlusOne_index_of_middleBoundarySuffix_source_pZPlusOne
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    (T : CompleteLinkageContactTrace R Q)
    (hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty)
    {s : Fin (T.len + 1)}
    (hs_contact :
      T.contact s = (middleBoundarySuffix (L := L) R hpos Q hmid).source)
    (_hsource :
      (middleBoundarySuffix (L := L) R hpos Q hmid).source ∈
        (L.path (R.pZPlusOneIndex hpos)).vertexSet) :
    ∀ (n : ℕ) (_hsn : s.1 < n) (hn : n ≤ T.len),
      T.index ⟨n, Nat.lt_succ_of_le hn⟩ ≠ R.pZPlusOneIndex hpos := by
  classical
  intro n hsn hn hidx
  let rn : Fin (T.len + 1) := ⟨n, Nat.lt_succ_of_le hn⟩
  have hn_mem_pZ :
      T.contact rn ∈ (L.path (R.pZPlusOneIndex hpos)).vertexSet := by
    simpa [rn, hidx] using T.contact_mem_linkage rn
  have hn_mid :
      T.contact rn ∈ middleBoundaryVertexSet (L := L) R hpos :=
    pZPlusOne_vertexSet_subset_middleBoundaryVertexSet
      (L := L) R hpos hn_mem_pZ
  have hbefore :
      Q.Before
        (middleBoundarySuffix (L := L) R hpos Q hmid).source
        (T.contact rn) := by
    have htrace_before :=
      T.toLinkageContactTrace.contact_before_of_le (a := s) (b := rn) (by
        simpa [rn] using le_of_lt hsn)
    simpa [hs_contact, rn] using htrace_before
  have hn_suffix :
      T.contact rn ∈
        (middleBoundarySuffix (L := L) R hpos Q hmid).vertexSet := by
    simpa [middleBoundarySuffix, GraphPath.cleanSuffixFromSet] using
      hbefore.choose_spec
  have hsuffix_singleton :
      middleBoundaryVertexSet (L := L) R hpos ∩
          (middleBoundarySuffix (L := L) R hpos Q hmid).vertexSet =
        {(middleBoundarySuffix (L := L) R hpos Q hmid).source} := by
    simpa [middleBoundarySuffix] using
      Q.cleanSuffixFromSet_inter_eq_singleton_source
        (middleBoundaryVertexSet (L := L) R hpos) hmid
  have hn_eq_source :
      T.contact rn =
        (middleBoundarySuffix (L := L) R hpos Q hmid).source := by
    have hmem_single :
        T.contact rn ∈
          ({(middleBoundarySuffix (L := L) R hpos Q hmid).source} :
            Finset V) := by
      rw [← hsuffix_singleton]
      exact Finset.mem_inter.2 ⟨hn_mid, hn_suffix⟩
    simpa using hmem_single
  have hback :
      Q.Before (T.contact rn) (T.contact s) := by
    have hmemQ : T.contact rn ∈ Q.vertexSet := T.contact_mem_Q rn
    have hrefl : Q.Before (T.contact rn) (T.contact rn) :=
      Q.before_refl hmemQ
    simpa [hs_contact, hn_eq_source] using hrefl
  have hle_back : rn.1 ≤ s.1 := (T.contact_before_iff_le rn s).1 hback
  have hn_val : rn.1 = n := rfl
  omega

/-- Symmetric last-middle-boundary fact for the type-2 branch: if the last
middle-boundary vertex lies on `P_{2z}`, then no contact at or after it can be
on `P_{z+1}`. -/
theorem no_later_pZPlusOne_index_of_middleBoundarySuffix_source_pTwoZ
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    (T : CompleteLinkageContactTrace R Q)
    (hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty)
    {s : Fin (T.len + 1)}
    (hs_contact :
      T.contact s = (middleBoundarySuffix (L := L) R hpos Q hmid).source)
    (hsource :
      (middleBoundarySuffix (L := L) R hpos Q hmid).source ∈
