    (by simpa [hEq] using B.rightAtom.start_mem_qstar)

theorem blocker_stop_ne_left_stop
    (B : ClaimB3HillBracketAtomData inv C)
    {M : ClaimB2Atom I}
    (hM : M.qIndex = Q0.selectedColumn j')
    (hj' : j' ≠ C.col) :
    M.stop ≠ B.leftAtom.stop := by
  intro hEq
  have hne : M.qIndex ≠ B.leftAtom.qIndex := by
    intro hidx
    exact B.left_middle_qIndex_ne hM hj' hidx.symm
