end CrossWitness

/-- There is a bump available in the current maintained graph. -/
def HasBump
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0) : Prop :=
  Nonempty (BumpWitness I)

/-- There is a cross available in the current maintained graph. -/
def HasCross
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0) : Prop :=
  Nonempty (CrossWitness I)

/-- Terminal state of the local rerouting loop: there is no bump and no
cross left to perform. -/
def NoBumpNoCross
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0) : Prop :=
  ¬ HasBump I ∧ ¬ HasCross I

/-! ## Claim B.2: no bump/no cross gives a planar strip certificate -/

/-- The auxiliary-row invariant used in Claim B.2: every auxiliary edge
between two current rows is an edge of the displayed row path.  This is the
formal version of the paper sentence that the current rows induce the same
2-path in `H(L')`, so clean off-row atoms cannot jump over an intermediate
row. -/
def TerminalRowsAuxNoChord
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) : Prop :=
  ∀ ⦃r s : I.Row⦄,
    (linkageAuxGraph I.linkage).Adj (I.rowIndex r) (I.rowIndex s) →
      FinConsecutive (inv.orderedRows.order r) (inv.orderedRows.order s)

/-- The active auxiliary invariant supplies the no-chord terminal hypothesis
used by Claims B.2 and B.3. -/
theorem TypeOneActiveAuxiliaryInvariant.terminalRowsAuxNoChord
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (H : TypeOneActiveAuxiliaryInvariant I inv) :
    TerminalRowsAuxNoChord I inv :=
  H.no_chord

/-- One atom in the decomposition used in Claim B.2.  It is an oriented
subpath of a fixed `Q*` whose endpoints lie on current rows and whose internal
vertices are disjoint from the full current linkage.  The paper obtains these
atoms by deleting row edges from the trimmed paths and then splitting at row
contacts. -/
structure ClaimB2Atom
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0) where
  qIndex : Q.Index
  q_mem : qIndex ∈ Q0.indices
  rowStart : I.Row
  rowStop : I.Row
  start : V
  stop : V
  start_mem_row : start ∈ (I.rowPath rowStart).vertexSet
  stop_mem_row : stop ∈ (I.rowPath rowStop).vertexSet
  segment : GraphPath G
  segment_source : segment.source = start
  segment_target : segment.target = stop
  segment_subset_qstar :
    segment.vertexSet ⊆ (Q0.data qIndex q_mem).qstar.vertexSet
  segment_edgeSet_subset_qstar :
    segment.edgeSet ⊆ (Q0.data qIndex q_mem).qstar.edgeSet
  segment_clean_rows :
    segment.InternallyDisjointFromSet I.rowVertexSet
  segment_clean_linkage :
    segment.InternallyDisjointFromSet I.linkage.toPathPacking.vertexSet

namespace ClaimB2Atom

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}

/-- The order on vertices of a simple path is total. -/
theorem graphPath_before_or_before_of_mem
    (P : GraphPath G) {x y : V}
    (hx : x ∈ P.vertexSet) (hy : y ∈ P.vertexSet) :
    P.Before x y ∨ P.Before y x := by
  classical
  rcases le_total (P.vertexIndex x) (P.vertexIndex y) with hxy | hyx
  · exact Or.inl ((P.before_iff_vertexIndex_le).2 ⟨hx, hy, hxy⟩)
  · exact Or.inr ((P.before_iff_vertexIndex_le).2 ⟨hy, hx, hyx⟩)

/-- The oriented atom connects its two row endpoints as an unoriented segment,
which is the endpoint convention used by bump and cross witnesses. -/
theorem segment_connects (A : ClaimB2Atom I) :
    A.segment.Connects {A.start} {A.stop} := by
  left
  constructor
  · simp [A.segment_source]
  · simp [A.segment_target]

theorem start_mem_qstar (A : ClaimB2Atom I) :
    A.start ∈ (Q0.data A.qIndex A.q_mem).qstar.vertexSet := by
  have hsource : A.segment.source ∈ A.segment.vertexSet :=
    GraphPath.source_mem_vertexSet A.segment
  exact A.segment_subset_qstar (by simpa [A.segment_source] using hsource)

theorem stop_mem_qstar (A : ClaimB2Atom I) :
    A.stop ∈ (Q0.data A.qIndex A.q_mem).qstar.vertexSet := by
  have htarget : A.segment.target ∈ A.segment.vertexSet :=
    GraphPath.target_mem_vertexSet A.segment
  exact A.segment_subset_qstar (by simpa [A.segment_target] using htarget)

/-- Reverse a Claim B.2 atom.  The stored transversal subpath is an
undirected object for the purposes of bumps, crosses, and the Claim B.3
barrier; reversing it preserves all support and cleanliness data. -/
noncomputable def reverse (A : ClaimB2Atom I) : ClaimB2Atom I where
  qIndex := A.qIndex
  q_mem := A.q_mem
  rowStart := A.rowStop
  rowStop := A.rowStart
  start := A.stop
  stop := A.start
  start_mem_row := A.stop_mem_row
  stop_mem_row := A.start_mem_row
  segment := orientBetween A.segment (by
    rw [GraphPath.connects_comm]
    exact A.segment_connects)
  segment_source := orientBetween.source
  segment_target := orientBetween.target
  segment_subset_qstar := by
    intro v hv
    exact A.segment_subset_qstar (by simpa [orientBetween] using hv)
  segment_edgeSet_subset_qstar := by
    intro e he
    exact A.segment_edgeSet_subset_qstar (by simpa [orientBetween] using he)
  segment_clean_rows := by
    intro v hv hrow
    have hvA : v ∈ A.segment.vertexSet := by
      simpa [orientBetween] using hv
    have hend := A.segment_clean_rows hvA hrow
    change (A.segment.orient _).IsEndpoint v
    exact (GraphPath.orient_isEndpoint A.segment _).2 hend
  segment_clean_linkage := by
    intro v hv hlink
    have hvA : v ∈ A.segment.vertexSet := by
      simpa [orientBetween] using hv
    have hend := A.segment_clean_linkage hvA hlink
    change (A.segment.orient _).IsEndpoint v
    exact (GraphPath.orient_isEndpoint A.segment _).2 hend

@[simp] theorem reverse_rowStart (A : ClaimB2Atom I) :
    A.reverse.rowStart = A.rowStop := rfl

@[simp] theorem reverse_rowStop (A : ClaimB2Atom I) :
    A.reverse.rowStop = A.rowStart := rfl

@[simp] theorem reverse_start (A : ClaimB2Atom I) :
    A.reverse.start = A.stop := rfl

@[simp] theorem reverse_stop (A : ClaimB2Atom I) :
    A.reverse.stop = A.start := rfl

@[simp] theorem reverse_qIndex (A : ClaimB2Atom I) :
    A.reverse.qIndex = A.qIndex := rfl

/-- If the two endpoints of an atom lie on different current rows, then the
atom witnesses an auxiliary edge between those rows. -/
theorem aux_adj_of_rows_ne
    (A : ClaimB2Atom I) (hinj : I.RowIndexInjective)
    (hne : A.rowStart ≠ A.rowStop) :
    (linkageAuxGraph I.linkage).Adj
      (I.rowIndex A.rowStart) (I.rowIndex A.rowStop) := by
  have hsource :
      A.segment.source ∈
        (I.linkage.path (I.rowIndex A.rowStart)).vertexSet := by
    rw [← I.rowPath_eq_linkage_path A.rowStart]
    simpa [A.segment_source] using A.start_mem_row
  have htarget :
      A.segment.target ∈
        (I.linkage.path (I.rowIndex A.rowStop)).vertexSet := by
    rw [← I.rowPath_eq_linkage_path A.rowStop]
    simpa [A.segment_target] using A.stop_mem_row
  rcases aux_adj_or_eq_of_clean_segment
      (L := I.linkage) A.segment hsource htarget
      A.segment_clean_linkage with hidx | hadj
  · exact False.elim (hne (hinj hidx))
  · exact hadj

/-- With the auxiliary-row no-chord invariant, every non-row atom joins
consecutive current rows. -/
theorem rows_consecutive_of_rows_ne
    (A : ClaimB2Atom I)
    {inv : TypeOneIterationInvariants I}
    (haux : TerminalRowsAuxNoChord I inv)
    (hne : A.rowStart ≠ A.rowStop) :
    FinConsecutive
      (inv.orderedRows.order A.rowStart)
      (inv.orderedRows.order A.rowStop) :=
  haux (A.aux_adj_of_rows_ne inv.rowIndexInjective hne)

/-- In a no-bump terminal state, an atom whose endpoints are distinct vertices
of the same row cannot leave that row.  This is exactly the no-bump part of
Claim B.2. -/
theorem no_off_row_of_same_row_of_noBump
    (A : ClaimB2Atom I) (hterm : NoBumpNoCross I)
    (hrow : A.rowStart = A.rowStop) (hne : A.start ≠ A.stop) :
    ¬ ∃ v : V, v ∈ A.segment.vertexSet ∧
      v ∉ (I.rowPath A.rowStart).vertexSet := by
  intro hoff
  have horder :
      (I.rowPath A.rowStart).Before A.start A.stop ∨
        (I.rowPath A.rowStart).Before A.stop A.start :=
    graphPath_before_or_before_of_mem (I.rowPath A.rowStart)
      A.start_mem_row (by simpa [hrow] using A.stop_mem_row)
  rcases horder with hbefore | hbefore
  · exact hterm.1 ⟨{
      row := A.rowStart
      qIndex := A.qIndex
      q_mem := A.q_mem
      left := A.start
      right := A.stop
      left_mem_row := A.start_mem_row
      right_mem_row := by simpa [hrow] using A.stop_mem_row
      left_before_right := hbefore
      left_ne_right := hne
      segment := A.segment
      segment_connects := A.segment_connects
      segment_subset_qstar := A.segment_subset_qstar
      segment_edgeSet_subset_qstar := A.segment_edgeSet_subset_qstar
      segment_clean_rows := A.segment_clean_rows
      segment_clean_linkage := A.segment_clean_linkage
      not_row_contained := Or.inl hoff }⟩
  · exact hterm.1 ⟨{
      row := A.rowStart
      qIndex := A.qIndex
      q_mem := A.q_mem
      left := A.stop
      right := A.start
      left_mem_row := by simpa [hrow] using A.stop_mem_row
      right_mem_row := A.start_mem_row
      left_before_right := hbefore
      left_ne_right := hne.symm
      segment := A.segment
      segment_connects := by
        rw [GraphPath.connects_comm]
        exact A.segment_connects
      segment_subset_qstar := A.segment_subset_qstar
      segment_edgeSet_subset_qstar := A.segment_edgeSet_subset_qstar
      segment_clean_rows := A.segment_clean_rows
      segment_clean_linkage := A.segment_clean_linkage
      not_row_contained := Or.inl hoff }⟩

/-- In a no-bump terminal state, an atom whose endpoints are distinct vertices
of the same row must use only row-path edges.  This strengthens
`no_off_row_of_same_row_of_noBump` and rules out row chords, which are also
bumps in the paper's sense of a non-row subpath. -/
theorem edgeSet_subset_row_of_same_row_of_noBump
    (A : ClaimB2Atom I) (hterm : NoBumpNoCross I)
    (hrow : A.rowStart = A.rowStop) (hne : A.start ≠ A.stop) :
    A.segment.edgeSet ⊆ (I.rowPath A.rowStart).edgeSet := by
  classical
  by_contra hsubset
  have horder :
      (I.rowPath A.rowStart).Before A.start A.stop ∨
        (I.rowPath A.rowStart).Before A.stop A.start :=
    graphPath_before_or_before_of_mem (I.rowPath A.rowStart)
      A.start_mem_row (by simpa [hrow] using A.stop_mem_row)
  rcases horder with hbefore | hbefore
  · exact False.elim <| hterm.1 ⟨{
      row := A.rowStart
      qIndex := A.qIndex
      q_mem := A.q_mem
      left := A.start
      right := A.stop
      left_mem_row := A.start_mem_row
      right_mem_row := by simpa [hrow] using A.stop_mem_row
      left_before_right := hbefore
      left_ne_right := hne
      segment := A.segment
      segment_connects := A.segment_connects
      segment_subset_qstar := A.segment_subset_qstar
      segment_edgeSet_subset_qstar := A.segment_edgeSet_subset_qstar
      segment_clean_rows := A.segment_clean_rows
      segment_clean_linkage := A.segment_clean_linkage
      not_row_contained := Or.inr hsubset }⟩
  · exact False.elim <| hterm.1 ⟨{
      row := A.rowStart
      qIndex := A.qIndex
      q_mem := A.q_mem
      left := A.stop
      right := A.start
      left_mem_row := by simpa [hrow] using A.stop_mem_row
      right_mem_row := A.start_mem_row
      left_before_right := hbefore
      left_ne_right := hne.symm
      segment := A.segment
      segment_connects := by
        rw [GraphPath.connects_comm]
        exact A.segment_connects
      segment_subset_qstar := A.segment_subset_qstar
      segment_edgeSet_subset_qstar := A.segment_edgeSet_subset_qstar
      segment_clean_rows := A.segment_clean_rows
      segment_clean_linkage := A.segment_clean_linkage
      not_row_contained := Or.inr hsubset }⟩

/-- In a no-cross terminal state, two distinct transversal atoms in the same
strip cannot have opposite endpoint orders.  This is the formal order
content of Claim B.2; the topological drawing is represented by this
noncrossing strip-order certificate. -/
theorem no_reversed_order_of_noCross
    {inv : TypeOneIterationInvariants I}
    (A₁ A₂ : ClaimB2Atom I) (hterm : NoBumpNoCross I)
    (r s : I.Row)
    (h₁r : A₁.rowStart = r) (h₁s : A₁.rowStop = s)
    (h₂r : A₂.rowStart = r) (h₂s : A₂.rowStop = s)
    (hrs : r ≠ s)
    (hq : A₁.qIndex ≠ A₂.qIndex)
    (hleft : (I.rowPath r).Before A₁.start A₂.start)
    (hright : (I.rowPath s).Before A₂.stop A₁.stop)
    (hleft_ne : A₁.start ≠ A₂.start)
    (hright_ne : A₂.stop ≠ A₁.stop) :
    False := by
  have hrowIndex_ne : I.rowIndex r ≠ I.rowIndex s := by
    intro hidx
    exact hrs (inv.rowIndexInjective hidx)
  have hsegments_disjoint : A₁.segment.NodeDisjoint A₂.segment := by
    rw [GraphPath.NodeDisjoint, Finset.disjoint_left]
    intro v hv₁ hv₂
    exact Finset.disjoint_left.mp
      (Q0.qstar_nodeDisjoint_of_ne hq)
      (A₁.segment_subset_qstar hv₁)
      (A₂.segment_subset_qstar hv₂)
  exact hterm.2 ⟨{
    rowLeft := r
    rowRight := s
    rowIndex_ne := hrowIndex_ne
    rowLeft_index_unique := by
      intro r' hr'
      exact inv.rowIndexInjective hr'
    rowRight_index_unique := by
      intro r' hr'
      exact inv.rowIndexInjective hr'
    rows_nodeDisjoint := inv.rowsNodeDisjoint hrs
    qIndex1 := A₁.qIndex
    qIndex2 := A₂.qIndex
    qIndex_ne := hq
    q_mem1 := A₁.q_mem
    q_mem2 := A₂.q_mem
    s1 := A₁.start
    s2 := A₂.start
    t1 := A₁.stop
    t2 := A₂.stop
    s1_mem_left := by simpa [h₁r] using A₁.start_mem_row
    s2_mem_left := by simpa [h₂r] using A₂.start_mem_row
    t1_mem_right := by simpa [h₁s] using A₁.stop_mem_row
    t2_mem_right := by simpa [h₂s] using A₂.stop_mem_row
    s1_before_s2 := hleft
    t2_before_t1 := hright
    s1_ne_s2 := hleft_ne
    t2_ne_t1 := hright_ne
    segment1 := A₁.segment
    segment2 := A₂.segment
    segment1_connects := A₁.segment_connects
    segment2_connects := A₂.segment_connects
    segment1_subset_qstar := A₁.segment_subset_qstar
    segment2_subset_qstar := A₂.segment_subset_qstar
    segment1_edgeSet_subset_qstar := A₁.segment_edgeSet_subset_qstar
    segment2_edgeSet_subset_qstar := A₂.segment_edgeSet_subset_qstar
    segment1_clean_rows := A₁.segment_clean_rows
    segment2_clean_rows := A₂.segment_clean_rows
    segment1_clean_linkage := A₁.segment_clean_linkage
    segment2_clean_linkage := A₂.segment_clean_linkage
    segments_nodeDisjoint := hsegments_disjoint }⟩

end ClaimB2Atom

/-- Lean-facing form of Claim B.2.  Instead of postulating a topological
planar embedding library, the certificate records the two finite combinatorial
facts used by the paper's planar drawing: atoms cannot form bumps, every
off-row atom goes between consecutive rows of the displayed row path, and
two distinct atoms in the same strip cannot be ordered oppositely on the two
boundary rows. -/
structure ClaimB2PlanarStripCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  same_row_atom_no_off_row :
    ∀ A : ClaimB2Atom I,
      A.rowStart = A.rowStop → A.start ≠ A.stop →
        ¬ ∃ v : V, v ∈ A.segment.vertexSet ∧
          v ∉ (I.rowPath A.rowStart).vertexSet
  same_row_atom_edgeSet_subset :
    ∀ A : ClaimB2Atom I,
      A.rowStart = A.rowStop → A.start ≠ A.stop →
        A.segment.edgeSet ⊆ (I.rowPath A.rowStart).edgeSet
  atom_rows_consecutive :
    ∀ A : ClaimB2Atom I,
      A.rowStart ≠ A.rowStop →
        FinConsecutive
          (inv.orderedRows.order A.rowStart)
          (inv.orderedRows.order A.rowStop)
  no_reversed_order :
    ∀ A₁ A₂ : ClaimB2Atom I, ∀ r s : I.Row,
      A₁.rowStart = r → A₁.rowStop = s →
      A₂.rowStart = r → A₂.rowStop = s →
      r ≠ s → A₁.qIndex ≠ A₂.qIndex →
      (I.rowPath r).Before A₁.start A₂.start →
      (I.rowPath s).Before A₂.stop A₁.stop →
      A₁.start ≠ A₂.start → A₂.stop ≠ A₁.stop → False

namespace ClaimB2PlanarStripCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Claim B.2 from the terminal no-bump/no-cross state, in its finite
strip-planarity form. -/
theorem of_noBumpNoCross
    (haux : TerminalRowsAuxNoChord I inv)
    (hterm : NoBumpNoCross I) :
    ClaimB2PlanarStripCertificate I inv where
  same_row_atom_no_off_row := by
    intro A hrow hne
    exact A.no_off_row_of_same_row_of_noBump hterm hrow hne
  same_row_atom_edgeSet_subset := by
    intro A hrow hne
    exact A.edgeSet_subset_row_of_same_row_of_noBump hterm hrow hne
  atom_rows_consecutive := by
    intro A hne
    exact A.rows_consecutive_of_rows_ne haux hne
  no_reversed_order := by
    intro A₁ A₂ r s h₁r h₁s h₂r h₂s hrs hq hleft hright hleft_ne hright_ne
    exact ClaimB2Atom.no_reversed_order_of_noCross
      (A₁ := A₁) (A₂ := A₂) (inv := inv) hterm r s
      h₁r h₁s h₂r h₂s hrs hq hleft hright hleft_ne hright_ne

/-- No-cross order barrier for three connectors in one strip.

If two connectors from one selected column bracket a connector from another
selected column on the upper row, then the endpoint of the middle connector on
the lower row is forced to lie between the two lower endpoints.  This is the
order-theoretic core of the blocker argument in Claim B.3. -/
theorem lower_endpoint_between_of_top_between
    (S : ClaimB2PlanarStripCertificate I inv)
    (Aleft Amid Aright : ClaimB2Atom I)
    (top lower : I.Row)
    (hL_top : Aleft.rowStart = top)
    (hL_lower : Aleft.rowStop = lower)
    (hM_top : Amid.rowStart = top)
    (hM_lower : Amid.rowStop = lower)
    (hR_top : Aright.rowStart = top)
    (hR_lower : Aright.rowStop = lower)
    (htop_lower : top ≠ lower)
    (hLM_q : Aleft.qIndex ≠ Amid.qIndex)
    (hMR_q : Amid.qIndex ≠ Aright.qIndex)
    (hLM_top : (I.rowPath top).Before Aleft.start Amid.start)
    (hMR_top : (I.rowPath top).Before Amid.start Aright.start)
    (hLM_start_ne : Aleft.start ≠ Amid.start)
    (hMR_start_ne : Amid.start ≠ Aright.start)
    (hML_stop_ne : Amid.stop ≠ Aleft.stop)
    (hRM_stop_ne : Aright.stop ≠ Amid.stop) :
    (I.rowPath lower).Before Aleft.stop Amid.stop ∧
      (I.rowPath lower).Before Amid.stop Aright.stop := by
  classical
  have hleft_stop_mem :
      Aleft.stop ∈ (I.rowPath lower).vertexSet := by
    simpa [hL_lower] using Aleft.stop_mem_row
  have hmid_stop_mem :
      Amid.stop ∈ (I.rowPath lower).vertexSet := by
    simpa [hM_lower] using Amid.stop_mem_row
  have hright_stop_mem :
      Aright.stop ∈ (I.rowPath lower).vertexSet := by
    simpa [hR_lower] using Aright.stop_mem_row
  constructor
  · rcases ClaimB2Atom.graphPath_before_or_before_of_mem
      (I.rowPath lower) hleft_stop_mem hmid_stop_mem with hleft_mid | hmid_left
    · exact hleft_mid
    · exact False.elim <|
        S.no_reversed_order Aleft Amid top lower
          hL_top hL_lower hM_top hM_lower htop_lower hLM_q
          hLM_top hmid_left hLM_start_ne hML_stop_ne
  · rcases ClaimB2Atom.graphPath_before_or_before_of_mem
      (I.rowPath lower) hmid_stop_mem hright_stop_mem with hmid_right | hright_mid
    · exact hmid_right
    · exact False.elim <|
        S.no_reversed_order Amid Aright top lower
          hM_top hM_lower hR_top hR_lower htop_lower hMR_q
          hMR_top hright_mid hMR_start_ne hRM_stop_ne

/-- If the row interval between the two lower contacts of the bracketing
connectors is already contained in the original selected column, then a
different blocker connector cannot have its lower endpoint inside that
interval.  This is the vertex-disjointness half of the Claim B.3 barrier
argument. -/
theorem lower_endpoint_between_contradicts_owned_lower_interval
    (Aleft Amid Aright : ClaimB2Atom I)
    (lower : I.Row)
    (hLM_q : Aleft.qIndex ≠ Amid.qIndex)
    (hLR_lower :
      (I.rowPath lower).Before Aleft.stop Aright.stop)
    (hL_mid_lower :
      (I.rowPath lower).Before Aleft.stop Amid.stop)
    (hmid_R_lower :
      (I.rowPath lower).Before Amid.stop Aright.stop)
    (hlower_interval_subset_left_qstar :
      ((I.rowPath lower).segmentOfBefore hLR_lower).vertexSet ⊆
        (Q0.data Aleft.qIndex Aleft.q_mem).qstar.vertexSet) :
    False := by
  classical
  have hmid_mem_lower_segment :
      Amid.stop ∈ ((I.rowPath lower).segmentOfBefore hLR_lower).vertexSet :=
    (I.rowPath lower).mem_segmentOfBefore_of_before_of_before
      hLR_lower hL_mid_lower hmid_R_lower
  have hmid_mem_left_qstar :
      Amid.stop ∈ (Q0.data Aleft.qIndex Aleft.q_mem).qstar.vertexSet :=
    hlower_interval_subset_left_qstar hmid_mem_lower_segment
  have hmid_mem_mid_qstar :
      Amid.stop ∈ (Q0.data Amid.qIndex Amid.q_mem).qstar.vertexSet := by
    have htgt : Amid.segment.target ∈ Amid.segment.vertexSet :=
      GraphPath.target_mem_vertexSet Amid.segment
    exact Amid.segment_subset_qstar (by
      simpa [Amid.segment_target] using htgt)
  have hdisj :=
    Q0.qstar_nodeDisjoint_of_ne
      (i := Aleft.qIndex) (j := Amid.qIndex)
      (hi := Aleft.q_mem) (hj := Amid.q_mem) hLM_q
  exact Finset.disjoint_left.mp hdisj hmid_mem_left_qstar hmid_mem_mid_qstar

/-- Combined no-cross barrier for an attempted lower-side blocker connector.

The first lemma forces the lower endpoint of the middle connector into the
owned lower interval; the second lemma contradicts ownership by a different
selected column.  This is the formal local statement behind “the blocker
cannot come from `R_{i-1}`” in Claim B.3. -/
theorem no_middle_connector_to_lower_between_hill_brackets
    (S : ClaimB2PlanarStripCertificate I inv)
    (Aleft Amid Aright : ClaimB2Atom I)
    (top lower : I.Row)
    (hL_top : Aleft.rowStart = top)
    (hL_lower : Aleft.rowStop = lower)
    (hM_top : Amid.rowStart = top)
    (hM_lower : Amid.rowStop = lower)
    (hR_top : Aright.rowStart = top)
    (hR_lower : Aright.rowStop = lower)
    (htop_lower : top ≠ lower)
    (hLM_q : Aleft.qIndex ≠ Amid.qIndex)
    (hMR_q : Amid.qIndex ≠ Aright.qIndex)
    (hLM_top : (I.rowPath top).Before Aleft.start Amid.start)
    (hMR_top : (I.rowPath top).Before Amid.start Aright.start)
    (hLM_start_ne : Aleft.start ≠ Amid.start)
    (hMR_start_ne : Amid.start ≠ Aright.start)
    (hML_stop_ne : Amid.stop ≠ Aleft.stop)
    (hRM_stop_ne : Aright.stop ≠ Amid.stop)
    (hLR_lower :
      (I.rowPath lower).Before Aleft.stop Aright.stop)
    (hlower_interval_subset_left_qstar :
      ((I.rowPath lower).segmentOfBefore hLR_lower).vertexSet ⊆
        (Q0.data Aleft.qIndex Aleft.q_mem).qstar.vertexSet) :
    False := by
  classical
  rcases S.lower_endpoint_between_of_top_between
      Aleft Amid Aright top lower
      hL_top hL_lower hM_top hM_lower hR_top hR_lower htop_lower
      hLM_q hMR_q hLM_top hMR_top hLM_start_ne hMR_start_ne
      hML_stop_ne hRM_stop_ne with
    ⟨hL_mid_lower, hmid_R_lower⟩
  exact lower_endpoint_between_contradicts_owned_lower_interval
    (I := I) Aleft Amid Aright lower hLM_q hLR_lower hL_mid_lower
    hmid_R_lower hlower_interval_subset_left_qstar

/-- Reversed-orientation version of
`no_middle_connector_to_lower_between_hill_brackets`.

The middle connector may be stored along its parent transversal from the lower
row up to the top row.  Reversing the atom turns it into the oriented
top-to-lower connector consumed by the no-cross barrier. -/
theorem no_reversed_middle_connector_to_lower_between_hill_brackets
    (S : ClaimB2PlanarStripCertificate I inv)
    (Aleft Amid Aright : ClaimB2Atom I)
    (top lower : I.Row)
    (hL_top : Aleft.rowStart = top)
    (hL_lower : Aleft.rowStop = lower)
    (hM_lower : Amid.rowStart = lower)
    (hM_top : Amid.rowStop = top)
    (hR_top : Aright.rowStart = top)
    (hR_lower : Aright.rowStop = lower)
    (htop_lower : top ≠ lower)
    (hLM_q : Aleft.qIndex ≠ Amid.qIndex)
    (hMR_q : Amid.qIndex ≠ Aright.qIndex)
    (hLM_top : (I.rowPath top).Before Aleft.start Amid.stop)
    (hMR_top : (I.rowPath top).Before Amid.stop Aright.start)
    (hLM_start_ne : Aleft.start ≠ Amid.stop)
    (hMR_start_ne : Amid.stop ≠ Aright.start)
    (hML_stop_ne : Amid.start ≠ Aleft.stop)
    (hRM_stop_ne : Aright.stop ≠ Amid.start)
    (hLR_lower :
      (I.rowPath lower).Before Aleft.stop Aright.stop)
    (hlower_interval_subset_left_qstar :
      ((I.rowPath lower).segmentOfBefore hLR_lower).vertexSet ⊆
        (Q0.data Aleft.qIndex Aleft.q_mem).qstar.vertexSet) :
    False := by
  classical
  have hMR_q' : Amid.reverse.qIndex ≠ Aright.qIndex := by
    simpa [ClaimB2Atom.reverse] using hMR_q
  have hLM_q' : Aleft.qIndex ≠ Amid.reverse.qIndex := by
    simpa [ClaimB2Atom.reverse] using hLM_q
  exact S.no_middle_connector_to_lower_between_hill_brackets
    Aleft Amid.reverse Aright top lower
    hL_top hL_lower (by simpa [ClaimB2Atom.reverse] using hM_top)
    (by simpa [ClaimB2Atom.reverse] using hM_lower)
    hR_top hR_lower htop_lower
    hLM_q' hMR_q'
    (by simpa using hLM_top) (by simpa using hMR_top)
    (by simpa using hLM_start_ne) (by simpa using hMR_start_ne)
    (by simpa using hML_stop_ne) (by simpa using hRM_stop_ne)
    hLR_lower hlower_interval_subset_left_qstar

end ClaimB2PlanarStripCertificate

/-- Claim B.2, stated as the combinatorial strip-planarity certificate used by
the subsequent terminal grid-minor construction.  The extra hypothesis
`TerminalRowsAuxNoChord` is the maintained page-60 invariant that the current
rows form the corresponding chordless auxiliary 2-path. -/
theorem claimB2_planarStripCertificate_of_noBumpNoCross
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (haux : TerminalRowsAuxNoChord I inv)
    (hterm : NoBumpNoCross I) :
    ClaimB2PlanarStripCertificate I inv :=
  ClaimB2PlanarStripCertificate.of_noBumpNoCross haux hterm

/-! ### Claim B.3: local blocker barrier -/

/-- Local lower-side blocker data for Claim B.3.

For a hill candidate `C`, the two bracketing atoms from `C.col` run from the
candidate row down to `C.lower`.  A putative blocker atom from a different
column also runs from a point between the two bracketing top endpoints down
to `C.lower`.  The no-cross barrier says this data is impossible: the middle
lower endpoint would be forced into a row interval owned by the original
selected column, contradicting disjointness of the fixed `Q₀` paths. -/
structure ClaimB3LowerSideBlockerConnectorData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    (inv : TypeOneIterationInvariants I)
    (C : ClaimB3HillCandidateData I inv) (j' : Fin h) where
  top : I.Row
  lowerRow : I.Row
  top_order : inv.orderedRows.order top = C.row
  lower_order : inv.orderedRows.order lowerRow = C.lower
  leftAtom : ClaimB2Atom I
  middleAtom : ClaimB2Atom I
  rightAtom : ClaimB2Atom I
  left_qIndex : leftAtom.qIndex = Q0.selectedColumn C.col
  middle_qIndex : middleAtom.qIndex = Q0.selectedColumn j'
  right_qIndex : rightAtom.qIndex = Q0.selectedColumn C.col
  left_top : leftAtom.rowStart = top
  left_lower : leftAtom.rowStop = lowerRow
  middle_top : middleAtom.rowStart = top
  middle_lower : middleAtom.rowStop = lowerRow
  right_top : rightAtom.rowStart = top
  right_lower : rightAtom.rowStop = lowerRow
  top_ne_lower : top ≠ lowerRow
  left_middle_top :
    (I.rowPath top).Before leftAtom.start middleAtom.start
  middle_right_top :
    (I.rowPath top).Before middleAtom.start rightAtom.start
  left_start_ne_middle : leftAtom.start ≠ middleAtom.start
  middle_start_ne_right : middleAtom.start ≠ rightAtom.start
  middle_stop_ne_left : middleAtom.stop ≠ leftAtom.stop
  right_stop_ne_middle : rightAtom.stop ≠ middleAtom.stop
  left_right_lower :
    (I.rowPath lowerRow).Before leftAtom.stop rightAtom.stop
  lower_interval_subset_left_qstar :
    ((I.rowPath lowerRow).segmentOfBefore left_right_lower).vertexSet ⊆
      (Q0.data leftAtom.qIndex leftAtom.q_mem).qstar.vertexSet

namespace ClaimB3LowerSideBlockerConnectorData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}
variable {C : ClaimB3HillCandidateData I inv} {j' : Fin h}

/-- The left bracketing atom and the blocker atom come from different
selected columns. -/
theorem left_middle_qIndex_ne
    (D : ClaimB3LowerSideBlockerConnectorData inv C j')
    (hj' : j' ≠ C.col) :
    D.leftAtom.qIndex ≠ D.middleAtom.qIndex := by
  intro hidx
  have hsel : Q0.selectedColumn C.col = Q0.selectedColumn j' := by
    calc
      Q0.selectedColumn C.col = D.leftAtom.qIndex := D.left_qIndex.symm
      _ = D.middleAtom.qIndex := hidx
      _ = Q0.selectedColumn j' := D.middle_qIndex
  exact hj' ((Q0.selectedColumn_injective) hsel.symm)

/-- The blocker atom and the right bracketing atom come from different
selected columns. -/
theorem middle_right_qIndex_ne
    (D : ClaimB3LowerSideBlockerConnectorData inv C j')
    (hj' : j' ≠ C.col) :
    D.middleAtom.qIndex ≠ D.rightAtom.qIndex := by
  intro hidx
  have hsel : Q0.selectedColumn j' = Q0.selectedColumn C.col := by
    calc
      Q0.selectedColumn j' = D.middleAtom.qIndex := D.middle_qIndex.symm
      _ = D.rightAtom.qIndex := hidx
      _ = Q0.selectedColumn C.col := D.right_qIndex
  exact hj' ((Q0.selectedColumn_injective) hsel)

/-- Local Claim B.3 barrier: a blocker connector cannot enter the candidate
row interval from the lower adjacent row. -/
theorem impossible
    (S : ClaimB2PlanarStripCertificate I inv)
    (D : ClaimB3LowerSideBlockerConnectorData inv C j')
    (hj' : j' ≠ C.col) :
    False :=
  S.no_middle_connector_to_lower_between_hill_brackets
    D.leftAtom D.middleAtom D.rightAtom D.top D.lowerRow
    D.left_top D.left_lower D.middle_top D.middle_lower
    D.right_top D.right_lower D.top_ne_lower
    (D.left_middle_qIndex_ne hj') (D.middle_right_qIndex_ne hj')
    D.left_middle_top D.middle_right_top
    D.left_start_ne_middle D.middle_start_ne_right
    D.middle_stop_ne_left D.right_stop_ne_middle
    D.left_right_lower D.lower_interval_subset_left_qstar

end ClaimB3LowerSideBlockerConnectorData

/-- The two fixed-column atoms bracketing a Claim B.3 hill candidate.

This separates the part of the blocker argument that belongs to the original
hill from the part that belongs to the blocking column.  The two atoms run
from the candidate row to the lower adjacent row; their lower endpoints bound
a row interval already contained in the original selected column. -/
structure ClaimB3HillBracketAtomData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    (inv : TypeOneIterationInvariants I)
    (C : ClaimB3HillCandidateData I inv) where
  top : I.Row
  lowerRow : I.Row
  top_order : inv.orderedRows.order top = C.row
  lower_order : inv.orderedRows.order lowerRow = C.lower
  leftAtom : ClaimB2Atom I
  rightAtom : ClaimB2Atom I
  left_qIndex : leftAtom.qIndex = Q0.selectedColumn C.col
  right_qIndex : rightAtom.qIndex = Q0.selectedColumn C.col
  left_top : leftAtom.rowStart = top
  left_lower : leftAtom.rowStop = lowerRow
  right_top : rightAtom.rowStart = top
  right_lower : rightAtom.rowStop = lowerRow
  left_start_eq : leftAtom.start = C.left
  right_start_eq : rightAtom.start = C.right
  top_ne_lower : top ≠ lowerRow
  left_right_lower :
    (I.rowPath lowerRow).Before leftAtom.stop rightAtom.stop
  lower_interval_subset_left_qstar :
    ((I.rowPath lowerRow).segmentOfBefore left_right_lower).vertexSet ⊆
      (Q0.data leftAtom.qIndex leftAtom.q_mem).qstar.vertexSet

namespace ClaimB3HillBracketAtomData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}
variable {C : ClaimB3HillCandidateData I inv} {j' : Fin h}

/-- The left bracketing atom is from the hill column, hence differs from a
blocker atom coming from a different selected column. -/
theorem left_middle_qIndex_ne
    (B : ClaimB3HillBracketAtomData inv C)
    {M : ClaimB2Atom I}
    (hM : M.qIndex = Q0.selectedColumn j')
    (hj' : j' ≠ C.col) :
    B.leftAtom.qIndex ≠ M.qIndex := by
  intro hidx
  have hsel : Q0.selectedColumn C.col = Q0.selectedColumn j' := by
    calc
      Q0.selectedColumn C.col = B.leftAtom.qIndex := B.left_qIndex.symm
      _ = M.qIndex := hidx
      _ = Q0.selectedColumn j' := hM
  exact hj' ((Q0.selectedColumn_injective) hsel.symm)

/-- The right bracketing atom is from the hill column, hence differs from a
blocker atom coming from a different selected column. -/
theorem middle_right_qIndex_ne
    (B : ClaimB3HillBracketAtomData inv C)
    {M : ClaimB2Atom I}
    (hM : M.qIndex = Q0.selectedColumn j')
    (hj' : j' ≠ C.col) :
    M.qIndex ≠ B.rightAtom.qIndex := by
  intro hidx
  have hsel : Q0.selectedColumn j' = Q0.selectedColumn C.col := by
    calc
      Q0.selectedColumn j' = M.qIndex := hM.symm
      _ = B.rightAtom.qIndex := hidx
      _ = Q0.selectedColumn C.col := B.right_qIndex
  exact hj' ((Q0.selectedColumn_injective) hsel)

theorem blocker_start_ne_left_stop
    (B : ClaimB3HillBracketAtomData inv C)
    {M : ClaimB2Atom I}
    (hM : M.qIndex = Q0.selectedColumn j')
    (hj' : j' ≠ C.col) :
    M.start ≠ B.leftAtom.stop := by
  intro hEq
  have hne : M.qIndex ≠ B.leftAtom.qIndex := by
    intro hidx
    exact B.left_middle_qIndex_ne hM hj' hidx.symm
  have hdisj :=
    Q0.qstar_nodeDisjoint_of_ne
      (i := M.qIndex) (j := B.leftAtom.qIndex)
      (hi := M.q_mem) (hj := B.leftAtom.q_mem) hne
  exact Finset.disjoint_left.mp hdisj M.start_mem_qstar
    (by simpa [hEq] using B.leftAtom.stop_mem_qstar)

theorem blocker_start_ne_right_stop
    (B : ClaimB3HillBracketAtomData inv C)
    {M : ClaimB2Atom I}
    (hM : M.qIndex = Q0.selectedColumn j')
    (hj' : j' ≠ C.col) :
    B.rightAtom.stop ≠ M.start := by
  intro hEq
  have hne : M.qIndex ≠ B.rightAtom.qIndex :=
    B.middle_right_qIndex_ne hM hj'
  have hdisj :=
    Q0.qstar_nodeDisjoint_of_ne
      (i := M.qIndex) (j := B.rightAtom.qIndex)
      (hi := M.q_mem) (hj := B.rightAtom.q_mem) hne
  exact Finset.disjoint_left.mp hdisj M.start_mem_qstar
    (by simpa [hEq] using B.rightAtom.stop_mem_qstar)

theorem blocker_stop_ne_left_start
    (B : ClaimB3HillBracketAtomData inv C)
    {M : ClaimB2Atom I}
    (hM : M.qIndex = Q0.selectedColumn j')
    (hj' : j' ≠ C.col) :
    B.leftAtom.start ≠ M.stop := by
  intro hEq
  have hne : B.leftAtom.qIndex ≠ M.qIndex :=
    B.left_middle_qIndex_ne hM hj'
  have hdisj :=
    Q0.qstar_nodeDisjoint_of_ne
      (i := B.leftAtom.qIndex) (j := M.qIndex)
      (hi := B.leftAtom.q_mem) (hj := M.q_mem) hne
  exact Finset.disjoint_left.mp hdisj B.leftAtom.start_mem_qstar
    (by simpa [hEq] using M.stop_mem_qstar)

theorem blocker_stop_ne_right_start
    (B : ClaimB3HillBracketAtomData inv C)
    {M : ClaimB2Atom I}
    (hM : M.qIndex = Q0.selectedColumn j')
    (hj' : j' ≠ C.col) :
    M.stop ≠ B.rightAtom.start := by
  intro hEq
  have hne : M.qIndex ≠ B.rightAtom.qIndex :=
    B.middle_right_qIndex_ne hM hj'
  have hdisj :=
    Q0.qstar_nodeDisjoint_of_ne
      (i := M.qIndex) (j := B.rightAtom.qIndex)
      (hi := M.q_mem) (hj := B.rightAtom.q_mem) hne
  exact Finset.disjoint_left.mp hdisj M.stop_mem_qstar
    (by simpa [hEq] using B.rightAtom.start_mem_qstar)

theorem blocker_start_ne_left_start
    (B : ClaimB3HillBracketAtomData inv C)
    {M : ClaimB2Atom I}
    (hM : M.qIndex = Q0.selectedColumn j')
    (hj' : j' ≠ C.col) :
    B.leftAtom.start ≠ M.start := by
  intro hEq
  have hne : B.leftAtom.qIndex ≠ M.qIndex :=
    B.left_middle_qIndex_ne hM hj'
  have hdisj :=
    Q0.qstar_nodeDisjoint_of_ne
      (i := B.leftAtom.qIndex) (j := M.qIndex)
      (hi := B.leftAtom.q_mem) (hj := M.q_mem) hne
  exact Finset.disjoint_left.mp hdisj B.leftAtom.start_mem_qstar
    (by simpa [hEq] using M.start_mem_qstar)

theorem blocker_start_ne_right_start
    (B : ClaimB3HillBracketAtomData inv C)
    {M : ClaimB2Atom I}
    (hM : M.qIndex = Q0.selectedColumn j')
    (hj' : j' ≠ C.col) :
    M.start ≠ B.rightAtom.start := by
  intro hEq
  have hne : M.qIndex ≠ B.rightAtom.qIndex :=
    B.middle_right_qIndex_ne hM hj'
  have hdisj :=
    Q0.qstar_nodeDisjoint_of_ne
      (i := M.qIndex) (j := B.rightAtom.qIndex)
      (hi := M.q_mem) (hj := B.rightAtom.q_mem) hne
