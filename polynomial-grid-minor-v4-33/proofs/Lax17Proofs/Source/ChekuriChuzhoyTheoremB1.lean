        linkageAuxDegreeTwoCount L' < linkageAuxDegreeTwoCount L := by
  have hpos : 0 < h := by omega
  exact reroutingConclusion_of_page60_actions_extended_ordered_claimB2_pathHillNormal
    (L := L) (h := h) hbad hlink hpos
    (D hpos).hbump (D hpos).hcross
    (D hpos).hbump_next_inv (D hpos).hcross_next_inv
    (fun S I Inv hterm =>
      let T := (D hpos).hterminal S I Inv hterm
      ⟨T.columns, T.claimB2, T.claimB3⟩)
    (D hpos).hTypeTwo

