  next := Cross.successorInputRightLeft haux hq0
  tilde_subset := Cross.successorInputRightLeft_tilde_subset haux hq0
  deleted_edge := deleted_edge
  deleted_edge_middle := hdeleted
  deleted_edge_new := hmissing

/-- The switched-order cross successor certificate preserves the explicit
linkage-support invariant. -/
theorem successorCertificateRightLeft_typeOneLinkageSupportInvariant
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathRightLeft)
    (hsupport : IterationInput.TypeOneLinkageSupportInvariant I)
    (deleted_edge : Sym2 V)
    (hdeleted :
      deleted_edge ∈ Cross.deletedLeftMiddle.edgeSet ∨
        deleted_edge ∈ Cross.deletedRightMiddle.edgeSet)
    (hmissing :
      deleted_edge ∉
        (Cross.successorInputRightLeft haux hq0).tildeEdgeSet) :
    IterationInput.TypeOneLinkageSupportInvariant
      (Cross.successorCertificateRightLeft_of_missing_deleted_edge haux hq0
        deleted_edge hdeleted hmissing).next :=
  Cross.successorInputRightLeft_typeOneLinkageSupportInvariant haux hq0
    hsupport

/-- The concrete switched-order cross successor certificate preserves the row
invariant package. -/
noncomputable def successorCertificateRightLeft_iterationInvariants
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathRightLeft)
    (Inv : TypeOneIterationInvariants I)
    (deleted_edge : Sym2 V)
    (hdeleted :
      deleted_edge ∈ Cross.deletedLeftMiddle.edgeSet ∨
        deleted_edge ∈ Cross.deletedRightMiddle.edgeSet)
    (hmissing :
      deleted_edge ∉
        (Cross.successorInputRightLeft haux hq0).tildeEdgeSet) :
    TypeOneIterationInvariants
      (Cross.successorCertificateRightLeft_of_missing_deleted_edge haux hq0
        deleted_edge hdeleted hmissing).next :=
  Cross.successorInputRightLeft_iterationInvariants haux hq0 Inv

/-- The concrete switched-order cross successor certificate preserves the full
invariant package once the local switched-order analysis has proved the active
auxiliary two-path invariant for the successor.

Unlike the left-to-right case, this branch swaps the two row indices in the
successor row map, so the needed active invariant is the local
`A -- Y -- X -- D` successor-path statement rather than same-index adjacency
preservation. -/
noncomputable def successorCertificateRightLeft_fullIterationInvariants
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathRightLeft)
    (Inv : TypeOneFullIterationInvariants I)
    (active :
      TypeOneActiveAuxiliaryInvariant
        (Cross.successorInputRightLeft haux hq0)
        (Cross.successorInputRightLeft_iterationInvariants haux hq0 Inv.base))
    (deleted_edge : Sym2 V)
    (hdeleted :
      deleted_edge ∈ Cross.deletedLeftMiddle.edgeSet ∨
        deleted_edge ∈ Cross.deletedRightMiddle.edgeSet)
    (hmissing :
      deleted_edge ∉
        (Cross.successorInputRightLeft haux hq0).tildeEdgeSet) :
    TypeOneFullIterationInvariants
      (Cross.successorCertificateRightLeft_of_missing_deleted_edge haux hq0
        deleted_edge hdeleted hmissing).next where
  base :=
    Cross.successorCertificateRightLeft_iterationInvariants haux hq0
      Inv.base deleted_edge hdeleted hmissing
  active_aux := by
    change TypeOneActiveAuxiliaryInvariant
      (Cross.successorInputRightLeft haux hq0)
      (Cross.successorInputRightLeft_iterationInvariants haux hq0 Inv.base)
    exact active

/-- Right-to-left full successor preservation from the local swapped-adjacency
description of the successor auxiliary graph. -/
noncomputable def successorCertificateRightLeft_fullIterationInvariants_of_swapAdj
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathRightLeft)
    (Inv : TypeOneFullIterationInvariants I)
    (hadj_swap :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) i)
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) j))
    (deleted_edge : Sym2 V)
    (hdeleted :
      deleted_edge ∈ Cross.deletedLeftMiddle.edgeSet ∨
        deleted_edge ∈ Cross.deletedRightMiddle.edgeSet)
    (hmissing :
      deleted_edge ∉
        (Cross.successorInputRightLeft haux hq0).tildeEdgeSet) :
    TypeOneFullIterationInvariants
      (Cross.successorCertificateRightLeft_of_missing_deleted_edge haux hq0
        deleted_edge hdeleted hmissing).next :=
  Cross.successorCertificateRightLeft_fullIterationInvariants haux hq0 Inv
    (Cross.successorInputRightLeft_activeAuxiliaryInvariant_of_swapAdj
      haux hq0 Inv.base Inv.active_aux hadj_swap)
    deleted_edge hdeleted hmissing

/-- The concrete switched-order cross successor certificate preserves the
extended full invariant package when the local analysis gives the swapped
auxiliary-adjacency description. -/
noncomputable def successorCertificateRightLeft_extendedFullIterationInvariants_of_swapAdj
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathRightLeft)
    (Inv : TypeOneExtendedFullIterationInvariants I)
    (hadj_swap :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) i)
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) j))
    (deleted_edge : Sym2 V)
    (hdeleted :
      deleted_edge ∈ Cross.deletedLeftMiddle.edgeSet ∨
        deleted_edge ∈ Cross.deletedRightMiddle.edgeSet)
    (hmissing :
      deleted_edge ∉
        (Cross.successorInputRightLeft haux hq0).tildeEdgeSet) :
    TypeOneExtendedFullIterationInvariants
      (Cross.successorCertificateRightLeft_of_missing_deleted_edge haux hq0
        deleted_edge hdeleted hmissing).next where
  full :=
    Cross.successorCertificateRightLeft_fullIterationInvariants_of_swapAdj
      haux hq0 Inv.full hadj_swap deleted_edge hdeleted hmissing
  boundary := by
    change TypeOneBoundaryAuxiliaryInvariant
      (Cross.successorInputRightLeft haux hq0)
      (Cross.successorInputRightLeft_iterationInvariants haux hq0
        Inv.full.base)
    exact Cross.successorInputRightLeft_boundaryAuxiliaryInvariant_of_swapAdj
      haux hq0 Inv hadj_swap

end CrossWitness

/-- The two possible outcomes of the cross action, matching the paragraph
headed “A cross.”  Either a local degree-two vertex is lost, or the
nonterminating isomorphic branch strictly decreases the maintained graph
`H̃`. -/
structure CrossActionCertificate {I : IterationInput R hpos Q0}
    (Cross : CrossWitness I) where
  degree_drop :
    (∃ L'' : PerfectPathPacking G A B,
      linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount I.linkage) ∨
      Nonempty (CrossSuccessorCertificate Cross)

namespace CrossActionCertificate

variable {I : IterationInput R hpos Q0} {Cross : CrossWitness I}

theorem simplifyingActionOutcome (C : CrossActionCertificate Cross) :
    SimplifyingActionOutcome I := by
  rcases C.degree_drop with hdrop | hsucc
  · exact Or.inl hdrop
  · rcases hsucc with ⟨S⟩
    exact Or.inr ⟨S.next, S.tilde_card_lt⟩

end CrossActionCertificate

namespace CrossWitness

variable {I : IterationInput R hpos Q0} (Cross : CrossWitness I)

/-- Assembles the formal conclusion of the paragraph “A cross.”

The hypotheses are the concrete facts proved in the paragraph after the two
switched rows are constructed:

* the switched rows form a linkage `L''`;
* every auxiliary edge change is supported on the local quadruple;
* the old local quadruple was degree two and the consecutive old/new local
  adjacencies hold, with the successor order already chosen as `A -- U -- V -- D`;
* if all four local degrees remain two, the caller supplies the successor
  iteration input whose maintained graph has lost a deleted middle edge.

The proof then exactly follows the paper's dichotomy: a changed local degree
gives a strict drop in `H(L)`'s degree-two count; otherwise the nonterminating
successor certificate gives the strict decrease of `H̃`. -/
theorem actionCertificate_of_supportedLocalDichotomy
    (hleft_right :
      Cross.replacementPaths.leftPath.NodeDisjoint
        Cross.replacementPaths.rightPath)
    (hleft_disj :
      ∀ i : I.linkage.Index,
        i ≠ I.rowIndex Cross.rowLeft →
          i ≠ I.rowIndex Cross.rowRight →
            Cross.replacementPaths.leftPath.NodeDisjoint
              (I.linkage.path i))
    (hright_disj :
      ∀ i : I.linkage.Index,
        i ≠ I.rowIndex Cross.rowLeft →
          i ≠ I.rowIndex Cross.rowRight →
            Cross.replacementPaths.rightPath.NodeDisjoint
              (I.linkage.path i))
    (auxL auxA auxU auxV auxD auxR : I.linkage.Index)
    (hsupport :
      AdjChangeSupportedIn (linkageAuxGraph I.linkage)
        (linkageAuxGraph
          (Cross.replacementLinkage hleft_right hleft_disj hright_disj))
        ({auxA, auxU, auxV, auxD} : Finset I.linkage.Index))
    (hLA_old : (linkageAuxGraph I.linkage).Adj auxA auxL)
    (hAU_old : (linkageAuxGraph I.linkage).Adj auxA auxU)
    (hUV_old : (linkageAuxGraph I.linkage).Adj auxU auxV)
    (hVD_old : (linkageAuxGraph I.linkage).Adj auxV auxD)
    (hDR_old : (linkageAuxGraph I.linkage).Adj auxD auxR)
    (hAU_new :
      (linkageAuxGraph
        (Cross.replacementLinkage hleft_right hleft_disj hright_disj)).Adj
        auxA auxU)
    (hUV_new :
      (linkageAuxGraph
        (Cross.replacementLinkage hleft_right hleft_disj hright_disj)).Adj
        auxU auxV)
    (hVD_new :
      (linkageAuxGraph
        (Cross.replacementLinkage hleft_right hleft_disj hright_disj)).Adj
        auxV auxD)
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hU_old : DegreeEquals (linkageAuxGraph I.linkage) auxU 2)
    (hV_old : DegreeEquals (linkageAuxGraph I.linkage) auxV 2)
    (hD_old : DegreeEquals (linkageAuxGraph I.linkage) auxD 2)
    (hL_not :
      auxL ∉ ({auxA, auxU, auxV, auxD} : Finset I.linkage.Index))
    (hR_not :
      auxR ∉ ({auxA, auxU, auxV, auxD} : Finset I.linkage.Index))
    (hLU : auxL ≠ auxU) (hRV : auxR ≠ auxV)
    (hAU_ne : auxA ≠ auxU) (hAD : auxA ≠ auxD)
    (hUD : auxU ≠ auxD) (hAV : auxA ≠ auxV)
    (hDV : auxD ≠ auxV) (hLD : auxL ≠ auxD)
    (hsucc : CrossSuccessorCertificate Cross) :
    CrossActionCertificate Cross := by
  classical
  let L'' : PerfectPathPacking G A B :=
    Cross.replacementLinkage hleft_right hleft_disj hright_disj
  have hdich :
      degreeTwoVertexCount (linkageAuxGraph L'') <
          degreeTwoVertexCount (linkageAuxGraph I.linkage) ∨
        ∀ u v : I.linkage.Index,
          (linkageAuxGraph L'').Adj u v ↔
            (linkageAuxGraph I.linkage).Adj u v := by
    exact
      cross_supported_degree_drop_or_aux_adj_iff
        (H := linkageAuxGraph I.linkage) (H' := linkageAuxGraph L'')
        (L := auxL) (A := auxA) (U := auxU) (V := auxV)
        (D := auxD) (R := auxR)
        hsupport hLA_old hAU_old hUV_old hVD_old hDR_old
        hAU_new hUV_new hVD_new hA_old hU_old hV_old hD_old
        hL_not hR_not hLU hRV hAU_ne hAD hUD hAV hDV hLD
  refine ⟨?_⟩
  rcases hdich with hdrop | _hiso
  · exact Or.inl ⟨L'', by
      simpa [L'', linkageAuxDegreeTwoCount] using hdrop⟩
  · exact Or.inr ⟨hsucc⟩

/-- A sharper form of `actionCertificate_of_supportedLocalDichotomy`.

The successor certificate is only needed in the nonterminating branch where
all four local successor vertices still have degree two.  This matches the
paper's actual control flow: if one local degree changes, the algorithm stops
with a degree-two-count drop and no successor invariant has to be constructed. -/
theorem actionCertificate_of_supportedLocalDichotomy_conditionalSuccessor
    (hleft_right :
      Cross.replacementPaths.leftPath.NodeDisjoint
        Cross.replacementPaths.rightPath)
    (hleft_disj :
      ∀ i : I.linkage.Index,
        i ≠ I.rowIndex Cross.rowLeft →
          i ≠ I.rowIndex Cross.rowRight →
            Cross.replacementPaths.leftPath.NodeDisjoint
              (I.linkage.path i))
    (hright_disj :
      ∀ i : I.linkage.Index,
        i ≠ I.rowIndex Cross.rowLeft →
          i ≠ I.rowIndex Cross.rowRight →
            Cross.replacementPaths.rightPath.NodeDisjoint
              (I.linkage.path i))
    (auxL auxA auxU auxV auxD auxR : I.linkage.Index)
    (hsupport :
      AdjChangeSupportedIn (linkageAuxGraph I.linkage)
        (linkageAuxGraph
          (Cross.replacementLinkage hleft_right hleft_disj hright_disj))
        ({auxA, auxU, auxV, auxD} : Finset I.linkage.Index))
    (hLA_old : (linkageAuxGraph I.linkage).Adj auxA auxL)
    (hAU_old : (linkageAuxGraph I.linkage).Adj auxA auxU)
    (hUV_old : (linkageAuxGraph I.linkage).Adj auxU auxV)
    (hVD_old : (linkageAuxGraph I.linkage).Adj auxV auxD)
    (hDR_old : (linkageAuxGraph I.linkage).Adj auxD auxR)
    (hAU_new :
      (linkageAuxGraph
        (Cross.replacementLinkage hleft_right hleft_disj hright_disj)).Adj
        auxA auxU)
    (hUV_new :
      (linkageAuxGraph
        (Cross.replacementLinkage hleft_right hleft_disj hright_disj)).Adj
        auxU auxV)
    (hVD_new :
      (linkageAuxGraph
        (Cross.replacementLinkage hleft_right hleft_disj hright_disj)).Adj
        auxV auxD)
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hU_old : DegreeEquals (linkageAuxGraph I.linkage) auxU 2)
    (hV_old : DegreeEquals (linkageAuxGraph I.linkage) auxV 2)
    (hD_old : DegreeEquals (linkageAuxGraph I.linkage) auxD 2)
    (hsucc :
      DegreeEquals
        (linkageAuxGraph
          (Cross.replacementLinkage hleft_right hleft_disj hright_disj))
        auxA 2 →
      DegreeEquals
        (linkageAuxGraph
          (Cross.replacementLinkage hleft_right hleft_disj hright_disj))
        auxU 2 →
      DegreeEquals
        (linkageAuxGraph
          (Cross.replacementLinkage hleft_right hleft_disj hright_disj))
        auxV 2 →
      DegreeEquals
        (linkageAuxGraph
          (Cross.replacementLinkage hleft_right hleft_disj hright_disj))
        auxD 2 →
      CrossSuccessorCertificate Cross) :
    CrossActionCertificate Cross := by
  classical
  let L'' : PerfectPathPacking G A B :=
    Cross.replacementLinkage hleft_right hleft_disj hright_disj
  let S : Finset I.linkage.Index := {auxA, auxU, auxV, auxD}
  have hlocal_old :
      ∀ x : I.linkage.Index, x ∈ S →
        DegreeEquals (linkageAuxGraph I.linkage) x 2 := by
    intro x hx
    simp [S] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · exact hA_old
    · exact hU_old
    · exact hV_old
    · exact hD_old
  refine ⟨?_⟩
  by_cases hA_new : DegreeEquals (linkageAuxGraph L'') auxA 2
  · by_cases hU_new : DegreeEquals (linkageAuxGraph L'') auxU 2
    · by_cases hV_new : DegreeEquals (linkageAuxGraph L'') auxV 2
      · by_cases hD_new : DegreeEquals (linkageAuxGraph L'') auxD 2
        · exact Or.inr ⟨hsucc hA_new hU_new hV_new hD_new⟩
        · exact Or.inl ⟨L'', by
            have hdrop :
                degreeTwoVertexCount (linkageAuxGraph L'') <
                  degreeTwoVertexCount (linkageAuxGraph I.linkage) :=
              degreeTwoVertexCount_lt_of_supported_local_drop
                (linkageAuxGraph I.linkage) (linkageAuxGraph L'') S
                (by simpa [S, L''] using hsupport) hlocal_old
                ⟨auxD, by simp [S], hD_new⟩
            simpa [L'', linkageAuxDegreeTwoCount] using hdrop⟩
      · exact Or.inl ⟨L'', by
          have hdrop :
              degreeTwoVertexCount (linkageAuxGraph L'') <
                degreeTwoVertexCount (linkageAuxGraph I.linkage) :=
            degreeTwoVertexCount_lt_of_supported_local_drop
              (linkageAuxGraph I.linkage) (linkageAuxGraph L'') S
              (by simpa [S, L''] using hsupport) hlocal_old
              ⟨auxV, by simp [S], hV_new⟩
          simpa [L'', linkageAuxDegreeTwoCount] using hdrop⟩
    · exact Or.inl ⟨L'', by
        have hdrop :
            degreeTwoVertexCount (linkageAuxGraph L'') <
              degreeTwoVertexCount (linkageAuxGraph I.linkage) :=
          degreeTwoVertexCount_lt_of_supported_local_drop
            (linkageAuxGraph I.linkage) (linkageAuxGraph L'') S
            (by simpa [S, L''] using hsupport) hlocal_old
            ⟨auxU, by simp [S], hU_new⟩
        simpa [L'', linkageAuxDegreeTwoCount] using hdrop⟩
  · exact Or.inl ⟨L'', by
      have hdrop :
          degreeTwoVertexCount (linkageAuxGraph L'') <
            degreeTwoVertexCount (linkageAuxGraph I.linkage) :=
        degreeTwoVertexCount_lt_of_supported_local_drop
          (linkageAuxGraph I.linkage) (linkageAuxGraph L'') S
          (by simpa [S, L''] using hsupport) hlocal_old
          ⟨auxA, by simp [S], hA_new⟩
      simpa [L'', linkageAuxDegreeTwoCount] using hdrop⟩

/-- Minimal cross control-flow lemma.

This is the part of the cross paragraph that is independent of which of the
two replacement rows is first in the successor order.  If all auxiliary-edge
changes are supported on a local set `S`, and every vertex of `S` was degree
two before the cross, then either some local successor degree is no longer two
and the auxiliary degree-two count drops, or the caller may use the supplied
nonterminating successor certificate. -/
theorem actionCertificate_of_supportedLocalDegreeTest_conditionalSuccessor
    (S : Finset I.linkage.Index)
    (hsupport :
      AdjChangeSupportedIn (linkageAuxGraph I.linkage)
        (linkageAuxGraph Cross.replacementLinkageConcrete) S)
    (hlocal_old :
      ∀ x : I.linkage.Index, x ∈ S →
        DegreeEquals (linkageAuxGraph I.linkage) x 2)
    (hsucc :
      (∀ x : I.linkage.Index, x ∈ S →
        DegreeEquals (linkageAuxGraph Cross.replacementLinkageConcrete) x 2) →
          CrossSuccessorCertificate Cross) :
    CrossActionCertificate Cross := by
  classical
  let L'' : PerfectPathPacking G A B := Cross.replacementLinkageConcrete
  refine ⟨?_⟩
  by_cases hall :
      ∀ x : I.linkage.Index, x ∈ S →
        DegreeEquals (linkageAuxGraph L'') x 2
  · exact Or.inr ⟨hsucc (by simpa [L''] using hall)⟩
  · have hdrop_local :
        ∃ x : I.linkage.Index, x ∈ S ∧
          ¬ DegreeEquals (linkageAuxGraph L'') x 2 := by
      by_contra hnone
      apply hall
      intro x hx
      by_contra hxdeg
      exact hnone ⟨x, hx, hxdeg⟩
    have hdrop :
        degreeTwoVertexCount (linkageAuxGraph L'') <
          degreeTwoVertexCount (linkageAuxGraph I.linkage) :=
      degreeTwoVertexCount_lt_of_supported_local_drop
        (linkageAuxGraph I.linkage) (linkageAuxGraph L'') S
        (by simpa [L''] using hsupport) hlocal_old hdrop_local
    exact Or.inl ⟨L'', by
      simpa [L'', linkageAuxDegreeTwoCount] using hdrop⟩

/-- Direct simplifying-action form of `actionCertificate_of_supportedLocalDichotomy`. -/
theorem simplifyingActionOutcome_of_supportedLocalDichotomy
    (hleft_right :
      Cross.replacementPaths.leftPath.NodeDisjoint
        Cross.replacementPaths.rightPath)
    (hleft_disj :
      ∀ i : I.linkage.Index,
        i ≠ I.rowIndex Cross.rowLeft →
          i ≠ I.rowIndex Cross.rowRight →
            Cross.replacementPaths.leftPath.NodeDisjoint
              (I.linkage.path i))
    (hright_disj :
      ∀ i : I.linkage.Index,
        i ≠ I.rowIndex Cross.rowLeft →
          i ≠ I.rowIndex Cross.rowRight →
            Cross.replacementPaths.rightPath.NodeDisjoint
              (I.linkage.path i))
    (auxL auxA auxU auxV auxD auxR : I.linkage.Index)
    (hsupport :
      AdjChangeSupportedIn (linkageAuxGraph I.linkage)
        (linkageAuxGraph
          (Cross.replacementLinkage hleft_right hleft_disj hright_disj))
        ({auxA, auxU, auxV, auxD} : Finset I.linkage.Index))
    (hLA_old : (linkageAuxGraph I.linkage).Adj auxA auxL)
    (hAU_old : (linkageAuxGraph I.linkage).Adj auxA auxU)
    (hUV_old : (linkageAuxGraph I.linkage).Adj auxU auxV)
    (hVD_old : (linkageAuxGraph I.linkage).Adj auxV auxD)
    (hDR_old : (linkageAuxGraph I.linkage).Adj auxD auxR)
    (hAU_new :
      (linkageAuxGraph
        (Cross.replacementLinkage hleft_right hleft_disj hright_disj)).Adj
        auxA auxU)
    (hUV_new :
      (linkageAuxGraph
        (Cross.replacementLinkage hleft_right hleft_disj hright_disj)).Adj
        auxU auxV)
    (hVD_new :
      (linkageAuxGraph
        (Cross.replacementLinkage hleft_right hleft_disj hright_disj)).Adj
        auxV auxD)
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hU_old : DegreeEquals (linkageAuxGraph I.linkage) auxU 2)
    (hV_old : DegreeEquals (linkageAuxGraph I.linkage) auxV 2)
    (hD_old : DegreeEquals (linkageAuxGraph I.linkage) auxD 2)
    (hL_not :
      auxL ∉ ({auxA, auxU, auxV, auxD} : Finset I.linkage.Index))
    (hR_not :
      auxR ∉ ({auxA, auxU, auxV, auxD} : Finset I.linkage.Index))
    (hLU : auxL ≠ auxU) (hRV : auxR ≠ auxV)
    (hAU_ne : auxA ≠ auxU) (hAD : auxA ≠ auxD)
    (hUD : auxU ≠ auxD) (hAV : auxA ≠ auxV)
    (hDV : auxD ≠ auxV) (hLD : auxL ≠ auxD)
    (hsucc : CrossSuccessorCertificate Cross) :
    SimplifyingActionOutcome I :=
  (Cross.actionCertificate_of_supportedLocalDichotomy hleft_right hleft_disj
    hright_disj auxL auxA auxU auxV auxD auxR hsupport hLA_old hAU_old
    hUV_old hVD_old hDR_old hAU_new hUV_new hVD_new hA_old hU_old
    hV_old hD_old hL_not hR_not hLU hRV hAU_ne hAD hUD hAV hDV hLD
    hsucc).simplifyingActionOutcome

/-- Concrete form of the cross action dichotomy.  The replacement linkage is
the one constructed directly from the cross witness, so no disjointness
hypotheses remain in the statement. -/
theorem actionCertificate_of_supportedLocalDichotomy_concrete
    (auxL auxA auxU auxV auxD auxR : I.linkage.Index)
    (hsupport :
      AdjChangeSupportedIn (linkageAuxGraph I.linkage)
        (linkageAuxGraph Cross.replacementLinkageConcrete)
        ({auxA, auxU, auxV, auxD} : Finset I.linkage.Index))
    (hLA_old : (linkageAuxGraph I.linkage).Adj auxA auxL)
    (hAU_old : (linkageAuxGraph I.linkage).Adj auxA auxU)
    (hUV_old : (linkageAuxGraph I.linkage).Adj auxU auxV)
    (hVD_old : (linkageAuxGraph I.linkage).Adj auxV auxD)
    (hDR_old : (linkageAuxGraph I.linkage).Adj auxD auxR)
    (hAU_new :
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj auxA auxU)
    (hUV_new :
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj auxU auxV)
    (hVD_new :
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj auxV auxD)
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hU_old : DegreeEquals (linkageAuxGraph I.linkage) auxU 2)
    (hV_old : DegreeEquals (linkageAuxGraph I.linkage) auxV 2)
    (hD_old : DegreeEquals (linkageAuxGraph I.linkage) auxD 2)
    (hL_not :
      auxL ∉ ({auxA, auxU, auxV, auxD} : Finset I.linkage.Index))
    (hR_not :
      auxR ∉ ({auxA, auxU, auxV, auxD} : Finset I.linkage.Index))
    (hLU : auxL ≠ auxU) (hRV : auxR ≠ auxV)
    (hAU_ne : auxA ≠ auxU) (hAD : auxA ≠ auxD)
    (hUD : auxU ≠ auxD) (hAV : auxA ≠ auxV)
    (hDV : auxD ≠ auxV) (hLD : auxL ≠ auxD)
    (hsucc : CrossSuccessorCertificate Cross) :
    CrossActionCertificate Cross :=
  Cross.actionCertificate_of_supportedLocalDichotomy
    Cross.replacementPaths_nodeDisjoint
    (fun _ hileft hiright =>
      Cross.replacementPaths_left_nodeDisjoint_unchanged hileft hiright)
    (fun _ hileft hiright =>
      Cross.replacementPaths_right_nodeDisjoint_unchanged hileft hiright)
    auxL auxA auxU auxV auxD auxR
    (by simpa [replacementLinkageConcrete] using hsupport)
    hLA_old hAU_old hUV_old hVD_old hDR_old
    (by simpa [replacementLinkageConcrete] using hAU_new)
    (by simpa [replacementLinkageConcrete] using hUV_new)
    (by simpa [replacementLinkageConcrete] using hVD_new)
    hA_old hU_old hV_old hD_old hL_not hR_not hLU hRV hAU_ne
    hAD hUD hAV hDV hLD hsucc

/-- Concrete cross dichotomy in the successor order where the first switched
row precedes the second one.  The middle successor adjacency is not an input:
it is witnessed by the deleted left middle row segment. -/
theorem actionCertificate_of_supportedLocalDichotomy_leftRightOrder
    (auxL auxA auxD auxR : I.linkage.Index)
    (hsupport :
      AdjChangeSupportedIn (linkageAuxGraph I.linkage)
        (linkageAuxGraph Cross.replacementLinkageConcrete)
        ({auxA, I.rowIndex Cross.rowLeft, I.rowIndex Cross.rowRight, auxD} :
          Finset I.linkage.Index))
    (hLA_old : (linkageAuxGraph I.linkage).Adj auxA auxL)
    (hAU_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Cross.rowLeft))
    (hUV_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight))
    (hVD_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hDR_old : (linkageAuxGraph I.linkage).Adj auxD auxR)
    (hAU_new :
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        auxA (I.rowIndex Cross.rowLeft))
    (hVD_new :
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hU_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowLeft) 2)
    (hV_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowRight) 2)
    (hD_old : DegreeEquals (linkageAuxGraph I.linkage) auxD 2)
    (hL_not :
      auxL ∉ ({auxA, I.rowIndex Cross.rowLeft,
        I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index))
    (hR_not :
      auxR ∉ ({auxA, I.rowIndex Cross.rowLeft,
        I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index))
    (hLU : auxL ≠ I.rowIndex Cross.rowLeft)
    (hRV : auxR ≠ I.rowIndex Cross.rowRight)
    (hAU_ne : auxA ≠ I.rowIndex Cross.rowLeft)
    (hAD : auxA ≠ auxD)
    (hUD : I.rowIndex Cross.rowLeft ≠ auxD)
    (hAV : auxA ≠ I.rowIndex Cross.rowRight)
    (hDV : auxD ≠ I.rowIndex Cross.rowRight)
    (hLD : auxL ≠ auxD)
    (hsucc : CrossSuccessorCertificate Cross) :
    CrossActionCertificate Cross :=
  Cross.actionCertificate_of_supportedLocalDichotomy_concrete
    auxL auxA (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
    auxD auxR hsupport hLA_old hAU_old hUV_old hVD_old hDR_old
    hAU_new Cross.replacementLinkageConcrete_adj_left_right_from_deletedLeftMiddle
    hVD_new hA_old hU_old hV_old hD_old hL_not hR_not hLU hRV
    hAU_ne hAD hUD hAV hDV hLD hsucc

/-- Left-to-right cross dichotomy with no external support hypothesis and with
the successor data required only in the nonterminating degree-two branch. -/
theorem actionCertificate_of_localDichotomy_leftRightOrder_conditionalSuccessor
    (auxL auxA auxD auxR : I.linkage.Index)
    (hLA_old : (linkageAuxGraph I.linkage).Adj auxA auxL)
    (hAU_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Cross.rowLeft))
    (hUV_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight))
    (hVD_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hDR_old : (linkageAuxGraph I.linkage).Adj auxD auxR)
    (hAU_new :
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        auxA (I.rowIndex Cross.rowLeft))
    (hVD_new :
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hU_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowLeft) 2)
    (hV_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowRight) 2)
    (hD_old : DegreeEquals (linkageAuxGraph I.linkage) auxD 2)
    (hUD : I.rowIndex Cross.rowLeft ≠ auxD)
    (hAV : auxA ≠ I.rowIndex Cross.rowRight)
    (hsucc :
      DegreeEquals (linkageAuxGraph Cross.replacementLinkageConcrete) auxA 2 →
      DegreeEquals (linkageAuxGraph Cross.replacementLinkageConcrete)
        (I.rowIndex Cross.rowLeft) 2 →
      DegreeEquals (linkageAuxGraph Cross.replacementLinkageConcrete)
        (I.rowIndex Cross.rowRight) 2 →
      DegreeEquals (linkageAuxGraph Cross.replacementLinkageConcrete) auxD 2 →
      CrossSuccessorCertificate Cross) :
    CrossActionCertificate Cross :=
  Cross.actionCertificate_of_supportedLocalDichotomy_conditionalSuccessor
    Cross.replacementPaths_nodeDisjoint
    (fun _ hileft hiright =>
      Cross.replacementPaths_left_nodeDisjoint_unchanged hileft hiright)
    (fun _ hileft hiright =>
      Cross.replacementPaths_right_nodeDisjoint_unchanged hileft hiright)
    auxL auxA (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
    auxD auxR
    (by
      simpa [replacementLinkageConcrete, replacementLinkageOfDisjointUnchanged]
        using Cross.cross_adjChangeSupportedIn auxA auxD hAU_old hUV_old
          hVD_old hU_old hV_old hAV hUD)
    hLA_old hAU_old hUV_old hVD_old hDR_old
    (by
      simpa [replacementLinkageConcrete, replacementLinkageOfDisjointUnchanged]
        using hAU_new)
    (by
      simpa [replacementLinkageConcrete, replacementLinkageOfDisjointUnchanged]
        using Cross.replacementLinkageConcrete_adj_left_right_from_deletedLeftMiddle)
    (by
      simpa [replacementLinkageConcrete, replacementLinkageOfDisjointUnchanged]
        using hVD_new)
    hA_old hU_old hV_old hD_old
    (fun hA_new hU_new hV_new hD_new =>
      hsucc
        (by
          simpa [replacementLinkageConcrete, replacementLinkageOfDisjointUnchanged]
            using hA_new)
        (by
          simpa [replacementLinkageConcrete, replacementLinkageOfDisjointUnchanged]
            using hU_new)
        (by
          simpa [replacementLinkageConcrete, replacementLinkageOfDisjointUnchanged]
            using hV_new)
        (by
          simpa [replacementLinkageConcrete, replacementLinkageOfDisjointUnchanged]
            using hD_new))

/-- In the left-to-right nonterminating branch of a cross, the auxiliary graph
of the concrete replacement linkage is isomorphic to the old auxiliary graph.
The support hypothesis is discharged by the formal Figure 8 locality theorem. -/
theorem auxGraphsIsomorphic_of_localDichotomy_leftRightOrder_degreeTwo
    (auxL auxA auxD auxR : I.linkage.Index)
    (hLA_old : (linkageAuxGraph I.linkage).Adj auxA auxL)
    (hAU_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Cross.rowLeft))
    (hUV_old :
