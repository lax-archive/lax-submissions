/-- Build the full paper-level invariant for a concrete bump successor once
the only remaining successor fact, all-`Q₀` future-cleanliness, has been
proved.

The row-order/auxiliary/boundary part and the linkage-support part are
constructed by the formal Figure 7 successor lemmas. -/
noncomputable def successorCertificate_extendedFutureCleanIterationInvariants_of_allQ0
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (haux : AuxGraphsIsomorphic L (Bump.replacementLinkage hdisj))
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Bump.successorRowPath)
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph (Bump.replacementLinkage hdisj)).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j)
    (deleted_edge : Sym2 V)
    (hdeleted : deleted_edge ∈ Bump.deletedRowSegment.edgeSet)
    (hmissing :
      deleted_edge ∉
        (Bump.successorInput hdisj Inv.base.rowIndexInjective haux hq0).tildeEdgeSet) :
    TypeOneExtendedFutureCleanIterationInvariants
      (Bump.successorCertificate_of_missing_deleted_edge hdisj
        Inv.base.rowIndexInjective haux hq0 deleted_edge hdeleted
        hmissing).next :=
  let full :=
    Bump.successorCertificate_extendedFullIterationInvariants hdisj haux
      hq0 Inv.extended hadj_iff deleted_edge hdeleted hmissing
  let support :=
    Bump.successorCertificate_typeOneLinkageSupportInvariant hdisj
      Inv.base.rowIndexInjective haux hq0 Inv.linkage_support deleted_edge
      hdeleted hmissing
  TypeOneExtendedFutureCleanIterationInvariants.mkOfAllQ0 full support
    (TypeOneAllQ0RowCleanSubsegmentsFullClean_of_support full support)

/-- The concrete bump successor produced by choosing an uncovered deleted
middle edge carries the full paper-level invariant. -/
noncomputable def successorCertificate_constructed_extendedFutureCleanIterationInvariants
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (haux : AuxGraphsIsomorphic L (Bump.replacementLinkage hdisj))
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Bump.successorRowPath)
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph (Bump.replacementLinkage hdisj)).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j) :
    TypeOneExtendedFutureCleanIterationInvariants
      (Bump.successorCertificate_of_constructed_deleted_edge hdisj
        Inv.base.rowIndexInjective haux hq0).next := by
  classical
  let deleted_edge : Sym2 V :=
    Classical.choose Bump.exists_deletedRowSegment_edge_not_mem_Q0
  have hdeleted :
      deleted_edge ∈ Bump.deletedRowSegment.edgeSet :=
    (Classical.choose_spec
      Bump.exists_deletedRowSegment_edge_not_mem_Q0).1
  have hnotQ0 : deleted_edge ∉ Q0.edgeSet :=
    (Classical.choose_spec
      Bump.exists_deletedRowSegment_edge_not_mem_Q0).2
  have hmissing :
      deleted_edge ∉
        (Bump.successorInput hdisj Inv.base.rowIndexInjective haux hq0).tildeEdgeSet :=
    Bump.deletedRowSegment_edge_not_mem_successorTilde_of_not_mem_Q0
      hdisj Inv.base.rowIndexInjective haux hq0 hdeleted hnotQ0
  exact
    Bump.successorCertificate_extendedFutureCleanIterationInvariants_of_allQ0
      hdisj haux hq0 Inv hadj_iff deleted_edge hdeleted hmissing

end BumpWitness

