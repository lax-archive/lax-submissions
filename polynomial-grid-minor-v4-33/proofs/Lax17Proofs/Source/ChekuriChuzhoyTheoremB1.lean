    CrossPaperActionUpdate Inv Cross :=
  Cross.paperActionUpdate_rightLeft_of_localDichotomy_constructedSuccessor_hitsReplacements
    Inv auxL auxA auxD auxR hLA_old hAU_old hUV_old hVD_old hDR_old
    hAV_new hUD_new hA_old hU_old hV_old hD_old hU_new hV_new
    hL_not hR_not hLU hRV hAU_ne hAD hUD hAV hDV hLD
    (fun i hi => by
      rcases htrace i hi with ⟨T⟩
      have hhit := T.hits_all_rows Cross.rowRight
      simpa using hhit)
    (fun i hi => by
      rcases htrace i hi with ⟨T⟩
      have hhit := T.hits_all_rows Cross.rowLeft
      simpa using hhit)

