    ContainsGridMinor G h ∨
      ∃ L'' : PerfectPathPacking G A B,
        linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount L := by
  refine gridMinor_or_degree_drop_of_invariant_actions ?_ hterminal I₀ Inv₀
  intro I Inv hnot
  exact invariantSimplifyingActionOutcome_of_action_certificates
    hbump hcross hbump_next_inv hcross_next_inv I Inv hnot

/-- The invariant-aware theorem-shaped loop specialized to ordinary
bump/cross action certificates, with the terminal branch split into Claims
B.2 and B.3. -/
theorem gridMinor_or_degree_drop_of_action_certificates_with_claimB2_B3
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (hbump :
