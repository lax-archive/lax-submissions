Compared with `reroutingConclusion_of_page60_full_step_terminal_proof_data`,
this avoids the terminal sparse-grid proof-data package.  The maintained
full invariant supplies the terminal no-chord fact needed by Claim B.3. -/
theorem reroutingConclusion_of_page60_full_step_claimB2_flexibleB3
    [Fintype V] {L : PerfectPathPacking G A B} {h : ℕ}
    (hbad : ¬ GoodLinkage L h)
    (hlink : NodeLinkedIn G Finset.univ A B)
    (hpos : 0 < h)
    (hstep :
      ∀ {R : IndexedAuxiliaryPrefix L h}
        {Q : PerfectPathPacking G R.X R.Y}
        (S : TypeOneIterationSetup R hpos Q)
        (I : IterationInput R hpos S.Q0)
        (_Inv : TypeOneFullIterationInvariants I),
          ¬ NoBumpNoCross I → FullInvariantSimplifyingActionOutcome I)
    (hclaimB2 :
      ∀ {R : IndexedAuxiliaryPrefix L h}
        {Q : PerfectPathPacking G R.X R.Y}
        (S : TypeOneIterationSetup R hpos Q)
        (I : IterationInput R hpos S.Q0)
        (Inv : TypeOneFullIterationInvariants I),
          NoBumpNoCross I → ClaimB2TerminalGridAdjacencies I Inv.base)
    (hno_hill :
      ∀ {R : IndexedAuxiliaryPrefix L h}
        {Q : PerfectPathPacking G R.X R.Y}
        (S : TypeOneIterationSetup R hpos Q)
        (I : IterationInput R hpos S.Q0)
        (Inv : TypeOneFullIterationInvariants I),
          NoBumpNoCross I → ClaimB3NoHill I Inv.base)
    (hatomized_trace :
      ∀ {R : IndexedAuxiliaryPrefix L h}
        {Q : PerfectPathPacking G R.X R.Y}
        (S : TypeOneIterationSetup R hpos Q)
        (I : IterationInput R hpos S.Q0)
        (Inv : TypeOneFullIterationInvariants I),
          NoBumpNoCross I →
            ClaimB3AtomizedTraceCompressionExtractionCertificate I Inv.base)
    (htrace_last_zero :
      ∀ {R : IndexedAuxiliaryPrefix L h}
        {Q : PerfectPathPacking G R.X R.Y}
        (S : TypeOneIterationSetup R hpos Q)
        (I : IterationInput R hpos S.Q0)
        (Inv : TypeOneFullIterationInvariants I)
        (hterm : NoBumpNoCross I),
          ∀ j : Fin h,
            (((hatomized_trace S I Inv hterm).blocks j).blockRow
              ⟨((hatomized_trace S I Inv hterm).blocks j).len,
                by omega⟩).1 = 0)
    (hTypeTwo :
      ∀ {R : IndexedAuxiliaryPrefix L h}
        {Q : PerfectPathPacking G R.X R.Y},
        TypeTwoIterationSetup R hpos Q → ReroutingConclusion G h L) :
    ReroutingConclusion G h L := by
  refine reroutingConclusion_of_page60_branch_handlers
    (L := L) (h := h) hbad hlink hpos ?_ hTypeTwo
  intro R Q S
  exact S.gridMinor_or_degree_drop_of_full_invariant_actions
    (fun I Inv hnot => hstep S I Inv hnot)
    (fun I Inv hterm =>
      (TerminalIntersectionCoreData.of_claimB2_B3 Inv.base
        (hclaimB2 S I Inv hterm)
        (claimB3_connectedIntersections_of_trace_valley_flexible
          hterm
          Inv.active_aux.terminalRowsAuxNoChord
          (hno_hill S I Inv hterm)
          (hatomized_trace S I Inv hterm)
          (htrace_last_zero S I Inv hterm))).containsGridMinor)

