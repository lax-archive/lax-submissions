        change pL.1 + 1 = nextFin.1 ∨ nextFin.1 + 1 = pL.1
        left
        simp [nextFin, pL]
      let prevFin : Fin (z h) := ⟨pR.1 - 1, by omega⟩
      let prevRow : I.Row := order.symm prevFin
      have hprev_order : order prevRow = prevFin := by
        simp [prevRow]
      have hcon_prev :
          FinConsecutive (order prevRow) (order Cross.rowRight) := by
        rw [hprev_order]
        change prevFin.1 + 1 = pR.1 ∨ pR.1 + 1 = prevFin.1
        left
        simp [prevFin, pR]
        omega
      have h_next_ne_left :
          I.rowIndex nextRow ≠ I.rowIndex Cross.rowLeft :=
        Inv.base.rowIndex_ne_of_order_val_ne (by
          change (order nextRow).1 ≠ (order Cross.rowLeft).1
          rw [hnext_order]
          change nextFin.1 ≠ pL.1
          simp [nextFin])
      have h_next_ne_right :
          I.rowIndex nextRow ≠ I.rowIndex Cross.rowRight :=
        Inv.base.rowIndex_ne_of_order_val_ne (by
          change (order nextRow).1 ≠ (order Cross.rowRight).1
          rw [hnext_order]
          change nextFin.1 ≠ pR.1
          simp [nextFin]
          omega)
      have h_prev_ne_left :
          I.rowIndex prevRow ≠ I.rowIndex Cross.rowLeft :=
        Inv.base.rowIndex_ne_of_order_val_ne (by
          change (order prevRow).1 ≠ (order Cross.rowLeft).1
          rw [hprev_order]
          change prevFin.1 ≠ pL.1
          simp [prevFin]
          omega)
      have h_prev_ne_right :
          I.rowIndex prevRow ≠ I.rowIndex Cross.rowRight :=
        Inv.base.rowIndex_ne_of_order_val_ne (by
          change (order prevRow).1 ≠ (order Cross.rowRight).1
          rw [hprev_order]
          change prevFin.1 ≠ pR.1
          simp [prevFin]
          omega)
      have h_next_ne_prev :
          I.rowIndex nextRow ≠ I.rowIndex prevRow :=
        Inv.base.rowIndex_ne_of_order_val_ne (by
          change (order nextRow).1 ≠ (order prevRow).1
          rw [hnext_order, hprev_order]
          simp [nextFin, prevFin]
          omega)
      by_cases hright_second : pR.1 = 1
      · have hprev_row_first :
            prevRow =
              order.symm (⟨0, by
                dsimp [z]
                omega⟩ : Fin (z h)) := by
          apply order.injective
          apply Fin.ext
          simp [hprev_order, prevFin]
          omega
        refine
          { auxL := Inv.extended.boundary.upperBoundary
            auxA := I.rowIndex nextRow
            auxD := I.rowIndex prevRow
            auxR := Inv.extended.boundary.lowerBoundary
            hLA_old := ?_
            hAU_old := ?_
            hUV_old := Cross.old_aux_adj_left_right
            hVD_old := ?_
            hDR_old := ?_
            hA_old := Inv.extended.full.active_aux.degree_two nextRow
            hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
            hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
            hD_old := Inv.extended.full.active_aux.degree_two prevRow
            hL_not := ?_
            hR_not := ?_
            hLU := Inv.extended.boundary.upper_ne_row Cross.rowLeft
            hRV := Inv.extended.boundary.lower_ne_row Cross.rowRight
            hAU_ne := h_next_ne_left
            hAD := h_next_ne_prev
            hUD := h_prev_ne_left.symm
            hAV := h_next_ne_right
            hDV := h_prev_ne_right
            hLD := (Inv.extended.boundary.upper_ne_row prevRow) }
        · simpa [hnext_row_last] using Inv.extended.boundary.last_adj_upper
        · exact H.symm (Inv.extended.full.active_aux.consecutive_adj hcon_next)
        · exact H.symm (Inv.extended.full.active_aux.consecutive_adj hcon_prev)
        · exact H.symm (by
            simpa [hprev_row_first] using
              Inv.extended.boundary.lower_adj_first)
        · simp [Inv.extended.boundary.upper_ne_row nextRow,
            Inv.extended.boundary.upper_ne_row Cross.rowLeft,
            Inv.extended.boundary.upper_ne_row Cross.rowRight,
            Inv.extended.boundary.upper_ne_row prevRow]
        · simp [Inv.extended.boundary.lower_ne_row nextRow,
            Inv.extended.boundary.lower_ne_row Cross.rowLeft,
            Inv.extended.boundary.lower_ne_row Cross.rowRight,
            Inv.extended.boundary.lower_ne_row prevRow]
      · let prevPrevFin : Fin (z h) := ⟨pR.1 - 2, by omega⟩
        let prevPrevRow : I.Row := order.symm prevPrevFin
        have hprevPrev_order : order prevPrevRow = prevPrevFin := by
          simp [prevPrevRow]
        have hcon_prevPrev :
            FinConsecutive (order prevPrevRow) (order prevRow) := by
          rw [hprevPrev_order, hprev_order]
          change prevPrevFin.1 + 1 = prevFin.1 ∨
            prevFin.1 + 1 = prevPrevFin.1
          left
          simp [prevPrevFin, prevFin]
          omega
        have h_prevPrev_ne_next :
            I.rowIndex prevPrevRow ≠ I.rowIndex nextRow :=
          Inv.base.rowIndex_ne_of_order_val_ne (by
            change (order prevPrevRow).1 ≠ (order nextRow).1
            rw [hprevPrev_order, hnext_order]
            simp [prevPrevFin, nextFin]
            omega)
        have h_prevPrev_ne_left :
            I.rowIndex prevPrevRow ≠ I.rowIndex Cross.rowLeft :=
          Inv.base.rowIndex_ne_of_order_val_ne (by
            change (order prevPrevRow).1 ≠ (order Cross.rowLeft).1
            rw [hprevPrev_order]
            change prevPrevFin.1 ≠ pL.1
            simp [prevPrevFin]
            omega)
        have h_prevPrev_ne_right :
            I.rowIndex prevPrevRow ≠ I.rowIndex Cross.rowRight :=
          Inv.base.rowIndex_ne_of_order_val_ne (by
            change (order prevPrevRow).1 ≠ (order Cross.rowRight).1
            rw [hprevPrev_order]
            change prevPrevFin.1 ≠ pR.1
            simp [prevPrevFin]
            omega)
        have h_prevPrev_ne_prev :
            I.rowIndex prevPrevRow ≠ I.rowIndex prevRow :=
          Inv.base.rowIndex_ne_of_order_val_ne (by
            change (order prevPrevRow).1 ≠ (order prevRow).1
            rw [hprevPrev_order, hprev_order]
            simp [prevPrevFin, prevFin]
            omega)
        refine
          { auxL := Inv.extended.boundary.upperBoundary
            auxA := I.rowIndex nextRow
            auxD := I.rowIndex prevRow
            auxR := I.rowIndex prevPrevRow
            hLA_old := ?_
            hAU_old := ?_
            hUV_old := Cross.old_aux_adj_left_right
            hVD_old := ?_
            hDR_old := ?_
            hA_old := Inv.extended.full.active_aux.degree_two nextRow
            hU_old := Inv.extended.full.active_aux.degree_two Cross.rowLeft
            hV_old := Inv.extended.full.active_aux.degree_two Cross.rowRight
            hD_old := Inv.extended.full.active_aux.degree_two prevRow
            hL_not := ?_
            hR_not := ?_
            hLU := Inv.extended.boundary.upper_ne_row Cross.rowLeft
            hRV := h_prevPrev_ne_right
            hAU_ne := h_next_ne_left
            hAD := h_next_ne_prev
