/-- Upgrade a bump action certificate to the boundary-aware full-invariant
action outcome once each successor certificate preserves the extended
invariant package. -/
theorem BumpActionCertificate.extendedFullInvariantSimplifyingActionOutcome
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0} {Bump : BumpWitness I}
