/-- Paper-level Figure 7 update from the minimal local degree-test data.

The proof text uses the isomorphic successor only in the branch where all
three local vertices remain degree two.  This wrapper makes that control flow
explicit and avoids threading an auxiliary outside neighbor through callers
that already have the successor auxiliary isomorphism and adjacency
description. -/
noncomputable def paperActionUpdate_of_supportedLocalDegreeTest_constructedSuccessor
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (haux : AuxGraphsIsomorphic L Bump.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Bump.successorRowPath)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Bump.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j)
    (auxA auxM auxC : I.linkage.Index)
    (hsupport :
      AdjChangeSupportedIn (linkageAuxGraph I.linkage)
        (linkageAuxGraph Bump.replacementLinkageConcrete)
        ({auxA, auxM, auxC} : Finset I.linkage.Index))
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hM_old : DegreeEquals (linkageAuxGraph I.linkage) auxM 2)
    (hC_old : DegreeEquals (linkageAuxGraph I.linkage) auxC 2) :
    BumpPaperActionUpdate Inv Bump := by
  classical
  let hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i) :=
    Bump.replacementPath_nodeDisjoint_unchanged_all
  let L'' : PerfectPathPacking G A B := Bump.replacementLinkage hdisj
  let S : Finset I.linkage.Index := {auxA, auxM, auxC}
  have hsupport' :
      AdjChangeSupportedIn (linkageAuxGraph I.linkage)
        (linkageAuxGraph L'') S := by
    simpa [S, L'', hdisj, replacementLinkageConcrete] using hsupport
  have hlocal_old :
      ∀ x : I.linkage.Index, x ∈ S →
        DegreeEquals (linkageAuxGraph I.linkage) x 2 := by
    intro x hx
    simp [S] at hx
    rcases hx with rfl | rfl | rfl
    · exact hA_old
    · exact hM_old
    · exact hC_old
  refine ⟨?_⟩
  by_cases hall :
      ∀ x : I.linkage.Index, x ∈ S →
        DegreeEquals (linkageAuxGraph L'') x 2
  · let haux' : AuxGraphsIsomorphic L (Bump.replacementLinkage hdisj) := by
      simpa [hdisj, replacementLinkageConcrete] using haux
    have hadj_iff' :
        ∀ i j : I.linkage.Index,
          (linkageAuxGraph (Bump.replacementLinkage hdisj)).Adj i j ↔
            (linkageAuxGraph I.linkage).Adj i j := by
      simpa [hdisj, replacementLinkageConcrete] using hadj_iff
    let Succ : BumpSuccessorCertificate Bump :=
      Bump.successorCertificate_of_constructed_deleted_edge hdisj
        Inv.base.rowIndexInjective haux' hq0
    let InvSucc :
        TypeOneExtendedFutureCleanIterationInvariants Succ.next :=
      Bump.successorCertificate_constructed_extendedFutureCleanIterationInvariants
        hdisj haux' hq0 Inv hadj_iff'
    exact Or.inr ⟨{ successor := Succ, invariant := InvSucc }⟩
  · have hdrop_local :
        ∃ x : I.linkage.Index, x ∈ S ∧
          ¬ DegreeEquals (linkageAuxGraph L'') x 2 := by
      by_contra hnone
      apply hall
      intro x hx
      by_contra hxdeg
      exact hnone ⟨x, hx, hxdeg⟩
    have hdrop :
        degreeTwoVertexCount (linkageAuxGraph L'') <
          degreeTwoVertexCount (linkageAuxGraph I.linkage) :=
      degreeTwoVertexCount_lt_of_supported_local_drop
        (linkageAuxGraph I.linkage) (linkageAuxGraph L'') S
        hsupport' hlocal_old hdrop_local
    exact Or.inl ⟨L'', by
      simpa [L'', linkageAuxDegreeTwoCount] using hdrop⟩

