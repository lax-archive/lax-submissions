/-- The invariant-aware theorem-shaped loop specialized back to ordinary
bump/cross action certificates, with the extra hypotheses recording exactly
what must be proved in each non-degree-drop successor branch: row invariants
survive. -/
theorem gridMinor_or_degree_drop_of_action_certificates_with_invariants
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (hbump :
      ∀ {I : IterationInput R hpos Q0} (Bump : BumpWitness I),
        BumpActionCertificate Bump)
    (hcross :
      ∀ {I : IterationInput R hpos Q0} (Cross : CrossWitness I),
        CrossActionCertificate Cross)
    (hbump_next_inv :
      ∀ {I : IterationInput R hpos Q0}
        (_Inv : TypeOneIterationInvariants I) (Bump : BumpWitness I)
        (S : BumpSuccessorCertificate Bump),
          TypeOneIterationInvariants S.next)
    (hcross_next_inv :
      ∀ {I : IterationInput R hpos Q0}
        (_Inv : TypeOneIterationInvariants I) (Cross : CrossWitness I)
        (S : CrossSuccessorCertificate Cross),
          TypeOneIterationInvariants S.next)
    (hterminal :
      ∀ I : IterationInput R hpos Q0,
        TypeOneIterationInvariants I → NoBumpNoCross I →
          ContainsGridMinor G h)
    (I₀ : IterationInput R hpos Q0)
