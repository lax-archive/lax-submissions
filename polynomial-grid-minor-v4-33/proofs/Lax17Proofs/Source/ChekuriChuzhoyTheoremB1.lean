/-- View the pre-hill ordered Claim B.2 data as post-hill path-column data
when the post-hill columns are just the original selected columns. -/
noncomputable def ofOrderedTerminalGridAdjacencies
    (C : TypeTwoClaimB2OrderedTerminalGridAdjacencies I inv columns) :
    TypeTwoClaimB2TerminalPathOrderedGridAdjacencies I inv
      (TypeTwoTerminalPathColumnOrder.ofTerminalColumnOrder
        (I := I) (inv := inv) columns) where
  horizontal_adj := by
    intro i j j' hcon
    simpa [TypeTwoTerminalPathColumnOrder.ofTerminalColumnOrder] using
      C.horizontal_adj i hcon
  vertical_adj := by
    intro i i' hcon j
    simpa [TypeTwoTerminalPathColumnOrder.ofTerminalColumnOrder] using
      C.vertical_adj hcon j

end TypeTwoClaimB2TerminalPathOrderedGridAdjacencies

namespace TypeTwoClaimB3TerminalPathOrderedHillNormalCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeTwoQStarFamily R hpos Q}
variable {I : TypeTwoIterationInput R hpos Q0}
variable {inv : TypeTwoIterationInvariants I}
variable {columns : TypeTwoTerminalColumnOrder Q0}

/-- View the ordered finite-ascent proof of type-2 Claim B.3 as a post-hill
path-column proof when no hill replacement has changed the selected columns. -/
noncomputable def ofOrderedPathHillNormalCertificate
    (C : TypeTwoClaimB3OrderedPathHillNormalCertificate I inv columns) :
    TypeTwoClaimB3TerminalPathOrderedHillNormalCertificate I inv
      (TypeTwoTerminalPathColumnOrder.ofTerminalColumnOrder
        (I := I) (inv := inv) columns) where
  HillCandidate := C.HillCandidate
  candidate_of_nonconvex_trace := by
    intro hbad
    rcases hbad with ⟨i, j, hN⟩
    rcases hN with ⟨N⟩
    exact C.candidate_of_nonconvex_trace
      ⟨i, j, ⟨{
        left := N.left
        middle := N.middle
        right := N.right
        left_mem := by
          simpa [TypeTwoTerminalPathColumnOrder.ofTerminalColumnOrder]
            using N.left_mem
        right_mem := by
          simpa [TypeTwoTerminalPathColumnOrder.ofTerminalColumnOrder]
            using N.right_mem
        middle_mem_column := by
          simpa [TypeTwoTerminalPathColumnOrder.ofTerminalColumnOrder]
            using N.middle_mem_column
        left_before_middle := by
          simpa [TypeTwoTerminalPathColumnOrder.ofTerminalColumnOrder]
            using N.left_before_middle
        middle_before_right := by
          simpa [TypeTwoTerminalPathColumnOrder.ofTerminalColumnOrder]
            using N.middle_before_right
        middle_not_mem_row := by
          simpa [TypeTwoTerminalPathColumnOrder.ofTerminalColumnOrder]
            using N.middle_not_mem_row
      }⟩⟩
  higher_candidate_of_candidate := C.higher_candidate_of_candidate

end TypeTwoClaimB3TerminalPathOrderedHillNormalCertificate

