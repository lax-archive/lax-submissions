/-- In the type-1 last-hit branch, the suffix from the last middle-boundary
contact has a later contact with `P_0`.  This is the formal version of the
paper's sentence choosing `u` as the first later vertex on `P_0`. -/
theorem middleBoundarySuffix_hits_p0_of_source_pZPlusOne
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    (T : CompleteLinkageContactTrace R Q)
    (hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty)
    (hend : T.toLinkageContactTrace.EndsIn R.block4IndexSet)
    (hsource :
      (middleBoundarySuffix (L := L) R hpos Q hmid).source ∈
        (L.path (R.pZPlusOneIndex hpos)).vertexSet) :
    ((middleBoundarySuffix (L := L) R hpos Q hmid).vertexSet ∩
      (L.path R.p0Index).vertexSet).Nonempty := by
  classical
  have hsource_Q :
      (middleBoundarySuffix (L := L) R hpos Q hmid).source ∈ Q.vertexSet := by
    exact Q.cleanSuffixFromSet_vertexSet_subset
      (middleBoundaryVertexSet (L := L) R hpos) hmid
      (GraphPath.source_mem_vertexSet
        (middleBoundarySuffix (L := L) R hpos Q hmid))
  have hsource_L :
      (middleBoundarySuffix (L := L) R hpos Q hmid).source ∈
        L.toPathPacking.vertexSet :=
    (L.toPathPacking.mem_vertexSet).2
      ⟨R.pZPlusOneIndex hpos, hsource⟩
  rcases T.contact_complete hsource_Q hsource_L with ⟨s, hs_contact⟩
  have hs_le : s.1 ≤ T.len := by omega
  have hstart :
      T.index ⟨s.1, Nat.lt_succ_of_le hs_le⟩ = R.pZPlusOneIndex hpos := by
    have hs_fin :
        (⟨s.1, Nat.lt_succ_of_le hs_le⟩ : Fin (T.len + 1)) = s := by
      apply Fin.ext
      simp
    rw [hs_fin]
    exact T.index_eq_of_contact_mem (by simpa [hs_contact] using hsource)
  have hno2z :=
    no_later_pTwoZ_index_of_middleBoundarySuffix_source_pZPlusOne
      (L := L) (R := R) (hpos := hpos) T hmid hs_contact hsource
  rcases T.toLinkageContactTrace.exists_p0_index_after_of_pZPlusOne_start
      (R := R) (hpos := hpos) (s := s.1) hs_le hstart hend hno2z with
    ⟨n, hsn, hn, hn_idx⟩
  let rn : Fin (T.len + 1) := ⟨n, Nat.lt_succ_of_le hn⟩
  have hn_mem_p0 :
      T.contact rn ∈ (L.path R.p0Index).vertexSet := by
    simpa [rn, hn_idx] using T.contact_mem_linkage rn
  have hbefore :
      Q.Before
        (middleBoundarySuffix (L := L) R hpos Q hmid).source
        (T.contact rn) := by
    have htrace_before :=
      T.toLinkageContactTrace.contact_before_of_le (a := s) (b := rn) (by
        simpa [rn] using hsn)
    simpa [hs_contact, rn] using htrace_before
  have hn_suffix :
      T.contact rn ∈
        (middleBoundarySuffix (L := L) R hpos Q hmid).vertexSet := by
    simpa [middleBoundarySuffix, GraphPath.cleanSuffixFromSet] using
      hbefore.choose_spec
  exact ⟨T.contact rn, Finset.mem_inter.2 ⟨hn_suffix, hn_mem_p0⟩⟩

/-- In the type-1 case, after choosing the middle-boundary suffix, `Q*` is the
prefix ending at the first later contact with `P_0`. -/
noncomputable def typeOneQStarFromLastFirst
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h)
    (Q : GraphPath G)
    (hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty)
    (hp0 :
      ((middleBoundarySuffix (L := L) R hpos Q hmid).vertexSet ∩
        (L.path R.p0Index).vertexSet).Nonempty) :
    GraphPath G :=
  (middleBoundarySuffix (L := L) R hpos Q hmid).cleanPrefixToSet
    (L.path R.p0Index).vertexSet hp0

/-- A vertex of the original path that lies between the last middle-boundary
source and the first later `P_0` hit lies on the formal type-1 `Q*` prefix. -/
theorem mem_typeOneQStarFromLastFirst_of_between
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    {hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty}
    {hp0 :
      ((middleBoundarySuffix (L := L) R hpos Q hmid).vertexSet ∩
        (L.path R.p0Index).vertexSet).Nonempty}
    {v : V}
    (hleft :
      Q.Before (middleBoundarySuffix (L := L) R hpos Q hmid).source v)
    (hright :
      Q.Before v
        (typeOneQStarFromLastFirst (L := L) R hpos Q hmid hp0).target) :
    v ∈ (typeOneQStarFromLastFirst (L := L) R hpos Q hmid hp0).vertexSet := by
  classical
  let suffix : GraphPath G :=
    middleBoundarySuffix (L := L) R hpos Q hmid
  let qstar : GraphPath G :=
    typeOneQStarFromLastFirst (L := L) R hpos Q hmid hp0
  have hv_suffix : v ∈ suffix.vertexSet := by
    simpa [suffix, middleBoundarySuffix, GraphPath.cleanSuffixFromSet] using
      hleft.choose_spec
  have ht_suffix : qstar.target ∈ suffix.vertexSet := by
    exact suffix.cleanPrefixToSet_vertexSet_subset
      (L.path R.p0Index).vertexSet hp0
      (GraphPath.target_mem_vertexSet qstar)
  have hsource_Q : suffix.source ∈ Q.vertexSet := by
    exact Q.cleanSuffixFromSet_vertexSet_subset
      (middleBoundaryVertexSet (L := L) R hpos) hmid
      (GraphPath.source_mem_vertexSet suffix)
  have hv_drop :
      v ∈ (Q.dropUntil hsource_Q).vertexSet := by
    simpa [suffix, middleBoundarySuffix, GraphPath.cleanSuffixFromSet] using hv_suffix
  have ht_drop :
      qstar.target ∈ (Q.dropUntil hsource_Q).vertexSet := by
    simpa [suffix, middleBoundarySuffix, GraphPath.cleanSuffixFromSet] using ht_suffix
  have hv_idx :
      Q.vertexIndex v =
        Q.vertexIndex suffix.source + (Q.dropUntil hsource_Q).vertexIndex v := by
    simpa [suffix] using
      Q.vertexIndex_eq_add_vertexIndex_dropUntil hsource_Q hv_drop
  have ht_idx :
      Q.vertexIndex qstar.target =
        Q.vertexIndex suffix.source +
          (Q.dropUntil hsource_Q).vertexIndex qstar.target := by
    simpa [suffix] using
      Q.vertexIndex_eq_add_vertexIndex_dropUntil hsource_Q ht_drop
  have hright_idx :
      Q.vertexIndex v ≤ Q.vertexIndex qstar.target :=
    ((Q.before_iff_vertexIndex_le).1 hright).2.2
  have hv_before_target_suffix :
      suffix.Before v qstar.target := by
    refine (suffix.before_iff_vertexIndex_le).2 ?_
    refine ⟨hv_suffix, ht_suffix, ?_⟩
    have hdrop_idx :
        (Q.dropUntil hsource_Q).vertexIndex v ≤
          (Q.dropUntil hsource_Q).vertexIndex qstar.target := by
      omega
    simpa [suffix, middleBoundarySuffix, GraphPath.cleanSuffixFromSet] using hdrop_idx
  simpa [qstar, typeOneQStarFromLastFirst] using
    suffix.mem_takeUntil_of_before
      (suffix.firstHitVertex_mem_vertexSet (L.path R.p0Index).vertexSet hp0)
      hv_before_target_suffix

/-- Any recorded linkage contact lying on the type-1 last/first-hit segment
occurs, in the complete contact trace, between the recorded last
middle-boundary contact and the recorded first `P_0` contact. -/
theorem typeOneQStarFromLastFirst_contact_bounds
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    {hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty}
    {hp0 :
      ((middleBoundarySuffix (L := L) R hpos Q hmid).vertexSet ∩
        (L.path R.p0Index).vertexSet).Nonempty}
    (T : CompleteLinkageContactTrace R Q)
    {s t r : Fin (T.len + 1)}
    (hs_contact :
      T.contact s = (middleBoundarySuffix (L := L) R hpos Q hmid).source)
    (ht_contact :
      T.contact t =
        (typeOneQStarFromLastFirst (L := L) R hpos Q hmid hp0).target)
    (hr_mem :
      T.contact r ∈
        (typeOneQStarFromLastFirst (L := L) R hpos Q hmid hp0).vertexSet) :
    s.1 ≤ r.1 ∧ r.1 ≤ t.1 := by
  classical
  let suffix : GraphPath G :=
    middleBoundarySuffix (L := L) R hpos Q hmid
  let qstar : GraphPath G :=
    typeOneQStarFromLastFirst (L := L) R hpos Q hmid hp0
  have hr_suffix : T.contact r ∈ suffix.vertexSet := by
    exact suffix.cleanPrefixToSet_vertexSet_subset
      (L.path R.p0Index).vertexSet hp0
      (by simpa [qstar, typeOneQStarFromLastFirst, suffix] using hr_mem)
  have hsource_Q : suffix.source ∈ Q.vertexSet := by
    exact Q.cleanSuffixFromSet_vertexSet_subset
      (middleBoundaryVertexSet (L := L) R hpos) hmid
      (GraphPath.source_mem_vertexSet suffix)
  have hleft :
      Q.Before suffix.source (T.contact r) := by
    exact ⟨hsource_Q, by
      simpa [suffix, middleBoundarySuffix, GraphPath.cleanSuffixFromSet] using
        hr_suffix⟩
  have hs_le_r : s.1 ≤ r.1 := by
    have hbefore_contacts :
        Q.Before (T.contact s) (T.contact r) := by
      simpa [hs_contact, suffix] using hleft
    exact (T.contact_before_iff_le s r).1 hbefore_contacts
  have htarget_suffix : qstar.target ∈ suffix.vertexSet := by
    exact suffix.cleanPrefixToSet_vertexSet_subset
      (L.path R.p0Index).vertexSet hp0
      (GraphPath.target_mem_vertexSet qstar)
  have htarget_Q : qstar.target ∈ Q.vertexSet := by
    exact Q.cleanSuffixFromSet_vertexSet_subset
      (middleBoundaryVertexSet (L := L) R hpos) hmid htarget_suffix
  have hr_before_target_suffix :
      suffix.Before (T.contact r) qstar.target := by
    simpa [qstar, typeOneQStarFromLastFirst, suffix] using
      suffix.before_of_mem_takeUntil
        (suffix.firstHitVertex_mem_vertexSet
          (L.path R.p0Index).vertexSet hp0)
        (by simpa [qstar, typeOneQStarFromLastFirst, suffix] using hr_mem)
  have hr_drop :
      T.contact r ∈ (Q.dropUntil hsource_Q).vertexSet := by
    simpa [suffix, middleBoundarySuffix, GraphPath.cleanSuffixFromSet] using
      hr_suffix
  have ht_drop :
      qstar.target ∈ (Q.dropUntil hsource_Q).vertexSet := by
    simpa [suffix, middleBoundarySuffix, GraphPath.cleanSuffixFromSet] using
      htarget_suffix
  have hr_idx :
      Q.vertexIndex (T.contact r) =
        Q.vertexIndex suffix.source +
          (Q.dropUntil hsource_Q).vertexIndex (T.contact r) := by
    simpa [suffix] using
      Q.vertexIndex_eq_add_vertexIndex_dropUntil hsource_Q hr_drop
  have ht_idx :
      Q.vertexIndex qstar.target =
        Q.vertexIndex suffix.source +
          (Q.dropUntil hsource_Q).vertexIndex qstar.target := by
    simpa [suffix] using
      Q.vertexIndex_eq_add_vertexIndex_dropUntil hsource_Q ht_drop
  have hsuf_idx :
      suffix.vertexIndex (T.contact r) ≤ suffix.vertexIndex qstar.target :=
    ((suffix.before_iff_vertexIndex_le).1 hr_before_target_suffix).2.2
  have hQ_before_target :
      Q.Before (T.contact r) qstar.target := by
    refine (Q.before_iff_vertexIndex_le).2 ?_
    refine ⟨T.contact_mem_Q r, htarget_Q, ?_⟩
    rw [hr_idx, ht_idx]
    simpa [suffix, middleBoundarySuffix, GraphPath.cleanSuffixFromSet] using
      Nat.add_le_add_left hsuf_idx (Q.vertexIndex suffix.source)
  have hr_le_t : r.1 ≤ t.1 := by
    have hbefore_contacts :
        Q.Before (T.contact r) (T.contact t) := by
      simpa [ht_contact, qstar] using hQ_before_target
    exact (T.contact_before_iff_le r t).1 hbefore_contacts
  exact ⟨hs_le_r, hr_le_t⟩

/-- Before the first `P_0` contact defining the target of a type-1 `Q*`
segment, the complete trace has no `P_0` index. -/
theorem no_p0_index_before_typeOneQStarFromLastFirst_target
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    {hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty}
    {hp0 :
      ((middleBoundarySuffix (L := L) R hpos Q hmid).vertexSet ∩
        (L.path R.p0Index).vertexSet).Nonempty}
    (T : CompleteLinkageContactTrace R Q)
    {s t : Fin (T.len + 1)}
    (hs_contact :
      T.contact s = (middleBoundarySuffix (L := L) R hpos Q hmid).source)
    (ht_contact :
      T.contact t =
        (typeOneQStarFromLastFirst (L := L) R hpos Q hmid hp0).target) :
    ∀ (n : ℕ) (_hsn : s.1 ≤ n) (_hnt : n < t.1),
      T.index ⟨n, by omega⟩ ≠ R.p0Index := by
  classical
  intro n hsn hnt hidx
  let rn : Fin (T.len + 1) := ⟨n, by omega⟩
  let suffix : GraphPath G :=
    middleBoundarySuffix (L := L) R hpos Q hmid
  let qstar : GraphPath G :=
    typeOneQStarFromLastFirst (L := L) R hpos Q hmid hp0
  have hn_left :
      Q.Before suffix.source (T.contact rn) := by
    have hbefore := T.toLinkageContactTrace.contact_before_of_le
      (a := s) (b := rn) (by simpa [rn] using hsn)
    simpa [hs_contact, suffix, rn] using hbefore
  have hn_right :
      Q.Before (T.contact rn) qstar.target := by
    have hbefore := T.toLinkageContactTrace.contact_before_of_le
      (a := rn) (b := t) (by simpa [rn] using le_of_lt hnt)
    simpa [ht_contact, qstar, rn] using hbefore
  have hn_qstar :
      T.contact rn ∈ qstar.vertexSet := by
    simpa [qstar, suffix] using
      mem_typeOneQStarFromLastFirst_of_between
        (L := L) (R := R) (hpos := hpos) (Q := Q)
        (hmid := hmid) (hp0 := hp0) hn_left hn_right
  have hn_mem_p0 :
      T.contact rn ∈ (L.path R.p0Index).vertexSet := by
    simpa [rn, hidx] using T.contact_mem_linkage rn
  have hp0_singleton :
      (L.path R.p0Index).vertexSet ∩ qstar.vertexSet = {qstar.target} := by
    simpa [qstar, typeOneQStarFromLastFirst, suffix] using
      suffix.cleanPrefixToSet_inter_eq_singleton_target
        (L.path R.p0Index).vertexSet hp0
  have hn_eq_target : T.contact rn = qstar.target := by
    have hsingle :
        T.contact rn ∈ ({qstar.target} : Finset V) := by
      rw [← hp0_singleton]
      exact Finset.mem_inter.2 ⟨hn_mem_p0, hn_qstar⟩
    simpa using hsingle
  have htarget_Q : qstar.target ∈ Q.vertexSet := by
    have ht_suffix : qstar.target ∈ suffix.vertexSet :=
      suffix.cleanPrefixToSet_vertexSet_subset
        (L.path R.p0Index).vertexSet hp0
        (GraphPath.target_mem_vertexSet qstar)
    exact Q.cleanSuffixFromSet_vertexSet_subset
      (middleBoundaryVertexSet (L := L) R hpos) hmid ht_suffix
  have hback :
      Q.Before (T.contact t) (T.contact rn) := by
    have hrefl : Q.Before qstar.target qstar.target :=
      Q.before_refl htarget_Q
    simpa [ht_contact, hn_eq_target, qstar, rn] using hrefl
  have ht_le_n : t.1 ≤ rn.1 := (T.contact_before_iff_le t rn).1 hback
  have hrn_val : rn.1 = n := rfl
  omega

/-- Every complete-trace contact that lies on the type-1 last/first-hit
segment has one of the allowed type-1 linkage indices.  The proof is the
formal corridor argument from `P_{z+1}` down to the first later `P_0`: before
that first `P_0`, the trace cannot hit `P_{2z}`, and if it ever moved above
`P_{z+1}` it could not return to `P_0` without another `P_{z+1}` contact. -/
theorem typeOneQStarFromLastFirst_contact_index_mem_allowed
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    (T : CompleteLinkageContactTrace R Q)
    (hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty)
    (hsource :
      (middleBoundarySuffix (L := L) R hpos Q hmid).source ∈
        (L.path (R.pZPlusOneIndex hpos)).vertexSet)
    (hp0 :
      ((middleBoundarySuffix (L := L) R hpos Q hmid).vertexSet ∩
        (L.path R.p0Index).vertexSet).Nonempty)
    {r : Fin (T.len + 1)}
    (hr_mem :
      T.contact r ∈
        (typeOneQStarFromLastFirst (L := L) R hpos Q hmid hp0).vertexSet) :
    T.index r ∈ typeOneAllowedIndexSet R hpos := by
  classical
  let suffix : GraphPath G :=
    middleBoundarySuffix (L := L) R hpos Q hmid
  let qstar : GraphPath G :=
    typeOneQStarFromLastFirst (L := L) R hpos Q hmid hp0
  have hsource_Q : suffix.source ∈ Q.vertexSet := by
    exact Q.cleanSuffixFromSet_vertexSet_subset
      (middleBoundaryVertexSet (L := L) R hpos) hmid
      (GraphPath.source_mem_vertexSet suffix)
  have hsource_L : suffix.source ∈ L.toPathPacking.vertexSet :=
    (L.toPathPacking.mem_vertexSet).2
      ⟨R.pZPlusOneIndex hpos, by simpa [suffix] using hsource⟩
  rcases T.contact_complete hsource_Q hsource_L with ⟨s, hs_contact⟩
  have htarget_p0 : qstar.target ∈ (L.path R.p0Index).vertexSet := by
    simpa [qstar, typeOneQStarFromLastFirst, suffix] using
      suffix.cleanPrefixToSet_target_mem (L.path R.p0Index).vertexSet hp0
  have htarget_suffix : qstar.target ∈ suffix.vertexSet := by
    exact suffix.cleanPrefixToSet_vertexSet_subset
      (L.path R.p0Index).vertexSet hp0
      (GraphPath.target_mem_vertexSet qstar)
  have htarget_Q : qstar.target ∈ Q.vertexSet := by
    exact Q.cleanSuffixFromSet_vertexSet_subset
      (middleBoundaryVertexSet (L := L) R hpos) hmid htarget_suffix
  have htarget_L : qstar.target ∈ L.toPathPacking.vertexSet :=
    (L.toPathPacking.mem_vertexSet).2 ⟨R.p0Index, htarget_p0⟩
  rcases T.contact_complete htarget_Q htarget_L with ⟨t, ht_contact⟩
  have hs_idx : T.index s = R.pZPlusOneIndex hpos := by
    exact T.index_eq_of_contact_mem (by simpa [hs_contact, suffix] using hsource)
  have ht_idx : T.index t = R.p0Index := by
    exact T.index_eq_of_contact_mem (by simpa [ht_contact, qstar] using htarget_p0)
  rcases typeOneQStarFromLastFirst_contact_bounds
      (L := L) (R := R) (hpos := hpos) (Q := Q)
      (hmid := hmid) (hp0 := hp0) T hs_contact ht_contact
      (by simpa [qstar] using hr_mem) with
    ⟨hs_le_r, hr_le_t⟩
  by_cases hrs : r.1 = s.1
  · have hr_eq_s : r = s := by
      apply Fin.ext
      exact hrs
    rw [hr_eq_s, hs_idx]
    exact pZPlusOneIndex_mem_typeOneAllowedIndexSet R hpos
  by_cases hrt : r.1 = t.1
  · have hr_eq_t : r = t := by
      apply Fin.ext
      exact hrt
    rw [hr_eq_t, ht_idx]
    exact p0Index_mem_typeOneAllowedIndexSet R hpos
  have hs_lt_r : s.1 < r.1 := by omega
  have hr_lt_t : r.1 < t.1 := by omega
  have hs_le : s.1 ≤ T.len := by omega
  have hr_le : r.1 ≤ T.len := by omega
  have ht_le : t.1 ≤ T.len := by omega
  have hs_start_display :
      T.index ⟨s.1, Nat.lt_succ_of_le hs_le⟩ =
        R.indexAt (z h + 1) (by
          have hz_eq : z h = 2 * h := rfl
          omega) := by
    have hs_fin :
        (⟨s.1, Nat.lt_succ_of_le hs_le⟩ : Fin (T.len + 1)) = s := by
      apply Fin.ext
      simp
    rw [hs_fin, hs_idx]
    simp [pZPlusOneIndex, pZPlusOnePos, indexAt, posOfNat]
  have hno2z_from_s :=
    no_later_pTwoZ_index_of_middleBoundarySuffix_source_pZPlusOne
      (L := L) (R := R) (hpos := hpos) T hmid hs_contact hsource
  have hno0_until_r : ∀ (n : ℕ) (_hsn : s.1 ≤ n) (hnr : n ≤ r.1),
      T.index ⟨n, Nat.lt_succ_of_le (le_trans hnr hr_le)⟩ ≠
        R.indexAt 0 (by omega) := by
    intro n hsn hnr hidx0
    have hn_lt_t : n < t.1 := by omega
    have hno :=
      no_p0_index_before_typeOneQStarFromLastFirst_target
        (L := L) (R := R) (hpos := hpos) (Q := Q)
        (hmid := hmid) (hp0 := hp0) T hs_contact ht_contact
        n hsn hn_lt_t
    exact hno (by
      simpa [p0Index, p0Pos, indexAt, posOfNat] using hidx0)
  have hno2z_until_r : ∀ (n : ℕ) (_hsn : s.1 ≤ n) (hnr : n ≤ r.1),
      T.index ⟨n, Nat.lt_succ_of_le (le_trans hnr hr_le)⟩ ≠
        R.indexAt (2 * z h) (by
          have hz_eq : z h = 2 * h := rfl
          omega) := by
    intro n hsn hnr hidx
    exact hno2z_from_s n hsn (le_trans hnr hr_le) (by
      simpa [pTwoZIndex, pTwoZPos, indexAt, posOfNat] using hidx)
  let d := r.1 - s.1
  have hsd : s.1 + d ≤ r.1 := by
    dsimp [d]
    omega
  rcases T.toLinkageContactTrace.left_corridor_offset_of_avoids_boundaries_until
      (R := R) (hpos := hpos) (hu := hr_le) (hsu := hs_le_r)
      (k := z h + 1)
      (by omega)
      (by
        have hz_eq : z h = 2 * h := rfl
        omega)
      hs_start_display hno0_until_r hno2z_until_r d hsd with
    ⟨k, hk_lt, hk_lo, hk_hi, hidx_at_r_offset⟩
  have hsd_eq : s.1 + d = r.1 := by
    dsimp [d]
    omega
  have hidx_r_display :
      T.index r = R.indexAt k hk_lt := by
    have hfin :
        (⟨s.1 + d, Nat.lt_succ_of_le (le_trans hsd hr_le)⟩ :
          Fin (T.len + 1)) = r := by
      apply Fin.ext
      simp [hsd_eq]
    simpa [hfin] using hidx_at_r_offset
  have hk_le_zPlusOne : k ≤ z h + 1 := by
    by_contra hknot
    have hk_gt : z h + 1 < k := Nat.lt_of_not_ge hknot
    have hnoZ_after_r : ∀ (n : ℕ) (_hrn : r.1 ≤ n) (hnt : n ≤ t.1),
        T.index ⟨n, Nat.lt_succ_of_le (le_trans hnt ht_le)⟩ ≠
          R.indexAt (z h + 1) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      intro n hrn hnt hidx
      have hs_lt_n : s.1 < n := by omega
      have hnoZ :=
        no_strict_later_pZPlusOne_index_of_middleBoundarySuffix_source_pZPlusOne
          (L := L) (R := R) (hpos := hpos) T hmid hs_contact hsource
          n hs_lt_n (le_trans hnt ht_le)
      exact hnoZ (by
        simpa [pZPlusOneIndex, pZPlusOnePos, indexAt, posOfNat] using hidx)
    have hno2z_after_r : ∀ (n : ℕ) (_hrn : r.1 ≤ n) (hnt : n ≤ t.1),
        T.index ⟨n, Nat.lt_succ_of_le (le_trans hnt ht_le)⟩ ≠
          R.indexAt (2 * z h) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      intro n hrn hnt hidx
      exact hno2z_from_s n (by omega) (le_trans hnt ht_le) (by
        simpa [pTwoZIndex, pTwoZPos, indexAt, posOfNat] using hidx)
    let e := t.1 - r.1
    have hed : r.1 + e ≤ t.1 := by
      dsimp [e]
      omega
    rcases T.toLinkageContactTrace.between_left_barriers_offset_of_avoids_until
        (R := R) (hpos := hpos) (hu := ht_le) (hsu := hr_le_t)
        (a := z h + 1) (k := k)
        (by omega)
        (by
          have hz_eq : z h = 2 * h := rfl
          omega)
        hk_gt hk_hi
        (by
          have hr_fin :
              (⟨r.1, Nat.lt_succ_of_le (le_trans hr_le_t ht_le)⟩ :
                Fin (T.len + 1)) = r := by
            apply Fin.ext
            simp
          simpa [hr_fin] using hidx_r_display)
        hnoZ_after_r hno2z_after_r e hed with
      ⟨k', hk'_lt, hk'_lo, _hk'_hi, hidx_t_offset⟩
    have hed_eq : r.1 + e = t.1 := by
      dsimp [e]
      omega
    have hidx_t_display :
        T.index t = R.indexAt k' hk'_lt := by
      have hfin :
          (⟨r.1 + e, Nat.lt_succ_of_le (le_trans hed ht_le)⟩ :
            Fin (T.len + 1)) = t := by
        apply Fin.ext
        simp [hed_eq]
      simpa [hfin] using hidx_t_offset
    have hp0_display :
        T.index t = R.indexAt 0 (by omega) := by
      rw [ht_idx]
      simp [p0Index, p0Pos, indexAt, posOfNat]
    have heq : R.indexAt k' hk'_lt = R.indexAt 0 (by omega) := by
      exact hidx_t_display.symm.trans hp0_display
    have hk'_eq0 := (R.indexAt_eq_indexAt_iff hk'_lt (by omega)).1 heq
    omega
  rw [hidx_r_display]
  exact indexAt_mem_typeOneAllowedIndexSet_of_between_one_zPlusOne
    R hpos hk_lt hk_lo hk_le_zPlusOne

/-- The type-1 last/first-hit segment avoids every linkage path outside
`P_1 ∪ {P_0, P_{z+1}}`. -/
theorem typeOneQStarFromLastFirst_avoids_other_linkage_of_completeTrace
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    (T : CompleteLinkageContactTrace R Q)
    (hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty)
    (hsource :
      (middleBoundarySuffix (L := L) R hpos Q hmid).source ∈
        (L.path (R.pZPlusOneIndex hpos)).vertexSet)
    (hp0 :
      ((middleBoundarySuffix (L := L) R hpos Q hmid).vertexSet ∩
        (L.path R.p0Index).vertexSet).Nonempty) :
    ∀ j : L.Index, j ∉ typeOneAllowedIndexSet R hpos →
      Disjoint
        (typeOneQStarFromLastFirst (L := L) R hpos Q hmid hp0).vertexSet
        (L.path j).vertexSet := by
  classical
  intro j hj
  rw [Finset.disjoint_left]
  intro v hvq hvj
  let suffix : GraphPath G :=
    middleBoundarySuffix (L := L) R hpos Q hmid
  let qstar : GraphPath G :=
    typeOneQStarFromLastFirst (L := L) R hpos Q hmid hp0
  have hv_suffix : v ∈ suffix.vertexSet := by
    exact suffix.cleanPrefixToSet_vertexSet_subset
      (L.path R.p0Index).vertexSet hp0
      (by simpa [qstar, typeOneQStarFromLastFirst, suffix] using hvq)
  have hvQ : v ∈ Q.vertexSet := by
    exact Q.cleanSuffixFromSet_vertexSet_subset
      (middleBoundaryVertexSet (L := L) R hpos) hmid hv_suffix
  have hvL : v ∈ L.toPathPacking.vertexSet :=
    (L.toPathPacking.mem_vertexSet).2 ⟨j, hvj⟩
  rcases T.contact_complete hvQ hvL with ⟨r, hrv⟩
  have hallowed :
      T.index r ∈ typeOneAllowedIndexSet R hpos :=
    typeOneQStarFromLastFirst_contact_index_mem_allowed
      (L := L) (R := R) (hpos := hpos) (Q := Q)
      T hmid hsource hp0 (r := r) (by simpa [hrv, qstar] using hvq)
  have hidx : T.index r = j :=
    T.index_eq_of_contact_mem (by simpa [hrv] using hvj)
  exact hj (by simpa [hidx] using hallowed)

/-- The type-1 last/first-hit prefix meets every displayed row of the first
block. -/
theorem typeOneQStarFromLastFirst_hits_block1_of_completeTrace
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    (T : CompleteLinkageContactTrace R Q)
    (hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty)
    (hsource :
      (middleBoundarySuffix (L := L) R hpos Q hmid).source ∈
        (L.path (R.pZPlusOneIndex hpos)).vertexSet)
    (hp0 :
      ((middleBoundarySuffix (L := L) R hpos Q hmid).vertexSet ∩
        (L.path R.p0Index).vertexSet).Nonempty) :
    R.HitsBlock1 (typeOneQStarFromLastFirst (L := L) R hpos Q hmid hp0) := by
  classical
  let suffix : GraphPath G :=
    middleBoundarySuffix (L := L) R hpos Q hmid
  let qstar : GraphPath G :=
    typeOneQStarFromLastFirst (L := L) R hpos Q hmid hp0
  have hsource_Q : suffix.source ∈ Q.vertexSet := by
    exact Q.cleanSuffixFromSet_vertexSet_subset
      (middleBoundaryVertexSet (L := L) R hpos) hmid
      (GraphPath.source_mem_vertexSet suffix)
  have hsource_L : suffix.source ∈ L.toPathPacking.vertexSet :=
    (L.toPathPacking.mem_vertexSet).2
      ⟨R.pZPlusOneIndex hpos, by simpa [suffix] using hsource⟩
  rcases T.contact_complete hsource_Q hsource_L with ⟨s, hs_contact⟩
  have hs_le : s.1 ≤ T.len := by omega
  have hs_start :
      T.index ⟨s.1, Nat.lt_succ_of_le hs_le⟩ = R.pZPlusOneIndex hpos := by
    have hs_fin :
        (⟨s.1, Nat.lt_succ_of_le hs_le⟩ : Fin (T.len + 1)) = s := by
      apply Fin.ext
      simp
    rw [hs_fin]
    exact T.index_eq_of_contact_mem (by simpa [hs_contact, suffix] using hsource)
  have htarget_p0 : qstar.target ∈ (L.path R.p0Index).vertexSet := by
    simpa [qstar, typeOneQStarFromLastFirst, suffix] using
      suffix.cleanPrefixToSet_target_mem (L.path R.p0Index).vertexSet hp0
  have htarget_Q : qstar.target ∈ Q.vertexSet := by
    have ht_suffix : qstar.target ∈ suffix.vertexSet :=
      suffix.cleanPrefixToSet_vertexSet_subset
        (L.path R.p0Index).vertexSet hp0
        (GraphPath.target_mem_vertexSet qstar)
    exact Q.cleanSuffixFromSet_vertexSet_subset
      (middleBoundaryVertexSet (L := L) R hpos) hmid ht_suffix
  have htarget_L : qstar.target ∈ L.toPathPacking.vertexSet :=
    (L.toPathPacking.mem_vertexSet).2 ⟨R.p0Index, htarget_p0⟩
  rcases T.contact_complete htarget_Q htarget_L with ⟨t, ht_contact⟩
  have ht_le : t.1 ≤ T.len := by omega
  have ht_end :
      T.index ⟨t.1, Nat.lt_succ_of_le ht_le⟩ = R.p0Index := by
    have ht_fin :
        (⟨t.1, Nat.lt_succ_of_le ht_le⟩ : Fin (T.len + 1)) = t := by
      apply Fin.ext
      simp
    rw [ht_fin]
    exact T.index_eq_of_contact_mem (by simpa [ht_contact] using htarget_p0)
  have hsource_before_target_Q :
      Q.Before suffix.source qstar.target := by
    have ht_suffix : qstar.target ∈ suffix.vertexSet :=
      suffix.cleanPrefixToSet_vertexSet_subset
        (L.path R.p0Index).vertexSet hp0
        (GraphPath.target_mem_vertexSet qstar)
    exact ⟨hsource_Q, by
      simpa [suffix, middleBoundarySuffix, GraphPath.cleanSuffixFromSet] using
        ht_suffix⟩
  have hst : s.1 ≤ t.1 := by
    have hbefore_contacts :
        Q.Before (T.contact s) (T.contact t) := by
      simpa [hs_contact, ht_contact, suffix, qstar] using hsource_before_target_Q
    exact (T.contact_before_iff_le s t).1 hbefore_contacts
  have hno2z_all :=
    no_later_pTwoZ_index_of_middleBoundarySuffix_source_pZPlusOne
      (L := L) (R := R) (hpos := hpos) T hmid hs_contact
      (by simpa [suffix] using hsource)
  intro i
  let a : ℕ := 1 + i.1
  have ha0 : 0 < a := by dsimp [a]; omega
  have haz : a ≤ z h := by
    have hi : i.1 < z h := i.2
    dsimp [a]
    omega
  have hno2z_between : ∀ (n : ℕ) (_hsn : s.1 ≤ n) (_hnt : n ≤ t.1),
      T.index ⟨n, Nat.lt_succ_of_le (le_trans _hnt ht_le)⟩ ≠
        R.pTwoZIndex hpos := by
    intro n hsn hnt
    exact hno2z_all n hsn (le_trans hnt ht_le)
  rcases T.toLinkageContactTrace.exists_displayed_index_between_pZPlusOne_and_p0
      (R := R) (hpos := hpos) (s := s.1) (t := t.1) (a := a)
      hs_le ht_le hst ha0 haz hs_start ht_end hno2z_between with
    ⟨n, hsn, hnt, hn_idx⟩
  let rn : Fin (T.len + 1) := ⟨n, Nat.lt_succ_of_le (le_trans hnt ht_le)⟩
  have hn_mem_row :
      T.contact rn ∈
        (L.path (R.index (windowPos h 1 (by
          dsimp [z]
          omega) i))).vertexSet := by
    have hidx_row :
        T.index rn =
          R.index (windowPos h 1 (by dsimp [z]; omega) i) := by
      have hidx_at :
          T.index rn =
            R.indexAt a (by
              have hz_eq : z h = 2 * h := rfl
              omega) := by
        simpa [rn, a] using hn_idx
      simpa [a, block1_index_eq_indexAt] using hidx_at
    simpa [hidx_row] using T.contact_mem_linkage rn
  have hn_left :
      Q.Before suffix.source (T.contact rn) := by
    have hbefore := T.toLinkageContactTrace.contact_before_of_le
      (a := s) (b := rn) (by simpa [rn] using hsn)
    simpa [hs_contact, rn, suffix] using hbefore
  have hn_right :
      Q.Before (T.contact rn) qstar.target := by
    have hbefore := T.toLinkageContactTrace.contact_before_of_le
      (a := rn) (b := t) (by simpa [rn] using hnt)
    simpa [ht_contact, rn, qstar] using hbefore
  have hn_qstar :
      T.contact rn ∈ qstar.vertexSet := by
    simpa [qstar, suffix] using
      mem_typeOneQStarFromLastFirst_of_between
        (L := L) (R := R) (hpos := hpos) (Q := Q)
        (hmid := hmid) (hp0 := hp0) hn_left hn_right
  exact ⟨T.contact rn, Finset.mem_inter.2 ⟨hn_qstar, hn_mem_row⟩⟩

/-- In the type-2 last-hit branch, the suffix from the last middle-boundary
contact has a later contact with `P_{3z+1}`. -/
theorem middleBoundarySuffix_hits_pThreeZPlusOne_of_source_pTwoZ
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    (T : CompleteLinkageContactTrace R Q)
    (hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty)
    (hend : T.toLinkageContactTrace.EndsIn R.block4IndexSet)
    (hsource :
      (middleBoundarySuffix (L := L) R hpos Q hmid).source ∈
        (L.path (R.pTwoZIndex hpos)).vertexSet) :
    ((middleBoundarySuffix (L := L) R hpos Q hmid).vertexSet ∩
      (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet).Nonempty := by
  classical
  let suffix : GraphPath G :=
    middleBoundarySuffix (L := L) R hpos Q hmid
  have hsource_Q : suffix.source ∈ Q.vertexSet := by
    exact Q.cleanSuffixFromSet_vertexSet_subset
      (middleBoundaryVertexSet (L := L) R hpos) hmid
      (GraphPath.source_mem_vertexSet suffix)
  have hsource_L : suffix.source ∈ L.toPathPacking.vertexSet :=
    (L.toPathPacking.mem_vertexSet).2
      ⟨R.pTwoZIndex hpos, by simpa [suffix] using hsource⟩
  rcases T.contact_complete hsource_Q hsource_L with ⟨s, hs_contact⟩
  have hs_le : s.1 ≤ T.len := by omega
  have hstart :
      T.index ⟨s.1, Nat.lt_succ_of_le hs_le⟩ = R.pTwoZIndex hpos := by
    have hs_fin :
        (⟨s.1, Nat.lt_succ_of_le hs_le⟩ : Fin (T.len + 1)) = s := by
      apply Fin.ext
      simp
    rw [hs_fin]
    exact T.index_eq_of_contact_mem (by simpa [hs_contact, suffix] using hsource)
  have hnoZ :=
    no_later_pZPlusOne_index_of_middleBoundarySuffix_source_pTwoZ
      (L := L) (R := R) (hpos := hpos) T hmid hs_contact hsource
  have hno2zStrict :=
    no_strict_later_pTwoZ_index_of_middleBoundarySuffix_source_pTwoZ
      (L := L) (R := R) (hpos := hpos) T hmid hs_contact hsource
  by_contra hnoHit
  have hno3 : ∀ (n : ℕ) (_hsn : s.1 ≤ n) (hn : n ≤ T.len),
      T.index ⟨n, Nat.lt_succ_of_le hn⟩ ≠ R.pThreeZPlusOneIndex hpos := by
    intro n hsn hn hidx
    let rn : Fin (T.len + 1) := ⟨n, Nat.lt_succ_of_le hn⟩
    have hn_mem_p3 :
        T.contact rn ∈
          (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet := by
      simpa [rn, hidx] using T.contact_mem_linkage rn
    have hbefore :
        Q.Before suffix.source (T.contact rn) := by
      have htrace_before :=
        T.toLinkageContactTrace.contact_before_of_le (a := s) (b := rn) (by
          simpa [rn] using hsn)
      simpa [hs_contact, suffix, rn] using htrace_before
    have hn_suffix : T.contact rn ∈ suffix.vertexSet := by
      simpa [suffix, middleBoundarySuffix, GraphPath.cleanSuffixFromSet] using
        hbefore.choose_spec
    exact hnoHit ⟨T.contact rn, Finset.mem_inter.2 ⟨hn_suffix, hn_mem_p3⟩⟩
  have hend_mem :
      T.index ⟨T.len, by omega⟩ ∈ R.block4IndexSet := by
    simpa [LinkageContactTrace.EndsIn, LinkageContactTrace.lastIndex] using hend
  have hs_lt_len : s.1 < T.len := by
    by_contra hnot
    have hs_eq_len : s.1 = T.len := by omega
    have hlast_p2 :
        T.index ⟨T.len, by omega⟩ =
          R.indexAt (2 * z h) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      have hfin :
          (⟨T.len, by omega⟩ : Fin (T.len + 1)) =
            ⟨s.1, Nat.lt_succ_of_le hs_le⟩ := by
        apply Fin.ext
        simp [hs_eq_len]
      rw [hfin]
      simpa [pTwoZIndex, pTwoZPos, indexAt, posOfNat] using hstart
    have hp2_block4 :
        R.indexAt (2 * z h) (by
          have hz_eq : z h = 2 * h := rfl
          omega) ∈ R.block4IndexSet := by
      simpa [hlast_p2] using hend_mem
    have hlower :=
      R.indexAt_mem_block4_position_lower
        (by have hz_eq : z h = 2 * h := rfl; omega) hp2_block4
    have hz_eq : z h = 2 * h := rfl
    omega
  let r0 : Fin T.len := ⟨s.1, hs_lt_len⟩
  have hcur :
      T.index ⟨r0.1, by omega⟩ =
        R.indexAt (2 * z h) (by
          have hz_eq : z h = 2 * h := rfl
          omega) := by
    simpa [r0, pTwoZIndex, pTwoZPos, indexAt, posOfNat] using hstart
  rcases T.toLinkageContactTrace.next_index_eq_or_neighbor_of_displayed
      (R := R) (r := r0) (k := 2 * z h)
      (by have hz_eq : z h = 2 * h := rfl; omega)
      (by have hz_eq : z h = 2 * h := rfl; omega)
      hcur with hsame | hprev | hsucc
  · have hbad := hno2zStrict (s.1 + 1) (by omega) (by omega)
    exact hbad (by
      simpa [r0, pTwoZIndex, pTwoZPos, indexAt, posOfNat] using hsame)
  · have hstart_left :
        T.index ⟨s.1 + 1, Nat.lt_succ_of_le (by omega)⟩ =
          R.indexAt (2 * z h - 1) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      simpa [r0] using hprev
    have hnoZ_left : ∀ (n : ℕ) (_hsn : s.1 + 1 ≤ n) (hn : n ≤ T.len),
        T.index ⟨n, Nat.lt_succ_of_le hn⟩ ≠
          R.indexAt (z h + 1) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      intro n hsn hn hidx
      exact hnoZ n (by omega) hn (by
        simpa [pZPlusOneIndex, pZPlusOnePos, indexAt, posOfNat] using hidx)
    have hno2z_left : ∀ (n : ℕ) (_hsn : s.1 + 1 ≤ n) (hn : n ≤ T.len),
        T.index ⟨n, Nat.lt_succ_of_le hn⟩ ≠
          R.indexAt (2 * z h) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      intro n hsn hn hidx
      exact hno2zStrict n (by omega) hn (by
        simpa [pTwoZIndex, pTwoZPos, indexAt, posOfNat] using hidx)
    let d := T.len - (s.1 + 1)
    have hsd : s.1 + 1 + d ≤ T.len := by
      dsimp [d]
      omega
    have hleft_gt : z h + 1 < 2 * z h - 1 := by
      by_contra hnot
      have hidxZ :
          T.index ⟨s.1 + 1, Nat.lt_succ_of_le (by omega)⟩ =
            R.indexAt (z h + 1) (by
              have hz_eq : z h = 2 * h := rfl
              omega) := by
        have hle : 2 * z h - 1 ≤ z h + 1 := Nat.le_of_not_gt hnot
        have heq : 2 * z h - 1 = z h + 1 := by
          have hz_eq : z h = 2 * h := rfl
          omega
        simpa [heq] using hstart_left
      have hbad := hnoZ (s.1 + 1) (by omega) (by omega)
      exact hbad (by
        simpa [pZPlusOneIndex, pZPlusOnePos, indexAt, posOfNat] using hidxZ)
    rcases T.toLinkageContactTrace.between_left_barriers_offset_of_avoids
        (R := R) (hpos := hpos) (hs := by omega)
        (a := z h + 1) (k := 2 * z h - 1)
        (by omega)
        (by have hz_eq : z h = 2 * h := rfl; omega)
        hleft_gt
        (by have hz_eq : z h = 2 * h := rfl; omega)
        hstart_left hnoZ_left hno2z_left d hsd with
      ⟨k', hk'_lt, _hk'_lo, hk'_hi, hlast⟩
    have hsd_eq : s.1 + 1 + d = T.len := by
      dsimp [d]
      omega
    have hlast_eq :
        T.index ⟨T.len, by omega⟩ = R.indexAt k' hk'_lt := by
      have hfin :
          (⟨T.len, by omega⟩ : Fin (T.len + 1)) =
            ⟨s.1 + 1 + d, Nat.lt_succ_of_le hsd⟩ := by
        apply Fin.ext
        simp [hsd_eq]
      simpa [hfin] using hlast
    have hblock4 : R.indexAt k' hk'_lt ∈ R.block4IndexSet := by
      simpa [hlast_eq] using hend_mem
    have hk'_lower := R.indexAt_mem_block4_position_lower hk'_lt hblock4
    have hz_eq : z h = 2 * h := rfl
    omega
  · have hstart_right :
        T.index ⟨s.1 + 1, Nat.lt_succ_of_le (by omega)⟩ =
          R.indexAt (2 * z h + 1) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      simpa [r0] using hsucc
    have hno2z_right : ∀ (n : ℕ) (_hsn : s.1 + 1 ≤ n) (hn : n ≤ T.len),
        T.index ⟨n, Nat.lt_succ_of_le hn⟩ ≠
          R.indexAt (2 * z h) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      intro n hsn hn hidx
      exact hno2zStrict n (by omega) hn (by
        simpa [pTwoZIndex, pTwoZPos, indexAt, posOfNat] using hidx)
    have hno3_right : ∀ (n : ℕ) (_hsn : s.1 + 1 ≤ n) (hn : n ≤ T.len),
        T.index ⟨n, Nat.lt_succ_of_le hn⟩ ≠
          R.indexAt (3 * z h + 1) (by
            have hz_eq : z h = 2 * h := rfl
            omega) := by
      intro n hsn hn hidx
      exact hno3 n (by omega) hn (by
        simpa [pThreeZPlusOneIndex, pThreeZPlusOnePos, indexAt, posOfNat] using hidx)
    let d := T.len - (s.1 + 1)
    have hsd : s.1 + 1 + d ≤ T.len := by
      dsimp [d]
      omega
    rcases T.toLinkageContactTrace.right_corridor_offset_of_avoids_boundaries
        (R := R) (hpos := hpos) (hs := by omega)
        (k := 2 * z h + 1)
        (by omega)
        (by have hz_eq : z h = 2 * h := rfl; omega)
        hstart_right hno2z_right hno3_right d hsd with
      ⟨k', hk'_lt, _hk'_lo, hk'_hi, hlast⟩
    have hsd_eq : s.1 + 1 + d = T.len := by
      dsimp [d]
      omega
    have hlast_eq :
        T.index ⟨T.len, by omega⟩ = R.indexAt k' hk'_lt := by
      have hfin :
          (⟨T.len, by omega⟩ : Fin (T.len + 1)) =
            ⟨s.1 + 1 + d, Nat.lt_succ_of_le hsd⟩ := by
        apply Fin.ext
        simp [hsd_eq]
      simpa [hfin] using hlast
    have hblock4 : R.indexAt k' hk'_lt ∈ R.block4IndexSet := by
      simpa [hlast_eq] using hend_mem
    have hk'_lower := R.indexAt_mem_block4_position_lower hk'_lt hblock4
    have hz_eq : z h = 2 * h := rfl
    omega

/-- The set of linkage paths that a type-2 segment `Q*` is allowed to meet:
`P_3 ∪ {P_{2z}, P_{3z+1}}`. -/
noncomputable def typeTwoAllowedIndexSet
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h) : Finset L.Index :=
  insert (R.pTwoZIndex hpos) (insert (R.pThreeZPlusOneIndex hpos)
    R.block3IndexSet)

theorem pTwoZIndex_mem_typeTwoAllowedIndexSet
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h) :
    R.pTwoZIndex hpos ∈ typeTwoAllowedIndexSet R hpos := by
  simp [typeTwoAllowedIndexSet]

theorem pThreeZPlusOneIndex_mem_typeTwoAllowedIndexSet
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h) :
    R.pThreeZPlusOneIndex hpos ∈ typeTwoAllowedIndexSet R hpos := by
  simp [typeTwoAllowedIndexSet]

theorem block3IndexSet_subset_typeTwoAllowedIndexSet
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h) :
    R.block3IndexSet ⊆ typeTwoAllowedIndexSet R hpos := by
  intro j hj
  simp [typeTwoAllowedIndexSet, hj]

/-- A displayed index in the closed interval from `P_{2z}` through
`P_{3z+1}` is one of the linkage paths allowed for a type-2 `Q*` segment. -/
theorem indexAt_mem_typeTwoAllowedIndexSet_of_between_twoZ_threeZPlusOne
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h)
    {k : ℕ} (hk : k < 8 * h + 1)
    (hklo : 2 * z h ≤ k) (hkhi : k ≤ 3 * z h + 1) :
    R.indexAt k hk ∈ typeTwoAllowedIndexSet R hpos := by
  classical
  by_cases hk2 : k = 2 * z h
  · have hidx :
        R.indexAt k hk = R.pTwoZIndex hpos := by
      subst hk2
      simp [pTwoZIndex, pTwoZPos, indexAt, posOfNat]
    rw [hidx]
    exact pTwoZIndex_mem_typeTwoAllowedIndexSet R hpos
  by_cases hk3 : k = 3 * z h + 1
  · have hidx :
        R.indexAt k hk = R.pThreeZPlusOneIndex hpos := by
      subst hk3
      simp [pThreeZPlusOneIndex, pThreeZPlusOnePos, indexAt, posOfNat]
    rw [hidx]
    exact pThreeZPlusOneIndex_mem_typeTwoAllowedIndexSet R hpos
  · have hklo' : 2 * z h + 1 ≤ k := by omega
    have hkhi' : k ≤ 3 * z h := by omega
    have hi_lt : k - (2 * z h + 1) < z h := by
      have hz_eq : z h = 2 * h := rfl
      omega
    let i : Fin (z h) := ⟨k - (2 * z h + 1), hi_lt⟩
    have hblock :
        R.indexAt k hk ∈ R.block3IndexSet := by
      rw [R.mem_block3IndexSet_iff]
      refine ⟨i, ?_⟩
      have hposi : 2 * z h + 1 + i.1 < 8 * h + 1 := by
        dsimp [i, z]
        omega
      rw [R.block3_index_eq_indexAt i]
      exact (R.indexAt_eq_indexAt_iff hk hposi).2 (by
        dsimp [i]
        omega)
    exact block3IndexSet_subset_typeTwoAllowedIndexSet R hpos hblock

/-- In the type-2 case, `Q*` is the prefix of the middle-boundary suffix ending
at the first later contact with `P_{3z+1}`. -/
noncomputable def typeTwoQStarFromLastFirst
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h)
    (Q : GraphPath G)
    (hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty)
    (hp3 :
      ((middleBoundarySuffix (L := L) R hpos Q hmid).vertexSet ∩
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet).Nonempty) :
    GraphPath G :=
  (middleBoundarySuffix (L := L) R hpos Q hmid).cleanPrefixToSet
    (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet hp3

/-- A vertex of the original path that lies between the last middle-boundary
source and the first later `P_{3z+1}` hit lies on the formal type-2 `Q*`
prefix. -/
theorem mem_typeTwoQStarFromLastFirst_of_between
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    {hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty}
    {hp3 :
      ((middleBoundarySuffix (L := L) R hpos Q hmid).vertexSet ∩
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet).Nonempty}
    {v : V}
    (hleft :
      Q.Before (middleBoundarySuffix (L := L) R hpos Q hmid).source v)
    (hright :
      Q.Before v
        (typeTwoQStarFromLastFirst (L := L) R hpos Q hmid hp3).target) :
    v ∈ (typeTwoQStarFromLastFirst (L := L) R hpos Q hmid hp3).vertexSet := by
  classical
  let suffix : GraphPath G :=
    middleBoundarySuffix (L := L) R hpos Q hmid
  let qstar : GraphPath G :=
    typeTwoQStarFromLastFirst (L := L) R hpos Q hmid hp3
  have hv_suffix : v ∈ suffix.vertexSet := by
    simpa [suffix, middleBoundarySuffix, GraphPath.cleanSuffixFromSet] using
      hleft.choose_spec
  have ht_suffix : qstar.target ∈ suffix.vertexSet := by
    exact suffix.cleanPrefixToSet_vertexSet_subset
      (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet hp3
      (GraphPath.target_mem_vertexSet qstar)
  have hsource_Q : suffix.source ∈ Q.vertexSet := by
    exact Q.cleanSuffixFromSet_vertexSet_subset
      (middleBoundaryVertexSet (L := L) R hpos) hmid
      (GraphPath.source_mem_vertexSet suffix)
  have hv_drop :
      v ∈ (Q.dropUntil hsource_Q).vertexSet := by
    simpa [suffix, middleBoundarySuffix, GraphPath.cleanSuffixFromSet] using hv_suffix
  have ht_drop :
      qstar.target ∈ (Q.dropUntil hsource_Q).vertexSet := by
    simpa [suffix, middleBoundarySuffix, GraphPath.cleanSuffixFromSet] using ht_suffix
  have hv_idx :
      Q.vertexIndex v =
        Q.vertexIndex suffix.source + (Q.dropUntil hsource_Q).vertexIndex v := by
    simpa [suffix] using
      Q.vertexIndex_eq_add_vertexIndex_dropUntil hsource_Q hv_drop
  have ht_idx :
      Q.vertexIndex qstar.target =
        Q.vertexIndex suffix.source +
          (Q.dropUntil hsource_Q).vertexIndex qstar.target := by
    simpa [suffix] using
      Q.vertexIndex_eq_add_vertexIndex_dropUntil hsource_Q ht_drop
  have hright_idx :
      Q.vertexIndex v ≤ Q.vertexIndex qstar.target :=
    ((Q.before_iff_vertexIndex_le).1 hright).2.2
  have hv_before_target_suffix :
      suffix.Before v qstar.target := by
    refine (suffix.before_iff_vertexIndex_le).2 ?_
    refine ⟨hv_suffix, ht_suffix, ?_⟩
    have hdrop_idx :
        (Q.dropUntil hsource_Q).vertexIndex v ≤
          (Q.dropUntil hsource_Q).vertexIndex qstar.target := by
      omega
    simpa [suffix, middleBoundarySuffix, GraphPath.cleanSuffixFromSet] using hdrop_idx
  simpa [qstar, typeTwoQStarFromLastFirst] using
    suffix.mem_takeUntil_of_before
      (suffix.firstHitVertex_mem_vertexSet
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet hp3)
      hv_before_target_suffix

/-- Any recorded linkage contact lying on the type-2 last/first-hit segment
occurs between the recorded last middle-boundary contact and the recorded first
`P_{3z+1}` contact. -/
theorem typeTwoQStarFromLastFirst_contact_bounds
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    {hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty}
    {hp3 :
      ((middleBoundarySuffix (L := L) R hpos Q hmid).vertexSet ∩
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet).Nonempty}
    (T : CompleteLinkageContactTrace R Q)
    {s t r : Fin (T.len + 1)}
    (hs_contact :
      T.contact s = (middleBoundarySuffix (L := L) R hpos Q hmid).source)
    (ht_contact :
      T.contact t =
        (typeTwoQStarFromLastFirst (L := L) R hpos Q hmid hp3).target)
    (hr_mem :
      T.contact r ∈
        (typeTwoQStarFromLastFirst (L := L) R hpos Q hmid hp3).vertexSet) :
    s.1 ≤ r.1 ∧ r.1 ≤ t.1 := by
  classical
  let suffix : GraphPath G :=
    middleBoundarySuffix (L := L) R hpos Q hmid
  let qstar : GraphPath G :=
    typeTwoQStarFromLastFirst (L := L) R hpos Q hmid hp3
  have hr_suffix : T.contact r ∈ suffix.vertexSet := by
    exact suffix.cleanPrefixToSet_vertexSet_subset
      (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet hp3
      (by simpa [qstar, typeTwoQStarFromLastFirst, suffix] using hr_mem)
  have hsource_Q : suffix.source ∈ Q.vertexSet := by
    exact Q.cleanSuffixFromSet_vertexSet_subset
      (middleBoundaryVertexSet (L := L) R hpos) hmid
      (GraphPath.source_mem_vertexSet suffix)
  have hleft :
      Q.Before suffix.source (T.contact r) := by
    exact ⟨hsource_Q, by
      simpa [suffix, middleBoundarySuffix, GraphPath.cleanSuffixFromSet] using
        hr_suffix⟩
  have hs_le_r : s.1 ≤ r.1 := by
    have hbefore_contacts :
        Q.Before (T.contact s) (T.contact r) := by
      simpa [hs_contact, suffix] using hleft
    exact (T.contact_before_iff_le s r).1 hbefore_contacts
  have htarget_suffix : qstar.target ∈ suffix.vertexSet := by
    exact suffix.cleanPrefixToSet_vertexSet_subset
      (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet hp3
      (GraphPath.target_mem_vertexSet qstar)
  have htarget_Q : qstar.target ∈ Q.vertexSet := by
    exact Q.cleanSuffixFromSet_vertexSet_subset
      (middleBoundaryVertexSet (L := L) R hpos) hmid htarget_suffix
  have hr_before_target_suffix :
      suffix.Before (T.contact r) qstar.target := by
    simpa [qstar, typeTwoQStarFromLastFirst, suffix] using
      suffix.before_of_mem_takeUntil
        (suffix.firstHitVertex_mem_vertexSet
          (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet hp3)
        (by simpa [qstar, typeTwoQStarFromLastFirst, suffix] using hr_mem)
  have hr_drop :
      T.contact r ∈ (Q.dropUntil hsource_Q).vertexSet := by
    simpa [suffix, middleBoundarySuffix, GraphPath.cleanSuffixFromSet] using
      hr_suffix
  have ht_drop :
      qstar.target ∈ (Q.dropUntil hsource_Q).vertexSet := by
    simpa [suffix, middleBoundarySuffix, GraphPath.cleanSuffixFromSet] using
      htarget_suffix
  have hr_idx :
      Q.vertexIndex (T.contact r) =
        Q.vertexIndex suffix.source +
          (Q.dropUntil hsource_Q).vertexIndex (T.contact r) := by
    simpa [suffix] using
      Q.vertexIndex_eq_add_vertexIndex_dropUntil hsource_Q hr_drop
  have ht_idx :
      Q.vertexIndex qstar.target =
        Q.vertexIndex suffix.source +
          (Q.dropUntil hsource_Q).vertexIndex qstar.target := by
    simpa [suffix] using
      Q.vertexIndex_eq_add_vertexIndex_dropUntil hsource_Q ht_drop
  have hsuf_idx :
      suffix.vertexIndex (T.contact r) ≤ suffix.vertexIndex qstar.target :=
    ((suffix.before_iff_vertexIndex_le).1 hr_before_target_suffix).2.2
  have hQ_before_target :
      Q.Before (T.contact r) qstar.target := by
    refine (Q.before_iff_vertexIndex_le).2 ?_
    refine ⟨T.contact_mem_Q r, htarget_Q, ?_⟩
    rw [hr_idx, ht_idx]
    simpa [suffix, middleBoundarySuffix, GraphPath.cleanSuffixFromSet] using
      Nat.add_le_add_left hsuf_idx (Q.vertexIndex suffix.source)
  have hr_le_t : r.1 ≤ t.1 := by
    have hbefore_contacts :
        Q.Before (T.contact r) (T.contact t) := by
      simpa [ht_contact, qstar] using hQ_before_target
    exact (T.contact_before_iff_le r t).1 hbefore_contacts
  exact ⟨hs_le_r, hr_le_t⟩

/-- Before the first `P_{3z+1}` contact defining the target of a type-2 `Q*`
segment, the complete trace has no `P_{3z+1}` index. -/
theorem no_pThreeZPlusOne_index_before_typeTwoQStarFromLastFirst_target
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    {hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty}
    {hp3 :
      ((middleBoundarySuffix (L := L) R hpos Q hmid).vertexSet ∩
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet).Nonempty}
    (T : CompleteLinkageContactTrace R Q)
    {s t : Fin (T.len + 1)}
    (hs_contact :
      T.contact s = (middleBoundarySuffix (L := L) R hpos Q hmid).source)
    (ht_contact :
      T.contact t =
        (typeTwoQStarFromLastFirst (L := L) R hpos Q hmid hp3).target) :
    ∀ (n : ℕ) (_hsn : s.1 ≤ n) (_hnt : n < t.1),
      T.index ⟨n, by omega⟩ ≠ R.pThreeZPlusOneIndex hpos := by
  classical
  intro n hsn hnt hidx
  let rn : Fin (T.len + 1) := ⟨n, by omega⟩
  let suffix : GraphPath G :=
    middleBoundarySuffix (L := L) R hpos Q hmid
  let qstar : GraphPath G :=
    typeTwoQStarFromLastFirst (L := L) R hpos Q hmid hp3
  have hn_left :
      Q.Before suffix.source (T.contact rn) := by
    have hbefore := T.toLinkageContactTrace.contact_before_of_le
      (a := s) (b := rn) (by simpa [rn] using hsn)
    simpa [hs_contact, suffix, rn] using hbefore
  have hn_right :
      Q.Before (T.contact rn) qstar.target := by
    have hbefore := T.toLinkageContactTrace.contact_before_of_le
      (a := rn) (b := t) (by simpa [rn] using le_of_lt hnt)
    simpa [ht_contact, qstar, rn] using hbefore
  have hn_qstar :
      T.contact rn ∈ qstar.vertexSet := by
    simpa [qstar, suffix] using
      mem_typeTwoQStarFromLastFirst_of_between
        (L := L) (R := R) (hpos := hpos) (Q := Q)
        (hmid := hmid) (hp3 := hp3) hn_left hn_right
  have hn_mem_p3 :
      T.contact rn ∈ (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet := by
    simpa [rn, hidx] using T.contact_mem_linkage rn
  have hp3_singleton :
      (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet ∩ qstar.vertexSet =
        {qstar.target} := by
    simpa [qstar, typeTwoQStarFromLastFirst, suffix] using
      suffix.cleanPrefixToSet_inter_eq_singleton_target
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet hp3
  have hn_eq_target : T.contact rn = qstar.target := by
    have hsingle :
        T.contact rn ∈ ({qstar.target} : Finset V) := by
      rw [← hp3_singleton]
      exact Finset.mem_inter.2 ⟨hn_mem_p3, hn_qstar⟩
    simpa using hsingle
  have htarget_Q : qstar.target ∈ Q.vertexSet := by
    have ht_suffix : qstar.target ∈ suffix.vertexSet :=
      suffix.cleanPrefixToSet_vertexSet_subset
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet hp3
        (GraphPath.target_mem_vertexSet qstar)
    exact Q.cleanSuffixFromSet_vertexSet_subset
      (middleBoundaryVertexSet (L := L) R hpos) hmid ht_suffix
  have hback :
      Q.Before (T.contact t) (T.contact rn) := by
    have hrefl : Q.Before qstar.target qstar.target :=
      Q.before_refl htarget_Q
    simpa [ht_contact, hn_eq_target, qstar, rn] using hrefl
  have ht_le_n : t.1 ≤ rn.1 := (T.contact_before_iff_le t rn).1 hback
  have hrn_val : rn.1 = n := rfl
  omega

/-- The type-2 last/first-hit prefix meets every displayed row of the third
block. -/
theorem typeTwoQStarFromLastFirst_hits_block3_of_completeTrace
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    (T : CompleteLinkageContactTrace R Q)
    (hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty)
    (hsource :
      (middleBoundarySuffix (L := L) R hpos Q hmid).source ∈
        (L.path (R.pTwoZIndex hpos)).vertexSet)
    (hp3 :
      ((middleBoundarySuffix (L := L) R hpos Q hmid).vertexSet ∩
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet).Nonempty) :
    R.HitsBlock3 (typeTwoQStarFromLastFirst (L := L) R hpos Q hmid hp3) := by
  classical
  let suffix : GraphPath G :=
    middleBoundarySuffix (L := L) R hpos Q hmid
  let qstar : GraphPath G :=
    typeTwoQStarFromLastFirst (L := L) R hpos Q hmid hp3
  have hsource_Q : suffix.source ∈ Q.vertexSet := by
    exact Q.cleanSuffixFromSet_vertexSet_subset
      (middleBoundaryVertexSet (L := L) R hpos) hmid
      (GraphPath.source_mem_vertexSet suffix)
  have hsource_L : suffix.source ∈ L.toPathPacking.vertexSet :=
    (L.toPathPacking.mem_vertexSet).2
      ⟨R.pTwoZIndex hpos, by simpa [suffix] using hsource⟩
  rcases T.contact_complete hsource_Q hsource_L with ⟨s, hs_contact⟩
  have hs_le : s.1 ≤ T.len := by omega
  have hs_start :
      T.index ⟨s.1, Nat.lt_succ_of_le hs_le⟩ = R.pTwoZIndex hpos := by
    have hs_fin :
        (⟨s.1, Nat.lt_succ_of_le hs_le⟩ : Fin (T.len + 1)) = s := by
      apply Fin.ext
      simp
    rw [hs_fin]
    exact T.index_eq_of_contact_mem (by simpa [hs_contact, suffix] using hsource)
  have htarget_p3 :
      qstar.target ∈ (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet := by
    simpa [qstar, typeTwoQStarFromLastFirst, suffix] using
      suffix.cleanPrefixToSet_target_mem
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet hp3
  have htarget_Q : qstar.target ∈ Q.vertexSet := by
    have ht_suffix : qstar.target ∈ suffix.vertexSet :=
      suffix.cleanPrefixToSet_vertexSet_subset
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet hp3
        (GraphPath.target_mem_vertexSet qstar)
    exact Q.cleanSuffixFromSet_vertexSet_subset
      (middleBoundaryVertexSet (L := L) R hpos) hmid ht_suffix
  have htarget_L : qstar.target ∈ L.toPathPacking.vertexSet :=
    (L.toPathPacking.mem_vertexSet).2
      ⟨R.pThreeZPlusOneIndex hpos, htarget_p3⟩
  rcases T.contact_complete htarget_Q htarget_L with ⟨t, ht_contact⟩
  have ht_le : t.1 ≤ T.len := by omega
  have ht_end :
      T.index ⟨t.1, Nat.lt_succ_of_le ht_le⟩ =
        R.pThreeZPlusOneIndex hpos := by
    have ht_fin :
        (⟨t.1, Nat.lt_succ_of_le ht_le⟩ : Fin (T.len + 1)) = t := by
      apply Fin.ext
      simp
    rw [ht_fin]
    exact T.index_eq_of_contact_mem (by simpa [ht_contact] using htarget_p3)
  have hsource_before_target_Q :
      Q.Before suffix.source qstar.target := by
    have ht_suffix : qstar.target ∈ suffix.vertexSet :=
      suffix.cleanPrefixToSet_vertexSet_subset
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet hp3
        (GraphPath.target_mem_vertexSet qstar)
    exact ⟨hsource_Q, by
      simpa [suffix, middleBoundarySuffix, GraphPath.cleanSuffixFromSet] using
        ht_suffix⟩
  have hst : s.1 ≤ t.1 := by
    have hbefore_contacts :
        Q.Before (T.contact s) (T.contact t) := by
      simpa [hs_contact, ht_contact, suffix, qstar] using hsource_before_target_Q
    exact (T.contact_before_iff_le s t).1 hbefore_contacts
  have hnoZ_all :=
    no_later_pZPlusOne_index_of_middleBoundarySuffix_source_pTwoZ
      (L := L) (R := R) (hpos := hpos) T hmid hs_contact hsource
  have hno2z_strict :=
    no_strict_later_pTwoZ_index_of_middleBoundarySuffix_source_pTwoZ
      (L := L) (R := R) (hpos := hpos) T hmid hs_contact hsource
  intro i
  let a : ℕ := 2 * z h + 1 + i.1
  have ha_lo : 2 * z h < a := by dsimp [a]; omega
  have ha_hi : a ≤ 3 * z h := by
    have hi : i.1 < z h := i.2
    dsimp [a]
    omega
  have hnoZ_between : ∀ (n : ℕ) (_hsn : s.1 ≤ n) (_hnt : n ≤ t.1),
      T.index ⟨n, Nat.lt_succ_of_le (le_trans _hnt ht_le)⟩ ≠
        R.pZPlusOneIndex hpos := by
    intro n hsn hnt
    exact hnoZ_all n hsn (le_trans hnt ht_le)
  have hno2z_between : ∀ (n : ℕ) (_hsn : s.1 < n) (_hnt : n ≤ t.1),
      T.index ⟨n, Nat.lt_succ_of_le (le_trans _hnt ht_le)⟩ ≠
        R.pTwoZIndex hpos := by
    intro n hsn hnt
    exact hno2z_strict n hsn (le_trans hnt ht_le)
  rcases T.toLinkageContactTrace.exists_displayed_index_between_pTwoZ_and_pThreeZPlusOne
      (R := R) (hpos := hpos) (s := s.1) (t := t.1) (a := a)
      hs_le ht_le hst ha_lo ha_hi hs_start ht_end hnoZ_between hno2z_between with
    ⟨n, hsn, hnt, hn_idx⟩
  let rn : Fin (T.len + 1) := ⟨n, Nat.lt_succ_of_le (le_trans hnt ht_le)⟩
  have hn_mem_row :
      T.contact rn ∈
        (L.path (R.index (windowPos h (2 * z h + 1) (by
          dsimp [z]
          omega) i))).vertexSet := by
    have hidx_row :
        T.index rn =
          R.index (windowPos h (2 * z h + 1) (by dsimp [z]; omega) i) := by
      have hidx_at :
          T.index rn =
            R.indexAt a (by
              have hz_eq : z h = 2 * h := rfl
              omega) := by
        simpa [rn, a] using hn_idx
      simpa [a, block3_index_eq_indexAt] using hidx_at
    simpa [hidx_row] using T.contact_mem_linkage rn
  have hn_left :
      Q.Before suffix.source (T.contact rn) := by
    have hbefore := T.toLinkageContactTrace.contact_before_of_le
      (a := s) (b := rn) (by simpa [rn] using hsn)
    simpa [hs_contact, rn, suffix] using hbefore
  have hn_right :
      Q.Before (T.contact rn) qstar.target := by
    have hbefore := T.toLinkageContactTrace.contact_before_of_le
      (a := rn) (b := t) (by simpa [rn] using hnt)
    simpa [ht_contact, rn, qstar] using hbefore
  have hn_qstar :
      T.contact rn ∈ qstar.vertexSet := by
    simpa [qstar, suffix] using
      mem_typeTwoQStarFromLastFirst_of_between
        (L := L) (R := R) (hpos := hpos) (Q := Q)
        (hmid := hmid) (hp3 := hp3) hn_left hn_right
  exact ⟨T.contact rn, Finset.mem_inter.2 ⟨hn_qstar, hn_mem_row⟩⟩

/-- Every complete-trace contact that lies on the type-2 last/first-hit
segment has one of the allowed type-2 linkage indices. -/
theorem typeTwoQStarFromLastFirst_contact_index_mem_allowed
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    (T : CompleteLinkageContactTrace R Q)
    (hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty)
    (hsource :
      (middleBoundarySuffix (L := L) R hpos Q hmid).source ∈
        (L.path (R.pTwoZIndex hpos)).vertexSet)
    (hp3 :
      ((middleBoundarySuffix (L := L) R hpos Q hmid).vertexSet ∩
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet).Nonempty)
    {r : Fin (T.len + 1)}
    (hr_mem :
      T.contact r ∈
        (typeTwoQStarFromLastFirst (L := L) R hpos Q hmid hp3).vertexSet) :
    T.index r ∈ typeTwoAllowedIndexSet R hpos := by
  classical
  let suffix : GraphPath G :=
    middleBoundarySuffix (L := L) R hpos Q hmid
  let qstar : GraphPath G :=
    typeTwoQStarFromLastFirst (L := L) R hpos Q hmid hp3
  have hsource_Q : suffix.source ∈ Q.vertexSet := by
    exact Q.cleanSuffixFromSet_vertexSet_subset
      (middleBoundaryVertexSet (L := L) R hpos) hmid
      (GraphPath.source_mem_vertexSet suffix)
  have hsource_L : suffix.source ∈ L.toPathPacking.vertexSet :=
    (L.toPathPacking.mem_vertexSet).2
      ⟨R.pTwoZIndex hpos, by simpa [suffix] using hsource⟩
  rcases T.contact_complete hsource_Q hsource_L with ⟨s, hs_contact⟩
  have htarget_p3 :
      qstar.target ∈ (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet := by
    simpa [qstar, typeTwoQStarFromLastFirst, suffix] using
      suffix.cleanPrefixToSet_target_mem
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet hp3
  have htarget_suffix : qstar.target ∈ suffix.vertexSet := by
    exact suffix.cleanPrefixToSet_vertexSet_subset
      (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet hp3
      (GraphPath.target_mem_vertexSet qstar)
  have htarget_Q : qstar.target ∈ Q.vertexSet := by
    exact Q.cleanSuffixFromSet_vertexSet_subset
      (middleBoundaryVertexSet (L := L) R hpos) hmid htarget_suffix
  have htarget_L : qstar.target ∈ L.toPathPacking.vertexSet :=
    (L.toPathPacking.mem_vertexSet).2
      ⟨R.pThreeZPlusOneIndex hpos, htarget_p3⟩
  rcases T.contact_complete htarget_Q htarget_L with ⟨t, ht_contact⟩
  have hs_idx : T.index s = R.pTwoZIndex hpos := by
    exact T.index_eq_of_contact_mem (by simpa [hs_contact, suffix] using hsource)
  have ht_idx : T.index t = R.pThreeZPlusOneIndex hpos := by
    exact T.index_eq_of_contact_mem (by simpa [ht_contact, qstar] using htarget_p3)
  rcases typeTwoQStarFromLastFirst_contact_bounds
      (L := L) (R := R) (hpos := hpos) (Q := Q)
      (hmid := hmid) (hp3 := hp3) T hs_contact ht_contact
      (by simpa [qstar] using hr_mem) with
    ⟨hs_le_r, hr_le_t⟩
  by_cases hrs : r.1 = s.1
  · have hr_eq_s : r = s := by
      apply Fin.ext
      exact hrs
    rw [hr_eq_s, hs_idx]
    exact pTwoZIndex_mem_typeTwoAllowedIndexSet R hpos
  by_cases hrt : r.1 = t.1
  · have hr_eq_t : r = t := by
      apply Fin.ext
      exact hrt
    rw [hr_eq_t, ht_idx]
    exact pThreeZPlusOneIndex_mem_typeTwoAllowedIndexSet R hpos
  have hs_lt_r : s.1 < r.1 := by omega
  have hr_lt_t : r.1 < t.1 := by omega
  have hs_le : s.1 ≤ T.len := by omega
  have hr_le : r.1 ≤ T.len := by omega
  have ht_le : t.1 ≤ T.len := by omega
  have hs_start :
      T.index ⟨s.1, Nat.lt_succ_of_le hs_le⟩ = R.pTwoZIndex hpos := by
    have hs_fin :
        (⟨s.1, Nat.lt_succ_of_le hs_le⟩ : Fin (T.len + 1)) = s := by
      apply Fin.ext
      simp
    simpa [hs_fin] using hs_idx
  have ht_end :
      T.index ⟨t.1, Nat.lt_succ_of_le ht_le⟩ =
        R.pThreeZPlusOneIndex hpos := by
    have ht_fin :
        (⟨t.1, Nat.lt_succ_of_le ht_le⟩ : Fin (T.len + 1)) = t := by
      apply Fin.ext
      simp
    simpa [ht_fin] using ht_idx
  have hnoZ_all :=
    no_later_pZPlusOne_index_of_middleBoundarySuffix_source_pTwoZ
      (L := L) (R := R) (hpos := hpos) T hmid hs_contact hsource
  have hno2z_strict :=
    no_strict_later_pTwoZ_index_of_middleBoundarySuffix_source_pTwoZ
      (L := L) (R := R) (hpos := hpos) T hmid hs_contact hsource
  have hno3_strict : ∀ (n : ℕ) (_hsn : s.1 ≤ n) (_hnt : n < t.1),
      T.index ⟨n, by omega⟩ ≠ R.pThreeZPlusOneIndex hpos :=
    no_pThreeZPlusOne_index_before_typeTwoQStarFromLastFirst_target
      (L := L) (R := R) (hpos := hpos) (Q := Q)
      (hmid := hmid) (hp3 := hp3) T hs_contact ht_contact
  have hnoZ_between : ∀ (n : ℕ) (_hsn : s.1 ≤ n) (_hnt : n ≤ t.1),
      T.index ⟨n, Nat.lt_succ_of_le (le_trans _hnt ht_le)⟩ ≠
        R.pZPlusOneIndex hpos := by
    intro n hsn hnt
    exact hnoZ_all n hsn (le_trans hnt ht_le)
  have hno2z_between : ∀ (n : ℕ) (_hsn : s.1 < n) (_hnt : n ≤ t.1),
      T.index ⟨n, Nat.lt_succ_of_le (le_trans _hnt ht_le)⟩ ≠
        R.pTwoZIndex hpos := by
    intro n hsn hnt
    exact hno2z_strict n hsn (le_trans hnt ht_le)
  rcases T.toLinkageContactTrace.displayed_right_corridor_of_between_pTwoZ_and_pThreeZPlusOne
      (R := R) (hpos := hpos) (s := s.1) (t := t.1) (n := r.1)
      hs_le ht_le (le_trans hs_le_r hr_le_t) hs_lt_r hr_lt_t hs_start ht_end
      hnoZ_between hno2z_between hno3_strict with
    ⟨k, hk_lt, hk_lo, hk_hi, hidx_r_display'⟩
  have hidx_r_display :
      T.index r = R.indexAt k hk_lt := by
    have hfin :
        (⟨r.1, Nat.lt_succ_of_le (le_trans (le_of_lt hr_lt_t) ht_le)⟩ :
          Fin (T.len + 1)) = r := by
      apply Fin.ext
      simp
    simpa [hfin] using hidx_r_display'
  rw [hidx_r_display]
  exact indexAt_mem_typeTwoAllowedIndexSet_of_between_twoZ_threeZPlusOne
    R hpos hk_lt (le_of_lt hk_lo) (by omega)

/-- The type-2 last/first-hit segment avoids every linkage path outside
`P_3 ∪ {P_{2z}, P_{3z+1}}`. -/
theorem typeTwoQStarFromLastFirst_avoids_other_linkage_of_completeTrace
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h} {Q : GraphPath G}
    (T : CompleteLinkageContactTrace R Q)
    (hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty)
    (hsource :
      (middleBoundarySuffix (L := L) R hpos Q hmid).source ∈
        (L.path (R.pTwoZIndex hpos)).vertexSet)
    (hp3 :
      ((middleBoundarySuffix (L := L) R hpos Q hmid).vertexSet ∩
        (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet).Nonempty) :
    ∀ j : L.Index, j ∉ typeTwoAllowedIndexSet R hpos →
      Disjoint
        (typeTwoQStarFromLastFirst (L := L) R hpos Q hmid hp3).vertexSet
        (L.path j).vertexSet := by
  classical
  intro j hj
  rw [Finset.disjoint_left]
  intro v hvq hvj
  let suffix : GraphPath G :=
    middleBoundarySuffix (L := L) R hpos Q hmid
  let qstar : GraphPath G :=
    typeTwoQStarFromLastFirst (L := L) R hpos Q hmid hp3
  have hv_suffix : v ∈ suffix.vertexSet := by
    exact suffix.cleanPrefixToSet_vertexSet_subset
      (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet hp3
      (by simpa [qstar, typeTwoQStarFromLastFirst, suffix] using hvq)
  have hvQ : v ∈ Q.vertexSet := by
    exact Q.cleanSuffixFromSet_vertexSet_subset
      (middleBoundaryVertexSet (L := L) R hpos) hmid hv_suffix
  have hvL : v ∈ L.toPathPacking.vertexSet :=
    (L.toPathPacking.mem_vertexSet).2 ⟨j, hvj⟩
  rcases T.contact_complete hvQ hvL with ⟨r, hrv⟩
  have hallowed :
      T.index r ∈ typeTwoAllowedIndexSet R hpos :=
    typeTwoQStarFromLastFirst_contact_index_mem_allowed
      (L := L) (R := R) (hpos := hpos) (Q := Q)
      T hmid hsource hp3 (r := r) (by simpa [hrv, qstar] using hvq)
  have hidx : T.index r = j :=
    T.index_eq_of_contact_mem (by simpa [hrv] using hvj)
  exact hj (by simpa [hidx] using hallowed)

/-- The formal certificate produced in the type-1 case of the second paragraph.

The paper constructs it from a transversal path `Q`: `v` is the last contact
with `P_{z+1} ∪ P_{2z}`, here specialized to `v ∈ P_{z+1}`; `u` is the first
later contact with `P_0`; and `qstar` is the segment from `v` to `u`.  The
fields record exactly the properties claimed at the end of the paragraph. -/
structure TypeOneQStarData (R : IndexedAuxiliaryPrefix L h)
    (hpos : 0 < h) (Q : GraphPath G) where
  v : V
  u : V
  v_mem_Q : v ∈ Q.vertexSet
  v_mem_PzPlusOne : v ∈ (L.path (R.pZPlusOneIndex hpos)).vertexSet
  u_mem_Q : u ∈ Q.vertexSet
  u_mem_P0 : u ∈ (L.path R.p0Index).vertexSet
  qstar : GraphPath G
  qstar_source_eq_v : qstar.source = v
  qstar_target_eq_u : qstar.target = u
  qstar_subset_Q : qstar.vertexSet ⊆ Q.vertexSet
  qstar_hits_block1 : R.HitsBlock1 qstar
  qstar_hits_P0 : HitsLinkagePath qstar R.p0Index
  qstar_hits_PzPlusOne : HitsLinkagePath qstar (R.pZPlusOneIndex hpos)
  qstar_avoids_other_linkage :
    ∀ j : L.Index, j ∉ typeOneAllowedIndexSet R hpos →
      Disjoint qstar.vertexSet (L.path j).vertexSet
  qstar_unique_P0 :
    (qstar.vertexSet ∩ (L.path R.p0Index).vertexSet).card = 1
  qstar_unique_PzPlusOne :
    (qstar.vertexSet ∩ (L.path (R.pZPlusOneIndex hpos)).vertexSet).card = 1

/-- The formal certificate produced in the type-2 case at the top of page 60.

Here `v` is the last contact with `P_{z+1} ∪ P_{2z}`, specialized to
`v ∈ P_{2z}`; `u` is the first later contact with `P_{3z+1}`; and `qstar` is
the segment between `u` and `v`. -/
structure TypeTwoQStarData (R : IndexedAuxiliaryPrefix L h)
    (hpos : 0 < h) (Q : GraphPath G) where
  v : V
  u : V
  v_mem_Q : v ∈ Q.vertexSet
  v_mem_PtwoZ : v ∈ (L.path (R.pTwoZIndex hpos)).vertexSet
  u_mem_Q : u ∈ Q.vertexSet
  u_mem_PthreeZPlusOne :
    u ∈ (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet
  qstar : GraphPath G
  qstar_source_eq_v : qstar.source = v
  qstar_target_eq_u : qstar.target = u
  qstar_subset_Q : qstar.vertexSet ⊆ Q.vertexSet
  qstar_hits_block3 : R.HitsBlock3 qstar
  qstar_hits_PtwoZ : HitsLinkagePath qstar (R.pTwoZIndex hpos)
  qstar_hits_PthreeZPlusOne :
    HitsLinkagePath qstar (R.pThreeZPlusOneIndex hpos)
  qstar_avoids_other_linkage :
    ∀ j : L.Index, j ∉ typeTwoAllowedIndexSet R hpos →
      Disjoint qstar.vertexSet (L.path j).vertexSet
  qstar_unique_PtwoZ :
    (qstar.vertexSet ∩ (L.path (R.pTwoZIndex hpos)).vertexSet).card = 1
  qstar_unique_PthreeZPlusOne :
    (qstar.vertexSet ∩
      (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet).card = 1

/-- Build the type-1 `Q*` certificate from a clean segment oriented from
`P_{z+1}` to `P_0`.  This packages the endpoint uniqueness and
outside-linkage avoidance checks that are used repeatedly later. -/
noncomputable def TypeOneQStarData.of_cleanSegment
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q qstar : GraphPath G}
    (hsub : qstar.vertexSet ⊆ Q.vertexSet)
    (hsource :
      qstar.source ∈ (L.path (R.pZPlusOneIndex hpos)).vertexSet)
    (htarget : qstar.target ∈ (L.path R.p0Index).vertexSet)
    (hclean : qstar.InternallyDisjointFromSet L.toPathPacking.vertexSet)
    (hhits : R.HitsBlock1 qstar) :
    TypeOneQStarData R hpos Q := by
  refine {
    v := qstar.source
    u := qstar.target
    v_mem_Q := hsub (GraphPath.source_mem_vertexSet qstar)
    v_mem_PzPlusOne := hsource
    u_mem_Q := hsub (GraphPath.target_mem_vertexSet qstar)
    u_mem_P0 := htarget
    qstar := qstar
    qstar_source_eq_v := rfl
    qstar_target_eq_u := rfl
    qstar_subset_Q := hsub
    qstar_hits_block1 := hhits
    qstar_hits_P0 := ?_
    qstar_hits_PzPlusOne := ?_
    qstar_avoids_other_linkage := ?_
    qstar_unique_P0 := ?_
    qstar_unique_PzPlusOne := ?_ }
  · exact ⟨qstar.target, Finset.mem_inter.2
      ⟨GraphPath.target_mem_vertexSet qstar, htarget⟩⟩
  · exact ⟨qstar.source, Finset.mem_inter.2
      ⟨GraphPath.source_mem_vertexSet qstar, hsource⟩⟩
  · intro j hj
    have hsource_not : qstar.source ∉ (L.path j).vertexSet := by
      have hne : R.pZPlusOneIndex hpos ≠ j := by
        intro h
        exact hj (by
          simpa [← h] using
            pZPlusOneIndex_mem_typeOneAllowedIndexSet R hpos)
      exact not_mem_linkage_path_of_mem_other (L := L) hne hsource
    have htarget_not : qstar.target ∉ (L.path j).vertexSet := by
      have hne : R.p0Index ≠ j := by
        intro h
        exact hj (by
          simpa [← h] using p0Index_mem_typeOneAllowedIndexSet R hpos)
      exact not_mem_linkage_path_of_mem_other (L := L) hne htarget
    exact disjoint_linkage_path_of_internallyDisjointFromSet
      (L := L) qstar hclean hsource_not htarget_not
  · exact inter_linkage_path_card_eq_one_target_of_internallyDisjointFromSet
      (L := L) qstar hclean
      (not_mem_p0Index_of_mem_pZPlusOneIndex (L := L) hsource) htarget
  · exact inter_linkage_path_card_eq_one_source_of_internallyDisjointFromSet
      (L := L) qstar hclean hsource
      (not_mem_pZPlusOneIndex_of_mem_p0Index (L := L) htarget)

/-- Build the type-2 `Q*` certificate from a clean segment oriented from
`P_{2z}` to `P_{3z+1}`. -/
noncomputable def TypeTwoQStarData.of_cleanSegment
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q qstar : GraphPath G}
    (hsub : qstar.vertexSet ⊆ Q.vertexSet)
    (hsource : qstar.source ∈ (L.path (R.pTwoZIndex hpos)).vertexSet)
    (htarget :
      qstar.target ∈ (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet)
    (hclean : qstar.InternallyDisjointFromSet L.toPathPacking.vertexSet)
    (hhits : R.HitsBlock3 qstar) :
    TypeTwoQStarData R hpos Q := by
  refine {
    v := qstar.source
    u := qstar.target
    v_mem_Q := hsub (GraphPath.source_mem_vertexSet qstar)
    v_mem_PtwoZ := hsource
    u_mem_Q := hsub (GraphPath.target_mem_vertexSet qstar)
    u_mem_PthreeZPlusOne := htarget
    qstar := qstar
    qstar_source_eq_v := rfl
    qstar_target_eq_u := rfl
    qstar_subset_Q := hsub
    qstar_hits_block3 := hhits
    qstar_hits_PtwoZ := ?_
    qstar_hits_PthreeZPlusOne := ?_
    qstar_avoids_other_linkage := ?_
    qstar_unique_PtwoZ := ?_
    qstar_unique_PthreeZPlusOne := ?_ }
  · exact ⟨qstar.source, Finset.mem_inter.2
      ⟨GraphPath.source_mem_vertexSet qstar, hsource⟩⟩
  · exact ⟨qstar.target, Finset.mem_inter.2
      ⟨GraphPath.target_mem_vertexSet qstar, htarget⟩⟩
  · intro j hj
    have hsource_not : qstar.source ∉ (L.path j).vertexSet := by
      have hne : R.pTwoZIndex hpos ≠ j := by
        intro h
        exact hj (by
          simpa [← h] using
            pTwoZIndex_mem_typeTwoAllowedIndexSet R hpos)
      exact not_mem_linkage_path_of_mem_other (L := L) hne hsource
    have htarget_not : qstar.target ∉ (L.path j).vertexSet := by
      have hne : R.pThreeZPlusOneIndex hpos ≠ j := by
        intro h
        exact hj (by
          simpa [← h] using
            pThreeZPlusOneIndex_mem_typeTwoAllowedIndexSet R hpos)
      exact not_mem_linkage_path_of_mem_other (L := L) hne htarget
    exact disjoint_linkage_path_of_internallyDisjointFromSet
      (L := L) qstar hclean hsource_not htarget_not
  · exact inter_linkage_path_card_eq_one_source_of_internallyDisjointFromSet
      (L := L) qstar hclean hsource
      (not_mem_pTwoZIndex_of_mem_pThreeZPlusOneIndex (L := L) htarget)
  · exact inter_linkage_path_card_eq_one_target_of_internallyDisjointFromSet
      (L := L) qstar hclean
      (not_mem_pThreeZPlusOneIndex_of_mem_pTwoZIndex (L := L) hsource)
      htarget

/-- A type-1 `Q*` segment before it is packaged as `TypeOneQStarData`.
Unlike a bridge in the auxiliary graph, this segment is not clean with respect
to the whole linkage: it is supposed to meet every path in `P₁`.  The
avoidance condition is exactly the paper's one, namely avoiding every linkage
path outside `P₁ ∪ {P₀, P_{z+1}}`. -/
def HasTypeOneQStarSegment (R : IndexedAuxiliaryPrefix L h)
    (hpos : 0 < h) (Q : GraphPath G) : Prop :=
  ∃ qstar : GraphPath G,
    qstar.vertexSet ⊆ Q.vertexSet ∧
      qstar.source ∈ (L.path (R.pZPlusOneIndex hpos)).vertexSet ∧
        qstar.target ∈ (L.path R.p0Index).vertexSet ∧
          R.HitsBlock1 qstar ∧
            (∀ j : L.Index, j ∉ typeOneAllowedIndexSet R hpos →
              Disjoint qstar.vertexSet (L.path j).vertexSet) ∧
              (qstar.vertexSet ∩ (L.path R.p0Index).vertexSet).card = 1 ∧
                (qstar.vertexSet ∩
                  (L.path (R.pZPlusOneIndex hpos)).vertexSet).card = 1

/-- A type-2 `Q*` segment before it is packaged as `TypeTwoQStarData`.
It may meet all of `P₃`, but avoids every linkage path outside
`P₃ ∪ {P_{2z}, P_{3z+1}}`. -/
def HasTypeTwoQStarSegment (R : IndexedAuxiliaryPrefix L h)
    (hpos : 0 < h) (Q : GraphPath G) : Prop :=
  ∃ qstar : GraphPath G,
    qstar.vertexSet ⊆ Q.vertexSet ∧
      qstar.source ∈ (L.path (R.pTwoZIndex hpos)).vertexSet ∧
        qstar.target ∈ (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet ∧
          R.HitsBlock3 qstar ∧
            (∀ j : L.Index, j ∉ typeTwoAllowedIndexSet R hpos →
              Disjoint qstar.vertexSet (L.path j).vertexSet) ∧
              (qstar.vertexSet ∩
                (L.path (R.pTwoZIndex hpos)).vertexSet).card = 1 ∧
                (qstar.vertexSet ∩
                  (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet).card = 1

/-- Last/first-hit data for the type-1 branch of the page-59 construction.
The fields say that the last middle-boundary hit lies on `P_{z+1}`, that the
suffix from it later reaches `P_0`, and that the resulting first-hit prefix has
exactly the allowed linkage intersections. -/
structure TypeOneLastFirstWitness
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h)
    (Q : GraphPath G) where
  hmid :
    (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty
  last_mem_PzPlusOne :
    (middleBoundarySuffix (L := L) R hpos Q hmid).source ∈
      (L.path (R.pZPlusOneIndex hpos)).vertexSet
  hp0 :
    ((middleBoundarySuffix (L := L) R hpos Q hmid).vertexSet ∩
      (L.path R.p0Index).vertexSet).Nonempty
  hits_block1 :
    R.HitsBlock1 (typeOneQStarFromLastFirst (L := L) R hpos Q hmid hp0)
  avoids_other_linkage :
    ∀ j : L.Index, j ∉ typeOneAllowedIndexSet R hpos →
      Disjoint
        (typeOneQStarFromLastFirst (L := L) R hpos Q hmid hp0).vertexSet
        (L.path j).vertexSet

/-- Last/first-hit data for the type-2 branch. -/
structure TypeTwoLastFirstWitness
