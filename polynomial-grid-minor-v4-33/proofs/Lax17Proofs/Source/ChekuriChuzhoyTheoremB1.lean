/-- Simplifying action outcome that carries the full paper invariant through the
nonterminating branch. -/
def ExtendedFutureCleanSimplifyingActionOutcome
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0) : Prop :=
  (∃ L'' : PerfectPathPacking G A B,
    linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount I.linkage) ∨
    ∃ I' : IterationInput R hpos Q0,
      Nonempty (TypeOneExtendedFutureCleanIterationInvariants I') ∧
        TildeEdgeDescent I' I

/-- Finite descent for the bump/cross loop while carrying the paper invariant
that includes future-clean segments. -/
theorem exists_terminal_or_degree_drop_of_extended_future_clean_actions
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (Terminal : IterationInput R hpos Q0 → Prop)
    (hstep :
      ∀ I : IterationInput R hpos Q0,
        TypeOneExtendedFutureCleanIterationInvariants I →
          ¬ Terminal I → ExtendedFutureCleanSimplifyingActionOutcome I)
    (I₀ : IterationInput R hpos Q0)
    (Inv₀ : TypeOneExtendedFutureCleanIterationInvariants I₀) :
    ∃ I : IterationInput R hpos Q0,
      Nonempty (TypeOneExtendedFutureCleanIterationInvariants I) ∧
        (Terminal I ∨
          ∃ L'' : PerfectPathPacking G A B,
            linkageAuxDegreeTwoCount L'' <
              linkageAuxDegreeTwoCount I.linkage) := by
  classical
  let motive : IterationInput R hpos Q0 → Prop := fun I =>
    Nonempty (TypeOneExtendedFutureCleanIterationInvariants I) →
      ∃ J : IterationInput R hpos Q0,
        Nonempty (TypeOneExtendedFutureCleanIterationInvariants J) ∧
          (Terminal J ∨
            ∃ L'' : PerfectPathPacking G A B,
              linkageAuxDegreeTwoCount L'' <
                linkageAuxDegreeTwoCount J.linkage)
  have hmain : motive I₀ := by
    refine (tildeEdgeDescent_wf (R := R) (hpos := hpos)
      (Q0 := Q0)).induction (C := motive) I₀ ?_
    intro I ih InvNE
    rcases InvNE with ⟨Inv⟩
    by_cases hterm : Terminal I
    · exact ⟨I, ⟨Inv⟩, Or.inl hterm⟩
    · rcases hstep I Inv hterm with hdrop | hnext
      · exact ⟨I, ⟨Inv⟩, Or.inr hdrop⟩
      · rcases hnext with ⟨I', Inv', hlt⟩
        exact ih I' hlt Inv'
  exact hmain ⟨Inv₀⟩

/-- The nonterminating branch of the Figure 7 bump paragraph: the concrete
successor certificate together with the paper invariant it preserves.  The
successor certificate already contains the strict `H̃` edge-set descent. -/
structure BumpPaperSuccessorUpdate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Bump : BumpWitness I) where
  successor : BumpSuccessorCertificate Bump
  invariant :
    TypeOneExtendedFutureCleanIterationInvariants successor.next

namespace BumpPaperSuccessorUpdate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {Inv : TypeOneExtendedFutureCleanIterationInvariants I}
variable {Bump : BumpWitness I}

/-- The successor branch strictly decreases the maintained graph `H̃`. -/
theorem tilde_card_lt (U : BumpPaperSuccessorUpdate Inv Bump) :
    U.successor.next.tildeEdgeSet.card < I.tildeEdgeSet.card :=
  U.successor.tilde_card_lt

end BumpPaperSuccessorUpdate

/-- Paper-level statement of the Figure 7 bump action.

This packages the two branches described in the proof.  In the degree-drop
branch the algorithm stops.  In the nonterminating branch the successor rows
again satisfy the extended degree-two-path invariant, fixed `Q₀` contacts and
future-cleanliness survive, and `H̃` strictly loses an edge. -/
structure BumpPaperActionUpdate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Bump : BumpWitness I) where
  degree_drop_or_successor :
    (∃ L'' : PerfectPathPacking G A B,
      linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount I.linkage) ∨
      Nonempty (BumpPaperSuccessorUpdate Inv Bump)

namespace BumpPaperActionUpdate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {Inv : TypeOneExtendedFutureCleanIterationInvariants I}
variable {Bump : BumpWitness I}

/-- Forget the paper-invariant fields down to the older bump action
certificate. -/
def toActionCertificate
    (U : BumpPaperActionUpdate Inv Bump) :
    BumpActionCertificate Bump where
  degree_drop := by
    rcases U.degree_drop_or_successor with hdrop | hsucc
    · exact Or.inl hdrop
    · rcases hsucc with ⟨S⟩
      exact Or.inr ⟨S.successor⟩

/-- The paper-level bump update gives the boundary-aware action outcome. -/
theorem extendedFullInvariantSimplifyingActionOutcome
    (U : BumpPaperActionUpdate Inv Bump) :
    ExtendedFullInvariantSimplifyingActionOutcome I := by
  rcases U.degree_drop_or_successor with hdrop | hsucc
  · exact Or.inl hdrop
  · rcases hsucc with ⟨S⟩
    exact Or.inr
      ⟨S.successor.next, ⟨S.invariant.extended⟩,
        S.successor.tilde_card_lt⟩

/-- The paper-level bump update gives the stronger outcome that keeps
future-cleanliness available for subsequent bump/cross candidates. -/
theorem extendedFutureCleanSimplifyingActionOutcome
    (U : BumpPaperActionUpdate Inv Bump) :
    ExtendedFutureCleanSimplifyingActionOutcome I := by
  rcases U.degree_drop_or_successor with hdrop | hsucc
  · exact Or.inl hdrop
  · rcases hsucc with ⟨S⟩
    exact Or.inr
      ⟨S.successor.next, ⟨S.invariant⟩, S.successor.tilde_card_lt⟩

end BumpPaperActionUpdate

namespace BumpWitness

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable (Bump : BumpWitness I)

/-- Paper-level Figure 7 action update from the concrete local bump data.

The degree-drop branch is obtained from the finite local-support dichotomy.
In the isomorphic branch, the constructed deleted-middle successor is paired
with the expanded invariant proved from support and boundary uniqueness. -/
noncomputable def paperActionUpdate_of_supportedLocalDichotomy_constructedSuccessor_fromLocalData
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Bump.successorRowPath)
    (auxL auxA auxM auxC : I.linkage.Index)
    (hsupport :
      AdjChangeSupportedIn (linkageAuxGraph I.linkage)
        (linkageAuxGraph Bump.replacementLinkageConcrete)
        ({auxA, auxM, auxC} : Finset I.linkage.Index))
    (hLA_old : (linkageAuxGraph I.linkage).Adj auxA auxL)
    (hAM_old : (linkageAuxGraph I.linkage).Adj auxA auxM)
    (hMC_old : (linkageAuxGraph I.linkage).Adj auxM auxC)
    (hAM_new :
      (linkageAuxGraph Bump.replacementLinkageConcrete).Adj auxA auxM)
    (hMC_new :
      (linkageAuxGraph Bump.replacementLinkageConcrete).Adj auxM auxC)
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hM_old : DegreeEquals (linkageAuxGraph I.linkage) auxM 2)
    (hC_old : DegreeEquals (linkageAuxGraph I.linkage) auxC 2)
    (hLA_ne : auxL ≠ auxA) (hLM : auxL ≠ auxM)
    (hLC : auxL ≠ auxC) (hAM_ne : auxA ≠ auxM)
    (hAC : auxA ≠ auxC) (hMC_ne : auxM ≠ auxC) :
    BumpPaperActionUpdate Inv Bump := by
  classical
  let hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i) :=
    Bump.replacementPath_nodeDisjoint_unchanged_all
  let L'' : PerfectPathPacking G A B := Bump.replacementLinkage hdisj
  have hdich :
      degreeTwoVertexCount (linkageAuxGraph L'') <
          degreeTwoVertexCount (linkageAuxGraph I.linkage) ∨
        ∀ u v : I.linkage.Index,
          (linkageAuxGraph L'').Adj u v ↔
            (linkageAuxGraph I.linkage).Adj u v := by
    exact
      bump_supported_degree_drop_or_aux_adj_iff
        (H := linkageAuxGraph I.linkage) (H' := linkageAuxGraph L'')
        (L := auxL) (A := auxA) (M := auxM) (C := auxC)
        (by simpa [L'', hdisj, replacementLinkageConcrete] using hsupport)
        hLA_old hAM_old hMC_old
        (by simpa [L'', hdisj, replacementLinkageConcrete] using hAM_new)
        (by simpa [L'', hdisj, replacementLinkageConcrete] using hMC_new)
        hA_old hM_old hC_old hLA_ne hLM hLC hAM_ne hAC hMC_ne
  refine ⟨?_⟩
  rcases hdich with hdrop | hadj_iff
  · exact Or.inl ⟨L'', by
      simpa [L'', linkageAuxDegreeTwoCount] using hdrop⟩
  · let haux_prev : AuxGraphsIsomorphic I.linkage L'' :=
      auxGraphsIsomorphic_of_equiv_adj (Equiv.refl I.linkage.Index)
        (fun i j => (hadj_iff i j).symm)
    let haux_fixed : AuxGraphsIsomorphic L L'' :=
      auxGraphsIsomorphic_trans I.aux_iso_fixed_outside haux_prev
    let Succ : BumpSuccessorCertificate Bump :=
      Bump.successorCertificate_of_constructed_deleted_edge hdisj
        Inv.base.rowIndexInjective haux_fixed hq0
    let InvSucc :
        TypeOneExtendedFutureCleanIterationInvariants Succ.next :=
      Bump.successorCertificate_constructed_extendedFutureCleanIterationInvariants
        hdisj haux_fixed hq0 Inv hadj_iff
    exact Or.inr ⟨{ successor := Succ, invariant := InvSucc }⟩

