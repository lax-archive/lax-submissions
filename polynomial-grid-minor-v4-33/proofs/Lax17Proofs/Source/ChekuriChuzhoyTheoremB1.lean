theorem gridMinor_or_degree_drop_of_ordered_claimB2_B3
    (S : TypeOneIterationSetup R hpos Q)
    (hstep :
      ∀ I : IterationInput R hpos S.Q0,
        TypeOneIterationInvariants I →
          ¬ NoBumpNoCross I → InvariantSimplifyingActionOutcome I)
