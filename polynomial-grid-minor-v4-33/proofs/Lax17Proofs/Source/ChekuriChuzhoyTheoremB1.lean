/-- Path-level hill-normal certificate for post-hill terminal columns. -/
structure ClaimB3TerminalPathOrderedHillNormalCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (columns : TerminalPathColumnOrder I inv) where
  HillCandidate : Fin (z h) → Fin h → Prop
  candidate_of_nonconvex_trace :
    (∃ i : Fin (z h), ∃ j : Fin h,
      Nonempty
        (ClaimB3TerminalPathOrderedNonconvexTrace I inv columns i j)) →
      ∃ i : Fin (z h), ∃ j : Fin h, HillCandidate i j
  higher_candidate_of_candidate :
    ∀ i : Fin (z h), ∀ j : Fin h, HillCandidate i j →
      ∃ i' : Fin (z h), ∃ j' : Fin h,
        i.1 < i'.1 ∧ HillCandidate i' j'

namespace ClaimB3TerminalPathOrderedHillNormalCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}
variable {columns : TerminalPathColumnOrder I inv}

/-- Build the post-hill finite-ascent certificate from concrete current-column
hill data.

This is the terminal Claim B.3 argument in the actual post-hill language: a
non-convex row trace gives a concrete hill candidate; if no free hill remains,
that candidate has a blocker; and the blocker-barrier lemma turns the blocker
into a strictly higher hill candidate.  Finiteness of `Fin (z h)` then rules
out every non-convex trace. -/
noncomputable def of_noHill_blockerBarrier
    (candidate_of_nonconvex_trace :
      (∃ i : Fin (z h), ∃ j : Fin h,
        Nonempty
          (ClaimB3TerminalPathOrderedNonconvexTrace I inv columns i j)) →
        Nonempty (TerminalPathHillCandidateData columns))
    (no_hill : TerminalPathNoHill columns)
    (higher_data_of_blocker :
      ∀ C : TerminalPathHillCandidateData columns,
        ∀ j' : Fin h, j' ≠ C.col →
          ¬ Disjoint C.rowInterval.vertexSet
            (columns.qstar j').vertexSet →
          Nonempty (TerminalPathHigherHillFromBlockerData C j')) :
    ClaimB3TerminalPathOrderedHillNormalCertificate I inv columns where
  HillCandidate := fun i j =>
    ∃ C : TerminalPathHillCandidateData columns, C.row = i ∧ C.col = j
  candidate_of_nonconvex_trace := by
    intro hbad
    rcases candidate_of_nonconvex_trace hbad with ⟨C⟩
    exact ⟨C.row, C.col, ⟨C, rfl, rfl⟩⟩
  higher_candidate_of_candidate := by
    intro i j hCand
    rcases hCand with ⟨C, rfl, rfl⟩
    rcases no_hill.exists_blocker C with ⟨j', hj', hblock⟩
    rcases higher_data_of_blocker C j' hj' hblock with ⟨D⟩
    refine
      ⟨D.toHillCandidateData.row, D.toHillCandidateData.col,
        D.row_lt_toHillCandidateData,
        ⟨D.toHillCandidateData, rfl, rfl⟩⟩

/-- The finite-ascent proof rules out all post-hill non-convex traces. -/
theorem no_nonconvex_trace
    (C : ClaimB3TerminalPathOrderedHillNormalCertificate I inv columns) :
    ∀ i : Fin (z h), ∀ j : Fin h,
      ¬ Nonempty
        (ClaimB3TerminalPathOrderedNonconvexTrace I inv columns i j) := by
  intro i j hbad
  rcases C.candidate_of_nonconvex_trace ⟨i, j, hbad⟩ with
    ⟨i₀, j₀, hcand⟩
  exact no_ordered_fin_row_candidate_of_strictly_higher
      (Candidate := C.HillCandidate)
      C.higher_candidate_of_candidate i₀ j₀ hcand

/-- The post-hill hill-normal ascent certificate gives convex traces. -/
theorem traceConvexNormalForm
    (C : ClaimB3TerminalPathOrderedHillNormalCertificate I inv columns) :
    ClaimB3TerminalPathOrderedTraceConvexNormalForm I inv columns :=
  (claimB3TerminalPathOrderedTraceConvexNormalForm_iff_no_nonconvex_trace).2
    C.no_nonconvex_trace

/-- The post-hill hill-normal ascent certificate gives connected row/column
intersections. -/
theorem connectedIntersections
    (C : ClaimB3TerminalPathOrderedHillNormalCertificate I inv columns) :
    ClaimB3TerminalPathOrderedConnectedIntersections I inv columns :=
  ClaimB3TerminalPathOrderedConnectedIntersections.of_traceConvexNormalForm
    C.traceConvexNormalForm

end ClaimB3TerminalPathOrderedHillNormalCertificate

/-- Concrete post-hill Claim B.3 normal-form data for the actual terminal
column paths.

This package exposes the three paper-level ingredients: no free hill remains;
every non-convex row/column trace gives a hill candidate; and every blocked
candidate gives a strictly higher candidate by the no-cross barrier. -/
structure TerminalPathConcreteHillNormalData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (columns : TerminalPathColumnOrder I inv) where
  no_hill : TerminalPathNoHill columns
  candidate_of_nonconvex_trace :
    (∃ i : Fin (z h), ∃ j : Fin h,
      Nonempty
        (ClaimB3TerminalPathOrderedNonconvexTrace I inv columns i j)) →
      Nonempty (TerminalPathHillCandidateData columns)
  higher_data_of_blocker :
    ∀ C : TerminalPathHillCandidateData columns,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (columns.qstar j').vertexSet →
        Nonempty (TerminalPathHigherHillFromBlockerData C j')

namespace TerminalPathConcreteHillNormalData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}
variable {columns : TerminalPathColumnOrder I inv}

/-- Convert concrete post-hill Claim B.3 data into the finite-ascent
certificate consumed by the grid-minor assembly. -/
noncomputable def toHillNormalCertificate
    (D : TerminalPathConcreteHillNormalData I inv columns) :
    ClaimB3TerminalPathOrderedHillNormalCertificate I inv columns :=
  ClaimB3TerminalPathOrderedHillNormalCertificate.of_noHill_blockerBarrier
    D.candidate_of_nonconvex_trace D.no_hill D.higher_data_of_blocker

/-- Concrete post-hill Claim B.3 data gives connected row/column
intersections. -/
theorem connectedIntersections
    (D : TerminalPathConcreteHillNormalData I inv columns) :
    ClaimB3TerminalPathOrderedConnectedIntersections I inv columns :=
  D.toHillNormalCertificate.connectedIntersections

end TerminalPathConcreteHillNormalData

/-- Terminal data for the post-hill route stated as post-hill Claim B.2 plus
the post-hill path-level proof of Claim B.3. -/
structure TerminalPathOrderedHillTerminalData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  columns : TerminalPathColumnOrder I inv
  claimB2 : ClaimB2TerminalPathOrderedGridAdjacencies I inv columns
  claimB3 : Nonempty
    (ClaimB3TerminalPathOrderedHillNormalCertificate I inv columns)

namespace TerminalPathOrderedHillTerminalData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Convert the post-hill Claim B.2/B.3 package into terminal grid data. -/
noncomputable def toTerminalPathOrderedIntersectionGridData
    (D : TerminalPathOrderedHillTerminalData I inv) :
    TerminalPathOrderedIntersectionGridData I :=
  TerminalPathOrderedIntersectionGridData.of_claimB2_B3 inv D.columns
    D.claimB2 D.claimB3.some.connectedIntersections

/-- The post-hill Claim B.2/B.3 package directly implies the grid minor. -/
theorem containsGridMinor
    (D : TerminalPathOrderedHillTerminalData I inv) :
    ContainsGridMinor G h :=
  D.toTerminalPathOrderedIntersectionGridData.containsGridMinor

end TerminalPathOrderedHillTerminalData

/-- Terminal data whose Claim B.3 component is stated in concrete
paper-level post-hill form, rather than as an already-packaged finite-ascent
predicate. -/
structure TerminalPathConcreteHillTerminalData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  columns : TerminalPathColumnOrder I inv
  claimB2 : ClaimB2TerminalPathOrderedGridAdjacencies I inv columns
  claimB3 : TerminalPathConcreteHillNormalData I inv columns

namespace TerminalPathConcreteHillTerminalData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Convert the concrete terminal package to the existing post-hill terminal
package. -/
noncomputable def toTerminalPathOrderedHillTerminalData
    (D : TerminalPathConcreteHillTerminalData I inv) :
    TerminalPathOrderedHillTerminalData I inv where
  columns := D.columns
  claimB2 := D.claimB2
  claimB3 := ⟨D.claimB3.toHillNormalCertificate⟩

/-- The concrete post-hill terminal package gives the grid minor. -/
theorem containsGridMinor
    (D : TerminalPathConcreteHillTerminalData I inv) :
    ContainsGridMinor G h :=
