  exact Finset.disjoint_left.mp hdisj M.start_mem_qstar
    (by simpa [hEq] using B.leftAtom.stop_mem_qstar)

theorem blocker_start_ne_right_stop
    (B : ClaimB3FlexibleHillBracketAtomData inv C)
    {M : ClaimB2Atom I}
    (hM : M.qIndex = Q0.selectedColumn j')
    (hj' : j' ≠ C.col) :
    B.rightAtom.stop ≠ M.start := by
  intro hEq
  have hne : M.qIndex ≠ B.rightAtom.qIndex :=
    B.middle_right_qIndex_ne hM hj'
  have hdisj :=
    Q0.qstar_nodeDisjoint_of_ne
      (i := M.qIndex) (j := B.rightAtom.qIndex)
      (hi := M.q_mem) (hj := B.rightAtom.q_mem) hne
  exact Finset.disjoint_left.mp hdisj M.start_mem_qstar
    (by simpa [hEq] using B.rightAtom.stop_mem_qstar)

theorem top_between_of_mem_rowInterval
    (B : ClaimB3FlexibleHillBracketAtomData inv C)
    {v : V}
    (hv : v ∈ C.rowInterval.vertexSet) :
    (I.rowPath B.top).Before B.leftAtom.start v ∧
      (I.rowPath B.top).Before v B.rightAtom.start := by
  classical
  have hleft_before_v_row :
      (claimB3RowPath I inv C.row).Before C.left v :=
    (claimB3RowPath I inv C.row).before_of_mem_segmentOfBefore_left
      C.left_before_right hv
  have hv_before_right_row :
      (claimB3RowPath I inv C.row).Before v C.right :=
    (claimB3RowPath I inv C.row).before_of_mem_segmentOfBefore_right
      C.left_before_right hv
  have htop_eq : B.top = inv.orderedRows.order.symm C.row := by
    rw [← B.top_order]
    simp
  have hrowpath_eq :
      I.rowPath B.top = claimB3RowPath I inv C.row := by
    simp [claimB3RowPath, htop_eq]
  constructor
  · simpa [hrowpath_eq, B.left_start_eq] using hleft_before_v_row
  · simpa [hrowpath_eq, B.right_start_eq] using hv_before_right_row

theorem impossible_topToLower
    (S : ClaimB2PlanarStripCertificate I inv)
    (B : ClaimB3FlexibleHillBracketAtomData inv C)
    (M : ClaimB2Atom I)
    (hM_qIndex : M.qIndex = Q0.selectedColumn j')
    (hj' : j' ≠ C.col)
    (hM_top : M.rowStart = B.top)
    (hM_lower : M.rowStop = B.lowerRow)
    (hleft_middle_top :
      (I.rowPath B.top).Before B.leftAtom.start M.start)
    (hmiddle_right_top :
      (I.rowPath B.top).Before M.start B.rightAtom.start) :
    False := by
  classical
  have hLM_start_ne := B.blocker_start_ne_left_start hM_qIndex hj'
  have hMR_start_ne := B.blocker_start_ne_right_start hM_qIndex hj'
  have hML_stop_ne := B.blocker_stop_ne_left_stop hM_qIndex hj'
  have hRM_stop_ne := B.blocker_stop_ne_right_stop hM_qIndex hj'
  rcases S.lower_endpoint_between_of_top_between
      B.leftAtom M B.rightAtom B.top B.lowerRow
      B.left_top B.left_lower hM_top hM_lower B.right_top B.right_lower
      B.top_ne_lower
      (B.left_middle_qIndex_ne hM_qIndex hj')
      (B.middle_right_qIndex_ne hM_qIndex hj')
      hleft_middle_top hmiddle_right_top
      hLM_start_ne hMR_start_ne hML_stop_ne hRM_stop_ne with
    ⟨hL_mid_lower, hmid_R_lower⟩
  have hL_mem : B.leftAtom.stop ∈ (I.rowPath B.lowerRow).vertexSet := by
    simpa [B.left_lower] using B.leftAtom.stop_mem_row
  have hR_mem : B.rightAtom.stop ∈ (I.rowPath B.lowerRow).vertexSet := by
    simpa [B.right_lower] using B.rightAtom.stop_mem_row
  have hLR_lower :
      (I.rowPath B.lowerRow).Before B.leftAtom.stop B.rightAtom.stop := by
    refine ((I.rowPath B.lowerRow).before_iff_vertexIndex_le).2
      ⟨hL_mem, hR_mem, ?_⟩
    exact le_trans
      (((I.rowPath B.lowerRow).before_iff_vertexIndex_le).1
        hL_mid_lower).2.2
      (((I.rowPath B.lowerRow).before_iff_vertexIndex_le).1
        hmid_R_lower).2.2
  exact ClaimB2PlanarStripCertificate.lower_endpoint_between_contradicts_owned_lower_interval
    (I := I) B.leftAtom M B.rightAtom B.lowerRow
    (B.left_middle_qIndex_ne hM_qIndex hj')
    hLR_lower hL_mid_lower hmid_R_lower
    (B.lower_interval_subset_left_qstar hLR_lower)

theorem impossible_lowerToTop
    (S : ClaimB2PlanarStripCertificate I inv)
    (B : ClaimB3FlexibleHillBracketAtomData inv C)
    (M : ClaimB2Atom I)
    (hM_qIndex : M.qIndex = Q0.selectedColumn j')
    (hj' : j' ≠ C.col)
    (hM_lower : M.rowStart = B.lowerRow)
    (hM_top : M.rowStop = B.top)
    (hleft_middle_top :
      (I.rowPath B.top).Before B.leftAtom.start M.stop)
    (hmiddle_right_top :
      (I.rowPath B.top).Before M.stop B.rightAtom.start) :
    False := by
  classical
  exact B.impossible_topToLower S M.reverse
    (by simpa [ClaimB2Atom.reverse] using hM_qIndex)
    hj'
    (by simpa [ClaimB2Atom.reverse] using hM_top)
    (by simpa [ClaimB2Atom.reverse] using hM_lower)
    (by simpa [ClaimB2Atom.reverse] using hleft_middle_top)
    (by simpa [ClaimB2Atom.reverse] using hmiddle_right_top)

end ClaimB3FlexibleHillBracketAtomData

/-- Lower-neighbor blocker atom oriented from the candidate row down to the
lower row. -/
structure ClaimB3LowerNeighborTopToLowerAtomData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    (inv : TypeOneIterationInvariants I)
    (C : ClaimB3HillCandidateData I inv) (j' : Fin h) where
  bracket : ClaimB3HillBracketAtomData inv C
  middleAtom : ClaimB2Atom I
  middle_qIndex : middleAtom.qIndex = Q0.selectedColumn j'
  middle_top : middleAtom.rowStart = bracket.top
  middle_lower : middleAtom.rowStop = bracket.lowerRow
  left_middle_top :
    (I.rowPath bracket.top).Before bracket.leftAtom.start middleAtom.start
  middle_right_top :
    (I.rowPath bracket.top).Before middleAtom.start bracket.rightAtom.start
  left_start_ne_middle : bracket.leftAtom.start ≠ middleAtom.start
  middle_start_ne_right : middleAtom.start ≠ bracket.rightAtom.start
  middle_stop_ne_left : middleAtom.stop ≠ bracket.leftAtom.stop
  right_stop_ne_middle : bracket.rightAtom.stop ≠ middleAtom.stop

namespace ClaimB3LowerNeighborTopToLowerAtomData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}
variable {C : ClaimB3HillCandidateData I inv} {j' : Fin h}

theorem impossible
    (S : ClaimB2PlanarStripCertificate I inv)
    (D : ClaimB3LowerNeighborTopToLowerAtomData inv C j')
    (hj' : j' ≠ C.col) :
    False :=
  D.bracket.impossible_topToLower S D.middleAtom D.middle_qIndex hj'
    D.middle_top D.middle_lower
    D.left_middle_top D.middle_right_top
    D.left_start_ne_middle D.middle_start_ne_right
    D.middle_stop_ne_left D.right_stop_ne_middle

end ClaimB3LowerNeighborTopToLowerAtomData

/-- Lower-neighbor blocker atom stored from the lower row up to the candidate
row. -/
structure ClaimB3LowerNeighborLowerToTopAtomData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
