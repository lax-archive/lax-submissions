/-- The packaged type-1 setup starts with the invariant package established
for the initial iteration input. -/
noncomputable def initialInvariants (S : TypeOneIterationSetup R hpos Q) :
    TypeOneIterationInvariants S.input := by
  rw [S.input_is_initial]
  exact S.Q0.initialIterationInvariants

/-- The packaged type-1 setup starts with the full invariant package,
including the active auxiliary two-path invariant inherited from the initial
indexed prefix. -/
noncomputable def initialFullInvariants (S : TypeOneIterationSetup R hpos Q) :
    TypeOneFullIterationInvariants S.input := by
  rw [S.input_is_initial]
  exact S.Q0.initialFullIterationInvariants

/-- The packaged type-1 setup starts with the extended full invariant package,
including the active two-path and its two boundary rows. -/
noncomputable def initialExtendedFullInvariants
    (S : TypeOneIterationSetup R hpos Q) :
    TypeOneExtendedFullIterationInvariants S.input := by
  rw [S.input_is_initial]
  exact S.Q0.initialExtendedFullIterationInvariants

/-- The packaged type-1 setup starts with the expanded future-clean invariant
used in the paper-level bump/cross loop. -/
noncomputable def initialExtendedFutureCleanInvariants
    (S : TypeOneIterationSetup R hpos Q) :
    TypeOneExtendedFutureCleanIterationInvariants S.input := by
  rw [S.input_is_initial]
  exact S.Q0.initialExtendedFutureCleanIterationInvariants_of_allQ0

