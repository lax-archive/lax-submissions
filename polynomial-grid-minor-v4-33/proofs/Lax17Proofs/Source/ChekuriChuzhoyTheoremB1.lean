/-- Build the invariant-preserving one-step function from ordinary bump/cross
action certificates plus successor-invariant preservation lemmas. -/
theorem invariantSimplifyingActionOutcome_of_action_certificates
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (hbump :
      ∀ {I : IterationInput R hpos Q0} (Bump : BumpWitness I),
        BumpActionCertificate Bump)
    (hcross :
      ∀ {I : IterationInput R hpos Q0} (Cross : CrossWitness I),
        CrossActionCertificate Cross)
    (hbump_next_inv :
      ∀ {I : IterationInput R hpos Q0}
        (_Inv : TypeOneIterationInvariants I) (Bump : BumpWitness I)
        (S : BumpSuccessorCertificate Bump),
          TypeOneIterationInvariants S.next)
    (hcross_next_inv :
      ∀ {I : IterationInput R hpos Q0}
        (_Inv : TypeOneIterationInvariants I) (Cross : CrossWitness I)
        (S : CrossSuccessorCertificate Cross),
          TypeOneIterationInvariants S.next)
    (I : IterationInput R hpos Q0)
    (Inv : TypeOneIterationInvariants I)
    (hnot_terminal : ¬ NoBumpNoCross I) :
    InvariantSimplifyingActionOutcome I := by
  classical
  by_cases hb : HasBump I
  · rcases hb with ⟨B⟩
    exact (hbump B).invariantSimplifyingActionOutcome
      (fun S => hbump_next_inv Inv B S)
  · by_cases hc : HasCross I
    · rcases hc with ⟨C⟩
      exact (hcross C).invariantSimplifyingActionOutcome
        (fun S => hcross_next_inv Inv C S)
    · exact False.elim (hnot_terminal ⟨hb, hc⟩)

/-- Build the full-invariant-preserving one-step function from ordinary
bump/cross action certificates plus successor preservation of the full
invariant package. -/
theorem fullInvariantSimplifyingActionOutcome_of_action_certificates
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (hbump :
      ∀ {I : IterationInput R hpos Q0} (Bump : BumpWitness I),
        BumpActionCertificate Bump)
    (hcross :
      ∀ {I : IterationInput R hpos Q0} (Cross : CrossWitness I),
        CrossActionCertificate Cross)
    (hbump_next_inv :
      ∀ {I : IterationInput R hpos Q0}
        (_Inv : TypeOneFullIterationInvariants I) (Bump : BumpWitness I)
        (S : BumpSuccessorCertificate Bump),
          TypeOneFullIterationInvariants S.next)
    (hcross_next_inv :
      ∀ {I : IterationInput R hpos Q0}
        (_Inv : TypeOneFullIterationInvariants I) (Cross : CrossWitness I)
        (S : CrossSuccessorCertificate Cross),
          TypeOneFullIterationInvariants S.next)
    (I : IterationInput R hpos Q0)
    (Inv : TypeOneFullIterationInvariants I)
    (hnot_terminal : ¬ NoBumpNoCross I) :
    FullInvariantSimplifyingActionOutcome I := by
  classical
  by_cases hb : HasBump I
  · rcases hb with ⟨B⟩
    exact (hbump B).fullInvariantSimplifyingActionOutcome
      (fun S => hbump_next_inv Inv B S)
  · by_cases hc : HasCross I
    · rcases hc with ⟨C⟩
      exact (hcross C).fullInvariantSimplifyingActionOutcome
        (fun S => hcross_next_inv Inv C S)
    · exact False.elim (hnot_terminal ⟨hb, hc⟩)

/-- Build the boundary-aware full-invariant-preserving one-step function from
ordinary bump/cross action certificates plus successor preservation of the
extended invariant package. -/
theorem extendedFullInvariantSimplifyingActionOutcome_of_action_certificates
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (hbump :
      ∀ {I : IterationInput R hpos Q0} (Bump : BumpWitness I),
        BumpActionCertificate Bump)
    (hcross :
      ∀ {I : IterationInput R hpos Q0} (Cross : CrossWitness I),
        CrossActionCertificate Cross)
    (hbump_next_inv :
      ∀ {I : IterationInput R hpos Q0}
        (_Inv : TypeOneExtendedFullIterationInvariants I)
        (Bump : BumpWitness I)
        (S : BumpSuccessorCertificate Bump),
          TypeOneExtendedFullIterationInvariants S.next)
    (hcross_next_inv :
      ∀ {I : IterationInput R hpos Q0}
        (_Inv : TypeOneExtendedFullIterationInvariants I)
        (Cross : CrossWitness I)
        (S : CrossSuccessorCertificate Cross),
          TypeOneExtendedFullIterationInvariants S.next)
    (I : IterationInput R hpos Q0)
    (Inv : TypeOneExtendedFullIterationInvariants I)
    (hnot_terminal : ¬ NoBumpNoCross I) :
    ExtendedFullInvariantSimplifyingActionOutcome I := by
  classical
  by_cases hb : HasBump I
  · rcases hb with ⟨B⟩
    exact (hbump B).extendedFullInvariantSimplifyingActionOutcome
      (fun S => hbump_next_inv Inv B S)
  · by_cases hc : HasCross I
    · rcases hc with ⟨C⟩
      exact (hcross C).extendedFullInvariantSimplifyingActionOutcome
        (fun S => hcross_next_inv Inv C S)
    · exact False.elim (hnot_terminal ⟨hb, hc⟩)

/-- Once the terminal no-bump/no-cross branch has been proved to contain an
`h × h` grid minor, the abstract loop yields the theorem-shaped alternative:
either a grid minor is present, or some iteration produces a linkage with
fewer degree-two auxiliary vertices than the linkage at that iteration. -/
theorem gridMinor_or_local_degree_drop_of_action_certificates
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (hbump :
      ∀ {I : IterationInput R hpos Q0} (Bump : BumpWitness I),
        BumpActionCertificate Bump)
    (hcross :
      ∀ {I : IterationInput R hpos Q0} (Cross : CrossWitness I),
        CrossActionCertificate Cross)
    (hterminal :
      ∀ I : IterationInput R hpos Q0,
        NoBumpNoCross I → ContainsGridMinor G h)
    (I₀ : IterationInput R hpos Q0) :
    ContainsGridMinor G h ∨
      ∃ I : IterationInput R hpos Q0,
        ∃ L'' : PerfectPathPacking G A B,
          linkageAuxDegreeTwoCount L'' <
            linkageAuxDegreeTwoCount I.linkage := by
  rcases
    exists_noBumpNoCross_or_degree_drop_of_action_certificates
      hbump hcross I₀ with
    ⟨I, hterm | hdrop⟩
  · exact Or.inl (hterminal I hterm)
  · exact Or.inr ⟨I, hdrop⟩

/-- A degree drop found in any iteration is a degree drop relative to the
original linkage `L`, because each iteration carries an auxiliary graph
isomorphism back to `L`. -/
theorem IterationInput.degree_drop_lt_original
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    {L'' : PerfectPathPacking G A B}
    (hdrop :
      linkageAuxDegreeTwoCount L'' <
        linkageAuxDegreeTwoCount I.linkage) :
    linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount L := by
  rw [I.aux_iso_fixed_outside.degreeTwoCount_eq]
  exact hdrop

/-- The loop conclusion in the exact theorem shape, assuming the terminal
no-bump/no-cross branch has been proved to contain the desired grid minor. -/
theorem gridMinor_or_degree_drop_of_action_certificates
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (hbump :
      ∀ {I : IterationInput R hpos Q0} (Bump : BumpWitness I),
        BumpActionCertificate Bump)
    (hcross :
      ∀ {I : IterationInput R hpos Q0} (Cross : CrossWitness I),
        CrossActionCertificate Cross)
    (hterminal :
      ∀ I : IterationInput R hpos Q0,
        NoBumpNoCross I → ContainsGridMinor G h)
    (I₀ : IterationInput R hpos Q0) :
    ContainsGridMinor G h ∨
      ∃ L'' : PerfectPathPacking G A B,
        linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount L := by
  rcases
    gridMinor_or_local_degree_drop_of_action_certificates
      hbump hcross hterminal I₀ with
    hgrid | hdrop
  · exact Or.inl hgrid
  · rcases hdrop with ⟨I, L'', hlt⟩
    exact Or.inr ⟨L'', I.degree_drop_lt_original hlt⟩

/-- Invariant-aware loop conclusion in the exact theorem shape.  The terminal
proof may assume the explicit row-order/row-disjointness invariant for the
terminal state reached by the finite descent. -/
theorem gridMinor_or_degree_drop_of_invariant_actions
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (hstep :
      ∀ I : IterationInput R hpos Q0,
        TypeOneIterationInvariants I →
          ¬ NoBumpNoCross I → InvariantSimplifyingActionOutcome I)
    (hterminal :
      ∀ I : IterationInput R hpos Q0,
        TypeOneIterationInvariants I → NoBumpNoCross I →
          ContainsGridMinor G h)
    (I₀ : IterationInput R hpos Q0)
    (Inv₀ : TypeOneIterationInvariants I₀) :
    ContainsGridMinor G h ∨
      ∃ L'' : PerfectPathPacking G A B,
        linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount L := by
  rcases
    exists_noBumpNoCross_or_degree_drop_of_invariant_actions
      hstep I₀ Inv₀ with
    ⟨I, InvNE, hterm | hdrop⟩
  · rcases InvNE with ⟨Inv⟩
    exact Or.inl (hterminal I Inv hterm)
  · rcases hdrop with ⟨L'', hlt⟩
    exact Or.inr ⟨L'', I.degree_drop_lt_original hlt⟩

/-- Full-invariant loop conclusion in the exact theorem shape.  The terminal
proof receives both the row bookkeeping and the active auxiliary two-path
invariant, so terminal no-chord facts can be derived rather than supplied as
separate assumptions. -/
theorem gridMinor_or_degree_drop_of_full_invariant_actions
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (hstep :
      ∀ I : IterationInput R hpos Q0,
        TypeOneFullIterationInvariants I →
          ¬ NoBumpNoCross I → FullInvariantSimplifyingActionOutcome I)
    (hterminal :
      ∀ I : IterationInput R hpos Q0,
        TypeOneFullIterationInvariants I → NoBumpNoCross I →
          ContainsGridMinor G h)
    (I₀ : IterationInput R hpos Q0)
    (Inv₀ : TypeOneFullIterationInvariants I₀) :
    ContainsGridMinor G h ∨
      ∃ L'' : PerfectPathPacking G A B,
        linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount L := by
  rcases
    exists_terminal_or_degree_drop_of_full_invariant_actions
      (Terminal := NoBumpNoCross) hstep I₀ Inv₀ with
    ⟨I, InvNE, hterm | hdrop⟩
  · rcases InvNE with ⟨Inv⟩
    exact Or.inl (hterminal I Inv hterm)
  · rcases hdrop with ⟨L'', hlt⟩
    exact Or.inr ⟨L'', I.degree_drop_lt_original hlt⟩

/-- Boundary-aware full-invariant loop conclusion in the exact theorem shape.
