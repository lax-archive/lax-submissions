        auxA (I.rowIndex Cross.rowLeft))
    (hVD_new :
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hU_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowLeft) 2)
    (hV_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowRight) 2)
    (hD_old : DegreeEquals (linkageAuxGraph I.linkage) auxD 2)
    (hL_not :
      auxL ∉ ({auxA, I.rowIndex Cross.rowLeft,
        I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index))
    (hR_not :
      auxR ∉ ({auxA, I.rowIndex Cross.rowLeft,
        I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index))
    (hLU : auxL ≠ I.rowIndex Cross.rowLeft)
    (hRV : auxR ≠ I.rowIndex Cross.rowRight)
    (hAU_ne : auxA ≠ I.rowIndex Cross.rowLeft)
    (hAD : auxA ≠ auxD)
    (hUD : I.rowIndex Cross.rowLeft ≠ auxD)
    (hAV : auxA ≠ I.rowIndex Cross.rowRight)
    (hDV : auxD ≠ I.rowIndex Cross.rowRight)
    (hLD : auxL ≠ auxD)
    (hleftHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.leftPath)
    (hrightHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.rightPath) :
    CrossPaperActionUpdate Inv Cross :=
  Cross.paperActionUpdate_leftRight_of_localDichotomy_constructedSuccessor
    Inv auxL auxA auxD auxR hLA_old hAU_old hUV_old hVD_old hDR_old
    hAU_new hVD_new hA_old hU_old hV_old hD_old hL_not hR_not hLU hRV
    hAU_ne hAD hUD hAV hDV hLD
    (Cross.successorCurrentRowsInvariantLeftRight_of_replacement_hits
      hleftHit hrightHit)

