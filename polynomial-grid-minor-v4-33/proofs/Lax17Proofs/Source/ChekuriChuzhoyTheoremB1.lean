/-- Switched-order cross action with the successor input constructed from the
right-to-left row order.  This is the data-level counterpart of the paper's
"possibly switching them" clause.

Unlike the left-to-right wrapper, this theorem uses only the local support and
degree-test control flow.  The caller supplies the auxiliary isomorphism and
the `Q0` contact invariant for the switched successor order, exactly the two
invariants asserted in the nonterminating branch. -/
theorem actionCertificate_of_localDichotomy_rightLeftOrder_constructedSuccessor_of_deletedEdge_not_mem_Q0
    (auxA auxD : I.linkage.Index)
    (hAU_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Cross.rowLeft))
    (hUV_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight))
    (hVD_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hU_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowLeft) 2)
    (hV_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowRight) 2)
    (hD_old : DegreeEquals (linkageAuxGraph I.linkage) auxD 2)
    (hAV : auxA ≠ I.rowIndex Cross.rowRight)
    (hUD : I.rowIndex Cross.rowLeft ≠ auxD)
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathRightLeft)
    (deleted_edge : Sym2 V)
    (hdeleted :
      deleted_edge ∈ Cross.deletedLeftMiddle.edgeSet ∨
        deleted_edge ∈ Cross.deletedRightMiddle.edgeSet)
    (hQ0 : deleted_edge ∉ Q0.edgeSet) :
    CrossActionCertificate Cross := by
  classical
  let S : Finset I.linkage.Index :=
    {auxA, I.rowIndex Cross.rowLeft, I.rowIndex Cross.rowRight, auxD}
  refine
    Cross.actionCertificate_of_supportedLocalDegreeTest_conditionalSuccessor
      S
      (by
        simpa [S] using
          Cross.cross_adjChangeSupportedIn auxA auxD
            hAU_old hUV_old hVD_old hU_old hV_old hAV hUD)
      ?_ ?_
  · intro x hx
    simp [S] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · exact hA_old
    · exact hU_old
    · exact hV_old
    · exact hD_old
  · intro _hall
    refine
      { replacement := Cross.replacementPaths
        next := Cross.successorInputRightLeft haux hq0
        tilde_subset := Cross.successorInputRightLeft_tilde_subset haux hq0
        deleted_edge := deleted_edge
        deleted_edge_middle := hdeleted
        deleted_edge_new := ?_ }
    rcases hdeleted with hleft | hright
    · exact Cross.deletedLeftMiddle_edge_not_mem_successorTilde_rightLeft_of_not_mem_Q0
        haux hq0 hleft hQ0
    · exact Cross.deletedRightMiddle_edge_not_mem_successorTilde_rightLeft_of_not_mem_Q0
        haux hq0 hright hQ0

