namespace BumpActionCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {Inv : TypeOneExtendedFutureCleanIterationInvariants I}
variable {Bump : BumpWitness I}

/-- Upgrade an ordinary bump action certificate to the paper-level Figure 7
update, once every possible nonterminating successor is known to preserve the
extended future-clean invariant.

This is the formal separation used in the proof text: the local Figure 7
analysis supplies the ordinary dichotomy and strict `H̃` descent, while the
expanded invariant argument supplies the successor invariant only in the
nonterminating branch. -/
def paperActionUpdate
    (C : BumpActionCertificate Bump)
    (hsuccInv :
      ∀ S : BumpSuccessorCertificate Bump,
        TypeOneExtendedFutureCleanIterationInvariants S.next) :
    BumpPaperActionUpdate Inv Bump where
  degree_drop_or_successor := by
    rcases C.degree_drop with hdrop | hsucc
    · exact Or.inl hdrop
    · rcases hsucc with ⟨S⟩
      exact Or.inr
        ⟨{ successor := S
           invariant := hsuccInv S }⟩

end BumpActionCertificate

/-- The nonterminating branch of the Figure 8 cross paragraph.  The successor
may use either local order of the two replacement rows; that choice is already
encoded in the `CrossSuccessorCertificate`. -/
structure CrossPaperSuccessorUpdate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Cross : CrossWitness I) where
  successor : CrossSuccessorCertificate Cross
  invariant :
    TypeOneExtendedFutureCleanIterationInvariants successor.next

namespace CrossPaperSuccessorUpdate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {Inv : TypeOneExtendedFutureCleanIterationInvariants I}
variable {Cross : CrossWitness I}

/-- The successor branch strictly decreases the maintained graph `H̃`. -/
theorem tilde_card_lt (U : CrossPaperSuccessorUpdate Inv Cross) :
    U.successor.next.tildeEdgeSet.card < I.tildeEdgeSet.card :=
  U.successor.tilde_card_lt

end CrossPaperSuccessorUpdate

/-- Paper-level statement of the Figure 8 cross action.

The nonterminating branch includes the “possibly switching them” successor row
order, the survived fixed-`Q₀` contacts, the future-clean invariant, and strict
decrease of `H̃`, all through the successor update package. -/
structure CrossPaperActionUpdate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Cross : CrossWitness I) where
  degree_drop_or_successor :
    (∃ L'' : PerfectPathPacking G A B,
      linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount I.linkage) ∨
      Nonempty (CrossPaperSuccessorUpdate Inv Cross)

namespace CrossPaperActionUpdate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {Inv : TypeOneExtendedFutureCleanIterationInvariants I}
variable {Cross : CrossWitness I}

/-- Forget the paper-invariant fields down to the older cross action
certificate. -/
def toActionCertificate
    (U : CrossPaperActionUpdate Inv Cross) :
    CrossActionCertificate Cross where
  degree_drop := by
    rcases U.degree_drop_or_successor with hdrop | hsucc
    · exact Or.inl hdrop
    · rcases hsucc with ⟨S⟩
      exact Or.inr ⟨S.successor⟩

/-- The paper-level cross update gives the boundary-aware action outcome. -/
theorem extendedFullInvariantSimplifyingActionOutcome
    (U : CrossPaperActionUpdate Inv Cross) :
    ExtendedFullInvariantSimplifyingActionOutcome I := by
  rcases U.degree_drop_or_successor with hdrop | hsucc
  · exact Or.inl hdrop
  · rcases hsucc with ⟨S⟩
    exact Or.inr
      ⟨S.successor.next, ⟨S.invariant.extended⟩,
        S.successor.tilde_card_lt⟩

/-- The paper-level cross update gives the stronger outcome that keeps
future-cleanliness available for subsequent bump/cross candidates. -/
theorem extendedFutureCleanSimplifyingActionOutcome
    (U : CrossPaperActionUpdate Inv Cross) :
    ExtendedFutureCleanSimplifyingActionOutcome I := by
  rcases U.degree_drop_or_successor with hdrop | hsucc
  · exact Or.inl hdrop
  · rcases hsucc with ⟨S⟩
    exact Or.inr
      ⟨S.successor.next, ⟨S.invariant⟩, S.successor.tilde_card_lt⟩

end CrossPaperActionUpdate

namespace CrossWitness

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable (Cross : CrossWitness I)

/-- Paper-level success branch for the left-to-right cross successor, once the
local analysis has supplied the auxiliary adjacency preservation for that
successor order. -/
noncomputable def paperActionUpdate_leftRight_successor
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathLeftRight)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j) :
    CrossPaperActionUpdate Inv Cross where
  degree_drop_or_successor := by
    classical
    let deleted_edge : Sym2 V :=
      Classical.choose Cross.exists_deletedMiddle_edge_not_mem_Q0
    have hdeleted :
        deleted_edge ∈ Cross.deletedLeftMiddle.edgeSet ∨
          deleted_edge ∈ Cross.deletedRightMiddle.edgeSet :=
      (Classical.choose_spec Cross.exists_deletedMiddle_edge_not_mem_Q0).1
    have hnotQ0 : deleted_edge ∉ Q0.edgeSet :=
      (Classical.choose_spec Cross.exists_deletedMiddle_edge_not_mem_Q0).2
    have hmissing :
        deleted_edge ∉
          (Cross.successorInputLeftRight haux hq0).tildeEdgeSet := by
      rcases hdeleted with hleft | hright
      · exact Cross.deletedLeftMiddle_edge_not_mem_successorTilde_of_not_mem_Q0
          haux hq0 hleft hnotQ0
      · exact Cross.deletedRightMiddle_edge_not_mem_successorTilde_of_not_mem_Q0
          haux hq0 hright hnotQ0
    let Succ : CrossSuccessorCertificate Cross :=
      Cross.successorCertificateLeftRight_of_missing_deleted_edge haux hq0
        deleted_edge hdeleted hmissing
    let InvSucc :
        TypeOneExtendedFutureCleanIterationInvariants Succ.next :=
      Cross.successorCertificateLeftRight_extendedFutureCleanIterationInvariants_of_allQ0
        haux hq0 Inv hadj_iff deleted_edge hdeleted hmissing
    exact Or.inr ⟨{ successor := Succ, invariant := InvSucc }⟩

/-- Left-to-right cross success branch with the successor `Q₀` invariant
reduced to the two replacement-row contact survival facts. -/
noncomputable def paperActionUpdate_leftRight_successor_hitsReplacements
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hleftHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.leftPath)
    (hrightHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.rightPath)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j) :
    CrossPaperActionUpdate Inv Cross :=
  Cross.paperActionUpdate_leftRight_successor Inv haux
    (Cross.successorCurrentRowsInvariantLeftRight_of_replacement_hits
      hleftHit hrightHit)
    hadj_iff

/-- Left-to-right cross success branch from bare extended-row contact traces
for the successor order. -/
noncomputable def paperActionUpdate_leftRight_successor_traces
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (htrace :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        Nonempty
          (TypeOneBareExtendedRowContactTrace
            (h := h) I.Row Inv.base.orderedRows.order
            Cross.successorRowPathLeftRight (Q0.data i hi).qstar))
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j) :
    CrossPaperActionUpdate Inv Cross :=
  Cross.paperActionUpdate_leftRight_successor Inv haux
    (TypeOneCurrentRowsInvariant_of_bareExtendedRowContactTraces htrace)
    hadj_iff

/-- Paper-level success branch for the switched-order cross successor. -/
noncomputable def paperActionUpdate_rightLeft_successor
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathRightLeft)
    (hadj_swap :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) i)
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) j)) :
    CrossPaperActionUpdate Inv Cross where
  degree_drop_or_successor := by
    classical
    let deleted_edge : Sym2 V :=
      Classical.choose Cross.exists_deletedMiddle_edge_not_mem_Q0
    have hdeleted :
        deleted_edge ∈ Cross.deletedLeftMiddle.edgeSet ∨
          deleted_edge ∈ Cross.deletedRightMiddle.edgeSet :=
      (Classical.choose_spec Cross.exists_deletedMiddle_edge_not_mem_Q0).1
    have hnotQ0 : deleted_edge ∉ Q0.edgeSet :=
      (Classical.choose_spec Cross.exists_deletedMiddle_edge_not_mem_Q0).2
    have hmissing :
        deleted_edge ∉
          (Cross.successorInputRightLeft haux hq0).tildeEdgeSet := by
      rcases hdeleted with hleft | hright
      · exact Cross.deletedLeftMiddle_edge_not_mem_successorTilde_rightLeft_of_not_mem_Q0
          haux hq0 hleft hnotQ0
      · exact Cross.deletedRightMiddle_edge_not_mem_successorTilde_rightLeft_of_not_mem_Q0
          haux hq0 hright hnotQ0
    let Succ : CrossSuccessorCertificate Cross :=
      Cross.successorCertificateRightLeft_of_missing_deleted_edge haux hq0
        deleted_edge hdeleted hmissing
    let InvSucc :
        TypeOneExtendedFutureCleanIterationInvariants Succ.next :=
      Cross.successorCertificateRightLeft_extendedFutureCleanIterationInvariants_of_allQ0
        haux hq0 Inv hadj_swap deleted_edge hdeleted hmissing
    exact Or.inr ⟨{ successor := Succ, invariant := InvSucc }⟩

/-- Switched-order cross success branch with the successor `Q₀` invariant
reduced to the two replacement-row contact survival facts. -/
noncomputable def paperActionUpdate_rightLeft_successor_hitsReplacements
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hleftReplacementHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.leftPath)
    (hrightReplacementHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.rightPath)
    (hadj_swap :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) i)
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) j)) :
    CrossPaperActionUpdate Inv Cross :=
  Cross.paperActionUpdate_rightLeft_successor Inv haux
    (Cross.successorCurrentRowsInvariantRightLeft_of_replacement_hits
      hleftReplacementHit hrightReplacementHit)
    hadj_swap

/-- Switched-order cross success branch from bare extended-row contact traces
for the successor order. -/
noncomputable def paperActionUpdate_rightLeft_successor_traces
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (htrace :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        Nonempty
          (TypeOneBareExtendedRowContactTrace
            (h := h) I.Row Inv.base.orderedRows.order
            Cross.successorRowPathRightLeft (Q0.data i hi).qstar))
    (hadj_swap :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) i)
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) j)) :
    CrossPaperActionUpdate Inv Cross :=
  Cross.paperActionUpdate_rightLeft_successor Inv haux
    (TypeOneCurrentRowsInvariant_of_bareExtendedRowContactTraces htrace)
    hadj_swap

/-- Paper-level Figure 8 update for the switched successor order from the
minimal local degree-test data.

This is the right-to-left analogue of the left-to-right local-dichotomy
wrapper below.  It follows the control flow in the proof text: if one of the
four local successor vertices is no longer degree two, the auxiliary
degree-two count drops; otherwise the supplied switched auxiliary isomorphism,
the successor `Q₀` contact invariant, and the swapped adjacency description
produce the invariant-preserving successor branch. -/
noncomputable def paperActionUpdate_rightLeft_of_localDegreeTest_constructedSuccessor
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (auxA auxD : I.linkage.Index)
    (hAU_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Cross.rowLeft))
    (hUV_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight))
    (hVD_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hU_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowLeft) 2)
    (hV_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowRight) 2)
    (hD_old : DegreeEquals (linkageAuxGraph I.linkage) auxD 2)
    (hAV : auxA ≠ I.rowIndex Cross.rowRight)
    (hUD : I.rowIndex Cross.rowLeft ≠ auxD)
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathRightLeft)
    (hadj_swap :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) i)
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) j)) :
    CrossPaperActionUpdate Inv Cross := by
  classical
  let S : Finset I.linkage.Index :=
    {auxA, I.rowIndex Cross.rowLeft, I.rowIndex Cross.rowRight, auxD}
  let L'' : PerfectPathPacking G A B := Cross.replacementLinkageConcrete
  have hsupport :
      AdjChangeSupportedIn (linkageAuxGraph I.linkage)
        (linkageAuxGraph L'') S := by
    simpa [S, L''] using
      Cross.cross_adjChangeSupportedIn auxA auxD
        hAU_old hUV_old hVD_old hU_old hV_old hAV hUD
  have hlocal_old :
      ∀ x : I.linkage.Index, x ∈ S →
        DegreeEquals (linkageAuxGraph I.linkage) x 2 := by
    intro x hx
    simp [S] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · exact hA_old
    · exact hU_old
    · exact hV_old
    · exact hD_old
  refine ⟨?_⟩
  by_cases hall :
      ∀ x : I.linkage.Index, x ∈ S →
        DegreeEquals (linkageAuxGraph L'') x 2
  · let deleted_edge : Sym2 V :=
      Classical.choose Cross.exists_deletedMiddle_edge_not_mem_Q0
    have hdeleted :
        deleted_edge ∈ Cross.deletedLeftMiddle.edgeSet ∨
          deleted_edge ∈ Cross.deletedRightMiddle.edgeSet :=
      (Classical.choose_spec Cross.exists_deletedMiddle_edge_not_mem_Q0).1
    have hnotQ0 : deleted_edge ∉ Q0.edgeSet :=
      (Classical.choose_spec Cross.exists_deletedMiddle_edge_not_mem_Q0).2
