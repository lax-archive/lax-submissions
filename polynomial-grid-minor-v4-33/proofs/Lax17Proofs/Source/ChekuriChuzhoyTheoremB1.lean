theorem theoremB1_gridMinor_or_rerouted_linkage_of_page60PathHillProofData
    [Fintype V] {L : PerfectPathPacking G A B} {h : ℕ}
    (D : ∀ hpos : 0 < h, TheoremB1Page60PathHillProofData L h hpos)
