namespace TheoremB1Page60ActionFutureCleanPathHillProofData

variable [Fintype V] {L : PerfectPathPacking G A B} {h : ℕ} {hpos : 0 < h}

/-- Convert the split page-60 proof-data package into the paper-update
package by bundling each local action certificate with its corresponding
successor future-clean invariant proof. -/
def toPaperPathHillProofData
    (D : TheoremB1Page60ActionFutureCleanPathHillProofData L h hpos) :
    TheoremB1Page60PaperPathHillProofData L h hpos where
  hinitial := D.hinitial
  hbump := by
    intro R Q S I Inv Bump
    exact (D.hbump (R := R) (Q := Q) S (I := I) Bump).paperActionUpdate
      (fun Succ => D.hbump_next_inv (R := R) (Q := Q) S
        (I := I) Inv Bump Succ)
  hcross := by
    intro R Q S I Inv Cross
    exact (D.hcross (R := R) (Q := Q) S (I := I) Cross).paperActionUpdate
      (fun Succ => D.hcross_next_inv (R := R) (Q := Q) S
        (I := I) Inv Cross Succ)
  hterminal := D.hterminal
  hTypeTwo := D.hTypeTwo

end TheoremB1Page60ActionFutureCleanPathHillProofData

