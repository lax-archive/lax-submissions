  hp3 :
    ((middleBoundarySuffix (L := L) R hpos Q hmid).vertexSet ∩
      (L.path (R.pThreeZPlusOneIndex hpos)).vertexSet).Nonempty
  hits_block3 :
    R.HitsBlock3 (typeTwoQStarFromLastFirst (L := L) R hpos Q hmid hp3)
  avoids_other_linkage :
    ∀ j : L.Index, j ∉ typeTwoAllowedIndexSet R hpos →
      Disjoint
        (typeTwoQStarFromLastFirst (L := L) R hpos Q hmid hp3).vertexSet
        (L.path j).vertexSet

/-- The remaining data needed in the type-1 branch after the last
middle-boundary hit has been fixed and shown to lie on `P_{z+1}`. -/
structure TypeOneLastHitBranchData
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h)
    (Q : GraphPath G)
    (hmid : (Q.vertexSet ∩ middleBoundaryVertexSet (L := L) R hpos).Nonempty)
