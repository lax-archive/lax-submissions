theorem gridMinor_or_degree_drop_of_action_certificates_with_full_invariants
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (hbump :
      ∀ {I : IterationInput R hpos Q0} (Bump : BumpWitness I),
        BumpActionCertificate Bump)
    (hcross :
      ∀ {I : IterationInput R hpos Q0} (Cross : CrossWitness I),
        CrossActionCertificate Cross)
    (hbump_next_inv :
      ∀ {I : IterationInput R hpos Q0}
        (_Inv : TypeOneFullIterationInvariants I) (Bump : BumpWitness I)
        (S : BumpSuccessorCertificate Bump),
          TypeOneFullIterationInvariants S.next)
    (hcross_next_inv :
      ∀ {I : IterationInput R hpos Q0}
        (_Inv : TypeOneFullIterationInvariants I) (Cross : CrossWitness I)
        (S : CrossSuccessorCertificate Cross),
          TypeOneFullIterationInvariants S.next)
    (hterminal :
      ∀ I : IterationInput R hpos Q0,
        TypeOneFullIterationInvariants I → NoBumpNoCross I →
