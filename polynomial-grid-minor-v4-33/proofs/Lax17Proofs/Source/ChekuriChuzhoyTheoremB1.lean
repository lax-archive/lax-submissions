namespace ClaimB2TerminalPathOrderedGridAdjacencies

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}
variable {columns : TerminalColumnOrder Q0}

/-- View ordered Claim B.2 data as post-hill path-column data when the
post-hill columns are the original selected columns. -/
noncomputable def ofOrderedTerminalGridAdjacencies
    (C : ClaimB2OrderedTerminalGridAdjacencies I inv columns) :
    ClaimB2TerminalPathOrderedGridAdjacencies I inv
      (TerminalPathColumnOrder.ofTerminalColumnOrder
        (I := I) (inv := inv) columns) where
  horizontal_adj := by
    intro i j j' hcon
    simpa [TerminalPathColumnOrder.ofTerminalColumnOrder] using
      C.horizontal_adj i hcon
  vertical_adj := by
    intro i i' hcon j
    simpa [TerminalPathColumnOrder.ofTerminalColumnOrder] using
      C.vertical_adj hcon j

end ClaimB2TerminalPathOrderedGridAdjacencies

namespace ClaimB3TerminalPathOrderedHillNormalCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}
variable {columns : TerminalColumnOrder Q0}

/-- View the ordered finite-ascent proof of Claim B.3 as a post-hill
path-column proof when no hill replacement has changed the selected columns. -/
noncomputable def ofOrderedPathHillNormalCertificate
    (C : ClaimB3OrderedPathHillNormalCertificate I inv columns) :
    ClaimB3TerminalPathOrderedHillNormalCertificate I inv
      (TerminalPathColumnOrder.ofTerminalColumnOrder
        (I := I) (inv := inv) columns) where
  HillCandidate := C.HillCandidate
  candidate_of_nonconvex_trace := by
    intro hbad
    rcases hbad with ⟨i, j, hN⟩
    rcases hN with ⟨N⟩
    exact C.candidate_of_nonconvex_trace
      ⟨i, j, ⟨{
        left := N.left
        middle := N.middle
        right := N.right
        left_mem := by
          simpa [TerminalPathColumnOrder.ofTerminalColumnOrder]
            using N.left_mem
        right_mem := by
          simpa [TerminalPathColumnOrder.ofTerminalColumnOrder]
            using N.right_mem
        middle_mem_column := by
          simpa [TerminalPathColumnOrder.ofTerminalColumnOrder]
            using N.middle_mem_column
        left_before_middle := by
          simpa [TerminalPathColumnOrder.ofTerminalColumnOrder]
            using N.left_before_middle
        middle_before_right := by
          simpa [TerminalPathColumnOrder.ofTerminalColumnOrder]
            using N.middle_before_right
        middle_not_mem_row := by
          simpa [TerminalPathColumnOrder.ofTerminalColumnOrder]
            using N.middle_not_mem_row
      }⟩⟩
  higher_candidate_of_candidate := C.higher_candidate_of_candidate

end ClaimB3TerminalPathOrderedHillNormalCertificate

namespace TerminalPathOrderedHillTerminalData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- The ordered type-1 terminal package is a post-hill terminal package for
the degenerate hill-elimination run where selected columns are unchanged. -/
noncomputable def ofOrderedPathHillTerminalData
    (D : OrderedPathHillTerminalData I inv) :
    TerminalPathOrderedHillTerminalData I inv where
  columns :=
    TerminalPathColumnOrder.ofTerminalColumnOrder
      (I := I) (inv := inv) D.columns
  claimB2 :=
    ClaimB2TerminalPathOrderedGridAdjacencies.ofOrderedTerminalGridAdjacencies
      D.claimB2
  claimB3 := by
    rcases D.claimB3 with ⟨C⟩
    exact ⟨
      ClaimB3TerminalPathOrderedHillNormalCertificate.ofOrderedPathHillNormalCertificate
        C⟩

end TerminalPathOrderedHillTerminalData

/-- Hill-elimination proof data for the type-1 terminal branch.

The paper repeatedly replaces a hill by a row segment until no hill remains.
This structure packages exactly the finite-descent content of that loop:
states, a natural-number measure that strictly decreases on every
nonterminal hill replacement, and the post-hill Claim B.2/B.3 terminal data
available at any terminal state. -/
structure TerminalPathHillEliminationData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  State : Type u
  initial : State
  measure : State → ℕ
  Terminal : State → Prop
  step :
    ∀ s : State, ¬ Terminal s →
      ∃ s' : State, measure s' < measure s
  terminalData :
    ∀ s : State, Terminal s →
      TerminalPathOrderedHillTerminalData I inv

namespace TerminalPathHillEliminationData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Execute the abstract finite hill-elimination descent and return the
post-hill terminal Claim B.2/B.3 data. -/
noncomputable def toTerminalPathOrderedHillTerminalData
    (D : TerminalPathHillEliminationData I inv) :
    TerminalPathOrderedHillTerminalData I inv := by
  classical
  let H : ∃ s : D.State, D.Terminal s :=
    exists_terminal_of_nat_descent D.measure D.Terminal D.step D.initial
  exact D.terminalData (Classical.choose H) (Classical.choose_spec H)

/-- Hill-elimination data directly gives the terminal grid minor. -/
theorem containsGridMinor
    (D : TerminalPathHillEliminationData I inv) :
    ContainsGridMinor G h :=
  D.toTerminalPathOrderedHillTerminalData.containsGridMinor

/-- A completed post-hill terminal package is a degenerate hill-elimination
proof with a one-state descent system. -/
noncomputable def ofTerminalData
    (D : TerminalPathOrderedHillTerminalData I inv) :
    TerminalPathHillEliminationData I inv where
  State := PUnit
  initial := PUnit.unit
  measure := fun _ => 0
  Terminal := fun _ => True
  step := by
    intro s hterm
    exact False.elim (hterm trivial)
  terminalData := by
    intro s hterm
    exact D

end TerminalPathHillEliminationData

/-- Hill-elimination proof data whose terminal state is given in concrete
paper-level post-hill form.

This is the same natural-number descent as `TerminalPathHillEliminationData`,
but the terminal data exposes no-hill, candidate extraction, and the
blocker-to-higher-hill barrier rather than an already-packaged finite-ascent
certificate. -/
structure TerminalPathConcreteHillEliminationData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  State : Type u
  initial : State
  measure : State → ℕ
  Terminal : State → Prop
  step :
    ∀ s : State, ¬ Terminal s →
      ∃ s' : State, measure s' < measure s
  terminalData :
    ∀ s : State, Terminal s →
      TerminalPathConcreteHillTerminalData I inv

namespace TerminalPathConcreteHillEliminationData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Convert concrete hill-elimination data to the existing post-hill descent
interface. -/
noncomputable def toTerminalPathHillEliminationData
    (D : TerminalPathConcreteHillEliminationData I inv) :
    TerminalPathHillEliminationData I inv where
  State := D.State
  initial := D.initial
  measure := D.measure
  Terminal := D.Terminal
  step := D.step
  terminalData := by
    intro s hterm
    exact (D.terminalData s hterm).toTerminalPathOrderedHillTerminalData

/-- Execute the concrete terminal hill-elimination descent and return the
post-hill terminal package. -/
noncomputable def toTerminalPathOrderedHillTerminalData
    (D : TerminalPathConcreteHillEliminationData I inv) :
    TerminalPathOrderedHillTerminalData I inv :=
  D.toTerminalPathHillEliminationData.toTerminalPathOrderedHillTerminalData

/-- Concrete terminal hill elimination directly gives the grid minor. -/
theorem containsGridMinor
    (D : TerminalPathConcreteHillEliminationData I inv) :
    ContainsGridMinor G h :=
  D.toTerminalPathHillEliminationData.containsGridMinor

end TerminalPathConcreteHillEliminationData

/-! ### Symmetric type-2 ordered finite-ascent form of Claim B.3 -/

/-- Row path used in the type-2 ordered Claim B.3 terminal state. -/
noncomputable def typeTwoClaimB3RowPath
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    (I : TypeTwoIterationInput R hpos Q0)
    (inv : TypeTwoIterationInvariants I)
    (i : Fin (z h)) : GraphPath G :=
  I.rowPath (inv.orderedRows.order.symm i)

/-- Symmetric type-2 version of the ordered Claim B.3 convex trace normal
form. -/
def TypeTwoClaimB3OrderedTraceConvexNormalForm
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    (I : TypeTwoIterationInput R hpos Q0)
    (inv : TypeTwoIterationInvariants I)
    (columns : TypeTwoTerminalColumnOrder Q0) : Prop :=
  ∀ i : Fin (z h), ∀ j : Fin h,
    GraphPathTraceConvex (columns.qstar j)
      (typeTwoClaimB3RowPath I inv i).vertexSet

namespace TypeTwoClaimB3OrderedConnectedIntersections

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeTwoQStarFamily R hpos Q}
variable {I : TypeTwoIterationInput R hpos Q0}
variable {inv : TypeTwoIterationInvariants I}
variable {columns : TypeTwoTerminalColumnOrder Q0}

/-- Type-2 ordered Claim B.3 from the convex trace normal form. -/
theorem of_traceConvexNormalForm
    (H : TypeTwoClaimB3OrderedTraceConvexNormalForm I inv columns) :
    TypeTwoClaimB3OrderedConnectedIntersections I inv columns where
  branch_connected := by
    intro i j
    have hne_row_col :=
      columns.currentRow_inter_nonempty I inv.orderedRows i j
    have hne_col_row :
        (((columns.qstar j).vertexSet) ∩
          (typeTwoClaimB3RowPath I inv i).vertexSet).Nonempty := by
      rcases hne_row_col with ⟨v, hv⟩
      exact ⟨v, by
        simpa [typeTwoClaimB3RowPath, Finset.mem_inter, and_comm] using hv⟩
    have htrace :
        (columns.qstar j).TraceOn
          (typeTwoClaimB3RowPath I inv i).vertexSet :=
      graphPath_traceOn_of_traceConvex hne_col_row (H i j)
    let P : GraphPath G := Classical.choose htrace
    have hP : P.vertexSet =
        (columns.qstar j).vertexSet ∩
          (typeTwoClaimB3RowPath I inv i).vertexSet := by
      simpa [P] using Classical.choose_spec htrace
    have hset :
        (↑P.vertexSet : Set V) =
          {v : V |
            v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
              ((columns.qstar j).vertexSet)} := by
      ext v
      simp [hP, typeTwoClaimB3RowPath, Finset.mem_inter, and_comm]
    change
      (G.induce
        {v : V |
          v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
            ((columns.qstar j).vertexSet)}).Connected
    rw [← hset]
    exact GraphPath.connected_induce_vertexSet P

end TypeTwoClaimB3OrderedConnectedIntersections

/-- Ordered non-convex trace witness in the symmetric type-2 terminal branch. -/
structure TypeTwoClaimB3OrderedNonconvexTrace
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    (I : TypeTwoIterationInput R hpos Q0)
    (inv : TypeTwoIterationInvariants I)
    (columns : TypeTwoTerminalColumnOrder Q0)
    (row : Fin (z h)) (col : Fin h) where
  left : V
  middle : V
  right : V
  left_mem :
    left ∈ (columns.qstar col).vertexSet ∩
      (typeTwoClaimB3RowPath I inv row).vertexSet
  right_mem :
    right ∈ (columns.qstar col).vertexSet ∩
      (typeTwoClaimB3RowPath I inv row).vertexSet
  middle_mem_column : middle ∈ (columns.qstar col).vertexSet
  left_before_middle :
    (columns.qstar col).Before left middle
  middle_before_right :
    (columns.qstar col).Before middle right
  middle_not_mem_row :
    middle ∉ (typeTwoClaimB3RowPath I inv row).vertexSet

/-- Type-2 ordered convex trace normal form is equivalent to absence of
ordered non-convex traces. -/
theorem typeTwoClaimB3OrderedTraceConvexNormalForm_iff_no_nonconvex_trace
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    {I : TypeTwoIterationInput R hpos Q0}
    {inv : TypeTwoIterationInvariants I}
    {columns : TypeTwoTerminalColumnOrder Q0} :
    TypeTwoClaimB3OrderedTraceConvexNormalForm I inv columns ↔
      ∀ i : Fin (z h), ∀ j : Fin h,
        ¬ Nonempty (TypeTwoClaimB3OrderedNonconvexTrace I inv columns i j) := by
  constructor
  · intro H i j hbad
    rcases hbad with ⟨N⟩
    exact N.middle_not_mem_row
      (H i j N.left_mem N.right_mem N.middle_mem_column
        N.left_before_middle N.middle_before_right)
  · intro H i j a b c ha hc hb hab hbc
    by_contra hbrow
    exact H i j ⟨{
      left := a
      middle := b
      right := c
      left_mem := ha
      right_mem := hc
      middle_mem_column := hb
      left_before_middle := hab
      middle_before_right := hbc
      middle_not_mem_row := hbrow
    }⟩

/-- Type-2 ordered path-level hill-normal certificate for Claim B.3. -/
structure TypeTwoClaimB3OrderedPathHillNormalCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    (I : TypeTwoIterationInput R hpos Q0)
    (inv : TypeTwoIterationInvariants I)
    (columns : TypeTwoTerminalColumnOrder Q0) where
  HillCandidate : Fin (z h) → Fin h → Prop
  candidate_of_nonconvex_trace :
    (∃ i : Fin (z h), ∃ j : Fin h,
      Nonempty (TypeTwoClaimB3OrderedNonconvexTrace I inv columns i j)) →
      ∃ i : Fin (z h), ∃ j : Fin h, HillCandidate i j
  higher_candidate_of_candidate :
    ∀ i : Fin (z h), ∀ j : Fin h, HillCandidate i j →
      ∃ i' : Fin (z h), ∃ j' : Fin h,
        i.1 < i'.1 ∧ HillCandidate i' j'

namespace TypeTwoClaimB3OrderedPathHillNormalCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeTwoQStarFamily R hpos Q}
variable {I : TypeTwoIterationInput R hpos Q0}
variable {inv : TypeTwoIterationInvariants I}
variable {columns : TypeTwoTerminalColumnOrder Q0}

/-- The type-2 finite-ascent certificate rules out all ordered non-convex
traces. -/
theorem no_nonconvex_trace
    (C : TypeTwoClaimB3OrderedPathHillNormalCertificate I inv columns) :
    ∀ i : Fin (z h), ∀ j : Fin h,
      ¬ Nonempty (TypeTwoClaimB3OrderedNonconvexTrace I inv columns i j) := by
  intro i j hbad
  rcases C.candidate_of_nonconvex_trace ⟨i, j, hbad⟩ with
    ⟨i₀, j₀, hcand⟩
  exact no_ordered_fin_row_candidate_of_strictly_higher
    (Candidate := C.HillCandidate)
    C.higher_candidate_of_candidate i₀ j₀ hcand

/-- The type-2 hill-normal ascent certificate gives convex row traces. -/
theorem traceConvexNormalForm
    (C : TypeTwoClaimB3OrderedPathHillNormalCertificate I inv columns) :
    TypeTwoClaimB3OrderedTraceConvexNormalForm I inv columns :=
  (typeTwoClaimB3OrderedTraceConvexNormalForm_iff_no_nonconvex_trace).2
    C.no_nonconvex_trace

/-- The type-2 hill-normal ascent certificate gives connected intersections. -/
theorem connectedIntersections
    (C : TypeTwoClaimB3OrderedPathHillNormalCertificate I inv columns) :
    TypeTwoClaimB3OrderedConnectedIntersections I inv columns :=
  TypeTwoClaimB3OrderedConnectedIntersections.of_traceConvexNormalForm
    C.traceConvexNormalForm

end TypeTwoClaimB3OrderedPathHillNormalCertificate

namespace TypeTwoTerminalOrderedIntersectionCoreData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeTwoQStarFamily R hpos Q}
variable {I : TypeTwoIterationInput R hpos Q0}

/-- Bundle type-2 ordered Claim B.2 with the type-2 ordered convex trace normal
form from hill elimination. -/
def of_claimB2_traceConvex
    (inv : TypeTwoIterationInvariants I)
    (columns : TypeTwoTerminalColumnOrder Q0)
    (claimB2 : TypeTwoClaimB2OrderedTerminalGridAdjacencies I inv columns)
    (claimB3 :
      TypeTwoClaimB3OrderedTraceConvexNormalForm I inv columns) :
    TypeTwoTerminalOrderedIntersectionCoreData I :=
  of_claimB2_B3 inv columns claimB2
    (TypeTwoClaimB3OrderedConnectedIntersections.of_traceConvexNormalForm claimB3)

/-- Bundle type-2 ordered Claim B.2 with the finite-ascent proof of type-2
ordered Claim B.3. -/
def of_claimB2_pathHillNormalCertificate
    (inv : TypeTwoIterationInvariants I)
    (columns : TypeTwoTerminalColumnOrder Q0)
    (claimB2 : TypeTwoClaimB2OrderedTerminalGridAdjacencies I inv columns)
    (claimB3 :
      TypeTwoClaimB3OrderedPathHillNormalCertificate I inv columns) :
    TypeTwoTerminalOrderedIntersectionCoreData I :=
  of_claimB2_traceConvex inv columns claimB2
    claimB3.traceConvexNormalForm

end TypeTwoTerminalOrderedIntersectionCoreData

/-- Type-2 terminal proof data stated as ordered Claim B.2 plus the ordered
path-hill-normal proof of Claim B.3.  This is a `Type`-level package because it
is consumed to construct the terminal grid-minor model. -/
structure TypeTwoOrderedPathHillTerminalData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    (I : TypeTwoIterationInput R hpos Q0)
    (inv : TypeTwoIterationInvariants I) where
  columns : TypeTwoTerminalColumnOrder Q0
  claimB2 : TypeTwoClaimB2OrderedTerminalGridAdjacencies I inv columns
  claimB3 : Nonempty
    (TypeTwoClaimB3OrderedPathHillNormalCertificate I inv columns)

namespace TypeTwoOrderedPathHillTerminalData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeTwoQStarFamily R hpos Q}
variable {I : TypeTwoIterationInput R hpos Q0}
variable {inv : TypeTwoIterationInvariants I}

/-- Convert the concrete type-2 ordered path-hill terminal package into the
terminal intersection core data used by the grid model. -/
noncomputable def toTerminalOrderedIntersectionCoreData
    (D : TypeTwoOrderedPathHillTerminalData I inv) :
    TypeTwoTerminalOrderedIntersectionCoreData I :=
  TypeTwoTerminalOrderedIntersectionCoreData.of_claimB2_pathHillNormalCertificate
    inv D.columns D.claimB2 D.claimB3.some

/-- The type-2 ordered path-hill terminal package directly implies the grid
minor. -/
theorem containsGridMinor
    (D : TypeTwoOrderedPathHillTerminalData I inv) :
    ContainsGridMinor G h :=
  D.toTerminalOrderedIntersectionCoreData.containsGridMinor

end TypeTwoOrderedPathHillTerminalData

/-! ### Symmetric type-2 post-hill terminal columns -/

/-- Explicit type-2 terminal column paths after hill elimination. -/
structure TypeTwoTerminalPathColumnOrder
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    (I : TypeTwoIterationInput R hpos Q0)
    (inv : TypeTwoIterationInvariants I) where
  qstar : Fin h → GraphPath G
  qstar_nodeDisjoint :
    ∀ ⦃j k : Fin h⦄, j ≠ k → (qstar j).NodeDisjoint (qstar k)
  currentRow_inter_nonempty :
    ∀ i : Fin (z h), ∀ j : Fin h,
      (((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
        ((qstar j).vertexSet)).Nonempty

namespace TypeTwoTerminalPathColumnOrder

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeTwoQStarFamily R hpos Q}
variable {I : TypeTwoIterationInput R hpos Q0}
variable {inv : TypeTwoIterationInvariants I}

/-- The old selected-column order is a type-2 post-hill column order when no
hill replacement has changed the selected paths. -/
noncomputable def ofTerminalColumnOrder
    (C : TypeTwoTerminalColumnOrder Q0) :
    TypeTwoTerminalPathColumnOrder I inv where
  qstar := C.qstar
  qstar_nodeDisjoint := by
    intro j k hjk
    simpa [GraphPath.NodeDisjoint] using C.qstar_nodeDisjoint hjk
  currentRow_inter_nonempty := by
    intro i j
    exact C.currentRow_inter_nonempty I inv.orderedRows i j

end TypeTwoTerminalPathColumnOrder

/-- Type-2 terminal branch sets after hill elimination, using the actual
terminal column paths. -/
structure TypeTwoTerminalPathOrderedIntersectionGridData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    (I : TypeTwoIterationInput R hpos Q0) where
  inv : TypeTwoIterationInvariants I
  columns : TypeTwoTerminalPathColumnOrder I inv
  branch_connected :
    ∀ i : Fin (z h), ∀ j : Fin h,
      (G.induce {v : V |
        v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j).vertexSet)}).Connected
  horizontal_adj :
    ∀ i : Fin (z h), ∀ ⦃j j' : Fin h⦄, FinConsecutive j j' →
      ∃ u ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j).vertexSet),
        ∃ v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j').vertexSet),
          G.Adj u v
  vertical_adj :
    ∀ ⦃i i' : Fin (z h)⦄, FinConsecutive i i' → ∀ j : Fin h,
      ∃ u ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j).vertexSet),
        ∃ v ∈ ((I.rowPath (inv.orderedRows.order.symm i')).vertexSet) ∩
          ((columns.qstar j).vertexSet),
          G.Adj u v

namespace TypeTwoTerminalPathOrderedIntersectionGridData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeTwoQStarFamily R hpos Q}
variable {I : TypeTwoIterationInput R hpos Q0}

noncomputable def branch
    (D : TypeTwoTerminalPathOrderedIntersectionGridData I)
    (i : Fin (z h)) (j : Fin h) : Finset V :=
  (I.rowPath (D.inv.orderedRows.order.symm i)).vertexSet ∩
    (D.columns.qstar j).vertexSet

noncomputable def rowSet
    (D : TypeTwoTerminalPathOrderedIntersectionGridData I)
    (i : Fin (z h)) : Finset V :=
  (I.rowPath (D.inv.orderedRows.order.symm i)).vertexSet

noncomputable def colSet
    (D : TypeTwoTerminalPathOrderedIntersectionGridData I)
    (j : Fin h) : Finset V :=
  (D.columns.qstar j).vertexSet

theorem branch_nonempty
    (D : TypeTwoTerminalPathOrderedIntersectionGridData I)
    (i : Fin (z h)) (j : Fin h) :
    (D.branch i j).Nonempty :=
  D.columns.currentRow_inter_nonempty i j

theorem branch_subset_row
    (D : TypeTwoTerminalPathOrderedIntersectionGridData I)
    (i : Fin (z h)) (j : Fin h) :
    D.branch i j ⊆ D.rowSet i := by
  intro v hv
  exact (Finset.mem_inter.1 hv).1

theorem branch_subset_col
    (D : TypeTwoTerminalPathOrderedIntersectionGridData I)
    (i : Fin (z h)) (j : Fin h) :
    D.branch i j ⊆ D.colSet j := by
  intro v hv
  exact (Finset.mem_inter.1 hv).2

theorem rowSet_disjoint
    (D : TypeTwoTerminalPathOrderedIntersectionGridData I)
    ⦃i i' : Fin (z h)⦄ (hii : i ≠ i') :
    Disjoint (D.rowSet i) (D.rowSet i') := by
  classical
  have hrow_ne :
      D.inv.orderedRows.order.symm i ≠
        D.inv.orderedRows.order.symm i' := by
    intro h
    exact hii (by
      have := congrArg D.inv.orderedRows.order h
      simpa using this)
  exact D.inv.rowsNodeDisjoint hrow_ne

theorem colSet_disjoint
    (D : TypeTwoTerminalPathOrderedIntersectionGridData I)
    ⦃j j' : Fin h⦄ (hjj : j ≠ j') :
    Disjoint (D.colSet j) (D.colSet j') := by
  change Disjoint (D.columns.qstar j).vertexSet
    (D.columns.qstar j').vertexSet
  simpa [GraphPath.NodeDisjoint] using D.columns.qstar_nodeDisjoint hjj

theorem branch_disjoint
    (D : TypeTwoTerminalPathOrderedIntersectionGridData I)
    ⦃i i' : Fin (z h)⦄ ⦃j j' : Fin h⦄
    (hij : (i, j) ≠ (i', j')) :
    Disjoint (D.branch i j) (D.branch i' j') :=
  branch_disjoint_of_row_column_disjoint
    D.rowSet D.colSet D.branch D.branch_subset_row D.branch_subset_col
    (fun _ _ h => D.rowSet_disjoint h)
    (fun _ _ h => D.colSet_disjoint h) hij

noncomputable def toRectangularGridBranchModel
    (D : TypeTwoTerminalPathOrderedIntersectionGridData I) :
    RectangularGridBranchModel G (z h) h where
  branch := D.branch
  branch_nonempty := D.branch_nonempty
  branch_connected := D.branch_connected
  branch_disjoint := by
    intro i j i' j' hne
    exact D.branch_disjoint hne
  horizontal_adj := D.horizontal_adj
  vertical_adj := D.vertical_adj

theorem containsGridMinor
    (D : TypeTwoTerminalPathOrderedIntersectionGridData I) :
    ContainsGridMinor G h := by
  have hrows : h ≤ z h := by
    dsimp [z]
    omega
  exact D.toRectangularGridBranchModel.containsGridMinor_topSquare hrows

end TypeTwoTerminalPathOrderedIntersectionGridData

/-- Type-2 Claim-B.2-style terminal adjacencies for post-hill columns. -/
structure TypeTwoClaimB2TerminalPathOrderedGridAdjacencies
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    (I : TypeTwoIterationInput R hpos Q0)
    (inv : TypeTwoIterationInvariants I)
    (columns : TypeTwoTerminalPathColumnOrder I inv) where
  horizontal_adj :
    ∀ i : Fin (z h), ∀ ⦃j j' : Fin h⦄, FinConsecutive j j' →
      ∃ u ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j).vertexSet),
        ∃ v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j').vertexSet),
          G.Adj u v
  vertical_adj :
    ∀ ⦃i i' : Fin (z h)⦄, FinConsecutive i i' → ∀ j : Fin h,
      ∃ u ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j).vertexSet),
        ∃ v ∈ ((I.rowPath (inv.orderedRows.order.symm i')).vertexSet) ∩
          ((columns.qstar j).vertexSet),
          G.Adj u v

/-- Type-2 Claim-B.3-style connected intersections for post-hill columns. -/
structure TypeTwoClaimB3TerminalPathOrderedConnectedIntersections
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    (I : TypeTwoIterationInput R hpos Q0)
    (inv : TypeTwoIterationInvariants I)
    (columns : TypeTwoTerminalPathColumnOrder I inv) where
  branch_connected :
    ∀ i : Fin (z h), ∀ j : Fin h,
      (G.induce {v : V |
        v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((columns.qstar j).vertexSet)}).Connected

namespace TypeTwoTerminalPathOrderedIntersectionGridData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeTwoQStarFamily R hpos Q}
variable {I : TypeTwoIterationInput R hpos Q0}

def of_claimB2_B3
    (inv : TypeTwoIterationInvariants I)
    (columns : TypeTwoTerminalPathColumnOrder I inv)
    (claimB2 :
      TypeTwoClaimB2TerminalPathOrderedGridAdjacencies I inv columns)
    (claimB3 :
      TypeTwoClaimB3TerminalPathOrderedConnectedIntersections I inv columns) :
    TypeTwoTerminalPathOrderedIntersectionGridData I where
  inv := inv
  columns := columns
  branch_connected := claimB3.branch_connected
  horizontal_adj := claimB2.horizontal_adj
  vertical_adj := claimB2.vertical_adj

end TypeTwoTerminalPathOrderedIntersectionGridData

/-- Type-2 convex trace normal form for post-hill terminal paths. -/
def TypeTwoClaimB3TerminalPathOrderedTraceConvexNormalForm
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    (I : TypeTwoIterationInput R hpos Q0)
    (inv : TypeTwoIterationInvariants I)
    (columns : TypeTwoTerminalPathColumnOrder I inv) : Prop :=
  ∀ i : Fin (z h), ∀ j : Fin h,
    GraphPathTraceConvex (columns.qstar j)
      (typeTwoClaimB3RowPath I inv i).vertexSet

namespace TypeTwoClaimB3TerminalPathOrderedConnectedIntersections

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeTwoQStarFamily R hpos Q}
variable {I : TypeTwoIterationInput R hpos Q0}
variable {inv : TypeTwoIterationInvariants I}
variable {columns : TypeTwoTerminalPathColumnOrder I inv}

theorem of_traceConvexNormalForm
    (H : TypeTwoClaimB3TerminalPathOrderedTraceConvexNormalForm I inv columns) :
    TypeTwoClaimB3TerminalPathOrderedConnectedIntersections I inv columns where
  branch_connected := by
    intro i j
    have hne_row_col := columns.currentRow_inter_nonempty i j
    have hne_col_row :
        (((columns.qstar j).vertexSet) ∩
          (typeTwoClaimB3RowPath I inv i).vertexSet).Nonempty := by
      rcases hne_row_col with ⟨v, hv⟩
      exact ⟨v, by
        simpa [typeTwoClaimB3RowPath, Finset.mem_inter, and_comm] using hv⟩
    have htrace :
        (columns.qstar j).TraceOn
          (typeTwoClaimB3RowPath I inv i).vertexSet :=
      graphPath_traceOn_of_traceConvex hne_col_row (H i j)
    let P : GraphPath G := Classical.choose htrace
    have hP : P.vertexSet =
        (columns.qstar j).vertexSet ∩
          (typeTwoClaimB3RowPath I inv i).vertexSet := by
      simpa [P] using Classical.choose_spec htrace
    have hset :
        (↑P.vertexSet : Set V) =
          {v : V |
            v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
              ((columns.qstar j).vertexSet)} := by
      ext v
      simp [hP, typeTwoClaimB3RowPath, Finset.mem_inter, and_comm]
    change
      (G.induce
        {v : V |
          v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
            ((columns.qstar j).vertexSet)}).Connected
    rw [← hset]
    exact GraphPath.connected_induce_vertexSet P

end TypeTwoClaimB3TerminalPathOrderedConnectedIntersections

/-- Type-2 non-convex trace witness for post-hill columns. -/
structure TypeTwoClaimB3TerminalPathOrderedNonconvexTrace
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    (I : TypeTwoIterationInput R hpos Q0)
    (inv : TypeTwoIterationInvariants I)
    (columns : TypeTwoTerminalPathColumnOrder I inv)
    (row : Fin (z h)) (col : Fin h) where
  left : V
  middle : V
  right : V
  left_mem :
    left ∈ (columns.qstar col).vertexSet ∩
      (typeTwoClaimB3RowPath I inv row).vertexSet
  right_mem :
    right ∈ (columns.qstar col).vertexSet ∩
      (typeTwoClaimB3RowPath I inv row).vertexSet
  middle_mem_column : middle ∈ (columns.qstar col).vertexSet
  left_before_middle :
    (columns.qstar col).Before left middle
  middle_before_right :
    (columns.qstar col).Before middle right
  middle_not_mem_row :
    middle ∉ (typeTwoClaimB3RowPath I inv row).vertexSet

/-- Concrete type-2 hill candidate for the actual post-hill terminal columns.
-/
structure TypeTwoTerminalPathHillCandidateData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    {I : TypeTwoIterationInput R hpos Q0}
    {inv : TypeTwoIterationInvariants I}
    (columns : TypeTwoTerminalPathColumnOrder I inv) where
  row : Fin (z h)
  col : Fin h
  lower : Fin (z h)
  lower_succ : lower.1 + 1 = row.1
  left : V
  right : V
  left_mem_row : left ∈ (typeTwoClaimB3RowPath I inv row).vertexSet
  right_mem_row : right ∈ (typeTwoClaimB3RowPath I inv row).vertexSet
  left_before_right : (typeTwoClaimB3RowPath I inv row).Before left right
  segment : GraphPath G
  segment_connects : segment.Connects {left} {right}
  segment_subset_column :
    segment.vertexSet ⊆ (columns.qstar col).vertexSet
  segment_edgeSet_subset_column :
    segment.edgeSet ⊆ (columns.qstar col).edgeSet
  hits_lower : HitsGraphPath segment (typeTwoClaimB3RowPath I inv lower)
  internally_disjoint_from_other_rows :
    segment.InternallyDisjointFromSet
      (Finset.univ.biUnion fun r : Fin (z h) =>
        if r = lower then ∅ else (typeTwoClaimB3RowPath I inv r).vertexSet)

namespace TypeTwoTerminalPathHillCandidateData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeTwoQStarFamily R hpos Q}
variable {I : TypeTwoIterationInput R hpos Q0}
variable {inv : TypeTwoIterationInvariants I}
variable {columns : TypeTwoTerminalPathColumnOrder I inv}

/-- The type-2 row interval between the endpoints of a concrete hill
candidate. -/
noncomputable def rowInterval
    (C : TypeTwoTerminalPathHillCandidateData columns) : GraphPath G :=
  (typeTwoClaimB3RowPath I inv C.row).segmentOfBefore
    C.left_before_right

@[simp] theorem rowInterval_source
    (C : TypeTwoTerminalPathHillCandidateData columns) :
    C.rowInterval.source = C.left := rfl

@[simp] theorem rowInterval_target
    (C : TypeTwoTerminalPathHillCandidateData columns) :
    C.rowInterval.target = C.right := rfl

theorem row_pos (C : TypeTwoTerminalPathHillCandidateData columns) :
    0 < C.row.1 := by
  have h := C.lower_succ
  omega

theorem lower_lt_row (C : TypeTwoTerminalPathHillCandidateData columns) :
    C.lower.1 < C.row.1 := by
  have h := C.lower_succ
  omega

theorem left_mem_column
    (C : TypeTwoTerminalPathHillCandidateData columns) :
    C.left ∈ (columns.qstar C.col).vertexSet := by
  classical
  have hleft_seg : C.left ∈ C.segment.vertexSet := by
    rcases C.segment_connects with h | h
    · have hs : C.segment.source = C.left := by
        simpa using h.1
      simpa [hs] using GraphPath.source_mem_vertexSet C.segment
    · have ht : C.segment.target = C.left := by
        simpa using h.2
      simpa [ht] using GraphPath.target_mem_vertexSet C.segment
  exact C.segment_subset_column hleft_seg

theorem right_mem_column
    (C : TypeTwoTerminalPathHillCandidateData columns) :
    C.right ∈ (columns.qstar C.col).vertexSet := by
  classical
  have hright_seg : C.right ∈ C.segment.vertexSet := by
    rcases C.segment_connects with h | h
    · have ht : C.segment.target = C.right := by
        simpa using h.2
      simpa [ht] using GraphPath.target_mem_vertexSet C.segment
    · have hs : C.segment.source = C.right := by
        simpa using h.1
      simpa [hs] using GraphPath.source_mem_vertexSet C.segment
  exact C.segment_subset_column hright_seg

end TypeTwoTerminalPathHillCandidateData

/-- Type-2 post-hill hill: a concrete candidate with a row interval free of
all other current terminal columns. -/
structure TypeTwoTerminalPathHill
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    {I : TypeTwoIterationInput R hpos Q0}
    {inv : TypeTwoIterationInvariants I}
    (columns : TypeTwoTerminalPathColumnOrder I inv) where
  candidate : TypeTwoTerminalPathHillCandidateData columns
  rowInterval_free_of_other_columns :
    ∀ j' : Fin h, j' ≠ candidate.col →
      Disjoint candidate.rowInterval.vertexSet
        (columns.qstar j').vertexSet

/-- Type-2 post-hill normal form: no free hill remains. -/
def TypeTwoTerminalPathNoHill
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    {I : TypeTwoIterationInput R hpos Q0}
    {inv : TypeTwoIterationInvariants I}
    (columns : TypeTwoTerminalPathColumnOrder I inv) : Prop :=
  ¬ Nonempty (TypeTwoTerminalPathHill columns)

namespace TypeTwoTerminalPathNoHill

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeTwoQStarFamily R hpos Q}
variable {I : TypeTwoIterationInput R hpos Q0}
variable {inv : TypeTwoIterationInvariants I}
variable {columns : TypeTwoTerminalPathColumnOrder I inv}

/-- If no type-2 hill remains, every candidate has a blocker column. -/
theorem exists_blocker (hno : TypeTwoTerminalPathNoHill columns)
    (C : TypeTwoTerminalPathHillCandidateData columns) :
    ∃ j' : Fin h, j' ≠ C.col ∧
      ¬ Disjoint C.rowInterval.vertexSet (columns.qstar j').vertexSet := by
  classical
  by_contra hblock
  apply hno
  refine ⟨{
    candidate := C
    rowInterval_free_of_other_columns := ?_
  }⟩
  intro j' hj'
  by_contra hdisj
  exact hblock ⟨j', hj', hdisj⟩

/-- Vertex form of the type-2 post-hill blocker statement. -/
theorem exists_blocker_vertex (hno : TypeTwoTerminalPathNoHill columns)
    (C : TypeTwoTerminalPathHillCandidateData columns) :
    ∃ j' : Fin h, ∃ v : V,
      j' ≠ C.col ∧ v ∈ C.rowInterval.vertexSet ∧
        v ∈ (columns.qstar j').vertexSet := by
  classical
  rcases hno.exists_blocker C with ⟨j', hj', hblock⟩
  rcases (Finset.not_disjoint_iff.1 hblock) with ⟨v, hvrow, hvcol⟩
  exact ⟨j', v, hj', hvrow, hvcol⟩

end TypeTwoTerminalPathNoHill

/-- Type-2 endpoint data turning a blocker into a strictly higher hill
candidate. -/
structure TypeTwoTerminalPathHigherHillFromBlockerData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    {I : TypeTwoIterationInput R hpos Q0}
    {inv : TypeTwoIterationInvariants I}
    {columns : TypeTwoTerminalPathColumnOrder I inv}
    (C : TypeTwoTerminalPathHillCandidateData columns) (j' : Fin h) where
  upper : Fin (z h)
  upper_succ : C.row.1 + 1 = upper.1
  left : V
  right : V
  left_mem_upper : left ∈ (typeTwoClaimB3RowPath I inv upper).vertexSet
  right_mem_upper : right ∈ (typeTwoClaimB3RowPath I inv upper).vertexSet
  left_before_right : (typeTwoClaimB3RowPath I inv upper).Before left right
  segment : GraphPath G
  segment_connects : segment.Connects {left} {right}
  segment_subset_column :
    segment.vertexSet ⊆ (columns.qstar j').vertexSet
  segment_edgeSet_subset_column :
    segment.edgeSet ⊆ (columns.qstar j').edgeSet
  hits_lower : HitsGraphPath segment (typeTwoClaimB3RowPath I inv C.row)
  internally_disjoint_from_other_rows :
    segment.InternallyDisjointFromSet
      (Finset.univ.biUnion fun r : Fin (z h) =>
        if r = C.row then ∅ else (typeTwoClaimB3RowPath I inv r).vertexSet)

namespace TypeTwoTerminalPathHigherHillFromBlockerData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeTwoQStarFamily R hpos Q}
variable {I : TypeTwoIterationInput R hpos Q0}
variable {inv : TypeTwoIterationInvariants I}
variable {columns : TypeTwoTerminalPathColumnOrder I inv}
variable {C : TypeTwoTerminalPathHillCandidateData columns} {j' : Fin h}

noncomputable def toHillCandidateData
    (D : TypeTwoTerminalPathHigherHillFromBlockerData C j') :
    TypeTwoTerminalPathHillCandidateData columns where
  row := D.upper
  col := j'
  lower := C.row
  lower_succ := D.upper_succ
  left := D.left
  right := D.right
  left_mem_row := D.left_mem_upper
  right_mem_row := D.right_mem_upper
  left_before_right := D.left_before_right
  segment := D.segment
  segment_connects := D.segment_connects
  segment_subset_column := D.segment_subset_column
  segment_edgeSet_subset_column := D.segment_edgeSet_subset_column
  hits_lower := D.hits_lower
  internally_disjoint_from_other_rows := D.internally_disjoint_from_other_rows

theorem row_lt_toHillCandidateData
    (D : TypeTwoTerminalPathHigherHillFromBlockerData C j') :
    C.row.1 < (D.toHillCandidateData).row.1 := by
  dsimp [toHillCandidateData]
  have h := D.upper_succ
  omega

end TypeTwoTerminalPathHigherHillFromBlockerData

theorem typeTwoClaimB3TerminalPathOrderedTraceConvexNormalForm_iff_no_nonconvex_trace
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    {I : TypeTwoIterationInput R hpos Q0}
    {inv : TypeTwoIterationInvariants I}
    {columns : TypeTwoTerminalPathColumnOrder I inv} :
    TypeTwoClaimB3TerminalPathOrderedTraceConvexNormalForm I inv columns ↔
      ∀ i : Fin (z h), ∀ j : Fin h,
        ¬ Nonempty
          (TypeTwoClaimB3TerminalPathOrderedNonconvexTrace I inv columns i j) := by
  constructor
  · intro H i j hbad
    rcases hbad with ⟨N⟩
    exact N.middle_not_mem_row
      (H i j N.left_mem N.right_mem N.middle_mem_column
        N.left_before_middle N.middle_before_right)
  · intro H i j a b c ha hc hb hab hbc
    by_contra hbrow
    exact H i j ⟨{
      left := a
      middle := b
      right := c
      left_mem := ha
      right_mem := hc
      middle_mem_column := hb
      left_before_middle := hab
      middle_before_right := hbc
      middle_not_mem_row := hbrow
    }⟩

/-- Type-2 path-level hill-normal certificate for post-hill terminal columns.
-/
structure TypeTwoClaimB3TerminalPathOrderedHillNormalCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeTwoQStarFamily R hpos Q}
    (I : TypeTwoIterationInput R hpos Q0)
    (inv : TypeTwoIterationInvariants I)
    (columns : TypeTwoTerminalPathColumnOrder I inv) where
  HillCandidate : Fin (z h) → Fin h → Prop
  candidate_of_nonconvex_trace :
    (∃ i : Fin (z h), ∃ j : Fin h,
      Nonempty
        (TypeTwoClaimB3TerminalPathOrderedNonconvexTrace I inv columns i j)) →
      ∃ i : Fin (z h), ∃ j : Fin h, HillCandidate i j
  higher_candidate_of_candidate :
    ∀ i : Fin (z h), ∀ j : Fin h, HillCandidate i j →
      ∃ i' : Fin (z h), ∃ j' : Fin h,
        i.1 < i'.1 ∧ HillCandidate i' j'

namespace TypeTwoClaimB3TerminalPathOrderedHillNormalCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeTwoQStarFamily R hpos Q}
variable {I : TypeTwoIterationInput R hpos Q0}
variable {inv : TypeTwoIterationInvariants I}
variable {columns : TypeTwoTerminalPathColumnOrder I inv}

/-- Build the type-2 post-hill finite-ascent certificate from concrete
current-column hill data. -/
noncomputable def of_noHill_blockerBarrier
    (candidate_of_nonconvex_trace :
      (∃ i : Fin (z h), ∃ j : Fin h,
        Nonempty
          (TypeTwoClaimB3TerminalPathOrderedNonconvexTrace
            I inv columns i j)) →
        Nonempty (TypeTwoTerminalPathHillCandidateData columns))
    (no_hill : TypeTwoTerminalPathNoHill columns)
    (higher_data_of_blocker :
      ∀ C : TypeTwoTerminalPathHillCandidateData columns,
        ∀ j' : Fin h, j' ≠ C.col →
          ¬ Disjoint C.rowInterval.vertexSet
            (columns.qstar j').vertexSet →
          Nonempty (TypeTwoTerminalPathHigherHillFromBlockerData C j')) :
    TypeTwoClaimB3TerminalPathOrderedHillNormalCertificate I inv columns where
  HillCandidate := fun i j =>
    ∃ C : TypeTwoTerminalPathHillCandidateData columns, C.row = i ∧ C.col = j
  candidate_of_nonconvex_trace := by
    intro hbad
    rcases candidate_of_nonconvex_trace hbad with ⟨C⟩
    exact ⟨C.row, C.col, ⟨C, rfl, rfl⟩⟩
  higher_candidate_of_candidate := by
    intro i j hCand
    rcases hCand with ⟨C, rfl, rfl⟩
    rcases no_hill.exists_blocker C with ⟨j', hj', hblock⟩
    rcases higher_data_of_blocker C j' hj' hblock with ⟨D⟩
    refine
      ⟨D.toHillCandidateData.row, D.toHillCandidateData.col,
        D.row_lt_toHillCandidateData,
        ⟨D.toHillCandidateData, rfl, rfl⟩⟩

theorem no_nonconvex_trace
    (C : TypeTwoClaimB3TerminalPathOrderedHillNormalCertificate I inv columns) :
    ∀ i : Fin (z h), ∀ j : Fin h,
      ¬ Nonempty
        (TypeTwoClaimB3TerminalPathOrderedNonconvexTrace I inv columns i j) := by
  intro i j hbad
  rcases C.candidate_of_nonconvex_trace ⟨i, j, hbad⟩ with
    ⟨i₀, j₀, hcand⟩
  exact no_ordered_fin_row_candidate_of_strictly_higher
      (Candidate := C.HillCandidate)
      C.higher_candidate_of_candidate i₀ j₀ hcand

theorem traceConvexNormalForm
    (C : TypeTwoClaimB3TerminalPathOrderedHillNormalCertificate I inv columns) :
    TypeTwoClaimB3TerminalPathOrderedTraceConvexNormalForm I inv columns :=
  (typeTwoClaimB3TerminalPathOrderedTraceConvexNormalForm_iff_no_nonconvex_trace).2
    C.no_nonconvex_trace

theorem connectedIntersections
    (C : TypeTwoClaimB3TerminalPathOrderedHillNormalCertificate I inv columns) :
    TypeTwoClaimB3TerminalPathOrderedConnectedIntersections I inv columns :=
  TypeTwoClaimB3TerminalPathOrderedConnectedIntersections.of_traceConvexNormalForm
    C.traceConvexNormalForm

end TypeTwoClaimB3TerminalPathOrderedHillNormalCertificate

/-- Type-2 terminal data for the post-hill route stated as post-hill Claim B.2
plus the post-hill path-level proof of Claim B.3. -/
structure TypeTwoTerminalPathOrderedHillTerminalData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
