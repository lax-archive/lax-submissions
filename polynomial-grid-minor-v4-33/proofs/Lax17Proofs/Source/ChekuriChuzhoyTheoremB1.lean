    (hlt : 1 < h)
    (hbad : ¬ GoodLinkage L h) :
    ContainsGridMinor G h ∨
      ∃ L' : PerfectPathPacking G A B,
        linkageAuxDegreeTwoCount L' < linkageAuxDegreeTwoCount L := by
  have hpos : 0 < h := by omega
  exact theoremB1_gridMinor_or_rerouted_linkage_of_page60_typeOne_actions_extended_future_clean_ordered_claimB2_pathHillNormal
    (L := L) (h := h)
    (fun hp => fun {R} {Q} S => (D hp).hinitial (R := R) (Q := Q) S)
    (fun hp => fun {R} {Q} S {I} Bump =>
      (D hp).hbump (R := R) (Q := Q) S (I := I) Bump)
    (fun hp => fun {R} {Q} S {I} Cross =>
      (D hp).hcross (R := R) (Q := Q) S (I := I) Cross)
    (fun hp => fun {R} {Q} S {I} Inv Bump Succ =>
      (D hp).hbump_next_inv (R := R) (Q := Q) S (I := I)
        Inv Bump Succ)
    (fun hp => fun {R} {Q} S {I} Inv Cross Succ =>
      (D hp).hcross_next_inv (R := R) (Q := Q) S (I := I)
        Inv Cross Succ)
    (fun hp => fun {R} {Q} S I Inv hterm =>
      let T := (D hp).hterminal S I Inv hterm
