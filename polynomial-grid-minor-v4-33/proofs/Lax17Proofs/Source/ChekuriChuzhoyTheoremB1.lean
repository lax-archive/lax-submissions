/-- The two raw boundary atoms around a trace hill valley are the flexible
bracketing atoms needed by Claim B.3.

The proof splits according to the order of the two top-row contacts.  In one
case the left bracket is the atom immediately after the left raw contact and
the right bracket is the reverse of the atom immediately before the right raw
contact.  In the other case those roles are swapped.  The lower interval
ownership is exactly the raw same-row interval ownership proved for the
contacts between the two boundary atoms. -/
noncomputable def flexibleHillBracketAtomData_of_hillValley
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (j : Fin h) (Vly : (C.trace j).HillValley) :
    ClaimB3FlexibleHillBracketAtomData inv Vly.toHillCandidateData := by
  classical
  let T := C.trace j
  let rL : Fin (T.len + 1) := ⟨Vly.left.1 + 1, by
    have h : Vly.left.1 < T.len := by
      simpa [T] using Vly.left_succ_lt_len
    omega⟩
  let rR : Fin (T.len + 1) := ⟨Vly.right.1 - 1, by
    have h : Vly.right.1 < T.len + 1 := by
      simpa [T] using Vly.right.2
    omega⟩
  have hrL_row : T.row rL = Vly.rowLower := by
    simpa [T, rL] using Vly.left_succ_row
  have hrR_row : T.row rR = Vly.rowLower := by
    simpa [T, rR] using Vly.right_pred_row
  have hpq : rL.1 ≤ rR.1 := by
    simpa [rL, rR] using Vly.left_succ_le_right_pred
  have hrows :
      ∀ r : Fin (T.len + 1), rL.1 ≤ r.1 → r.1 ≤ rR.1 →
        T.row r = Vly.rowLower := by
    intro r hl hr
    exact Vly.row_eq_lower_of_internal r
      (by simpa [rL] using hl) (by simpa [rR] using hr)
  let top : I.Row := inv.orderedRows.order.symm Vly.rowTop
  let lowerRow : I.Row := inv.orderedRows.order.symm Vly.rowLower
  have htop_order : inv.orderedRows.order top = Vly.rowTop := by
    simp [top]
  have hlower_order : inv.orderedRows.order lowerRow = Vly.rowLower := by
    simp [lowerRow]
  by_cases htop_lr :
      (claimB3RowPath I inv Vly.rowTop).Before
        (T.contact Vly.left) (T.contact Vly.right)
  · let Aleft : ClaimB2Atom I :=
      C.nextRawBoundaryAtom j (by simpa [T] using Vly.left_succ_lt_len)
    let Aright : ClaimB2Atom I :=
      (C.prevRawBoundaryAtom j (by simpa [T] using Vly.right_pos)).reverse
    refine {
      top := top
      lowerRow := lowerRow
      top_order := ?_
      lower_order := ?_
      leftAtom := Aleft
      rightAtom := Aright
      left_qIndex := ?_
      right_qIndex := ?_
      left_top := ?_
      left_lower := ?_
      right_top := ?_
      right_lower := ?_
      left_start_eq := ?_
      right_start_eq := ?_
      top_ne_lower := ?_
      lower_interval_subset_left_qstar := ?_
    }
    · simpa using htop_order
    · simpa using hlower_order
    · simp [Aleft]
    · simp [Aright]
    · apply inv.orderedRows.order.injective
      have h := C.nextRawBoundaryAtom_rowStart_order j
        (r := Vly.left) (by simpa [T] using Vly.left_succ_lt_len)
      simpa [Aleft, top, T, Vly.left_row] using h
    · apply inv.orderedRows.order.injective
      have h := C.nextRawBoundaryAtom_rowStop_order j
        (r := Vly.left) (by simpa [T] using Vly.left_succ_lt_len)
      calc
        inv.orderedRows.order Aleft.rowStop =
            Vly.rowLower := by
          calc
            inv.orderedRows.order Aleft.rowStop =
                (C.trace j).row ⟨Vly.left.1 + 1, by
                  have hlt : Vly.left.1 < (C.trace j).len := by
                    simpa [T] using Vly.left_succ_lt_len
                  omega⟩ := by
                    simpa [Aleft] using h
            _ = Vly.rowLower := by
                    simpa [T, rL] using hrL_row
        _ = inv.orderedRows.order lowerRow := hlower_order.symm
    · apply inv.orderedRows.order.injective
      have h := C.prevRawBoundaryAtom_rowStop_order j
        (r := Vly.right) (by simpa [T] using Vly.right_pos)
      simpa [Aright, top, T, Vly.right_row, ClaimB2Atom.reverse] using h
    · apply inv.orderedRows.order.injective
      have h := C.prevRawBoundaryAtom_rowStart_order j
        (r := Vly.right) (by simpa [T] using Vly.right_pos)
      calc
        inv.orderedRows.order Aright.rowStop =
            Vly.rowLower := by
          calc
            inv.orderedRows.order Aright.rowStop =
                (C.trace j).row ⟨Vly.right.1 - 1, by
                  have hlt : Vly.right.1 < (C.trace j).len + 1 := by
                    simpa [T] using Vly.right.2
                  omega⟩ := by
                    simpa [Aright, ClaimB2Atom.reverse] using h
            _ = Vly.rowLower := by
                    simpa [T, rR] using hrR_row
        _ = inv.orderedRows.order lowerRow := hlower_order.symm
    · have hbefore :
          (claimB3RowPath I inv Vly.rowTop).Before
            ((C.trace j).contact Vly.left) ((C.trace j).contact Vly.right) := by
        simpa [T] using htop_lr
      rw [ClaimB3RowContactTrace.HillValley.toHillCandidateData_left_of_before
        (T := C.trace j) Vly hbefore]
      simp [Aleft]
    · have hbefore :
          (claimB3RowPath I inv Vly.rowTop).Before
            ((C.trace j).contact Vly.left) ((C.trace j).contact Vly.right) := by
        simpa [T] using htop_lr
      rw [ClaimB3RowContactTrace.HillValley.toHillCandidateData_right_of_before
        (T := C.trace j) Vly hbefore]
      simp [Aright, ClaimB2Atom.reverse]
    · intro hEq
      have hfin := congrArg inv.orderedRows.order hEq
      exact Vly.top_ne_lower (by simpa [top, lowerRow] using hfin)
    · intro hLR x hx
      have hbefore :
          (claimB3RowPath I inv Vly.rowLower).Before
            (T.contact rL) (T.contact rR) := by
        simpa [claimB3RowPath, lowerRow, Aleft, Aright, T,
          ClaimB2Atom.reverse] using hLR
      have hx' :
          x ∈ ((claimB3RowPath I inv Vly.rowLower).segmentOfBefore
            hbefore).vertexSet := by
        simpa [claimB3RowPath, lowerRow, Aleft, Aright, T,
          ClaimB2Atom.reverse] using hx
      have hsubset :=
        T.rowSegment_between_same_row_trace_interval_subset_qstar
          hpq hrows hbefore
      have hq : Aleft.qIndex = Q0.selectedColumn j := by
        simp [Aleft]
      have hset :
          (Q0.data Aleft.qIndex Aleft.q_mem).qstar.vertexSet =
            (Q0.data (Q0.selectedColumn j)
              (Q0.selectedColumn_mem_indices j)).qstar.vertexSet :=
        Q0.qstar_vertexSet_eq_of_index_eq hq
      rw [hset]
      exact hsubset hx'
  · have htop_rl :
        (claimB3RowPath I inv Vly.rowTop).Before
          (T.contact Vly.right) (T.contact Vly.left) := by
      have hleft_mem :
          T.contact Vly.left ∈
            (claimB3RowPath I inv Vly.rowTop).vertexSet := by
        simpa [T, Vly.left_row] using T.contact_mem_row Vly.left
      have hright_mem :
          T.contact Vly.right ∈
            (claimB3RowPath I inv Vly.rowTop).vertexSet := by
        simpa [T, Vly.right_row] using T.contact_mem_row Vly.right
      rcases ClaimB2Atom.graphPath_before_or_before_of_mem
          (claimB3RowPath I inv Vly.rowTop) hleft_mem hright_mem with h | h
      · exact False.elim (htop_lr h)
      · exact h
    let Aleft : ClaimB2Atom I :=
      (C.prevRawBoundaryAtom j (by simpa [T] using Vly.right_pos)).reverse
    let Aright : ClaimB2Atom I :=
      C.nextRawBoundaryAtom j (by simpa [T] using Vly.left_succ_lt_len)
    refine {
      top := top
      lowerRow := lowerRow
      top_order := ?_
      lower_order := ?_
      leftAtom := Aleft
      rightAtom := Aright
      left_qIndex := ?_
      right_qIndex := ?_
      left_top := ?_
      left_lower := ?_
      right_top := ?_
      right_lower := ?_
      left_start_eq := ?_
      right_start_eq := ?_
      top_ne_lower := ?_
      lower_interval_subset_left_qstar := ?_
    }
    · simpa using htop_order
    · simpa using hlower_order
    · simp [Aleft]
    · simp [Aright]
    · apply inv.orderedRows.order.injective
      have h := C.prevRawBoundaryAtom_rowStop_order j
        (r := Vly.right) (by simpa [T] using Vly.right_pos)
      simpa [Aleft, top, T, Vly.right_row, ClaimB2Atom.reverse] using h
    · apply inv.orderedRows.order.injective
      have h := C.prevRawBoundaryAtom_rowStart_order j
        (r := Vly.right) (by simpa [T] using Vly.right_pos)
      calc
        inv.orderedRows.order Aleft.rowStop =
            Vly.rowLower := by
          calc
            inv.orderedRows.order Aleft.rowStop =
                (C.trace j).row ⟨Vly.right.1 - 1, by
                  have hlt : Vly.right.1 < (C.trace j).len + 1 := by
                    simpa [T] using Vly.right.2
                  omega⟩ := by
                    simpa [Aleft, ClaimB2Atom.reverse] using h
            _ = Vly.rowLower := by
                    simpa [T, rR] using hrR_row
        _ = inv.orderedRows.order lowerRow := hlower_order.symm
    · apply inv.orderedRows.order.injective
      have h := C.nextRawBoundaryAtom_rowStart_order j
        (r := Vly.left) (by simpa [T] using Vly.left_succ_lt_len)
      simpa [Aright, top, T, Vly.left_row] using h
    · apply inv.orderedRows.order.injective
      have h := C.nextRawBoundaryAtom_rowStop_order j
        (r := Vly.left) (by simpa [T] using Vly.left_succ_lt_len)
      calc
        inv.orderedRows.order Aright.rowStop =
            Vly.rowLower := by
          calc
            inv.orderedRows.order Aright.rowStop =
                (C.trace j).row ⟨Vly.left.1 + 1, by
                  have hlt : Vly.left.1 < (C.trace j).len := by
                    simpa [T] using Vly.left_succ_lt_len
                  omega⟩ := by
                    simpa [Aright] using h
            _ = Vly.rowLower := by
                    simpa [T, rL] using hrL_row
        _ = inv.orderedRows.order lowerRow := hlower_order.symm
    · have hnot :
          ¬ (claimB3RowPath I inv Vly.rowTop).Before
            ((C.trace j).contact Vly.left) ((C.trace j).contact Vly.right) := by
        simpa [T] using htop_lr
      rw [ClaimB3RowContactTrace.HillValley.toHillCandidateData_left_of_not_before
        (T := C.trace j) Vly hnot]
      simp [Aleft, ClaimB2Atom.reverse]
    · have hnot :
          ¬ (claimB3RowPath I inv Vly.rowTop).Before
            ((C.trace j).contact Vly.left) ((C.trace j).contact Vly.right) := by
        simpa [T] using htop_lr
      rw [ClaimB3RowContactTrace.HillValley.toHillCandidateData_right_of_not_before
        (T := C.trace j) Vly hnot]
      simp [Aright]
    · intro hEq
      have hfin := congrArg inv.orderedRows.order hEq
      exact Vly.top_ne_lower (by simpa [top, lowerRow] using hfin)
    · intro hLR x hx
      have hbefore :
          (claimB3RowPath I inv Vly.rowLower).Before
            (T.contact rR) (T.contact rL) := by
        simpa [claimB3RowPath, lowerRow, Aleft, Aright, T,
          ClaimB2Atom.reverse] using hLR
      have hx' :
          x ∈ ((claimB3RowPath I inv Vly.rowLower).segmentOfBefore
            hbefore).vertexSet := by
        simpa [claimB3RowPath, lowerRow, Aleft, Aright, T,
          ClaimB2Atom.reverse] using hx
      have hsubset :=
        T.rowSegment_between_same_row_trace_interval_subset_qstar_rev
          hpq hrows hbefore
      have hq : Aleft.qIndex = Q0.selectedColumn j := by
        simp [Aleft, ClaimB2Atom.reverse]
      have hset :
          (Q0.data Aleft.qIndex Aleft.q_mem).qstar.vertexSet =
            (Q0.data (Q0.selectedColumn j)
              (Q0.selectedColumn_mem_indices j)).qstar.vertexSet :=
        Q0.qstar_vertexSet_eq_of_index_eq hq
      rw [hset]
      exact hsubset hx'

/-- A raw previous boundary atom whose previous contact is on the lower row
is a lower-to-top blocker atom. -/
theorem lowerNeighborAtomData_of_prevRawBoundary
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (j : Fin h) {H : ClaimB3HillCandidateData I inv}
    (Bkt : ClaimB3HillBracketAtomData inv H)
    (hj : j ≠ H.col)
    {r : Fin ((C.trace j).len + 1)} (hrpos : 0 < r.1)
    (hr_top : (C.trace j).row r = H.row)
    (hprev_lower : ((C.trace j).row ⟨r.1 - 1, by omega⟩).1 + 1 = H.row.1)
    (htop_mem : (C.prevRawBoundaryAtom j hrpos).stop ∈
      H.rowInterval.vertexSet) :
    Nonempty (ClaimB3LowerNeighborAtomData inv H j) := by
  classical
  let M : ClaimB2Atom I := C.prevRawBoundaryAtom j hrpos
  have hM_lower : M.rowStart = Bkt.lowerRow := by
    apply inv.orderedRows.order.injective
    have hstart := C.prevRawBoundaryAtom_rowStart_order j hrpos
    have hval :
        ((C.trace j).row ⟨r.1 - 1, by omega⟩).1 = H.lower.1 := by
      have hlower := H.lower_succ
      omega
    apply Fin.ext
    calc
      (inv.orderedRows.order M.rowStart).1
          = ((C.trace j).row ⟨r.1 - 1, by omega⟩).1 := by
            rw [hstart]
      _ = H.lower.1 := hval
      _ = (inv.orderedRows.order Bkt.lowerRow).1 := by
            rw [Bkt.lower_order]
  have hM_top : M.rowStop = Bkt.top := by
    apply inv.orderedRows.order.injective
    have hstop := C.prevRawBoundaryAtom_rowStop_order j hrpos
    apply Fin.ext
    calc
      (inv.orderedRows.order M.rowStop).1
          = ((C.trace j).row r).1 := by
            rw [hstop]
      _ = H.row.1 := by rw [hr_top]
      _ = (inv.orderedRows.order Bkt.top).1 := by
            rw [Bkt.top_order]
  rcases Bkt.top_between_of_mem_rowInterval htop_mem with
    ⟨hleft_mid, hmid_right⟩
  refine ⟨ClaimB3LowerNeighborAtomData.lowerToTop ?_⟩
  refine {
    bracket := Bkt
    middleAtom := M
    middle_qIndex := ?_
    middle_lower := hM_lower
    middle_top := hM_top
    left_middle_top := hleft_mid
    middle_right_top := hmid_right
    left_start_ne_middle := ?_
    middle_start_ne_right := ?_
    middle_stop_ne_left := ?_
    right_stop_ne_middle := ?_
  }
  · simp [M]
  · simpa [M] using
      Bkt.blocker_stop_ne_left_start (M := M) (j' := j) (by simp [M]) hj
  · simpa [M] using
      Bkt.blocker_stop_ne_right_start (M := M) (j' := j) (by simp [M]) hj
  · simpa [M] using
      Bkt.blocker_start_ne_left_stop (M := M) (j' := j) (by simp [M]) hj
  · simpa [M] using
      Bkt.blocker_start_ne_right_stop (M := M) (j' := j) (by simp [M]) hj

/-- A raw next boundary atom whose next contact is on the lower row is a
top-to-lower blocker atom. -/
theorem lowerNeighborAtomData_of_nextRawBoundary
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (j : Fin h) {H : ClaimB3HillCandidateData I inv}
    (Bkt : ClaimB3HillBracketAtomData inv H)
    (hj : j ≠ H.col)
    {r : Fin ((C.trace j).len + 1)} (hrlt : r.1 < (C.trace j).len)
    (hr_top : (C.trace j).row r = H.row)
    (hnext_lower : ((C.trace j).row ⟨r.1 + 1, by omega⟩).1 + 1 = H.row.1)
    (htop_mem : (C.nextRawBoundaryAtom j hrlt).start ∈
      H.rowInterval.vertexSet) :
    Nonempty (ClaimB3LowerNeighborAtomData inv H j) := by
  classical
  let M : ClaimB2Atom I := C.nextRawBoundaryAtom j hrlt
  have hM_top : M.rowStart = Bkt.top := by
    apply inv.orderedRows.order.injective
    have hstart := C.nextRawBoundaryAtom_rowStart_order j hrlt
    apply Fin.ext
    calc
      (inv.orderedRows.order M.rowStart).1
          = ((C.trace j).row r).1 := by
            rw [hstart]
      _ = H.row.1 := by rw [hr_top]
      _ = (inv.orderedRows.order Bkt.top).1 := by
            rw [Bkt.top_order]
  have hM_lower : M.rowStop = Bkt.lowerRow := by
    apply inv.orderedRows.order.injective
    have hstop := C.nextRawBoundaryAtom_rowStop_order j hrlt
    have hval :
        ((C.trace j).row ⟨r.1 + 1, by omega⟩).1 = H.lower.1 := by
      have hlower := H.lower_succ
      omega
    apply Fin.ext
    calc
      (inv.orderedRows.order M.rowStop).1
          = ((C.trace j).row ⟨r.1 + 1, by omega⟩).1 := by
            rw [hstop]
      _ = H.lower.1 := hval
      _ = (inv.orderedRows.order Bkt.lowerRow).1 := by
            rw [Bkt.lower_order]
  rcases Bkt.top_between_of_mem_rowInterval htop_mem with
    ⟨hleft_mid, hmid_right⟩
  refine ⟨ClaimB3LowerNeighborAtomData.topToLower ?_⟩
  refine {
    bracket := Bkt
    middleAtom := M
    middle_qIndex := ?_
    middle_top := hM_top
    middle_lower := hM_lower
    left_middle_top := hleft_mid
    middle_right_top := hmid_right
    left_start_ne_middle := ?_
    middle_start_ne_right := ?_
    middle_stop_ne_left := ?_
    right_stop_ne_middle := ?_
  }
  · simp [M]
  · simpa [M] using
      Bkt.blocker_start_ne_left_start (M := M) (j' := j) (by simp [M]) hj
  · simpa [M] using
      Bkt.blocker_start_ne_right_start (M := M) (j' := j) (by simp [M]) hj
  · simpa [M] using
      Bkt.blocker_stop_ne_left_stop (M := M) (j' := j) (by simp [M]) hj
  · simpa [M] using
      Bkt.blocker_stop_ne_right_stop (M := M) (j' := j) (by simp [M]) hj

/-- Flexible-bracket version of the previous-boundary lower-neighbor
contradiction.  This is the blocker entering the candidate row from the lower
row on the left side of the chosen blocker block. -/
theorem impossible_prevBoundary_lower_flexible
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (S : ClaimB2PlanarStripCertificate I inv)
    (j : Fin h) {H : ClaimB3HillCandidateData I inv}
    (Bkt : ClaimB3FlexibleHillBracketAtomData inv H)
    (hj : j ≠ H.col)
    {b : Fin ((C.blocks j).len + 1)}
    (hbpos : 0 < b.1)
    (hblock_row : (C.blocks j).blockRow b = H.row)
    (hprev_lower :
      ((C.blocks j).blockRow ⟨b.1 - 1, by omega⟩).1 + 1 = H.row.1)
    (htop_mem :
      (C.prevBoundaryAtom j hbpos).stop ∈ H.rowInterval.vertexSet) :
    False := by
  classical
  let M : ClaimB2Atom I := C.prevBoundaryAtom j hbpos
  have hM_lower : M.rowStart = Bkt.lowerRow := by
    apply inv.orderedRows.order.injective
    have hstart := C.prevBoundaryAtom_rowStart_order j hbpos
    have hval :
        ((C.blocks j).blockRow ⟨b.1 - 1, by omega⟩).1 = H.lower.1 := by
      have hlower := H.lower_succ
      omega
    apply Fin.ext
    calc
      (inv.orderedRows.order M.rowStart).1
          = ((C.blocks j).blockRow ⟨b.1 - 1, by omega⟩).1 := by
            rw [hstart]
      _ = H.lower.1 := hval
      _ = (inv.orderedRows.order Bkt.lowerRow).1 := by
            rw [Bkt.lower_order]
  have hM_top : M.rowStop = Bkt.top := by
    apply inv.orderedRows.order.injective
    have hstop := C.prevBoundaryAtom_rowStop_order j hbpos
    apply Fin.ext
    calc
      (inv.orderedRows.order M.rowStop).1
          = ((C.blocks j).blockRow b).1 := by
            rw [hstop]
      _ = H.row.1 := by rw [hblock_row]
      _ = (inv.orderedRows.order Bkt.top).1 := by
            rw [Bkt.top_order]
  rcases Bkt.top_between_of_mem_rowInterval htop_mem with
    ⟨hleft_mid, hmid_right⟩
  exact Bkt.impossible_lowerToTop S M
    (by simp [M]) hj hM_lower hM_top hleft_mid hmid_right

/-- Flexible-bracket version of the next-boundary lower-neighbor
contradiction.  This is the blocker leaving the candidate row toward the
lower row on the right side of the chosen blocker block. -/
theorem impossible_nextBoundary_lower_flexible
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (S : ClaimB2PlanarStripCertificate I inv)
    (j : Fin h) {H : ClaimB3HillCandidateData I inv}
