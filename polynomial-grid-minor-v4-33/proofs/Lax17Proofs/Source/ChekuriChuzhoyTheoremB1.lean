variable [Fintype V] {L : PerfectPathPacking G A B} {h : ℕ} {hpos : 0 < h}

/-- Rebundle the proof data where the bump paragraph is supplied by local
degree-saturation data and the cross paragraph by the current attachment
interface. -/
noncomputable def toPaperFutureCleanTerminalProofDataTypeTwoInput
    (D :
      TheoremB1Page60PaperFutureCleanTerminalProofDataTypeTwoInputByBumpLocalCrossAttachments
        L h hpos) :
    TheoremB1Page60PaperFutureCleanTerminalProofDataTypeTwoInput L h hpos where
  hbump := by
    intro R Q S I Inv Bump
    let T :=
      TypeOneExtendedFutureCleanIterationInvariants.bumpLocalTripleData
        (R := R) (hpos := hpos) (Q := Q) (Q0 := S.Q0) (I := I)
        Inv Bump
    let N :=
      TypeOneBumpLeftOutsideNeighborData.ofInvariant
        (R := R) (hpos := hpos) (Q := Q) (Q0 := S.Q0) (I := I)
        Inv Bump
    have hsupport :
        AdjChangeSupportedIn (linkageAuxGraph I.linkage)
          (linkageAuxGraph Bump.replacementLinkageConcrete)
          ({T.left, I.rowIndex Bump.row, T.right} :
              Finset I.linkage.Index) := by
      simpa [T] using
        Bump.bump_adjChangeSupportedIn T.left T.right
          T.left_adj_mid T.mid_adj_right T.mid_degree_two T.left_ne_right
    exact
      Bump.paperActionUpdate_of_supportedLocalDichotomy_constructedSuccessor_fromLocalData_hitsReplacement_autoAdj
        Inv
        (D.hbump_replacementHit S Inv Bump)
        N.auxL T.left T.right hsupport
        N.left_adj_auxL T.left_adj_mid T.mid_adj_right
        T.left_degree_two T.mid_degree_two T.right_degree_two
        N.auxL_ne_left N.auxL_ne_mid N.auxL_ne_right
        T.left_ne_mid T.left_ne_right T.mid_ne_right
  hcross := by
    intro R Q S I Inv Cross
    exact
      Cross.paperActionUpdate_of_orderedLocalDegreeTest_constructedSuccessor_byAttachments
        Inv
        (D.hcross_aux_left S Inv Cross)
        (D.hcross_adj_left S Inv Cross)
        (D.hcross_aux_right S Inv Cross)
        (D.hcross_adj_swap S Inv Cross)
        (D.hcross_leftReplacementHit S Inv Cross)
        (D.hcross_rightReplacementHit S Inv Cross)
  hterminal := D.hterminal
  hTypeTwo := D.hTypeTwo

end TheoremB1Page60PaperFutureCleanTerminalProofDataTypeTwoInputByBumpLocalCrossAttachments

