/-- Page-60 orchestration with the type-1 branch reduced to local bump/cross
action certificates and the terminal sparse-grid path/suppression certificate.
This is the theorem-shaped wrapper whose terminal hypothesis matches the paper:
after the bump/cross/hill normalization, the rows and transversals realize a
valid sparse grid by subpaths, and suppressing those subpaths gives the grid
minor. -/
theorem reroutingConclusion_of_page60_typeOne_actions_sparse_terminal
    [Fintype V] {L : PerfectPathPacking G A B} {h : ℕ}
    (hbad : ¬ GoodLinkage L h)
    (hlink : NodeLinkedIn G Finset.univ A B)
    (hpos : 0 < h)
    (hbump :
      ∀ {R : IndexedAuxiliaryPrefix L h}
        {Q : PerfectPathPacking G R.X R.Y}
        (S : TypeOneIterationSetup R hpos Q)
        {I : IterationInput R hpos S.Q0} (Bump : BumpWitness I),
          BumpActionCertificate Bump)
    (hcross :
      ∀ {R : IndexedAuxiliaryPrefix L h}
        {Q : PerfectPathPacking G R.X R.Y}
        (S : TypeOneIterationSetup R hpos Q)
        {I : IterationInput R hpos S.Q0} (Cross : CrossWitness I),
          CrossActionCertificate Cross)
    (hbump_next_inv :
      ∀ {R : IndexedAuxiliaryPrefix L h}
        {Q : PerfectPathPacking G R.X R.Y}
        (S : TypeOneIterationSetup R hpos Q)
        {I : IterationInput R hpos S.Q0}
        (_Inv : TypeOneIterationInvariants I) (Bump : BumpWitness I)
        (Succ : BumpSuccessorCertificate Bump),
          TypeOneIterationInvariants Succ.next)
    (hcross_next_inv :
      ∀ {R : IndexedAuxiliaryPrefix L h}
        {Q : PerfectPathPacking G R.X R.Y}
        (S : TypeOneIterationSetup R hpos Q)
        {I : IterationInput R hpos S.Q0}
        (_Inv : TypeOneIterationInvariants I) (Cross : CrossWitness I)
        (Succ : CrossSuccessorCertificate Cross),
          TypeOneIterationInvariants Succ.next)
    (hterminal :
      ∀ {R : IndexedAuxiliaryPrefix L h}
        {Q : PerfectPathPacking G R.X R.Y}
        (S : TypeOneIterationSetup R hpos Q)
        (I : IterationInput R hpos S.Q0)
        (_Inv : TypeOneIterationInvariants I),
          NoBumpNoCross I → TerminalSparseGridTraceCertificate I)
    (hTypeTwo :
      ∀ {R : IndexedAuxiliaryPrefix L h}
        {Q : PerfectPathPacking G R.X R.Y},
        TypeTwoIterationSetup R hpos Q → ReroutingConclusion G h L) :
    ReroutingConclusion G h L := by
  refine reroutingConclusion_of_page60_branch_handlers
    (L := L) (h := h) hbad hlink hpos ?_ hTypeTwo
  intro R Q S
  exact S.reroutingConclusion_of_action_certificates_with_sparse_terminal
    (fun Bump => hbump S Bump)
    (fun Cross => hcross S Cross)
    (fun Inv Bump Succ => hbump_next_inv S Inv Bump Succ)
    (fun Inv Cross Succ => hcross_next_inv S Inv Cross Succ)
    (fun I Inv hterm => hterminal S I Inv hterm)

