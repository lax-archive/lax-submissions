  exact Bkt.impossible_topToLower S M
    (by simp [M]) hj hM_top hM_lower hleft_mid hmid_right

/-- A previous compressed lower-neighbor boundary atom becomes the
lower-to-top blocker atom data, provided its top endpoint is the selected
maximal blocker endpoint inside the hill row interval. -/
theorem lowerNeighborAtomData_of_prevBoundary
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (j : Fin h) {H : ClaimB3HillCandidateData I inv}
    (Bkt : ClaimB3HillBracketAtomData inv H)
    (hj : j ≠ H.col)
    {b : Fin ((C.blocks j).len + 1)}
    (hbpos : 0 < b.1)
    (hblock_row : (C.blocks j).blockRow b = H.row)
    (hprev_lower :
      ((C.blocks j).blockRow ⟨b.1 - 1, by omega⟩).1 + 1 = H.row.1)
    (htop_mem :
      (C.prevBoundaryAtom j hbpos).stop ∈ H.rowInterval.vertexSet) :
    Nonempty (ClaimB3LowerNeighborAtomData inv H j) := by
  classical
  let M : ClaimB2Atom I := C.prevBoundaryAtom j hbpos
  rcases C.prevBoundaryAtom_rows_of_prev_lower j Bkt hbpos hblock_row
      hprev_lower with ⟨hM_lower, hM_top⟩
  rcases Bkt.top_between_of_mem_rowInterval htop_mem with
    ⟨hleft_mid, hmid_right⟩
  refine ⟨ClaimB3LowerNeighborAtomData.lowerToTop ?_⟩
  refine {
    bracket := Bkt
    middleAtom := M
    middle_qIndex := ?_
    middle_lower := hM_lower
    middle_top := hM_top
    left_middle_top := hleft_mid
    middle_right_top := hmid_right
    left_start_ne_middle := ?_
    middle_start_ne_right := ?_
    middle_stop_ne_left := ?_
    right_stop_ne_middle := ?_
  }
  · simp [M]
  · simpa [M] using
      Bkt.blocker_stop_ne_left_start
        (M := M) (j' := j)
        (by simp [M])
        hj
  · simpa [M] using
      Bkt.blocker_stop_ne_right_start
        (M := M) (j' := j)
        (by simp [M])
        hj
  · simpa [M] using
      Bkt.blocker_start_ne_left_stop
        (M := M) (j' := j)
        (by simp [M])
        hj
  · simpa [M] using
      Bkt.blocker_start_ne_right_stop
        (M := M) (j' := j)
        (by simp [M])
        hj

/-- A next compressed lower-neighbor boundary atom becomes the top-to-lower
blocker atom data, provided its top endpoint is the selected maximal blocker
endpoint inside the hill row interval. -/
theorem lowerNeighborAtomData_of_nextBoundary
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (j : Fin h) {H : ClaimB3HillCandidateData I inv}
    (Bkt : ClaimB3HillBracketAtomData inv H)
    (hj : j ≠ H.col)
    {b : Fin ((C.blocks j).len + 1)}
    (hblt : b.1 < (C.blocks j).len)
    (hblock_row : (C.blocks j).blockRow b = H.row)
    (hnext_lower :
      ((C.blocks j).blockRow ⟨b.1 + 1, by omega⟩).1 + 1 = H.row.1)
    (htop_mem :
      (C.nextBoundaryAtom j hblt).start ∈ H.rowInterval.vertexSet) :
    Nonempty (ClaimB3LowerNeighborAtomData inv H j) := by
  classical
  let M : ClaimB2Atom I := C.nextBoundaryAtom j hblt
  rcases C.nextBoundaryAtom_rows_of_next_lower j Bkt hblt hblock_row
      hnext_lower with ⟨hM_top, hM_lower⟩
  rcases Bkt.top_between_of_mem_rowInterval htop_mem with
    ⟨hleft_mid, hmid_right⟩
  refine ⟨ClaimB3LowerNeighborAtomData.topToLower ?_⟩
  refine {
    bracket := Bkt
    middleAtom := M
    middle_qIndex := ?_
    middle_top := hM_top
    middle_lower := hM_lower
    left_middle_top := hleft_mid
    middle_right_top := hmid_right
    left_start_ne_middle := ?_
    middle_start_ne_right := ?_
    middle_stop_ne_left := ?_
    right_stop_ne_middle := ?_
  }
  · simp [M]
  · have h := Bkt.blocker_start_ne_left_start
        (M := M) (j' := j)
        (by simp [M])
        hj
    simpa [M] using h
  · have h := Bkt.blocker_start_ne_right_start
        (M := M) (j' := j)
        (by simp [M])
        hj
    simpa [M] using h
  · have h := Bkt.blocker_stop_ne_left_stop
        (M := M) (j' := j)
        (by simp [M])
        hj
    simpa [M] using h
  · have h := Bkt.blocker_stop_ne_right_stop
        (M := M) (j' := j)
        (by simp [M])
        hj
    simpa [M] using h

/-- From an actual blocker intersection with a hill row interval, choose the
compressed blocker block containing that contact.  The maximal-block argument
proved above shows that the first and last contacts of this block also lie in
the hill row interval. -/
theorem exists_block_with_endpoints_inside_of_blocker
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    {H : ClaimB3HillCandidateData I inv}
    (j' : Fin h) (hj' : j' ≠ H.col)
    (hblock :
      ¬ Disjoint H.rowInterval.vertexSet
        (claimB3ColumnPath I inv j').vertexSet) :
    ∃ b : Fin ((C.blocks j').len + 1),
      (C.blocks j').blockRow b = H.row ∧
        (C.trace j').contact ((C.blocks j').first b) ∈
          H.rowInterval.vertexSet ∧
        (C.trace j').contact ((C.blocks j').last b) ∈
          H.rowInterval.vertexSet := by
  classical
  rcases Finset.not_disjoint_iff.1 hblock with ⟨v, hvInterval, hvCol⟩
  have hvRow : v ∈ (claimB3RowPath I inv H.row).vertexSet :=
    (claimB3RowPath I inv H.row).segmentOfBefore_vertexSet_subset
      H.left_before_right hvInterval
  have hvRowUnion : v ∈ I.rowVertexSet :=
    claimB3RowPath_vertexSet_subset_rowVertexSet (I := I) (inv := inv)
      H.row hvRow
  rcases (C.trace j').contact_complete hvCol hvRowUnion with ⟨r, hr⟩
  rcases (C.blocks j').exists_block_of_raw_index r with
    ⟨b, hb_first, hb_last⟩
  have hr_row : (C.trace j').row r = H.row := by
    exact ((C.trace j').contact_row_unique r H.row
      (by simpa [hr] using hvRow)).symm
  have hbrow : (C.blocks j').blockRow b = H.row := by
    have hrow_block :
        (C.trace j').row r = (C.blocks j').blockRow b :=
      (C.blocks j').row_eq_block b r hb_first hb_last
    exact hrow_block.symm.trans hr_row
  have hrInterval : (C.trace j').contact r ∈ H.rowInterval.vertexSet := by
    simpa [hr] using hvInterval
  have hfirst :
      (C.trace j').contact ((C.blocks j').first b) ∈
        H.rowInterval.vertexSet :=
    (C.blocks j').first_mem_rowInterval_of_block_contains_contact
      hbrow hb_first hb_last hrInterval hj'
  have hlast :
      (C.trace j').contact ((C.blocks j').last b) ∈
        H.rowInterval.vertexSet :=
    (C.blocks j').last_mem_rowInterval_of_block_contains_contact
      hbrow hb_first hb_last hrInterval hj'
  exact ⟨b, hbrow, hfirst, hlast⟩

end ClaimB3AtomizedTraceCompressionExtractionCertificate

/-- Claim B.3 terminal proof package with explicit row-contact traces.  This
is the no-hill/no-cross proof shape from the paper: non-convexity gives a
local valley in a complete row trace; the proven valley-to-hill step turns it
into a hill candidate; no-hill gives a blocker; the barrier step gives a
higher candidate. -/
structure ClaimB3TraceTerminalProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  terminal_noBumpNoCross : NoBumpNoCross I
  terminal_aux_noChord : TerminalRowsAuxNoChord I inv
  no_hill : ClaimB3NoHill I inv
  trace_valleys : ClaimB3TraceValleyExtractionCertificate I inv
  higher_candidate_of_blocker :
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          ∃ C' : ClaimB3HillCandidateData I inv, C.row.1 < C'.row.1

/-- A more geometric version of `ClaimB3TraceTerminalProofData`: the barrier
step supplies the endpoint data of the higher hill, rather than the higher
hill candidate already packaged. -/
structure ClaimB3TraceTerminalEndpointProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  terminal_noBumpNoCross : NoBumpNoCross I
  terminal_aux_noChord : TerminalRowsAuxNoChord I inv
  no_hill : ClaimB3NoHill I inv
  trace_valleys : ClaimB3TraceValleyExtractionCertificate I inv
  higher_hill_data_of_blocker :
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
      ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          Nonempty (ClaimB3HigherHillFromBlockerData inv C j')

/-- Trace-valley version of the terminal Claim B.3 proof package.

The blocker barrier is stated in the form closest to the finite trace proof:
for a blocked hill candidate, the blocker column has a hill interval whose
lower row is the original candidate row.  The theorem
`HillValley.toHigherHillFromBlockerData` then packages that valley as the
endpoint data consumed by the existing ascent proof. -/
structure ClaimB3TraceTerminalValleyProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  terminal_noBumpNoCross : NoBumpNoCross I
  terminal_aux_noChord : TerminalRowsAuxNoChord I inv
  no_hill : ClaimB3NoHill I inv
  trace_valleys : ClaimB3TraceValleyExtractionCertificate I inv
  higher_valley_of_blocker :
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
      ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          ∃ Vly : (trace_valleys.trace j').HillValley,
            Vly.rowLower = C.row

/-- Claim B.3 terminal proof package using the complete raw row-contact
traces.  This is the Lean-facing version closest to the paper after the
hill-elimination step: the only geometric input still visible is the blocker
barrier turning a row-interval blocker into a higher hill. -/
structure ClaimB3RawTraceTerminalEndpointProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  terminal_noBumpNoCross : NoBumpNoCross I
  terminal_aux_noChord : TerminalRowsAuxNoChord I inv
  no_hill : ClaimB3NoHill I inv
  trace : ∀ j : Fin h, ClaimB3RowContactTrace I inv j
  trace_first_max :
    ∀ j : Fin h, ∀ k : Fin ((trace j).len + 1),
      ((trace j).row k).1 ≤ ((trace j).row ⟨0, by omega⟩).1
  higher_hill_data_of_blocker :
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          Nonempty (ClaimB3HigherHillFromBlockerData inv C j')

/-- Raw-trace terminal package whose blocker barrier is still expressed as a
higher valley in the blocker trace. -/
structure ClaimB3RawTraceTerminalValleyProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  terminal_noBumpNoCross : NoBumpNoCross I
  terminal_aux_noChord : TerminalRowsAuxNoChord I inv
  no_hill : ClaimB3NoHill I inv
  trace : ∀ j : Fin h, ClaimB3RowContactTrace I inv j
  trace_first_max :
    ∀ j : Fin h, ∀ k : Fin ((trace j).len + 1),
      ((trace j).row k).1 ≤ ((trace j).row ⟨0, by omega⟩).1
  higher_valley_of_blocker :
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          ∃ Vly : (trace j').HillValley, Vly.rowLower = C.row

/-- Terminal Claim B.3 proof data in the form closest to the paper after the
row-contact decomposition has been constructed.  The raw traces are not stored
as hypotheses: they are built from the concrete row-contact lists using Claim
B.2 and the invariant that consecutive row-clean `Q₀` segments are clean for
the full current linkage. -/
structure ClaimB3LinkageCleanTerminalEndpointProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  terminal_noBumpNoCross : NoBumpNoCross I
  terminal_aux_noChord : TerminalRowsAuxNoChord I inv
  no_hill : ClaimB3NoHill I inv
  consecutive_segments_clean :
    ClaimB3AllConsecutiveContactSegmentsLinkageClean I inv
  trace_first_max :
    let S : ClaimB2PlanarStripCertificate I inv :=
      claimB2_planarStripCertificate_of_noBumpNoCross
        terminal_aux_noChord terminal_noBumpNoCross
    let trace : ∀ j : Fin h, ClaimB3RowContactTrace I inv j :=
      claimB3RowContactTraceOfLinkageClean S consecutive_segments_clean
    ∀ j : Fin h, ∀ k : Fin ((trace j).len + 1),
      ((trace j).row k).1 ≤ ((trace j).row ⟨0, by omega⟩).1
  higher_hill_data_of_blocker :
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          Nonempty (ClaimB3HigherHillFromBlockerData inv C j')

/-- Generated-raw-trace terminal package whose blocker barrier is expressed
as a higher valley in the generated blocker trace. -/
structure ClaimB3LinkageCleanTerminalValleyProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  terminal_noBumpNoCross : NoBumpNoCross I
  terminal_aux_noChord : TerminalRowsAuxNoChord I inv
  no_hill : ClaimB3NoHill I inv
  consecutive_segments_clean :
    ClaimB3AllConsecutiveContactSegmentsLinkageClean I inv
  trace_first_max :
    let S : ClaimB2PlanarStripCertificate I inv :=
      claimB2_planarStripCertificate_of_noBumpNoCross
        terminal_aux_noChord terminal_noBumpNoCross
    let trace : ∀ j : Fin h, ClaimB3RowContactTrace I inv j :=
      claimB3RowContactTraceOfLinkageClean S consecutive_segments_clean
    ∀ j : Fin h, ∀ k : Fin ((trace j).len + 1),
      ((trace j).row k).1 ≤ ((trace j).row ⟨0, by omega⟩).1
  higher_valley_of_blocker :
    let S : ClaimB2PlanarStripCertificate I inv :=
      claimB2_planarStripCertificate_of_noBumpNoCross
        terminal_aux_noChord terminal_noBumpNoCross
    let trace : ∀ j : Fin h, ClaimB3RowContactTrace I inv j :=
      claimB3RowContactTraceOfLinkageClean S consecutive_segments_clean
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          ∃ Vly : (trace j').HillValley, Vly.rowLower = C.row

/-- Terminal Claim B.3 proof data using the future-clean-segment invariant
directly.  This is the natural output of the bump/cross successor invariant:
future row-clean `Q₀` subsegments are full-linkage-clean. -/
structure ClaimB3FutureCleanTerminalEndpointProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  terminal_noBumpNoCross : NoBumpNoCross I
  terminal_aux_noChord : TerminalRowsAuxNoChord I inv
  no_hill : ClaimB3NoHill I inv
  future_segments_clean :
    ClaimB3FutureRowCleanSegmentsFullClean I inv
  trace_first_max :
    let S : ClaimB2PlanarStripCertificate I inv :=
      claimB2_planarStripCertificate_of_noBumpNoCross
        terminal_aux_noChord terminal_noBumpNoCross
    let hclean : ClaimB3AllConsecutiveContactSegmentsLinkageClean I inv :=
      claimB3AllConsecutiveContactSegmentsLinkageClean_of_futureFullClean
        future_segments_clean
    let trace : ∀ j : Fin h, ClaimB3RowContactTrace I inv j :=
      claimB3RowContactTraceOfLinkageClean S hclean
    ∀ j : Fin h, ∀ k : Fin ((trace j).len + 1),
      ((trace j).row k).1 ≤ ((trace j).row ⟨0, by omega⟩).1
  higher_hill_data_of_blocker :
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          Nonempty (ClaimB3HigherHillFromBlockerData inv C j')

/-- Terminal Claim B.3 proof package using compressed row-contact traces
instead of direct hill-valley witnesses.  The remaining geometric input is the
barrier step turning a blocker on the row interval into a higher hill. -/
structure ClaimB3TraceCompressionTerminalEndpointProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  terminal_noBumpNoCross : NoBumpNoCross I
  terminal_aux_noChord : TerminalRowsAuxNoChord I inv
  no_hill : ClaimB3NoHill I inv
  trace_compression : ClaimB3TraceCompressionExtractionCertificate I inv
  higher_hill_data_of_blocker :
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          Nonempty (ClaimB3HigherHillFromBlockerData inv C j')

/-- Compressed-block version of the terminal Claim B.3 package.

This is the narrow form of the remaining blocker barrier: a blocked hill
candidate supplies a compressed block of the blocker trace on the candidate
row, that block is not a boundary block, and the adjacent compressed blocks
are not on the lower side.  The finite trace lemmas then force both adjacent
blocks to be on the upper row and produce the higher hill. -/
structure ClaimB3CompressedBlockerTerminalProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  terminal_noBumpNoCross : NoBumpNoCross I
  terminal_aux_noChord : TerminalRowsAuxNoChord I inv
  no_hill : ClaimB3NoHill I inv
  trace_compression : ClaimB3TraceCompressionExtractionCertificate I inv
  blocker_block_without_lower_neighbors :
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          ∃ b : Fin ((trace_compression.blocks j').len + 1),
          ∃ hbpos : 0 < b.1,
          ∃ hblt : b.1 < (trace_compression.blocks j').len,
            (trace_compression.blocks j').blockRow b = C.row ∧
                ((trace_compression.blocks j').blockRow
                    ⟨b.1 - 1, by omega⟩).1 + 1 ≠ C.row.1 ∧
                  ((trace_compression.blocks j').blockRow
                      ⟨b.1 + 1, by omega⟩).1 + 1 ≠ C.row.1

/-- Terminal Claim B.3 package with the blocker choice performed by the
formal row-contact trace.

Compared with `ClaimB3CompressedBlockerTerminalProofData`, this version does
not ask the caller to produce the blocker block.  The proof chooses it from
the `¬ Disjoint` blocker hypothesis; the remaining geometric obligation is the
boundary/lower-neighbor exclusion for every such block. -/
structure ClaimB3BlockerNeighborExclusionTerminalProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  terminal_noBumpNoCross : NoBumpNoCross I
  terminal_aux_noChord : TerminalRowsAuxNoChord I inv
  no_hill : ClaimB3NoHill I inv
  trace_compression : ClaimB3TraceCompressionExtractionCertificate I inv
  blocker_block_boundary_and_lower_exclusion :
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          ∀ b : Fin ((trace_compression.blocks j').len + 1),
            (trace_compression.blocks j').blockRow b = C.row →
              ∃ hbpos : 0 < b.1,
              ∃ hblt : b.1 < (trace_compression.blocks j').len,
                ((trace_compression.blocks j').blockRow
                    ⟨b.1 - 1, by omega⟩).1 + 1 ≠ C.row.1 ∧
                  ((trace_compression.blocks j').blockRow
                      ⟨b.1 + 1, by omega⟩).1 + 1 ≠ C.row.1

/-- Atom-level terminal Claim B.3 package.

This is the refactored target for the remaining blocker proof.  It splits the
paper's “the blocker enters from above” barrier into:

* the blocker compressed block is not a boundary block;
* if the previous or next compressed block were on the lower side, the
  corresponding raw connector atom could be packaged as
  `ClaimB3LowerNeighborAtomData`, contradicting Claim B.2.

The conversion below proves the older `blocker_block_boundary_and_lower_exclusion`
package from these smaller obligations. -/
structure ClaimB3AtomBarrierTerminalProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  terminal_noBumpNoCross : NoBumpNoCross I
  terminal_aux_noChord : TerminalRowsAuxNoChord I inv
  no_hill : ClaimB3NoHill I inv
  trace_compression : ClaimB3TraceCompressionExtractionCertificate I inv
  blocker_block_boundary :
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          ∀ b : Fin ((trace_compression.blocks j').len + 1),
            (trace_compression.blocks j').blockRow b = C.row →
              ∃ _ : 0 < b.1,
                b.1 < (trace_compression.blocks j').len
  prev_lower_neighbor_atom_data :
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          ∀ b : Fin ((trace_compression.blocks j').len + 1),
            (trace_compression.blocks j').blockRow b = C.row →
              ∀ hblt : b.1 < (trace_compression.blocks j').len,
                ((trace_compression.blocks j').blockRow
                    ⟨b.1 - 1, by omega⟩).1 + 1 = C.row.1 →
                  Nonempty (ClaimB3LowerNeighborAtomData inv C j')
  next_lower_neighbor_atom_data :
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          ∀ b : Fin ((trace_compression.blocks j').len + 1),
            (trace_compression.blocks j').blockRow b = C.row →
              ∀ hblt : b.1 < (trace_compression.blocks j').len,
                ((trace_compression.blocks j').blockRow
                    ⟨b.1 + 1, by omega⟩).1 + 1 = C.row.1 →
                  Nonempty (ClaimB3LowerNeighborAtomData inv C j')

/-- Atom-level terminal package with atomized trace compression retained.

This is the most useful target for finishing Claim B.3 from the raw path
decomposition: the block decomposition is available, and the consecutive
atoms used to construct lower-neighbor data are carried in the same package. -/
structure ClaimB3AtomizedAtomBarrierTerminalProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  terminal_noBumpNoCross : NoBumpNoCross I
  terminal_aux_noChord : TerminalRowsAuxNoChord I inv
  no_hill : ClaimB3NoHill I inv
  atomized_trace : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv
  blocker_block_boundary :
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          ∀ b : Fin ((atomized_trace.blocks j').len + 1),
            (atomized_trace.blocks j').blockRow b = C.row →
              ∃ _ : 0 < b.1, b.1 < (atomized_trace.blocks j').len
  prev_lower_neighbor_atom_data :
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          ∀ b : Fin ((atomized_trace.blocks j').len + 1),
            (atomized_trace.blocks j').blockRow b = C.row →
              ∀ hblt : b.1 < (atomized_trace.blocks j').len,
                ((atomized_trace.blocks j').blockRow
                    ⟨b.1 - 1, by omega⟩).1 + 1 = C.row.1 →
                  Nonempty (ClaimB3LowerNeighborAtomData inv C j')
  next_lower_neighbor_atom_data :
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          ∀ b : Fin ((atomized_trace.blocks j').len + 1),
            (atomized_trace.blocks j').blockRow b = C.row →
              ∀ hblt : b.1 < (atomized_trace.blocks j').len,
                ((atomized_trace.blocks j').blockRow
                    ⟨b.1 + 1, by omega⟩).1 + 1 = C.row.1 →
                  Nonempty (ClaimB3LowerNeighborAtomData inv C j')

/-- Chosen-block atom-level terminal package.

This is the exact shape used in the paper: from a blocked hill candidate we
choose one maximal blocker block on the candidate row, then prove only for
that block that it is internal and cannot have a lower-side neighbor. -/
structure ClaimB3ChosenBlockerAtomBarrierTerminalProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  terminal_noBumpNoCross : NoBumpNoCross I
  terminal_aux_noChord : TerminalRowsAuxNoChord I inv
  no_hill : ClaimB3NoHill I inv
  atomized_trace : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv
  blocker_block_data :
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          ∃ b : Fin ((atomized_trace.blocks j').len + 1),
          ∃ hbpos : 0 < b.1,
          ∃ hblt : b.1 < (atomized_trace.blocks j').len,
            (atomized_trace.blocks j').blockRow b = C.row ∧
              (((atomized_trace.blocks j').blockRow
                    ⟨b.1 - 1, by omega⟩).1 + 1 = C.row.1 →
                  Nonempty (ClaimB3LowerNeighborAtomData inv C j')) ∧
                (((atomized_trace.blocks j').blockRow
                    ⟨b.1 + 1, by omega⟩).1 + 1 = C.row.1 →
                  Nonempty (ClaimB3LowerNeighborAtomData inv C j'))

/-- The chosen maximal blocker row segment used in the atom-level proof of
Claim B.3.  It consists of the hill bracketing data, the selected compressed
block of the blocker trace, and the two endpoint facts saying that the
neighboring boundary atoms land inside the hill row interval. -/
structure ClaimB3BlockerSegmentData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    (inv : TypeOneIterationInvariants I)
    (A : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (C : ClaimB3HillCandidateData I inv) (j' : Fin h) where
  bracket : ClaimB3HillBracketAtomData inv C
  block : Fin ((A.blocks j').len + 1)
  block_pos : 0 < block.1
  block_lt : block.1 < (A.blocks j').len
  block_row : (A.blocks j').blockRow block = C.row
  prev_top_mem :
    (A.prevBoundaryAtom j' block_pos).stop ∈ C.rowInterval.vertexSet
  next_top_mem :
    (A.nextBoundaryAtom j' block_lt).start ∈ C.rowInterval.vertexSet

/-- A cleaner form of the chosen blocker block data.

Instead of storing facts about the two boundary atoms, it stores the direct
maximal-block content used in the paper: the first and last contacts of the
chosen blocker block on the candidate row lie in the candidate row interval.
The boundary-atom endpoint facts are then recovered by the endpoint lemmas
for `prevBoundaryAtom` and `nextBoundaryAtom`. -/
structure ClaimB3BlockerBlockInsideIntervalData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    (inv : TypeOneIterationInvariants I)
    (A : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (C : ClaimB3HillCandidateData I inv) (j' : Fin h) where
  bracket : ClaimB3HillBracketAtomData inv C
  block : Fin ((A.blocks j').len + 1)
  block_pos : 0 < block.1
  block_lt : block.1 < (A.blocks j').len
  block_row : (A.blocks j').blockRow block = C.row
  first_mem :
    (A.trace j').contact ((A.blocks j').first block) ∈
      C.rowInterval.vertexSet
  last_mem :
    (A.trace j').contact ((A.blocks j').last block) ∈
      C.rowInterval.vertexSet

namespace ClaimB3BlockerBlockInsideIntervalData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}
variable {A : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv}
variable {C : ClaimB3HillCandidateData I inv} {j' : Fin h}

/-- Convert the cleaner “block endpoints lie inside the row interval”
certificate into the older boundary-atom form consumed by the already-proved
Claim B.3 barrier chain. -/
def toBlockerSegmentData
    (D : ClaimB3BlockerBlockInsideIntervalData inv A C j') :
    ClaimB3BlockerSegmentData inv A C j' where
  bracket := D.bracket
  block := D.block
  block_pos := D.block_pos
  block_lt := D.block_lt
  block_row := D.block_row
  prev_top_mem := by
    simpa using D.first_mem
  next_top_mem := by
    simpa using D.last_mem

/-- The row interval from the first to the last contact of the chosen blocker
block is contained in the blocker `Q₀` path. -/
theorem first_last_rowInterval_subset_qstar
    (D : ClaimB3BlockerBlockInsideIntervalData inv A C j')
    (hbefore :
      (claimB3RowPath I inv C.row).Before
        ((A.trace j').contact ((A.blocks j').first D.block))
        ((A.trace j').contact ((A.blocks j').last D.block))) :
    ((claimB3RowPath I inv C.row).segmentOfBefore hbefore).vertexSet ⊆
      (Q0.data (Q0.selectedColumn j')
        (Q0.selectedColumn_mem_indices j')).qstar.vertexSet := by
  classical
  let B := A.blocks j'
  have hbefore_block :
      (claimB3RowPath I inv (B.blockRow D.block)).Before
        ((A.trace j').contact (B.first D.block))
        ((A.trace j').contact (B.last D.block)) := by
    simpa [B, D.block_row] using hbefore
  have hsubset :=
    B.rowSegment_between_block_contacts_subset_qstar hbefore_block
  simpa [B, D.block_row] using hsubset

/-- Reverse-orientation version of
`first_last_rowInterval_subset_qstar`. -/
theorem last_first_rowInterval_subset_qstar
    (D : ClaimB3BlockerBlockInsideIntervalData inv A C j')
    (hbefore :
      (claimB3RowPath I inv C.row).Before
        ((A.trace j').contact ((A.blocks j').last D.block))
        ((A.trace j').contact ((A.blocks j').first D.block))) :
    ((claimB3RowPath I inv C.row).segmentOfBefore hbefore).vertexSet ⊆
      (Q0.data (Q0.selectedColumn j')
        (Q0.selectedColumn_mem_indices j')).qstar.vertexSet := by
  classical
  let B := A.blocks j'
  have hbefore_block :
      (claimB3RowPath I inv (B.blockRow D.block)).Before
        ((A.trace j').contact (B.last D.block))
        ((A.trace j').contact (B.first D.block)) := by
    simpa [B, D.block_row] using hbefore
  have hsubset :=
    B.rowSegment_between_block_contacts_subset_qstar_rev hbefore_block
  simpa [B, D.block_row] using hsubset

end ClaimB3BlockerBlockInsideIntervalData

/-- Flexible version of the blocker block data.  The blocker block is the
same maximal row block as before, but the original hill carries flexible
brackets so no lower-row orientation is fixed prematurely. -/
structure ClaimB3FlexibleBlockerBlockInsideIntervalData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    (inv : TypeOneIterationInvariants I)
    (A : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (C : ClaimB3HillCandidateData I inv) (j' : Fin h) where
  bracket : ClaimB3FlexibleHillBracketAtomData inv C
  block : Fin ((A.blocks j').len + 1)
  block_pos : 0 < block.1
  block_lt : block.1 < (A.blocks j').len
  block_row : (A.blocks j').blockRow block = C.row
  first_mem :
    (A.trace j').contact ((A.blocks j').first block) ∈
      C.rowInterval.vertexSet
  last_mem :
    (A.trace j').contact ((A.blocks j').last block) ∈
      C.rowInterval.vertexSet

namespace ClaimB3AtomizedTraceCompressionExtractionCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Choose the blocker block and prove it is an internal block.

The proof is the formal version of the paragraph in Claim B.3 where a
blocking transversal segment inside the hill row interval is considered.  The
selected compressed block cannot be the final block, because terminal
type-1 traces end on the bottom active row.  It also cannot be the first
block: the first step out of it is either a forbidden lower-side connector
or an upward step contradicting the maximality of the first compressed row.
Thus the neighboring boundary atoms exist, and the endpoint-inside facts
from `exists_block_with_endpoints_inside_of_blocker` give the precise
inside-interval blocker-block certificate used by the already-proved barrier
chain. -/
theorem blockerBlockInsideIntervalData_of_blocker
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (S : ClaimB2PlanarStripCertificate I inv)
    {H : ClaimB3HillCandidateData I inv}
    (Bkt : ClaimB3HillBracketAtomData inv H)
    (j' : Fin h) (hj' : j' ≠ H.col)
    (hlast_zero :
      ((C.blocks j').blockRow ⟨(C.blocks j').len, by omega⟩).1 = 0)
    (hblock :
      ¬ Disjoint H.rowInterval.vertexSet
        (claimB3ColumnPath I inv j').vertexSet) :
    Nonempty (ClaimB3BlockerBlockInsideIntervalData inv C H j') := by
  classical
  let B := C.blocks j'
  rcases C.exists_block_with_endpoints_inside_of_blocker j' hj' hblock with
    ⟨b, hbrow, hfirst, hlast⟩
  have hblt : b.1 < B.len := by
    by_contra hnot
    have hb_le : b.1 ≤ B.len := by
      exact Nat.le_of_lt_succ b.2
    have hb_eq_len : b.1 = B.len := by
      exact Nat.le_antisymm hb_le (Nat.le_of_not_gt hnot)
    have hrow_zero : H.row.1 = 0 := by
      have hlast_block :
          B.blockRow b = B.blockRow ⟨B.len, by omega⟩ := by
        apply congrArg B.blockRow
        exact Fin.ext hb_eq_len
      have hval : (B.blockRow b).1 = 0 := by
        rw [hlast_block]
        simpa [B] using hlast_zero
      simpa [B, hbrow] using hval
    have hpos := H.row_pos
    omega
  have hbpos : 0 < b.1 := by
    by_contra hnot
    have hb_eq_zero : b.1 = 0 := Nat.eq_zero_of_not_pos hnot
    let ecur : Fin B.len := ⟨b.1, by simpa [B] using hblt⟩
    have hcur_eq :
        (⟨ecur.1, by omega⟩ : Fin (B.len + 1)) = b := by
      apply Fin.ext
      rfl
    have hnext_eq :
        (⟨ecur.1 + 1, by omega⟩ : Fin (B.len + 1)) =
          ⟨b.1 + 1, by omega⟩ := by
      apply Fin.ext
      rfl
    rcases B.exact_step ecur with hdown | hup
    · have hnext_lower :
          (B.blockRow ⟨b.1 + 1, by omega⟩).1 + 1 = H.row.1 := by
        have h :
            (B.blockRow ⟨b.1 + 1, by omega⟩).1 + 1 =
              (B.blockRow b).1 := by
          have h' :
              (B.blockRow ⟨ecur.1 + 1, by omega⟩).1 + 1 =
                (B.blockRow ⟨ecur.1, by omega⟩).1 := hdown
          simpa [hcur_eq, hnext_eq] using h'
        calc
          (B.blockRow ⟨b.1 + 1, by omega⟩).1 + 1 =
              (B.blockRow b).1 := h
          _ = H.row.1 := by rw [hbrow]
      rcases C.lowerNeighborAtomData_of_nextBoundary
          j' Bkt hj' hblt hbrow hnext_lower (by simpa [B] using hlast) with
        ⟨D⟩
      exact D.impossible S hj'
    · have hnext_upper :
          (B.blockRow b).1 + 1 =
            (B.blockRow ⟨b.1 + 1, by omega⟩).1 := by
        have h :
            (B.blockRow ⟨ecur.1, by omega⟩).1 + 1 =
              (B.blockRow ⟨ecur.1 + 1, by omega⟩).1 := hup
        simpa [hcur_eq, hnext_eq] using h
      have hfirst_eq :
          B.blockRow ⟨0, by omega⟩ = B.blockRow b := by
        apply congrArg B.blockRow
        exact Fin.ext hb_eq_zero.symm
      have hnext_le :
          (B.blockRow ⟨b.1 + 1, by omega⟩).1 ≤
            (B.blockRow b).1 := by
        have hmax := B.first_max ⟨b.1 + 1, by omega⟩
        have hfirst_val :
            (B.blockRow ⟨0, by omega⟩).1 = (B.blockRow b).1 :=
          congrArg Fin.val hfirst_eq
        omega
      omega
  exact ⟨{
    bracket := Bkt
    block := b
    block_pos := hbpos
    block_lt := by simpa [B] using hblt
    block_row := by simpa [B] using hbrow
    first_mem := by simpa [B] using hfirst
    last_mem := by simpa [B] using hlast
  }⟩

/-- Flexible-bracket version of `blockerBlockInsideIntervalData_of_blocker`.

The maximal blocker block is chosen in exactly the same way.  The endpoint
cases that would enter from the lower row are discharged directly by the
flexible no-cross barrier, avoiding the obsolete fixed lower-orientation
field. -/
theorem flexibleBlockerBlockInsideIntervalData_of_blocker
    (C : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv)
    (S : ClaimB2PlanarStripCertificate I inv)
    {H : ClaimB3HillCandidateData I inv}
    (Bkt : ClaimB3FlexibleHillBracketAtomData inv H)
    (j' : Fin h) (hj' : j' ≠ H.col)
    (hlast_zero :
      ((C.blocks j').blockRow ⟨(C.blocks j').len, by omega⟩).1 = 0)
    (hblock :
      ¬ Disjoint H.rowInterval.vertexSet
        (claimB3ColumnPath I inv j').vertexSet) :
    Nonempty (ClaimB3FlexibleBlockerBlockInsideIntervalData inv C H j') := by
  classical
  let B := C.blocks j'
  rcases C.exists_block_with_endpoints_inside_of_blocker j' hj' hblock with
    ⟨b, hbrow, hfirst, hlast⟩
  have hblt : b.1 < B.len := by
    by_contra hnot
    have hb_le : b.1 ≤ B.len := Nat.le_of_lt_succ b.2
    have hb_eq_len : b.1 = B.len :=
      Nat.le_antisymm hb_le (Nat.le_of_not_gt hnot)
    have hrow_zero : H.row.1 = 0 := by
      have hlast_block :
          B.blockRow b = B.blockRow ⟨B.len, by omega⟩ := by
        apply congrArg B.blockRow
        exact Fin.ext hb_eq_len
      have hval : (B.blockRow b).1 = 0 := by
        rw [hlast_block]
        simpa [B] using hlast_zero
      simpa [B, hbrow] using hval
    have hpos := H.row_pos
    omega
  have hbpos : 0 < b.1 := by
    by_contra hnot
    have hb_eq_zero : b.1 = 0 := Nat.eq_zero_of_not_pos hnot
    let ecur : Fin B.len := ⟨b.1, by simpa [B] using hblt⟩
    have hcur_eq :
        (⟨ecur.1, by omega⟩ : Fin (B.len + 1)) = b := by
      apply Fin.ext
      rfl
    have hnext_eq :
        (⟨ecur.1 + 1, by omega⟩ : Fin (B.len + 1)) =
          ⟨b.1 + 1, by omega⟩ := by
      apply Fin.ext
      rfl
    rcases B.exact_step ecur with hdown | hup
    · have hnext_lower :
          (B.blockRow ⟨b.1 + 1, by omega⟩).1 + 1 = H.row.1 := by
        have h :
            (B.blockRow ⟨b.1 + 1, by omega⟩).1 + 1 =
              (B.blockRow b).1 := by
          have h' :
              (B.blockRow ⟨ecur.1 + 1, by omega⟩).1 + 1 =
                (B.blockRow ⟨ecur.1, by omega⟩).1 := hdown
          simpa [hcur_eq, hnext_eq] using h'
        calc
          (B.blockRow ⟨b.1 + 1, by omega⟩).1 + 1 =
              (B.blockRow b).1 := h
          _ = H.row.1 := by rw [hbrow]
      exact C.impossible_nextBoundary_lower_flexible
        S j' Bkt hj' (by simpa [B] using hblt) (by simpa [B] using hbrow)
        (by simpa [B] using hnext_lower) (by simpa [B] using hlast)
    · have hnext_upper :
          (B.blockRow b).1 + 1 =
            (B.blockRow ⟨b.1 + 1, by omega⟩).1 := by
        have h :
            (B.blockRow ⟨ecur.1, by omega⟩).1 + 1 =
              (B.blockRow ⟨ecur.1 + 1, by omega⟩).1 := hup
        simpa [hcur_eq, hnext_eq] using h
      have hfirst_eq :
          B.blockRow ⟨0, by omega⟩ = B.blockRow b := by
        apply congrArg B.blockRow
        exact Fin.ext hb_eq_zero.symm
      have hnext_le :
          (B.blockRow ⟨b.1 + 1, by omega⟩).1 ≤
            (B.blockRow b).1 := by
        have hmax := B.first_max ⟨b.1 + 1, by omega⟩
        have hfirst_val :
            (B.blockRow ⟨0, by omega⟩).1 = (B.blockRow b).1 :=
          congrArg Fin.val hfirst_eq
        omega
      omega
  exact ⟨{
    bracket := Bkt
    block := b
    block_pos := hbpos
    block_lt := by simpa [B] using hblt
    block_row := by simpa [B] using hbrow
    first_mem := by simpa [B] using hfirst
    last_mem := by simpa [B] using hlast
  }⟩

end ClaimB3AtomizedTraceCompressionExtractionCertificate

/-- Terminal Claim B.3 package with the blocker block chosen internally from
the atomized trace.

This removes the earlier chosen-block hypothesis.  The remaining visible
inputs are structural facts of the terminal type-1 picture: the blocker traces
end on the bottom active row, and each hill candidate carries the two
bracketing atoms supplied by the adjacent strip decomposition. -/
structure ClaimB3EndpointBracketTerminalProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  terminal_noBumpNoCross : NoBumpNoCross I
  terminal_aux_noChord : TerminalRowsAuxNoChord I inv
  no_hill : ClaimB3NoHill I inv
  atomized_trace : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv
  trace_last_zero :
    ∀ j : Fin h,
      ((atomized_trace.blocks j).blockRow
        ⟨(atomized_trace.blocks j).len, by omega⟩).1 = 0
  hill_bracket :
    ∀ C : ClaimB3HillCandidateData I inv,
      Nonempty (ClaimB3HillBracketAtomData inv C)

/-- Terminal Claim B.3 package with bracketing only for trace-generated hill
valleys.

This is closer to the proof in the paper than
`ClaimB3EndpointBracketTerminalProofData`: the finite ascent ranges over hill
candidates that come from row-contact valleys, and each such valley carries
the two bracketing strip atoms.  No bracketing data is required for arbitrary
abstract hill candidates. -/
structure ClaimB3TraceValleyBracketTerminalProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  terminal_noBumpNoCross : NoBumpNoCross I
  terminal_aux_noChord : TerminalRowsAuxNoChord I inv
  no_hill : ClaimB3NoHill I inv
  atomized_trace : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv
  trace_last_zero :
    ∀ j : Fin h,
      ((atomized_trace.blocks j).blockRow
        ⟨(atomized_trace.blocks j).len, by omega⟩).1 = 0
  hill_valley_bracket :
    ∀ j : Fin h, ∀ Vly : (atomized_trace.trace j).HillValley,
      Nonempty (ClaimB3HillBracketAtomData inv Vly.toHillCandidateData)

/-- Fully refactored terminal package for Claim B.3 using flexible
trace-generated bracketing atoms.

All hill brackets are constructed from the atomized row-contact trace itself;
the package therefore no longer asks for separate bracketing data for every
trace valley. -/
structure ClaimB3TraceValleyFlexibleTerminalProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  terminal_noBumpNoCross : NoBumpNoCross I
  terminal_aux_noChord : TerminalRowsAuxNoChord I inv
  no_hill : ClaimB3NoHill I inv
  atomized_trace : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv
  trace_last_zero :
    ∀ j : Fin h,
      ((atomized_trace.blocks j).blockRow
        ⟨(atomized_trace.blocks j).len, by omega⟩).1 = 0

/-- Maximal-blocker-segment terminal package for Claim B.3.

This is the proof interface that matches the paper's blocker paragraph most
closely.  From a blocker intersection with the hill row interval, choose the
maximal contiguous blocker row segment inside that interval.  Its two
neighboring raw atoms are the previous and next boundary atoms of the chosen
compressed block, and their top endpoints lie inside the hill interval.  The
conversion below proves the lower-neighbor alternatives impossible by applying
the local Claim B.2 barrier to those two concrete atoms. -/
structure ClaimB3BlockerSegmentAtomBarrierTerminalProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  terminal_noBumpNoCross : NoBumpNoCross I
  terminal_aux_noChord : TerminalRowsAuxNoChord I inv
  no_hill : ClaimB3NoHill I inv
  atomized_trace : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv
  blocker_segment_data :
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          Nonempty (ClaimB3BlockerSegmentData inv atomized_trace C j')

/-- Terminal package where the chosen blocker block is stated directly as a
row block whose first and last contacts lie inside the candidate hill row
interval.  This is the preferred interface for the remaining maximal-blocker
choice: it matches the paper's maximal subpath inside `P_i[s,t]` and avoids
duplicating boundary-atom endpoint equalities. -/
structure ClaimB3BlockerBlockInsideIntervalTerminalProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  terminal_noBumpNoCross : NoBumpNoCross I
  terminal_aux_noChord : TerminalRowsAuxNoChord I inv
  no_hill : ClaimB3NoHill I inv
  atomized_trace : ClaimB3AtomizedTraceCompressionExtractionCertificate I inv
  blocker_block_inside_interval :
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          Nonempty
            (ClaimB3BlockerBlockInsideIntervalData
              inv atomized_trace C j')

namespace ClaimB3TraceValleyBracketTerminalProofData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Convert trace-valley bracketing data into the bracketed finite-ascent
certificate.

The key point is that the successor hill is recovered as a concrete valley in
the blocker trace, so its bracketing data is requested only through
`hill_valley_bracket`, not through a global arbitrary-candidate hypothesis. -/
noncomputable def toBracketedPathHillNormalCertificate
    (C : ClaimB3TraceValleyBracketTerminalProofData I inv) :
    ClaimB3BracketedPathHillNormalCertificate I inv where
  no_hill := C.no_hill
  candidate_of_nonconvex_trace := by
    intro hbad
    rcases ClaimB3MaximalNonconvexTrace.exists_of_any
        (I := I) (inv := inv) hbad with ⟨M⟩
    rcases C.atomized_trace.toTraceCompressionExtractionCertificate
        |>.toTraceValleyExtractionCertificate
        |>.hill_valley_of_maximal_nonconvex_trace M with ⟨Vly⟩
    rcases C.hill_valley_bracket M.col Vly with ⟨Bkt⟩
    exact ⟨{ candidate := Vly.toHillCandidateData, bracket := Bkt }⟩
  higher_candidate_of_candidate := by
    intro H
    rcases C.no_hill.exists_blocker H.candidate with
      ⟨j', hj', hblock⟩
    let S : ClaimB2PlanarStripCertificate I inv :=
      claimB2_planarStripCertificate_of_noBumpNoCross
        C.terminal_aux_noChord C.terminal_noBumpNoCross
    rcases C.atomized_trace.blockerBlockInsideIntervalData_of_blocker
        S H.bracket j' hj' (C.trace_last_zero j') hblock with ⟨D⟩
    have hprev_lt :
        D.block.1 - 1 < (C.atomized_trace.blocks j').len + 1 :=
      lt_of_le_of_lt (Nat.sub_le _ _) D.block.2
    have hnext_lt :
        D.block.1 + 1 < (C.atomized_trace.blocks j').len + 1 :=
      Nat.succ_lt_succ D.block_lt
    have hprev_not :
        ((C.atomized_trace.blocks j').blockRow
            ⟨D.block.1 - 1, hprev_lt⟩).1 + 1 ≠ H.candidate.row.1 := by
      intro hprev
      rcases C.atomized_trace.lowerNeighborAtomData_of_prevBoundary
          j' D.bracket hj' D.block_pos D.block_row hprev
          (by simpa using D.first_mem) with ⟨N⟩
      exact N.impossible S hj'
    have hnext_not :
        ((C.atomized_trace.blocks j').blockRow
            ⟨D.block.1 + 1, hnext_lt⟩).1 + 1 ≠ H.candidate.row.1 := by
      intro hnext
      rcases C.atomized_trace.lowerNeighborAtomData_of_nextBoundary
          j' D.bracket hj' D.block_lt D.block_row hnext
          (by simpa using D.last_mem) with ⟨N⟩
      exact N.impossible S hj'
    rcases (C.atomized_trace.blocks j').hillValley_of_block_without_lower_neighbors
        D.block_row D.block_pos D.block_lt
        (by simpa using hprev_not) (by simpa using hnext_not) with
      ⟨Vly, hrowLower⟩
    rcases C.hill_valley_bracket j' Vly with ⟨Bkt'⟩
    refine ⟨{ candidate := Vly.toHillCandidateData, bracket := Bkt' }, ?_⟩
    have hlt :=
      (Vly.toHigherHillFromBlockerData hrowLower).row_lt_toHillCandidateData
    simpa [ClaimB3HigherHillFromBlockerData.toHillCandidateData,
      ClaimB3RowContactTrace.HillValley.toHigherHillFromBlockerData] using hlt

/-- Connected-intersection Claim B.3 from trace-generated bracketed hill
valleys. -/
theorem connectedIntersections
    (C : ClaimB3TraceValleyBracketTerminalProofData I inv) :
    ClaimB3ConnectedIntersections I inv :=
  C.toBracketedPathHillNormalCertificate.connectedIntersections

end ClaimB3TraceValleyBracketTerminalProofData

namespace ClaimB3TraceValleyFlexibleTerminalProofData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Convert the fully refactored flexible terminal data into the finite
hill-ascent certificate. -/
noncomputable def toFlexibleBracketedPathHillNormalCertificate
    (C : ClaimB3TraceValleyFlexibleTerminalProofData I inv) :
    ClaimB3FlexibleBracketedPathHillNormalCertificate I inv where
  no_hill := C.no_hill
  candidate_of_nonconvex_trace := by
    intro hbad
    rcases ClaimB3MaximalNonconvexTrace.exists_of_any
        (I := I) (inv := inv) hbad with ⟨M⟩
    rcases C.atomized_trace.toTraceCompressionExtractionCertificate
        |>.toTraceValleyExtractionCertificate
        |>.hill_valley_of_maximal_nonconvex_trace M with ⟨Vly⟩
    let Bkt :=
      C.atomized_trace.flexibleHillBracketAtomData_of_hillValley M.col Vly
    exact ⟨{ candidate := Vly.toHillCandidateData, bracket := Bkt }⟩
  higher_candidate_of_candidate := by
    intro H
    rcases C.no_hill.exists_blocker H.candidate with
      ⟨j', hj', hblock⟩
    let S : ClaimB2PlanarStripCertificate I inv :=
      claimB2_planarStripCertificate_of_noBumpNoCross
        C.terminal_aux_noChord C.terminal_noBumpNoCross
    rcases C.atomized_trace.flexibleBlockerBlockInsideIntervalData_of_blocker
        S H.bracket j' hj' (C.trace_last_zero j') hblock with ⟨D⟩
    have hprev_lt :
        D.block.1 - 1 < (C.atomized_trace.blocks j').len + 1 :=
      lt_of_le_of_lt (Nat.sub_le _ _) D.block.2
    have hnext_lt :
        D.block.1 + 1 < (C.atomized_trace.blocks j').len + 1 :=
      Nat.succ_lt_succ D.block_lt
    have hprev_not :
        ((C.atomized_trace.blocks j').blockRow
            ⟨D.block.1 - 1, hprev_lt⟩).1 + 1 ≠ H.candidate.row.1 := by
      intro hprev
      exact C.atomized_trace.impossible_prevBoundary_lower_flexible
        S j' D.bracket hj' D.block_pos D.block_row hprev
        (by simpa using D.first_mem)
    have hnext_not :
        ((C.atomized_trace.blocks j').blockRow
            ⟨D.block.1 + 1, hnext_lt⟩).1 + 1 ≠ H.candidate.row.1 := by
      intro hnext
      exact C.atomized_trace.impossible_nextBoundary_lower_flexible
        S j' D.bracket hj' D.block_lt D.block_row hnext
        (by simpa using D.last_mem)
    rcases (C.atomized_trace.blocks j').hillValley_of_block_without_lower_neighbors
        D.block_row D.block_pos D.block_lt
        (by simpa using hprev_not) (by simpa using hnext_not) with
      ⟨Vly, hrowLower⟩
    let Bkt' :=
      C.atomized_trace.flexibleHillBracketAtomData_of_hillValley j' Vly
    refine ⟨{ candidate := Vly.toHillCandidateData, bracket := Bkt' }, ?_⟩
    have hlt :=
      (Vly.toHigherHillFromBlockerData hrowLower).row_lt_toHillCandidateData
    simpa [ClaimB3HigherHillFromBlockerData.toHillCandidateData,
      ClaimB3RowContactTrace.HillValley.toHigherHillFromBlockerData] using hlt

/-- Connected-intersection Claim B.3 from internally constructed flexible
trace-valley brackets. -/
noncomputable def pathIntersections
    (C : ClaimB3TraceValleyFlexibleTerminalProofData I inv) :
    ClaimB3PathIntersections I inv :=
  C.toFlexibleBracketedPathHillNormalCertificate.pathIntersections

/-- Connected-intersection Claim B.3 from internally constructed flexible
trace-valley brackets. -/
theorem connectedIntersections
    (C : ClaimB3TraceValleyFlexibleTerminalProofData I inv) :
    ClaimB3ConnectedIntersections I inv :=
  ClaimB3ConnectedIntersections.of_pathIntersections C.pathIntersections

end ClaimB3TraceValleyFlexibleTerminalProofData

namespace ClaimB3TraceCompressionTerminalEndpointProofData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Forget the compressed-trace terminal package to the endpoint-level package
already consumed by the finite hill-ascent proof. -/
def toTraceTerminalEndpointProofData
    (C : ClaimB3TraceCompressionTerminalEndpointProofData I inv) :
    ClaimB3TraceTerminalEndpointProofData I inv where
  terminal_noBumpNoCross := C.terminal_noBumpNoCross
  terminal_aux_noChord := C.terminal_aux_noChord
  no_hill := C.no_hill
  trace_valleys :=
    C.trace_compression.toTraceValleyExtractionCertificate
  higher_hill_data_of_blocker := C.higher_hill_data_of_blocker

end ClaimB3TraceCompressionTerminalEndpointProofData

namespace ClaimB3CompressedBlockerTerminalProofData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Convert the compressed-block blocker-barrier package into the endpoint
package consumed by the already-proved finite hill-ascent proof. -/
def toTraceCompressionTerminalEndpointProofData
    (C : ClaimB3CompressedBlockerTerminalProofData I inv) :
    ClaimB3TraceCompressionTerminalEndpointProofData I inv where
  terminal_noBumpNoCross := C.terminal_noBumpNoCross
  terminal_aux_noChord := C.terminal_aux_noChord
  no_hill := C.no_hill
  trace_compression := C.trace_compression
  higher_hill_data_of_blocker := by
    intro H j' hj' hblock
    rcases C.blocker_block_without_lower_neighbors H j' hj' hblock with
      ⟨b, hbpos, hblt, hbrow, hbprev, hbnext⟩
    exact (C.trace_compression.blocks j').higherHillFromBlockerData_of_block_without_lower_neighbors
      hbrow hbpos hblt hbprev hbnext

end ClaimB3CompressedBlockerTerminalProofData

namespace ClaimB3BlockerNeighborExclusionTerminalProofData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Choose the blocker block from the trace, then apply the supplied
boundary/lower-neighbor exclusion to get the compressed-block terminal
package. -/
def toCompressedBlockerTerminalProofData
    (C : ClaimB3BlockerNeighborExclusionTerminalProofData I inv) :
    ClaimB3CompressedBlockerTerminalProofData I inv where
  terminal_noBumpNoCross := C.terminal_noBumpNoCross
  terminal_aux_noChord := C.terminal_aux_noChord
  no_hill := C.no_hill
  trace_compression := C.trace_compression
  blocker_block_without_lower_neighbors := by
    intro H j' hj' hblock
    rcases (C.trace_compression.blocks j').exists_block_on_candidate_row_of_blocker
        hblock with ⟨b, hbrow⟩
    rcases C.blocker_block_boundary_and_lower_exclusion H j' hj' hblock
        b hbrow with ⟨hbpos, hblt, hbprev, hbnext⟩
    exact ⟨b, hbpos, hblt, hbrow, hbprev, hbnext⟩

end ClaimB3BlockerNeighborExclusionTerminalProofData

namespace ClaimB3AtomBarrierTerminalProofData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Convert the atom-level terminal package into the compressed-block
boundary/lower-neighbor exclusion package. -/
def toBlockerNeighborExclusionTerminalProofData
    (C : ClaimB3AtomBarrierTerminalProofData I inv) :
    ClaimB3BlockerNeighborExclusionTerminalProofData I inv where
  terminal_noBumpNoCross := C.terminal_noBumpNoCross
  terminal_aux_noChord := C.terminal_aux_noChord
  no_hill := C.no_hill
  trace_compression := C.trace_compression
  blocker_block_boundary_and_lower_exclusion := by
    intro H j' hj' hblock b hbrow
    rcases C.blocker_block_boundary H j' hj' hblock b hbrow with
      ⟨hbpos, hblt⟩
    refine ⟨hbpos, hblt, ?_, ?_⟩
    · intro hprev_lower
      let S : ClaimB2PlanarStripCertificate I inv :=
        claimB2_planarStripCertificate_of_noBumpNoCross
          C.terminal_aux_noChord C.terminal_noBumpNoCross
      rcases C.prev_lower_neighbor_atom_data H j' hj' hblock b hbrow
          hblt hprev_lower with ⟨D⟩
      exact D.impossible S hj'
    · intro hnext_lower
      let S : ClaimB2PlanarStripCertificate I inv :=
        claimB2_planarStripCertificate_of_noBumpNoCross
          C.terminal_aux_noChord C.terminal_noBumpNoCross
      rcases C.next_lower_neighbor_atom_data H j' hj' hblock b hbrow
          hblt hnext_lower with ⟨D⟩
      exact D.impossible S hj'

end ClaimB3AtomBarrierTerminalProofData

namespace ClaimB3AtomizedAtomBarrierTerminalProofData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Forget the retained atomization after the atom-level lower-neighbor
barrier has been packaged. -/
noncomputable def toAtomBarrierTerminalProofData
    (C : ClaimB3AtomizedAtomBarrierTerminalProofData I inv) :
    ClaimB3AtomBarrierTerminalProofData I inv where
  terminal_noBumpNoCross := C.terminal_noBumpNoCross
  terminal_aux_noChord := C.terminal_aux_noChord
  no_hill := C.no_hill
  trace_compression :=
    C.atomized_trace.toTraceCompressionExtractionCertificate
  blocker_block_boundary := by
    intro H j' hj' hblock b hbrow
    exact C.blocker_block_boundary H j' hj' hblock b hbrow
  prev_lower_neighbor_atom_data := by
    intro H j' hj' hblock b hbrow hblt hprev
    exact C.prev_lower_neighbor_atom_data H j' hj' hblock b hbrow hblt hprev
  next_lower_neighbor_atom_data := by
    intro H j' hj' hblock b hbrow hblt hnext
    exact C.next_lower_neighbor_atom_data H j' hj' hblock b hbrow hblt hnext

end ClaimB3AtomizedAtomBarrierTerminalProofData

namespace ClaimB3ChosenBlockerAtomBarrierTerminalProofData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Convert the chosen-block atom barrier directly to the compressed-block
terminal package.  The lower-neighbor alternatives are discharged by the
already-proved atom-level no-cross contradiction. -/
noncomputable def toCompressedBlockerTerminalProofData
    (C : ClaimB3ChosenBlockerAtomBarrierTerminalProofData I inv) :
    ClaimB3CompressedBlockerTerminalProofData I inv where
  terminal_noBumpNoCross := C.terminal_noBumpNoCross
  terminal_aux_noChord := C.terminal_aux_noChord
  no_hill := C.no_hill
  trace_compression :=
    C.atomized_trace.toTraceCompressionExtractionCertificate
  blocker_block_without_lower_neighbors := by
    intro H j' hj' hblock
    rcases C.blocker_block_data H j' hj' hblock with
      ⟨b, hbpos, hblt, hbrow, hprevData, hnextData⟩
    refine ⟨b, hbpos, hblt, hbrow, ?_, ?_⟩
    · intro hprev
      let S : ClaimB2PlanarStripCertificate I inv :=
        claimB2_planarStripCertificate_of_noBumpNoCross
          C.terminal_aux_noChord C.terminal_noBumpNoCross
      rcases hprevData hprev with ⟨D⟩
      exact D.impossible S hj'
    · intro hnext
      let S : ClaimB2PlanarStripCertificate I inv :=
        claimB2_planarStripCertificate_of_noBumpNoCross
          C.terminal_aux_noChord C.terminal_noBumpNoCross
      rcases hnextData hnext with ⟨D⟩
      exact D.impossible S hj'

end ClaimB3ChosenBlockerAtomBarrierTerminalProofData

