  hUD : I.rowIndex Cross.rowLeft ≠ auxD
  hAV : auxA ≠ I.rowIndex Cross.rowRight
  hDV : auxD ≠ I.rowIndex Cross.rowRight
  hLD : auxL ≠ auxD

namespace CrossLocalOutsideData

/-- Package forward local-quad data together with endpoint outside-neighbor
data into the exact Figure 8 local record. -/
def ofForwardQuadAndEndpoint
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Cross : CrossWitness I)
    (D : TypeOneCrossForwardLocalQuadData Inv Cross)
    (O : EndpointOutsideNeighborData Inv Cross D.auxA D.auxD) :
    CrossLocalOutsideData Inv Cross where
  auxL := O.auxL
  auxA := D.auxA
  auxD := D.auxD
  auxR := O.auxR
  hLA_old := O.left_adj_auxL
  hAU_old := D.hAU_old
  hUV_old := D.hUV_old
  hVD_old := D.hVD_old
  hDR_old := O.right_adj_auxR
  hA_old := D.hA_old
  hU_old := D.hU_old
  hV_old := D.hV_old
  hD_old := D.hD_old
  hL_not := O.auxL_not
  hR_not := O.auxR_not
  hLU := O.auxL_ne_leftRow
  hRV := O.auxR_ne_rightRow
  hAU_ne := D.hAU_old.1
  hAD := D.hAD
  hUD := D.hUD
  hAV := D.hAV
  hDV := D.hVD_old.1.symm
  hLD := O.auxL_ne_auxD

