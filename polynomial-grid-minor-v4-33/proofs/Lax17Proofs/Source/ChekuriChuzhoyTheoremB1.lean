/-- Paper-level Figure 8 update for the left-to-right successor order from the
concrete local cross data.

This bundles the finite local degree-drop dichotomy with the constructed
left-to-right successor and its expanded invariant.  The only remaining
nonlocal hypothesis is the successor `Q₀` row-contact invariant, which is the
separate no-skip contact-survival part of the paper proof. -/
noncomputable def paperActionUpdate_leftRight_of_localDichotomy_constructedSuccessor
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (auxL auxA auxD auxR : I.linkage.Index)
    (hLA_old : (linkageAuxGraph I.linkage).Adj auxA auxL)
    (hAU_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Cross.rowLeft))
    (hUV_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight))
    (hVD_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hDR_old : (linkageAuxGraph I.linkage).Adj auxD auxR)
    (hAU_new :
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        auxA (I.rowIndex Cross.rowLeft))
    (hVD_new :
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hU_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowLeft) 2)
    (hV_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowRight) 2)
    (hD_old : DegreeEquals (linkageAuxGraph I.linkage) auxD 2)
    (hL_not :
      auxL ∉ ({auxA, I.rowIndex Cross.rowLeft,
        I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index))
    (hR_not :
      auxR ∉ ({auxA, I.rowIndex Cross.rowLeft,
        I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index))
    (hLU : auxL ≠ I.rowIndex Cross.rowLeft)
    (hRV : auxR ≠ I.rowIndex Cross.rowRight)
    (hAU_ne : auxA ≠ I.rowIndex Cross.rowLeft)
    (hAD : auxA ≠ auxD)
    (hUD : I.rowIndex Cross.rowLeft ≠ auxD)
    (hAV : auxA ≠ I.rowIndex Cross.rowRight)
    (hDV : auxD ≠ I.rowIndex Cross.rowRight)
    (hLD : auxL ≠ auxD)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathLeftRight) :
    CrossPaperActionUpdate Inv Cross := by
  classical
  let L'' : PerfectPathPacking G A B := Cross.replacementLinkageConcrete
  have hsupport :
      AdjChangeSupportedIn (linkageAuxGraph I.linkage)
        (linkageAuxGraph L'')
        ({auxA, I.rowIndex Cross.rowLeft,
          I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index) := by
    simpa [L''] using
      Cross.cross_adjChangeSupportedIn auxA auxD
        hAU_old hUV_old hVD_old hU_old hV_old hAV hUD
  have hdich :
      degreeTwoVertexCount (linkageAuxGraph L'') <
          degreeTwoVertexCount (linkageAuxGraph I.linkage) ∨
        ∀ u v : I.linkage.Index,
          (linkageAuxGraph L'').Adj u v ↔
            (linkageAuxGraph I.linkage).Adj u v := by
    exact
      cross_supported_degree_drop_or_aux_adj_iff
        (H := linkageAuxGraph I.linkage) (H' := linkageAuxGraph L'')
        (L := auxL) (A := auxA) (U := I.rowIndex Cross.rowLeft)
        (V := I.rowIndex Cross.rowRight) (D := auxD) (R := auxR)
        hsupport hLA_old hAU_old hUV_old hVD_old hDR_old
        (by simpa [L''] using hAU_new)
        (by simpa [L''] using
          Cross.replacementLinkageConcrete_adj_left_right_from_deletedLeftMiddle)
        (by simpa [L''] using hVD_new)
        hA_old hU_old hV_old hD_old hL_not hR_not hLU hRV hAU_ne
        hAD hUD hAV hDV hLD
  refine ⟨?_⟩
  rcases hdich with hdrop | hadj_iff
  · exact Or.inl ⟨L'', by
      simpa [L'', linkageAuxDegreeTwoCount] using hdrop⟩
  · let haux_prev : AuxGraphsIsomorphic I.linkage L'' :=
      auxGraphsIsomorphic_of_equiv_adj (Equiv.refl I.linkage.Index)
        (fun i j => (hadj_iff i j).symm)
    let haux_fixed : AuxGraphsIsomorphic L L'' :=
      auxGraphsIsomorphic_trans I.aux_iso_fixed_outside haux_prev
    let deleted_edge : Sym2 V :=
      Classical.choose Cross.exists_deletedMiddle_edge_not_mem_Q0
    have hdeleted :
        deleted_edge ∈ Cross.deletedLeftMiddle.edgeSet ∨
          deleted_edge ∈ Cross.deletedRightMiddle.edgeSet :=
      (Classical.choose_spec Cross.exists_deletedMiddle_edge_not_mem_Q0).1
    have hnotQ0 : deleted_edge ∉ Q0.edgeSet :=
      (Classical.choose_spec Cross.exists_deletedMiddle_edge_not_mem_Q0).2
    have hmissing :
        deleted_edge ∉
          (Cross.successorInputLeftRight haux_fixed hq0).tildeEdgeSet := by
      rcases hdeleted with hleft | hright
      · exact Cross.deletedLeftMiddle_edge_not_mem_successorTilde_of_not_mem_Q0
          haux_fixed hq0 hleft hnotQ0
      · exact Cross.deletedRightMiddle_edge_not_mem_successorTilde_of_not_mem_Q0
          haux_fixed hq0 hright hnotQ0
    let Succ : CrossSuccessorCertificate Cross :=
      Cross.successorCertificateLeftRight_of_missing_deleted_edge haux_fixed
        hq0 deleted_edge hdeleted hmissing
    let InvSucc :
        TypeOneExtendedFutureCleanIterationInvariants Succ.next :=
      Cross.successorCertificateLeftRight_extendedFutureCleanIterationInvariants_of_allQ0
        haux_fixed hq0 Inv hadj_iff deleted_edge hdeleted hmissing
    exact Or.inr ⟨{ successor := Succ, invariant := InvSucc }⟩

/-- Paper-level Figure 8 left-to-right update from local data, with the
successor `Q₀` invariant required only in the nonterminating isomorphic
branch.

This is the cross analogue of the conditional Figure 7 wrapper.  If the local
dichotomy drops an auxiliary degree, the loop stops.  If it preserves the
auxiliary adjacency relation, the caller supplies the no-skip successor
contact invariant for the left-to-right replacement order. -/
noncomputable def paperActionUpdate_leftRight_of_localDichotomy_constructedSuccessor_conditional
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (auxL auxA auxD auxR : I.linkage.Index)
    (hLA_old : (linkageAuxGraph I.linkage).Adj auxA auxL)
    (hAU_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Cross.rowLeft))
    (hUV_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight))
    (hVD_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hDR_old : (linkageAuxGraph I.linkage).Adj auxD auxR)
    (hAU_new :
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        auxA (I.rowIndex Cross.rowLeft))
    (hVD_new :
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hU_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowLeft) 2)
    (hV_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowRight) 2)
    (hD_old : DegreeEquals (linkageAuxGraph I.linkage) auxD 2)
    (hL_not :
      auxL ∉ ({auxA, I.rowIndex Cross.rowLeft,
        I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index))
    (hR_not :
      auxR ∉ ({auxA, I.rowIndex Cross.rowLeft,
        I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index))
    (hLU : auxL ≠ I.rowIndex Cross.rowLeft)
    (hRV : auxR ≠ I.rowIndex Cross.rowRight)
    (hAU_ne : auxA ≠ I.rowIndex Cross.rowLeft)
    (hAD : auxA ≠ auxD)
    (hUD : I.rowIndex Cross.rowLeft ≠ auxD)
    (hAV : auxA ≠ I.rowIndex Cross.rowRight)
    (hDV : auxD ≠ I.rowIndex Cross.rowRight)
    (hLD : auxL ≠ auxD)
    (hq0_of_adj_iff :
      (∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j) →
        TypeOneCurrentRowsInvariant R hpos Q0 I.Row
          Cross.successorRowPathLeftRight) :
    CrossPaperActionUpdate Inv Cross := by
  classical
  let L'' : PerfectPathPacking G A B := Cross.replacementLinkageConcrete
  have hsupport :
      AdjChangeSupportedIn (linkageAuxGraph I.linkage)
        (linkageAuxGraph L'')
        ({auxA, I.rowIndex Cross.rowLeft,
          I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index) := by
    simpa [L''] using
      Cross.cross_adjChangeSupportedIn auxA auxD
        hAU_old hUV_old hVD_old hU_old hV_old hAV hUD
  have hdich :
      degreeTwoVertexCount (linkageAuxGraph L'') <
          degreeTwoVertexCount (linkageAuxGraph I.linkage) ∨
        ∀ u v : I.linkage.Index,
          (linkageAuxGraph L'').Adj u v ↔
            (linkageAuxGraph I.linkage).Adj u v := by
    exact
      cross_supported_degree_drop_or_aux_adj_iff
        (H := linkageAuxGraph I.linkage) (H' := linkageAuxGraph L'')
        (L := auxL) (A := auxA) (U := I.rowIndex Cross.rowLeft)
        (V := I.rowIndex Cross.rowRight) (D := auxD) (R := auxR)
        hsupport hLA_old hAU_old hUV_old hVD_old hDR_old
        (by simpa [L''] using hAU_new)
        (by simpa [L''] using
          Cross.replacementLinkageConcrete_adj_left_right_from_deletedLeftMiddle)
        (by simpa [L''] using hVD_new)
        hA_old hU_old hV_old hD_old hL_not hR_not hLU hRV hAU_ne
        hAD hUD hAV hDV hLD
  refine ⟨?_⟩
  rcases hdich with hdrop | hadj_iff
  · exact Or.inl ⟨L'', by
      simpa [L'', linkageAuxDegreeTwoCount] using hdrop⟩
  · have hadj_iff_concrete :
        ∀ i j : I.linkage.Index,
          (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
            (linkageAuxGraph I.linkage).Adj i j := by
      intro i j
      simpa [L''] using hadj_iff i j
    let hq0 :
        TypeOneCurrentRowsInvariant R hpos Q0 I.Row
          Cross.successorRowPathLeftRight :=
      hq0_of_adj_iff hadj_iff_concrete
    let haux_prev : AuxGraphsIsomorphic I.linkage L'' :=
      auxGraphsIsomorphic_of_equiv_adj (Equiv.refl I.linkage.Index)
        (fun i j => (hadj_iff i j).symm)
    let haux_fixed : AuxGraphsIsomorphic L L'' :=
      auxGraphsIsomorphic_trans I.aux_iso_fixed_outside haux_prev
    let deleted_edge : Sym2 V :=
      Classical.choose Cross.exists_deletedMiddle_edge_not_mem_Q0
    have hdeleted :
        deleted_edge ∈ Cross.deletedLeftMiddle.edgeSet ∨
          deleted_edge ∈ Cross.deletedRightMiddle.edgeSet :=
      (Classical.choose_spec Cross.exists_deletedMiddle_edge_not_mem_Q0).1
    have hnotQ0 : deleted_edge ∉ Q0.edgeSet :=
      (Classical.choose_spec Cross.exists_deletedMiddle_edge_not_mem_Q0).2
    have hmissing :
        deleted_edge ∉
          (Cross.successorInputLeftRight haux_fixed hq0).tildeEdgeSet := by
      rcases hdeleted with hleft | hright
      · exact Cross.deletedLeftMiddle_edge_not_mem_successorTilde_of_not_mem_Q0
          haux_fixed hq0 hleft hnotQ0
      · exact Cross.deletedRightMiddle_edge_not_mem_successorTilde_of_not_mem_Q0
          haux_fixed hq0 hright hnotQ0
    let Succ : CrossSuccessorCertificate Cross :=
      Cross.successorCertificateLeftRight_of_missing_deleted_edge haux_fixed
        hq0 deleted_edge hdeleted hmissing
    let InvSucc :
        TypeOneExtendedFutureCleanIterationInvariants Succ.next :=
      Cross.successorCertificateLeftRight_extendedFutureCleanIterationInvariants_of_allQ0
        haux_fixed hq0 Inv hadj_iff deleted_edge hdeleted hmissing
    exact Or.inr ⟨{ successor := Succ, invariant := InvSucc }⟩

/-- Paper-level Figure 8 left-to-right update from local data, with the
successor `Q₀` invariant reduced to the two replacement-row contact survival
facts. -/
noncomputable def paperActionUpdate_leftRight_of_localDichotomy_constructedSuccessor_hitsReplacements
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (auxL auxA auxD auxR : I.linkage.Index)
