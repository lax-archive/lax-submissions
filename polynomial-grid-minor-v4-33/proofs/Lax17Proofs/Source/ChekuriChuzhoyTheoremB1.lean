      TypeTwoExtendedFullIterationInvariants I →
        ¬ Terminal I →
          TypeTwoExtendedFullInvariantSimplifyingActionOutcome I
  hterminal :
    ∀ I : TypeTwoIterationInput R hpos S.Q0,
      ∀ Inv : TypeTwoExtendedFullIterationInvariants I,
        Terminal I →
          TypeTwoTerminalPathConcreteHillEliminationData I Inv.full.base

namespace TypeTwoBranchConcreteHillEliminationProofData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {S : TypeTwoIterationSetup R hpos Q}

/-- Forget the concrete terminal type-2 Claim B.3 internals down to the
existing type-2 hill-elimination branch interface. -/
noncomputable def toPathHillEliminationProofData
    (D : TypeTwoBranchConcreteHillEliminationProofData S) :
    TypeTwoBranchPathHillEliminationProofData S where
  Terminal := D.Terminal
  hstep := D.hstep
  hterminal := by
    intro I Inv hterm
    exact (D.hterminal I Inv hterm).toTerminalPathHillEliminationData

/-- Type-2 rerouting conclusion from concrete terminal hill-elimination data.
-/
noncomputable def reroutingConclusion
    [Fintype V]
    (D : TypeTwoBranchConcreteHillEliminationProofData S) :
    ReroutingConclusion G h L :=
  D.toPathHillEliminationProofData.reroutingConclusion

end TypeTwoBranchConcreteHillEliminationProofData

/-- Type-2 branch proof data whose terminal case is stated as ordered Claim B.2
plus the ordered finite-ascent certificate for Claim B.3. -/
structure TypeTwoBranchOrderedPathHillProofData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (S : TypeTwoIterationSetup R hpos Q) where
  Terminal : TypeTwoIterationInput R hpos S.Q0 → Prop
  hstep :
    ∀ I : TypeTwoIterationInput R hpos S.Q0,
      TypeTwoExtendedFullIterationInvariants I →
        ¬ Terminal I →
          TypeTwoExtendedFullInvariantSimplifyingActionOutcome I
  hterminal :
    ∀ I : TypeTwoIterationInput R hpos S.Q0,
      ∀ Inv : TypeTwoExtendedFullIterationInvariants I,
        Terminal I →
          TypeTwoOrderedPathHillTerminalData I Inv.full.base

namespace TypeTwoBranchOrderedPathHillProofData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {S : TypeTwoIterationSetup R hpos Q}

/-- Convert the type-2 ordered Claim B.2 plus path-hill-normal proof data to
the core terminal package consumed by the finite-descent shell. -/
noncomputable def toOrderedTerminalProofData
    (D : TypeTwoBranchOrderedPathHillProofData S) :
    TypeTwoBranchOrderedTerminalProofData S where
  Terminal := D.Terminal
  hstep := D.hstep
  hterminal := by
    intro I Inv hterm
    let T := D.hterminal I Inv hterm
    exact T.toTerminalOrderedIntersectionCoreData

/-- Reinterpret the ordered type-2 branch as a post-hill path-column branch in
the degenerate case where no terminal hill replacement changes the selected
columns. -/
noncomputable def toPathOrderedHillProofData
    (D : TypeTwoBranchOrderedPathHillProofData S) :
    TypeTwoBranchPathOrderedHillProofData S where
  Terminal := D.Terminal
  hstep := D.hstep
  hterminal := by
    intro I Inv hterm
    exact TypeTwoTerminalPathOrderedHillTerminalData.ofOrderedPathHillTerminalData
      (D.hterminal I Inv hterm)

/-- Consume the type-2 ordered path-hill-normal proof data to obtain the
rerouting conclusion. -/
theorem reroutingConclusion [Fintype V]
    (D : TypeTwoBranchOrderedPathHillProofData S) :
    ReroutingConclusion G h L :=
  D.toOrderedTerminalProofData.reroutingConclusion

end TypeTwoBranchOrderedPathHillProofData

/-- Path-level form of Claim B.3 for one branch set: the row/transversal
intersection is exactly the vertex set of a graph path.  This is stronger than
the connectedness field used downstream in the grid-minor model. -/
structure ClaimB3IntersectionPath
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (i : Fin (z h)) (j : Fin h) where
  path : GraphPath G
  vertexSet_eq : path.vertexSet = claimB3BranchSet I inv i j

namespace ClaimB3IntersectionPath

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}
variable {i : Fin (z h)} {j : Fin h}

/-- A path-shaped row/transversal intersection is connected. -/
theorem connected (P : ClaimB3IntersectionPath I inv i j) :
    claimB3BranchConnected I inv i j := by
  have hset :
      (↑P.path.vertexSet : Set V) =
        (↑(claimB3BranchSet I inv i j) : Set V) := by
    ext v
    simp [P.vertexSet_eq]
  rw [claimB3BranchConnected]
  change (G.induce (↑(claimB3BranchSet I inv i j) : Set V)).Connected
  rw [← hset]
  exact GraphPath.connected_induce_vertexSet P.path

/-- If the `j`-th selected transversal has a path-shaped trace on the `i`-th
row, then the corresponding row-column branch set is path-shaped. -/
noncomputable def of_column_traceOn_row
    (htrace :
      (claimB3ColumnPath I inv j).TraceOn
        (claimB3RowPath I inv i).vertexSet) :
    ClaimB3IntersectionPath I inv i j where
  path := Classical.choose htrace
  vertexSet_eq := by
    have hP := Classical.choose_spec htrace
    rw [hP]
    ext v
    simp [claimB3BranchSet, claimB3RowPath, claimB3ColumnPath,
      Finset.mem_inter, and_comm]

end ClaimB3IntersectionPath

/-- Path-level form of Claim B.3: every terminal row/transversal intersection
is exactly the vertex set of a graph path.  The later grid-minor model only
uses connectedness, but the paper states this stronger path-shaped
intersection conclusion. -/
structure ClaimB3PathIntersections
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  intersection_path :
    ∀ i : Fin (z h), ∀ j : Fin h,
      ClaimB3IntersectionPath I inv i j

namespace ClaimB3PathIntersections

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- A row-wise `TraceOn` certificate is exactly the path-level form of
Claim B.3. -/
noncomputable def of_column_traceOn_rows
    (H : ∀ i : Fin (z h), ∀ j : Fin h,
      (claimB3ColumnPath I inv j).TraceOn
        (claimB3RowPath I inv i).vertexSet) :
    ClaimB3PathIntersections I inv where
  intersection_path i j :=
    ClaimB3IntersectionPath.of_column_traceOn_row (H i j)

end ClaimB3PathIntersections

/-- Pure finite ascent lemma used in the maximal-hill proof of Claim B.3.
There is no predicate on a finite row set such that every witness produces
another witness on a strictly higher row. -/
theorem no_fin_row_candidate_of_strictly_higher
    {rows cols : ℕ} {Candidate : Fin rows → Fin cols → Prop}
    (hstep :
    ∀ i j, Candidate i j →
        ∃ i' j', i.1 < i'.1 ∧ Candidate i' j') :
    ∀ i j, ¬ Candidate i j := by
  classical
  let μ : Fin rows × Fin cols → ℕ := fun x => rows - x.1.1
  intro i j hij
  refine WellFounded.induction
    (C := fun x : Fin rows × Fin cols => Candidate x.1 x.2 → False)
    (InvImage.wf μ <| (Nat.lt_wfRel).2) (i, j) ?_ hij
  intro x ih hx
  rcases hstep x.1 x.2 hx with ⟨i', j', hlt, hcand⟩
  apply ih (i', j') ?_ hcand
  have hi'lt : i'.1 < rows := i'.2
  dsimp [μ]
  exact tsub_lt_tsub_left_of_le (Nat.le_of_lt hi'lt) hlt

/-- Every nonempty predicate on a finite row-column rectangle has a witness
on a row that is maximal among all witness rows.  This is the finite choice
step used in Claim B.3 before extracting the hill valley. -/
theorem exists_fin_row_candidate_maximal
    {rows cols : ℕ} {Candidate : Fin rows → Fin cols → Prop}
    (h : ∃ i j, Candidate i j) :
    ∃ i j, Candidate i j ∧
      ∀ i' j', Candidate i' j' → i'.1 ≤ i.1 := by
  classical
  by_contra hno
  have hstep :
      ∀ i j, Candidate i j →
        ∃ i' j', i.1 < i'.1 ∧ Candidate i' j' := by
    intro i j hij
    by_contra hnone
    apply hno
    refine ⟨i, j, hij, ?_⟩
    intro i' j' hij'
    by_contra hle
    exact hnone ⟨i', j', Nat.lt_of_not_ge hle, hij'⟩
  rcases h with ⟨i, j, hij⟩
  exact no_fin_row_candidate_of_strictly_higher hstep i j hij

/-- Hill-normal terminal certificate for Claim B.3.

The paper proves Claim B.3 by contradiction: a disconnected intersection gives
a local valley/hill candidate on some row, and in the no-hill terminal state
the blocker on the row interval gives another hill candidate on a strictly
higher row.  The finite-ascent theorem above then rules out all such
candidates.  This certificate exposes exactly those two geometric ingredients:
`candidate_of_disconnected` is the valley-extraction lemma, and
`higher_candidate_of_candidate` is the no-cross blocker/barrier lemma. -/
structure ClaimB3HillNormalCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  HillCandidate : Fin (z h) → Fin h → Prop
  candidate_of_disconnected :
    (∃ i : Fin (z h), ∃ j : Fin h,
      ¬ claimB3BranchConnected I inv i j) →
      ∃ i : Fin (z h), ∃ j : Fin h, HillCandidate i j
  higher_candidate_of_candidate :
    ∀ i : Fin (z h), ∀ j : Fin h, HillCandidate i j →
      ∃ i' : Fin (z h), ∃ j' : Fin h,
        i.1 < i'.1 ∧ HillCandidate i' j'

/-- Interval-convex terminal normal form for Claim B.3: after hill
elimination, each selected transversal meets each row in a convex interval of
the transversal path. -/
def ClaimB3TraceConvexNormalForm
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) : Prop :=
  ∀ i : Fin (z h), ∀ j : Fin h,
    GraphPathTraceConvex (claimB3ColumnPath I inv j)
      (claimB3RowPath I inv i).vertexSet

namespace ClaimB3PathIntersections

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- The convex normal form supplied by hill elimination gives the paper's
path-shaped intersection conclusion. -/
noncomputable def of_traceConvexNormalForm
    (H : ClaimB3TraceConvexNormalForm I inv) :
    ClaimB3PathIntersections I inv :=
  of_column_traceOn_rows (by
    intro i j
    have hne_row_col :=
      selectedColumn_currentRow_inter_nonempty I inv.orderedRows i j
    have hne_col_row :
        ((claimB3ColumnPath I inv j).vertexSet ∩
          (claimB3RowPath I inv i).vertexSet).Nonempty := by
      rcases hne_row_col with ⟨v, hv⟩
      exact ⟨v, by
        simpa [claimB3ColumnPath, claimB3RowPath,
          claimB3BranchSet, Finset.mem_inter, and_comm] using hv⟩
    exact graphPath_traceOn_of_traceConvex hne_col_row (H i j))

end ClaimB3PathIntersections

namespace ClaimB3HillNormalCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- The maximal-valley proof of Claim B.3, in finite form.  If disconnected
row intersections produced hill candidates and every candidate forced a
strictly higher one, no disconnected row intersection can exist. -/
theorem branch_connected (C : ClaimB3HillNormalCertificate I inv)
    (i : Fin (z h)) (j : Fin h) :
    claimB3BranchConnected I inv i j := by
  classical
  by_contra hdisc
  rcases C.candidate_of_disconnected ⟨i, j, hdisc⟩ with
    ⟨i₀, j₀, hcand⟩
  exact no_fin_row_candidate_of_strictly_higher
      (Candidate := C.HillCandidate)
      C.higher_candidate_of_candidate i₀ j₀ hcand

end ClaimB3HillNormalCertificate

/-! ### Concrete hill candidates for Claim B.3 -/

/-- A concrete hill candidate in the terminal trace.

The candidate is the path segment `segment` of the `j`-th selected transversal
whose endpoints lie on row `row`, which hits the immediately lower row
`lower`, and whose internal vertices meet no row except that lower row.  The
last cleanliness field is deliberately stated against the union of all current
rows except `lower`; this is the Lean form of “the segment only goes down one
row and comes back.” -/
structure ClaimB3HillCandidateData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  row : Fin (z h)
  col : Fin h
  lower : Fin (z h)
  lower_succ : lower.1 + 1 = row.1
  left : V
  right : V
  left_mem_row : left ∈ (claimB3RowPath I inv row).vertexSet
  right_mem_row : right ∈ (claimB3RowPath I inv row).vertexSet
  left_before_right : (claimB3RowPath I inv row).Before left right
  segment : GraphPath G
  segment_connects : segment.Connects {left} {right}
  segment_subset_column :
    segment.vertexSet ⊆ (claimB3ColumnPath I inv col).vertexSet
  segment_edgeSet_subset_column :
    segment.edgeSet ⊆ (claimB3ColumnPath I inv col).edgeSet
  hits_lower : HitsGraphPath segment (claimB3RowPath I inv lower)
  internally_disjoint_from_other_rows :
    segment.InternallyDisjointFromSet
      (Finset.univ.biUnion fun r : Fin (z h) =>
        if r = lower then ∅ else (claimB3RowPath I inv r).vertexSet)

/-- A witness that the selected transversal does not meet one row in a convex
interval: two row-contact vertices of the column have a column vertex between
them that is not on the row. -/
structure ClaimB3NonconvexTrace
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I)
    (row : Fin (z h)) (col : Fin h) where
  left : V
  middle : V
  right : V
  left_mem :
    left ∈ (claimB3ColumnPath I inv col).vertexSet ∩
      (claimB3RowPath I inv row).vertexSet
  right_mem :
    right ∈ (claimB3ColumnPath I inv col).vertexSet ∩
      (claimB3RowPath I inv row).vertexSet
  middle_mem_column : middle ∈ (claimB3ColumnPath I inv col).vertexSet
  left_before_middle :
    (claimB3ColumnPath I inv col).Before left middle
  middle_before_right :
    (claimB3ColumnPath I inv col).Before middle right
  middle_not_mem_row :
    middle ∉ (claimB3RowPath I inv row).vertexSet

namespace ClaimB3NonconvexTrace

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}
variable {i : Fin (z h)} {j : Fin h}

/-- A disconnected branch set gives a non-convex row trace unless the branch
set was already connected by the first-hit/last-hit segment argument. -/
theorem of_not_branchConnected
    (hdisc : ¬ claimB3BranchConnected I inv i j) :
    Nonempty (ClaimB3NonconvexTrace I inv i j) := by
  classical
  by_contra hnone
  have hconv :
      GraphPathTraceConvex (claimB3ColumnPath I inv j)
        (claimB3RowPath I inv i).vertexSet := by
    intro a b c ha hc hb hab hbc
    by_contra hbrow
    exact hnone ⟨{
      left := a
      middle := b
      right := c
      left_mem := ha
      right_mem := hc
      middle_mem_column := hb
      left_before_middle := hab
      middle_before_right := hbc
      middle_not_mem_row := hbrow
    }⟩
  have hne_row_col :=
    selectedColumn_currentRow_inter_nonempty I inv.orderedRows i j
  have hne_col_row :
      ((claimB3ColumnPath I inv j).vertexSet ∩
        (claimB3RowPath I inv i).vertexSet).Nonempty := by
    rcases hne_row_col with ⟨v, hv⟩
    exact ⟨v, by
      simpa [claimB3ColumnPath, claimB3RowPath,
        claimB3BranchSet, Finset.mem_inter, and_comm] using hv⟩
  have htrace :
      (claimB3ColumnPath I inv j).TraceOn
        (claimB3RowPath I inv i).vertexSet :=
    graphPath_traceOn_of_traceConvex hne_col_row hconv
  exact hdisc
    (ClaimB3IntersectionPath.connected
      (ClaimB3IntersectionPath.of_column_traceOn_row htrace))

end ClaimB3NonconvexTrace

/-- A non-convex row trace chosen on a maximal possible row.  The paper's
proof of Claim B.3 first makes this maximal choice and only then extracts the
down-and-back hill interval; without maximality the corresponding finite-list
statement is false for an arbitrary non-convex row. -/
structure ClaimB3MaximalNonconvexTrace
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  row : Fin (z h)
  col : Fin h
  witness : ClaimB3NonconvexTrace I inv row col
  row_maximal :
    ∀ i : Fin (z h), ∀ j : Fin h,
      Nonempty (ClaimB3NonconvexTrace I inv i j) → i.1 ≤ row.1

namespace ClaimB3MaximalNonconvexTrace

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- A maximal non-convex trace exists whenever there is any non-convex trace. -/
theorem exists_of_any
    (hbad : ∃ i : Fin (z h), ∃ j : Fin h,
      Nonempty (ClaimB3NonconvexTrace I inv i j)) :
    Nonempty (ClaimB3MaximalNonconvexTrace I inv) := by
  classical
  rcases exists_fin_row_candidate_maximal
      (Candidate := fun i : Fin (z h) => fun j : Fin h =>
        Nonempty (ClaimB3NonconvexTrace I inv i j)) hbad with
    ⟨i, j, ⟨N⟩, hmax⟩
  exact ⟨{
    row := i
    col := j
    witness := N
    row_maximal := hmax
  }⟩

end ClaimB3MaximalNonconvexTrace

/-- The interval-convex row-normal form is equivalent to the absence of a
non-convex three-point witness on every row/column pair. -/
theorem claimB3TraceConvexNormalForm_iff_no_nonconvex_trace
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I} :
    ClaimB3TraceConvexNormalForm I inv ↔
      ∀ i : Fin (z h), ∀ j : Fin h,
        ¬ Nonempty (ClaimB3NonconvexTrace I inv i j) := by
  constructor
  · intro H i j hbad
    rcases hbad with ⟨N⟩
    exact N.middle_not_mem_row
      (H i j N.left_mem N.right_mem N.middle_mem_column
        N.left_before_middle N.middle_before_right)
  · intro H i j a b c ha hc hb hab hbc
    by_contra hbrow
    exact H i j ⟨{
      left := a
      middle := b
      right := c
      left_mem := ha
      right_mem := hc
      middle_mem_column := hb
      left_before_middle := hab
      middle_before_right := hbc
      middle_not_mem_row := hbrow
    }⟩

namespace ClaimB3PathIntersections

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- The no-nonconvex-witness form gives the paper's path-shaped
intersection conclusion. -/
noncomputable def of_no_nonconvex_trace
    (H : ∀ i : Fin (z h), ∀ j : Fin h,
      ¬ Nonempty (ClaimB3NonconvexTrace I inv i j)) :
    ClaimB3PathIntersections I inv :=
  of_traceConvexNormalForm
    ((claimB3TraceConvexNormalForm_iff_no_nonconvex_trace).2 H)

end ClaimB3PathIntersections

/-! ### Path-level maximal-hill form of Claim B.3 -/

/-- Path-level hill-normal certificate for Claim B.3.

This is the exact finite shape of the paper's Claim B.3 proof: if some
row/transversal trace is non-convex, choose a maximal offending row and obtain
a concrete hill candidate; if no free hill remains, the blocker/barrier
argument produces a hill candidate on a strictly higher row.  Finite ascent
then rules out every non-convex trace, giving path-shaped intersections. -/
structure ClaimB3PathHillNormalCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  HillCandidate : Fin (z h) → Fin h → Prop
  candidate_of_nonconvex_trace :
    (∃ i : Fin (z h), ∃ j : Fin h,
      Nonempty (ClaimB3NonconvexTrace I inv i j)) →
      ∃ i : Fin (z h), ∃ j : Fin h, HillCandidate i j
  higher_candidate_of_candidate :
    ∀ i : Fin (z h), ∀ j : Fin h, HillCandidate i j →
      ∃ i' : Fin (z h), ∃ j' : Fin h,
        i.1 < i'.1 ∧ HillCandidate i' j'

namespace ClaimB3PathHillNormalCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- The path-level maximal-valley proof of Claim B.3. -/
noncomputable def pathIntersections
    (C : ClaimB3PathHillNormalCertificate I inv) :
    ClaimB3PathIntersections I inv := by
  refine ClaimB3PathIntersections.of_no_nonconvex_trace ?_
  intro i j hbad
  rcases C.candidate_of_nonconvex_trace ⟨i, j, hbad⟩ with
    ⟨i₀, j₀, hcand⟩
  exact no_fin_row_candidate_of_strictly_higher
      (Candidate := C.HillCandidate)
      C.higher_candidate_of_candidate i₀ j₀ hcand

end ClaimB3PathHillNormalCertificate

namespace ClaimB3HillCandidateData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- The row interval between the endpoints of a hill candidate. -/
noncomputable def rowInterval (C : ClaimB3HillCandidateData I inv) :
    GraphPath G :=
  (claimB3RowPath I inv C.row).segmentOfBefore C.left_before_right

@[simp] theorem rowInterval_source (C : ClaimB3HillCandidateData I inv) :
    C.rowInterval.source = C.left := rfl

@[simp] theorem rowInterval_target (C : ClaimB3HillCandidateData I inv) :
    C.rowInterval.target = C.right := rfl

theorem row_pos (C : ClaimB3HillCandidateData I inv) : 0 < C.row.1 := by
  have h := C.lower_succ
  omega

theorem lower_lt_row (C : ClaimB3HillCandidateData I inv) :
    C.lower.1 < C.row.1 := by
  have h := C.lower_succ
  omega

/-- The hill candidate's column segment oriented from the left row endpoint to
the right row endpoint.  The stored segment is deliberately unoriented; the
hill replacement uses this orientation when it swaps the off-row excursion
with the row interval. -/
noncomputable def orientedSegment (C : ClaimB3HillCandidateData I inv) :
    GraphPath G :=
  C.segment.orient C.segment_connects

@[simp] theorem orientedSegment_vertexSet (C : ClaimB3HillCandidateData I inv) :
    C.orientedSegment.vertexSet = C.segment.vertexSet := by
  simp [orientedSegment]

@[simp] theorem orientedSegment_edgeSet (C : ClaimB3HillCandidateData I inv) :
    C.orientedSegment.edgeSet = C.segment.edgeSet := by
  simp [orientedSegment]

@[simp] theorem orientedSegment_source (C : ClaimB3HillCandidateData I inv) :
    C.orientedSegment.source = C.left := by
  have hleft : C.orientedSegment.source ∈ ({C.left} : Finset V) :=
    GraphPath.orient_source_mem C.segment C.segment_connects
  simpa [orientedSegment] using hleft

@[simp] theorem orientedSegment_target (C : ClaimB3HillCandidateData I inv) :
    C.orientedSegment.target = C.right := by
  have hright : C.orientedSegment.target ∈ ({C.right} : Finset V) :=
    GraphPath.orient_target_mem C.segment C.segment_connects
  simpa [orientedSegment] using hright

/-- The left endpoint of a hill candidate lies on its selected column. -/
theorem left_mem_column (C : ClaimB3HillCandidateData I inv) :
    C.left ∈ (claimB3ColumnPath I inv C.col).vertexSet := by
  classical
  have hleft_seg : C.left ∈ C.segment.vertexSet := by
    rcases C.segment_connects with h | h
    · have hs : C.segment.source = C.left := by
        simpa using h.1
      simpa [hs] using GraphPath.source_mem_vertexSet C.segment
    · have ht : C.segment.target = C.left := by
        simpa using h.2
      simpa [ht] using GraphPath.target_mem_vertexSet C.segment
  exact C.segment_subset_column hleft_seg

/-- The right endpoint of a hill candidate lies on its selected column. -/
theorem right_mem_column (C : ClaimB3HillCandidateData I inv) :
    C.right ∈ (claimB3ColumnPath I inv C.col).vertexSet := by
  classical
  have hright_seg : C.right ∈ C.segment.vertexSet := by
    rcases C.segment_connects with h | h
    · have ht : C.segment.target = C.right := by
        simpa using h.2
      simpa [ht] using GraphPath.target_mem_vertexSet C.segment
    · have hs : C.segment.source = C.right := by
        simpa using h.1
      simpa [hs] using GraphPath.source_mem_vertexSet C.segment
  exact C.segment_subset_column hright_seg

/-- The oriented hill segment still lies on its selected post-hill column. -/
theorem orientedSegment_vertexSet_subset_column
    (C : ClaimB3HillCandidateData I inv) :
    C.orientedSegment.vertexSet ⊆
      (claimB3ColumnPath I inv C.col).vertexSet := by
  intro v hv
  exact C.segment_subset_column (by simpa using hv)

/-- The oriented hill segment uses only edges of its selected post-hill
column. -/
theorem orientedSegment_edgeSet_subset_column
    (C : ClaimB3HillCandidateData I inv) :
    C.orientedSegment.edgeSet ⊆
      (claimB3ColumnPath I inv C.col).edgeSet := by
  intro e he
  exact C.segment_edgeSet_subset_column (by simpa using he)

/-- On the selected column, the two endpoints of a hill candidate have one of
the two possible linear orders.  Hill replacement can branch on this theorem
to choose the correct prefix/suffix orientation of the column path. -/
theorem column_left_before_right_or_right_before_left
    (C : ClaimB3HillCandidateData I inv) :
    (claimB3ColumnPath I inv C.col).Before C.left C.right ∨
      (claimB3ColumnPath I inv C.col).Before C.right C.left := by
  classical
  let Col : GraphPath G := claimB3ColumnPath I inv C.col
  have hleft : C.left ∈ Col.vertexSet := by
    simpa [Col] using C.left_mem_column
  have hright : C.right ∈ Col.vertexSet := by
    simpa [Col] using C.right_mem_column
  rcases le_total (Col.vertexIndex C.left) (Col.vertexIndex C.right) with hle | hle
  · exact Or.inl ((Col.before_iff_vertexIndex_le).2 ⟨hleft, hright, hle⟩)
  · exact Or.inr ((Col.before_iff_vertexIndex_le).2 ⟨hright, hleft, hle⟩)

/-- Path data for the hill replacement of a selected column.

The path has the same endpoints as the old column and uses only old column
edges plus the row interval between the hill endpoints.  It is obtained by
concatenating the appropriate column prefix, the row interval in the needed
orientation, and the appropriate column suffix, followed by cycle erasure. -/
structure ReplacementColumnPath (C : ClaimB3HillCandidateData I inv) where
  path : GraphPath G
  source_eq : path.source = (claimB3ColumnPath I inv C.col).source
  target_eq : path.target = (claimB3ColumnPath I inv C.col).target
  vertexSet_subset :
    path.vertexSet ⊆
      (claimB3ColumnPath I inv C.col).vertexSet ∪ C.rowInterval.vertexSet
  edgeSet_subset :
    path.edgeSet ⊆
      (claimB3ColumnPath I inv C.col).edgeSet ∪ C.rowInterval.edgeSet

/-- Construct the path obtained by replacing a hill segment by its row
interval.  The construction branches on the order of the two hill endpoints
on the selected column, so it also covers the reversed-transversal case. -/
noncomputable def replacementColumnPath
    (C : ClaimB3HillCandidateData I inv) :
  ReplacementColumnPath C := by
  classical
  let Col : GraphPath G := claimB3ColumnPath I inv C.col
  by_cases hLR : Col.Before C.left C.right
  · let pre : GraphPath G := Col.takeUntil (by simpa [Col] using C.left_mem_column)
    let mid : GraphPath G := C.rowInterval
    let suf : GraphPath G := Col.dropUntil (by simpa [Col] using C.right_mem_column)
    have hpre_mid : pre.target = mid.source := by
      simp [pre, mid, Col]
    have hmid_suf : mid.target = suf.source := by
      simp [mid, suf, Col]
    let whole : GraphPath G :=
      pre.append3WithEqToPath mid suf hpre_mid hmid_suf
    refine
      { path := whole
        source_eq := ?_
        target_eq := ?_
        vertexSet_subset := ?_
        edgeSet_subset := ?_ }
    · simp [whole, pre, Col]
    · simp [whole, suf, Col]
    · intro v hv
      have hvparts :
          v ∈ pre.vertexSet ∪ mid.vertexSet ∪ suf.vertexSet :=
        GraphPath.append3WithEqToPath_vertexSet_subset
          pre mid suf hpre_mid hmid_suf hv
      rcases Finset.mem_union.1 hvparts with hvpm | hvsuf
      · rcases Finset.mem_union.1 hvpm with hvpre | hvmid
        · exact Finset.mem_union.2 <| Or.inl <|
            Col.takeUntil_vertexSet_subset
              (by simpa [Col] using C.left_mem_column)
              (by simpa [pre] using hvpre)
        · exact Finset.mem_union.2 <| Or.inr <|
            by simpa [mid] using hvmid
      · exact Finset.mem_union.2 <| Or.inl <|
          Col.dropUntil_vertexSet_subset
            (by simpa [Col] using C.right_mem_column)
            (by simpa [suf] using hvsuf)
    · intro e he
      have heparts :
          e ∈ pre.edgeSet ∪ mid.edgeSet ∪ suf.edgeSet :=
        GraphPath.append3WithEqToPath_edgeSet_subset
          pre mid suf hpre_mid hmid_suf he
      rcases Finset.mem_union.1 heparts with hepm | hesuf
      · rcases Finset.mem_union.1 hepm with hepre | hemid
        · exact Finset.mem_union.2 <| Or.inl <|
            Col.takeUntil_edgeSet_subset
              (by simpa [Col] using C.left_mem_column)
              (by simpa [pre] using hepre)
        · exact Finset.mem_union.2 <| Or.inr <|
            by simpa [mid] using hemid
      · exact Finset.mem_union.2 <| Or.inl <|
          Col.dropUntil_edgeSet_subset
            (by simpa [Col] using C.right_mem_column)
            (by simpa [suf] using hesuf)
  · let pre : GraphPath G := Col.takeUntil (by simpa [Col] using C.right_mem_column)
    let mid : GraphPath G := C.rowInterval.reverse
    let suf : GraphPath G := Col.dropUntil (by simpa [Col] using C.left_mem_column)
    have hpre_mid : pre.target = mid.source := by
      simp [pre, mid, Col]
    have hmid_suf : mid.target = suf.source := by
      simp [mid, suf, Col]
    let whole : GraphPath G :=
      pre.append3WithEqToPath mid suf hpre_mid hmid_suf
    refine
      { path := whole
        source_eq := ?_
        target_eq := ?_
        vertexSet_subset := ?_
        edgeSet_subset := ?_ }
    · simp [whole, pre, Col]
    · simp [whole, suf, Col]
    · intro v hv
      have hvparts :
          v ∈ pre.vertexSet ∪ mid.vertexSet ∪ suf.vertexSet :=
        GraphPath.append3WithEqToPath_vertexSet_subset
          pre mid suf hpre_mid hmid_suf hv
      rcases Finset.mem_union.1 hvparts with hvpm | hvsuf
      · rcases Finset.mem_union.1 hvpm with hvpre | hvmid
        · exact Finset.mem_union.2 <| Or.inl <|
            Col.takeUntil_vertexSet_subset
              (by simpa [Col] using C.right_mem_column)
              (by simpa [pre] using hvpre)
        · exact Finset.mem_union.2 <| Or.inr <|
            by simpa [mid] using hvmid
      · exact Finset.mem_union.2 <| Or.inl <|
          Col.dropUntil_vertexSet_subset
            (by simpa [Col] using C.left_mem_column)
            (by simpa [suf] using hvsuf)
    · intro e he
      have heparts :
          e ∈ pre.edgeSet ∪ mid.edgeSet ∪ suf.edgeSet :=
        GraphPath.append3WithEqToPath_edgeSet_subset
          pre mid suf hpre_mid hmid_suf he
      rcases Finset.mem_union.1 heparts with hepm | hesuf
      · rcases Finset.mem_union.1 hepm with hepre | hemid
        · exact Finset.mem_union.2 <| Or.inl <|
            Col.takeUntil_edgeSet_subset
              (by simpa [Col] using C.right_mem_column)
              (by simpa [pre] using hepre)
        · exact Finset.mem_union.2 <| Or.inr <|
            by simpa [mid] using hemid
      · exact Finset.mem_union.2 <| Or.inl <|
          Col.dropUntil_edgeSet_subset
            (by simpa [Col] using C.left_mem_column)
            (by simpa [suf] using hesuf)

end ClaimB3HillCandidateData

/-- Endpoint data produced by the no-cross blocker barrier in Claim B.3.
Starting from a hill candidate on row `C.row`, the blocker path supplies a
column segment whose endpoints lie on the immediately higher row and whose
only internal row contacts lie on `C.row`.  This structure records exactly the
data needed to turn that blocker into the next hill candidate. -/
structure ClaimB3HigherHillFromBlockerData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    (inv : TypeOneIterationInvariants I)
    (C : ClaimB3HillCandidateData I inv) (j' : Fin h) where
  upper : Fin (z h)
  upper_succ : C.row.1 + 1 = upper.1
  left : V
  right : V
  left_mem_upper : left ∈ (claimB3RowPath I inv upper).vertexSet
  right_mem_upper : right ∈ (claimB3RowPath I inv upper).vertexSet
  left_before_right : (claimB3RowPath I inv upper).Before left right
  segment : GraphPath G
  segment_connects : segment.Connects {left} {right}
  segment_subset_column :
    segment.vertexSet ⊆ (claimB3ColumnPath I inv j').vertexSet
  segment_edgeSet_subset_column :
    segment.edgeSet ⊆ (claimB3ColumnPath I inv j').edgeSet
  hits_lower : HitsGraphPath segment (claimB3RowPath I inv C.row)
  internally_disjoint_from_other_rows :
    segment.InternallyDisjointFromSet
      (Finset.univ.biUnion fun r : Fin (z h) =>
        if r = C.row then ∅ else (claimB3RowPath I inv r).vertexSet)

namespace ClaimB3HigherHillFromBlockerData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}
variable {C : ClaimB3HillCandidateData I inv} {j' : Fin h}

/-- The blocker-barrier endpoint data is exactly a hill candidate on the next
higher row. -/
noncomputable def toHillCandidateData
    (D : ClaimB3HigherHillFromBlockerData inv C j') :
    ClaimB3HillCandidateData I inv where
  row := D.upper
  col := j'
  lower := C.row
  lower_succ := D.upper_succ
  left := D.left
  right := D.right
  left_mem_row := D.left_mem_upper
  right_mem_row := D.right_mem_upper
  left_before_right := D.left_before_right
  segment := D.segment
  segment_connects := D.segment_connects
  segment_subset_column := D.segment_subset_column
  segment_edgeSet_subset_column := D.segment_edgeSet_subset_column
  hits_lower := D.hits_lower
  internally_disjoint_from_other_rows := D.internally_disjoint_from_other_rows

/-- The new hill candidate is strictly higher than the original one. -/
theorem row_lt_toHillCandidateData
    (D : ClaimB3HigherHillFromBlockerData inv C j') :
    C.row.1 < (D.toHillCandidateData).row.1 := by
  dsimp [toHillCandidateData]
  have h := D.upper_succ
  omega

end ClaimB3HigherHillFromBlockerData

/-- A hill is a hill candidate whose row interval is free of every other
selected transversal.  This is exactly the row-segment replacement condition
used in the paper before cycle deletion. -/
structure ClaimB3Hill
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  candidate : ClaimB3HillCandidateData I inv
  rowInterval_free_of_other_columns :
    ∀ j' : Fin h, j' ≠ candidate.col →
      Disjoint candidate.rowInterval.vertexSet
        (claimB3ColumnPath I inv j').vertexSet

/-- The hill-elimination normal form: no free hill candidate remains. -/
def ClaimB3NoHill
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) : Prop :=
  ¬ Nonempty (ClaimB3Hill I inv)

namespace ClaimB3NoHill

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- If no hill remains, then every hill candidate has a blocker: some other
selected transversal meets the row interval between the candidate endpoints.
This is the first formal step in the proof of Claim B.3 after choosing the
maximal candidate. -/
theorem exists_blocker (hno : ClaimB3NoHill I inv)
    (C : ClaimB3HillCandidateData I inv) :
    ∃ j' : Fin h, j' ≠ C.col ∧
      ¬ Disjoint C.rowInterval.vertexSet
        (claimB3ColumnPath I inv j').vertexSet := by
  classical
  by_contra hblock
  apply hno
  refine ⟨{
    candidate := C
    rowInterval_free_of_other_columns := ?_
  }⟩
  intro j' hj'
  by_contra hdisj
  exact hblock ⟨j', hj', hdisj⟩

/-- Vertex form of `exists_blocker`: if a hill candidate is not free, an
explicit different selected column meets its row interval. -/
theorem exists_blocker_vertex (hno : ClaimB3NoHill I inv)
    (C : ClaimB3HillCandidateData I inv) :
    ∃ j' : Fin h, ∃ v : V,
      j' ≠ C.col ∧ v ∈ C.rowInterval.vertexSet ∧
        v ∈ (claimB3ColumnPath I inv j').vertexSet := by
  classical
  rcases hno.exists_blocker C with ⟨j', hj', hblock⟩
  rcases (Finset.not_disjoint_iff.1 hblock) with ⟨v, hvrow, hvcol⟩
  exact ⟨j', v, hj', hvrow, hvcol⟩

end ClaimB3NoHill

/-- The no-cross barrier step used in Claim B.3 after the blocker has been
found.  A blocker on the row interval of a hill candidate forces another hill
candidate on a strictly higher row. -/
structure ClaimB3BlockerBarrierCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  no_hill : ClaimB3NoHill I inv
  candidate_of_disconnected :
    (∃ i : Fin (z h), ∃ j : Fin h,
      ¬ claimB3BranchConnected I inv i j) →
      Nonempty (ClaimB3HillCandidateData I inv)
  higher_candidate_of_blocker :
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          ∃ C' : ClaimB3HillCandidateData I inv, C.row.1 < C'.row.1

/-- More detailed Claim B.3 proof package.  It separates the proof into the
same three conceptual steps as the paper: non-convexity produces a valley
candidate; hill-normality supplies a blocker; the no-cross barrier turns the
blocker into a higher valley. -/
structure ClaimB3ValleyExtractionBarrierCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  no_hill : ClaimB3NoHill I inv
  candidate_of_nonconvexity :
    ∀ i : Fin (z h), ∀ j : Fin h,
      ClaimB3NonconvexTrace I inv i j →
        Nonempty (ClaimB3HillCandidateData I inv)
  higher_candidate_of_blocker :
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          ∃ C' : ClaimB3HillCandidateData I inv, C.row.1 < C'.row.1

/-- Path-level blocker/barrier package for Claim B.3.  It starts from a
non-convex trace, not only from a disconnected induced branch set, and
therefore feeds the stronger path-shaped conclusion. -/
structure ClaimB3PathBlockerBarrierCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  no_hill : ClaimB3NoHill I inv
  candidate_of_nonconvex_trace :
    (∃ i : Fin (z h), ∃ j : Fin h,
      Nonempty (ClaimB3NonconvexTrace I inv i j)) →
      Nonempty (ClaimB3HillCandidateData I inv)
  higher_candidate_of_blocker :
    ∀ C : ClaimB3HillCandidateData I inv,
      ∀ j' : Fin h, j' ≠ C.col →
        ¬ Disjoint C.rowInterval.vertexSet
          (claimB3ColumnPath I inv j').vertexSet →
          ∃ C' : ClaimB3HillCandidateData I inv, C.row.1 < C'.row.1

/-- Concrete Lean-facing form of the terminal part of Claim B.3.

The fields correspond to the two nontrivial paragraphs of the informal proof:
disconnected row intersections yield a hill candidate, and if no hill remains
then the blocker/barrier argument yields another candidate on a strictly
higher row. -/
structure ClaimB3ConcreteHillAscentCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  no_hill : ClaimB3NoHill I inv
  candidate_of_disconnected :
    (∃ i : Fin (z h), ∃ j : Fin h,
      ¬ claimB3BranchConnected I inv i j) →
      Nonempty (ClaimB3HillCandidateData I inv)
  higher_candidate_of_candidate :
    ClaimB3NoHill I inv →
    ∀ C : ClaimB3HillCandidateData I inv,
      ∃ C' : ClaimB3HillCandidateData I inv, C.row.1 < C'.row.1

/-- Concrete path-level version of the terminal Claim B.3 hill-ascent package.

Unlike `ClaimB3ConcreteHillAscentCertificate`, this starts from a non-convex
row trace, so its conclusion is the paper's stronger statement that
`P_i ∩ Q` is a path, not just connected. -/
structure ClaimB3ConcretePathHillAscentCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  no_hill : ClaimB3NoHill I inv
  candidate_of_nonconvex_trace :
    (∃ i : Fin (z h), ∃ j : Fin h,
      Nonempty (ClaimB3NonconvexTrace I inv i j)) →
      Nonempty (ClaimB3HillCandidateData I inv)
  higher_candidate_of_candidate :
    ClaimB3NoHill I inv →
    ∀ C : ClaimB3HillCandidateData I inv,
      ∃ C' : ClaimB3HillCandidateData I inv, C.row.1 < C'.row.1

namespace ClaimB3ConcreteHillAscentCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Convert the concrete hill-candidate ascent package into the finite
maximal-valley certificate used by the proof of Claim B.3. -/
noncomputable def toHillNormalCertificate
    (C : ClaimB3ConcreteHillAscentCertificate I inv) :
    ClaimB3HillNormalCertificate I inv where
  HillCandidate i j :=
    ∃ H : ClaimB3HillCandidateData I inv, H.row = i ∧ H.col = j
  candidate_of_disconnected := by
    intro hdisc
    rcases C.candidate_of_disconnected hdisc with ⟨H⟩
    exact ⟨H.row, H.col, H, rfl, rfl⟩
  higher_candidate_of_candidate := by
    intro i j hcandidate
    rcases hcandidate with ⟨H, hrow, hcol⟩
    rcases C.higher_candidate_of_candidate C.no_hill H with ⟨H', hlt⟩
    exact ⟨H'.row, H'.col, by simpa [hrow] using hlt, H', rfl, rfl⟩

end ClaimB3ConcreteHillAscentCertificate

namespace ClaimB3ConcretePathHillAscentCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Convert the concrete path-level hill-ascent package into the finite
maximal-hill certificate. -/
noncomputable def toPathHillNormalCertificate
    (C : ClaimB3ConcretePathHillAscentCertificate I inv) :
    ClaimB3PathHillNormalCertificate I inv where
  HillCandidate i j :=
    ∃ H : ClaimB3HillCandidateData I inv, H.row = i ∧ H.col = j
  candidate_of_nonconvex_trace := by
    intro hbad
    rcases C.candidate_of_nonconvex_trace hbad with ⟨H⟩
    exact ⟨H.row, H.col, H, rfl, rfl⟩
  higher_candidate_of_candidate := by
    intro i j hcandidate
    rcases hcandidate with ⟨H, hrow, hcol⟩
    rcases C.higher_candidate_of_candidate C.no_hill H with ⟨H', hlt⟩
    exact ⟨H'.row, H'.col, by simpa [hrow] using hlt, H', rfl, rfl⟩

end ClaimB3ConcretePathHillAscentCertificate

namespace ClaimB3PathBlockerBarrierCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- The path-level blocker/barrier package gives the concrete path-level
hill-ascent certificate. -/
noncomputable def toConcretePathHillAscentCertificate
    (C : ClaimB3PathBlockerBarrierCertificate I inv) :
    ClaimB3ConcretePathHillAscentCertificate I inv where
  no_hill := C.no_hill
  candidate_of_nonconvex_trace := C.candidate_of_nonconvex_trace
  higher_candidate_of_candidate := by
    intro hno H
    rcases hno.exists_blocker H with ⟨j', hj', hblock⟩
    exact C.higher_candidate_of_blocker H j' hj' hblock

end ClaimB3PathBlockerBarrierCertificate

namespace ClaimB3BlockerBarrierCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- The blocker-barrier package gives the concrete hill-ascent certificate. -/
noncomputable def toConcreteHillAscentCertificate
    (C : ClaimB3BlockerBarrierCertificate I inv) :
    ClaimB3ConcreteHillAscentCertificate I inv where
  no_hill := C.no_hill
  candidate_of_disconnected := C.candidate_of_disconnected
  higher_candidate_of_candidate := by
    intro hno H
    rcases hno.exists_blocker H with ⟨j', hj', hblock⟩
    exact C.higher_candidate_of_blocker H j' hj' hblock

end ClaimB3BlockerBarrierCertificate

namespace ClaimB3ValleyExtractionBarrierCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- The valley-extraction package gives the blocker-barrier package by using
the path-order lemma that disconnected intersections are non-convex traces. -/
noncomputable def toBlockerBarrierCertificate
    (C : ClaimB3ValleyExtractionBarrierCertificate I inv) :
    ClaimB3BlockerBarrierCertificate I inv where
  no_hill := C.no_hill
  candidate_of_disconnected := by
    rintro ⟨i, j, hdisc⟩
    rcases ClaimB3NonconvexTrace.of_not_branchConnected
        (I := I) (inv := inv) (i := i) (j := j) hdisc with ⟨N⟩
    exact C.candidate_of_nonconvexity i j N
  higher_candidate_of_blocker := C.higher_candidate_of_blocker

end ClaimB3ValleyExtractionBarrierCertificate

/-- Claim B.3 in the terminal stage: after hill elimination, every
row/transversal intersection is connected.  The statement is separated from
the final grid-model adjacencies so that the remaining proof obligations for
Theorem B.1 are exactly the paper's terminal Claims B.2 and B.3. -/
structure ClaimB3ConnectedIntersections
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  branch_connected :
    ∀ i : Fin (z h), ∀ j : Fin h,
      (G.induce {v : V |
        v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((Q0.selectedData (Q0.selectedColumn j)
            (Q0.selectedColumn_mem_selectedIndexSet j)).qstar.vertexSet)}).Connected

namespace ClaimB3ConnectedIntersections

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Claim B.3 from the finite hill-normal contradiction certificate. -/
theorem of_hillNormalCertificate
    (C : ClaimB3HillNormalCertificate I inv) :
    ClaimB3ConnectedIntersections I inv where
  branch_connected := by
    intro i j
    simpa [claimB3BranchConnected, claimB3BranchSet] using
      C.branch_connected i j

/-- Claim B.3 from the stronger path-level statement that every terminal
intersection is exactly a path. -/
theorem of_intersectionPaths
    (H : ∀ i : Fin (z h), ∀ j : Fin h,
      ClaimB3IntersectionPath I inv i j) :
    ClaimB3ConnectedIntersections I inv where
  branch_connected := by
    intro i j
    simpa [claimB3BranchConnected, claimB3BranchSet] using
      ClaimB3IntersectionPath.connected (H i j)

/-- The path-level Claim B.3 package implies the connected branch-set package
used by the terminal grid model. -/
theorem of_pathIntersections
    (C : ClaimB3PathIntersections I inv) :
    ClaimB3ConnectedIntersections I inv :=
  of_intersectionPaths C.intersection_path

/-- Claim B.3 from row traces of the selected transversals.  This is the
direct “`P_i ∩ Q` is a path” formulation after hill elimination. -/
theorem of_column_traceOn_rows
    (H : ∀ i : Fin (z h), ∀ j : Fin h,
      (claimB3ColumnPath I inv j).TraceOn
        (claimB3RowPath I inv i).vertexSet) :
    ClaimB3ConnectedIntersections I inv :=
  of_intersectionPaths (fun i j =>
    ClaimB3IntersectionPath.of_column_traceOn_row (H i j))

/-- Claim B.3 from the interval-convex normal form of hill elimination. -/
theorem of_traceConvexNormalForm
    (H : ClaimB3TraceConvexNormalForm I inv) :
    ClaimB3ConnectedIntersections I inv :=
  of_column_traceOn_rows (fun i j => by
    have hne_row_col :=
      selectedColumn_currentRow_inter_nonempty I inv.orderedRows i j
    have hne_col_row :
        ((claimB3ColumnPath I inv j).vertexSet ∩
          (claimB3RowPath I inv i).vertexSet).Nonempty := by
      rcases hne_row_col with ⟨v, hv⟩
      exact ⟨v, by
        simpa [claimB3ColumnPath, claimB3RowPath,
          claimB3BranchSet, Finset.mem_inter, and_comm] using hv⟩
    exact graphPath_traceOn_of_traceConvex hne_col_row (H i j))

/-- Claim B.3 from the direct negative form of the row-normality conclusion:
if no selected transversal has a non-convex trace on any current row, then all
row/transversal intersections are path-shaped.  This is the first-hit/last-hit
path argument isolated from the hill-normal maximality proof. -/
theorem of_no_nonconvex_trace
    (H : ∀ i : Fin (z h), ∀ j : Fin h,
      ¬ Nonempty (ClaimB3NonconvexTrace I inv i j)) :
    ClaimB3ConnectedIntersections I inv :=
  of_traceConvexNormalForm (by
    intro i j a b c ha hc hb hab hbc
    by_contra hbrow
    exact H i j ⟨{
      left := a
      middle := b
      right := c
      left_mem := ha
      right_mem := hc
      middle_mem_column := hb
      left_before_middle := hab
      middle_before_right := hbc
      middle_not_mem_row := hbrow
    }⟩)

/-- Claim B.3 from the concrete hill-elimination ascent argument. -/
theorem of_concreteHillAscentCertificate
    (C : ClaimB3ConcreteHillAscentCertificate I inv) :
    ClaimB3ConnectedIntersections I inv :=
  of_hillNormalCertificate C.toHillNormalCertificate

/-- Claim B.3 from the blocker-barrier form of the no-cross/hill-normal
argument. -/
theorem of_blockerBarrierCertificate
    (C : ClaimB3BlockerBarrierCertificate I inv) :
    ClaimB3ConnectedIntersections I inv :=
  of_concreteHillAscentCertificate C.toConcreteHillAscentCertificate

/-- Claim B.3 from the valley-extraction/barrier proof package. -/
theorem of_valleyExtractionBarrierCertificate
    (C : ClaimB3ValleyExtractionBarrierCertificate I inv) :
    ClaimB3ConnectedIntersections I inv :=
  of_blockerBarrierCertificate C.toBlockerBarrierCertificate

/-- Connected-branch consequence of the path-level blocker/barrier proof. -/
theorem of_pathBlockerBarrierCertificate
    (C : ClaimB3PathBlockerBarrierCertificate I inv) :
    ClaimB3ConnectedIntersections I inv :=
  of_pathIntersections
    (C.toConcretePathHillAscentCertificate.toPathHillNormalCertificate.pathIntersections)

end ClaimB3ConnectedIntersections

/-- Path-level Claim B.3 from the maximal-hill finite-ascent certificate. -/
noncomputable def claimB3_pathIntersections_of_pathHillNormalCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (C : ClaimB3PathHillNormalCertificate I inv) :
    ClaimB3PathIntersections I inv :=
  C.pathIntersections

/-- Path-level Claim B.3 from the no-hill blocker/barrier package. -/
noncomputable def claimB3_pathIntersections_of_pathBlockerBarrierCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (C : ClaimB3PathBlockerBarrierCertificate I inv) :
    ClaimB3PathIntersections I inv :=
  C.toConcretePathHillAscentCertificate.toPathHillNormalCertificate.pathIntersections

/-- Path-level Claim B.3 from the row-convex normal form: every
row/transversal intersection is exactly the vertex set of a graph path. -/
noncomputable def claimB3_pathIntersections_of_traceConvexNormalForm
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (H : ClaimB3TraceConvexNormalForm I inv) :
    ClaimB3PathIntersections I inv :=
  ClaimB3PathIntersections.of_traceConvexNormalForm H

/-- Path-level Claim B.3 from the no-nonconvex-trace normal form. -/
noncomputable def claimB3_pathIntersections_of_no_nonconvex_trace
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (H : ∀ i : Fin (z h), ∀ j : Fin h,
      ¬ Nonempty (ClaimB3NonconvexTrace I inv i j)) :
    ClaimB3PathIntersections I inv :=
  ClaimB3PathIntersections.of_traceConvexNormalForm
    ((claimB3TraceConvexNormalForm_iff_no_nonconvex_trace).2 H)

/-- Claim B.3, in the finite maximal-valley form used by the Appendix B.1
terminal argument. -/
theorem claimB3_connectedIntersections_of_hillNormalCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (C : ClaimB3HillNormalCertificate I inv) :
    ClaimB3ConnectedIntersections I inv :=
  ClaimB3ConnectedIntersections.of_hillNormalCertificate C

/-- Connected-branch version of the path-level maximal-hill proof of
Claim B.3. -/
theorem claimB3_connectedIntersections_of_pathHillNormalCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (C : ClaimB3PathHillNormalCertificate I inv) :
    ClaimB3ConnectedIntersections I inv :=
  ClaimB3ConnectedIntersections.of_pathIntersections C.pathIntersections

/-- Claim B.3 in the row-trace form: after hill elimination, if each selected
transversal has a path-shaped trace on every current row, then all terminal
branch intersections are connected. -/
theorem claimB3_connectedIntersections_of_column_traceOn_rows
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (H : ∀ i : Fin (z h), ∀ j : Fin h,
      (claimB3ColumnPath I inv j).TraceOn
        (claimB3RowPath I inv i).vertexSet) :
    ClaimB3ConnectedIntersections I inv :=
  ClaimB3ConnectedIntersections.of_column_traceOn_rows H

/-- Claim B.3 from the row-convex normal form supplied by hill elimination. -/
theorem claimB3_connectedIntersections_of_traceConvexNormalForm
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (H : ClaimB3TraceConvexNormalForm I inv) :
    ClaimB3ConnectedIntersections I inv :=
  ClaimB3ConnectedIntersections.of_traceConvexNormalForm H

/-- Claim B.3 from the equivalent no-nonconvex-trace normal form. -/
theorem claimB3_connectedIntersections_of_no_nonconvex_trace
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (H : ∀ i : Fin (z h), ∀ j : Fin h,
      ¬ Nonempty (ClaimB3NonconvexTrace I inv i j)) :
    ClaimB3ConnectedIntersections I inv :=
  ClaimB3ConnectedIntersections.of_no_nonconvex_trace H

/-- Claim B.3 from concrete hill candidates: disconnected intersections give
valleys, no-hill plus the no-cross barrier makes every valley climb to a
strictly higher row, and finite ascent is impossible. -/
theorem claimB3_connectedIntersections_of_concreteHillAscentCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (C : ClaimB3ConcreteHillAscentCertificate I inv) :
    ClaimB3ConnectedIntersections I inv :=
  ClaimB3ConnectedIntersections.of_concreteHillAscentCertificate C

/-- Claim B.3 from the blocker-barrier form: a disconnected intersection
gives a hill candidate; no-hill gives a blocker; no-cross/barrier turns the
blocker into a higher candidate; finite ascent is impossible. -/
theorem claimB3_connectedIntersections_of_blockerBarrierCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (C : ClaimB3BlockerBarrierCertificate I inv) :
    ClaimB3ConnectedIntersections I inv :=
  ClaimB3ConnectedIntersections.of_blockerBarrierCertificate C

/-- Connected-branch consequence of the path-level blocker/barrier package. -/
theorem claimB3_connectedIntersections_of_pathBlockerBarrierCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (C : ClaimB3PathBlockerBarrierCertificate I inv) :
    ClaimB3ConnectedIntersections I inv :=
  ClaimB3ConnectedIntersections.of_pathBlockerBarrierCertificate C

/-- Claim B.3 from the most detailed terminal proof package currently used in
the B.1 formalization: disconnected means non-convex, non-convex gives a
valley, no-hill gives a blocker, and no-cross/barrier gives a higher valley. -/
theorem claimB3_connectedIntersections_of_valleyExtractionBarrierCertificate
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    {inv : TypeOneIterationInvariants I}
    (C : ClaimB3ValleyExtractionBarrierCertificate I inv) :
    ClaimB3ConnectedIntersections I inv :=
  ClaimB3ConnectedIntersections.of_valleyExtractionBarrierCertificate C

/-- Claim B.2 plus the final no-cross order consequence, in the precise form
needed by the terminal grid minor model: consecutive selected intersections
are adjacent along every row and along every selected transversal.  Claim B.3
supplies connectedness separately. -/
structure ClaimB2TerminalGridAdjacencies
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  horizontal_adj :
    ∀ i : Fin (z h), ∀ ⦃j j' : Fin h⦄, FinConsecutive j j' →
      ∃ u ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((Q0.selectedData (Q0.selectedColumn j)
            (Q0.selectedColumn_mem_selectedIndexSet j)).qstar.vertexSet),
        ∃ v ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((Q0.selectedData (Q0.selectedColumn j')
            (Q0.selectedColumn_mem_selectedIndexSet j')).qstar.vertexSet),
          G.Adj u v
  vertical_adj :
    ∀ ⦃i i' : Fin (z h)⦄, FinConsecutive i i' → ∀ j : Fin h,
      ∃ u ∈ ((I.rowPath (inv.orderedRows.order.symm i)).vertexSet) ∩
          ((Q0.selectedData (Q0.selectedColumn j)
            (Q0.selectedColumn_mem_selectedIndexSet j)).qstar.vertexSet),
        ∃ v ∈ ((I.rowPath (inv.orderedRows.order.symm i')).vertexSet) ∩
          ((Q0.selectedData (Q0.selectedColumn j)
            (Q0.selectedColumn_mem_selectedIndexSet j)).qstar.vertexSet),
          G.Adj u v

namespace ClaimB3ConnectedIntersections

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Adapter from the older arbitrary selected-column statement of Claim B.3
to the explicit ordered-column interface, using that same selected order. -/
theorem toOrderedSelected
    (C : ClaimB3ConnectedIntersections I inv) :
    ClaimB3OrderedConnectedIntersections I inv
      (TerminalColumnOrder.selected Q0) where
  branch_connected := by
    intro i j
    simpa [TerminalColumnOrder.selected, TerminalColumnOrder.qstar,
      TypeOneQStarFamily.selectedData] using C.branch_connected i j

end ClaimB3ConnectedIntersections

namespace ClaimB2TerminalGridAdjacencies

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Adapter from the older arbitrary selected-column statement of Claim B.2
to the explicit ordered-column interface, using that same selected order. -/
theorem toOrderedSelected
    (C : ClaimB2TerminalGridAdjacencies I inv) :
    ClaimB2OrderedTerminalGridAdjacencies I inv
      (TerminalColumnOrder.selected Q0) where
  horizontal_adj := by
    intro i j j' hcon
    simpa [TerminalColumnOrder.selected, TerminalColumnOrder.qstar,
      TypeOneQStarFamily.selectedData] using C.horizontal_adj i hcon
  vertical_adj := by
    intro i i' hcon j
    simpa [TerminalColumnOrder.selected, TerminalColumnOrder.qstar,
      TypeOneQStarFamily.selectedData] using C.vertical_adj hcon j

end ClaimB2TerminalGridAdjacencies

namespace ClaimB3PathHillNormalCertificate

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Adapter from the older selected-column path-hill certificate for
Claim B.3 to the corrected ordered-column interface, using the same arbitrary
selected order.  This is only a compatibility adapter: the terminal no-cross
argument should normally provide a genuine common row order. -/
noncomputable def toOrderedSelected
    (C : ClaimB3PathHillNormalCertificate I inv) :
    ClaimB3OrderedPathHillNormalCertificate I inv
      (TerminalColumnOrder.selected Q0) where
  HillCandidate := C.HillCandidate
  candidate_of_nonconvex_trace := by
    intro hbad
    rcases hbad with ⟨i, j, hbadij⟩
    have hbadij' : Nonempty (ClaimB3NonconvexTrace I inv i j) := by
      rcases hbadij with ⟨N⟩
      exact ⟨{
        left := N.left
        middle := N.middle
        right := N.right
        left_mem := by
          simpa [TerminalColumnOrder.selected, TerminalColumnOrder.qstar,
            TypeOneQStarFamily.selectedData] using N.left_mem
        right_mem := by
          simpa [TerminalColumnOrder.selected, TerminalColumnOrder.qstar,
            TypeOneQStarFamily.selectedData] using N.right_mem
        middle_mem_column := by
          simpa [TerminalColumnOrder.selected, TerminalColumnOrder.qstar,
            TypeOneQStarFamily.selectedData] using N.middle_mem_column
        left_before_middle := by
          simpa [TerminalColumnOrder.selected, TerminalColumnOrder.qstar,
            TypeOneQStarFamily.selectedData] using N.left_before_middle
        middle_before_right := by
          simpa [TerminalColumnOrder.selected, TerminalColumnOrder.qstar,
            TypeOneQStarFamily.selectedData] using N.middle_before_right
        middle_not_mem_row := by
          simpa [TerminalColumnOrder.selected, TerminalColumnOrder.qstar,
            TypeOneQStarFamily.selectedData] using N.middle_not_mem_row
      }⟩
    exact C.candidate_of_nonconvex_trace ⟨i, j, hbadij'⟩
  higher_candidate_of_candidate := C.higher_candidate_of_candidate

end ClaimB3PathHillNormalCertificate

namespace OrderedPathHillTerminalData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Build the ordered terminal package from the older selected-column
Claim B.2 and path-hill Claim B.3 packages, using the selected order as the
explicit terminal order. -/
noncomputable def ofSelected
    (claimB2 : ClaimB2TerminalGridAdjacencies I inv)
    (claimB3 : ClaimB3PathHillNormalCertificate I inv) :
    OrderedPathHillTerminalData I inv where
  columns := TerminalColumnOrder.selected Q0
  claimB2 := claimB2.toOrderedSelected
  claimB3 := ⟨claimB3.toOrderedSelected⟩

end OrderedPathHillTerminalData

/-- Type-1 terminal proof data in the selected-column language: Claim B.2
for the selected transversal order, plus the selected-column path-hill proof
of Claim B.3. -/
structure SelectedPathHillTerminalData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (I : IterationInput R hpos Q0)
    (inv : TypeOneIterationInvariants I) where
  claimB2 : ClaimB2TerminalGridAdjacencies I inv
  claimB3 : ClaimB3PathHillNormalCertificate I inv

namespace SelectedPathHillTerminalData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- Convert selected-column terminal data to the corrected ordered terminal
interface by using `TerminalColumnOrder.selected`. -/
noncomputable def toOrdered
    (D : SelectedPathHillTerminalData I inv) :
    OrderedPathHillTerminalData I inv :=
  OrderedPathHillTerminalData.ofSelected D.claimB2 D.claimB3

end SelectedPathHillTerminalData

namespace TerminalIntersectionGridData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}

/-- The actual branch set at row `i`, column `j`: an intersection of the
current row path and the selected fixed `Q*` column. -/
noncomputable def branch (D : TerminalIntersectionGridData I)
    (i : Fin (z h)) (j : Fin h) : Finset V :=
  (I.rowPath (D.inv.orderedRows.order.symm i)).vertexSet ∩
    (Q0.selectedData (Q0.selectedColumn j)
      (Q0.selectedColumn_mem_selectedIndexSet j)).qstar.vertexSet

/-- The row support used by the terminal intersection model. -/
noncomputable def rowSet (D : TerminalIntersectionGridData I)
    (i : Fin (z h)) : Finset V :=
  (I.rowPath (D.inv.orderedRows.order.symm i)).vertexSet

/-- The selected column support used by the terminal intersection model. -/
noncomputable def colSet (_D : TerminalIntersectionGridData I)
    (j : Fin h) : Finset V :=
  (Q0.selectedData (Q0.selectedColumn j)
    (Q0.selectedColumn_mem_selectedIndexSet j)).qstar.vertexSet

theorem branch_subset_row (D : TerminalIntersectionGridData I)
    (i : Fin (z h)) (j : Fin h) :
    D.branch i j ⊆ D.rowSet i := by
  intro v hv
  exact (Finset.mem_inter.1 hv).1

theorem branch_subset_col (D : TerminalIntersectionGridData I)
    (i : Fin (z h)) (j : Fin h) :
    D.branch i j ⊆ D.colSet j := by
  intro v hv
  exact (Finset.mem_inter.1 hv).2

/-- Ordered rows in the terminal model are pairwise disjoint. -/
theorem rowSet_disjoint (D : TerminalIntersectionGridData I)
    ⦃i i' : Fin (z h)⦄ (hii : i ≠ i') :
    Disjoint (D.rowSet i) (D.rowSet i') := by
  classical
  have hrow_ne :
      D.inv.orderedRows.order.symm i ≠
        D.inv.orderedRows.order.symm i' := by
    intro h
    exact hii (by
      have := congrArg D.inv.orderedRows.order h
      simpa using this)
  exact D.inv.rowsNodeDisjoint hrow_ne

/-- Selected terminal columns are pairwise disjoint. -/
theorem colSet_disjoint (D : TerminalIntersectionGridData I)
    ⦃j j' : Fin h⦄ (hjj : j ≠ j') :
    Disjoint (D.colSet j) (D.colSet j') := by
  exact Q0.selectedColumn_qstar_nodeDisjoint hjj

/-- Pairwise disjointness of the row-column intersections. -/
theorem branch_disjoint (D : TerminalIntersectionGridData I)
    ⦃i i' : Fin (z h)⦄ ⦃j j' : Fin h⦄
    (hij : (i, j) ≠ (i', j')) :
    Disjoint (D.branch i j) (D.branch i' j') :=
  branch_disjoint_of_row_column_disjoint
    D.rowSet D.colSet D.branch D.branch_subset_row D.branch_subset_col
    (fun _ _ h => D.rowSet_disjoint h)
    (fun _ _ h => D.colSet_disjoint h) hij

/-- Convert terminal intersection data into a rectangular branch-set model. -/
noncomputable def toRectangularGridBranchModel
    (D : TerminalIntersectionGridData I) :
    RectangularGridBranchModel G (z h) h where
  branch := D.branch
  branch_nonempty := D.branch_nonempty
  branch_connected := D.branch_connected
  branch_disjoint := by
    intro i j i' j' hne
    exact D.branch_disjoint hne
  horizontal_adj := D.horizontal_adj
  vertical_adj := D.vertical_adj

/-- Terminal intersection data gives the concrete terminal trace certificate. -/
noncomputable def toTerminalTraceGridCertificate
    (D : TerminalIntersectionGridData I) :
    TerminalTraceGridCertificate I where
  model := D.toRectangularGridBranchModel

/-- Terminal intersection data implies the terminal grid-minor conclusion. -/
theorem containsGridMinor (D : TerminalIntersectionGridData I) :
    ContainsGridMinor G h :=
  D.toTerminalTraceGridCertificate.containsGridMinor

end TerminalIntersectionGridData

namespace TerminalIntersectionCoreData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}

/-- Bundle the two terminal claims into the core terminal intersection data.
This is the formal handoff point: after the bump/cross loop terminates, Claim
B.3 supplies connected branch sets and Claim B.2 supplies the horizontal and
vertical grid adjacencies. -/
def of_claimB2_B3
    (inv : TypeOneIterationInvariants I)
    (claimB2 : ClaimB2TerminalGridAdjacencies I inv)
    (claimB3 : ClaimB3ConnectedIntersections I inv) :
    TerminalIntersectionCoreData I where
  inv := inv
  branch_connected := claimB3.branch_connected
  horizontal_adj := claimB2.horizontal_adj
  vertical_adj := claimB2.vertical_adj

/-- Fill the full terminal intersection data from the core geometric
obligations. -/
noncomputable def toTerminalIntersectionGridData
    (D : TerminalIntersectionCoreData I) :
    TerminalIntersectionGridData I where
  inv := D.inv
  branch_nonempty := by
    intro i j
    exact selectedColumn_currentRow_inter_nonempty I D.inv.orderedRows i j
  branch_connected := D.branch_connected
  horizontal_adj := D.horizontal_adj
  vertical_adj := D.vertical_adj

/-- Core terminal data gives the terminal trace certificate. -/
noncomputable def toTerminalTraceGridCertificate
    (D : TerminalIntersectionCoreData I) :
    TerminalTraceGridCertificate I :=
  D.toTerminalIntersectionGridData.toTerminalTraceGridCertificate

/-- Core terminal data implies the grid minor. -/
theorem containsGridMinor (D : TerminalIntersectionCoreData I) :
    ContainsGridMinor G h :=
  D.toTerminalTraceGridCertificate.containsGridMinor

end TerminalIntersectionCoreData

/-- The observation recalled immediately before the definition of a bump: for
the linkages used in the iteration, connectedness of the ambient graph is meant
to imply connectedness of the corresponding auxiliary graph.  This is isolated
as the precise proposition to be proved when the bridge-splitting API is added. -/
def AuxiliaryConnectedObservation (G : _root_.SimpleGraph V) : Prop :=
  ∀ {A B : Finset V} (L' : PerfectPathPacking G A B),
    Nonempty L'.Index → G.Connected → (linkageAuxGraph L').Connected

/-- The observation used immediately before “A bump”: if the ambient graph is
connected and the linkage has at least one path, then the auxiliary graph of
the linkage is connected.  Given two linkage paths, take an ambient simple path
between their sources; filtering its linkage contacts gives a walk in
`H(L')`. -/
theorem auxiliaryConnectedObservation_of_connected :
    AuxiliaryConnectedObservation (V := V) G := by
  intro A B L' hnonempty hG
  refine {
    preconnected := ?_
    nonempty := hnonempty
  }
  intro i j
  by_cases hij : i = j
  · subst hij
    exact _root_.SimpleGraph.Reachable.refl _
  · rcases hG.exists_isPath (L'.path i).source (L'.path j).source with
      ⟨W, hW⟩
    let P : GraphPath G := {
      source := (L'.path i).source
      target := (L'.path j).source
      walk := W
      isPath := hW
    }
    have hsource_i :
        P.source ∈ (L'.path i).vertexSet := by
      simp [P]
    have htarget_j :
        P.target ∈ (L'.path j).vertexSet := by
      simp [P]
    have hsource :
        P.source ∈ L'.toPathPacking.vertexSet :=
      (L'.toPathPacking.mem_vertexSet).2 ⟨i, hsource_i⟩
    have htarget :
        P.target ∈ L'.toPathPacking.vertexSet :=
      (L'.toPathPacking.mem_vertexSet).2 ⟨j, htarget_j⟩
    have hne : P.source ≠ P.target := by
      intro hst
      have hsource_on_j :
          P.source ∈ (L'.path j).vertexSet := by
        simpa [hst] using htarget_j
      exact Finset.disjoint_left.mp (L'.toPathPacking.node_disjoint hij)
        hsource_i hsource_on_j
    have hreach :=
      endpointContactIndex_reachable_first_last
        (L := L') P hsource htarget hne
    have hfirst :
        endpointContactIndex L' P hsource htarget
            ⟨0, by simp [endpointContactTraceLen]⟩ = i :=
      endpointContactIndex_zero_eq_of_source_mem
        (L := L') (Q := P) hsource htarget hsource_i
    have hfirst' :
        endpointContactIndex L' P hsource htarget 0 = i := by
      simpa using hfirst
    have hlast :
        endpointContactIndex L' P hsource htarget
            ⟨endpointContactTraceLen L' P, by omega⟩ = j :=
      endpointContactIndex_last_eq_of_target_mem
        (L := L') (Q := P) hsource htarget htarget_j
    simpa [hfirst', hlast] using hreach

/-! ## The “A bump” local action -/

namespace IterationInput

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}

/-- The vertex set of the current row family `P₁'`. -/
noncomputable def rowVertexSet (I : IterationInput R hpos Q0) :
    Finset V :=
  Finset.univ.biUnion fun r : I.Row => (I.rowPath r).vertexSet

/-- The two fixed boundary rows for the type-1 loop, as a vertex set in the
original linkage. -/
noncomputable def typeOneBoundaryVertexSet
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h) : Finset V :=
  (L.path R.p0Index).vertexSet ∪
    (L.path (R.pZPlusOneIndex hpos)).vertexSet

/-- The original linkage vertices outside the type-1 extended block
`P₀, P₁, ..., P_z, P_{z+1}`.  These paths are never modified in the
Figure 7/Figure 8 iteration. -/
noncomputable def typeOneOutsideLinkageVertexSet
    (R : IndexedAuxiliaryPrefix L h) (hpos : 0 < h) : Finset V :=
  Finset.univ.biUnion fun j : L.Index =>
    if j ∈ typeOneAllowedIndexSet R hpos then ∅ else (L.path j).vertexSet

/-- Support invariant for a current type-1 linkage.

This is the explicit version of the paper convention
`L' = (L \ P₁) ∪ P₁'`: every vertex of the current linkage is either on a
current active row, on one of the two fixed boundary rows `P₀,P_{z+1}`, or on
an original linkage path outside the selected extended block. -/
def TypeOneLinkageSupportInvariant (I : IterationInput R hpos Q0) : Prop :=
  I.linkage.toPathPacking.vertexSet ⊆
    I.rowVertexSet ∪
      (typeOneBoundaryVertexSet (L := L) R hpos ∪
        typeOneOutsideLinkageVertexSet (L := L) R hpos)

/-- Each current row is contained in the vertex set of the current row
family. -/
theorem rowPath_vertexSet_subset_rowVertexSet
    (I : IterationInput R hpos Q0) (r : I.Row) :
    (I.rowPath r).vertexSet ⊆ I.rowVertexSet := by
  classical
  intro v hv
  rw [rowVertexSet]
  exact Finset.mem_biUnion.2 ⟨r, Finset.mem_univ r, hv⟩

/-- The current rows are still directed `A`--`B` paths.  This is one of the
concrete pieces hidden in the paper notation `L' = (L \ P₁) ∪ P₁'`. -/
def RowsConnectAB (I : IterationInput R hpos Q0) : Prop :=
  ∀ r : I.Row, (I.rowPath r).source ∈ A ∧ (I.rowPath r).target ∈ B

theorem initialRowsConnectAB (Q0 : TypeOneQStarFamily R hpos Q) :
    (initialIterationInput Q0).RowsConnectAB := by
  intro r
  exact ⟨L.source_mem _, L.target_mem _⟩

end IterationInput

/-- The initial type-1 iteration satisfies the explicit support invariant:
the original linkage is the union of the first active block, the two boundary
rows, and all outside linkage paths. -/
theorem initialIterationInput_typeOneLinkageSupportInvariant
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    (Q0 : TypeOneQStarFamily R hpos Q) :
    IterationInput.TypeOneLinkageSupportInvariant
      (initialIterationInput Q0) := by
  classical
  intro v hv
  rcases (L.toPathPacking.mem_vertexSet).1 hv with ⟨j, hvj⟩
  by_cases hjAllowed : j ∈ typeOneAllowedIndexSet R hpos
  · rw [typeOneAllowedIndexSet] at hjAllowed
    simp only [Finset.mem_insert] at hjAllowed
    rcases hjAllowed with rfl | hjAllowed
    · exact Finset.mem_union.2 (Or.inr
        (Finset.mem_union.2 (Or.inl
          (Finset.mem_union.2 (Or.inl hvj)))))
    · rcases hjAllowed with rfl | hblock
      · exact Finset.mem_union.2 (Or.inr
          (Finset.mem_union.2 (Or.inl
            (Finset.mem_union.2 (Or.inr hvj)))))
      · rw [R.mem_block1IndexSet_iff] at hblock
        rcases hblock with ⟨r, rfl⟩
        exact Finset.mem_union.2 (Or.inl (by
          rw [IterationInput.rowVertexSet]
          exact Finset.mem_biUnion.mpr ⟨r, Finset.mem_univ r, by
            simpa [initialIterationInput] using hvj⟩))
  · exact Finset.mem_union.2 (Or.inr
      (Finset.mem_union.2 (Or.inr (by
        rw [IterationInput.typeOneOutsideLinkageVertexSet]
        exact Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ j, by
          simp [hjAllowed, hvj]⟩))))

/-- Current active rows are vertex-disjoint from the fixed lower boundary
row `P₀`. -/
theorem TypeOneExtendedFullIterationInvariants.rowVertexSet_disjoint_lowerBoundary
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    (Inv : TypeOneExtendedFullIterationInvariants I) :
    Disjoint I.rowVertexSet (L.path R.p0Index).vertexSet := by
  classical
  rw [Finset.disjoint_left]
  intro v hvrow hvbound
  rw [IterationInput.rowVertexSet] at hvrow
  rcases Finset.mem_biUnion.1 hvrow with ⟨r, _hr, hvr⟩
  have hvRowLink :
      v ∈ (I.linkage.path (I.rowIndex r)).vertexSet := by
    simpa [I.rowPath_eq_linkage_path r] using hvr
  have hvBoundaryLink :
      v ∈ (I.linkage.path Inv.boundary.lowerBoundary).vertexSet := by
    simpa [Inv.boundary.lower_path_eq] using hvbound
  exact Finset.disjoint_left.mp
    (I.linkage.toPathPacking.node_disjoint (Inv.boundary.lower_ne_row r))
    hvBoundaryLink hvRowLink

/-- Current active rows are vertex-disjoint from the fixed upper boundary
row `P_{z+1}`. -/
theorem TypeOneExtendedFullIterationInvariants.rowVertexSet_disjoint_upperBoundary
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    (Inv : TypeOneExtendedFullIterationInvariants I) :
    Disjoint I.rowVertexSet
      (L.path (R.pZPlusOneIndex hpos)).vertexSet := by
  classical
  rw [Finset.disjoint_left]
  intro v hvrow hvbound
  rw [IterationInput.rowVertexSet] at hvrow
  rcases Finset.mem_biUnion.1 hvrow with ⟨r, _hr, hvr⟩
  have hvRowLink :
      v ∈ (I.linkage.path (I.rowIndex r)).vertexSet := by
    simpa [I.rowPath_eq_linkage_path r] using hvr
  have hvBoundaryLink :
      v ∈ (I.linkage.path Inv.boundary.upperBoundary).vertexSet := by
    simpa [Inv.boundary.upper_path_eq] using hvbound
  exact Finset.disjoint_left.mp
    (I.linkage.toPathPacking.node_disjoint (Inv.boundary.upper_ne_row r))
    hvBoundaryLink hvRowLink

/-- If two simple paths meet in at most one prescribed vertex, then they share
no edge.  This converts the vertex-intersection endpoint statements used in
the bump/cross replacements into edge-disjointness statements. -/
theorem graphPath_edgeDisjoint_of_vertex_inter_subset_singleton
    {P Q : GraphPath G} {x : V}
    (hinter : ∀ ⦃v : V⦄, v ∈ P.vertexSet → v ∈ Q.vertexSet → v = x) :
    P.EdgeDisjoint Q := by
  classical
  rw [GraphPath.EdgeDisjoint, Finset.disjoint_left]
  intro e heP heQ
  have heG : e ∈ G.edgeSet := P.edgeSet_subset_edgeSet heP
  have hePwalk : e ∈ P.walk.edges := by
    exact List.mem_toFinset.mp (by simpa [GraphPath.edgeSet] using heP)
  have heQwalk : e ∈ Q.walk.edges := by
    exact List.mem_toFinset.mp (by simpa [GraphPath.edgeSet] using heQ)
  have hfstP : e.out.1 ∈ P.vertexSet := by
    have hv : e.out.1 ∈ P.walk.support :=
      P.walk.mem_support_of_mem_edges hePwalk (Sym2.out_fst_mem e)
    simpa [GraphPath.vertexSet] using hv
  have hfstQ : e.out.1 ∈ Q.vertexSet := by
    have hv : e.out.1 ∈ Q.walk.support :=
      Q.walk.mem_support_of_mem_edges heQwalk (Sym2.out_fst_mem e)
    simpa [GraphPath.vertexSet] using hv
  have hsndP : e.out.2 ∈ P.vertexSet := by
    have hv : e.out.2 ∈ P.walk.support :=
      P.walk.mem_support_of_mem_edges hePwalk (Sym2.out_snd_mem e)
    simpa [GraphPath.vertexSet] using hv
  have hsndQ : e.out.2 ∈ Q.vertexSet := by
    have hv : e.out.2 ∈ Q.walk.support :=
      Q.walk.mem_support_of_mem_edges heQwalk (Sym2.out_snd_mem e)
    simpa [GraphPath.vertexSet] using hv
  have hfst : e.out.1 = x := hinter hfstP hfstQ
  have hsnd : e.out.2 = x := hinter hsndP hsndQ
  have hadj : G.Adj e.out.1 e.out.2 := by
    rw [← _root_.SimpleGraph.mem_edgeSet]
    simpa [Sym2.mk, e.out_eq] using heG
  rw [hfst, hsnd] at hadj
  exact G.loopless.irrefl x hadj

/-- Node-disjoint simple paths are edge-disjoint.  This local copy keeps the
Appendix B.1 proof independent of the later Section 4.4 helper file. -/
theorem graphPath_edgeDisjoint_of_nodeDisjoint
    {P Q : GraphPath G} (h : P.NodeDisjoint Q) :
    P.EdgeDisjoint Q := by
  classical
  rw [GraphPath.EdgeDisjoint, Finset.disjoint_left]
  intro e heP heQ
  have hePwalk : e ∈ P.walk.edges := by
    exact List.mem_toFinset.mp (by simpa [GraphPath.edgeSet] using heP)
  have heQwalk : e ∈ Q.walk.edges := by
    exact List.mem_toFinset.mp (by simpa [GraphPath.edgeSet] using heQ)
  have hvP : e.out.1 ∈ P.vertexSet := by
    have hv : e.out.1 ∈ P.walk.support :=
      P.walk.mem_support_of_mem_edges hePwalk (Sym2.out_fst_mem e)
    simpa [GraphPath.vertexSet] using hv
  have hvQ : e.out.1 ∈ Q.vertexSet := by
    have hv : e.out.1 ∈ Q.walk.support :=
      Q.walk.mem_support_of_mem_edges heQwalk (Sym2.out_fst_mem e)
    simpa [GraphPath.vertexSet] using hv
  exact Finset.disjoint_left.mp h hvP hvQ

/-- An endpoint of an edge lying on a graph path is a vertex of that path.
This is the small incidence API needed to identify which fixed `Q*` path owns
an edge of the union `Q0`. -/
theorem graphPath_mem_vertexSet_of_mem_edgeSet
    {P : GraphPath G} {e : Sym2 V} {v : V}
    (he : e ∈ P.edgeSet) (hv : v ∈ e) :
    v ∈ P.vertexSet := by
  classical
  have heWalk : e ∈ P.walk.edges := by
    exact List.mem_toFinset.mp (by simpa [GraphPath.edgeSet] using he)
  exact by
    simpa [GraphPath.vertexSet] using
      P.walk.mem_support_of_mem_edges heWalk hv

/-- If a graph path starts on an ambient simple path and every one of its
edges is an ambient-path edge, then all of its vertices lie on the ambient
path. -/
theorem graphPath_vertexSet_subset_of_edgeSet_subset_of_source_mem
    {P Q : GraphPath G}
    (hsource : Q.source ∈ P.vertexSet)
    (hedges : Q.edgeSet ⊆ P.edgeSet) :
    Q.vertexSet ⊆ P.vertexSet := by
  classical
  have aux :
      ∀ {u v : V} (W : G.Walk u v),
        u ∈ P.vertexSet →
          (∀ e : Sym2 V, e ∈ W.edges.toFinset → e ∈ P.edgeSet) →
            ∀ x : V, x ∈ W.support.toFinset → x ∈ P.vertexSet := by
    intro u v W
    induction W with
    | nil =>
        intro hu _ x hx
        simp at hx
        simpa [hx] using hu
    | @cons u v w hadj W ih =>
        intro hu hWedges x hx
        have hxList : x ∈ u :: W.support := List.mem_toFinset.mp hx
        rcases List.mem_cons.1 hxList with hx_eq | hx_tail
        · simpa [hx_eq] using hu
        · have hfirstP : s(u, v) ∈ P.edgeSet :=
            hWedges (s(u, v)) (by simp)
          have hvP : v ∈ P.vertexSet :=
            graphPath_mem_vertexSet_of_mem_edgeSet hfirstP
              (Sym2.mem_mk_right u v)
          have htail_edges :
              ∀ e : Sym2 V, e ∈ W.edges.toFinset → e ∈ P.edgeSet := by
            intro e he
            exact hWedges e (by
              have heList : e ∈ W.edges := List.mem_toFinset.mp he
              exact List.mem_toFinset.mpr (by
                simpa using List.mem_cons_of_mem (s(u, v)) heList))
          exact ih hvP htail_edges x (List.mem_toFinset.mpr hx_tail)
  intro x hx
  have hxSupport : x ∈ Q.walk.support.toFinset := by
    simpa [GraphPath.vertexSet] using hx
  exact aux Q.walk hsource
    (by
      intro e he
      exact hedges (by simpa [GraphPath.edgeSet] using he))
    x hxSupport

namespace TypeOneQStarFamily

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}

/-- Distinct selected `Q*` paths are edge-disjoint. -/
theorem qstar_edgeDisjoint_of_ne
    (F : TypeOneQStarFamily R hpos Q)
    {i j : Q.Index} {hi : i ∈ F.indices} {hj : j ∈ F.indices}
    (hne : i ≠ j) :
    (F.data i hi).qstar.EdgeDisjoint (F.data j hj).qstar :=
  graphPath_edgeDisjoint_of_nodeDisjoint (F.qstar_nodeDisjoint_of_ne hne)

/-- An edge of the fixed family `Q0` has a unique owning selected
transversal path. -/
theorem qstar_owner_eq_of_edge_mem
    (F : TypeOneQStarFamily R hpos Q)
    {i j : Q.Index} {hi : i ∈ F.indices} {hj : j ∈ F.indices}
    {e : Sym2 V}
    (hei : e ∈ (F.data i hi).qstar.edgeSet)
    (hej : e ∈ (F.data j hj).qstar.edgeSet) :
    i = j := by
  by_contra hne
  exact Finset.disjoint_left.mp (F.qstar_edgeDisjoint_of_ne hne)
    hei hej

/-- A vertex of the fixed family `Q0` has a unique owning selected
transversal path. -/
theorem qstar_owner_eq_of_vertex_mem
    (F : TypeOneQStarFamily R hpos Q)
    {i j : Q.Index} {hi : i ∈ F.indices} {hj : j ∈ F.indices}
    {v : V}
    (hvi : v ∈ (F.data i hi).qstar.vertexSet)
    (hvj : v ∈ (F.data j hj).qstar.vertexSet) :
    i = j := by
  by_contra hne
  exact Finset.disjoint_left.mp (F.qstar_nodeDisjoint_of_ne hne)
    hvi hvj

/-- If a simple walk uses only edges from the fixed family `Q0`, then the
selected `Q*` path owning its first endpoint also owns its last endpoint.
This is the connectedness/ownership propagation used in the cross paragraph:
ownership cannot switch along consecutive edges because distinct `Q*` paths
are vertex-disjoint. -/
theorem qstar_owner_eq_of_walk_edges_subset
    (F : TypeOneQStarFamily R hpos Q)
    {u v : V} (W : G.Walk u v) (hpath : W.IsPath)
    {i j : Q.Index} {hi : i ∈ F.indices} {hj : j ∈ F.indices}
    (hu : u ∈ (F.data i hi).qstar.vertexSet)
    (hv : v ∈ (F.data j hj).qstar.vertexSet)
    (hedges : ∀ e : Sym2 V, e ∈ W.edges.toFinset → e ∈ F.edgeSet) :
    i = j := by
  classical
  induction W generalizing i with
  | nil =>
      exact F.qstar_owner_eq_of_vertex_mem hu hv
  | @cons u v w hadj W ih =>
      have hfirstF : s(u, v) ∈ F.edgeSet := by
        exact hedges (s(u, v)) (by simp)
      rcases (F.mem_edgeSet_iff).1 hfirstF with ⟨k, hk, hek⟩
      have hu_k : u ∈ (F.data k hk).qstar.vertexSet :=
        graphPath_mem_vertexSet_of_mem_edgeSet hek
          (Sym2.mem_mk_left u v)
      have hv_k : v ∈ (F.data k hk).qstar.vertexSet :=
        graphPath_mem_vertexSet_of_mem_edgeSet hek
          (Sym2.mem_mk_right u v)
      have hik : i = k :=
        F.qstar_owner_eq_of_vertex_mem hu hu_k
      have htail_path : W.IsPath :=
        _root_.SimpleGraph.Walk.IsPath.of_cons hpath
      have htail_edges :
          ∀ e : Sym2 V, e ∈ W.edges.toFinset → e ∈ F.edgeSet := by
        intro e he
        exact hedges e (by
          have heList : e ∈ W.edges := List.mem_toFinset.mp he
          exact List.mem_toFinset.mpr (by
            simpa using List.mem_cons_of_mem (s(u, v)) heList))
      have hkj : k = j :=
        ih htail_path hv_k hv htail_edges
      exact hik.trans hkj

/-- Graph-path version of
`qstar_owner_eq_of_walk_edges_subset`. -/
theorem qstar_owner_eq_of_graphPath_edges_subset
    (F : TypeOneQStarFamily R hpos Q)
    (P : GraphPath G)
    {i j : Q.Index} {hi : i ∈ F.indices} {hj : j ∈ F.indices}
    (hsource : P.source ∈ (F.data i hi).qstar.vertexSet)
    (htarget : P.target ∈ (F.data j hj).qstar.vertexSet)
    (hedges : P.edgeSet ⊆ F.edgeSet) :
    i = j :=
  F.qstar_owner_eq_of_walk_edges_subset P.walk P.isPath hsource htarget
    (by
      intro e he
      exact hedges (by simpa [GraphPath.edgeSet] using he))

/-- If a connected walk uses only edges from the fixed `Q₀` family and starts
on a selected `Q*`, then every edge of the walk lies on that same `Q*`.

This is the edge-level ownership propagation used in the bump paragraph.  The
walk cannot switch from one fixed transversal to another along an edge, because
the selected `Q*` paths are pairwise vertex-disjoint. -/
theorem qstar_edge_mem_of_walk_edges_subset_of_source_mem
    (F : TypeOneQStarFamily R hpos Q)
    {u v : V} (W : G.Walk u v)
    {i : Q.Index} {hi : i ∈ F.indices}
    (hu : u ∈ (F.data i hi).qstar.vertexSet)
    (hedges : ∀ e : Sym2 V, e ∈ W.edges.toFinset → e ∈ F.edgeSet) :
    ∀ e : Sym2 V, e ∈ W.edges.toFinset →
      e ∈ (F.data i hi).qstar.edgeSet := by
  classical
  induction W generalizing i with
  | nil =>
      intro e he
      simp at he
  | @cons u v w hadj W ih =>
      intro e he
      have hfirstF : s(u, v) ∈ F.edgeSet := by
        exact hedges (s(u, v)) (by simp)
      rcases (F.mem_edgeSet_iff).1 hfirstF with ⟨k, hk, hek⟩
      have hu_k : u ∈ (F.data k hk).qstar.vertexSet :=
        graphPath_mem_vertexSet_of_mem_edgeSet hek
          (Sym2.mem_mk_left u v)
      have hv_k : v ∈ (F.data k hk).qstar.vertexSet :=
        graphPath_mem_vertexSet_of_mem_edgeSet hek
          (Sym2.mem_mk_right u v)
      have hik : i = k :=
        F.qstar_owner_eq_of_vertex_mem hu hu_k
      have hv_i : v ∈ (F.data i hi).qstar.vertexSet := by
        subst hik
        exact hv_k
      have htail_edges :
          ∀ e : Sym2 V, e ∈ W.edges.toFinset → e ∈ F.edgeSet := by
        intro e he
        exact hedges e (by
          have heList : e ∈ W.edges := List.mem_toFinset.mp he
          exact List.mem_toFinset.mpr (by
            simpa using List.mem_cons_of_mem (s(u, v)) heList))
      have htail_owned :
          ∀ e : Sym2 V, e ∈ W.edges.toFinset →
            e ∈ (F.data i hi).qstar.edgeSet :=
        ih hv_i htail_edges
      have he_cases :
          e = s(u, v) ∨ e ∈ W.edges.toFinset := by
        have heList : e ∈ (s(u, v) :: W.edges) := by
          simpa using (List.mem_toFinset.mp he)
        rcases List.mem_cons.1 heList with hfirst | htail
        · exact Or.inl hfirst
        · exact Or.inr (List.mem_toFinset.mpr htail)
      rcases he_cases with rfl | htail
      · subst hik
        exact hek
      · exact htail_owned e htail

/-- Graph-path version of
`qstar_edge_mem_of_walk_edges_subset_of_source_mem`. -/
theorem qstar_edge_mem_of_graphPath_edges_subset_of_source_mem
    (F : TypeOneQStarFamily R hpos Q)
    (P : GraphPath G)
    {i : Q.Index} {hi : i ∈ F.indices}
    (hsource : P.source ∈ (F.data i hi).qstar.vertexSet)
    (hedges : P.edgeSet ⊆ F.edgeSet) :
    P.edgeSet ⊆ (F.data i hi).qstar.edgeSet := by
  intro e he
  exact F.qstar_edge_mem_of_walk_edges_subset_of_source_mem P.walk
    hsource
    (by
      intro e he
      exact hedges (by simpa [GraphPath.edgeSet] using he))
    e (by simpa [GraphPath.edgeSet] using he)

end TypeOneQStarFamily

/-- Orient a stored unoriented segment from `s` to `t`.  This is the primitive
used by the bump and cross paragraphs: the parent transversal path may traverse
the segment in either direction. -/
noncomputable def orientBetween (P : GraphPath G) {s t : V}
    (h : P.Connects {s} {t}) : GraphPath G :=
  P.orient h

namespace orientBetween

variable {P : GraphPath G} {s t : V} {h : P.Connects {s} {t}}

@[simp] theorem vertexSet :
    (orientBetween (G := G) P h).vertexSet = P.vertexSet := by
  simp [orientBetween]

@[simp] theorem edgeSet :
    (orientBetween (G := G) P h).edgeSet = P.edgeSet := by
  simp [orientBetween]

theorem source : (orientBetween (G := G) P h).source = s := by
  have hs := GraphPath.orient_source_mem P h
  simpa [orientBetween] using hs

theorem target : (orientBetween (G := G) P h).target = t := by
  have ht := GraphPath.orient_target_mem P h
  simpa [orientBetween] using ht

end orientBetween

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}

/-- A bump in the maintained graph `H̃`.

The witness segment is deliberately stored as an unoriented graph path together
with a singleton-endpoint connection certificate.  The replacement action
orients it by `orientBetween`, because the fixed transversal `Q ∈ Q₀` may
traverse the bump in the direction `s → t` or `t → s`. -/
structure BumpWitness (I : IterationInput R hpos Q0) where
  /-- The current row `P_j'` on which the two bump endpoints lie. -/
  row : I.Row
  /-- The fixed transversal-path index whose `Q*` contains the bump segment. -/
  qIndex : Q.Index
  q_mem : qIndex ∈ Q0.indices
  /-- The endpoints of the bump, named in row order. -/
  left : V
  right : V
  left_mem_row : left ∈ (I.rowPath row).vertexSet
  right_mem_row : right ∈ (I.rowPath row).vertexSet
  /-- `left` appears before `right` on the current row, oriented from `A` to
  `B`. -/
  left_before_right : (I.rowPath row).Before left right
  left_ne_right : left ≠ right
  /-- The subpath `Q'` of a fixed path in `Q₀`. -/
  segment : GraphPath G
  segment_connects : segment.Connects {left} {right}
  segment_subset_qstar :
    segment.vertexSet ⊆ (Q0.data qIndex q_mem).qstar.vertexSet
  segment_edgeSet_subset_qstar :
    segment.edgeSet ⊆ (Q0.data qIndex q_mem).qstar.edgeSet
  /-- All row contacts of the bump segment are endpoints of that segment. -/
  segment_clean_rows :
    segment.InternallyDisjointFromSet I.rowVertexSet
  /-- The bump segment is clean with respect to the whole current linkage. -/
  segment_clean_linkage :
    segment.InternallyDisjointFromSet I.linkage.toPathPacking.vertexSet
  /-- The segment is not just a row-contained subpath.  It either leaves the
  row in vertices, or it stays on row vertices but uses an edge that is not
  one of the row-path edges. -/
  not_row_contained :
    (∃ v : V, v ∈ segment.vertexSet ∧
      v ∉ (I.rowPath row).vertexSet) ∨
      ¬ segment.edgeSet ⊆ (I.rowPath row).edgeSet

namespace BumpWitness

variable {I : IterationInput R hpos Q0} (Bump : BumpWitness I)

/-- The bump segment oriented from the earlier row endpoint `s` to the later
row endpoint `t`. -/
noncomputable def orientedSegment : GraphPath G :=
  orientBetween Bump.segment Bump.segment_connects

@[simp] theorem orientedSegment_vertexSet :
    Bump.orientedSegment.vertexSet = Bump.segment.vertexSet := by
  simp [orientedSegment]

@[simp] theorem orientedSegment_edgeSet :
    Bump.orientedSegment.edgeSet = Bump.segment.edgeSet := by
  simp [orientedSegment]

@[simp] theorem orientedSegment_source :
    Bump.orientedSegment.source = Bump.left :=
  orientBetween.source

@[simp] theorem orientedSegment_target :
    Bump.orientedSegment.target = Bump.right :=
  orientBetween.target

/-- The deleted middle segment of the row, namely `P_j'[s,t]`. -/
noncomputable def deletedRowSegment : GraphPath G :=
  (I.rowPath Bump.row).segmentOfBefore Bump.left_before_right

@[simp] theorem deletedRowSegment_source :
    Bump.deletedRowSegment.source = Bump.left := rfl

@[simp] theorem deletedRowSegment_target :
    Bump.deletedRowSegment.target = Bump.right := rfl

theorem deletedRowSegment_edgeSet_subset_row :
    Bump.deletedRowSegment.edgeSet ⊆ (I.rowPath Bump.row).edgeSet :=
  (I.rowPath Bump.row).segmentOfBefore_edgeSet_subset
    Bump.left_before_right

theorem segment_subset_fixed_qstar :
    Bump.segment.vertexSet ⊆ (Q0.data Bump.qIndex Bump.q_mem).qstar.vertexSet :=
  Bump.segment_subset_qstar

theorem segment_edgeSet_subset_fixed_qstar :
    Bump.segment.edgeSet ⊆ (Q0.data Bump.qIndex Bump.q_mem).qstar.edgeSet :=
  Bump.segment_edgeSet_subset_qstar

theorem left_mem_segment :
    Bump.left ∈ Bump.segment.vertexSet := by
  have hs : Bump.orientedSegment.source ∈ Bump.orientedSegment.vertexSet :=
    GraphPath.source_mem_vertexSet Bump.orientedSegment
  simpa [Bump.orientedSegment_vertexSet] using hs

theorem right_mem_segment :
    Bump.right ∈ Bump.segment.vertexSet := by
  have ht : Bump.orientedSegment.target ∈ Bump.orientedSegment.vertexSet :=
    GraphPath.target_mem_vertexSet Bump.orientedSegment
  simpa [Bump.orientedSegment_vertexSet] using ht

theorem left_mem_qstar :
    Bump.left ∈ (Q0.data Bump.qIndex Bump.q_mem).qstar.vertexSet :=
  Bump.segment_subset_qstar Bump.left_mem_segment

theorem right_mem_qstar :
    Bump.right ∈ (Q0.data Bump.qIndex Bump.q_mem).qstar.vertexSet :=
  Bump.segment_subset_qstar Bump.right_mem_segment

/-- Cleanliness of the stored segment is unchanged by orienting it from `s` to
`t`. -/
theorem orientedSegment_clean_rows :
    Bump.orientedSegment.InternallyDisjointFromSet I.rowVertexSet := by
  intro v hv hrow
  have hv' : v ∈ Bump.segment.vertexSet := by
    simpa [Bump.orientedSegment_vertexSet] using hv
  have hend := Bump.segment_clean_rows hv' hrow
  change (Bump.segment.orient Bump.segment_connects).IsEndpoint v
  exact (GraphPath.orient_isEndpoint Bump.segment Bump.segment_connects).2
    hend

/-- Linkage-cleanliness of the stored bump segment is unchanged by orienting
it from the earlier row endpoint to the later row endpoint. -/
theorem orientedSegment_clean_linkage :
    Bump.orientedSegment.InternallyDisjointFromSet
      I.linkage.toPathPacking.vertexSet := by
  intro v hv hlink
  have hv' : v ∈ Bump.segment.vertexSet := by
    simpa [Bump.orientedSegment_vertexSet] using hv
  have hend := Bump.segment_clean_linkage hv' hlink
  change (Bump.segment.orient Bump.segment_connects).IsEndpoint v
  exact (GraphPath.orient_isEndpoint Bump.segment Bump.segment_connects).2
    hend

/-- The oriented bump segment still lies on the fixed `Q*`. -/
theorem orientedSegment_subset_qstar :
    Bump.orientedSegment.vertexSet ⊆
      (Q0.data Bump.qIndex Bump.q_mem).qstar.vertexSet := by
  intro v hv
  exact Bump.segment_subset_qstar (by simpa using hv)

theorem orientedSegment_edgeSet_subset_qstar :
    Bump.orientedSegment.edgeSet ⊆
      (Q0.data Bump.qIndex Bump.q_mem).qstar.edgeSet := by
  intro e he
  exact Bump.segment_edgeSet_subset_qstar (by simpa using he)

end BumpWitness

theorem appendWithEqOfInterSubsetTarget_vertexSet_subset
    (P Q : GraphPath G) (h : P.target = Q.source)
    (hinter :
      ∀ ⦃v : V⦄, v ∈ P.vertexSet → v ∈ Q.vertexSet → v = P.target) :
    (P.appendWithEqOfInterSubsetTarget Q h hinter).vertexSet ⊆
      P.vertexSet ∪ Q.vertexSet := by
  exact P.appendWithEq_vertexSet_subset Q h
    (P.appendWithEq_isPath_of_inter_subset_target Q h hinter)

theorem appendWithEqOfInterSubsetTarget_edgeSet_subset
    (P Q : GraphPath G) (h : P.target = Q.source)
    (hinter :
      ∀ ⦃v : V⦄, v ∈ P.vertexSet → v ∈ Q.vertexSet → v = P.target) :
    (P.appendWithEqOfInterSubsetTarget Q h hinter).edgeSet ⊆
      P.edgeSet ∪ Q.edgeSet := by
  exact P.appendWithEq_edgeSet_subset Q h
    (P.appendWithEq_isPath_of_inter_subset_target Q h hinter)

/-- A concrete replacement path for the bumped row.

The paper constructs this path by concatenating the prefix of the old row up to
`s`, the bump segment oriented from `s` to `t`, and the suffix of the old row
from `t`.  The fields record the exact endpoint and containment facts used in
the rest of the bump paragraph; `BumpWitness.replacementPath` constructs this
object from the witness data. -/
structure BumpReplacementPath {I : IterationInput R hpos Q0}
    (Bump : BumpWitness I) where
  path : GraphPath G
  source_eq : path.source = (I.rowPath Bump.row).source
  target_eq : path.target = (I.rowPath Bump.row).target
  vertexSet_subset_parts :
    path.vertexSet ⊆
      (((I.rowPath Bump.row).takeUntil Bump.left_mem_row).vertexSet ∪
          Bump.orientedSegment.vertexSet) ∪
        ((I.rowPath Bump.row).dropUntil Bump.right_mem_row).vertexSet
  prefix_subset_path :
    ((I.rowPath Bump.row).takeUntil Bump.left_mem_row).vertexSet ⊆
      path.vertexSet
  segment_subset_path :
    Bump.orientedSegment.vertexSet ⊆ path.vertexSet
  suffix_subset_path :
    ((I.rowPath Bump.row).dropUntil Bump.right_mem_row).vertexSet ⊆
      path.vertexSet
  vertexSet_subset :
    path.vertexSet ⊆
      (I.rowPath Bump.row).vertexSet ∪ Bump.segment.vertexSet
  edgeSet_subset_parts :
    path.edgeSet ⊆
      (((I.rowPath Bump.row).takeUntil Bump.left_mem_row).edgeSet ∪
          Bump.orientedSegment.edgeSet) ∪
        ((I.rowPath Bump.row).dropUntil Bump.right_mem_row).edgeSet
  edgeSet_subset :
    path.edgeSet ⊆
      (I.rowPath Bump.row).edgeSet ∪ Bump.segment.edgeSet

namespace BumpReplacementPath

variable {I : IterationInput R hpos Q0} {Bump : BumpWitness I}

/-- The replacement row is again an `A`--`B` path whenever the old row was. -/
theorem connectsAB (P' : BumpReplacementPath Bump)
    (hrows : I.RowsConnectAB) :
    P'.path.Connects A B := by
  exact Or.inl ⟨by
      rw [P'.source_eq]
      exact (hrows Bump.row).1,
    by
      rw [P'.target_eq]
      exact (hrows Bump.row).2⟩

end BumpReplacementPath

namespace BumpWitness

variable {I : IterationInput R hpos Q0} (Bump : BumpWitness I)

/-- The row vertex set contains the vertex set of each current row. -/
theorem row_vertexSet_subset_rowVertexSet :
    (I.rowPath Bump.row).vertexSet ⊆ I.rowVertexSet := by
  classical
  intro v hv
  exact Finset.mem_biUnion.mpr
    ⟨Bump.row, Finset.mem_univ _, hv⟩

/-- Since `right` occurs strictly after `left` on the row, it is not in the
prefix ending at `left`. -/
theorem right_not_mem_row_prefix :
    Bump.right ∉
      ((I.rowPath Bump.row).takeUntil Bump.left_mem_row).vertexSet := by
  intro hright
  have hright_before_left :
      (I.rowPath Bump.row).Before Bump.right Bump.left :=
    (I.rowPath Bump.row).before_of_mem_takeUntil Bump.left_mem_row hright
  have heq :
      Bump.right = Bump.left :=
    (I.rowPath Bump.row).before_antisymm
      hright_before_left Bump.left_before_right
  exact Bump.left_ne_right heq.symm

/-- Since `left` occurs strictly before `right` on the row, it is not in the
suffix starting at `right`. -/
theorem left_not_mem_row_suffix :
    Bump.left ∉
      ((I.rowPath Bump.row).dropUntil Bump.right_mem_row).vertexSet := by
  intro hleft
  have hright_before_left :
      (I.rowPath Bump.row).Before Bump.right Bump.left :=
    ⟨Bump.right_mem_row, hleft⟩
  have heq :
      Bump.left = Bump.right :=
    (I.rowPath Bump.row).before_antisymm
      Bump.left_before_right hright_before_left
  exact Bump.left_ne_right heq

/-- The prefix of the old row ending at `left` can meet the oriented bump
segment only at `left`. -/
theorem prefix_inter_orientedSegment_subset_left :
    ∀ ⦃v : V⦄,
      v ∈ ((I.rowPath Bump.row).takeUntil Bump.left_mem_row).vertexSet →
      v ∈ Bump.orientedSegment.vertexSet →
      v = ((I.rowPath Bump.row).takeUntil Bump.left_mem_row).target := by
  intro v hvpre hvmid
  have hvrow :
      v ∈ (I.rowPath Bump.row).vertexSet :=
    (I.rowPath Bump.row).takeUntil_vertexSet_subset
      Bump.left_mem_row hvpre
  have hend :=
    Bump.orientedSegment_clean_rows hvmid
      (Bump.row_vertexSet_subset_rowVertexSet hvrow)
  rcases hend with hleft | hright
  · simpa using hleft
  · exfalso
    exact Bump.right_not_mem_row_prefix (by
      simpa [hright] using hvpre)

/-- The prefix ending at `left` and the suffix starting at `right` are
disjoint when `left` is strictly before `right`. -/
theorem row_prefix_disjoint_suffix :
    Disjoint
      ((I.rowPath Bump.row).takeUntil Bump.left_mem_row).vertexSet
      ((I.rowPath Bump.row).dropUntil Bump.right_mem_row).vertexSet := by
  rw [Finset.disjoint_left]
  intro v hvpre hvsuf
  have hv_before_left :
      (I.rowPath Bump.row).Before v Bump.left :=
    (I.rowPath Bump.row).before_of_mem_takeUntil
      Bump.left_mem_row hvpre
  have hright_before_v :
      (I.rowPath Bump.row).Before Bump.right v :=
    ⟨Bump.right_mem_row, hvsuf⟩
  have hright_before_left :
      (I.rowPath Bump.row).Before Bump.right Bump.left :=
    (I.rowPath Bump.row).before_trans hright_before_v hv_before_left
  have heq :
      Bump.right = Bump.left :=
    (I.rowPath Bump.row).before_antisymm
      hright_before_left Bump.left_before_right
  exact Bump.left_ne_right heq.symm

/-- The path obtained by replacing the row segment `P_j'[s,t]` with the bump
segment `Q'[s,t]`.

This is the formal version of the first sentence after Figure 7: the bumped
row is the prefix of the old row to `s`, followed by the bump segment oriented
from `s` to `t`, followed by the suffix of the old row from `t`. -/
noncomputable def replacementPath : BumpReplacementPath Bump := by
  classical
  let Row : GraphPath G := I.rowPath Bump.row
  let pre : GraphPath G := Row.takeUntil Bump.left_mem_row
  let mid : GraphPath G := Bump.orientedSegment
  let suf : GraphPath G := Row.dropUntil Bump.right_mem_row
  have hpre_mid_glue : pre.target = mid.source := by
    simp [pre, mid, Row]
  have hpre_mid_inter :
      ∀ ⦃v : V⦄, v ∈ pre.vertexSet → v ∈ mid.vertexSet →
        v = pre.target := by
    intro v hvpre hvmid
    simpa [pre, mid, Row] using
      Bump.prefix_inter_orientedSegment_subset_left
        (v := v) (by simpa [pre, Row] using hvpre)
        (by simpa [mid] using hvmid)
  let preMid : GraphPath G :=
    pre.appendWithEqOfInterSubsetTarget mid hpre_mid_glue hpre_mid_inter
  have hpreMid_suf_glue : preMid.target = suf.source := by
    simp [preMid, pre, mid, suf, Row]
  have hpreMid_suf_inter :
      ∀ ⦃v : V⦄, v ∈ preMid.vertexSet → v ∈ suf.vertexSet →
        v = preMid.target := by
    intro v hvpm hvsuf
    have hvpm_union :
        v ∈ pre.vertexSet ∪ mid.vertexSet :=
      appendWithEqOfInterSubsetTarget_vertexSet_subset
        pre mid hpre_mid_glue hpre_mid_inter hvpm
    rcases Finset.mem_union.1 hvpm_union with hvpre | hvmid
    · exact False.elim
        (Finset.disjoint_left.mp Bump.row_prefix_disjoint_suffix
          (by simpa [pre, Row] using hvpre)
          (by simpa [suf, Row] using hvsuf))
    · have hvrow :
          v ∈ (I.rowPath Bump.row).vertexSet :=
        (I.rowPath Bump.row).dropUntil_vertexSet_subset
          Bump.right_mem_row (by simpa [suf, Row] using hvsuf)
      have hend :=
        Bump.orientedSegment_clean_rows
          (by simpa [mid] using hvmid)
          (Bump.row_vertexSet_subset_rowVertexSet hvrow)
      rcases hend with hleft | hright
      · exact False.elim
          (Bump.left_not_mem_row_suffix (by
            simpa [suf, Row, hleft] using hvsuf))
      · simpa [preMid, mid] using hright
  let whole : GraphPath G :=
    preMid.appendWithEqOfInterSubsetTarget suf
      hpreMid_suf_glue hpreMid_suf_inter
  refine
    { path := whole
      source_eq := ?_
      target_eq := ?_
      vertexSet_subset_parts := ?_
      prefix_subset_path := ?_
      segment_subset_path := ?_
      suffix_subset_path := ?_
      vertexSet_subset := ?_
      edgeSet_subset_parts := ?_
      edgeSet_subset := ?_ }
  · simp [whole, preMid, pre, Row]
  · simp [whole, preMid, suf, Row]
  · intro v hv
    have hv_union :
        v ∈ preMid.vertexSet ∪ suf.vertexSet :=
      appendWithEqOfInterSubsetTarget_vertexSet_subset
        preMid suf hpreMid_suf_glue hpreMid_suf_inter hv
    rcases Finset.mem_union.1 hv_union with hvpm | hvsuf
    · have hvpm_union :
          v ∈ pre.vertexSet ∪ mid.vertexSet :=
        appendWithEqOfInterSubsetTarget_vertexSet_subset
          pre mid hpre_mid_glue hpre_mid_inter hvpm
      rcases Finset.mem_union.1 hvpm_union with hvpre | hvmid
      · exact Finset.mem_union.2 <| Or.inl <|
          Finset.mem_union.2 <| Or.inl <|
            by simpa [pre, Row] using hvpre
      · exact Finset.mem_union.2 <| Or.inl <|
          Finset.mem_union.2 <| Or.inr <|
            by simpa [mid] using hvmid
    · exact Finset.mem_union.2 <| Or.inr <|
        by simpa [suf, Row] using hvsuf
  · intro v hvpre
    have hvpm : v ∈ preMid.vertexSet :=
      pre.left_vertexSet_subset_appendWithEqOfInterSubsetTarget
        mid hpre_mid_glue hpre_mid_inter hvpre
    have hvwhole : v ∈ whole.vertexSet :=
      preMid.left_vertexSet_subset_appendWithEqOfInterSubsetTarget
        suf hpreMid_suf_glue hpreMid_suf_inter hvpm
    simpa [whole, preMid, pre, Row] using hvwhole
  · intro v hvmid
    have hvpm : v ∈ preMid.vertexSet :=
      pre.right_vertexSet_subset_appendWithEqOfInterSubsetTarget
        mid hpre_mid_glue hpre_mid_inter hvmid
    have hvwhole : v ∈ whole.vertexSet :=
      preMid.left_vertexSet_subset_appendWithEqOfInterSubsetTarget
        suf hpreMid_suf_glue hpreMid_suf_inter hvpm
    simpa [whole, preMid, mid] using hvwhole
  · intro v hvsuf
    have hvwhole : v ∈ whole.vertexSet :=
      preMid.right_vertexSet_subset_appendWithEqOfInterSubsetTarget
        suf hpreMid_suf_glue hpreMid_suf_inter hvsuf
    simpa [whole, preMid, suf, Row] using hvwhole
  · intro v hv
    have hv_union :
        v ∈ preMid.vertexSet ∪ suf.vertexSet :=
      appendWithEqOfInterSubsetTarget_vertexSet_subset
        preMid suf hpreMid_suf_glue hpreMid_suf_inter hv
    rcases Finset.mem_union.1 hv_union with hvpm | hvsuf
    · have hvpm_union :
          v ∈ pre.vertexSet ∪ mid.vertexSet :=
        appendWithEqOfInterSubsetTarget_vertexSet_subset
          pre mid hpre_mid_glue hpre_mid_inter hvpm
      rcases Finset.mem_union.1 hvpm_union with hvpre | hvmid
      · exact Finset.mem_union.2 <| Or.inl <|
          (I.rowPath Bump.row).takeUntil_vertexSet_subset
            Bump.left_mem_row (by simpa [pre, Row] using hvpre)
      · exact Finset.mem_union.2 <| Or.inr <|
          by simpa [mid] using hvmid
    · exact Finset.mem_union.2 <| Or.inl <|
        (I.rowPath Bump.row).dropUntil_vertexSet_subset
          Bump.right_mem_row (by simpa [suf, Row] using hvsuf)
  · intro e he
    have he_union :
        e ∈ preMid.edgeSet ∪ suf.edgeSet :=
      appendWithEqOfInterSubsetTarget_edgeSet_subset
        preMid suf hpreMid_suf_glue hpreMid_suf_inter he
    rcases Finset.mem_union.1 he_union with hepm | hesuf
    · have hepm_union :
          e ∈ pre.edgeSet ∪ mid.edgeSet :=
        appendWithEqOfInterSubsetTarget_edgeSet_subset
          pre mid hpre_mid_glue hpre_mid_inter hepm
      rcases Finset.mem_union.1 hepm_union with hepre | hemid
      · exact Finset.mem_union.2 <| Or.inl <|
          Finset.mem_union.2 <| Or.inl <|
            by simpa [pre, Row] using hepre
      · exact Finset.mem_union.2 <| Or.inl <|
          Finset.mem_union.2 <| Or.inr <|
            by simpa [mid] using hemid
    · exact Finset.mem_union.2 <| Or.inr <|
        by simpa [suf, Row] using hesuf
  · intro e he
    have he_union :
        e ∈ preMid.edgeSet ∪ suf.edgeSet :=
      appendWithEqOfInterSubsetTarget_edgeSet_subset
        preMid suf hpreMid_suf_glue hpreMid_suf_inter he
    rcases Finset.mem_union.1 he_union with hepm | hesuf
    · have hepm_union :
          e ∈ pre.edgeSet ∪ mid.edgeSet :=
        appendWithEqOfInterSubsetTarget_edgeSet_subset
          pre mid hpre_mid_glue hpre_mid_inter hepm
      rcases Finset.mem_union.1 hepm_union with hepre | hemid
      · exact Finset.mem_union.2 <| Or.inl <|
          (I.rowPath Bump.row).takeUntil_edgeSet_subset
            Bump.left_mem_row (by simpa [pre, Row] using hepre)
      · exact Finset.mem_union.2 <| Or.inr <|
          by simpa [mid] using hemid
    · exact Finset.mem_union.2 <| Or.inl <|
        (I.rowPath Bump.row).dropUntil_edgeSet_subset
          Bump.right_mem_row (by simpa [suf, Row] using hesuf)

@[simp] theorem replacementPath_path_source :
    Bump.replacementPath.path.source = (I.rowPath Bump.row).source :=
  Bump.replacementPath.source_eq

@[simp] theorem replacementPath_path_target :
    Bump.replacementPath.path.target = (I.rowPath Bump.row).target :=
  Bump.replacementPath.target_eq

/-- The constructed bumped row is again an `A`--`B` path under the current-row
endpoint invariant. -/
theorem replacementPath_connectsAB (hrows : I.RowsConnectAB) :
    Bump.replacementPath.path.Connects A B :=
  Bump.replacementPath.connectsAB hrows

/-- The constructed bumped row uses only edges already present in the old row
or in the fixed `Q0` family.  This is the edge-set inclusion behind the
paragraph's maintained-graph comparison. -/
theorem replacementPath_edgeSet_subset_row_union_Q0 :
    Bump.replacementPath.path.edgeSet ⊆
      (I.rowPath Bump.row).edgeSet ∪ Q0.edgeSet := by
  classical
  intro e he
  have hraw := Bump.replacementPath.edgeSet_subset he
  rcases Finset.mem_union.1 hraw with herow | heseg
  · exact Finset.mem_union.2 (Or.inl herow)
  · have heqstar :
        e ∈ (Q0.data Bump.qIndex Bump.q_mem).qstar.edgeSet :=
      Bump.segment_edgeSet_subset_qstar heseg
    have heQ0 : e ∈ Q0.edgeSet := by
      exact Finset.mem_biUnion.mpr
        ⟨⟨Bump.qIndex, Bump.q_mem⟩, Finset.mem_attach _ _, heqstar⟩
    exact Finset.mem_union.2 (Or.inr heQ0)

/-- The deleted middle segment has at least one edge, because its endpoints
`s` and `t` are distinct. -/
theorem deletedRowSegment_edgeSet_nonempty :
    Bump.deletedRowSegment.edgeSet.Nonempty := by
  have hne : Bump.deletedRowSegment.source ≠ Bump.deletedRowSegment.target := by
    intro h
    exact Bump.left_ne_right (by simpa using h)
  exact Bump.deletedRowSegment.edgeSet_nonempty_of_source_ne_target hne

/-- If the deleted row interval were contained in the union of the fixed
transversal paths, then in fact all of its edges would be owned by the same
fixed `Q*` as the bump segment, because the interval starts at the bump's left
endpoint. -/
theorem deletedRowSegment_edgeSet_subset_qstar_of_subset_Q0
    (hsub : Bump.deletedRowSegment.edgeSet ⊆ Q0.edgeSet) :
    Bump.deletedRowSegment.edgeSet ⊆
      (Q0.data Bump.qIndex Bump.q_mem).qstar.edgeSet := by
  exact Q0.qstar_edge_mem_of_graphPath_edges_subset_of_source_mem
    Bump.deletedRowSegment
    (by simpa [Bump.deletedRowSegment_source] using Bump.left_mem_qstar)
    hsub

/-- Vertex form of `deletedRowSegment_edgeSet_subset_qstar_of_subset_Q0`. -/
theorem deletedRowSegment_vertexSet_subset_qstar_of_subset_Q0
    (hsub : Bump.deletedRowSegment.edgeSet ⊆ Q0.edgeSet) :
    Bump.deletedRowSegment.vertexSet ⊆
      (Q0.data Bump.qIndex Bump.q_mem).qstar.vertexSet :=
  graphPath_vertexSet_subset_of_edgeSet_subset_of_source_mem
    (P := (Q0.data Bump.qIndex Bump.q_mem).qstar)
    (Q := Bump.deletedRowSegment)
    (by simpa [Bump.deletedRowSegment_source] using Bump.left_mem_qstar)
    (Bump.deletedRowSegment_edgeSet_subset_qstar_of_subset_Q0 hsub)

/-- If the deleted row interval were already contained in the fixed `Q₀`
edge set, then the bump segment would have no off-row vertex.  This is the
vertex-level half of the simple-path uniqueness argument used in the bump
progress proof. -/
theorem segment_vertexSet_subset_deletedRowSegment_of_deleted_subset_Q0
    (hsub : Bump.deletedRowSegment.edgeSet ⊆ Q0.edgeSet) :
    Bump.segment.vertexSet ⊆ Bump.deletedRowSegment.vertexSet := by
  have hsubset_oriented :
      Bump.orientedSegment.vertexSet ⊆ Bump.deletedRowSegment.vertexSet :=
    GraphPath.vertexSet_subset_of_edgeSet_subset_same_endpoints
      (Q0.data Bump.qIndex Bump.q_mem).qstar
      Bump.orientedSegment
      Bump.deletedRowSegment
      Bump.orientedSegment_subset_qstar
      Bump.orientedSegment_edgeSet_subset_qstar
      (Bump.deletedRowSegment_vertexSet_subset_qstar_of_subset_Q0 hsub)
      (Bump.deletedRowSegment_edgeSet_subset_qstar_of_subset_Q0 hsub)
      (by simp)
      (by simp)
  intro v hv
  exact hsubset_oriented (by simpa [Bump.orientedSegment_vertexSet] using hv)

/-- The converse vertex containment, under the same hypothetical containment
of the deleted row interval in `Q₀`. -/
theorem deletedRowSegment_vertexSet_subset_segment_of_deleted_subset_Q0
    (hsub : Bump.deletedRowSegment.edgeSet ⊆ Q0.edgeSet) :
    Bump.deletedRowSegment.vertexSet ⊆ Bump.segment.vertexSet := by
  have hsubset_oriented :
      Bump.deletedRowSegment.vertexSet ⊆ Bump.orientedSegment.vertexSet :=
    GraphPath.vertexSet_subset_of_edgeSet_subset_same_endpoints
      (Q0.data Bump.qIndex Bump.q_mem).qstar
      Bump.deletedRowSegment
      Bump.orientedSegment
      (Bump.deletedRowSegment_vertexSet_subset_qstar_of_subset_Q0 hsub)
      (Bump.deletedRowSegment_edgeSet_subset_qstar_of_subset_Q0 hsub)
      Bump.orientedSegment_subset_qstar
      Bump.orientedSegment_edgeSet_subset_qstar
      (by simp)
      (by simp)
  intro v hv
  have hv' : v ∈ Bump.orientedSegment.vertexSet := hsubset_oriented hv
  simpa [Bump.orientedSegment_vertexSet] using hv'

/-- If the bump segment has no off-row vertex, then its vertices are just its
two endpoints.  This uses the endpoint-clean row-contact condition in the
definition of a bump. -/
theorem segment_vertexSet_subset_endpoints_of_no_off_row
    (hno_off :
      ¬ ∃ v : V, v ∈ Bump.segment.vertexSet ∧
        v ∉ (I.rowPath Bump.row).vertexSet) :
    Bump.segment.vertexSet ⊆ ({Bump.left, Bump.right} : Finset V) := by
  have hsource_lr :
      Bump.segment.source = Bump.left ∨
        Bump.segment.source = Bump.right := by
    rcases Bump.segment_connects with h | h
    · exact Or.inl (by simpa using h.1)
    · exact Or.inr (by simpa using h.1)
  have htarget_lr :
      Bump.segment.target = Bump.left ∨
        Bump.segment.target = Bump.right := by
    rcases Bump.segment_connects with h | h
    · exact Or.inr (by simpa using h.2)
    · exact Or.inl (by simpa using h.2)
  intro v hv
  have hvrow : v ∈ (I.rowPath Bump.row).vertexSet := by
    by_contra hvnot
    exact hno_off ⟨v, hv, hvnot⟩
  have hvrow_global : v ∈ I.rowVertexSet :=
    Bump.row_vertexSet_subset_rowVertexSet hvrow
  have hend := Bump.segment_clean_rows hv hvrow_global
  rcases hend with hleft | hright
  · simpa [hleft] using hsource_lr
  · simpa [hright] using htarget_lr

/-- Any edge of a path whose vertices are contained in the two bump endpoints
is the unordered edge between those endpoints. -/
theorem edge_eq_left_right_of_mem_path_with_endpoint_vertices
    {P : GraphPath G} {e : Sym2 V}
    (hverts : P.vertexSet ⊆ ({Bump.left, Bump.right} : Finset V))
    (he : e ∈ P.edgeSet) :
    e = s(Bump.left, Bump.right) := by
  classical
  have hfst_mem : e.out.1 ∈ P.vertexSet :=
    graphPath_mem_vertexSet_of_mem_edgeSet he (Sym2.out_fst_mem e)
  have hsnd_mem : e.out.2 ∈ P.vertexSet :=
    graphPath_mem_vertexSet_of_mem_edgeSet he (Sym2.out_snd_mem e)
  have hfst_cases :
      e.out.1 = Bump.left ∨ e.out.1 = Bump.right := by
    simpa using hverts hfst_mem
  have hsnd_cases :
      e.out.2 = Bump.left ∨ e.out.2 = Bump.right := by
    simpa using hverts hsnd_mem
  have heG : e ∈ G.edgeSet := P.edgeSet_subset_edgeSet he
  have hadj : G.Adj e.out.1 e.out.2 := by
    rw [← _root_.SimpleGraph.mem_edgeSet]
    simpa [Sym2.mk, e.out_eq] using heG
  have hne : e.out.1 ≠ e.out.2 := hadj.ne
  rcases hfst_cases with hfl | hfr <;>
    rcases hsnd_cases with hsl | hsr
  · exact False.elim (hne (hfl.trans hsl.symm))
  · exact (Sym2.mem_and_mem_iff Bump.left_ne_right).1
      ⟨by simpa [hfl] using Sym2.out_fst_mem e,
        by simpa [hsr] using Sym2.out_snd_mem e⟩
  · exact (Sym2.mem_and_mem_iff Bump.left_ne_right).1
      ⟨by simpa [hsl] using Sym2.out_snd_mem e,
        by simpa [hfr] using Sym2.out_fst_mem e⟩
  · exact False.elim (hne (hfr.trans hsr.symm))

/-- If the deleted row interval were contained in `Q₀` and the bump segment
had no off-row vertices, then every bump-segment edge would already be a row
edge. -/
theorem segment_edgeSet_subset_row_of_deleted_subset_Q0_of_no_off_row
    (hsub : Bump.deletedRowSegment.edgeSet ⊆ Q0.edgeSet)
    (hno_off :
      ¬ ∃ v : V, v ∈ Bump.segment.vertexSet ∧
        v ∉ (I.rowPath Bump.row).vertexSet) :
    Bump.segment.edgeSet ⊆ (I.rowPath Bump.row).edgeSet := by
  classical
  have hseg_vertices :
      Bump.segment.vertexSet ⊆ ({Bump.left, Bump.right} : Finset V) :=
    Bump.segment_vertexSet_subset_endpoints_of_no_off_row hno_off
  have hdel_vertices :
      Bump.deletedRowSegment.vertexSet ⊆
        ({Bump.left, Bump.right} : Finset V) := by
    intro v hv
    exact hseg_vertices
      (Bump.deletedRowSegment_vertexSet_subset_segment_of_deleted_subset_Q0
        hsub hv)
  rcases Bump.deletedRowSegment_edgeSet_nonempty with ⟨erow, herow⟩
  have herow_eq :
      erow = s(Bump.left, Bump.right) :=
    Bump.edge_eq_left_right_of_mem_path_with_endpoint_vertices
      (P := Bump.deletedRowSegment) hdel_vertices herow
  have hleft_right_row : s(Bump.left, Bump.right) ∈
      (I.rowPath Bump.row).edgeSet := by
    simpa [herow_eq] using
      Bump.deletedRowSegment_edgeSet_subset_row herow
  intro e he
  have he_eq :
      e = s(Bump.left, Bump.right) :=
    Bump.edge_eq_left_right_of_mem_path_with_endpoint_vertices
      (P := Bump.segment) hseg_vertices he
  simpa [he_eq] using hleft_right_row

/-- The deleted interval cannot be contained in `Q₀` in the case where the
bump segment visibly leaves the row in vertices. -/
theorem deletedRowSegment_edgeSet_not_subset_Q0_of_segment_off_row
    (hoff :
      ∃ v : V, v ∈ Bump.segment.vertexSet ∧
        v ∉ (I.rowPath Bump.row).vertexSet) :
    ¬ Bump.deletedRowSegment.edgeSet ⊆ Q0.edgeSet := by
  intro hsub
  rcases hoff with ⟨v, hvseg, hvnotrow⟩
  have hvdel :
      v ∈ Bump.deletedRowSegment.vertexSet :=
    Bump.segment_vertexSet_subset_deletedRowSegment_of_deleted_subset_Q0
      hsub hvseg
  have hvrow : v ∈ (I.rowPath Bump.row).vertexSet :=
    (I.rowPath Bump.row).segmentOfBefore_vertexSet_subset
      Bump.left_before_right hvdel
  exact hvnotrow hvrow

/-- The deleted row interval cannot already be contained in the fixed
transversal family `Q₀`.

If it were, path-uniqueness inside the fixed `Q*` owning the bump would force
the bump segment and the deleted row interval to have the same two-endpoint
vertex support.  In the off-row case this is immediate.  In the remaining
case the bump segment has only its two row endpoints as vertices, so every
bump edge is the row edge between those endpoints, contradicting the
`not_row_contained` field. -/
theorem deletedRowSegment_edgeSet_not_subset_Q0 :
    ¬ Bump.deletedRowSegment.edgeSet ⊆ Q0.edgeSet := by
  classical
  intro hsub
  by_cases hoff :
      ∃ v : V, v ∈ Bump.segment.vertexSet ∧
        v ∉ (I.rowPath Bump.row).vertexSet
  · exact Bump.deletedRowSegment_edgeSet_not_subset_Q0_of_segment_off_row
      hoff hsub
  · have hseg_edges_row :
        Bump.segment.edgeSet ⊆ (I.rowPath Bump.row).edgeSet :=
      Bump.segment_edgeSet_subset_row_of_deleted_subset_Q0_of_no_off_row
        hsub hoff
    rcases Bump.not_row_contained with hoff' | hedge
    · exact hoff hoff'
    · exact hedge hseg_edges_row

/-- A concrete deleted-middle edge outside `Q₀`, used to build the
nonterminating bump successor certificate. -/
theorem exists_deletedRowSegment_edge_not_mem_Q0 :
    ∃ deleted_edge : Sym2 V,
      deleted_edge ∈ Bump.deletedRowSegment.edgeSet ∧
        deleted_edge ∉ Q0.edgeSet := by
  classical
  by_contra hnone
  apply Bump.deletedRowSegment_edgeSet_not_subset_Q0
  intro e he
  by_contra hQ0
  exact hnone ⟨e, he, hQ0⟩

/-- Every edge of the deleted middle segment belongs to the old maintained
graph `H̃`, since it is an edge of the current row. -/
theorem deletedRowSegment_edge_mem_tilde
    {e : Sym2 V} (he : e ∈ Bump.deletedRowSegment.edgeSet) :
    e ∈ I.tildeEdgeSet := by
  classical
  have herow : e ∈ (I.rowPath Bump.row).edgeSet :=
    Bump.deletedRowSegment_edgeSet_subset_row he
  have heRows : e ∈ I.rowEdgeSet := by
    exact Finset.mem_biUnion.mpr
      ⟨Bump.row, Finset.mem_univ _, herow⟩
  exact Finset.mem_union.2 (Or.inl heRows)

/-- The old bumped row is disjoint from every unchanged linkage path. -/
theorem row_nodeDisjoint_unchanged
    {i : I.linkage.Index} (hi : i ≠ I.rowIndex Bump.row) :
    (I.rowPath Bump.row).NodeDisjoint (I.linkage.path i) := by
  rw [GraphPath.NodeDisjoint, Finset.disjoint_left]
  intro v hvrow hvi
  have hvrow' :
      v ∈ (I.linkage.path (I.rowIndex Bump.row)).vertexSet := by
    simpa [I.rowPath_eq_linkage_path Bump.row] using hvrow
  exact Finset.disjoint_left.mp
    (I.linkage.toPathPacking.node_disjoint (fun h => hi h.symm))
    hvrow' hvi

/-- If the oriented bump segment is clean with respect to the whole current
linkage, then it is disjoint from every unchanged linkage path. -/
theorem orientedSegment_nodeDisjoint_unchanged_of_linkage_clean
    (hclean :
      Bump.orientedSegment.InternallyDisjointFromSet
        I.linkage.toPathPacking.vertexSet)
    {i : I.linkage.Index} (hi : i ≠ I.rowIndex Bump.row) :
    Bump.orientedSegment.NodeDisjoint (I.linkage.path i) := by
  rw [GraphPath.NodeDisjoint, Finset.disjoint_left]
  intro v hvseg hvi
  have hpack : v ∈ I.linkage.toPathPacking.vertexSet :=
    (I.linkage.toPathPacking.mem_vertexSet).2 ⟨i, hvi⟩
  have hend := hclean hvseg hpack
  rcases hend with hleft | hright
  · have hleft_i : Bump.left ∈ (I.linkage.path i).vertexSet := by
      simpa [hleft] using hvi
    have hleft_row :
        Bump.left ∈
          (I.linkage.path (I.rowIndex Bump.row)).vertexSet := by
      simpa [I.rowPath_eq_linkage_path Bump.row] using Bump.left_mem_row
    exact Finset.disjoint_left.mp
      (I.linkage.toPathPacking.node_disjoint (fun h => hi h.symm))
      hleft_row hleft_i
  · have hright_i : Bump.right ∈ (I.linkage.path i).vertexSet := by
      simpa [hright] using hvi
    have hright_row :
        Bump.right ∈
          (I.linkage.path (I.rowIndex Bump.row)).vertexSet := by
      simpa [I.rowPath_eq_linkage_path Bump.row] using Bump.right_mem_row
    exact Finset.disjoint_left.mp
      (I.linkage.toPathPacking.node_disjoint (fun h => hi h.symm))
      hright_row hright_i

/-- Whole-linkage cleanliness of the inserted bump segment implies that the
entire replacement row is disjoint from every unchanged linkage path. -/
theorem replacementPath_nodeDisjoint_unchanged_of_segment_linkage_clean
    (hclean :
      Bump.orientedSegment.InternallyDisjointFromSet
        I.linkage.toPathPacking.vertexSet)
    {i : I.linkage.Index} (hi : i ≠ I.rowIndex Bump.row) :
    Bump.replacementPath.path.NodeDisjoint (I.linkage.path i) := by
  rw [GraphPath.NodeDisjoint, Finset.disjoint_left]
  intro v hvrep hvi
  have hparts := Bump.replacementPath.vertexSet_subset_parts hvrep
  rcases Finset.mem_union.1 hparts with hpre_or_mid | hsuf
  · rcases Finset.mem_union.1 hpre_or_mid with hpre | hmid
    · have hvrow : v ∈ (I.rowPath Bump.row).vertexSet :=
        (I.rowPath Bump.row).takeUntil_vertexSet_subset
          Bump.left_mem_row hpre
      exact Finset.disjoint_left.mp
        (Bump.row_nodeDisjoint_unchanged hi) hvrow hvi
    · exact Finset.disjoint_left.mp
        (Bump.orientedSegment_nodeDisjoint_unchanged_of_linkage_clean
          hclean hi) hmid hvi
  · have hvrow : v ∈ (I.rowPath Bump.row).vertexSet :=
      (I.rowPath Bump.row).dropUntil_vertexSet_subset
        Bump.right_mem_row hsuf
    exact Finset.disjoint_left.mp
      (Bump.row_nodeDisjoint_unchanged hi) hvrow hvi

/-- The bump witness itself carries the full-linkage-cleanliness needed to
show that the replacement row is disjoint from every unchanged linkage path. -/
theorem replacementPath_nodeDisjoint_unchanged
    {i : I.linkage.Index} (hi : i ≠ I.rowIndex Bump.row) :
    Bump.replacementPath.path.NodeDisjoint (I.linkage.path i) :=
  Bump.replacementPath_nodeDisjoint_unchanged_of_segment_linkage_clean
    Bump.orientedSegment_clean_linkage hi

/-- Concrete disjointness package used to build the replacement linkage for a
bump. -/
theorem replacementPath_nodeDisjoint_unchanged_all :
    ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
      Bump.replacementPath.path.NodeDisjoint (I.linkage.path i) :=
  fun _ hi => Bump.replacementPath_nodeDisjoint_unchanged hi

/-- The deleted row interval can meet the retained prefix of the bumped row
only at the endpoint `left`. -/
theorem deletedRowSegment_inter_prefix_endpoint
    {v : V} (hvdel : v ∈ Bump.deletedRowSegment.vertexSet)
    (hvpre :
      v ∈ ((I.rowPath Bump.row).takeUntil Bump.left_mem_row).vertexSet) :
    v = Bump.left := by
  have hv_before_left :
      (I.rowPath Bump.row).Before v Bump.left :=
    (I.rowPath Bump.row).before_of_mem_takeUntil
      Bump.left_mem_row hvpre
  have hleft_before_v :
      (I.rowPath Bump.row).Before Bump.left v :=
    (I.rowPath Bump.row).before_of_mem_segmentOfBefore_left
      Bump.left_before_right hvdel
  exact (I.rowPath Bump.row).before_antisymm
    hv_before_left hleft_before_v

/-- The deleted row interval can meet the retained suffix of the bumped row
only at the endpoint `right`. -/
theorem deletedRowSegment_inter_suffix_endpoint
    {v : V} (hvdel : v ∈ Bump.deletedRowSegment.vertexSet)
    (hvsuf :
      v ∈ ((I.rowPath Bump.row).dropUntil Bump.right_mem_row).vertexSet) :
    v = Bump.right := by
  have hv_before_right :
      (I.rowPath Bump.row).Before v Bump.right :=
    (I.rowPath Bump.row).before_of_mem_segmentOfBefore_right
      Bump.left_before_right hvdel
  have hright_before_v :
      (I.rowPath Bump.row).Before Bump.right v :=
    ⟨Bump.right_mem_row, hvsuf⟩
  exact (I.rowPath Bump.row).before_antisymm
    hv_before_right hright_before_v

/-- The deleted middle is edge-disjoint from the retained prefix of the
bumped row. -/
theorem deletedRowSegment_edgeDisjoint_prefix :
    Bump.deletedRowSegment.EdgeDisjoint
      ((I.rowPath Bump.row).takeUntil Bump.left_mem_row) :=
  graphPath_edgeDisjoint_of_vertex_inter_subset_singleton
    (x := Bump.left) (by
      intro v hvdel hvpre
      exact Bump.deletedRowSegment_inter_prefix_endpoint hvdel hvpre)

/-- The deleted middle is edge-disjoint from the retained suffix of the
bumped row. -/
theorem deletedRowSegment_edgeDisjoint_suffix :
    Bump.deletedRowSegment.EdgeDisjoint
      ((I.rowPath Bump.row).dropUntil Bump.right_mem_row) :=
  graphPath_edgeDisjoint_of_vertex_inter_subset_singleton
    (x := Bump.right) (by
      intro v hvdel hvsuf
      exact Bump.deletedRowSegment_inter_suffix_endpoint hvdel hvsuf)

/-- A deleted-middle edge outside `Q₀` is not used by the replacement row. -/
theorem deletedRowSegment_edge_not_mem_replacementPath_of_not_mem_Q0
    {e : Sym2 V} (he : e ∈ Bump.deletedRowSegment.edgeSet)
    (hQ0 : e ∉ Q0.edgeSet) :
    e ∉ Bump.replacementPath.path.edgeSet := by
  classical
  intro hrep
  have hparts := Bump.replacementPath.edgeSet_subset_parts hrep
  rcases Finset.mem_union.1 hparts with hpre_or_mid | hsuf
  · rcases Finset.mem_union.1 hpre_or_mid with hpre | hmid
    · exact Finset.disjoint_left.mp
        Bump.deletedRowSegment_edgeDisjoint_prefix he hpre
    · have heqstar :
          e ∈ (Q0.data Bump.qIndex Bump.q_mem).qstar.edgeSet :=
        Bump.orientedSegment_edgeSet_subset_qstar hmid
      have heQ0 : e ∈ Q0.edgeSet :=
        Finset.mem_biUnion.mpr
          ⟨⟨Bump.qIndex, Bump.q_mem⟩, Finset.mem_attach _ _, heqstar⟩
      exact hQ0 heQ0
  · exact Finset.disjoint_left.mp
      Bump.deletedRowSegment_edgeDisjoint_suffix he hsuf

/-- If a successor maintained graph is contained in the old one and misses an
edge from the deleted middle segment, then its edge count strictly decreases. -/
theorem tilde_card_lt_of_missing_deletedRowSegment_edge
    {I' : IterationInput R hpos Q0} {e : Sym2 V}
    (hsub : I'.tildeEdgeSet ⊆ I.tildeEdgeSet)
    (he : e ∈ Bump.deletedRowSegment.edgeSet)
    (hmiss : e ∉ I'.tildeEdgeSet) :
    I'.tildeEdgeSet.card < I.tildeEdgeSet.card := by
  have hssub : I'.tildeEdgeSet ⊂ I.tildeEdgeSet := by
    refine ⟨hsub, ?_⟩
    intro hrev
    exact hmiss (hrev (Bump.deletedRowSegment_edge_mem_tilde he))
  exact Finset.card_lt_card hssub

end BumpWitness

namespace PerfectPathPacking

variable {S T : Finset V}

/-- Replace one path of a perfect packing by a path with the same ordered
endpoints, assuming it remains vertex-disjoint from every other path.  This is
the reusable formal core of the bump sentence “it is immediate to verify that
`L''` is an `A`-`B` linkage.” -/
noncomputable def replacePathSameEndpoints
    (P : PerfectPathPacking G S T) (j : P.Index) (Pj : GraphPath G)
    (hsource : Pj.source = (P.path j).source)
    (htarget : Pj.target = (P.path j).target)
    (hdisj : ∀ i : P.Index, i ≠ j → Pj.NodeDisjoint (P.path i)) :
    PerfectPathPacking G S T := by
  classical
  let path' : P.Index → GraphPath G := fun i =>
    if i = j then Pj else P.path i
  have hpath_source : ∀ i : P.Index, (path' i).source = (P.path i).source := by
    intro i
    by_cases hij : i = j
    · subst hij
      simp [path', hsource]
    · simp [path', hij]
  have hpath_target : ∀ i : P.Index, (path' i).target = (P.path i).target := by
    intro i
    by_cases hij : i = j
    · subst hij
      simp [path', htarget]
    · simp [path', hij]
  refine
    { toPathPacking := ?_
      source_mem := ?_
      target_mem := ?_
      source_bijective := ?_
      target_bijective := ?_ }
  · exact
      { Index := P.Index
        path := path'
        connects := by
          intro i
          exact Or.inl ⟨by
              rw [hpath_source i]
              exact P.source_mem i,
            by
              rw [hpath_target i]
              exact P.target_mem i⟩
        node_disjoint := by
          intro i k hik
          by_cases hij : i = j
          · by_cases hkj : k = j
            · exact False.elim (hik (hij.trans hkj.symm))
            · simpa [path', hij, hkj] using hdisj k hkj
          · by_cases hkj : k = j
            · simpa [path', hij, hkj] using (hdisj i hij).symm
            · simpa [path', hij, hkj] using P.node_disjoint hik }
  · intro i
    rw [hpath_source i]
    exact P.source_mem i
  · intro i
    rw [hpath_target i]
    exact P.target_mem i
  · have hsrc :
        (fun i : P.Index =>
          (⟨(path' i).source, by
            rw [hpath_source i]
            exact P.source_mem i⟩ : {v // v ∈ S})) =
        (fun i : P.Index =>
          (⟨(P.path i).source, P.source_mem i⟩ : {v // v ∈ S})) := by
      funext i
      apply Subtype.ext
      exact hpath_source i
    simpa [hsrc] using P.source_bijective
  · have htgt :
        (fun i : P.Index =>
          (⟨(path' i).target, by
            rw [hpath_target i]
            exact P.target_mem i⟩ : {v // v ∈ T})) =
        (fun i : P.Index =>
          (⟨(P.path i).target, P.target_mem i⟩ : {v // v ∈ T})) := by
      funext i
      apply Subtype.ext
      exact hpath_target i
    simpa [htgt] using P.target_bijective

@[simp] theorem replacePathSameEndpoints_path_self
    (P : PerfectPathPacking G S T) (j : P.Index) (Pj : GraphPath G)
    (hsource : Pj.source = (P.path j).source)
    (htarget : Pj.target = (P.path j).target)
    (hdisj : ∀ i : P.Index, i ≠ j → Pj.NodeDisjoint (P.path i)) :
    ((replacePathSameEndpoints P j Pj hsource htarget hdisj).path j) = Pj := by
  simp [replacePathSameEndpoints]

@[simp] theorem replacePathSameEndpoints_path_of_ne
    (P : PerfectPathPacking G S T) (j i : P.Index) (Pj : GraphPath G)
    (hsource : Pj.source = (P.path j).source)
    (htarget : Pj.target = (P.path j).target)
    (hdisj : ∀ i : P.Index, i ≠ j → Pj.NodeDisjoint (P.path i))
    (hij : i ≠ j) :
    ((replacePathSameEndpoints P j Pj hsource htarget hdisj).path i) =
      P.path i := by
  simp [replacePathSameEndpoints, hij]

/-- Replace two paths of a perfect packing by two new paths that keep the same
left endpoints but swap their right endpoints.

This is the endpoint bookkeeping needed for the cross operation: the two
switched rows still form an `A`--`B` linkage, but their `B`-endpoints are
exchanged. -/
noncomputable def replaceTwoPathsSwapTargets
    (P : PerfectPathPacking G S T) (j k : P.Index) (hjk : j ≠ k)
    (Pj Pk : GraphPath G)
    (hsource_j : Pj.source = (P.path j).source)
    (htarget_j : Pj.target = (P.path k).target)
    (hsource_k : Pk.source = (P.path k).source)
    (htarget_k : Pk.target = (P.path j).target)
    (hjk_disj : Pj.NodeDisjoint Pk)
    (hPj_disj :
      ∀ i : P.Index, i ≠ j → i ≠ k → Pj.NodeDisjoint (P.path i))
    (hPk_disj :
      ∀ i : P.Index, i ≠ j → i ≠ k → Pk.NodeDisjoint (P.path i)) :
    PerfectPathPacking G S T := by
  classical
  let path' : P.Index → GraphPath G := fun i =>
    if i = j then Pj else if i = k then Pk else P.path i
  have hpath_source : ∀ i : P.Index, (path' i).source = (P.path i).source := by
    intro i
    by_cases hij' : i = j
    · subst hij'
      simp [path', hsource_j]
    · by_cases hik' : i = k
      · subst hik'
        simp [path', hjk.symm, hsource_k]
      · simp [path', hij', hik']
  have hpath_target_mem : ∀ i : P.Index, (path' i).target ∈ T := by
    intro i
    by_cases hij' : i = j
    · have hpi : path' i = Pj := by
        simp [path', hij']
      rw [hpi, htarget_j]
      exact P.target_mem k
    · by_cases hik' : i = k
      · have hpi : path' i = Pk := by
          rw [hik']
          simp [path', hjk.symm]
        rw [hpi, htarget_k]
        exact P.target_mem j
      · simpa [path', hij', hik'] using P.target_mem i
  let pack : PathPacking G S T :=
      { Index := P.Index
        path := path'
        connects := by
          intro i
          exact Or.inl ⟨by
              rw [hpath_source i]
              exact P.source_mem i,
            hpath_target_mem i⟩
        node_disjoint := by
          intro i l hil
          by_cases hij' : i = j
          · have hpi : path' i = Pj := by
              simp [path', hij']
            by_cases hlj : l = j
            · exact False.elim (hil (hij'.trans hlj.symm))
            · by_cases hlk : l = k
              · have hpl : path' l = Pk := by
                  rw [hlk]
                  simp [path', hjk.symm]
                simpa [hpi, hpl] using hjk_disj
              · have hpl : path' l = P.path l := by
                  simp [path', hlj, hlk]
                simpa [hpi, hpl] using hPj_disj l hlj hlk
          · by_cases hik' : i = k
            · have hpi : path' i = Pk := by
                rw [hik']
                simp [path', hjk.symm]
              by_cases hlj : l = j
              · have hpl : path' l = Pj := by
                  simp [path', hlj]
                simpa [hpi, hpl] using hjk_disj.symm
              · by_cases hlk : l = k
                · exact False.elim (hil (hik'.trans hlk.symm))
                · have hpl : path' l = P.path l := by
                    simp [path', hlj, hlk]
                  simpa [hpi, hpl] using hPk_disj l hlj hlk
            · by_cases hlj : l = j
              · have hpi : path' i = P.path i := by
                  simp [path', hij', hik']
                have hpl : path' l = Pj := by
                  simp [path', hlj]
                simpa [hpi, hpl] using (hPj_disj i hij' hik').symm
              · by_cases hlk : l = k
                · have hpi : path' i = P.path i := by
                    simp [path', hij', hik']
                  have hpl : path' l = Pk := by
                    rw [hlk]
                    simp [path', hjk.symm]
                  simpa [hpi, hpl] using (hPk_disj i hij' hik').symm
                · have hpi : path' i = P.path i := by
                    simp [path', hij', hik']
                  have hpl : path' l = P.path l := by
                    simp [path', hlj, hlk]
                  simpa [hpi, hpl] using P.node_disjoint hil }
  refine
    { toPathPacking := pack
      source_mem := ?_
      target_mem := ?_
      source_bijective := ?_
      target_bijective := ?_ }
  · intro i
    change (path' i).source ∈ S
    rw [hpath_source i]
    exact P.source_mem i
  · intro i
    change (path' i).target ∈ T
    exact hpath_target_mem i
  · change Function.Bijective
      (fun i : P.Index =>
        (⟨(path' i).source, by
          rw [hpath_source i]
          exact P.source_mem i⟩ : {v // v ∈ S}))
    have hsrc :
        (fun i : P.Index =>
          (⟨(path' i).source, by
            rw [hpath_source i]
            exact P.source_mem i⟩ : {v // v ∈ S})) =
        (fun i : P.Index =>
          (⟨(P.path i).source, P.source_mem i⟩ : {v // v ∈ S})) := by
      funext i
      apply Subtype.ext
      exact hpath_source i
    simpa [hsrc] using P.source_bijective
  · change Function.Bijective
      (fun i : P.Index =>
        (⟨(path' i).target, hpath_target_mem i⟩ : {v // v ∈ T}))
    constructor
    · intro i l hil
      have hv : (path' i).target = (path' l).target :=
        congrArg Subtype.val hil
      by_cases hij' : i = j
      · have hpi : path' i = Pj := by
          simp [path', hij']
        by_cases hlj : l = j
        · exact hij'.trans hlj.symm
        · by_cases hlk : l = k
          · have hpl : path' l = Pk := by
              rw [hlk]
              simp [path', hjk.symm]
            have htarget_eq :
                (P.path k).target = (P.path j).target := by
              simpa [hpi, hpl, htarget_j, htarget_k] using hv
            have hkj : k = j := P.target_bijective.1 (by
              apply Subtype.ext
              exact htarget_eq)
            exact False.elim (hjk hkj.symm)
          · have hpl : path' l = P.path l := by
              simp [path', hlj, hlk]
            have htarget_eq :
                (P.path k).target = (P.path l).target := by
              simpa [hpi, hpl, htarget_j] using hv
            have hkl : k = l := P.target_bijective.1 (by
              apply Subtype.ext
              exact htarget_eq)
            exact False.elim (hlk hkl.symm)
      · by_cases hik' : i = k
        · have hpi : path' i = Pk := by
            rw [hik']
            simp [path', hjk.symm]
          by_cases hlj : l = j
          · have hpl : path' l = Pj := by
              simp [path', hlj]
            have htarget_eq :
                (P.path j).target = (P.path k).target := by
              simpa [hpi, hpl, htarget_j, htarget_k] using hv
            have hjk' : j = k := P.target_bijective.1 (by
              apply Subtype.ext
              exact htarget_eq)
            exact False.elim (hjk hjk')
          · by_cases hlk : l = k
            · exact hik'.trans hlk.symm
            · have hpl : path' l = P.path l := by
                simp [path', hlj, hlk]
              have htarget_eq :
                  (P.path j).target = (P.path l).target := by
                simpa [hpi, hpl, htarget_k] using hv
              have hjl : j = l := P.target_bijective.1 (by
                apply Subtype.ext
                exact htarget_eq)
              exact False.elim (hlj hjl.symm)
        · by_cases hlj : l = j
          · have hpi : path' i = P.path i := by
              simp [path', hij', hik']
            have hpl : path' l = Pj := by
              simp [path', hlj]
            have htarget_eq :
                (P.path i).target = (P.path k).target := by
              simpa [hpi, hpl, htarget_j] using hv
            have hik_contra : i = k := P.target_bijective.1 (by
              apply Subtype.ext
              exact htarget_eq)
            exact False.elim (hik' hik_contra)
          · by_cases hlk : l = k
            · have hpi : path' i = P.path i := by
                simp [path', hij', hik']
              have hpl : path' l = Pk := by
                rw [hlk]
                simp [path', hjk.symm]
              have htarget_eq :
                  (P.path i).target = (P.path j).target := by
                simpa [hpi, hpl, htarget_k] using hv
              have hij_contra : i = j := P.target_bijective.1 (by
                apply Subtype.ext
                exact htarget_eq)
              exact False.elim (hij' hij_contra)
            · have hpi : path' i = P.path i := by
                simp [path', hij', hik']
              have hpl : path' l = P.path l := by
                simp [path', hlj, hlk]
              have htarget_eq :
                  (P.path i).target = (P.path l).target := by
                simpa [hpi, hpl] using hv
              exact P.target_bijective.1 (by
                apply Subtype.ext
                exact htarget_eq)
    · intro v
      rcases P.target_bijective.2 v with ⟨i, hi⟩
      have hval : (P.path i).target = v.1 :=
        congrArg Subtype.val hi
      by_cases hij' : i = j
      · refine ⟨k, ?_⟩
        apply Subtype.ext
        have hpk : path' k = Pk := by
          simp [path', hjk.symm]
        simpa [hpk, hij', htarget_k] using hval
      · by_cases hik' : i = k
        · refine ⟨j, ?_⟩
          apply Subtype.ext
          have hpj : path' j = Pj := by
            simp [path']
          simpa [hpj, hik', htarget_j] using hval
        · refine ⟨i, ?_⟩
          apply Subtype.ext
          have hpi : path' i = P.path i := by
            simp [path', hij', hik']
          simpa [hpi] using hval

@[simp] theorem replaceTwoPathsSwapTargets_path_left
    (P : PerfectPathPacking G S T) (j k : P.Index) (hjk : j ≠ k)
    (Pj Pk : GraphPath G)
    (hsource_j : Pj.source = (P.path j).source)
    (htarget_j : Pj.target = (P.path k).target)
    (hsource_k : Pk.source = (P.path k).source)
    (htarget_k : Pk.target = (P.path j).target)
    (hjk_disj : Pj.NodeDisjoint Pk)
    (hPj_disj :
      ∀ i : P.Index, i ≠ j → i ≠ k → Pj.NodeDisjoint (P.path i))
    (hPk_disj :
      ∀ i : P.Index, i ≠ j → i ≠ k → Pk.NodeDisjoint (P.path i)) :
    ((replaceTwoPathsSwapTargets P j k hjk Pj Pk hsource_j htarget_j
      hsource_k htarget_k hjk_disj hPj_disj hPk_disj).path j) = Pj := by
  simp [replaceTwoPathsSwapTargets]

@[simp] theorem replaceTwoPathsSwapTargets_path_right
    (P : PerfectPathPacking G S T) (j k : P.Index) (hjk : j ≠ k)
    (Pj Pk : GraphPath G)
    (hsource_j : Pj.source = (P.path j).source)
    (htarget_j : Pj.target = (P.path k).target)
    (hsource_k : Pk.source = (P.path k).source)
    (htarget_k : Pk.target = (P.path j).target)
    (hjk_disj : Pj.NodeDisjoint Pk)
    (hPj_disj :
      ∀ i : P.Index, i ≠ j → i ≠ k → Pj.NodeDisjoint (P.path i))
    (hPk_disj :
      ∀ i : P.Index, i ≠ j → i ≠ k → Pk.NodeDisjoint (P.path i)) :
    ((replaceTwoPathsSwapTargets P j k hjk Pj Pk hsource_j htarget_j
      hsource_k htarget_k hjk_disj hPj_disj hPk_disj).path k) = Pk := by
  simp [replaceTwoPathsSwapTargets, hjk.symm]

@[simp] theorem replaceTwoPathsSwapTargets_path_of_ne
    (P : PerfectPathPacking G S T) (j k i : P.Index) (hjk : j ≠ k)
    (Pj Pk : GraphPath G)
    (hsource_j : Pj.source = (P.path j).source)
    (htarget_j : Pj.target = (P.path k).target)
    (hsource_k : Pk.source = (P.path k).source)
    (htarget_k : Pk.target = (P.path j).target)
    (hjk_disj : Pj.NodeDisjoint Pk)
    (hPj_disj :
      ∀ i : P.Index, i ≠ j → i ≠ k → Pj.NodeDisjoint (P.path i))
    (hPk_disj :
      ∀ i : P.Index, i ≠ j → i ≠ k → Pk.NodeDisjoint (P.path i))
    (hij : i ≠ j) (hik : i ≠ k) :
    ((replaceTwoPathsSwapTargets P j k hjk Pj Pk hsource_j htarget_j
      hsource_k htarget_k hjk_disj hPj_disj hPk_disj).path i) =
        P.path i := by
  simp [replaceTwoPathsSwapTargets, hij, hik]

end PerfectPathPacking

namespace BumpWitness

variable {I : IterationInput R hpos Q0} (Bump : BumpWitness I)

/-- The linkage `L''` obtained from the current linkage by replacing the row
path containing the bump with the constructed bumped row.

The only extra input is the vertex-disjointness check against all unchanged
linkage paths.  Once that check is available, `PerfectPathPacking` supplies the
full `A`--`B` linkage structure, including endpoint bijections. -/
noncomputable def replacementLinkage
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i)) :
    PerfectPathPacking G A B :=
  PerfectPathPacking.replacePathSameEndpoints I.linkage
    (I.rowIndex Bump.row) Bump.replacementPath.path
    (by
      rw [Bump.replacementPath.source_eq]
      exact congrArg GraphPath.source (I.rowPath_eq_linkage_path Bump.row))
    (by
      rw [Bump.replacementPath.target_eq]
      exact congrArg GraphPath.target (I.rowPath_eq_linkage_path Bump.row))
    hdisj

@[simp] theorem replacementLinkage_path_row
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i)) :
    (Bump.replacementLinkage hdisj).path (I.rowIndex Bump.row) =
      Bump.replacementPath.path := by
  simp [replacementLinkage]

@[simp] theorem replacementLinkage_path_of_ne
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    {i : I.linkage.Index} (hi : i ≠ I.rowIndex Bump.row) :
    (Bump.replacementLinkage hdisj).path i = I.linkage.path i := by
  simp [replacementLinkage, hi]

/-- The bump replacement linkage with the disjointness proof discharged from
the bump witness itself. -/
noncomputable def replacementLinkageConcrete : PerfectPathPacking G A B :=
  Bump.replacementLinkage Bump.replacementPath_nodeDisjoint_unchanged_all

@[simp] theorem replacementLinkageConcrete_path_row :
    Bump.replacementLinkageConcrete.path (I.rowIndex Bump.row) =
      Bump.replacementPath.path := by
  simp [replacementLinkageConcrete]

@[simp] theorem replacementLinkageConcrete_path_of_ne
    {i : I.linkage.Index} (hi : i ≠ I.rowIndex Bump.row) :
    Bump.replacementLinkageConcrete.path i = I.linkage.path i := by
  simp [replacementLinkageConcrete, hi]

/-- After a bump, the deleted middle row segment is clean with respect to the
replacement linkage.  Its endpoints remain on the replacement row, while its
interior is no longer a linkage vertex. -/
theorem deletedRowSegment_clean_replacementLinkageConcrete :
    Bump.deletedRowSegment.InternallyDisjointFromSet
      Bump.replacementLinkageConcrete.toPathPacking.vertexSet := by
  classical
  intro v hvdel hvnew
  rcases (Bump.replacementLinkageConcrete.toPathPacking.mem_vertexSet).1
      hvnew with ⟨i, hvi⟩
  by_cases hirow : i = I.rowIndex Bump.row
  · subst hirow
    have hvrep : v ∈ Bump.replacementPath.path.vertexSet := by
      simpa [Bump.replacementLinkageConcrete_path_row] using hvi
    have hparts := Bump.replacementPath.vertexSet_subset_parts hvrep
    rcases Finset.mem_union.1 hparts with hpre_or_seg | hsuf
    · rcases Finset.mem_union.1 hpre_or_seg with hpre | hseg
      · exact Or.inl (Bump.deletedRowSegment_inter_prefix_endpoint
          hvdel hpre)
      · have hvrow : v ∈ I.rowVertexSet := by
          rw [IterationInput.rowVertexSet]
          exact Finset.mem_biUnion.mpr
            ⟨Bump.row, Finset.mem_univ _, by
              exact (I.rowPath Bump.row).segmentOfBefore_vertexSet_subset
                Bump.left_before_right hvdel⟩
        have hend := Bump.orientedSegment_clean_rows hseg hvrow
        rcases hend with hleft | hright
        · exact Or.inl (by simpa [Bump.deletedRowSegment_source] using hleft)
        · exact Or.inr (by simpa [Bump.deletedRowSegment_target] using hright)
    · exact Or.inr (Bump.deletedRowSegment_inter_suffix_endpoint
        hvdel hsuf)
  · have hvrow :
        v ∈ (I.rowPath Bump.row).vertexSet :=
      (I.rowPath Bump.row).segmentOfBefore_vertexSet_subset
        Bump.left_before_right hvdel
    have hvrow_old :
        v ∈ (I.linkage.path (I.rowIndex Bump.row)).vertexSet := by
      simpa [I.rowPath_eq_linkage_path Bump.row] using hvrow
    have hvi_old : v ∈ (I.linkage.path i).vertexSet := by
      simpa [Bump.replacementLinkageConcrete_path_of_ne hirow] using hvi
    exact False.elim <|
      Finset.disjoint_left.mp
        (I.linkage.toPathPacking.node_disjoint (fun h => hirow h.symm))
        hvrow_old hvi_old

/-- Vertices of the old row segment removed by the bump. -/
noncomputable def deletedMiddleVertexSet : Finset V :=
  Bump.deletedRowSegment.vertexSet

/-- Vertices of the inserted transversal segment used by the bump. -/
noncomputable def insertedSegmentVertexSet : Finset V :=
  Bump.orientedSegment.vertexSet

/-- The old bumped row is covered by the retained prefix, the deleted middle,
and the retained suffix. -/
theorem row_vertex_mem_prefix_or_deleted_or_suffix
    {v : V} (hv : v ∈ (I.rowPath Bump.row).vertexSet) :
    v ∈ ((I.rowPath Bump.row).takeUntil Bump.left_mem_row).vertexSet ∨
      v ∈ Bump.deletedRowSegment.vertexSet ∨
        v ∈ ((I.rowPath Bump.row).dropUntil Bump.right_mem_row).vertexSet := by
  classical
  by_cases hv_before_left : (I.rowPath Bump.row).Before v Bump.left
  · exact Or.inl
      ((I.rowPath Bump.row).mem_takeUntil_of_before
        Bump.left_mem_row hv_before_left)
  · by_cases hright_before_v : (I.rowPath Bump.row).Before Bump.right v
    · rcases hright_before_v with ⟨_, hvdrop⟩
      exact Or.inr <| Or.inr (by simpa using hvdrop)
    · have hleft_before_v : (I.rowPath Bump.row).Before Bump.left v := by
        rcases le_total
            ((I.rowPath Bump.row).vertexIndex Bump.left)
            ((I.rowPath Bump.row).vertexIndex v) with hle | hle
        · exact ((I.rowPath Bump.row).before_iff_vertexIndex_le).2
            ⟨Bump.left_mem_row, hv, hle⟩
        · exact False.elim (hv_before_left
            (((I.rowPath Bump.row).before_iff_vertexIndex_le).2
              ⟨hv, Bump.left_mem_row, hle⟩))
      have hv_before_right : (I.rowPath Bump.row).Before v Bump.right := by
        rcases le_total
            ((I.rowPath Bump.row).vertexIndex v)
            ((I.rowPath Bump.row).vertexIndex Bump.right) with hle | hle
        · exact ((I.rowPath Bump.row).before_iff_vertexIndex_le).2
            ⟨hv, Bump.right_mem_row, hle⟩
        · exact False.elim (hright_before_v
            (((I.rowPath Bump.row).before_iff_vertexIndex_le).2
              ⟨Bump.right_mem_row, hv, hle⟩))
      exact Or.inr <| Or.inl <|
        (I.rowPath Bump.row).mem_segmentOfBefore_of_before_of_before
          Bump.left_before_right hleft_before_v hv_before_right

/-- Any old linkage vertex that disappears after a bump lies on the deleted
middle row segment. -/
theorem old_link_vertex_not_new_mem_deletedMiddle
    {v : V} (hold : v ∈ I.linkage.toPathPacking.vertexSet)
    (hnew : v ∉ Bump.replacementLinkageConcrete.toPathPacking.vertexSet) :
    v ∈ Bump.deletedMiddleVertexSet := by
  classical
  rcases (I.linkage.toPathPacking.mem_vertexSet).1 hold with ⟨i, hvi⟩
  by_cases hirow : i = I.rowIndex Bump.row
  · subst hirow
    have hvrow : v ∈ (I.rowPath Bump.row).vertexSet := by
      simpa [I.rowPath_eq_linkage_path Bump.row] using hvi
    rcases Bump.row_vertex_mem_prefix_or_deleted_or_suffix hvrow with
      hpre | hmid | hsuf
    · have hvrep : v ∈ Bump.replacementPath.path.vertexSet :=
        Bump.replacementPath.prefix_subset_path hpre
      have hvnew :
          v ∈ Bump.replacementLinkageConcrete.toPathPacking.vertexSet :=
        (Bump.replacementLinkageConcrete.toPathPacking.mem_vertexSet).2
          ⟨I.rowIndex Bump.row, by
            simpa [Bump.replacementLinkageConcrete_path_row] using hvrep⟩
      exact False.elim (hnew hvnew)
    · simpa [deletedMiddleVertexSet] using hmid
    · have hvrep : v ∈ Bump.replacementPath.path.vertexSet :=
        Bump.replacementPath.suffix_subset_path hsuf
      have hvnew :
          v ∈ Bump.replacementLinkageConcrete.toPathPacking.vertexSet :=
        (Bump.replacementLinkageConcrete.toPathPacking.mem_vertexSet).2
          ⟨I.rowIndex Bump.row, by
            simpa [Bump.replacementLinkageConcrete_path_row] using hvrep⟩
      exact False.elim (hnew hvnew)
  · have hvnew_path :
        v ∈ (Bump.replacementLinkageConcrete.path i).vertexSet := by
      simpa [Bump.replacementLinkageConcrete_path_of_ne hirow] using hvi
    have hvnew :
        v ∈ Bump.replacementLinkageConcrete.toPathPacking.vertexSet :=
      (Bump.replacementLinkageConcrete.toPathPacking.mem_vertexSet).2
        ⟨i, hvnew_path⟩
    exact False.elim (hnew hvnew)

/-- Any new linkage vertex that was not already an old linkage vertex lies on
the inserted bump segment. -/
theorem new_link_vertex_not_old_mem_insertedSegment
    {v : V}
    (hnew : v ∈ Bump.replacementLinkageConcrete.toPathPacking.vertexSet)
    (hold : v ∉ I.linkage.toPathPacking.vertexSet) :
    v ∈ Bump.insertedSegmentVertexSet := by
  classical
  rcases (Bump.replacementLinkageConcrete.toPathPacking.mem_vertexSet).1
      hnew with ⟨i, hvi⟩
  by_cases hirow : i = I.rowIndex Bump.row
  · subst hirow
    have hvrep : v ∈ Bump.replacementPath.path.vertexSet := by
      simpa [Bump.replacementLinkageConcrete_path_row] using hvi
    have hparts := Bump.replacementPath.vertexSet_subset_parts hvrep
    rcases Finset.mem_union.1 hparts with hpre_or_mid | hsuf
    · rcases Finset.mem_union.1 hpre_or_mid with hpre | hmid
      · have hvrow :
            v ∈ (I.rowPath Bump.row).vertexSet :=
          (I.rowPath Bump.row).takeUntil_vertexSet_subset
            Bump.left_mem_row hpre
        have hvold :
            v ∈ I.linkage.toPathPacking.vertexSet :=
          (I.linkage.toPathPacking.mem_vertexSet).2
            ⟨I.rowIndex Bump.row, by
              simpa [I.rowPath_eq_linkage_path Bump.row] using hvrow⟩
        exact False.elim (hold hvold)
      · change v ∈ Bump.orientedSegment.vertexSet
        exact hmid
    · have hvrow :
          v ∈ (I.rowPath Bump.row).vertexSet :=
        (I.rowPath Bump.row).dropUntil_vertexSet_subset
          Bump.right_mem_row hsuf
      have hvold :
          v ∈ I.linkage.toPathPacking.vertexSet :=
        (I.linkage.toPathPacking.mem_vertexSet).2
          ⟨I.rowIndex Bump.row, by
            simpa [I.rowPath_eq_linkage_path Bump.row] using hvrow⟩
      exact False.elim (hold hvold)
  · have hvold_path :
        v ∈ (I.linkage.path i).vertexSet := by
      simpa [Bump.replacementLinkageConcrete_path_of_ne hirow] using hvi
    have hvold :
        v ∈ I.linkage.toPathPacking.vertexSet :=
      (I.linkage.toPathPacking.mem_vertexSet).2 ⟨i, hvold_path⟩
    exact False.elim (hold hvold)

/-- A path clean for the successor bump linkage and missing the deleted
middle is clean for the old linkage. -/
theorem internallyDisjoint_old_of_new_clean_disjoint_deleted
    (P : GraphPath G)
    (hclean :
      P.InternallyDisjointFromSet
        Bump.replacementLinkageConcrete.toPathPacking.vertexSet)
    (hmiss : Disjoint P.vertexSet Bump.deletedMiddleVertexSet) :
    P.InternallyDisjointFromSet I.linkage.toPathPacking.vertexSet := by
  intro v hvP hvold
  by_cases hvnew :
      v ∈ Bump.replacementLinkageConcrete.toPathPacking.vertexSet
  · exact hclean hvP hvnew
  · have hvdel := Bump.old_link_vertex_not_new_mem_deletedMiddle hvold hvnew
    exact False.elim (Finset.disjoint_left.mp hmiss hvP hvdel)

/-- A path clean for the old linkage and missing the inserted bump segment is
clean for the successor bump linkage. -/
theorem internallyDisjoint_new_of_old_clean_disjoint_inserted
    (P : GraphPath G)
    (hclean :
      P.InternallyDisjointFromSet I.linkage.toPathPacking.vertexSet)
    (hmiss : Disjoint P.vertexSet Bump.insertedSegmentVertexSet) :
    P.InternallyDisjointFromSet
      Bump.replacementLinkageConcrete.toPathPacking.vertexSet := by
  intro v hvP hvnew
  by_cases hvold : v ∈ I.linkage.toPathPacking.vertexSet
  · exact hclean hvP hvold
  · have hvins := Bump.new_link_vertex_not_old_mem_insertedSegment hvnew hvold
    exact False.elim (Finset.disjoint_left.mp hmiss hvP hvins)

/-- A successor bridge between unchanged linkage paths is already an old
bridge if it misses the deleted middle interval. -/
theorem old_aux_adj_of_new_bridge_unchanged_miss_deleted
    {i j : I.linkage.Index} (hij : i ≠ j)
    (hirow : i ≠ I.rowIndex Bump.row)
    (hjrow : j ≠ I.rowIndex Bump.row)
    (β :
      Bump.replacementLinkageConcrete.toPathPacking.BridgeBetween i j)
    (hmiss : Disjoint β.orientedPath.vertexSet Bump.deletedMiddleVertexSet) :
    (linkageAuxGraph I.linkage).Adj i j := by
  refine ⟨hij, Or.inl ?_⟩
  refine ⟨PathPacking.BridgeBetween.of_orientedPath
    I.linkage.toPathPacking β.orientedPath ?_ ?_ ?_⟩
  · have hsrc :=
      PathPacking.BridgeBetween.orientedPath_source_mem_left β
    simpa [Bump.replacementLinkageConcrete_path_of_ne hirow] using hsrc
  · have htgt :=
      PathPacking.BridgeBetween.orientedPath_target_mem_right β
    simpa [Bump.replacementLinkageConcrete_path_of_ne hjrow] using htgt
  · exact Bump.internallyDisjoint_old_of_new_clean_disjoint_deleted
      β.orientedPath β.orientedPath_internallyDisjoint hmiss

/-- An old bridge between unchanged linkage paths survives as a successor
bridge if it misses the inserted bump segment. -/
theorem new_aux_adj_of_old_bridge_unchanged_miss_inserted
    {i j : I.linkage.Index} (hij : i ≠ j)
    (hirow : i ≠ I.rowIndex Bump.row)
    (hjrow : j ≠ I.rowIndex Bump.row)
    (β : I.linkage.toPathPacking.BridgeBetween i j)
    (hmiss : Disjoint β.orientedPath.vertexSet Bump.insertedSegmentVertexSet) :
    (linkageAuxGraph Bump.replacementLinkageConcrete).Adj i j := by
  refine ⟨hij, Or.inl ?_⟩
  refine ⟨PathPacking.BridgeBetween.of_orientedPath
    Bump.replacementLinkageConcrete.toPathPacking β.orientedPath ?_ ?_ ?_⟩
  · have hsrc :=
      PathPacking.BridgeBetween.orientedPath_source_mem_left β
    simpa [Bump.replacementLinkageConcrete_path_of_ne hirow] using hsrc
  · have htgt :=
      PathPacking.BridgeBetween.orientedPath_target_mem_right β
    simpa [Bump.replacementLinkageConcrete_path_of_ne hjrow] using htgt
  · exact Bump.internallyDisjoint_new_of_old_clean_disjoint_inserted
      β.orientedPath β.orientedPath_internallyDisjoint hmiss

/-- If a successor-clean path is stopped at its first deleted-middle hit, the
prefix is clean with respect to the old linkage. -/
theorem cleanPrefixToDeleted_internallyDisjoint_old_of_new_clean
    (P : GraphPath G)
    (hclean :
      P.InternallyDisjointFromSet
        Bump.replacementLinkageConcrete.toPathPacking.vertexSet)
    (hne : (P.vertexSet ∩ Bump.deletedMiddleVertexSet).Nonempty) :
    (P.cleanPrefixToSet Bump.deletedMiddleVertexSet hne).InternallyDisjointFromSet
      I.linkage.toPathPacking.vertexSet := by
  intro v hvPrefix hvold
  have hcleanPrefixNew :
      (P.cleanPrefixToSet Bump.deletedMiddleVertexSet hne).InternallyDisjointFromSet
        Bump.replacementLinkageConcrete.toPathPacking.vertexSet := by
    simpa [GraphPath.cleanPrefixToSet] using
      P.takeUntil_internallyDisjointFromSet
        (P.firstHitVertex_mem_vertexSet Bump.deletedMiddleVertexSet hne)
        hclean
  by_cases hvnew :
      v ∈ Bump.replacementLinkageConcrete.toPathPacking.vertexSet
  · exact hcleanPrefixNew hvPrefix hvnew
  · have hvdel := Bump.old_link_vertex_not_new_mem_deletedMiddle hvold hvnew
    have hv_eq :
        v = P.firstHitVertex Bump.deletedMiddleVertexSet hne :=
      P.eq_firstHitVertex_of_mem_takeUntil_of_mem_set
        Bump.deletedMiddleVertexSet hne (by
          simpa [GraphPath.cleanPrefixToSet] using hvPrefix) hvdel
    exact Or.inr (by simp [GraphPath.cleanPrefixToSet, hv_eq])

/-- A successor bridge from an unchanged row that first hits the deleted
middle witnesses an old auxiliary edge to the bumped row. -/
theorem old_aux_adj_to_bumped_row_of_new_bridge_hits_deleted
    {i j : I.linkage.Index}
    (hirow : i ≠ I.rowIndex Bump.row)
    (β :
      Bump.replacementLinkageConcrete.toPathPacking.BridgeBetween i j)
    (hne : (β.orientedPath.vertexSet ∩
      Bump.deletedMiddleVertexSet).Nonempty) :
    (linkageAuxGraph I.linkage).Adj i (I.rowIndex Bump.row) := by
  classical
  let P : GraphPath G := β.orientedPath
  let Prefix : GraphPath G :=
    P.cleanPrefixToSet Bump.deletedMiddleVertexSet hne
  have hsrc_new :
      P.source ∈
        (Bump.replacementLinkageConcrete.path i).vertexSet :=
    PathPacking.BridgeBetween.orientedPath_source_mem_left β
  have hsrc_old : Prefix.source ∈ (I.linkage.path i).vertexSet := by
    simpa [Prefix, P, Bump.replacementLinkageConcrete_path_of_ne hirow]
      using hsrc_new
  have hclean_old :
      Prefix.InternallyDisjointFromSet I.linkage.toPathPacking.vertexSet := by
    simpa [Prefix, P] using
      Bump.cleanPrefixToDeleted_internallyDisjoint_old_of_new_clean
        P β.orientedPath_internallyDisjoint hne
  have htgt_del :
      Prefix.target ∈ Bump.deletedMiddleVertexSet := by
    simpa [Prefix, P] using
      P.cleanPrefixToSet_target_mem Bump.deletedMiddleVertexSet hne
  have htgt_old :
      Prefix.target ∈
        (I.linkage.path (I.rowIndex Bump.row)).vertexSet := by
    have htgt_row :
      Prefix.target ∈ (I.rowPath Bump.row).vertexSet :=
      (I.rowPath Bump.row).segmentOfBefore_vertexSet_subset
        Bump.left_before_right (by
          change Prefix.target ∈ Bump.deletedRowSegment.vertexSet at htgt_del
          exact htgt_del)
    simpa [I.rowPath_eq_linkage_path Bump.row] using htgt_row
  exact ⟨hirow, Or.inl
    ⟨PathPacking.BridgeBetween.of_orientedPath
      I.linkage.toPathPacking Prefix hsrc_old htgt_old hclean_old⟩⟩

/-- Any old auxiliary edge to the bumped row has its other endpoint in the
local triple. -/
theorem mem_local_triple_of_old_adj_to_bumped_row
    {i auxA auxC : I.linkage.Index}
    (hAM_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Bump.row))
    (hMC_old :
      (linkageAuxGraph I.linkage).Adj (I.rowIndex Bump.row) auxC)
    (hM_old :
      DegreeEquals (linkageAuxGraph I.linkage) (I.rowIndex Bump.row) 2)
    (hA_ne_C : auxA ≠ auxC)
    (hadj :
      (linkageAuxGraph I.linkage).Adj i (I.rowIndex Bump.row)) :
    i ∈ ({auxA, I.rowIndex Bump.row, auxC} :
        Finset I.linkage.Index) := by
  classical
  have hi :
      i = auxA ∨ i = auxC := by
    have h := DegreeEquals.two_adj_eq_or_eq
      (G := linkageAuxGraph I.linkage) hM_old
      ((linkageAuxGraph I.linkage).symm hAM_old) hMC_old
      hA_ne_C ((linkageAuxGraph I.linkage).symm hadj)
    rcases h with h | h
    · exact Or.inl h
    · exact Or.inr h
  rcases hi with rfl | rfl <;> simp

/-- If the first inserted hit of an old bridge lies on the inserted bump
segment, then the bridge prefix, possibly followed along that segment,
witnesses an old auxiliary edge to the bumped row. -/
theorem old_aux_adj_to_bumped_row_of_old_bridge_hits_inserted
    {i j : I.linkage.Index}
    (hirow : i ≠ I.rowIndex Bump.row)
    (β : I.linkage.toPathPacking.BridgeBetween i j)
    (hne : (β.orientedPath.vertexSet ∩
      Bump.insertedSegmentVertexSet).Nonempty) :
    (linkageAuxGraph I.linkage).Adj i (I.rowIndex Bump.row) := by
  classical
  let P : GraphPath G := β.orientedPath
  let Prefix : GraphPath G :=
    P.cleanPrefixToSet Bump.insertedSegmentVertexSet hne
  have hsrc_old : Prefix.source ∈ (I.linkage.path i).vertexSet := by
    simpa [Prefix, P] using
      PathPacking.BridgeBetween.orientedPath_source_mem_left β
  have hprefix_clean :
      Prefix.InternallyDisjointFromSet I.linkage.toPathPacking.vertexSet := by
    simpa [Prefix, P, GraphPath.cleanPrefixToSet] using
      P.takeUntil_internallyDisjointFromSet
        (P.firstHitVertex_mem_vertexSet Bump.insertedSegmentVertexSet hne)
        β.orientedPath_internallyDisjoint
  have hxseg :
      Prefix.target ∈ Bump.orientedSegment.vertexSet := by
    have hx :
        Prefix.target ∈ Bump.insertedSegmentVertexSet := by
      simpa [Prefix, P] using
        P.cleanPrefixToSet_target_mem Bump.insertedSegmentVertexSet hne
    change Prefix.target ∈ Bump.orientedSegment.vertexSet at hx
    exact hx
  by_cases hxold : Prefix.target ∈ I.linkage.toPathPacking.vertexSet
  · have hend := Bump.orientedSegment_clean_linkage hxseg hxold
    rcases hend with hleft | hright
    · have htgt_old :
          Prefix.target ∈
            (I.linkage.path (I.rowIndex Bump.row)).vertexSet := by
        have hrow : Prefix.target ∈ (I.rowPath Bump.row).vertexSet := by
          rw [hleft, Bump.orientedSegment_source]
          exact Bump.left_mem_row
        simpa [I.rowPath_eq_linkage_path Bump.row] using hrow
      exact ⟨hirow, Or.inl
        ⟨PathPacking.BridgeBetween.of_orientedPath
          I.linkage.toPathPacking Prefix hsrc_old htgt_old
          hprefix_clean⟩⟩
    · have htgt_old :
          Prefix.target ∈
            (I.linkage.path (I.rowIndex Bump.row)).vertexSet := by
        have hrow : Prefix.target ∈ (I.rowPath Bump.row).vertexSet := by
          rw [hright, Bump.orientedSegment_target]
          exact Bump.right_mem_row
        simpa [I.rowPath_eq_linkage_path Bump.row] using hrow
      exact ⟨hirow, Or.inl
        ⟨PathPacking.BridgeBetween.of_orientedPath
          I.linkage.toPathPacking Prefix hsrc_old htgt_old
          hprefix_clean⟩⟩
  · let Tail : GraphPath G := Bump.orientedSegment.dropUntil hxseg
    have hglue : Prefix.target = Tail.source := by
      simp [Tail, Prefix, P]
    have hinter :
        ∀ ⦃v : V⦄, v ∈ Prefix.vertexSet → v ∈ Tail.vertexSet →
          v = Prefix.target := by
      intro v hvpre hvtail
      have hvtail_seg :
          v ∈ Bump.orientedSegment.vertexSet :=
        Bump.orientedSegment.dropUntil_vertexSet_subset hxseg
          (by simpa [Tail] using hvtail)
      have hvins : v ∈ Bump.insertedSegmentVertexSet := by
        change v ∈ Bump.orientedSegment.vertexSet
        exact hvtail_seg
      have hv_eq :
          v = P.firstHitVertex Bump.insertedSegmentVertexSet hne :=
        P.eq_firstHitVertex_of_mem_takeUntil_of_mem_set
          Bump.insertedSegmentVertexSet hne
          (by simpa [Prefix, GraphPath.cleanPrefixToSet] using hvpre) hvins
      simpa [Prefix, P, GraphPath.cleanPrefixToSet] using hv_eq
    let Joined : GraphPath G :=
      Prefix.appendWithEqOfInterSubsetTarget Tail hglue hinter
    have htail_clean :
        Tail.InternallyDisjointFromSet I.linkage.toPathPacking.vertexSet := by
      simpa [Tail] using
        Bump.orientedSegment.dropUntil_internallyDisjointFromSet
          hxseg Bump.orientedSegment_clean_linkage
    have hjoined_clean :
        Joined.InternallyDisjointFromSet I.linkage.toPathPacking.vertexSet := by
      simpa [Joined] using
        Prefix.appendWithEqOfInterSubsetTarget_internallyDisjointFromSet
          Tail hglue hinter hprefix_clean htail_clean hxold
    have hjoined_src :
        Joined.source ∈ (I.linkage.path i).vertexSet := by
      simpa [Joined] using hsrc_old
    have hjoined_tgt :
        Joined.target ∈
          (I.linkage.path (I.rowIndex Bump.row)).vertexSet := by
      have htgt : Joined.target = Bump.right := by
        simp [Joined, Tail]
      have hrow : Joined.target ∈ (I.rowPath Bump.row).vertexSet := by
        simpa [htgt] using Bump.right_mem_row
      simpa [I.rowPath_eq_linkage_path Bump.row] using hrow
    exact ⟨hirow, Or.inl
      ⟨PathPacking.BridgeBetween.of_orientedPath
        I.linkage.toPathPacking Joined hjoined_src hjoined_tgt
        hjoined_clean⟩⟩

/-- Reverse a bridge between two indexed paths. -/
noncomputable def reverseBridge
    {P : PathPacking G A B} {i j : P.Index}
    (β : P.BridgeBetween i j) : P.BridgeBetween j i where
  path := β.path.reverse
  connects := by
    rcases β.connects with h | h
    · exact Or.inl ⟨by simpa using h.2, by simpa using h.1⟩
    · exact Or.inr ⟨by simpa using h.2, by simpa using h.1⟩
  internallyDisjoint := by
    exact (β.path.reverse_internallyDisjointFromSet P.vertexSet).2
      β.internallyDisjoint

/-- A successor bridge from an unchanged row to the replacement row localizes
to an old auxiliary edge to the bumped row. -/
theorem old_aux_adj_to_bumped_row_of_new_bridge_to_replacement
    {i : I.linkage.Index}
    (hirow : i ≠ I.rowIndex Bump.row)
    (β :
      Bump.replacementLinkageConcrete.toPathPacking.BridgeBetween
        i (I.rowIndex Bump.row)) :
    (linkageAuxGraph I.linkage).Adj i (I.rowIndex Bump.row) := by
  classical
  by_cases hhit :
      (β.orientedPath.vertexSet ∩ Bump.deletedMiddleVertexSet).Nonempty
  · exact Bump.old_aux_adj_to_bumped_row_of_new_bridge_hits_deleted
      hirow β hhit
  · have hmiss :
        Disjoint β.orientedPath.vertexSet Bump.deletedMiddleVertexSet := by
      rw [Finset.disjoint_left]
      intro v hvP hvDel
      exact hhit ⟨v, Finset.mem_inter.2 ⟨hvP, hvDel⟩⟩
    let P : GraphPath G := β.orientedPath
    have hsrc_old : P.source ∈ (I.linkage.path i).vertexSet := by
      have hsrc_new :=
        PathPacking.BridgeBetween.orientedPath_source_mem_left β
      simpa [P, Bump.replacementLinkageConcrete_path_of_ne hirow]
        using hsrc_new
    have hclean_old :
        P.InternallyDisjointFromSet I.linkage.toPathPacking.vertexSet := by
      exact Bump.internallyDisjoint_old_of_new_clean_disjoint_deleted
        P β.orientedPath_internallyDisjoint hmiss
    have htgt_rep :
        P.target ∈ Bump.replacementPath.path.vertexSet := by
      have htgt_new :=
        PathPacking.BridgeBetween.orientedPath_target_mem_right β
      simpa [P, Bump.replacementLinkageConcrete_path_row] using htgt_new
    have hparts := Bump.replacementPath.vertexSet_subset_parts htgt_rep
    rcases Finset.mem_union.1 hparts with hpre_or_seg | hsuf
    · rcases Finset.mem_union.1 hpre_or_seg with hpre | hseg
      · have htgt_old :
            P.target ∈
              (I.linkage.path (I.rowIndex Bump.row)).vertexSet := by
          have hrow :
              P.target ∈ (I.rowPath Bump.row).vertexSet :=
            (I.rowPath Bump.row).takeUntil_vertexSet_subset
              Bump.left_mem_row hpre
          simpa [I.rowPath_eq_linkage_path Bump.row] using hrow
        exact ⟨hirow, Or.inl
          ⟨PathPacking.BridgeBetween.of_orientedPath
            I.linkage.toPathPacking P hsrc_old htgt_old hclean_old⟩⟩
      · have hxseg : P.target ∈ Bump.orientedSegment.vertexSet := hseg
        by_cases hxold : P.target ∈ I.linkage.toPathPacking.vertexSet
        · have hend := Bump.orientedSegment_clean_linkage hxseg hxold
          rcases hend with hleft | hright
          · have htgt_old :
                P.target ∈
                  (I.linkage.path (I.rowIndex Bump.row)).vertexSet := by
              have hrow :
                  P.target ∈ (I.rowPath Bump.row).vertexSet := by
                rw [hleft, Bump.orientedSegment_source]
                exact Bump.left_mem_row
              simpa [I.rowPath_eq_linkage_path Bump.row] using hrow
            exact ⟨hirow, Or.inl
              ⟨PathPacking.BridgeBetween.of_orientedPath
                I.linkage.toPathPacking P hsrc_old htgt_old hclean_old⟩⟩
          · have htgt_old :
                P.target ∈
                  (I.linkage.path (I.rowIndex Bump.row)).vertexSet := by
              have hrow :
                  P.target ∈ (I.rowPath Bump.row).vertexSet := by
                rw [hright, Bump.orientedSegment_target]
                exact Bump.right_mem_row
              simpa [I.rowPath_eq_linkage_path Bump.row] using hrow
            exact ⟨hirow, Or.inl
              ⟨PathPacking.BridgeBetween.of_orientedPath
                I.linkage.toPathPacking P hsrc_old htgt_old hclean_old⟩⟩
        · let Tail : GraphPath G := Bump.orientedSegment.dropUntil hxseg
          have hglue : P.target = Tail.source := by
            simp [Tail, P]
          have hinter :
              ∀ ⦃v : V⦄, v ∈ P.vertexSet → v ∈ Tail.vertexSet →
                v = P.target := by
            intro v hvP hvtail
            have hvtail_seg :
                v ∈ Bump.orientedSegment.vertexSet :=
              Bump.orientedSegment.dropUntil_vertexSet_subset hxseg
                (by simpa [Tail] using hvtail)
            have hvrep :
                v ∈ Bump.replacementPath.path.vertexSet :=
              Bump.replacementPath.segment_subset_path hvtail_seg
            have hvnew :
                v ∈ Bump.replacementLinkageConcrete.toPathPacking.vertexSet :=
              (Bump.replacementLinkageConcrete.toPathPacking.mem_vertexSet).2
                ⟨I.rowIndex Bump.row, by
                  simpa [Bump.replacementLinkageConcrete_path_row] using hvrep⟩
            rcases β.orientedPath_internallyDisjoint
                (by simpa [P] using hvP) hvnew with hsrc | htgt
            · have hsrc_new :
                  P.source ∈
                    (Bump.replacementLinkageConcrete.path i).vertexSet :=
                PathPacking.BridgeBetween.orientedPath_source_mem_left β
              have hsrc_i :
                  P.source ∈ (I.linkage.path i).vertexSet := by
                simpa [P, Bump.replacementLinkageConcrete_path_of_ne hirow]
                  using hsrc_new
              exact False.elim <|
                Finset.disjoint_left.mp
                  (Bump.replacementPath_nodeDisjoint_unchanged hirow)
                  hvrep (by simpa [P, hsrc] using hsrc_i)
            · simpa [P] using htgt
          let Joined : GraphPath G :=
            P.appendWithEqOfInterSubsetTarget Tail hglue hinter
          have htail_clean :
              Tail.InternallyDisjointFromSet
                I.linkage.toPathPacking.vertexSet := by
            simpa [Tail] using
              Bump.orientedSegment.dropUntil_internallyDisjointFromSet
                hxseg Bump.orientedSegment_clean_linkage
          have hjoined_clean :
              Joined.InternallyDisjointFromSet
                I.linkage.toPathPacking.vertexSet := by
            simpa [Joined] using
              P.appendWithEqOfInterSubsetTarget_internallyDisjointFromSet
                Tail hglue hinter hclean_old htail_clean hxold
          have hjoined_src :
              Joined.source ∈ (I.linkage.path i).vertexSet := by
            simpa [Joined] using hsrc_old
          have hjoined_tgt :
              Joined.target ∈
                (I.linkage.path (I.rowIndex Bump.row)).vertexSet := by
            have htgt : Joined.target = Bump.right := by
              simp [Joined, Tail]
            have hrow :
                Joined.target ∈ (I.rowPath Bump.row).vertexSet := by
              simpa [htgt] using Bump.right_mem_row
            simpa [I.rowPath_eq_linkage_path Bump.row] using hrow
          exact ⟨hirow, Or.inl
            ⟨PathPacking.BridgeBetween.of_orientedPath
              I.linkage.toPathPacking Joined hjoined_src hjoined_tgt
              hjoined_clean⟩⟩
    · have htgt_old :
          P.target ∈
            (I.linkage.path (I.rowIndex Bump.row)).vertexSet := by
        have hrow :
            P.target ∈ (I.rowPath Bump.row).vertexSet :=
          (I.rowPath Bump.row).dropUntil_vertexSet_subset
            Bump.right_mem_row hsuf
        simpa [I.rowPath_eq_linkage_path Bump.row] using hrow
      exact ⟨hirow, Or.inl
        ⟨PathPacking.BridgeBetween.of_orientedPath
          I.linkage.toPathPacking P hsrc_old htgt_old hclean_old⟩⟩

/-- An old bridge from an unchanged linkage path to the bumped row survives
as a successor bridge from that unchanged path to the replacement row.

This is the formal version of the Figure 7 sentence that the old local
adjacencies into the bumped row persist after replacing the middle row segment:
if the old bridge first hits the inserted bump segment, truncate there; if it
misses the inserted segment and ends on a retained row piece, keep it; if it
ends in the deleted middle, append along the deleted middle to the next
replacement endpoint. -/
theorem new_aux_adj_to_replacement_of_old_bridge_to_bumped_row
    {i : I.linkage.Index}
    (hirow : i ≠ I.rowIndex Bump.row)
    (β : I.linkage.toPathPacking.BridgeBetween
      i (I.rowIndex Bump.row)) :
    (linkageAuxGraph Bump.replacementLinkageConcrete).Adj
      i (I.rowIndex Bump.row) := by
  classical
  by_cases hhit :
      (β.orientedPath.vertexSet ∩ Bump.insertedSegmentVertexSet).Nonempty
  · let P : GraphPath G := β.orientedPath
    let Prefix : GraphPath G :=
      P.cleanPrefixToSet Bump.insertedSegmentVertexSet hhit
    have hsrc_new :
        Prefix.source ∈
          (Bump.replacementLinkageConcrete.path i).vertexSet := by
      have hsrc_old : Prefix.source ∈ (I.linkage.path i).vertexSet := by
        simpa [Prefix, P] using
          PathPacking.BridgeBetween.orientedPath_source_mem_left β
      simpa [Bump.replacementLinkageConcrete_path_of_ne hirow]
        using hsrc_old
    have hprefix_old :
        Prefix.InternallyDisjointFromSet
          I.linkage.toPathPacking.vertexSet := by
      simpa [Prefix, P, GraphPath.cleanPrefixToSet] using
        P.takeUntil_internallyDisjointFromSet
          (P.firstHitVertex_mem_vertexSet Bump.insertedSegmentVertexSet hhit)
          β.orientedPath_internallyDisjoint
    have hprefix_new :
        Prefix.InternallyDisjointFromSet
          Bump.replacementLinkageConcrete.toPathPacking.vertexSet := by
      intro v hvPrefix hvnew
      by_cases hvold : v ∈ I.linkage.toPathPacking.vertexSet
      · exact hprefix_old hvPrefix hvold
      · have hvins := Bump.new_link_vertex_not_old_mem_insertedSegment
          hvnew hvold
        have hv_eq :
            v = P.firstHitVertex Bump.insertedSegmentVertexSet hhit :=
          P.eq_firstHitVertex_of_mem_takeUntil_of_mem_set
            Bump.insertedSegmentVertexSet hhit
            (by simpa [Prefix, GraphPath.cleanPrefixToSet] using hvPrefix)
            hvins
        exact Or.inr (by
          simpa [Prefix, GraphPath.cleanPrefixToSet] using hv_eq)
    have htgt_seg :
        Prefix.target ∈ Bump.orientedSegment.vertexSet := by
      have htgt :
          Prefix.target ∈ Bump.insertedSegmentVertexSet := by
        simpa [Prefix, P] using
          P.cleanPrefixToSet_target_mem Bump.insertedSegmentVertexSet hhit
      change Prefix.target ∈ Bump.orientedSegment.vertexSet at htgt
      exact htgt
    have htgt_new :
        Prefix.target ∈
          (Bump.replacementLinkageConcrete.path
            (I.rowIndex Bump.row)).vertexSet := by
      have hrep : Prefix.target ∈ Bump.replacementPath.path.vertexSet :=
        Bump.replacementPath.segment_subset_path htgt_seg
      simpa [Bump.replacementLinkageConcrete_path_row] using hrep
    exact ⟨hirow, Or.inl
      ⟨PathPacking.BridgeBetween.of_orientedPath
        Bump.replacementLinkageConcrete.toPathPacking Prefix
        hsrc_new htgt_new hprefix_new⟩⟩
  · have hmiss :
        Disjoint β.orientedPath.vertexSet Bump.insertedSegmentVertexSet := by
      rw [Finset.disjoint_left]
      intro v hvP hvIns
      exact hhit ⟨v, Finset.mem_inter.2 ⟨hvP, hvIns⟩⟩
    let P : GraphPath G := β.orientedPath
    have hsrc_new :
        P.source ∈
          (Bump.replacementLinkageConcrete.path i).vertexSet := by
      have hsrc_old :=
        PathPacking.BridgeBetween.orientedPath_source_mem_left β
      simpa [P, Bump.replacementLinkageConcrete_path_of_ne hirow]
        using hsrc_old
    have hclean_new :
        P.InternallyDisjointFromSet
          Bump.replacementLinkageConcrete.toPathPacking.vertexSet :=
      Bump.internallyDisjoint_new_of_old_clean_disjoint_inserted
        P β.orientedPath_internallyDisjoint hmiss
    have htgt_old :
        P.target ∈
          (I.linkage.path (I.rowIndex Bump.row)).vertexSet := by
      simpa [P] using
        PathPacking.BridgeBetween.orientedPath_target_mem_right β
    have htgt_row :
        P.target ∈ (I.rowPath Bump.row).vertexSet := by
      simpa [I.rowPath_eq_linkage_path Bump.row] using htgt_old
    rcases Bump.row_vertex_mem_prefix_or_deleted_or_suffix htgt_row with
      hpre | hdel | hsuf
    · have htgt_new :
          P.target ∈
            (Bump.replacementLinkageConcrete.path
              (I.rowIndex Bump.row)).vertexSet := by
        have hrep : P.target ∈ Bump.replacementPath.path.vertexSet :=
          Bump.replacementPath.prefix_subset_path hpre
        simpa [P, Bump.replacementLinkageConcrete_path_row] using hrep
      exact ⟨hirow, Or.inl
        ⟨PathPacking.BridgeBetween.of_orientedPath
          Bump.replacementLinkageConcrete.toPathPacking P
          hsrc_new htgt_new hclean_new⟩⟩
    · by_cases hleft : P.target = Bump.left
      · have htgt_new :
            P.target ∈
              (Bump.replacementLinkageConcrete.path
                (I.rowIndex Bump.row)).vertexSet := by
          have hrep : P.target ∈ Bump.replacementPath.path.vertexSet := by
            rw [hleft]
            exact Bump.replacementPath.prefix_subset_path
              (GraphPath.target_mem_vertexSet
                ((I.rowPath Bump.row).takeUntil Bump.left_mem_row))
          simpa [P, Bump.replacementLinkageConcrete_path_row] using hrep
        exact ⟨hirow, Or.inl
          ⟨PathPacking.BridgeBetween.of_orientedPath
            Bump.replacementLinkageConcrete.toPathPacking P
            hsrc_new htgt_new hclean_new⟩⟩
      · by_cases hright : P.target = Bump.right
        · have htgt_new :
              P.target ∈
                (Bump.replacementLinkageConcrete.path
                  (I.rowIndex Bump.row)).vertexSet := by
            have hrep : P.target ∈ Bump.replacementPath.path.vertexSet := by
              rw [hright]
              exact Bump.replacementPath.suffix_subset_path
                (GraphPath.source_mem_vertexSet
                  ((I.rowPath Bump.row).dropUntil Bump.right_mem_row))
            simpa [P, Bump.replacementLinkageConcrete_path_row] using hrep
          exact ⟨hirow, Or.inl
            ⟨PathPacking.BridgeBetween.of_orientedPath
              Bump.replacementLinkageConcrete.toPathPacking P
              hsrc_new htgt_new hclean_new⟩⟩
        · let Tail : GraphPath G := Bump.deletedRowSegment.dropUntil hdel
          have hglue : P.target = Tail.source := by
            simp [Tail, P]
          have hinter :
              ∀ ⦃v : V⦄, v ∈ P.vertexSet → v ∈ Tail.vertexSet →
                v = P.target := by
            intro v hvP hvTail
            have hvdel :
                v ∈ Bump.deletedRowSegment.vertexSet :=
              Bump.deletedRowSegment.dropUntil_vertexSet_subset hdel
                (by simpa [Tail] using hvTail)
            have hvrow :
                v ∈ (I.rowPath Bump.row).vertexSet :=
              (I.rowPath Bump.row).segmentOfBefore_vertexSet_subset
                Bump.left_before_right hvdel
            have hvold :
                v ∈ I.linkage.toPathPacking.vertexSet :=
              (I.linkage.toPathPacking.mem_vertexSet).2
                ⟨I.rowIndex Bump.row, by
                  simpa [I.rowPath_eq_linkage_path Bump.row] using hvrow⟩
            rcases β.orientedPath_internallyDisjoint
                (by simpa [P] using hvP) hvold with hsrc | htgt
            · have hsrc_old :
                  P.source ∈ (I.linkage.path i).vertexSet := by
                simpa [P] using
                  PathPacking.BridgeBetween.orientedPath_source_mem_left β
              have hv_i : v ∈ (I.linkage.path i).vertexSet := by
                simpa [P, hsrc] using hsrc_old
              have hv_row :
                  v ∈
                    (I.linkage.path (I.rowIndex Bump.row)).vertexSet := by
                simpa [I.rowPath_eq_linkage_path Bump.row] using hvrow
              exact False.elim <|
                Finset.disjoint_left.mp
                  (I.linkage.toPathPacking.node_disjoint hirow)
                  hv_i hv_row
            · simpa [P] using htgt
          have htail_clean :
              Tail.InternallyDisjointFromSet
                Bump.replacementLinkageConcrete.toPathPacking.vertexSet := by
            simpa [Tail] using
              Bump.deletedRowSegment.dropUntil_internallyDisjointFromSet
                hdel Bump.deletedRowSegment_clean_replacementLinkageConcrete
          have hglue_not_new :
              P.target ∉
                Bump.replacementLinkageConcrete.toPathPacking.vertexSet := by
            intro hnew
            rcases Bump.deletedRowSegment_clean_replacementLinkageConcrete
                hdel hnew with hL | hR
            · exact hleft (by simpa [P, Bump.deletedRowSegment_source] using hL)
            · exact hright (by simpa [P, Bump.deletedRowSegment_target] using hR)
          let Joined : GraphPath G :=
            P.appendWithEqOfInterSubsetTarget Tail hglue hinter
          have hjoined_clean :
              Joined.InternallyDisjointFromSet
                Bump.replacementLinkageConcrete.toPathPacking.vertexSet := by
            simpa [Joined] using
              P.appendWithEqOfInterSubsetTarget_internallyDisjointFromSet
                Tail hglue hinter hclean_new htail_clean hglue_not_new
          have hjoined_src :
              Joined.source ∈
                (Bump.replacementLinkageConcrete.path i).vertexSet := by
            simpa [Joined] using hsrc_new
          have hjoined_tgt :
              Joined.target ∈
                (Bump.replacementLinkageConcrete.path
                  (I.rowIndex Bump.row)).vertexSet := by
            have htgt : Joined.target = Bump.right := by
              simp [Joined, Tail]
            have hrep : Joined.target ∈ Bump.replacementPath.path.vertexSet := by
              rw [htgt]
              exact Bump.replacementPath.suffix_subset_path
                (GraphPath.source_mem_vertexSet
                  ((I.rowPath Bump.row).dropUntil Bump.right_mem_row))
            simpa [Bump.replacementLinkageConcrete_path_row] using hrep
          exact ⟨hirow, Or.inl
            ⟨PathPacking.BridgeBetween.of_orientedPath
              Bump.replacementLinkageConcrete.toPathPacking Joined
              hjoined_src hjoined_tgt hjoined_clean⟩⟩
    · have htgt_new :
          P.target ∈
            (Bump.replacementLinkageConcrete.path
              (I.rowIndex Bump.row)).vertexSet := by
        have hrep : P.target ∈ Bump.replacementPath.path.vertexSet :=
          Bump.replacementPath.suffix_subset_path hsuf
        simpa [P, Bump.replacementLinkageConcrete_path_row] using hrep
      exact ⟨hirow, Or.inl
        ⟨PathPacking.BridgeBetween.of_orientedPath
          Bump.replacementLinkageConcrete.toPathPacking P
          hsrc_new htgt_new hclean_new⟩⟩

/-- The old left-to-bumped-row auxiliary adjacency survives as a left-to-
replacement-row adjacency after the bump. -/
theorem replacementLinkageConcrete_adj_to_replacement_of_old_adj
    {i : I.linkage.Index}
    (hirow : i ≠ I.rowIndex Bump.row)
    (hadj :
      (linkageAuxGraph I.linkage).Adj i (I.rowIndex Bump.row)) :
    (linkageAuxGraph Bump.replacementLinkageConcrete).Adj
      i (I.rowIndex Bump.row) := by
  classical
  rcases hadj with ⟨_hne, hbridge⟩
  rcases hbridge with hβ | hβ
  · rcases hβ with ⟨β⟩
    exact Bump.new_aux_adj_to_replacement_of_old_bridge_to_bumped_row
      hirow β
  · rcases hβ with ⟨β⟩
    exact Bump.new_aux_adj_to_replacement_of_old_bridge_to_bumped_row
      hirow (reverseBridge β)

/-- The old bumped-row-to-right auxiliary adjacency survives after the bump. -/
theorem replacementLinkageConcrete_adj_from_replacement_of_old_adj
    {i : I.linkage.Index}
    (hirow : I.rowIndex Bump.row ≠ i)
    (hadj :
      (linkageAuxGraph I.linkage).Adj (I.rowIndex Bump.row) i) :
    (linkageAuxGraph Bump.replacementLinkageConcrete).Adj
      (I.rowIndex Bump.row) i := by
  have hnew :
      (linkageAuxGraph Bump.replacementLinkageConcrete).Adj
        i (I.rowIndex Bump.row) :=
    Bump.replacementLinkageConcrete_adj_to_replacement_of_old_adj
      (fun h => hirow h.symm) ((linkageAuxGraph I.linkage).symm hadj)
  exact (linkageAuxGraph Bump.replacementLinkageConcrete).symm hnew

/-- If an old bridge between unchanged rows does not survive after a bump,
then the first endpoint is in the local triple. -/
theorem mem_local_triple_of_old_bridge_not_new_unchanged
    {i j auxA auxC : I.linkage.Index} (hij : i ≠ j)
    (hirow : i ≠ I.rowIndex Bump.row)
    (hjrow : j ≠ I.rowIndex Bump.row)
    (β : I.linkage.toPathPacking.BridgeBetween i j)
    (hnotnew : ¬ (linkageAuxGraph Bump.replacementLinkageConcrete).Adj i j)
    (hAM_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Bump.row))
    (hMC_old :
      (linkageAuxGraph I.linkage).Adj (I.rowIndex Bump.row) auxC)
    (hM_old :
      DegreeEquals (linkageAuxGraph I.linkage) (I.rowIndex Bump.row) 2)
    (hA_ne_C : auxA ≠ auxC) :
    i ∈ ({auxA, I.rowIndex Bump.row, auxC} :
        Finset I.linkage.Index) := by
  classical
  by_cases hhit :
      (β.orientedPath.vertexSet ∩ Bump.insertedSegmentVertexSet).Nonempty
  · exact Bump.mem_local_triple_of_old_adj_to_bumped_row
      hAM_old hMC_old hM_old hA_ne_C
      (Bump.old_aux_adj_to_bumped_row_of_old_bridge_hits_inserted
        hirow β hhit)
  · have hmiss :
        Disjoint β.orientedPath.vertexSet Bump.insertedSegmentVertexSet := by
      rw [Finset.disjoint_left]
      intro v hvP hvIns
      exact hhit ⟨v, Finset.mem_inter.2 ⟨hvP, hvIns⟩⟩
    have hnew :
        (linkageAuxGraph Bump.replacementLinkageConcrete).Adj i j :=
      Bump.new_aux_adj_of_old_bridge_unchanged_miss_inserted
        hij hirow hjrow β hmiss
    exact False.elim (hnotnew hnew)

/-- If a successor bridge between unchanged rows was not an old edge, then
the first endpoint is in the local triple. -/
theorem mem_local_triple_of_new_bridge_not_old_unchanged
    {i j auxA auxC : I.linkage.Index} (hij : i ≠ j)
    (hirow : i ≠ I.rowIndex Bump.row)
    (hjrow : j ≠ I.rowIndex Bump.row)
    (β :
      Bump.replacementLinkageConcrete.toPathPacking.BridgeBetween i j)
    (hnotold : ¬ (linkageAuxGraph I.linkage).Adj i j)
    (hAM_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Bump.row))
    (hMC_old :
      (linkageAuxGraph I.linkage).Adj (I.rowIndex Bump.row) auxC)
    (hM_old :
      DegreeEquals (linkageAuxGraph I.linkage) (I.rowIndex Bump.row) 2)
    (hA_ne_C : auxA ≠ auxC) :
    i ∈ ({auxA, I.rowIndex Bump.row, auxC} :
        Finset I.linkage.Index) := by
  classical
  by_cases hhit :
      (β.orientedPath.vertexSet ∩ Bump.deletedMiddleVertexSet).Nonempty
  · exact Bump.mem_local_triple_of_old_adj_to_bumped_row
      hAM_old hMC_old hM_old hA_ne_C
      (Bump.old_aux_adj_to_bumped_row_of_new_bridge_hits_deleted
        hirow β hhit)
  · have hmiss :
        Disjoint β.orientedPath.vertexSet Bump.deletedMiddleVertexSet := by
      rw [Finset.disjoint_left]
      intro v hvP hvDel
      exact hhit ⟨v, Finset.mem_inter.2 ⟨hvP, hvDel⟩⟩
    have hold :
        (linkageAuxGraph I.linkage).Adj i j :=
      Bump.old_aux_adj_of_new_bridge_unchanged_miss_deleted
        hij hirow hjrow β hmiss
    exact False.elim (hnotold hold)

/-- Endpoint-localizing form for an old auxiliary edge that disappears after
a bump. -/
theorem mem_local_triple_of_old_adj_not_new_at_left_endpoint
    {i j auxA auxC : I.linkage.Index}
    (hirow : i ≠ I.rowIndex Bump.row)
    (hold : (linkageAuxGraph I.linkage).Adj i j)
    (hnotnew : ¬ (linkageAuxGraph Bump.replacementLinkageConcrete).Adj i j)
    (hAM_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Bump.row))
    (hMC_old :
      (linkageAuxGraph I.linkage).Adj (I.rowIndex Bump.row) auxC)
    (hM_old :
      DegreeEquals (linkageAuxGraph I.linkage) (I.rowIndex Bump.row) 2)
    (hA_ne_C : auxA ≠ auxC) :
    i ∈ ({auxA, I.rowIndex Bump.row, auxC} :
        Finset I.linkage.Index) := by
  classical
  by_cases hjrow_eq : j = I.rowIndex Bump.row
  · exact Bump.mem_local_triple_of_old_adj_to_bumped_row
      hAM_old hMC_old hM_old hA_ne_C (by simpa [hjrow_eq] using hold)
  · rcases hold with ⟨hij, hbridge⟩
    rcases hbridge with hβ | hβ
    · rcases hβ with ⟨β⟩
      exact Bump.mem_local_triple_of_old_bridge_not_new_unchanged
        hij hirow hjrow_eq β hnotnew hAM_old hMC_old hM_old hA_ne_C
    · rcases hβ with ⟨β⟩
      exact Bump.mem_local_triple_of_old_bridge_not_new_unchanged
        hij hirow hjrow_eq (reverseBridge β) hnotnew
        hAM_old hMC_old hM_old hA_ne_C

/-- Symmetric endpoint-localizing form for an old edge that disappears. -/
theorem mem_local_triple_of_old_adj_not_new_at_right_endpoint
    {i j auxA auxC : I.linkage.Index}
    (hjrow : j ≠ I.rowIndex Bump.row)
    (hold : (linkageAuxGraph I.linkage).Adj i j)
    (hnotnew : ¬ (linkageAuxGraph Bump.replacementLinkageConcrete).Adj i j)
    (hAM_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Bump.row))
    (hMC_old :
      (linkageAuxGraph I.linkage).Adj (I.rowIndex Bump.row) auxC)
    (hM_old :
      DegreeEquals (linkageAuxGraph I.linkage) (I.rowIndex Bump.row) 2)
    (hA_ne_C : auxA ≠ auxC) :
    j ∈ ({auxA, I.rowIndex Bump.row, auxC} :
        Finset I.linkage.Index) := by
  exact Bump.mem_local_triple_of_old_adj_not_new_at_left_endpoint
    hjrow ((linkageAuxGraph I.linkage).symm hold)
    (fun hnew => hnotnew ((linkageAuxGraph Bump.replacementLinkageConcrete).symm hnew))
    hAM_old hMC_old hM_old hA_ne_C

/-- Endpoint-localizing form for a successor auxiliary edge that was not an
old edge. -/
theorem mem_local_triple_of_new_adj_not_old_at_left_endpoint
    {i j auxA auxC : I.linkage.Index}
    (hirow : i ≠ I.rowIndex Bump.row)
    (hnew : (linkageAuxGraph Bump.replacementLinkageConcrete).Adj i j)
    (hnotold : ¬ (linkageAuxGraph I.linkage).Adj i j)
    (hAM_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Bump.row))
    (hMC_old :
      (linkageAuxGraph I.linkage).Adj (I.rowIndex Bump.row) auxC)
    (hM_old :
      DegreeEquals (linkageAuxGraph I.linkage) (I.rowIndex Bump.row) 2)
    (hA_ne_C : auxA ≠ auxC) :
    i ∈ ({auxA, I.rowIndex Bump.row, auxC} :
        Finset I.linkage.Index) := by
  classical
  by_cases hjrow_eq : j = I.rowIndex Bump.row
  · rcases hnew with ⟨_hij, hbridge⟩
    have hadj_row :
        (linkageAuxGraph I.linkage).Adj i (I.rowIndex Bump.row) := by
      rcases hbridge with hβ | hβ
      · rcases hβ with ⟨β⟩
        exact Bump.old_aux_adj_to_bumped_row_of_new_bridge_to_replacement
          hirow (by simpa [hjrow_eq] using β)
      · rcases hβ with ⟨β⟩
        exact Bump.old_aux_adj_to_bumped_row_of_new_bridge_to_replacement
          hirow (by simpa [hjrow_eq] using (reverseBridge β))
    exact Bump.mem_local_triple_of_old_adj_to_bumped_row
      hAM_old hMC_old hM_old hA_ne_C hadj_row
  · rcases hnew with ⟨hij, hbridge⟩
    rcases hbridge with hβ | hβ
    · rcases hβ with ⟨β⟩
      exact Bump.mem_local_triple_of_new_bridge_not_old_unchanged
        hij hirow hjrow_eq β hnotold hAM_old hMC_old hM_old hA_ne_C
    · rcases hβ with ⟨β⟩
      exact Bump.mem_local_triple_of_new_bridge_not_old_unchanged
        hij hirow hjrow_eq (reverseBridge β) hnotold
        hAM_old hMC_old hM_old hA_ne_C

/-- Symmetric endpoint-localizing form for a successor edge that was not old. -/
theorem mem_local_triple_of_new_adj_not_old_at_right_endpoint
    {i j auxA auxC : I.linkage.Index}
    (hjrow : j ≠ I.rowIndex Bump.row)
    (hnew : (linkageAuxGraph Bump.replacementLinkageConcrete).Adj i j)
    (hnotold : ¬ (linkageAuxGraph I.linkage).Adj i j)
    (hAM_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Bump.row))
    (hMC_old :
      (linkageAuxGraph I.linkage).Adj (I.rowIndex Bump.row) auxC)
    (hM_old :
      DegreeEquals (linkageAuxGraph I.linkage) (I.rowIndex Bump.row) 2)
    (hA_ne_C : auxA ≠ auxC) :
    j ∈ ({auxA, I.rowIndex Bump.row, auxC} :
        Finset I.linkage.Index) := by
  exact Bump.mem_local_triple_of_new_adj_not_old_at_left_endpoint
    hjrow ((linkageAuxGraph Bump.replacementLinkageConcrete).symm hnew)
    (fun hold => hnotold ((linkageAuxGraph I.linkage).symm hold))
    hAM_old hMC_old hM_old hA_ne_C

/-- If the local bump analysis proves that the auxiliary adjacency relation is
unchanged on the shared index type, then the replacement linkage satisfies the
iteration's auxiliary-isomorphism invariant. -/
theorem replacementLinkage_auxGraphsIsomorphic_of_adj_iff
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (hadj :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph (Bump.replacementLinkage hdisj)).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j) :
    AuxGraphsIsomorphic I.linkage (Bump.replacementLinkage hdisj) := by
  refine auxGraphsIsomorphic_of_equiv_adj (Equiv.refl I.linkage.Index) ?_
  intro i j
  exact (hadj i j).symm

/-- Row family obtained from a bump by replacing the bumped row and keeping
all other current rows unchanged. -/
noncomputable def successorRowPath (r : I.Row) : GraphPath G :=
  if r = Bump.row then Bump.replacementPath.path else I.rowPath r

@[simp] theorem successorRowPath_row :
    Bump.successorRowPath Bump.row = Bump.replacementPath.path := by
  simp [successorRowPath]

@[simp] theorem successorRowPath_of_ne {r : I.Row} (hr : r ≠ Bump.row) :
    Bump.successorRowPath r = I.rowPath r := by
  simp [successorRowPath, hr]

/-- Bump successor row-contact invariant from the single real contact
survival obligation.

All rows except the bumped row are unchanged, so the old maintained
`Q₀`-contact invariant supplies them.  The only new mathematical content is
that every fixed `Q₀` path still hits the replacement row `X`; this is the
no-skip argument in the paper. -/
theorem successorCurrentRowsInvariant_of_replacement_hits
    (hreplace :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar Bump.replacementPath.path) :
    TypeOneCurrentRowsInvariant R hpos Q0 I.Row
      Bump.successorRowPath := by
  classical
  intro i hi
  rcases I.q0_intersection_invariant i hi with
    ⟨hrows, hp0, hpz, havoid⟩
  refine ⟨?_, hp0, hpz, havoid⟩
  intro r
  by_cases hr : r = Bump.row
  · subst r
    simpa using hreplace i hi
  · simpa [Bump.successorRowPath_of_ne hr] using hrows r

/-- Bump successor row-contact traces from the same single replacement-hit
obligation.  This is the trace-level form of
`successorCurrentRowsInvariant_of_replacement_hits`. -/
theorem successorBareExtendedRowContactTraces_of_replacement_hits
    (order : I.Row ≃ Fin (z h))
    (hreplace :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar Bump.replacementPath.path) :
    ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
      Nonempty
        (TypeOneBareExtendedRowContactTrace
          (h := h) I.Row order Bump.successorRowPath
          (Q0.data i hi).qstar) :=
  TypeOneBareExtendedRowContactTrace.nonempty_of_currentRowsInvariant
    (order := order)
    (Bump.successorCurrentRowsInvariant_of_replacement_hits hreplace)

/-- The bump successor keeps the same linkage index names. -/
def successorRowIndex
    (_hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (r : I.Row) : (Bump.replacementLinkage _hdisj).Index :=
  I.rowIndex r

theorem successorRowPath_eq_linkage_path
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (hinj : I.RowIndexInjective) (r : I.Row) :
    Bump.successorRowPath r =
      (Bump.replacementLinkage hdisj).path
        (Bump.successorRowIndex hdisj r) := by
  by_cases hr : r = Bump.row
  · subst hr
    simp [successorRowIndex]
  · rw [Bump.successorRowPath_of_ne hr]
    rw [I.rowPath_eq_linkage_path r]
    exact (Bump.replacementLinkage_path_of_ne hdisj
      (fun hidx => hr (hinj hidx))).symm

/-- Concrete successor `IterationInput` for a bump nonterminating branch. -/
noncomputable def successorInput
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (hinj : I.RowIndexInjective)
    (haux : AuxGraphsIsomorphic L (Bump.replacementLinkage hdisj))
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Bump.successorRowPath) :
    IterationInput R hpos Q0 where
  Row := I.Row
  rowFintype := inferInstance
  rowDecidableEq := inferInstance
  rowPath := Bump.successorRowPath
  linkage := Bump.replacementLinkage hdisj
  rowIndex := Bump.successorRowIndex hdisj
  rowPath_eq_linkage_path :=
    Bump.successorRowPath_eq_linkage_path hdisj hinj
  linkage_is_block_replacement := I.linkage_is_block_replacement
  aux_iso_fixed_outside := haux
  q0_intersection_invariant := hq0

/-- The concrete bump successor preserves row-index injectivity. -/
theorem successorInput_rowIndexInjective
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (hinj : I.RowIndexInjective)
    (haux : AuxGraphsIsomorphic L (Bump.replacementLinkage hdisj))
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Bump.successorRowPath) :
    (Bump.successorInput hdisj hinj haux hq0).RowIndexInjective := by
  intro r s hrs
  exact hinj hrs

/-- The concrete bump successor keeps the same displayed row order. -/
noncomputable def successorInput_orderedRows
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (hinj : I.RowIndexInjective)
    (haux : AuxGraphsIsomorphic L (Bump.replacementLinkage hdisj))
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Bump.successorRowPath)
    (O : I.OrderedRows) :
    (Bump.successorInput hdisj hinj haux hq0).OrderedRows where
  order := O.order

/-- The concrete bump successor preserves the explicit iteration invariant
package. -/
noncomputable def successorInput_iterationInvariants
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (haux : AuxGraphsIsomorphic L (Bump.replacementLinkage hdisj))
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Bump.successorRowPath)
    (Inv : TypeOneIterationInvariants I) :
    TypeOneIterationInvariants
      (Bump.successorInput hdisj Inv.rowIndexInjective haux hq0) where
  orderedRows :=
    Bump.successorInput_orderedRows hdisj Inv.rowIndexInjective haux hq0
      Inv.orderedRows
  rowIndexInjective :=
    Bump.successorInput_rowIndexInjective hdisj Inv.rowIndexInjective haux
      hq0
  rowsNodeDisjoint :=
    IterationInput.rowsNodeDisjoint_of_rowIndexInjective
      (Bump.successorInput hdisj Inv.rowIndexInjective haux hq0)
      (Bump.successorInput_rowIndexInjective hdisj Inv.rowIndexInjective
        haux hq0)

/-- The concrete bump successor preserves the active auxiliary two-path
invariant when the nonterminating local analysis proves that the auxiliary
adjacency relation is unchanged on the shared index type. -/
noncomputable def successorInput_activeAuxiliaryInvariant
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (haux : AuxGraphsIsomorphic L (Bump.replacementLinkage hdisj))
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Bump.successorRowPath)
    (Inv : TypeOneIterationInvariants I)
    (Haux : TypeOneActiveAuxiliaryInvariant I Inv)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph (Bump.replacementLinkage hdisj)).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j) :
    TypeOneActiveAuxiliaryInvariant
      (Bump.successorInput hdisj Inv.rowIndexInjective haux hq0)
      (Bump.successorInput_iterationInvariants hdisj haux hq0 Inv) where
  degree_two := by
    intro r
    have hiff :
        ∀ x y : I.linkage.Index,
          (linkageAuxGraph I.linkage).Adj x y ↔
            (linkageAuxGraph (Bump.replacementLinkage hdisj)).Adj x y := by
      intro x y
      exact (hadj_iff x y).symm
    simpa [successorInput, successorRowIndex] using
      (degreeEquals_equiv_iff (Equiv.refl I.linkage.Index) hiff).1
        (Haux.degree_two r)
  consecutive_adj := by
    intro r s hcon
    exact (hadj_iff (I.rowIndex r) (I.rowIndex s)).2
      (Haux.consecutive_adj hcon)
  no_chord := by
    intro r s hnew
    exact Haux.no_chord ((hadj_iff (I.rowIndex r) (I.rowIndex s)).1 hnew)

/-- The concrete bump successor preserves the two boundary rows when the
nonterminating branch leaves the auxiliary adjacency relation unchanged. -/
noncomputable def successorInput_boundaryAuxiliaryInvariant
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (haux : AuxGraphsIsomorphic L (Bump.replacementLinkage hdisj))
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Bump.successorRowPath)
    (Inv : TypeOneExtendedFullIterationInvariants I)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph (Bump.replacementLinkage hdisj)).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j) :
    TypeOneBoundaryAuxiliaryInvariant
      (Bump.successorInput hdisj Inv.full.base.rowIndexInjective haux hq0)
      (Bump.successorInput_iterationInvariants hdisj haux hq0
        Inv.full.base) where
  lowerBoundary := Inv.boundary.lowerBoundary
  upperBoundary := Inv.boundary.upperBoundary
  lower_path_eq := by
    change (Bump.replacementLinkage hdisj).path Inv.boundary.lowerBoundary =
      L.path R.p0Index
    rw [Bump.replacementLinkage_path_of_ne hdisj
      (Inv.boundary.lower_ne_row Bump.row)]
    exact Inv.boundary.lower_path_eq
  upper_path_eq := by
    change (Bump.replacementLinkage hdisj).path Inv.boundary.upperBoundary =
      L.path (R.pZPlusOneIndex hpos)
    rw [Bump.replacementLinkage_path_of_ne hdisj
      (Inv.boundary.upper_ne_row Bump.row)]
    exact Inv.boundary.upper_path_eq
  lower_ne_row := by
    intro r
    exact Inv.boundary.lower_ne_row r
  upper_ne_row := by
    intro r
    exact Inv.boundary.upper_ne_row r
  lower_degree_two := by
    have hiff :
        ∀ x y : I.linkage.Index,
          (linkageAuxGraph I.linkage).Adj x y ↔
            (linkageAuxGraph (Bump.replacementLinkage hdisj)).Adj x y := by
      intro x y
      exact (hadj_iff x y).symm
    simpa [successorInput, successorRowIndex] using
      (degreeEquals_equiv_iff (Equiv.refl I.linkage.Index) hiff).1
        Inv.boundary.lower_degree_two
  upper_degree_two := by
    have hiff :
        ∀ x y : I.linkage.Index,
          (linkageAuxGraph I.linkage).Adj x y ↔
            (linkageAuxGraph (Bump.replacementLinkage hdisj)).Adj x y := by
      intro x y
      exact (hadj_iff x y).symm
    simpa [successorInput, successorRowIndex] using
      (degreeEquals_equiv_iff (Equiv.refl I.linkage.Index) hiff).1
        Inv.boundary.upper_degree_two
  lower_adj_first := by
    exact (hadj_iff Inv.boundary.lowerBoundary
      (I.rowIndex
        ((Bump.successorInput_iterationInvariants hdisj haux hq0
          Inv.full.base).orderedRows.order.symm
            (⟨0, by dsimp [z]; omega⟩ : Fin (z h))))).2
      Inv.boundary.lower_adj_first
  last_adj_upper := by
    exact (hadj_iff
      (I.rowIndex
        ((Bump.successorInput_iterationInvariants hdisj haux hq0
          Inv.full.base).orderedRows.order.symm
            (⟨z h - 1, by dsimp [z]; omega⟩ : Fin (z h))))
      Inv.boundary.upperBoundary).2
      Inv.boundary.last_adj_upper
  lowerOutside := Inv.boundary.lowerOutside
  upperOutside := Inv.boundary.upperOutside
  lower_adj_outside := by
    exact (hadj_iff Inv.boundary.lowerBoundary
      Inv.boundary.lowerOutside).2 Inv.boundary.lower_adj_outside
  upper_adj_outside := by
    exact (hadj_iff Inv.boundary.upperBoundary
      Inv.boundary.upperOutside).2 Inv.boundary.upper_adj_outside
  lowerOutside_ne_row := by
    intro r
    exact Inv.boundary.lowerOutside_ne_row r
  upperOutside_ne_row := by
    intro r
    exact Inv.boundary.upperOutside_ne_row r
  lowerOutside_ne_lower := Inv.boundary.lowerOutside_ne_lower
  lowerOutside_ne_upper := Inv.boundary.lowerOutside_ne_upper
  upperOutside_ne_lower := Inv.boundary.upperOutside_ne_lower
  upperOutside_ne_upper := Inv.boundary.upperOutside_ne_upper

/-- The concrete bump successor does not add edges to the maintained graph
`H̃`: the new row uses only old row edges or fixed `Q0` edges. -/
theorem successorInput_tilde_subset
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (hinj : I.RowIndexInjective)
    (haux : AuxGraphsIsomorphic L (Bump.replacementLinkage hdisj))
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Bump.successorRowPath) :
    (Bump.successorInput hdisj hinj haux hq0).tildeEdgeSet ⊆
      I.tildeEdgeSet := by
  classical
  intro e he
  rcases Finset.mem_union.1 (by
      simpa [successorInput, IterationInput.tildeEdgeSet] using he)
    with hrow | hQ0
  · have hrow' :
        e ∈ Finset.univ.biUnion
          (fun r : I.Row => (Bump.successorRowPath r).edgeSet) := by
      simpa [IterationInput.rowEdgeSet, successorInput] using hrow
    rcases Finset.mem_biUnion.mp hrow' with ⟨r, _hr, her⟩
    by_cases hr : r = Bump.row
    · subst r
      have hraw := Bump.replacementPath_edgeSet_subset_row_union_Q0
        (by simpa using her)
      rcases Finset.mem_union.1 hraw with herow | hq
      · have heRows : e ∈ I.rowEdgeSet :=
          Finset.mem_biUnion.mpr ⟨Bump.row, Finset.mem_univ _, herow⟩
        exact Finset.mem_union.2 (Or.inl heRows)
      · exact Finset.mem_union.2 (Or.inr hq)
    · have herOld : e ∈ (I.rowPath r).edgeSet := by
        simpa [Bump.successorRowPath_of_ne hr] using her
      have heRows : e ∈ I.rowEdgeSet :=
        Finset.mem_biUnion.mpr ⟨r, Finset.mem_univ _, herOld⟩
      exact Finset.mem_union.2 (Or.inl heRows)
  · exact Finset.mem_union.2 (Or.inr hQ0)

/-- The explicit linkage-support invariant survives a bump successor: the
replacement linkage only changes the bumped active row, and that replacement
row is part of the successor row family. -/
theorem successorInput_typeOneLinkageSupportInvariant
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (hinj : I.RowIndexInjective)
    (haux : AuxGraphsIsomorphic L (Bump.replacementLinkage hdisj))
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Bump.successorRowPath)
    (hsupport : IterationInput.TypeOneLinkageSupportInvariant I) :
    IterationInput.TypeOneLinkageSupportInvariant
      (Bump.successorInput hdisj hinj haux hq0) := by
  classical
  intro v hv
  rcases ((Bump.successorInput hdisj hinj haux hq0).linkage.toPathPacking.mem_vertexSet).1
      hv with ⟨i, hvi⟩
  by_cases hi : i = I.rowIndex Bump.row
  · subst i
    exact Finset.mem_union.2 (Or.inl (by
      rw [IterationInput.rowVertexSet]
      exact Finset.mem_biUnion.mpr ⟨Bump.row, Finset.mem_univ Bump.row, by
        simpa [successorInput] using hvi⟩))
  · have hv_old_path : v ∈ (I.linkage.path i).vertexSet := by
      change v ∈ ((Bump.replacementLinkage hdisj).path i).vertexSet at hvi
      rwa [Bump.replacementLinkage_path_of_ne hdisj hi] at hvi
    have hv_old_link : v ∈ I.linkage.toPathPacking.vertexSet :=
      (I.linkage.toPathPacking.mem_vertexSet).2 ⟨i, hv_old_path⟩
    have hraw := hsupport hv_old_link
    rcases Finset.mem_union.1 hraw with hrow | hrest
    · rw [IterationInput.rowVertexSet] at hrow
      rcases Finset.mem_biUnion.1 hrow with ⟨r, _hr, hvr⟩
      have hr_ne : r ≠ Bump.row := by
        intro hr
        subst r
        have hidx : i ≠ I.rowIndex Bump.row := hi
        have hv_bump :
            v ∈ (I.linkage.path (I.rowIndex Bump.row)).vertexSet := by
          simpa [I.rowPath_eq_linkage_path Bump.row] using hvr
        exact Finset.disjoint_left.mp
          (I.linkage.toPathPacking.node_disjoint hidx) hv_old_path hv_bump
      exact Finset.mem_union.2 (Or.inl (by
        rw [IterationInput.rowVertexSet]
        exact Finset.mem_biUnion.mpr ⟨r, Finset.mem_univ r, by
          simpa [successorInput, Bump.successorRowPath_of_ne hr_ne] using hvr⟩))
    · exact Finset.mem_union.2 (Or.inr hrest)

/-- A deleted-middle edge outside `Q₀` is absent from every successor row. -/
theorem deletedRowSegment_edge_not_mem_successorRowEdgeSet_of_not_mem_Q0
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (hinj : I.RowIndexInjective)
    (haux : AuxGraphsIsomorphic L (Bump.replacementLinkage hdisj))
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Bump.successorRowPath)
    {e : Sym2 V} (he : e ∈ Bump.deletedRowSegment.edgeSet)
    (hQ0 : e ∉ Q0.edgeSet) :
    e ∉ (Bump.successorInput hdisj hinj haux hq0).rowEdgeSet := by
  classical
  intro hrow
  rw [IterationInput.rowEdgeSet] at hrow
  rcases Finset.mem_biUnion.1 hrow with ⟨r, _hr, her⟩
  by_cases hr : r = Bump.row
  · subst r
    have hrep : e ∈ Bump.replacementPath.path.edgeSet := by
      simpa [successorInput] using her
    exact Bump.deletedRowSegment_edge_not_mem_replacementPath_of_not_mem_Q0
      he hQ0 hrep
  · have herOld : e ∈ (I.rowPath r).edgeSet := by
      simpa [successorInput, Bump.successorRowPath_of_ne hr] using her
    have hidx : I.rowIndex r ≠ I.rowIndex Bump.row := by
      intro hidx
      exact hr (hinj hidx)
    have hnode :
        (I.rowPath Bump.row).NodeDisjoint (I.rowPath r) := by
      rw [GraphPath.NodeDisjoint, Finset.disjoint_left]
      intro v hvb hvr
      have hvb' :
          v ∈ (I.linkage.path (I.rowIndex Bump.row)).vertexSet := by
        simpa [I.rowPath_eq_linkage_path Bump.row] using hvb
      have hvr' :
          v ∈ (I.linkage.path (I.rowIndex r)).vertexSet := by
        simpa [I.rowPath_eq_linkage_path r] using hvr
      exact Finset.disjoint_left.mp
        (I.linkage.toPathPacking.node_disjoint (fun h => hidx h.symm))
        hvb' hvr'
    have hedge :
        (I.rowPath Bump.row).EdgeDisjoint (I.rowPath r) :=
      graphPath_edgeDisjoint_of_nodeDisjoint hnode
    exact Finset.disjoint_left.mp hedge
      (Bump.deletedRowSegment_edgeSet_subset_row he) herOld

/-- A deleted-middle edge outside `Q₀` is absent from the successor
maintained graph `H̃`. -/
theorem deletedRowSegment_edge_not_mem_successorTilde_of_not_mem_Q0
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (hinj : I.RowIndexInjective)
    (haux : AuxGraphsIsomorphic L (Bump.replacementLinkage hdisj))
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Bump.successorRowPath)
    {e : Sym2 V} (he : e ∈ Bump.deletedRowSegment.edgeSet)
    (hQ0 : e ∉ Q0.edgeSet) :
    e ∉ (Bump.successorInput hdisj hinj haux hq0).tildeEdgeSet := by
  intro htilde
  rcases Finset.mem_union.1
      (by simpa [IterationInput.tildeEdgeSet] using htilde) with hrow | hq
  · exact Bump.deletedRowSegment_edge_not_mem_successorRowEdgeSet_of_not_mem_Q0
      hdisj hinj haux hq0 he hQ0 hrow
  · exact hQ0 hq

end BumpWitness

/-- Finite-set strict decrease used for the maintained graph `H̃`: if the new
edge set is contained in the old one and at least one old edge is missing, the
number of maintained edges strictly decreases. -/
theorem card_lt_of_subset_and_missing {α : Type*} [DecidableEq α]
    {old new : Finset α} {e : α}
    (hsub : new ⊆ old) (he_old : e ∈ old) (he_new : e ∉ new) :
    new.card < old.card := by
  classical
  have hssub : new ⊂ old := by
    refine ⟨hsub, ?_⟩
    intro holdsub
    exact he_new (holdsub he_old)
  exact Finset.card_lt_card hssub

/-- Counting lemma behind the bump paragraph.  If all nonlocal vertices keep
their degree-two status, all local vertices used to be degree two, and at least
one local vertex ceases to have degree two, then the number of degree-two
vertices strictly drops. -/
theorem degreeTwoVertexCount_lt_of_local_drop
    {α : Type*} [Fintype α] [DecidableEq α]
    (H H' : _root_.SimpleGraph α) (S : Finset α)
    (hnonlocal :
      ∀ x : α, x ∉ S → (DegreeEquals H' x 2 ↔ DegreeEquals H x 2))
    (hlocal_old : ∀ x : α, x ∈ S → DegreeEquals H x 2)
    (hdrop : ∃ x : α, x ∈ S ∧ ¬ DegreeEquals H' x 2) :
    degreeTwoVertexCount H' < degreeTwoVertexCount H := by
  classical
  let old : Finset α := Finset.univ.filter fun x => DegreeEquals H x 2
  let new : Finset α := Finset.univ.filter fun x => DegreeEquals H' x 2
  have hsub : new ⊆ old := by
    intro x hx
    have hxnew : DegreeEquals H' x 2 := (Finset.mem_filter.mp hx).2
    by_cases hxS : x ∈ S
    · exact Finset.mem_filter.mpr ⟨Finset.mem_univ x, hlocal_old x hxS⟩
    · exact Finset.mem_filter.mpr
        ⟨Finset.mem_univ x, (hnonlocal x hxS).1 hxnew⟩
  rcases hdrop with ⟨x, hxS, hxnot⟩
  have hxold : x ∈ old :=
    Finset.mem_filter.mpr ⟨Finset.mem_univ x, hlocal_old x hxS⟩
  have hxnew_not : x ∉ new := by
    intro hx
    exact hxnot (Finset.mem_filter.mp hx).2
  have hlt := card_lt_of_subset_and_missing
    (old := old) (new := new) (e := x) hsub hxold hxnew_not
  simpa [degreeTwoVertexCount, old, new] using hlt

/-- Two graphs have the same degree at a vertex if they have exactly the same
neighbors there. -/
theorem degreeEquals_iff_of_adj_iff
    {α : Type*} {H H' : _root_.SimpleGraph α} {v : α} {d : ℕ}
    (hadj : ∀ w : α, H'.Adj v w ↔ H.Adj v w) :
    DegreeEquals H' v d ↔ DegreeEquals H v d := by
  constructor
  · rintro ⟨N, hN, hcard⟩
    refine ⟨N, ?_, hcard⟩
    intro w
    constructor
    · intro hw
      exact (hadj w).1 ((hN w).1 hw)
    · intro hw
      exact (hN w).2 ((hadj w).2 hw)
  · rintro ⟨N, hN, hcard⟩
    refine ⟨N, ?_, hcard⟩
    intro w
    constructor
    · intro hw
      exact (hadj w).2 ((hN w).1 hw)
    · intro hw
      exact (hN w).2 ((hadj w).1 hw)

/-- The symmetric-difference support condition used in the bump paragraph:
every changed auxiliary edge has both endpoints in the specified local set. -/
def AdjChangeSupportedIn {α : Type*}
    (H H' : _root_.SimpleGraph α) (S : Finset α) : Prop :=
  ∀ ⦃u v : α⦄, u ∉ S ∨ v ∉ S → (H'.Adj u v ↔ H.Adj u v)

namespace BumpWitness

variable {I : IterationInput R hpos Q0} (Bump : BumpWitness I)

/-- Figure 7 auxiliary-locality theorem for the bump operation: every
auxiliary edge whose status changes has both endpoints in the local triple. -/
theorem bump_adjChangeSupportedIn
    (auxA auxC : I.linkage.Index)
    (hAM_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Bump.row))
    (hMC_old :
      (linkageAuxGraph I.linkage).Adj (I.rowIndex Bump.row) auxC)
    (hM_old :
      DegreeEquals (linkageAuxGraph I.linkage) (I.rowIndex Bump.row) 2)
    (hA_ne_C : auxA ≠ auxC) :
    AdjChangeSupportedIn (linkageAuxGraph I.linkage)
      (linkageAuxGraph Bump.replacementLinkageConcrete)
      ({auxA, I.rowIndex Bump.row, auxC} : Finset I.linkage.Index) := by
  classical
  intro u v hnonlocal
  constructor
  · intro hnew
    by_contra hnotold
    rcases hnonlocal with hu_not | hv_not
    · have hurow : u ≠ I.rowIndex Bump.row := by
        intro h
        exact hu_not (by simp [h])
      have hulocal :
          u ∈ ({auxA, I.rowIndex Bump.row, auxC} :
              Finset I.linkage.Index) :=
        Bump.mem_local_triple_of_new_adj_not_old_at_left_endpoint
          hurow hnew hnotold hAM_old hMC_old hM_old hA_ne_C
      exact hu_not hulocal
    · have hvrow : v ≠ I.rowIndex Bump.row := by
        intro h
        exact hv_not (by simp [h])
      have hvlocal :
          v ∈ ({auxA, I.rowIndex Bump.row, auxC} :
              Finset I.linkage.Index) :=
        Bump.mem_local_triple_of_new_adj_not_old_at_right_endpoint
          hvrow hnew hnotold hAM_old hMC_old hM_old hA_ne_C
      exact hv_not hvlocal
  · intro hold
    by_contra hnotnew
    rcases hnonlocal with hu_not | hv_not
    · have hurow : u ≠ I.rowIndex Bump.row := by
        intro h
        exact hu_not (by simp [h])
      have hulocal :
          u ∈ ({auxA, I.rowIndex Bump.row, auxC} :
              Finset I.linkage.Index) :=
        Bump.mem_local_triple_of_old_adj_not_new_at_left_endpoint
          hurow hold hnotnew hAM_old hMC_old hM_old hA_ne_C
      exact hu_not hulocal
    · have hvrow : v ≠ I.rowIndex Bump.row := by
        intro h
        exact hv_not (by simp [h])
      have hvlocal :
          v ∈ ({auxA, I.rowIndex Bump.row, auxC} :
              Finset I.linkage.Index) :=
        Bump.mem_local_triple_of_old_adj_not_new_at_right_endpoint
          hvrow hold hnotnew hAM_old hMC_old hM_old hA_ne_C
      exact hv_not hvlocal

end BumpWitness

theorem nonlocal_degree_two_iff_of_adjChangeSupportedIn
    {α : Type*} {H H' : _root_.SimpleGraph α} {S : Finset α}
    (hsupport : AdjChangeSupportedIn H H' S) :
    ∀ x : α, x ∉ S → (DegreeEquals H' x 2 ↔ DegreeEquals H x 2) := by
  intro x hx
  exact degreeEquals_iff_of_adj_iff
    (H := H) (H' := H') (v := x) (d := 2)
    (fun w => hsupport (Or.inl hx))

/-- Local support plus a local degree loss gives the strict degree-two-count
drop asserted in the bump paragraph. -/
theorem degreeTwoVertexCount_lt_of_supported_local_drop
    {α : Type*} [Fintype α] [DecidableEq α]
    (H H' : _root_.SimpleGraph α) (S : Finset α)
    (hsupport : AdjChangeSupportedIn H H' S)
    (hlocal_old : ∀ x : α, x ∈ S → DegreeEquals H x 2)
    (hdrop : ∃ x : α, x ∈ S ∧ ¬ DegreeEquals H' x 2) :
    degreeTwoVertexCount H' < degreeTwoVertexCount H :=
  degreeTwoVertexCount_lt_of_local_drop H H' S
    (nonlocal_degree_two_iff_of_adjChangeSupportedIn hsupport)
    hlocal_old hdrop

/-- Degree saturation for the bump triple `A -- X -- C`.

When the successor middle row `X` has degree two and is adjacent to the two
consecutive row vertices, it has no other neighbor.  If the left endpoint `A`
is also saturated by an outside neighbor and by `X`, then the local skip edge
`A--C` is impossible. -/
theorem DegreeEquals.bump_three_no_skip {α : Type*} [DecidableEq α]
    {H : _root_.SimpleGraph α} {A X C L : α}
    (hAX : H.Adj A X) (hXC : H.Adj X C)
    (hX : DegreeEquals H X 2) (hA : DegreeEquals H A 2)
    (hLA : H.Adj A L) (hLX : L ≠ X)
    (hAC : A ≠ C) (hCX : C ≠ X) (hLC : L ≠ C) :
    ¬ H.Adj A C ∧ ∀ w : α, H.Adj X w → w = A ∨ w = C := by
  constructor
  · exact DegreeEquals.two_not_adj_of_ne hA hLA hAX hLX
      (fun hCL => hLC hCL.symm) hCX
  · intro w hw
    exact DegreeEquals.two_adj_eq_or_eq hX (H.symm hAX) hXC hAC hw

/-- Finite-graph core of the nonterminating bump branch.

The local block is `A -- M -- C`, where `M` is the bumped row vertex.  If
every changed auxiliary edge is supported in this triple, the two consecutive
local adjacencies survive, and the local degree-two vertices remain saturated,
then no local skip edge can appear and the two auxiliary graphs have identical
adjacency relations.  This is the graph-theoretic content of “`H''` is
isomorphic to `H'`, replacing `u_Pj` with `u_Pj'`.” -/
theorem bump_local_adj_iff_of_supported_degree_two
    {α : Type*} [DecidableEq α]
    {H H' : _root_.SimpleGraph α} {L A M C : α}
    (hsupport : AdjChangeSupportedIn H H' ({A, M, C} : Finset α))
    (hLA_old : H.Adj A L) (hAM_old : H.Adj A M)
    (hMC_old : H.Adj M C)
    (hAM_new : H'.Adj A M) (hMC_new : H'.Adj M C)
    (hA_old : DegreeEquals H A 2) (hM_old : DegreeEquals H M 2)
    (hA_new : DegreeEquals H' A 2) (hM_new : DegreeEquals H' M 2)
    (hLA_ne : L ≠ A) (hLM : L ≠ M) (hLC : L ≠ C)
    (hAM_ne : A ≠ M) (hAC : A ≠ C) (hMC_ne : M ≠ C) :
    ∀ u v : α, H'.Adj u v ↔ H.Adj u v := by
  classical
  have hL_not : L ∉ ({A, M, C} : Finset α) := by
    simp [hLA_ne, hLM, hLC]
  have hLA_new : H'.Adj A L := by
    exact (hsupport (u := A) (v := L) (Or.inr hL_not)).2 hLA_old
  have hAC_old_not : ¬ H.Adj A C :=
    DegreeEquals.two_not_adj_of_ne hA_old hLA_old hAM_old hLM
      (fun h => hLC h.symm) (fun h => hMC_ne h.symm)
  have hAC_new_not : ¬ H'.Adj A C :=
    DegreeEquals.two_not_adj_of_ne hA_new hLA_new hAM_new hLM
      (fun h => hLC h.symm) (fun h => hMC_ne h.symm)
  intro u v
  by_cases hu : u ∈ ({A, M, C} : Finset α)
  · by_cases hv : v ∈ ({A, M, C} : Finset α)
    · simp at hu hv
      rcases hu with rfl | rfl | rfl
      · rcases hv with rfl | rfl | rfl
        · simp
        · exact ⟨fun _ => hAM_old, fun _ => hAM_new⟩
        · exact ⟨fun h => False.elim (hAC_new_not h),
            fun h => False.elim (hAC_old_not h)⟩
      · rcases hv with rfl | rfl | rfl
        · exact ⟨fun _ => H.symm hAM_old, fun _ => H'.symm hAM_new⟩
        · simp
        · exact ⟨fun _ => hMC_old, fun _ => hMC_new⟩
      · rcases hv with rfl | rfl | rfl
        · exact ⟨fun h => False.elim (hAC_new_not (H'.symm h)),
            fun h => False.elim (hAC_old_not (H.symm h))⟩
        · exact ⟨fun _ => H.symm hMC_old, fun _ => H'.symm hMC_new⟩
        · simp
    · exact hsupport (Or.inr hv)
  · exact hsupport (Or.inl hu)

/-- The finite-graph dichotomy used in the bump paragraph.

If a bump action changes only the local triple, then either one of the three
formerly degree-two local vertices stops being degree two, giving a strict
drop in the number of degree-two vertices, or all local degrees remain two and
the auxiliary graph is unchanged up to the replacement of the middle row. -/
theorem bump_supported_degree_drop_or_aux_adj_iff
    {α : Type*} [Fintype α] [DecidableEq α]
    (H H' : _root_.SimpleGraph α) (L A M C : α)
    (hsupport : AdjChangeSupportedIn H H' ({A, M, C} : Finset α))
    (hLA_old : H.Adj A L) (hAM_old : H.Adj A M)
    (hMC_old : H.Adj M C)
    (hAM_new : H'.Adj A M) (hMC_new : H'.Adj M C)
    (hA_old : DegreeEquals H A 2) (hM_old : DegreeEquals H M 2)
    (hC_old : DegreeEquals H C 2)
    (hLA_ne : L ≠ A) (hLM : L ≠ M) (hLC : L ≠ C)
    (hAM_ne : A ≠ M) (hAC : A ≠ C) (hMC_ne : M ≠ C) :
    degreeTwoVertexCount H' < degreeTwoVertexCount H ∨
      ∀ u v : α, H'.Adj u v ↔ H.Adj u v := by
  classical
  let S : Finset α := {A, M, C}
  have hlocal_old : ∀ x : α, x ∈ S → DegreeEquals H x 2 := by
    intro x hx
    simp [S] at hx
    rcases hx with rfl | rfl | rfl
    · exact hA_old
    · exact hM_old
    · exact hC_old
  by_cases hA_new : DegreeEquals H' A 2
  · by_cases hM_new : DegreeEquals H' M 2
    · by_cases hC_new : DegreeEquals H' C 2
      · exact Or.inr
          (bump_local_adj_iff_of_supported_degree_two
            (H := H) (H' := H') (L := L) (A := A) (M := M) (C := C)
            hsupport hLA_old hAM_old hMC_old hAM_new hMC_new hA_old
            hM_old hA_new hM_new hLA_ne hLM hLC hAM_ne hAC hMC_ne)
      · exact Or.inl
          (degreeTwoVertexCount_lt_of_supported_local_drop H H' S
            (by simpa [S] using hsupport) hlocal_old
            ⟨C, by simp [S], hC_new⟩)
    · exact Or.inl
        (degreeTwoVertexCount_lt_of_supported_local_drop H H' S
          (by simpa [S] using hsupport) hlocal_old
          ⟨M, by simp [S], hM_new⟩)
  · exact Or.inl
      (degreeTwoVertexCount_lt_of_supported_local_drop H H' S
        (by simpa [S] using hsupport) hlocal_old
        ⟨A, by simp [S], hA_new⟩)

/-- The local auxiliary-graph facts used in the bump paragraph.

`local` is the triple `{u_{P_{j-1}}, u_{P_j}, u_{P_{j+1}}}`.  The support
condition says that all degree-two changes are confined to this triple. -/
structure BumpLocalDegreeDropCertificate
    {α : Type*} [Fintype α] [DecidableEq α]
    (H H' : _root_.SimpleGraph α) where
  localSet : Finset α
  nonlocal_degree_two_iff :
    ∀ x : α, x ∉ localSet → (DegreeEquals H' x 2 ↔ DegreeEquals H x 2)
  local_old_degree_two :
    ∀ x : α, x ∈ localSet → DegreeEquals H x 2
  local_degree_drop :
    ∃ x : α, x ∈ localSet ∧ ¬ DegreeEquals H' x 2

namespace BumpLocalDegreeDropCertificate

variable {α : Type*} [Fintype α] [DecidableEq α]
variable {H H' : _root_.SimpleGraph α}

theorem degreeTwoCount_lt (C : BumpLocalDegreeDropCertificate H H') :
    degreeTwoVertexCount H' < degreeTwoVertexCount H :=
  degreeTwoVertexCount_lt_of_local_drop H H' C.localSet
    C.nonlocal_degree_two_iff C.local_old_degree_two C.local_degree_drop

end BumpLocalDegreeDropCertificate

/-- In the non-degree-drop branch of a bump action, the paper obtains a valid
successor iteration input and the maintained graph `H̃` loses an edge. -/
structure BumpSuccessorCertificate {I : IterationInput R hpos Q0}
    (Bump : BumpWitness I) where
  replacement : BumpReplacementPath Bump
  next : IterationInput R hpos Q0
  tilde_subset : next.tildeEdgeSet ⊆ I.tildeEdgeSet
  deleted_edge : Sym2 V
  deleted_edge_middle : deleted_edge ∈ Bump.deletedRowSegment.edgeSet
  deleted_edge_new : deleted_edge ∉ next.tildeEdgeSet

namespace BumpSuccessorCertificate

variable {I : IterationInput R hpos Q0} {Bump : BumpWitness I}

theorem tilde_card_lt (C : BumpSuccessorCertificate Bump) :
    C.next.tildeEdgeSet.card < I.tildeEdgeSet.card :=
  Bump.tilde_card_lt_of_missing_deletedRowSegment_edge C.tilde_subset
    C.deleted_edge_middle C.deleted_edge_new

end BumpSuccessorCertificate

namespace BumpWitness

variable {I : IterationInput R hpos Q0} (Bump : BumpWitness I)

/-- Nonterminating bump branch: if the local successor adjacencies survive and
the two relevant local degrees remain two, then the replacement linkage has
an auxiliary graph isomorphic to the previous one. -/
theorem replacementLinkage_auxGraphsIsomorphic_of_supportedLocalDegreeTwo
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (auxL auxA auxM auxC : I.linkage.Index)
    (hsupport :
      AdjChangeSupportedIn (linkageAuxGraph I.linkage)
        (linkageAuxGraph (Bump.replacementLinkage hdisj))
        ({auxA, auxM, auxC} : Finset I.linkage.Index))
    (hLA_old : (linkageAuxGraph I.linkage).Adj auxA auxL)
    (hAM_old : (linkageAuxGraph I.linkage).Adj auxA auxM)
    (hMC_old : (linkageAuxGraph I.linkage).Adj auxM auxC)
    (hAM_new :
      (linkageAuxGraph (Bump.replacementLinkage hdisj)).Adj auxA auxM)
    (hMC_new :
      (linkageAuxGraph (Bump.replacementLinkage hdisj)).Adj auxM auxC)
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hM_old : DegreeEquals (linkageAuxGraph I.linkage) auxM 2)
    (hA_new :
      DegreeEquals (linkageAuxGraph (Bump.replacementLinkage hdisj))
        auxA 2)
    (hM_new :
      DegreeEquals (linkageAuxGraph (Bump.replacementLinkage hdisj))
        auxM 2)
    (hLA_ne : auxL ≠ auxA) (hLM : auxL ≠ auxM)
    (hLC : auxL ≠ auxC) (hAM_ne : auxA ≠ auxM)
    (hAC : auxA ≠ auxC) (hMC_ne : auxM ≠ auxC) :
    AuxGraphsIsomorphic I.linkage (Bump.replacementLinkage hdisj) := by
  let L'' : PerfectPathPacking G A B := Bump.replacementLinkage hdisj
  have hadj :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph L'').Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j := by
    exact
      bump_local_adj_iff_of_supported_degree_two
        (H := linkageAuxGraph I.linkage) (H' := linkageAuxGraph L'')
        (L := auxL) (A := auxA) (M := auxM) (C := auxC)
        hsupport hLA_old hAM_old hMC_old hAM_new hMC_new hA_old
        hM_old hA_new hM_new hLA_ne hLM hLC hAM_ne hAC hMC_ne
  exact Bump.replacementLinkage_auxGraphsIsomorphic_of_adj_iff hdisj hadj

/-- Concrete nonterminating bump branch, using the replacement linkage built
directly from the bump witness. -/
theorem replacementLinkageConcrete_auxGraphsIsomorphic_of_supportedLocalDegreeTwo
    (auxL auxA auxM auxC : I.linkage.Index)
    (hsupport :
      AdjChangeSupportedIn (linkageAuxGraph I.linkage)
        (linkageAuxGraph Bump.replacementLinkageConcrete)
        ({auxA, auxM, auxC} : Finset I.linkage.Index))
    (hLA_old : (linkageAuxGraph I.linkage).Adj auxA auxL)
    (hAM_old : (linkageAuxGraph I.linkage).Adj auxA auxM)
    (hMC_old : (linkageAuxGraph I.linkage).Adj auxM auxC)
    (hAM_new :
      (linkageAuxGraph Bump.replacementLinkageConcrete).Adj auxA auxM)
    (hMC_new :
      (linkageAuxGraph Bump.replacementLinkageConcrete).Adj auxM auxC)
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hM_old : DegreeEquals (linkageAuxGraph I.linkage) auxM 2)
    (hA_new :
      DegreeEquals (linkageAuxGraph Bump.replacementLinkageConcrete)
        auxA 2)
    (hM_new :
      DegreeEquals (linkageAuxGraph Bump.replacementLinkageConcrete)
        auxM 2)
    (hLA_ne : auxL ≠ auxA) (hLM : auxL ≠ auxM)
    (hLC : auxL ≠ auxC) (hAM_ne : auxA ≠ auxM)
    (hAC : auxA ≠ auxC) (hMC_ne : auxM ≠ auxC) :
    AuxGraphsIsomorphic I.linkage Bump.replacementLinkageConcrete := by
  simpa [replacementLinkageConcrete] using
    Bump.replacementLinkage_auxGraphsIsomorphic_of_supportedLocalDegreeTwo
      Bump.replacementPath_nodeDisjoint_unchanged_all
      auxL auxA auxM auxC
      (by simpa [replacementLinkageConcrete] using hsupport)
      hLA_old hAM_old hMC_old
      (by simpa [replacementLinkageConcrete] using hAM_new)
      (by simpa [replacementLinkageConcrete] using hMC_new)
      hA_old hM_old
      (by simpa [replacementLinkageConcrete] using hA_new)
      (by simpa [replacementLinkageConcrete] using hM_new)
      hLA_ne hLM hLC hAM_ne hAC hMC_ne

/-- Package the concrete bump successor input as the successor certificate used
by the abstract action dichotomy, once a deleted middle edge is known to be
absent from the successor maintained graph. -/
noncomputable def successorCertificate_of_missing_deleted_edge
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (hinj : I.RowIndexInjective)
    (haux : AuxGraphsIsomorphic L (Bump.replacementLinkage hdisj))
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Bump.successorRowPath)
    (deleted_edge : Sym2 V)
    (hdeleted : deleted_edge ∈ Bump.deletedRowSegment.edgeSet)
    (hmissing :
      deleted_edge ∉
        (Bump.successorInput hdisj hinj haux hq0).tildeEdgeSet) :
    BumpSuccessorCertificate Bump where
  replacement := Bump.replacementPath
  next := Bump.successorInput hdisj hinj haux hq0
  tilde_subset := Bump.successorInput_tilde_subset hdisj hinj haux hq0
  deleted_edge := deleted_edge
  deleted_edge_middle := hdeleted
  deleted_edge_new := hmissing

/-- Concrete successor certificate for the bump nonterminating branch.

The deleted middle segment always contains an edge not owned by the fixed
`Q₀` family.  Such an edge is absent from the successor row family by the
prefix/segment/suffix support of the replacement row, hence absent from the
successor maintained graph `H̃`. -/
noncomputable def successorCertificate_of_constructed_deleted_edge
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (hinj : I.RowIndexInjective)
    (haux : AuxGraphsIsomorphic L (Bump.replacementLinkage hdisj))
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Bump.successorRowPath) :
    BumpSuccessorCertificate Bump := by
  classical
  let deleted_edge : Sym2 V :=
    Classical.choose Bump.exists_deletedRowSegment_edge_not_mem_Q0
  have hdeleted :
      deleted_edge ∈ Bump.deletedRowSegment.edgeSet :=
    (Classical.choose_spec
      Bump.exists_deletedRowSegment_edge_not_mem_Q0).1
  have hnotQ0 : deleted_edge ∉ Q0.edgeSet :=
    (Classical.choose_spec
      Bump.exists_deletedRowSegment_edge_not_mem_Q0).2
  exact Bump.successorCertificate_of_missing_deleted_edge hdisj hinj
    haux hq0 deleted_edge hdeleted
    (Bump.deletedRowSegment_edge_not_mem_successorTilde_of_not_mem_Q0
      hdisj hinj haux hq0 hdeleted hnotQ0)

/-- The bump successor certificate preserves the explicit linkage-support
invariant. -/
theorem successorCertificate_typeOneLinkageSupportInvariant
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (hinj : I.RowIndexInjective)
    (haux : AuxGraphsIsomorphic L (Bump.replacementLinkage hdisj))
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Bump.successorRowPath)
    (hsupport : IterationInput.TypeOneLinkageSupportInvariant I)
    (deleted_edge : Sym2 V)
    (hdeleted : deleted_edge ∈ Bump.deletedRowSegment.edgeSet)
    (hmissing :
      deleted_edge ∉
        (Bump.successorInput hdisj hinj haux hq0).tildeEdgeSet) :
    IterationInput.TypeOneLinkageSupportInvariant
      (Bump.successorCertificate_of_missing_deleted_edge hdisj hinj haux hq0
        deleted_edge hdeleted hmissing).next :=
  Bump.successorInput_typeOneLinkageSupportInvariant hdisj hinj haux hq0
    hsupport

/-- The concrete bump successor certificate carries the row invariant package
through the nonterminating branch. -/
noncomputable def successorCertificate_iterationInvariants
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (haux : AuxGraphsIsomorphic L (Bump.replacementLinkage hdisj))
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Bump.successorRowPath)
    (Inv : TypeOneIterationInvariants I)
    (deleted_edge : Sym2 V)
    (hdeleted : deleted_edge ∈ Bump.deletedRowSegment.edgeSet)
    (hmissing :
      deleted_edge ∉
        (Bump.successorInput hdisj Inv.rowIndexInjective haux hq0).tildeEdgeSet) :
    TypeOneIterationInvariants
      (Bump.successorCertificate_of_missing_deleted_edge hdisj
        Inv.rowIndexInjective haux hq0 deleted_edge hdeleted hmissing).next :=
  Bump.successorInput_iterationInvariants hdisj haux hq0 Inv

/-- The concrete bump successor certificate preserves the full invariant
package when the nonterminating local analysis proves that auxiliary
adjacency is unchanged on the shared index type. -/
noncomputable def successorCertificate_fullIterationInvariants
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (haux : AuxGraphsIsomorphic L (Bump.replacementLinkage hdisj))
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Bump.successorRowPath)
    (Inv : TypeOneFullIterationInvariants I)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph (Bump.replacementLinkage hdisj)).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j)
    (deleted_edge : Sym2 V)
    (hdeleted : deleted_edge ∈ Bump.deletedRowSegment.edgeSet)
    (hmissing :
      deleted_edge ∉
        (Bump.successorInput hdisj Inv.base.rowIndexInjective haux hq0).tildeEdgeSet) :
    TypeOneFullIterationInvariants
      (Bump.successorCertificate_of_missing_deleted_edge hdisj
        Inv.base.rowIndexInjective haux hq0 deleted_edge hdeleted hmissing).next where
  base :=
    Bump.successorCertificate_iterationInvariants hdisj haux hq0 Inv.base
      deleted_edge hdeleted hmissing
  active_aux := by
    change TypeOneActiveAuxiliaryInvariant
      (Bump.successorInput hdisj Inv.base.rowIndexInjective haux hq0)
      (Bump.successorInput_iterationInvariants hdisj haux hq0 Inv.base)
    exact Bump.successorInput_activeAuxiliaryInvariant hdisj haux hq0
      Inv.base Inv.active_aux hadj_iff

/-- The concrete bump successor certificate preserves the extended full
invariant package, including boundary rows, in the nonterminating branch. -/
noncomputable def successorCertificate_extendedFullIterationInvariants
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (haux : AuxGraphsIsomorphic L (Bump.replacementLinkage hdisj))
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Bump.successorRowPath)
    (Inv : TypeOneExtendedFullIterationInvariants I)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph (Bump.replacementLinkage hdisj)).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j)
    (deleted_edge : Sym2 V)
    (hdeleted : deleted_edge ∈ Bump.deletedRowSegment.edgeSet)
    (hmissing :
      deleted_edge ∉
        (Bump.successorInput hdisj Inv.full.base.rowIndexInjective haux hq0).tildeEdgeSet) :
    TypeOneExtendedFullIterationInvariants
      (Bump.successorCertificate_of_missing_deleted_edge hdisj
        Inv.full.base.rowIndexInjective haux hq0 deleted_edge hdeleted
        hmissing).next where
  full :=
    Bump.successorCertificate_fullIterationInvariants hdisj haux hq0
      Inv.full hadj_iff deleted_edge hdeleted hmissing
  boundary := by
    change TypeOneBoundaryAuxiliaryInvariant
      (Bump.successorInput hdisj Inv.full.base.rowIndexInjective haux hq0)
      (Bump.successorInput_iterationInvariants hdisj haux hq0
        Inv.full.base)
    exact Bump.successorInput_boundaryAuxiliaryInvariant hdisj haux hq0
      Inv hadj_iff

end BumpWitness

/-- The two possible outcomes of the bump action, matching the paragraph:
either the auxiliary graph loses a degree-two vertex, or the auxiliary graph is
isomorphic and the maintained graph `H̃` strictly decreases. -/
structure BumpActionCertificate {I : IterationInput R hpos Q0}
    (Bump : BumpWitness I) where
  degree_drop :
    (∃ L'' : PerfectPathPacking G A B,
      linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount I.linkage) ∨
      Nonempty (BumpSuccessorCertificate Bump)

namespace BumpActionCertificate

variable {I : IterationInput R hpos Q0} {Bump : BumpWitness I}

/-- A bump action supplies the generic simplifying-action outcome used by the
iteration. -/
theorem simplifyingActionOutcome (C : BumpActionCertificate Bump) :
    SimplifyingActionOutcome I := by
  rcases C.degree_drop with hdrop | hsucc
  · exact Or.inl hdrop
  · rcases hsucc with ⟨S⟩
    exact Or.inr ⟨S.next, S.tilde_card_lt⟩

end BumpActionCertificate

namespace BumpWitness

variable {I : IterationInput R hpos Q0} (Bump : BumpWitness I)

/-- Assembles the formal conclusion of the paragraph “A bump.”

The hypotheses are the local facts proved around Figure 7: the replacement row
is a valid linkage row, every auxiliary edge change is supported on the local
triple, the old local triple was degree two, and the two row adjacencies
survive after the replacement.  The finite-graph dichotomy then gives either
a strict drop in the number of degree-two auxiliary vertices, or the supplied
successor certificate for the isomorphic branch. -/
theorem actionCertificate_of_supportedLocalDichotomy
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (auxL auxA auxM auxC : I.linkage.Index)
    (hsupport :
      AdjChangeSupportedIn (linkageAuxGraph I.linkage)
        (linkageAuxGraph (Bump.replacementLinkage hdisj))
        ({auxA, auxM, auxC} : Finset I.linkage.Index))
    (hLA_old : (linkageAuxGraph I.linkage).Adj auxA auxL)
    (hAM_old : (linkageAuxGraph I.linkage).Adj auxA auxM)
    (hMC_old : (linkageAuxGraph I.linkage).Adj auxM auxC)
    (hAM_new :
      (linkageAuxGraph (Bump.replacementLinkage hdisj)).Adj auxA auxM)
    (hMC_new :
      (linkageAuxGraph (Bump.replacementLinkage hdisj)).Adj auxM auxC)
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hM_old : DegreeEquals (linkageAuxGraph I.linkage) auxM 2)
    (hC_old : DegreeEquals (linkageAuxGraph I.linkage) auxC 2)
    (hLA_ne : auxL ≠ auxA) (hLM : auxL ≠ auxM) (hLC : auxL ≠ auxC)
    (hAM_ne : auxA ≠ auxM) (hAC : auxA ≠ auxC)
    (hMC_ne : auxM ≠ auxC)
    (hsucc : BumpSuccessorCertificate Bump) :
    BumpActionCertificate Bump := by
  classical
  let L'' : PerfectPathPacking G A B := Bump.replacementLinkage hdisj
  have hdich :
      degreeTwoVertexCount (linkageAuxGraph L'') <
          degreeTwoVertexCount (linkageAuxGraph I.linkage) ∨
        ∀ u v : I.linkage.Index,
          (linkageAuxGraph L'').Adj u v ↔
            (linkageAuxGraph I.linkage).Adj u v := by
    exact
      bump_supported_degree_drop_or_aux_adj_iff
        (H := linkageAuxGraph I.linkage) (H' := linkageAuxGraph L'')
        (L := auxL) (A := auxA) (M := auxM) (C := auxC)
        (by simpa [L''] using hsupport)
        hLA_old hAM_old hMC_old
        (by simpa [L''] using hAM_new)
        (by simpa [L''] using hMC_new)
        hA_old hM_old hC_old hLA_ne hLM hLC hAM_ne hAC hMC_ne
  refine ⟨?_⟩
  rcases hdich with hdrop | _hiso
  · exact Or.inl ⟨L'', by
      simpa [L'', linkageAuxDegreeTwoCount] using hdrop⟩
  · exact Or.inr ⟨hsucc⟩

/-- Sharper bump control-flow lemma: the successor certificate is required
only when the local degree test confirms that all three local vertices remain
degree two.  This matches the proof text: if a local degree changes, the
algorithm stops immediately with a degree-two-count drop. -/
theorem actionCertificate_of_supportedLocalDichotomy_conditionalSuccessor
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (auxA auxM auxC : I.linkage.Index)
    (hsupport :
      AdjChangeSupportedIn (linkageAuxGraph I.linkage)
        (linkageAuxGraph (Bump.replacementLinkage hdisj))
        ({auxA, auxM, auxC} : Finset I.linkage.Index))
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hM_old : DegreeEquals (linkageAuxGraph I.linkage) auxM 2)
    (hC_old : DegreeEquals (linkageAuxGraph I.linkage) auxC 2)
    (hsucc :
      DegreeEquals
        (linkageAuxGraph (Bump.replacementLinkage hdisj)) auxA 2 →
      DegreeEquals
        (linkageAuxGraph (Bump.replacementLinkage hdisj)) auxM 2 →
      DegreeEquals
        (linkageAuxGraph (Bump.replacementLinkage hdisj)) auxC 2 →
      BumpSuccessorCertificate Bump) :
    BumpActionCertificate Bump := by
  classical
  let L'' : PerfectPathPacking G A B := Bump.replacementLinkage hdisj
  let S : Finset I.linkage.Index := {auxA, auxM, auxC}
  have hlocal_old :
      ∀ x : I.linkage.Index, x ∈ S →
        DegreeEquals (linkageAuxGraph I.linkage) x 2 := by
    intro x hx
    simp [S] at hx
    rcases hx with rfl | rfl | rfl
    · exact hA_old
    · exact hM_old
    · exact hC_old
  refine ⟨?_⟩
  by_cases hA_new : DegreeEquals (linkageAuxGraph L'') auxA 2
  · by_cases hM_new : DegreeEquals (linkageAuxGraph L'') auxM 2
    · by_cases hC_new : DegreeEquals (linkageAuxGraph L'') auxC 2
      · exact Or.inr ⟨hsucc
          (by simpa [L''] using hA_new)
          (by simpa [L''] using hM_new)
          (by simpa [L''] using hC_new)⟩
      · exact Or.inl ⟨L'', by
          have hdrop :
              degreeTwoVertexCount (linkageAuxGraph L'') <
                degreeTwoVertexCount (linkageAuxGraph I.linkage) :=
            degreeTwoVertexCount_lt_of_supported_local_drop
              (linkageAuxGraph I.linkage) (linkageAuxGraph L'') S
              (by simpa [S, L''] using hsupport) hlocal_old
              ⟨auxC, by simp [S], hC_new⟩
          simpa [L'', linkageAuxDegreeTwoCount] using hdrop⟩
    · exact Or.inl ⟨L'', by
        have hdrop :
            degreeTwoVertexCount (linkageAuxGraph L'') <
              degreeTwoVertexCount (linkageAuxGraph I.linkage) :=
          degreeTwoVertexCount_lt_of_supported_local_drop
            (linkageAuxGraph I.linkage) (linkageAuxGraph L'') S
            (by simpa [S, L''] using hsupport) hlocal_old
            ⟨auxM, by simp [S], hM_new⟩
        simpa [L'', linkageAuxDegreeTwoCount] using hdrop⟩
  · exact Or.inl ⟨L'', by
      have hdrop :
          degreeTwoVertexCount (linkageAuxGraph L'') <
            degreeTwoVertexCount (linkageAuxGraph I.linkage) :=
        degreeTwoVertexCount_lt_of_supported_local_drop
          (linkageAuxGraph I.linkage) (linkageAuxGraph L'') S
          (by simpa [S, L''] using hsupport) hlocal_old
          ⟨auxA, by simp [S], hA_new⟩
      simpa [L'', linkageAuxDegreeTwoCount] using hdrop⟩

/-- Self-contained bump action certificate using the constructed deleted
middle edge for the nonterminating successor branch. -/
theorem actionCertificate_of_supportedLocalDichotomy_constructedSuccessor
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (hinj : I.RowIndexInjective)
    (haux : AuxGraphsIsomorphic L (Bump.replacementLinkage hdisj))
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Bump.successorRowPath)
    (auxA auxM auxC : I.linkage.Index)
    (hsupport :
      AdjChangeSupportedIn (linkageAuxGraph I.linkage)
        (linkageAuxGraph (Bump.replacementLinkage hdisj))
        ({auxA, auxM, auxC} : Finset I.linkage.Index))
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hM_old : DegreeEquals (linkageAuxGraph I.linkage) auxM 2)
    (hC_old : DegreeEquals (linkageAuxGraph I.linkage) auxC 2) :
    BumpActionCertificate Bump :=
  Bump.actionCertificate_of_supportedLocalDichotomy_conditionalSuccessor
    hdisj auxA auxM auxC hsupport hA_old hM_old hC_old
    (fun _hA_new _hM_new _hC_new =>
      Bump.successorCertificate_of_constructed_deleted_edge hdisj hinj
        haux hq0)

/-- Concrete self-contained bump action certificate: the replacement linkage
is the one whose disjointness has already been proved from the bump witness's
full-linkage-clean segment. -/
theorem actionCertificate_of_supportedLocalDichotomy_constructedSuccessor_concrete
    (hinj : I.RowIndexInjective)
    (haux : AuxGraphsIsomorphic L Bump.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Bump.successorRowPath)
    (auxA auxM auxC : I.linkage.Index)
    (hsupport :
      AdjChangeSupportedIn (linkageAuxGraph I.linkage)
        (linkageAuxGraph Bump.replacementLinkageConcrete)
        ({auxA, auxM, auxC} : Finset I.linkage.Index))
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hM_old : DegreeEquals (linkageAuxGraph I.linkage) auxM 2)
    (hC_old : DegreeEquals (linkageAuxGraph I.linkage) auxC 2) :
    BumpActionCertificate Bump := by
  classical
  exact
    Bump.actionCertificate_of_supportedLocalDichotomy_constructedSuccessor
      Bump.replacementPath_nodeDisjoint_unchanged_all hinj
      (by simpa [replacementLinkageConcrete] using haux)
      hq0 auxA auxM auxC
      (by simpa [replacementLinkageConcrete] using hsupport)
      hA_old hM_old hC_old

/-- Bump action certificate from the full local Figure 7 data, with both the
replacement linkage and the auxiliary-isomorphism proof constructed inside the
theorem.

The successor branch is entered only under the local degree-two test.  In that
branch the local support and surviving adjacencies imply auxiliary isomorphism;
composing with the old fixed-outside isomorphism gives the `haux` field needed
by the successor input. -/
theorem actionCertificate_of_supportedLocalDichotomy_constructedSuccessor_fromLocalData
    (hinj : I.RowIndexInjective)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Bump.successorRowPath)
    (auxL auxA auxM auxC : I.linkage.Index)
    (hsupport :
      AdjChangeSupportedIn (linkageAuxGraph I.linkage)
        (linkageAuxGraph Bump.replacementLinkageConcrete)
        ({auxA, auxM, auxC} : Finset I.linkage.Index))
    (hLA_old : (linkageAuxGraph I.linkage).Adj auxA auxL)
    (hAM_old : (linkageAuxGraph I.linkage).Adj auxA auxM)
    (hMC_old : (linkageAuxGraph I.linkage).Adj auxM auxC)
    (hAM_new :
      (linkageAuxGraph Bump.replacementLinkageConcrete).Adj auxA auxM)
    (hMC_new :
      (linkageAuxGraph Bump.replacementLinkageConcrete).Adj auxM auxC)
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hM_old : DegreeEquals (linkageAuxGraph I.linkage) auxM 2)
    (hC_old : DegreeEquals (linkageAuxGraph I.linkage) auxC 2)
    (hLA_ne : auxL ≠ auxA) (hLM : auxL ≠ auxM)
    (hLC : auxL ≠ auxC) (hAM_ne : auxA ≠ auxM)
    (hAC : auxA ≠ auxC) (hMC_ne : auxM ≠ auxC) :
    BumpActionCertificate Bump := by
  classical
  exact
    Bump.actionCertificate_of_supportedLocalDichotomy_conditionalSuccessor
      Bump.replacementPath_nodeDisjoint_unchanged_all
      auxA auxM auxC
      (by simpa [replacementLinkageConcrete] using hsupport)
      hA_old hM_old hC_old
      (fun hA_new hM_new _hC_new =>
        let haux_prev :
            AuxGraphsIsomorphic I.linkage Bump.replacementLinkageConcrete :=
          Bump.replacementLinkageConcrete_auxGraphsIsomorphic_of_supportedLocalDegreeTwo
            auxL auxA auxM auxC hsupport hLA_old hAM_old hMC_old
            hAM_new hMC_new hA_old hM_old
            (by simpa [replacementLinkageConcrete] using hA_new)
            (by simpa [replacementLinkageConcrete] using hM_new)
            hLA_ne hLM hLC hAM_ne hAC hMC_ne
        let haux_fixed :
            AuxGraphsIsomorphic L Bump.replacementLinkageConcrete :=
          auxGraphsIsomorphic_trans I.aux_iso_fixed_outside haux_prev
        Bump.successorCertificate_of_constructed_deleted_edge
          Bump.replacementPath_nodeDisjoint_unchanged_all hinj
          (by simpa [replacementLinkageConcrete] using haux_fixed) hq0)

/-- Direct simplifying-action form of the Figure 7 bump dichotomy. -/
theorem simplifyingActionOutcome_of_supportedLocalDichotomy
    (hdisj :
      ∀ i : I.linkage.Index, i ≠ I.rowIndex Bump.row →
        Bump.replacementPath.path.NodeDisjoint (I.linkage.path i))
    (auxL auxA auxM auxC : I.linkage.Index)
    (hsupport :
      AdjChangeSupportedIn (linkageAuxGraph I.linkage)
        (linkageAuxGraph (Bump.replacementLinkage hdisj))
        ({auxA, auxM, auxC} : Finset I.linkage.Index))
    (hLA_old : (linkageAuxGraph I.linkage).Adj auxA auxL)
    (hAM_old : (linkageAuxGraph I.linkage).Adj auxA auxM)
    (hMC_old : (linkageAuxGraph I.linkage).Adj auxM auxC)
    (hAM_new :
      (linkageAuxGraph (Bump.replacementLinkage hdisj)).Adj auxA auxM)
    (hMC_new :
      (linkageAuxGraph (Bump.replacementLinkage hdisj)).Adj auxM auxC)
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hM_old : DegreeEquals (linkageAuxGraph I.linkage) auxM 2)
    (hC_old : DegreeEquals (linkageAuxGraph I.linkage) auxC 2)
    (hLA_ne : auxL ≠ auxA) (hLM : auxL ≠ auxM) (hLC : auxL ≠ auxC)
    (hAM_ne : auxA ≠ auxM) (hAC : auxA ≠ auxC)
    (hMC_ne : auxM ≠ auxC)
    (hsucc : BumpSuccessorCertificate Bump) :
    SimplifyingActionOutcome I :=
  (Bump.actionCertificate_of_supportedLocalDichotomy hdisj auxL auxA auxM
    auxC hsupport hLA_old hAM_old hMC_old hAM_new hMC_new hA_old hM_old
    hC_old hLA_ne hLM hLC hAM_ne hAC hMC_ne hsucc).simplifyingActionOutcome

end BumpWitness

/-! ## The cross operation from Figure 8

The next declarations formalize the paragraph headed “A cross.”  As with
bumps, transversal subpaths are stored without choosing the direction induced by
their parent `Q₀` path.  The operation orients the first subpath from
`s₁` to `t₁`, and the second from `t₂` to `s₂`, exactly as in the switched
replacement rows in the paper.
-/

/-- A cross in the maintained graph `H̃`.

The left row is the current `P_j'`, the right row is `P_{j+1}'`.  The endpoints
are named by row order:

* `s₁` occurs before `s₂` on the left row;
* `t₂` occurs before `t₁` on the right row.

The two transversal segments are stored as unoriented paths with endpoint sets
`{s₁,t₁}` and `{s₂,t₂}`.  The replacement construction orients them in the
directions required by Figure 8. -/
structure CrossWitness (I : IterationInput R hpos Q0) where
  rowLeft : I.Row
  rowRight : I.Row
  rowIndex_ne : I.rowIndex rowLeft ≠ I.rowIndex rowRight
  rowLeft_index_unique :
    ∀ r : I.Row, I.rowIndex r = I.rowIndex rowLeft → r = rowLeft
  rowRight_index_unique :
    ∀ r : I.Row, I.rowIndex r = I.rowIndex rowRight → r = rowRight
  rows_nodeDisjoint : (I.rowPath rowLeft).NodeDisjoint (I.rowPath rowRight)
  qIndex1 : Q.Index
  qIndex2 : Q.Index
  qIndex_ne : qIndex1 ≠ qIndex2
  q_mem1 : qIndex1 ∈ Q0.indices
  q_mem2 : qIndex2 ∈ Q0.indices
  s1 : V
  s2 : V
  t1 : V
  t2 : V
  s1_mem_left : s1 ∈ (I.rowPath rowLeft).vertexSet
  s2_mem_left : s2 ∈ (I.rowPath rowLeft).vertexSet
  t1_mem_right : t1 ∈ (I.rowPath rowRight).vertexSet
  t2_mem_right : t2 ∈ (I.rowPath rowRight).vertexSet
  s1_before_s2 : (I.rowPath rowLeft).Before s1 s2
  t2_before_t1 : (I.rowPath rowRight).Before t2 t1
  s1_ne_s2 : s1 ≠ s2
  t2_ne_t1 : t2 ≠ t1
  segment1 : GraphPath G
  segment2 : GraphPath G
  segment1_connects : segment1.Connects {s1} {t1}
  segment2_connects : segment2.Connects {s2} {t2}
  segment1_subset_qstar :
    segment1.vertexSet ⊆ (Q0.data qIndex1 q_mem1).qstar.vertexSet
  segment2_subset_qstar :
    segment2.vertexSet ⊆ (Q0.data qIndex2 q_mem2).qstar.vertexSet
  segment1_edgeSet_subset_qstar :
    segment1.edgeSet ⊆ (Q0.data qIndex1 q_mem1).qstar.edgeSet
  segment2_edgeSet_subset_qstar :
    segment2.edgeSet ⊆ (Q0.data qIndex2 q_mem2).qstar.edgeSet
  /-- All row contacts of the first cross segment are its endpoints. -/
  segment1_clean_rows :
    segment1.InternallyDisjointFromSet I.rowVertexSet
  /-- All row contacts of the second cross segment are its endpoints. -/
  segment2_clean_rows :
    segment2.InternallyDisjointFromSet I.rowVertexSet
  /-- The first cross segment is clean with respect to the whole current
  linkage, as supplied by the maintained invariant before choosing a cross. -/
  segment1_clean_linkage :
    segment1.InternallyDisjointFromSet I.linkage.toPathPacking.vertexSet
  /-- The second cross segment is clean with respect to the whole current
  linkage. -/
  segment2_clean_linkage :
    segment2.InternallyDisjointFromSet I.linkage.toPathPacking.vertexSet
  /-- The two transversal segments are disjoint, as required in the definition
  of a cross. -/
  segments_nodeDisjoint : segment1.NodeDisjoint segment2

namespace CrossWitness

variable {I : IterationInput R hpos Q0} (Cross : CrossWitness I)

/-- The first cross segment oriented from `s₁` to `t₁`. -/
noncomputable def orientedSegment1 : GraphPath G :=
  orientBetween Cross.segment1 Cross.segment1_connects

/-- The second stored segment also connects `{t₂}` to `{s₂}`. -/
theorem segment2_connects_reversed :
    Cross.segment2.Connects {Cross.t2} {Cross.s2} := by
  rcases Cross.segment2_connects with h | h
  · exact Or.inr h
  · exact Or.inl h

/-- The second cross segment oriented from `t₂` to `s₂`, the direction in
which Figure 8 uses it. -/
noncomputable def orientedSegment2 : GraphPath G :=
  orientBetween Cross.segment2 Cross.segment2_connects_reversed

@[simp] theorem orientedSegment1_vertexSet :
    Cross.orientedSegment1.vertexSet = Cross.segment1.vertexSet := by
  simp [orientedSegment1]

@[simp] theorem orientedSegment1_edgeSet :
    Cross.orientedSegment1.edgeSet = Cross.segment1.edgeSet := by
  simp [orientedSegment1]

@[simp] theorem orientedSegment1_source :
    Cross.orientedSegment1.source = Cross.s1 :=
  orientBetween.source

@[simp] theorem orientedSegment1_target :
    Cross.orientedSegment1.target = Cross.t1 :=
  orientBetween.target

@[simp] theorem orientedSegment2_vertexSet :
    Cross.orientedSegment2.vertexSet = Cross.segment2.vertexSet := by
  simp [orientedSegment2]

@[simp] theorem orientedSegment2_edgeSet :
    Cross.orientedSegment2.edgeSet = Cross.segment2.edgeSet := by
  simp [orientedSegment2]

@[simp] theorem orientedSegment2_source :
    Cross.orientedSegment2.source = Cross.t2 :=
  orientBetween.source

@[simp] theorem orientedSegment2_target :
    Cross.orientedSegment2.target = Cross.s2 :=
  orientBetween.target

/-- The left deleted row interval `P_j'[s₁,s₂]`. -/
noncomputable def deletedLeftMiddle : GraphPath G :=
  (I.rowPath Cross.rowLeft).segmentOfBefore Cross.s1_before_s2

/-- The right deleted row interval `P_{j+1}'[t₂,t₁]`. -/
noncomputable def deletedRightMiddle : GraphPath G :=
  (I.rowPath Cross.rowRight).segmentOfBefore Cross.t2_before_t1

@[simp] theorem deletedLeftMiddle_source :
    Cross.deletedLeftMiddle.source = Cross.s1 := rfl

@[simp] theorem deletedLeftMiddle_target :
    Cross.deletedLeftMiddle.target = Cross.s2 := rfl

@[simp] theorem deletedRightMiddle_source :
    Cross.deletedRightMiddle.source = Cross.t2 := rfl

@[simp] theorem deletedRightMiddle_target :
    Cross.deletedRightMiddle.target = Cross.t1 := rfl

theorem deletedLeftMiddle_edgeSet_subset_row :
    Cross.deletedLeftMiddle.edgeSet ⊆ (I.rowPath Cross.rowLeft).edgeSet :=
  (I.rowPath Cross.rowLeft).segmentOfBefore_edgeSet_subset
    Cross.s1_before_s2

theorem deletedRightMiddle_edgeSet_subset_row :
    Cross.deletedRightMiddle.edgeSet ⊆ (I.rowPath Cross.rowRight).edgeSet :=
  (I.rowPath Cross.rowRight).segmentOfBefore_edgeSet_subset
    Cross.t2_before_t1

/-- The first oriented cross segment still lies on its fixed `Q*`. -/
theorem orientedSegment1_subset_qstar :
    Cross.orientedSegment1.vertexSet ⊆
      (Q0.data Cross.qIndex1 Cross.q_mem1).qstar.vertexSet := by
  intro v hv
  exact Cross.segment1_subset_qstar (by simpa using hv)

theorem orientedSegment1_edgeSet_subset_qstar :
    Cross.orientedSegment1.edgeSet ⊆
      (Q0.data Cross.qIndex1 Cross.q_mem1).qstar.edgeSet := by
  intro e he
  exact Cross.segment1_edgeSet_subset_qstar (by simpa using he)

/-- The endpoint `s₁` lies on the owning fixed `Q*` path of the first cross
segment. -/
theorem s1_mem_qstar1 :
    Cross.s1 ∈ (Q0.data Cross.qIndex1 Cross.q_mem1).qstar.vertexSet :=
