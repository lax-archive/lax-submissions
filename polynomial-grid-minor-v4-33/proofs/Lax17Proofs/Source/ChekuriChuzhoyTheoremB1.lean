theorem orientedSegment1_clean_rows :
    Cross.orientedSegment1.InternallyDisjointFromSet I.rowVertexSet := by
  intro v hv hrow
  have hv' : v ∈ Cross.segment1.vertexSet := by
    simpa [Cross.orientedSegment1_vertexSet] using hv
  have hend := Cross.segment1_clean_rows hv' hrow
  change (Cross.segment1.orient Cross.segment1_connects).IsEndpoint v
  exact (GraphPath.orient_isEndpoint Cross.segment1
    Cross.segment1_connects).2 hend

theorem orientedSegment2_clean_rows :
    Cross.orientedSegment2.InternallyDisjointFromSet I.rowVertexSet := by
  intro v hv hrow
  have hv' : v ∈ Cross.segment2.vertexSet := by
    simpa [Cross.orientedSegment2_vertexSet] using hv
  have hend := Cross.segment2_clean_rows hv' hrow
  change (Cross.segment2.orient Cross.segment2_connects_reversed).IsEndpoint v
  exact (GraphPath.orient_isEndpoint Cross.segment2
    Cross.segment2_connects_reversed).2 hend

/-- Reorienting the first cross segment preserves cleanliness with respect to
the whole current linkage. -/
theorem orientedSegment1_clean_linkage :
    Cross.orientedSegment1.InternallyDisjointFromSet
      I.linkage.toPathPacking.vertexSet := by
  intro v hv hlink
  have hv' : v ∈ Cross.segment1.vertexSet := by
    simpa [Cross.orientedSegment1_vertexSet] using hv
  have hend := Cross.segment1_clean_linkage hv' hlink
  change (Cross.segment1.orient Cross.segment1_connects).IsEndpoint v
  exact (GraphPath.orient_isEndpoint Cross.segment1
    Cross.segment1_connects).2 hend

/-- Reorienting the second cross segment preserves cleanliness with respect to
the whole current linkage. -/
theorem orientedSegment2_clean_linkage :
    Cross.orientedSegment2.InternallyDisjointFromSet
      I.linkage.toPathPacking.vertexSet := by
  intro v hv hlink
  have hv' : v ∈ Cross.segment2.vertexSet := by
    simpa [Cross.orientedSegment2_vertexSet] using hv
  have hend := Cross.segment2_clean_linkage hv' hlink
  change (Cross.segment2.orient Cross.segment2_connects_reversed).IsEndpoint v
  exact (GraphPath.orient_isEndpoint Cross.segment2
    Cross.segment2_connects_reversed).2 hend

/-- Reorienting the two cross segments preserves their vertex-disjointness. -/
theorem orientedSegments_nodeDisjoint :
    Cross.orientedSegment1.NodeDisjoint Cross.orientedSegment2 := by
  rw [GraphPath.NodeDisjoint]
  simpa [Cross.orientedSegment1_vertexSet, Cross.orientedSegment2_vertexSet]
    using Cross.segments_nodeDisjoint

/-- The two oriented cross segments are edge-disjoint. -/
theorem orientedSegments_edgeDisjoint :
    Cross.orientedSegment1.EdgeDisjoint Cross.orientedSegment2 :=
  graphPath_edgeDisjoint_of_nodeDisjoint Cross.orientedSegments_nodeDisjoint

/-- The current row family contains the left row. -/
theorem left_row_vertexSet_subset_rowVertexSet :
    (I.rowPath Cross.rowLeft).vertexSet ⊆ I.rowVertexSet := by
  classical
  intro v hv
  exact Finset.mem_biUnion.mpr
    ⟨Cross.rowLeft, Finset.mem_univ _, hv⟩

/-- The current row family contains the right row. -/
theorem right_row_vertexSet_subset_rowVertexSet :
    (I.rowPath Cross.rowRight).vertexSet ⊆ I.rowVertexSet := by
  classical
  intro v hv
  exact Finset.mem_biUnion.mpr
    ⟨Cross.rowRight, Finset.mem_univ _, hv⟩

theorem left_right_rows_disjoint {v : V}
    (hvleft : v ∈ (I.rowPath Cross.rowLeft).vertexSet)
    (hvright : v ∈ (I.rowPath Cross.rowRight).vertexSet) :
    False :=
  Finset.disjoint_left.mp Cross.rows_nodeDisjoint hvleft hvright

theorem t1_not_mem_left_row : Cross.t1 ∉ (I.rowPath Cross.rowLeft).vertexSet := by
  intro ht
  exact Cross.left_right_rows_disjoint ht Cross.t1_mem_right

theorem t2_not_mem_left_row : Cross.t2 ∉ (I.rowPath Cross.rowLeft).vertexSet := by
  intro ht
  exact Cross.left_right_rows_disjoint ht Cross.t2_mem_right

theorem s1_not_mem_right_row : Cross.s1 ∉ (I.rowPath Cross.rowRight).vertexSet := by
  intro hs
  exact Cross.left_right_rows_disjoint Cross.s1_mem_left hs

theorem s2_not_mem_right_row : Cross.s2 ∉ (I.rowPath Cross.rowRight).vertexSet := by
  intro hs
  exact Cross.left_right_rows_disjoint Cross.s2_mem_left hs

end CrossWitness

/-- Finite-graph core of the nonterminating cross branch.

The local block is ordered as `A -- U -- V -- D`; in the actual cross proof,
`U,V` are the two replacement rows in whichever order the successor
degree-two path chooses.  If every changed edge is supported inside this
quadruple, the three consecutive adjacencies hold before and after the cross,
and all local vertices remain degree two, then no skip edge can appear inside
the quadruple.  Hence the two auxiliary graphs have the same adjacency
relation under this chosen local order. -/
theorem cross_local_adj_iff_of_supported_degree_two
    {α : Type*} [DecidableEq α]
    {H H' : _root_.SimpleGraph α} {L A U V D R : α}
    (hsupport : AdjChangeSupportedIn H H' ({A, U, V, D} : Finset α))
    (hLA_old : H.Adj A L) (hAU_old : H.Adj A U)
    (hUV_old : H.Adj U V) (hVD_old : H.Adj V D)
    (hDR_old : H.Adj D R)
    (hAU_new : H'.Adj A U) (hUV_new : H'.Adj U V)
    (hVD_new : H'.Adj V D)
    (hA_old : DegreeEquals H A 2) (hU_old : DegreeEquals H U 2)
    (hV_old : DegreeEquals H V 2) (hD_old : DegreeEquals H D 2)
    (hA_new : DegreeEquals H' A 2) (hU_new : DegreeEquals H' U 2)
    (hV_new : DegreeEquals H' V 2) (hD_new : DegreeEquals H' D 2)
    (hL_not : L ∉ ({A, U, V, D} : Finset α))
    (hR_not : R ∉ ({A, U, V, D} : Finset α))
    (hLU : L ≠ U) (hRV : R ≠ V)
    (hAU_ne : A ≠ U) (hAD : A ≠ D) (hUD : U ≠ D)
    (hAV : A ≠ V) (hDV : D ≠ V) (hLD : L ≠ D) :
    ∀ u v : α, H'.Adj u v ↔ H.Adj u v := by
  classical
  let S : Finset α := {A, U, V, D}
  have hLA_new : H'.Adj A L :=
    (hsupport (u := A) (v := L) (Or.inr hL_not)).2 hLA_old
  have hDR_new : H'.Adj D R :=
    (hsupport (u := D) (v := R) (Or.inr hR_not)).2 hDR_old
  have hold_skip :
      ¬ H.Adj A V ∧ ¬ H.Adj A D ∧ ¬ H.Adj U D :=
    DegreeEquals.cross_four_no_skip hAU_old hUV_old hVD_old
      hU_old hV_old hA_old hD_old hLA_old hDR_old hLU hRV
      hAU_ne hAD hUD hAV hDV hLD
  have hnew_skip :
      ¬ H'.Adj A V ∧ ¬ H'.Adj A D ∧ ¬ H'.Adj U D :=
    DegreeEquals.cross_four_no_skip hAU_new hUV_new hVD_new
      hU_new hV_new hA_new hD_new hLA_new hDR_new hLU hRV
      hAU_ne hAD hUD hAV hDV hLD
  intro x y
  by_cases hx : x ∈ S
  · by_cases hy : y ∈ S
    · simp [S] at hx hy
      rcases hx with rfl | rfl | rfl | rfl
      · rcases hy with rfl | rfl | rfl | rfl
        · simp
        · exact ⟨fun _ => hAU_old, fun _ => hAU_new⟩
        · exact ⟨fun h => False.elim (hnew_skip.1 h),
            fun h => False.elim (hold_skip.1 h)⟩
        · exact ⟨fun h => False.elim (hnew_skip.2.1 h),
            fun h => False.elim (hold_skip.2.1 h)⟩
      · rcases hy with rfl | rfl | rfl | rfl
        · exact ⟨fun _ => H.symm hAU_old, fun _ => H'.symm hAU_new⟩
        · simp
        · exact ⟨fun _ => hUV_old, fun _ => hUV_new⟩
        · exact ⟨fun h => False.elim (hnew_skip.2.2 h),
            fun h => False.elim (hold_skip.2.2 h)⟩
      · rcases hy with rfl | rfl | rfl | rfl
        · exact ⟨fun h => False.elim (hnew_skip.1 (H'.symm h)),
            fun h => False.elim (hold_skip.1 (H.symm h))⟩
        · exact ⟨fun _ => H.symm hUV_old, fun _ => H'.symm hUV_new⟩
        · simp
        · exact ⟨fun _ => hVD_old, fun _ => hVD_new⟩
      · rcases hy with rfl | rfl | rfl | rfl
        · exact ⟨fun h => False.elim (hnew_skip.2.1 (H'.symm h)),
            fun h => False.elim (hold_skip.2.1 (H.symm h))⟩
        · exact ⟨fun h => False.elim (hnew_skip.2.2 (H'.symm h)),
            fun h => False.elim (hold_skip.2.2 (H.symm h))⟩
        · exact ⟨fun _ => H.symm hVD_old, fun _ => H'.symm hVD_new⟩
        · simp
    · exact hsupport (Or.inr hy)
  · exact hsupport (Or.inl hx)

/-- Switched finite-graph core of the nonterminating cross branch.

The old local block is ordered as `A -- U -- V -- D`, while the successor
block is ordered as `A -- V -- U -- D`.  Under the same locality and
degree-two hypotheses as `cross_local_adj_iff_of_supported_degree_two`, the
successor adjacency relation is the old adjacency relation after transposing
the two crossed vertices `U,V`. -/
theorem cross_local_adj_swap_iff_of_supported_degree_two
    {α : Type*} [DecidableEq α]
    {H H' : _root_.SimpleGraph α} {L A U V D R : α}
    (hsupport : AdjChangeSupportedIn H H' ({A, U, V, D} : Finset α))
    (hLA_old : H.Adj A L) (hAU_old : H.Adj A U)
    (hUV_old : H.Adj U V) (hVD_old : H.Adj V D)
    (hDR_old : H.Adj D R)
    (hAV_new : H'.Adj A V) (hVU_new : H'.Adj V U)
    (hUD_new : H'.Adj U D)
    (hA_old : DegreeEquals H A 2) (hU_old : DegreeEquals H U 2)
    (hV_old : DegreeEquals H V 2) (hD_old : DegreeEquals H D 2)
    (hA_new : DegreeEquals H' A 2) (hU_new : DegreeEquals H' U 2)
    (hV_new : DegreeEquals H' V 2) (hD_new : DegreeEquals H' D 2)
    (hL_not : L ∉ ({A, U, V, D} : Finset α))
    (hR_not : R ∉ ({A, U, V, D} : Finset α))
    (hLU : L ≠ U) (hRV : R ≠ V)
    (hAU_ne : A ≠ U) (hAD : A ≠ D) (hUD : U ≠ D)
    (hAV : A ≠ V) (hDV : D ≠ V) (hLD : L ≠ D) :
    ∀ x y : α,
      H'.Adj x y ↔
        H.Adj ((Equiv.swap U V) x) ((Equiv.swap U V) y) := by
  classical
  let S : Finset α := {A, U, V, D}
  let sw : α ≃ α := Equiv.swap U V
  have hLA_new : H'.Adj A L :=
    (hsupport (u := A) (v := L) (Or.inr hL_not)).2 hLA_old
  have hDR_new : H'.Adj D R :=
    (hsupport (u := D) (v := R) (Or.inr hR_not)).2 hDR_old
  have hLV : L ≠ V := by
    intro h
    exact hL_not (by simp [h])
  have hRU : R ≠ U := by
    intro h
    exact hR_not (by simp [h])
  have hold_skip :
      ¬ H.Adj A V ∧ ¬ H.Adj A D ∧ ¬ H.Adj U D :=
    DegreeEquals.cross_four_no_skip hAU_old hUV_old hVD_old
      hU_old hV_old hA_old hD_old hLA_old hDR_old hLU hRV
      hAU_ne hAD hUD hAV hDV hLD
  have hnew_skip :
      ¬ H'.Adj A U ∧ ¬ H'.Adj A D ∧ ¬ H'.Adj V D :=
    DegreeEquals.cross_four_no_skip hAV_new hVU_new hUD_new
      hV_new hU_new hA_new hD_new hLA_new hDR_new hLV hRU
      hAV hAD (by exact hDV.symm) hAU_ne (by exact hUD.symm) hLD
  have hswap_old_left :
      ∀ {x y : α}, x ∉ S →
        (H.Adj x y ↔ H.Adj (sw x) (sw y)) := by
    intro x y hx
    have hxA : x ≠ A := by
      intro h
      exact hx (by simp [S, h])
    have hxU : x ≠ U := by
      intro h
      exact hx (by simp [S, h])
    have hxV : x ≠ V := by
      intro h
      exact hx (by simp [S, h])
    have hxD : x ≠ D := by
      intro h
      exact hx (by simp [S, h])
    have hswx : sw x = x := by
      simp [sw, Equiv.swap_apply_of_ne_of_ne hxU hxV]
    by_cases hy : y ∈ S
    · have hy_cases : y = A ∨ y = U ∨ y = V ∨ y = D := by
        simpa [S] using hy
      rcases hy_cases with hyA | hyU | hyV | hyD
      · subst y
        have hswA : sw A = A := by
          simp [sw, Equiv.swap_apply_of_ne_of_ne hAU_ne hAV]
        rw [hswx, hswA]
      · subst y
        have hnot_xU : ¬ H.Adj x U := by
          intro hxu
          have hUx : H.Adj U x := H.symm hxu
          rcases DegreeEquals.two_adj_eq_or_eq hU_old
              (H.symm hAU_old) hUV_old hAV hUx with hx_eq_A | hx_eq_V
          · exact hxA hx_eq_A
          · exact hxV hx_eq_V
        have hnot_xV : ¬ H.Adj x V := by
          intro hxv
          have hVx : H.Adj V x := H.symm hxv
          rcases DegreeEquals.two_adj_eq_or_eq hV_old
              (H.symm hUV_old) hVD_old hUD hVx with hx_eq_U | hx_eq_D
          · exact hxU hx_eq_U
          · exact hxD hx_eq_D
        constructor
        · intro h
          exact False.elim (hnot_xU h)
        · intro h
          exact False.elim (hnot_xV (by simpa [sw, hswx] using h))
      · subst y
        have hnot_xU : ¬ H.Adj x U := by
          intro hxu
          have hUx : H.Adj U x := H.symm hxu
          rcases DegreeEquals.two_adj_eq_or_eq hU_old
              (H.symm hAU_old) hUV_old hAV hUx with hx_eq_A | hx_eq_V
          · exact hxA hx_eq_A
          · exact hxV hx_eq_V
        have hnot_xV : ¬ H.Adj x V := by
          intro hxv
          have hVx : H.Adj V x := H.symm hxv
          rcases DegreeEquals.two_adj_eq_or_eq hV_old
              (H.symm hUV_old) hVD_old hUD hVx with hx_eq_U | hx_eq_D
          · exact hxU hx_eq_U
          · exact hxD hx_eq_D
        constructor
        · intro h
          exact False.elim (hnot_xV h)
        · intro h
          exact False.elim (hnot_xU (by simpa [sw, hswx] using h))
      · subst y
        have hswD : sw D = D := by
          simp [sw, Equiv.swap_apply_of_ne_of_ne hUD.symm hDV]
        rw [hswx, hswD]
    · have hyU : y ≠ U := by
        intro h
        exact hy (by simp [S, h])
      have hyV : y ≠ V := by
        intro h
        exact hy (by simp [S, h])
      have hswy : sw y = y := by
        simp [sw, Equiv.swap_apply_of_ne_of_ne hyU hyV]
      rw [hswx, hswy]
  have hswap_old_nonlocal :
      ∀ {x y : α}, x ∉ S ∨ y ∉ S →
        (H.Adj x y ↔ H.Adj (sw x) (sw y)) := by
    intro x y hnon
    rcases hnon with hx | hy
    · exact hswap_old_left hx
    · have hsym := hswap_old_left (x := y) (y := x) hy
      constructor
      · intro hxy
        exact H.symm (hsym.1 (H.symm hxy))
      · intro hswxy
        exact H.symm (hsym.2 (H.symm hswxy))
  have hswapA : (Equiv.swap U V) A = A := by
    rw [Equiv.swap_apply_of_ne_of_ne hAU_ne hAV]
  have hswapD : (Equiv.swap U V) D = D := by
    rw [Equiv.swap_apply_of_ne_of_ne hUD.symm hDV]
  intro x y
  by_cases hx : x ∈ S
  · by_cases hy : y ∈ S
    · have hx_cases : x = A ∨ x = U ∨ x = V ∨ x = D := by
        simpa [S] using hx
      have hy_cases : y = A ∨ y = U ∨ y = V ∨ y = D := by
        simpa [S] using hy
      rcases hx_cases with hxA | hxU | hxV | hxD
      · subst x
        rcases hy_cases with hyA | hyU | hyV | hyD
        · subst y
          simp [hswapA]
        · subst y
          constructor
          · intro h
            exact False.elim (hnew_skip.1 h)
          · intro h
            exact False.elim (hold_skip.1 (by simpa [hswapA] using h))
        · subst y
          exact ⟨fun _ => by simpa [hswapA] using hAU_old,
            fun _ => hAV_new⟩
        · subst y
          constructor
          · intro h
            exact False.elim (hnew_skip.2.1 h)
          · intro h
            exact False.elim (hold_skip.2.1 (by
              simpa [hswapA, hswapD] using h))
      · subst x
        rcases hy_cases with hyA | hyU | hyV | hyD
        · subst y
          constructor
          · intro h
            exact False.elim (hnew_skip.1 (H'.symm h))
          · intro h
            exact False.elim (hold_skip.1 (by
              simpa [hswapA] using H.symm h))
        · subst y
          simp
        · subst y
          exact ⟨fun _ => by simpa [sw] using H.symm hUV_old,
            fun _ => H'.symm hVU_new⟩
        · subst y
          exact ⟨fun _ => by simpa [hswapD] using hVD_old,
            fun _ => hUD_new⟩
      · subst x
        rcases hy_cases with hyA | hyU | hyV | hyD
        · subst y
          exact ⟨fun _ => by simpa [hswapA] using H.symm hAU_old,
            fun _ => H'.symm hAV_new⟩
        · subst y
          exact ⟨fun _ => by simpa [sw] using hUV_old,
            fun _ => hVU_new⟩
        · subst y
          simp
        · subst y
          constructor
          · intro h
            exact False.elim (hnew_skip.2.2 h)
          · intro h
            exact False.elim (hold_skip.2.2 (by
              simpa [hswapD] using h))
      · subst x
        rcases hy_cases with hyA | hyU | hyV | hyD
        · subst y
          constructor
          · intro h
            exact False.elim (hnew_skip.2.1 (H'.symm h))
          · intro h
            exact False.elim (hold_skip.2.1 (by
              simpa [hswapA, hswapD] using H.symm h))
        · subst y
          exact ⟨fun _ => by simpa [hswapD] using H.symm hVD_old,
            fun _ => H'.symm hUD_new⟩
        · subst y
          constructor
          · intro h
            exact False.elim (hnew_skip.2.2 (H'.symm h))
          · intro h
            exact False.elim (hold_skip.2.2 (by
              simpa [hswapD] using H.symm h))
        · subst y
          simp [hswapD]
    · exact (hsupport (Or.inr hy)).trans
        (hswap_old_nonlocal (Or.inr hy))
  · exact (hsupport (Or.inl hx)).trans
      (hswap_old_nonlocal (Or.inl hx))

/-- The finite-graph dichotomy used in the cross paragraph.

If a cross changes only the local quadruple, then either one of the four
formerly degree-two local vertices stops being degree two, giving a strict
drop in the number of degree-two vertices, or all four local degrees remain
two and the auxiliary graph is unchanged under the chosen successor order
`A -- U -- V -- D`. -/
theorem cross_supported_degree_drop_or_aux_adj_iff
    {α : Type*} [Fintype α] [DecidableEq α]
    (H H' : _root_.SimpleGraph α) (L A U V D R : α)
    (hsupport : AdjChangeSupportedIn H H' ({A, U, V, D} : Finset α))
    (hLA_old : H.Adj A L) (hAU_old : H.Adj A U)
    (hUV_old : H.Adj U V) (hVD_old : H.Adj V D)
    (hDR_old : H.Adj D R)
    (hAU_new : H'.Adj A U) (hUV_new : H'.Adj U V)
    (hVD_new : H'.Adj V D)
    (hA_old : DegreeEquals H A 2) (hU_old : DegreeEquals H U 2)
    (hV_old : DegreeEquals H V 2) (hD_old : DegreeEquals H D 2)
    (hL_not : L ∉ ({A, U, V, D} : Finset α))
    (hR_not : R ∉ ({A, U, V, D} : Finset α))
    (hLU : L ≠ U) (hRV : R ≠ V)
    (hAU_ne : A ≠ U) (hAD : A ≠ D) (hUD : U ≠ D)
    (hAV : A ≠ V) (hDV : D ≠ V) (hLD : L ≠ D) :
    degreeTwoVertexCount H' < degreeTwoVertexCount H ∨
      ∀ u v : α, H'.Adj u v ↔ H.Adj u v := by
  classical
  let S : Finset α := {A, U, V, D}
  have hlocal_old : ∀ x : α, x ∈ S → DegreeEquals H x 2 := by
    intro x hx
    simp [S] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · exact hA_old
    · exact hU_old
    · exact hV_old
    · exact hD_old
  by_cases hA_new : DegreeEquals H' A 2
  · by_cases hU_new : DegreeEquals H' U 2
    · by_cases hV_new : DegreeEquals H' V 2
      · by_cases hD_new : DegreeEquals H' D 2
        · exact Or.inr
            (cross_local_adj_iff_of_supported_degree_two
              (H := H) (H' := H') (L := L) (A := A) (U := U)
              (V := V) (D := D) (R := R)
              hsupport hLA_old hAU_old hUV_old hVD_old hDR_old
              hAU_new hUV_new hVD_new hA_old hU_old hV_old hD_old
              hA_new hU_new hV_new hD_new hL_not hR_not hLU hRV
              hAU_ne hAD hUD hAV hDV hLD)
        · exact Or.inl
            (degreeTwoVertexCount_lt_of_supported_local_drop H H' S
              (by simpa [S] using hsupport) hlocal_old
              ⟨D, by simp [S], hD_new⟩)
      · exact Or.inl
          (degreeTwoVertexCount_lt_of_supported_local_drop H H' S
            (by simpa [S] using hsupport) hlocal_old
            ⟨V, by simp [S], hV_new⟩)
    · exact Or.inl
        (degreeTwoVertexCount_lt_of_supported_local_drop H H' S
          (by simpa [S] using hsupport) hlocal_old
          ⟨U, by simp [S], hU_new⟩)
  · exact Or.inl
      (degreeTwoVertexCount_lt_of_supported_local_drop H H' S
        (by simpa [S] using hsupport) hlocal_old
        ⟨A, by simp [S], hA_new⟩)

/-- Degree-two dispatch for the nonterminating Figure 8 branch.

Once the two replacement rows `U,V` are adjacent, degree two prevents the two
outside endpoints `A,D` from attaching to the same replacement row.  Thus the
local successor block is either `A -- U -- V -- D` or `A -- V -- U -- D`. -/
theorem cross_attachment_order_of_degree_two
    {α : Type*} [DecidableEq α] {H : _root_.SimpleGraph α}
    {A U V D : α}
    (hUV : H.Adj U V)
    (hU : DegreeEquals H U 2) (hV : DegreeEquals H V 2)
    (hA_attach : H.Adj A U ∨ H.Adj A V)
    (hD_attach : H.Adj D U ∨ H.Adj D V)
    (hAU_ne : A ≠ U) (hAV_ne : A ≠ V)
    (hUD_ne : U ≠ D) (hDV_ne : D ≠ V) (hAD_ne : A ≠ D) :
    (H.Adj A U ∧ H.Adj V D) ∨
      (H.Adj A V ∧ H.Adj U D) := by
  rcases hA_attach with hAU | hAV
  · rcases hD_attach with hDU | hDV
    · exfalso
      have hUD : H.Adj U D := H.symm hDU
      rcases DegreeEquals.two_adj_eq_or_eq hU (H.symm hAU) hUV
          hAV_ne hUD with hD_eq_A | hD_eq_V
      · exact hAD_ne hD_eq_A.symm
      · exact hDV_ne hD_eq_V
    · exact Or.inl ⟨hAU, H.symm hDV⟩
  · rcases hD_attach with hDU | hDV
    · exact Or.inr ⟨hAV, H.symm hDU⟩
    · exfalso
      have hVD : H.Adj V D := H.symm hDV
      rcases DegreeEquals.two_adj_eq_or_eq hV (H.symm hUV) (H.symm hAV)
          (by exact hAU_ne.symm) hVD with hD_eq_U | hD_eq_A
      · exact hUD_ne hD_eq_U.symm
      · exact hAD_ne hD_eq_A.symm

/-- The two switched paths produced by a cross.

`leftPath` is
`P_j'[a_j,s₁] ++ Q₁'[s₁,t₁] ++ P_{j+1}'[t₁,b_{j+1}]`, while `rightPath`
is
`P_{j+1}'[a_{j+1},t₂] ++ Q₂'[t₂,s₂] ++ P_j'[s₂,b_j]`. -/
structure CrossReplacementPaths {I : IterationInput R hpos Q0}
    (Cross : CrossWitness I) where
  leftPath : GraphPath G
  rightPath : GraphPath G
  left_source_eq : leftPath.source = (I.rowPath Cross.rowLeft).source
  left_target_eq : leftPath.target = (I.rowPath Cross.rowRight).target
  right_source_eq : rightPath.source = (I.rowPath Cross.rowRight).source
  right_target_eq : rightPath.target = (I.rowPath Cross.rowLeft).target
  s1_mem_leftPath : Cross.s1 ∈ leftPath.vertexSet
  t1_mem_leftPath : Cross.t1 ∈ leftPath.vertexSet
  t2_mem_rightPath : Cross.t2 ∈ rightPath.vertexSet
  s2_mem_rightPath : Cross.s2 ∈ rightPath.vertexSet
  left_prefix_subset_leftPath :
    ((I.rowPath Cross.rowLeft).takeUntil Cross.s1_mem_left).vertexSet ⊆
      leftPath.vertexSet
  segment1_subset_leftPath :
    Cross.orientedSegment1.vertexSet ⊆ leftPath.vertexSet
  right_suffix_subset_leftPath :
    ((I.rowPath Cross.rowRight).dropUntil Cross.t1_mem_right).vertexSet ⊆
      leftPath.vertexSet
  right_prefix_subset_rightPath :
    ((I.rowPath Cross.rowRight).takeUntil Cross.t2_mem_right).vertexSet ⊆
      rightPath.vertexSet
  segment2_subset_rightPath :
    Cross.orientedSegment2.vertexSet ⊆ rightPath.vertexSet
  left_suffix_subset_rightPath :
    ((I.rowPath Cross.rowLeft).dropUntil Cross.s2_mem_left).vertexSet ⊆
      rightPath.vertexSet
  left_vertexSet_subset_parts :
    leftPath.vertexSet ⊆
      (((I.rowPath Cross.rowLeft).takeUntil Cross.s1_mem_left).vertexSet ∪
          Cross.segment1.vertexSet) ∪
        ((I.rowPath Cross.rowRight).dropUntil Cross.t1_mem_right).vertexSet
  right_vertexSet_subset_parts :
    rightPath.vertexSet ⊆
      (((I.rowPath Cross.rowRight).takeUntil Cross.t2_mem_right).vertexSet ∪
          Cross.segment2.vertexSet) ∪
        ((I.rowPath Cross.rowLeft).dropUntil Cross.s2_mem_left).vertexSet
  left_vertexSet_subset :
    leftPath.vertexSet ⊆
      ((I.rowPath Cross.rowLeft).vertexSet ∪ Cross.segment1.vertexSet) ∪
        (I.rowPath Cross.rowRight).vertexSet
  right_vertexSet_subset :
    rightPath.vertexSet ⊆
      ((I.rowPath Cross.rowRight).vertexSet ∪ Cross.segment2.vertexSet) ∪
        (I.rowPath Cross.rowLeft).vertexSet
  left_edgeSet_subset :
    leftPath.edgeSet ⊆
      ((I.rowPath Cross.rowLeft).edgeSet ∪ Cross.segment1.edgeSet) ∪
        (I.rowPath Cross.rowRight).edgeSet
  right_edgeSet_subset :
    rightPath.edgeSet ⊆
      ((I.rowPath Cross.rowRight).edgeSet ∪ Cross.segment2.edgeSet) ∪
        (I.rowPath Cross.rowLeft).edgeSet

namespace CrossReplacementPaths

variable {I : IterationInput R hpos Q0} {Cross : CrossWitness I}

theorem leftConnectsAB (P' : CrossReplacementPaths Cross)
    (hrows : I.RowsConnectAB) :
    P'.leftPath.Connects A B :=
  Or.inl ⟨by
      rw [P'.left_source_eq]
      exact (hrows Cross.rowLeft).1,
    by
      rw [P'.left_target_eq]
      exact (hrows Cross.rowRight).2⟩

theorem rightConnectsAB (P' : CrossReplacementPaths Cross)
    (hrows : I.RowsConnectAB) :
    P'.rightPath.Connects A B :=
  Or.inl ⟨by
      rw [P'.right_source_eq]
      exact (hrows Cross.rowRight).1,
    by
      rw [P'.right_target_eq]
      exact (hrows Cross.rowLeft).2⟩

end CrossReplacementPaths

namespace CrossWitness

variable {I : IterationInput R hpos Q0} (Cross : CrossWitness I)

/-- Reverse a bridge between two indexed paths.  The auxiliary graph is
undirected, and this helper lets locality arguments orient a bridge from
whichever endpoint is currently being analyzed. -/
noncomputable def reverseBridge
    {P : PathPacking G A B} {i j : P.Index}
    (β : P.BridgeBetween i j) : P.BridgeBetween j i where
  path := β.path.reverse
  connects := by
    rcases β.connects with h | h
    · exact Or.inl ⟨by simpa using h.2, by simpa using h.1⟩
    · exact Or.inr ⟨by simpa using h.2, by simpa using h.1⟩
  internallyDisjoint := by
    exact (β.path.reverse_internallyDisjointFromSet P.vertexSet).2
      β.internallyDisjoint

theorem s2_not_mem_left_prefix :
    Cross.s2 ∉
      ((I.rowPath Cross.rowLeft).takeUntil Cross.s1_mem_left).vertexSet := by
  intro hs2
  have hs2_before_s1 :
      (I.rowPath Cross.rowLeft).Before Cross.s2 Cross.s1 :=
    (I.rowPath Cross.rowLeft).before_of_mem_takeUntil
      Cross.s1_mem_left hs2
  have heq :
      Cross.s2 = Cross.s1 :=
    (I.rowPath Cross.rowLeft).before_antisymm
      hs2_before_s1 Cross.s1_before_s2
  exact Cross.s1_ne_s2 heq.symm

theorem s1_not_mem_left_suffix :
    Cross.s1 ∉
      ((I.rowPath Cross.rowLeft).dropUntil Cross.s2_mem_left).vertexSet := by
  intro hs1
  have hs2_before_s1 :
      (I.rowPath Cross.rowLeft).Before Cross.s2 Cross.s1 :=
    ⟨Cross.s2_mem_left, hs1⟩
  have heq :
      Cross.s1 = Cross.s2 :=
    (I.rowPath Cross.rowLeft).before_antisymm
      Cross.s1_before_s2 hs2_before_s1
  exact Cross.s1_ne_s2 heq

theorem t1_not_mem_right_prefix :
    Cross.t1 ∉
      ((I.rowPath Cross.rowRight).takeUntil Cross.t2_mem_right).vertexSet := by
  intro ht1
  have ht1_before_t2 :
      (I.rowPath Cross.rowRight).Before Cross.t1 Cross.t2 :=
    (I.rowPath Cross.rowRight).before_of_mem_takeUntil
      Cross.t2_mem_right ht1
  have heq :
      Cross.t1 = Cross.t2 :=
    (I.rowPath Cross.rowRight).before_antisymm
      ht1_before_t2 Cross.t2_before_t1
  exact Cross.t2_ne_t1 heq.symm

theorem t2_not_mem_right_suffix :
    Cross.t2 ∉
      ((I.rowPath Cross.rowRight).dropUntil Cross.t1_mem_right).vertexSet := by
  intro ht2
  have ht1_before_t2 :
      (I.rowPath Cross.rowRight).Before Cross.t1 Cross.t2 :=
    ⟨Cross.t1_mem_right, ht2⟩
  have heq :
      Cross.t2 = Cross.t1 :=
    (I.rowPath Cross.rowRight).before_antisymm
      Cross.t2_before_t1 ht1_before_t2
  exact Cross.t2_ne_t1 heq

theorem left_prefix_disjoint_suffix :
    Disjoint
      ((I.rowPath Cross.rowLeft).takeUntil Cross.s1_mem_left).vertexSet
      ((I.rowPath Cross.rowLeft).dropUntil Cross.s2_mem_left).vertexSet := by
  rw [Finset.disjoint_left]
  intro v hvpre hvsuf
  have hv_before_s1 :
      (I.rowPath Cross.rowLeft).Before v Cross.s1 :=
    (I.rowPath Cross.rowLeft).before_of_mem_takeUntil
      Cross.s1_mem_left hvpre
  have hs2_before_v :
      (I.rowPath Cross.rowLeft).Before Cross.s2 v :=
    ⟨Cross.s2_mem_left, hvsuf⟩
  have hs2_before_s1 :
      (I.rowPath Cross.rowLeft).Before Cross.s2 Cross.s1 :=
    (I.rowPath Cross.rowLeft).before_trans hs2_before_v hv_before_s1
  have heq :
      Cross.s2 = Cross.s1 :=
    (I.rowPath Cross.rowLeft).before_antisymm
      hs2_before_s1 Cross.s1_before_s2
  exact Cross.s1_ne_s2 heq.symm

theorem right_prefix_disjoint_suffix :
    Disjoint
      ((I.rowPath Cross.rowRight).takeUntil Cross.t2_mem_right).vertexSet
      ((I.rowPath Cross.rowRight).dropUntil Cross.t1_mem_right).vertexSet := by
  rw [Finset.disjoint_left]
  intro v hvpre hvsuf
  have hv_before_t2 :
      (I.rowPath Cross.rowRight).Before v Cross.t2 :=
    (I.rowPath Cross.rowRight).before_of_mem_takeUntil
      Cross.t2_mem_right hvpre
  have ht1_before_v :
      (I.rowPath Cross.rowRight).Before Cross.t1 v :=
    ⟨Cross.t1_mem_right, hvsuf⟩
  have ht1_before_t2 :
      (I.rowPath Cross.rowRight).Before Cross.t1 Cross.t2 :=
    (I.rowPath Cross.rowRight).before_trans ht1_before_v hv_before_t2
  have heq :
      Cross.t1 = Cross.t2 :=
    (I.rowPath Cross.rowRight).before_antisymm
      ht1_before_t2 Cross.t2_before_t1
  exact Cross.t2_ne_t1 heq.symm

theorem left_prefix_inter_segment1_subset_s1 :
    ∀ ⦃v : V⦄,
      v ∈ ((I.rowPath Cross.rowLeft).takeUntil Cross.s1_mem_left).vertexSet →
      v ∈ Cross.orientedSegment1.vertexSet →
      v = ((I.rowPath Cross.rowLeft).takeUntil Cross.s1_mem_left).target := by
  intro v hvpre hvmid
  have hvrow :
      v ∈ (I.rowPath Cross.rowLeft).vertexSet :=
    (I.rowPath Cross.rowLeft).takeUntil_vertexSet_subset
      Cross.s1_mem_left hvpre
  have hend :=
    Cross.orientedSegment1_clean_rows hvmid
      (Cross.left_row_vertexSet_subset_rowVertexSet hvrow)
  rcases hend with hs1 | ht1
  · simpa using hs1
  · exfalso
    exact Cross.t1_not_mem_left_row (by simpa [ht1] using hvrow)

theorem right_prefix_inter_segment2_subset_t2 :
    ∀ ⦃v : V⦄,
      v ∈ ((I.rowPath Cross.rowRight).takeUntil Cross.t2_mem_right).vertexSet →
      v ∈ Cross.orientedSegment2.vertexSet →
      v = ((I.rowPath Cross.rowRight).takeUntil Cross.t2_mem_right).target := by
  intro v hvpre hvmid
  have hvrow :
      v ∈ (I.rowPath Cross.rowRight).vertexSet :=
    (I.rowPath Cross.rowRight).takeUntil_vertexSet_subset
      Cross.t2_mem_right hvpre
  have hend :=
    Cross.orientedSegment2_clean_rows hvmid
      (Cross.right_row_vertexSet_subset_rowVertexSet hvrow)
  rcases hend with ht2 | hs2
  · simpa using ht2
  · exfalso
    exact Cross.s2_not_mem_right_row (by simpa [hs2] using hvrow)

/-- The two switched paths of Figure 8. -/
noncomputable def replacementPaths : CrossReplacementPaths Cross := by
  classical
  let LRow : GraphPath G := I.rowPath Cross.rowLeft
  let RRow : GraphPath G := I.rowPath Cross.rowRight
  let lpre : GraphPath G := LRow.takeUntil Cross.s1_mem_left
  let lmid : GraphPath G := Cross.orientedSegment1
  let lsuf : GraphPath G := RRow.dropUntil Cross.t1_mem_right
  have hlpre_lmid_glue : lpre.target = lmid.source := by
    simp [lpre, lmid, LRow]
  have hlpre_lmid_inter :
      ∀ ⦃v : V⦄, v ∈ lpre.vertexSet → v ∈ lmid.vertexSet →
        v = lpre.target := by
    intro v hvpre hvmid
    simpa [lpre, lmid, LRow] using
      Cross.left_prefix_inter_segment1_subset_s1
        (v := v) (by simpa [lpre, LRow] using hvpre)
        (by simpa [lmid] using hvmid)
  let lpreMid : GraphPath G :=
    lpre.appendWithEqOfInterSubsetTarget lmid
      hlpre_lmid_glue hlpre_lmid_inter
  have hlpreMid_lsuf_glue : lpreMid.target = lsuf.source := by
    simp [lpreMid, lpre, lmid, lsuf, RRow]
  have hlpreMid_lsuf_inter :
      ∀ ⦃v : V⦄, v ∈ lpreMid.vertexSet → v ∈ lsuf.vertexSet →
        v = lpreMid.target := by
    intro v hvpm hvsuf
    have hvpm_union : v ∈ lpre.vertexSet ∪ lmid.vertexSet :=
      appendWithEqOfInterSubsetTarget_vertexSet_subset
        lpre lmid hlpre_lmid_glue hlpre_lmid_inter hvpm
    have hvright :
        v ∈ (I.rowPath Cross.rowRight).vertexSet :=
      (I.rowPath Cross.rowRight).dropUntil_vertexSet_subset
        Cross.t1_mem_right (by simpa [lsuf, RRow] using hvsuf)
    rcases Finset.mem_union.1 hvpm_union with hvpre | hvmid
    · have hvleft :
          v ∈ (I.rowPath Cross.rowLeft).vertexSet :=
        (I.rowPath Cross.rowLeft).takeUntil_vertexSet_subset
          Cross.s1_mem_left (by simpa [lpre, LRow] using hvpre)
      exact False.elim (Cross.left_right_rows_disjoint hvleft hvright)
    · have hend :=
        Cross.orientedSegment1_clean_rows
          (by simpa [lmid] using hvmid)
          (Cross.right_row_vertexSet_subset_rowVertexSet hvright)
      rcases hend with hs1 | ht1
      · exact False.elim (Cross.s1_not_mem_right_row (by
          simpa [hs1] using hvright))
      · simpa [lpreMid, lmid] using ht1
  let leftWhole : GraphPath G :=
    lpreMid.appendWithEqOfInterSubsetTarget lsuf
      hlpreMid_lsuf_glue hlpreMid_lsuf_inter
  let rpre : GraphPath G := RRow.takeUntil Cross.t2_mem_right
  let rmid : GraphPath G := Cross.orientedSegment2
  let rsuf : GraphPath G := LRow.dropUntil Cross.s2_mem_left
  have hrpre_rmid_glue : rpre.target = rmid.source := by
    simp [rpre, rmid, RRow]
  have hrpre_rmid_inter :
      ∀ ⦃v : V⦄, v ∈ rpre.vertexSet → v ∈ rmid.vertexSet →
        v = rpre.target := by
    intro v hvpre hvmid
    simpa [rpre, rmid, RRow] using
      Cross.right_prefix_inter_segment2_subset_t2
        (v := v) (by simpa [rpre, RRow] using hvpre)
        (by simpa [rmid] using hvmid)
  let rpreMid : GraphPath G :=
    rpre.appendWithEqOfInterSubsetTarget rmid
      hrpre_rmid_glue hrpre_rmid_inter
  have hrpreMid_rsuf_glue : rpreMid.target = rsuf.source := by
    simp [rpreMid, rpre, rmid, rsuf, LRow]
  have hrpreMid_rsuf_inter :
      ∀ ⦃v : V⦄, v ∈ rpreMid.vertexSet → v ∈ rsuf.vertexSet →
        v = rpreMid.target := by
    intro v hvpm hvsuf
    have hvpm_union : v ∈ rpre.vertexSet ∪ rmid.vertexSet :=
      appendWithEqOfInterSubsetTarget_vertexSet_subset
        rpre rmid hrpre_rmid_glue hrpre_rmid_inter hvpm
    have hvleft :
        v ∈ (I.rowPath Cross.rowLeft).vertexSet :=
      (I.rowPath Cross.rowLeft).dropUntil_vertexSet_subset
        Cross.s2_mem_left (by simpa [rsuf, LRow] using hvsuf)
    rcases Finset.mem_union.1 hvpm_union with hvpre | hvmid
    · have hvright :
          v ∈ (I.rowPath Cross.rowRight).vertexSet :=
        (I.rowPath Cross.rowRight).takeUntil_vertexSet_subset
          Cross.t2_mem_right (by simpa [rpre, RRow] using hvpre)
      exact False.elim (Cross.left_right_rows_disjoint hvleft hvright)
    · have hend :=
        Cross.orientedSegment2_clean_rows
          (by simpa [rmid] using hvmid)
          (Cross.left_row_vertexSet_subset_rowVertexSet hvleft)
      rcases hend with ht2 | hs2
      · exact False.elim (Cross.t2_not_mem_left_row (by
          simpa [ht2] using hvleft))
      · simpa [rpreMid, rmid] using hs2
  let rightWhole : GraphPath G :=
    rpreMid.appendWithEqOfInterSubsetTarget rsuf
      hrpreMid_rsuf_glue hrpreMid_rsuf_inter
  refine
    { leftPath := leftWhole
      rightPath := rightWhole
      left_source_eq := ?_
      left_target_eq := ?_
      right_source_eq := ?_
      right_target_eq := ?_
      s1_mem_leftPath := ?_
      t1_mem_leftPath := ?_
      t2_mem_rightPath := ?_
      s2_mem_rightPath := ?_
      left_prefix_subset_leftPath := ?_
      segment1_subset_leftPath := ?_
      right_suffix_subset_leftPath := ?_
      right_prefix_subset_rightPath := ?_
      segment2_subset_rightPath := ?_
      left_suffix_subset_rightPath := ?_
      left_vertexSet_subset_parts := ?_
      right_vertexSet_subset_parts := ?_
      left_vertexSet_subset := ?_
      right_vertexSet_subset := ?_
      left_edgeSet_subset := ?_
      right_edgeSet_subset := ?_ }
  · simp [leftWhole, lpreMid, lpre, LRow]
  · simp [leftWhole, lpreMid, lsuf, RRow]
  · simp [rightWhole, rpreMid, rpre, RRow]
  · simp [rightWhole, rpreMid, rsuf, LRow]
  · have hs1_lpre : Cross.s1 ∈ lpre.vertexSet := by
      simpa [lpre, LRow] using GraphPath.target_mem_vertexSet lpre
    have hs1_lpreMid : Cross.s1 ∈ lpreMid.vertexSet :=
      GraphPath.left_vertexSet_subset_appendWithEqOfInterSubsetTarget
        lpre lmid hlpre_lmid_glue hlpre_lmid_inter hs1_lpre
    exact
      GraphPath.left_vertexSet_subset_appendWithEqOfInterSubsetTarget
        lpreMid lsuf hlpreMid_lsuf_glue hlpreMid_lsuf_inter hs1_lpreMid
  · have ht1_lsuf : Cross.t1 ∈ lsuf.vertexSet := by
      simpa [lsuf, RRow] using GraphPath.source_mem_vertexSet lsuf
    exact
      GraphPath.right_vertexSet_subset_appendWithEqOfInterSubsetTarget
        lpreMid lsuf hlpreMid_lsuf_glue hlpreMid_lsuf_inter ht1_lsuf
  · have ht2_rpre : Cross.t2 ∈ rpre.vertexSet := by
      simpa [rpre, RRow] using GraphPath.target_mem_vertexSet rpre
    have ht2_rpreMid : Cross.t2 ∈ rpreMid.vertexSet :=
      GraphPath.left_vertexSet_subset_appendWithEqOfInterSubsetTarget
        rpre rmid hrpre_rmid_glue hrpre_rmid_inter ht2_rpre
    exact
      GraphPath.left_vertexSet_subset_appendWithEqOfInterSubsetTarget
        rpreMid rsuf hrpreMid_rsuf_glue hrpreMid_rsuf_inter ht2_rpreMid
  · have hs2_rsuf : Cross.s2 ∈ rsuf.vertexSet := by
      simpa [rsuf, LRow] using GraphPath.source_mem_vertexSet rsuf
    exact
      GraphPath.right_vertexSet_subset_appendWithEqOfInterSubsetTarget
        rpreMid rsuf hrpreMid_rsuf_glue hrpreMid_rsuf_inter hs2_rsuf
  · intro v hv
    have hvlpre : v ∈ lpre.vertexSet := by
      simpa [lpre, LRow] using hv
    have hvlpreMid : v ∈ lpreMid.vertexSet :=
      GraphPath.left_vertexSet_subset_appendWithEqOfInterSubsetTarget
        lpre lmid hlpre_lmid_glue hlpre_lmid_inter hvlpre
    exact
      GraphPath.left_vertexSet_subset_appendWithEqOfInterSubsetTarget
        lpreMid lsuf hlpreMid_lsuf_glue hlpreMid_lsuf_inter hvlpreMid
  · intro v hv
    have hvlmid : v ∈ lmid.vertexSet := by
      simpa [lmid, Cross.orientedSegment1_vertexSet] using hv
    have hvlpreMid : v ∈ lpreMid.vertexSet :=
      GraphPath.right_vertexSet_subset_appendWithEqOfInterSubsetTarget
        lpre lmid hlpre_lmid_glue hlpre_lmid_inter hvlmid
    exact
      GraphPath.left_vertexSet_subset_appendWithEqOfInterSubsetTarget
        lpreMid lsuf hlpreMid_lsuf_glue hlpreMid_lsuf_inter hvlpreMid
  · intro v hv
    have hvlsuf : v ∈ lsuf.vertexSet := by
      simpa [lsuf, RRow] using hv
    exact
      GraphPath.right_vertexSet_subset_appendWithEqOfInterSubsetTarget
        lpreMid lsuf hlpreMid_lsuf_glue hlpreMid_lsuf_inter hvlsuf
  · intro v hv
    have hvrpre : v ∈ rpre.vertexSet := by
      simpa [rpre, RRow] using hv
    have hvrpreMid : v ∈ rpreMid.vertexSet :=
      GraphPath.left_vertexSet_subset_appendWithEqOfInterSubsetTarget
        rpre rmid hrpre_rmid_glue hrpre_rmid_inter hvrpre
    exact
      GraphPath.left_vertexSet_subset_appendWithEqOfInterSubsetTarget
        rpreMid rsuf hrpreMid_rsuf_glue hrpreMid_rsuf_inter hvrpreMid
  · intro v hv
    have hvrmid : v ∈ rmid.vertexSet := by
      simpa [rmid, Cross.orientedSegment2_vertexSet] using hv
    have hvrpreMid : v ∈ rpreMid.vertexSet :=
      GraphPath.right_vertexSet_subset_appendWithEqOfInterSubsetTarget
        rpre rmid hrpre_rmid_glue hrpre_rmid_inter hvrmid
    exact
      GraphPath.left_vertexSet_subset_appendWithEqOfInterSubsetTarget
        rpreMid rsuf hrpreMid_rsuf_glue hrpreMid_rsuf_inter hvrpreMid
  · intro v hv
    have hvrsuf : v ∈ rsuf.vertexSet := by
      simpa [rsuf, LRow] using hv
    exact
      GraphPath.right_vertexSet_subset_appendWithEqOfInterSubsetTarget
        rpreMid rsuf hrpreMid_rsuf_glue hrpreMid_rsuf_inter hvrsuf
  · intro v hv
    have hv_union : v ∈ lpreMid.vertexSet ∪ lsuf.vertexSet :=
      appendWithEqOfInterSubsetTarget_vertexSet_subset
        lpreMid lsuf hlpreMid_lsuf_glue hlpreMid_lsuf_inter hv
    rcases Finset.mem_union.1 hv_union with hvpm | hvsuf
    · have hvpm_union : v ∈ lpre.vertexSet ∪ lmid.vertexSet :=
        appendWithEqOfInterSubsetTarget_vertexSet_subset
          lpre lmid hlpre_lmid_glue hlpre_lmid_inter hvpm
      rcases Finset.mem_union.1 hvpm_union with hvpre | hvmid
      · exact Finset.mem_union.2 <| Or.inl <|
          Finset.mem_union.2 <| Or.inl <|
            by simpa [lpre, LRow] using hvpre
      · exact Finset.mem_union.2 <| Or.inl <|
          Finset.mem_union.2 <| Or.inr <| by simpa [lmid] using hvmid
    · exact Finset.mem_union.2 <| Or.inr <|
        by simpa [lsuf, RRow] using hvsuf
  · intro v hv
    have hv_union : v ∈ rpreMid.vertexSet ∪ rsuf.vertexSet :=
      appendWithEqOfInterSubsetTarget_vertexSet_subset
        rpreMid rsuf hrpreMid_rsuf_glue hrpreMid_rsuf_inter hv
    rcases Finset.mem_union.1 hv_union with hvpm | hvsuf
    · have hvpm_union : v ∈ rpre.vertexSet ∪ rmid.vertexSet :=
        appendWithEqOfInterSubsetTarget_vertexSet_subset
          rpre rmid hrpre_rmid_glue hrpre_rmid_inter hvpm
      rcases Finset.mem_union.1 hvpm_union with hvpre | hvmid
      · exact Finset.mem_union.2 <| Or.inl <|
          Finset.mem_union.2 <| Or.inl <|
            by simpa [rpre, RRow] using hvpre
      · exact Finset.mem_union.2 <| Or.inl <|
          Finset.mem_union.2 <| Or.inr <| by simpa [rmid] using hvmid
    · exact Finset.mem_union.2 <| Or.inr <|
        by simpa [rsuf, LRow] using hvsuf
  · intro v hv
    have hv_union : v ∈ lpreMid.vertexSet ∪ lsuf.vertexSet :=
      appendWithEqOfInterSubsetTarget_vertexSet_subset
        lpreMid lsuf hlpreMid_lsuf_glue hlpreMid_lsuf_inter hv
    rcases Finset.mem_union.1 hv_union with hvpm | hvsuf
    · have hvpm_union : v ∈ lpre.vertexSet ∪ lmid.vertexSet :=
        appendWithEqOfInterSubsetTarget_vertexSet_subset
          lpre lmid hlpre_lmid_glue hlpre_lmid_inter hvpm
      rcases Finset.mem_union.1 hvpm_union with hvpre | hvmid
      · exact Finset.mem_union.2 <| Or.inl <|
          Finset.mem_union.2 <| Or.inl <|
            (I.rowPath Cross.rowLeft).takeUntil_vertexSet_subset
              Cross.s1_mem_left (by simpa [lpre, LRow] using hvpre)
      · exact Finset.mem_union.2 <| Or.inl <|
          Finset.mem_union.2 <| Or.inr <| by simpa [lmid] using hvmid
    · exact Finset.mem_union.2 <| Or.inr <|
        (I.rowPath Cross.rowRight).dropUntil_vertexSet_subset
          Cross.t1_mem_right (by simpa [lsuf, RRow] using hvsuf)
  · intro v hv
    have hv_union : v ∈ rpreMid.vertexSet ∪ rsuf.vertexSet :=
      appendWithEqOfInterSubsetTarget_vertexSet_subset
        rpreMid rsuf hrpreMid_rsuf_glue hrpreMid_rsuf_inter hv
    rcases Finset.mem_union.1 hv_union with hvpm | hvsuf
    · have hvpm_union : v ∈ rpre.vertexSet ∪ rmid.vertexSet :=
        appendWithEqOfInterSubsetTarget_vertexSet_subset
          rpre rmid hrpre_rmid_glue hrpre_rmid_inter hvpm
      rcases Finset.mem_union.1 hvpm_union with hvpre | hvmid
      · exact Finset.mem_union.2 <| Or.inl <|
          Finset.mem_union.2 <| Or.inl <|
            (I.rowPath Cross.rowRight).takeUntil_vertexSet_subset
              Cross.t2_mem_right (by simpa [rpre, RRow] using hvpre)
      · exact Finset.mem_union.2 <| Or.inl <|
          Finset.mem_union.2 <| Or.inr <| by simpa [rmid] using hvmid
    · exact Finset.mem_union.2 <| Or.inr <|
        (I.rowPath Cross.rowLeft).dropUntil_vertexSet_subset
          Cross.s2_mem_left (by simpa [rsuf, LRow] using hvsuf)
  · intro e he
    have he_union : e ∈ lpreMid.edgeSet ∪ lsuf.edgeSet :=
      appendWithEqOfInterSubsetTarget_edgeSet_subset
        lpreMid lsuf hlpreMid_lsuf_glue hlpreMid_lsuf_inter he
    rcases Finset.mem_union.1 he_union with hepm | hesuf
    · have hepm_union : e ∈ lpre.edgeSet ∪ lmid.edgeSet :=
        appendWithEqOfInterSubsetTarget_edgeSet_subset
          lpre lmid hlpre_lmid_glue hlpre_lmid_inter hepm
      rcases Finset.mem_union.1 hepm_union with hepre | hemid
      · exact Finset.mem_union.2 <| Or.inl <|
          Finset.mem_union.2 <| Or.inl <|
            (I.rowPath Cross.rowLeft).takeUntil_edgeSet_subset
              Cross.s1_mem_left (by simpa [lpre, LRow] using hepre)
      · exact Finset.mem_union.2 <| Or.inl <|
          Finset.mem_union.2 <| Or.inr <| by simpa [lmid] using hemid
    · exact Finset.mem_union.2 <| Or.inr <|
        (I.rowPath Cross.rowRight).dropUntil_edgeSet_subset
          Cross.t1_mem_right (by simpa [lsuf, RRow] using hesuf)
  · intro e he
    have he_union : e ∈ rpreMid.edgeSet ∪ rsuf.edgeSet :=
      appendWithEqOfInterSubsetTarget_edgeSet_subset
        rpreMid rsuf hrpreMid_rsuf_glue hrpreMid_rsuf_inter he
    rcases Finset.mem_union.1 he_union with hepm | hesuf
    · have hepm_union : e ∈ rpre.edgeSet ∪ rmid.edgeSet :=
        appendWithEqOfInterSubsetTarget_edgeSet_subset
          rpre rmid hrpre_rmid_glue hrpre_rmid_inter hepm
      rcases Finset.mem_union.1 hepm_union with hepre | hemid
      · exact Finset.mem_union.2 <| Or.inl <|
          Finset.mem_union.2 <| Or.inl <|
            (I.rowPath Cross.rowRight).takeUntil_edgeSet_subset
              Cross.t2_mem_right (by simpa [rpre, RRow] using hepre)
      · exact Finset.mem_union.2 <| Or.inl <|
          Finset.mem_union.2 <| Or.inr <| by simpa [rmid] using hemid
    · exact Finset.mem_union.2 <| Or.inr <|
        (I.rowPath Cross.rowLeft).dropUntil_edgeSet_subset
          Cross.s2_mem_left (by simpa [rsuf, LRow] using hesuf)

@[simp] theorem replacementPaths_left_source :
    Cross.replacementPaths.leftPath.source =
      (I.rowPath Cross.rowLeft).source :=
  Cross.replacementPaths.left_source_eq

@[simp] theorem replacementPaths_left_target :
    Cross.replacementPaths.leftPath.target =
      (I.rowPath Cross.rowRight).target :=
  Cross.replacementPaths.left_target_eq

@[simp] theorem replacementPaths_right_source :
    Cross.replacementPaths.rightPath.source =
      (I.rowPath Cross.rowRight).source :=
  Cross.replacementPaths.right_source_eq

@[simp] theorem replacementPaths_right_target :
    Cross.replacementPaths.rightPath.target =
      (I.rowPath Cross.rowLeft).target :=
  Cross.replacementPaths.right_target_eq

theorem replacementPaths_left_connectsAB (hrows : I.RowsConnectAB) :
    Cross.replacementPaths.leftPath.Connects A B :=
  Cross.replacementPaths.leftConnectsAB hrows

theorem replacementPaths_right_connectsAB (hrows : I.RowsConnectAB) :
    Cross.replacementPaths.rightPath.Connects A B :=
  Cross.replacementPaths.rightConnectsAB hrows

/-- The two switched rows produced by a cross are vertex-disjoint.  This is
the formal content of the “immediate to verify” part of Figure 8 for the pair
of replacement paths themselves. -/
theorem replacementPaths_nodeDisjoint :
    Cross.replacementPaths.leftPath.NodeDisjoint
      Cross.replacementPaths.rightPath := by
  rw [GraphPath.NodeDisjoint, Finset.disjoint_left]
  intro v hvleft hvright
  have hleft_parts :=
    Cross.replacementPaths.left_vertexSet_subset_parts hvleft
  have hright_parts :=
    Cross.replacementPaths.right_vertexSet_subset_parts hvright
  rcases Finset.mem_union.1 hleft_parts with hleft_pre_or_seg | hleft_rsuf
  · rcases Finset.mem_union.1 hleft_pre_or_seg with hleft_pre | hleft_seg
    · rcases Finset.mem_union.1 hright_parts with hright_pre_or_seg | hright_lsuf
      · rcases Finset.mem_union.1 hright_pre_or_seg with hright_pre | hright_seg
        · have hvLrow :
              v ∈ (I.rowPath Cross.rowLeft).vertexSet :=
            (I.rowPath Cross.rowLeft).takeUntil_vertexSet_subset
              Cross.s1_mem_left hleft_pre
          have hvRrow :
              v ∈ (I.rowPath Cross.rowRight).vertexSet :=
            (I.rowPath Cross.rowRight).takeUntil_vertexSet_subset
              Cross.t2_mem_right hright_pre
          exact Cross.left_right_rows_disjoint hvLrow hvRrow
        · have hvLrow :
              v ∈ (I.rowPath Cross.rowLeft).vertexSet :=
            (I.rowPath Cross.rowLeft).takeUntil_vertexSet_subset
              Cross.s1_mem_left hleft_pre
          have hend :=
            Cross.orientedSegment2_clean_rows
              (by simpa using hright_seg)
              (Cross.left_row_vertexSet_subset_rowVertexSet hvLrow)
          rcases hend with ht2 | hs2
          · exact Cross.t2_not_mem_left_row (by simpa [ht2] using hvLrow)
          · exact Cross.s2_not_mem_left_prefix (by
              simpa [hs2] using hleft_pre)
      · exact Finset.disjoint_left.mp Cross.left_prefix_disjoint_suffix
          hleft_pre hright_lsuf
    · rcases Finset.mem_union.1 hright_parts with hright_pre_or_seg | hright_lsuf
      · rcases Finset.mem_union.1 hright_pre_or_seg with hright_pre | hright_seg
        · have hvRrow :
              v ∈ (I.rowPath Cross.rowRight).vertexSet :=
            (I.rowPath Cross.rowRight).takeUntil_vertexSet_subset
              Cross.t2_mem_right hright_pre
          have hend :=
            Cross.orientedSegment1_clean_rows
              (by simpa using hleft_seg)
              (Cross.right_row_vertexSet_subset_rowVertexSet hvRrow)
          rcases hend with hs1 | ht1
          · exact Cross.s1_not_mem_right_row (by simpa [hs1] using hvRrow)
          · exact Cross.t1_not_mem_right_prefix (by
              simpa [ht1] using hright_pre)
        · exact Finset.disjoint_left.mp Cross.segments_nodeDisjoint
            hleft_seg hright_seg
      · have hvLrow :
            v ∈ (I.rowPath Cross.rowLeft).vertexSet :=
          (I.rowPath Cross.rowLeft).dropUntil_vertexSet_subset
            Cross.s2_mem_left hright_lsuf
        have hend :=
          Cross.orientedSegment1_clean_rows
            (by simpa using hleft_seg)
            (Cross.left_row_vertexSet_subset_rowVertexSet hvLrow)
        rcases hend with hs1 | ht1
        · exact Cross.s1_not_mem_left_suffix (by
            simpa [hs1] using hright_lsuf)
        · exact Cross.t1_not_mem_left_row (by simpa [ht1] using hvLrow)
  · rcases Finset.mem_union.1 hright_parts with hright_pre_or_seg | hright_lsuf
    · rcases Finset.mem_union.1 hright_pre_or_seg with hright_pre | hright_seg
      · exact Finset.disjoint_left.mp Cross.right_prefix_disjoint_suffix
          hright_pre hleft_rsuf
      · have hvRrow :
            v ∈ (I.rowPath Cross.rowRight).vertexSet :=
          (I.rowPath Cross.rowRight).dropUntil_vertexSet_subset
            Cross.t1_mem_right hleft_rsuf
        have hend :=
          Cross.orientedSegment2_clean_rows
            (by simpa using hright_seg)
            (Cross.right_row_vertexSet_subset_rowVertexSet hvRrow)
        rcases hend with ht2 | hs2
        · exact Cross.t2_not_mem_right_suffix (by
            simpa [ht2] using hleft_rsuf)
        · exact Cross.s2_not_mem_right_row (by simpa [hs2] using hvRrow)
    · have hvRrow :
          v ∈ (I.rowPath Cross.rowRight).vertexSet :=
        (I.rowPath Cross.rowRight).dropUntil_vertexSet_subset
          Cross.t1_mem_right hleft_rsuf
      have hvLrow :
          v ∈ (I.rowPath Cross.rowLeft).vertexSet :=
        (I.rowPath Cross.rowLeft).dropUntil_vertexSet_subset
          Cross.s2_mem_left hright_lsuf
      exact Cross.left_right_rows_disjoint hvLrow hvRrow

/-- The old left row is disjoint from every unchanged linkage path. -/
theorem left_row_nodeDisjoint_unchanged
    {i : I.linkage.Index} (hileft : i ≠ I.rowIndex Cross.rowLeft) :
    (I.rowPath Cross.rowLeft).NodeDisjoint (I.linkage.path i) := by
  rw [GraphPath.NodeDisjoint, Finset.disjoint_left]
  intro v hvrow hvi
  have hvrow' :
      v ∈ (I.linkage.path (I.rowIndex Cross.rowLeft)).vertexSet := by
    simpa [I.rowPath_eq_linkage_path Cross.rowLeft] using hvrow
  exact Finset.disjoint_left.mp
    (I.linkage.toPathPacking.node_disjoint (fun h => hileft h.symm))
    hvrow' hvi

/-- The old right row is disjoint from every unchanged linkage path. -/
theorem right_row_nodeDisjoint_unchanged
    {i : I.linkage.Index} (hiright : i ≠ I.rowIndex Cross.rowRight) :
    (I.rowPath Cross.rowRight).NodeDisjoint (I.linkage.path i) := by
  rw [GraphPath.NodeDisjoint, Finset.disjoint_left]
  intro v hvrow hvi
  have hvrow' :
      v ∈ (I.linkage.path (I.rowIndex Cross.rowRight)).vertexSet := by
    simpa [I.rowPath_eq_linkage_path Cross.rowRight] using hvrow
  exact Finset.disjoint_left.mp
    (I.linkage.toPathPacking.node_disjoint (fun h => hiright h.symm))
    hvrow' hvi

/-- The first inserted cross segment is disjoint from every unchanged linkage
path.  Whole-linkage cleanliness says any old linkage contact is one of the
two endpoints; those endpoints lie on the two crossed rows, which are not the
unchanged path. -/
theorem orientedSegment1_nodeDisjoint_unchanged
    {i : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight) :
    Cross.orientedSegment1.NodeDisjoint (I.linkage.path i) := by
  rw [GraphPath.NodeDisjoint, Finset.disjoint_left]
  intro v hvseg hvi
  have hpack : v ∈ I.linkage.toPathPacking.vertexSet :=
    (I.linkage.toPathPacking.mem_vertexSet).2 ⟨i, hvi⟩
  have hend := Cross.orientedSegment1_clean_linkage hvseg hpack
  rcases hend with hs1 | ht1
  · have hs1_i :
        Cross.s1 ∈ (I.linkage.path i).vertexSet := by
      simpa [hs1] using hvi
    have hs1_row :
        Cross.s1 ∈
          (I.linkage.path (I.rowIndex Cross.rowLeft)).vertexSet := by
      simpa [I.rowPath_eq_linkage_path Cross.rowLeft] using
        Cross.s1_mem_left
    exact Finset.disjoint_left.mp
      (I.linkage.toPathPacking.node_disjoint (fun h => hileft h.symm))
      hs1_row hs1_i
  · have ht1_i :
        Cross.t1 ∈ (I.linkage.path i).vertexSet := by
      simpa [ht1] using hvi
    have ht1_row :
        Cross.t1 ∈
          (I.linkage.path (I.rowIndex Cross.rowRight)).vertexSet := by
      simpa [I.rowPath_eq_linkage_path Cross.rowRight] using
        Cross.t1_mem_right
    exact Finset.disjoint_left.mp
      (I.linkage.toPathPacking.node_disjoint (fun h => hiright h.symm))
      ht1_row ht1_i

/-- The second inserted cross segment is disjoint from every unchanged linkage
path. -/
theorem orientedSegment2_nodeDisjoint_unchanged
    {i : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight) :
    Cross.orientedSegment2.NodeDisjoint (I.linkage.path i) := by
  rw [GraphPath.NodeDisjoint, Finset.disjoint_left]
  intro v hvseg hvi
  have hpack : v ∈ I.linkage.toPathPacking.vertexSet :=
    (I.linkage.toPathPacking.mem_vertexSet).2 ⟨i, hvi⟩
  have hend := Cross.orientedSegment2_clean_linkage hvseg hpack
  rcases hend with ht2 | hs2
  · have ht2_i :
        Cross.t2 ∈ (I.linkage.path i).vertexSet := by
      simpa [ht2] using hvi
    have ht2_row :
        Cross.t2 ∈
          (I.linkage.path (I.rowIndex Cross.rowRight)).vertexSet := by
      simpa [I.rowPath_eq_linkage_path Cross.rowRight] using
        Cross.t2_mem_right
    exact Finset.disjoint_left.mp
      (I.linkage.toPathPacking.node_disjoint (fun h => hiright h.symm))
      ht2_row ht2_i
  · have hs2_i :
        Cross.s2 ∈ (I.linkage.path i).vertexSet := by
      simpa [hs2] using hvi
    have hs2_row :
        Cross.s2 ∈
          (I.linkage.path (I.rowIndex Cross.rowLeft)).vertexSet := by
      simpa [I.rowPath_eq_linkage_path Cross.rowLeft] using
        Cross.s2_mem_left
    exact Finset.disjoint_left.mp
      (I.linkage.toPathPacking.node_disjoint (fun h => hileft h.symm))
      hs2_row hs2_i

/-- The left switched row is disjoint from every unchanged linkage path. -/
theorem replacementPaths_left_nodeDisjoint_unchanged
    {i : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight) :
    Cross.replacementPaths.leftPath.NodeDisjoint (I.linkage.path i) := by
  rw [GraphPath.NodeDisjoint, Finset.disjoint_left]
  intro v hvleft hvi
  have hparts := Cross.replacementPaths.left_vertexSet_subset_parts hvleft
  rcases Finset.mem_union.1 hparts with hpre_or_seg | hrsuf
  · rcases Finset.mem_union.1 hpre_or_seg with hpre | hseg
    · have hvrow :
          v ∈ (I.rowPath Cross.rowLeft).vertexSet :=
        (I.rowPath Cross.rowLeft).takeUntil_vertexSet_subset
          Cross.s1_mem_left hpre
      exact Finset.disjoint_left.mp
        (Cross.left_row_nodeDisjoint_unchanged hileft) hvrow hvi
    · exact Finset.disjoint_left.mp
        (Cross.orientedSegment1_nodeDisjoint_unchanged hileft hiright)
        (by simpa [Cross.orientedSegment1_vertexSet] using hseg) hvi
  · have hvrow :
        v ∈ (I.rowPath Cross.rowRight).vertexSet :=
      (I.rowPath Cross.rowRight).dropUntil_vertexSet_subset
        Cross.t1_mem_right hrsuf
    exact Finset.disjoint_left.mp
      (Cross.right_row_nodeDisjoint_unchanged hiright) hvrow hvi

/-- The right switched row is disjoint from every unchanged linkage path. -/
theorem replacementPaths_right_nodeDisjoint_unchanged
    {i : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight) :
    Cross.replacementPaths.rightPath.NodeDisjoint (I.linkage.path i) := by
  rw [GraphPath.NodeDisjoint, Finset.disjoint_left]
  intro v hvright hvi
  have hparts := Cross.replacementPaths.right_vertexSet_subset_parts hvright
  rcases Finset.mem_union.1 hparts with hpre_or_seg | hlsuf
  · rcases Finset.mem_union.1 hpre_or_seg with hpre | hseg
    · have hvrow :
          v ∈ (I.rowPath Cross.rowRight).vertexSet :=
        (I.rowPath Cross.rowRight).takeUntil_vertexSet_subset
          Cross.t2_mem_right hpre
      exact Finset.disjoint_left.mp
        (Cross.right_row_nodeDisjoint_unchanged hiright) hvrow hvi
    · exact Finset.disjoint_left.mp
        (Cross.orientedSegment2_nodeDisjoint_unchanged hileft hiright)
        (by simpa [Cross.orientedSegment2_vertexSet] using hseg) hvi
  · have hvrow :
        v ∈ (I.rowPath Cross.rowLeft).vertexSet :=
      (I.rowPath Cross.rowLeft).dropUntil_vertexSet_subset
        Cross.s2_mem_left hlsuf
    exact Finset.disjoint_left.mp
      (Cross.left_row_nodeDisjoint_unchanged hileft) hvrow hvi

/-- Vertices of the deleted middle intervals. -/
noncomputable def deletedMiddleVertexSet : Finset V :=
  Cross.deletedLeftMiddle.vertexSet ∪ Cross.deletedRightMiddle.vertexSet

/-- Vertices of the two inserted transversal segments. -/
noncomputable def insertedSegmentVertexSet : Finset V :=
  Cross.orientedSegment1.vertexSet ∪ Cross.orientedSegment2.vertexSet

/-- The old left row is covered by the prefix used in the left switched row,
the deleted middle, and the suffix used in the right switched row. -/
theorem left_row_vertex_mem_prefix_or_deleted_or_suffix
    {v : V} (hv : v ∈ (I.rowPath Cross.rowLeft).vertexSet) :
    v ∈ ((I.rowPath Cross.rowLeft).takeUntil Cross.s1_mem_left).vertexSet ∨
      v ∈ Cross.deletedLeftMiddle.vertexSet ∨
        v ∈ ((I.rowPath Cross.rowLeft).dropUntil Cross.s2_mem_left).vertexSet := by
  classical
  by_cases hv_before_s1 : (I.rowPath Cross.rowLeft).Before v Cross.s1
  · exact Or.inl
      ((I.rowPath Cross.rowLeft).mem_takeUntil_of_before
        Cross.s1_mem_left hv_before_s1)
  · by_cases hs2_before_v : (I.rowPath Cross.rowLeft).Before Cross.s2 v
    · rcases hs2_before_v with ⟨_, hvdrop⟩
      exact Or.inr <| Or.inr (by simpa using hvdrop)
    · have hs1_before_v : (I.rowPath Cross.rowLeft).Before Cross.s1 v := by
        rcases le_total
            ((I.rowPath Cross.rowLeft).vertexIndex Cross.s1)
            ((I.rowPath Cross.rowLeft).vertexIndex v) with hle | hle
        · exact ((I.rowPath Cross.rowLeft).before_iff_vertexIndex_le).2
            ⟨Cross.s1_mem_left, hv, hle⟩
        · exact False.elim (hv_before_s1
            (((I.rowPath Cross.rowLeft).before_iff_vertexIndex_le).2
              ⟨hv, Cross.s1_mem_left, hle⟩))
      have hv_before_s2 : (I.rowPath Cross.rowLeft).Before v Cross.s2 := by
        rcases le_total
            ((I.rowPath Cross.rowLeft).vertexIndex v)
            ((I.rowPath Cross.rowLeft).vertexIndex Cross.s2) with hle | hle
        · exact ((I.rowPath Cross.rowLeft).before_iff_vertexIndex_le).2
            ⟨hv, Cross.s2_mem_left, hle⟩
        · exact False.elim (hs2_before_v
            (((I.rowPath Cross.rowLeft).before_iff_vertexIndex_le).2
              ⟨Cross.s2_mem_left, hv, hle⟩))
      exact Or.inr <| Or.inl <|
        (I.rowPath Cross.rowLeft).mem_segmentOfBefore_of_before_of_before
          Cross.s1_before_s2 hs1_before_v hv_before_s2

/-- The old right row is covered by the prefix used in the right switched row,
the deleted middle, and the suffix used in the left switched row. -/
theorem right_row_vertex_mem_prefix_or_deleted_or_suffix
    {v : V} (hv : v ∈ (I.rowPath Cross.rowRight).vertexSet) :
    v ∈ ((I.rowPath Cross.rowRight).takeUntil Cross.t2_mem_right).vertexSet ∨
      v ∈ Cross.deletedRightMiddle.vertexSet ∨
        v ∈ ((I.rowPath Cross.rowRight).dropUntil Cross.t1_mem_right).vertexSet := by
  classical
  by_cases hv_before_t2 : (I.rowPath Cross.rowRight).Before v Cross.t2
  · exact Or.inl
      ((I.rowPath Cross.rowRight).mem_takeUntil_of_before
        Cross.t2_mem_right hv_before_t2)
  · by_cases ht1_before_v : (I.rowPath Cross.rowRight).Before Cross.t1 v
    · rcases ht1_before_v with ⟨_, hvdrop⟩
      exact Or.inr <| Or.inr (by simpa using hvdrop)
    · have ht2_before_v : (I.rowPath Cross.rowRight).Before Cross.t2 v := by
        rcases le_total
            ((I.rowPath Cross.rowRight).vertexIndex Cross.t2)
            ((I.rowPath Cross.rowRight).vertexIndex v) with hle | hle
        · exact ((I.rowPath Cross.rowRight).before_iff_vertexIndex_le).2
            ⟨Cross.t2_mem_right, hv, hle⟩
        · exact False.elim (hv_before_t2
            (((I.rowPath Cross.rowRight).before_iff_vertexIndex_le).2
              ⟨hv, Cross.t2_mem_right, hle⟩))
      have hv_before_t1 : (I.rowPath Cross.rowRight).Before v Cross.t1 := by
        rcases le_total
            ((I.rowPath Cross.rowRight).vertexIndex v)
            ((I.rowPath Cross.rowRight).vertexIndex Cross.t1) with hle | hle
        · exact ((I.rowPath Cross.rowRight).before_iff_vertexIndex_le).2
            ⟨hv, Cross.t1_mem_right, hle⟩
        · exact False.elim (ht1_before_v
            (((I.rowPath Cross.rowRight).before_iff_vertexIndex_le).2
              ⟨Cross.t1_mem_right, hv, hle⟩))
      exact Or.inr <| Or.inl <|
        (I.rowPath Cross.rowRight).mem_segmentOfBefore_of_before_of_before
          Cross.t2_before_t1 ht2_before_v hv_before_t1

/-- The deleted left middle row segment can meet the left switched row only at
its `s₁` endpoint. -/
theorem deletedLeftMiddle_inter_leftPath_endpoint
    {v : V} (hvdel : v ∈ Cross.deletedLeftMiddle.vertexSet)
    (hvleft : v ∈ Cross.replacementPaths.leftPath.vertexSet) :
    Cross.deletedLeftMiddle.IsEndpoint v := by
  have hvrow :
      v ∈ (I.rowPath Cross.rowLeft).vertexSet :=
    (I.rowPath Cross.rowLeft).segmentOfBefore_vertexSet_subset
      Cross.s1_before_s2 hvdel
  have hparts := Cross.replacementPaths.left_vertexSet_subset_parts hvleft
  rcases Finset.mem_union.1 hparts with hpre_or_seg | hrsuf
  · rcases Finset.mem_union.1 hpre_or_seg with hpre | hseg
    · have hv_before_s1 :
          (I.rowPath Cross.rowLeft).Before v Cross.s1 :=
        (I.rowPath Cross.rowLeft).before_of_mem_takeUntil
          Cross.s1_mem_left hpre
      have hs1_before_v :
          (I.rowPath Cross.rowLeft).Before Cross.s1 v :=
        (I.rowPath Cross.rowLeft).before_of_mem_segmentOfBefore_left
          Cross.s1_before_s2 hvdel
      have hv_eq : v = Cross.s1 :=
        (I.rowPath Cross.rowLeft).before_antisymm
          hv_before_s1 hs1_before_v
      exact Or.inl (by simpa [deletedLeftMiddle] using hv_eq)
    · have hrowContact : v ∈ I.rowVertexSet :=
        Cross.left_row_vertexSet_subset_rowVertexSet hvrow
      have hend := Cross.orientedSegment1_clean_rows
        (by simpa [Cross.orientedSegment1_vertexSet] using hseg) hrowContact
      rcases hend with hs1 | ht1
      · exact Or.inl (by simpa [deletedLeftMiddle] using hs1)
      · exact False.elim
          (Cross.t1_not_mem_left_row (by simpa [ht1] using hvrow))
  · have hvright :
        v ∈ (I.rowPath Cross.rowRight).vertexSet :=
      (I.rowPath Cross.rowRight).dropUntil_vertexSet_subset
        Cross.t1_mem_right hrsuf
    exact False.elim (Cross.left_right_rows_disjoint hvrow hvright)

/-- The deleted left middle row segment can meet the right switched row only at
its `s₂` endpoint. -/
theorem deletedLeftMiddle_inter_rightPath_endpoint
    {v : V} (hvdel : v ∈ Cross.deletedLeftMiddle.vertexSet)
    (hvright : v ∈ Cross.replacementPaths.rightPath.vertexSet) :
    Cross.deletedLeftMiddle.IsEndpoint v := by
  have hvrow :
      v ∈ (I.rowPath Cross.rowLeft).vertexSet :=
    (I.rowPath Cross.rowLeft).segmentOfBefore_vertexSet_subset
      Cross.s1_before_s2 hvdel
  have hparts := Cross.replacementPaths.right_vertexSet_subset_parts hvright
  rcases Finset.mem_union.1 hparts with hpre_or_seg | hlsuf
  · rcases Finset.mem_union.1 hpre_or_seg with hpre | hseg
    · have hvrightrow :
          v ∈ (I.rowPath Cross.rowRight).vertexSet :=
        (I.rowPath Cross.rowRight).takeUntil_vertexSet_subset
          Cross.t2_mem_right hpre
      exact False.elim (Cross.left_right_rows_disjoint hvrow hvrightrow)
    · have hrowContact : v ∈ I.rowVertexSet :=
        Cross.left_row_vertexSet_subset_rowVertexSet hvrow
      have hend := Cross.orientedSegment2_clean_rows
        (by simpa [Cross.orientedSegment2_vertexSet] using hseg) hrowContact
      rcases hend with ht2 | hs2
      · exact False.elim
          (Cross.t2_not_mem_left_row (by simpa [ht2] using hvrow))
      · exact Or.inr (by simpa [deletedLeftMiddle] using hs2)
  · have hs2_before_v :
        (I.rowPath Cross.rowLeft).Before Cross.s2 v :=
      ⟨Cross.s2_mem_left, hlsuf⟩
    have hv_before_s2 :
        (I.rowPath Cross.rowLeft).Before v Cross.s2 :=
      (I.rowPath Cross.rowLeft).before_of_mem_segmentOfBefore_right
        Cross.s1_before_s2 hvdel
    have hv_eq : v = Cross.s2 :=
      (I.rowPath Cross.rowLeft).before_antisymm
        hv_before_s2 hs2_before_v
    exact Or.inr (by simpa [deletedLeftMiddle] using hv_eq)

/-- The deleted right middle row segment can meet the left switched row only
at its `t₁` endpoint. -/
theorem deletedRightMiddle_inter_leftPath_endpoint
    {v : V} (hvdel : v ∈ Cross.deletedRightMiddle.vertexSet)
    (hvleft : v ∈ Cross.replacementPaths.leftPath.vertexSet) :
    Cross.deletedRightMiddle.IsEndpoint v := by
  have hvrow :
      v ∈ (I.rowPath Cross.rowRight).vertexSet :=
    (I.rowPath Cross.rowRight).segmentOfBefore_vertexSet_subset
      Cross.t2_before_t1 hvdel
  have hparts := Cross.replacementPaths.left_vertexSet_subset_parts hvleft
  rcases Finset.mem_union.1 hparts with hpre_or_seg | hrsuf
  · rcases Finset.mem_union.1 hpre_or_seg with hpre | hseg
    · have hvleftrow :
          v ∈ (I.rowPath Cross.rowLeft).vertexSet :=
        (I.rowPath Cross.rowLeft).takeUntil_vertexSet_subset
          Cross.s1_mem_left hpre
      exact False.elim (Cross.left_right_rows_disjoint hvleftrow hvrow)
    · have hrowContact : v ∈ I.rowVertexSet :=
        Cross.right_row_vertexSet_subset_rowVertexSet hvrow
      have hend := Cross.orientedSegment1_clean_rows
        (by simpa [Cross.orientedSegment1_vertexSet] using hseg) hrowContact
      rcases hend with hs1 | ht1
      · exact False.elim
          (Cross.s1_not_mem_right_row (by simpa [hs1] using hvrow))
      · exact Or.inr (by simpa [deletedRightMiddle] using ht1)
  · have ht1_before_v :
        (I.rowPath Cross.rowRight).Before Cross.t1 v :=
      ⟨Cross.t1_mem_right, hrsuf⟩
    have hv_before_t1 :
        (I.rowPath Cross.rowRight).Before v Cross.t1 :=
      (I.rowPath Cross.rowRight).before_of_mem_segmentOfBefore_right
        Cross.t2_before_t1 hvdel
    have hv_eq : v = Cross.t1 :=
      (I.rowPath Cross.rowRight).before_antisymm
        hv_before_t1 ht1_before_v
    exact Or.inr (by simpa [deletedRightMiddle] using hv_eq)

/-- The deleted right middle row segment can meet the right switched row only
at its `t₂` endpoint. -/
theorem deletedRightMiddle_inter_rightPath_endpoint
    {v : V} (hvdel : v ∈ Cross.deletedRightMiddle.vertexSet)
    (hvright : v ∈ Cross.replacementPaths.rightPath.vertexSet) :
    Cross.deletedRightMiddle.IsEndpoint v := by
  have hvrow :
      v ∈ (I.rowPath Cross.rowRight).vertexSet :=
    (I.rowPath Cross.rowRight).segmentOfBefore_vertexSet_subset
      Cross.t2_before_t1 hvdel
  have hparts := Cross.replacementPaths.right_vertexSet_subset_parts hvright
  rcases Finset.mem_union.1 hparts with hpre_or_seg | hlsuf
  · rcases Finset.mem_union.1 hpre_or_seg with hpre | hseg
    · have hv_before_t2 :
          (I.rowPath Cross.rowRight).Before v Cross.t2 :=
        (I.rowPath Cross.rowRight).before_of_mem_takeUntil
          Cross.t2_mem_right hpre
      have ht2_before_v :
          (I.rowPath Cross.rowRight).Before Cross.t2 v :=
        (I.rowPath Cross.rowRight).before_of_mem_segmentOfBefore_left
          Cross.t2_before_t1 hvdel
      have hv_eq : v = Cross.t2 :=
        (I.rowPath Cross.rowRight).before_antisymm
          hv_before_t2 ht2_before_v
      exact Or.inl (by simpa [deletedRightMiddle] using hv_eq)
    · have hrowContact : v ∈ I.rowVertexSet :=
        Cross.right_row_vertexSet_subset_rowVertexSet hvrow
      have hend := Cross.orientedSegment2_clean_rows
        (by simpa [Cross.orientedSegment2_vertexSet] using hseg) hrowContact
      rcases hend with ht2 | hs2
      · exact Or.inl (by simpa [deletedRightMiddle] using ht2)
      · exact False.elim
          (Cross.s2_not_mem_right_row (by simpa [hs2] using hvrow))
  · have hvleftrow :
        v ∈ (I.rowPath Cross.rowLeft).vertexSet :=
      (I.rowPath Cross.rowLeft).dropUntil_vertexSet_subset
        Cross.s2_mem_left hlsuf
    exact False.elim (Cross.left_right_rows_disjoint hvleftrow hvrow)

/-- The endpoint `s₂` of the deleted left middle segment is not on the left
replacement row. -/
theorem s2_not_mem_leftReplacementPath :
    Cross.s2 ∉ Cross.replacementPaths.leftPath.vertexSet := by
  intro hvleft
  have hparts := Cross.replacementPaths.left_vertexSet_subset_parts hvleft
  rcases Finset.mem_union.1 hparts with hpre_or_seg | hrsuf
  · rcases Finset.mem_union.1 hpre_or_seg with hpre | hseg
    · exact Cross.s2_not_mem_left_prefix hpre
    · have hrowContact : Cross.s2 ∈ I.rowVertexSet :=
        Cross.left_row_vertexSet_subset_rowVertexSet Cross.s2_mem_left
      have hend := Cross.orientedSegment1_clean_rows
        (by simpa [Cross.orientedSegment1_vertexSet] using hseg) hrowContact
      rcases hend with hs1 | ht1
      · exact Cross.s1_ne_s2 (by
          simpa [Cross.orientedSegment1_source] using hs1.symm)
      · exact Cross.t1_not_mem_left_row (by
          simpa [Cross.orientedSegment1_target, ht1] using Cross.s2_mem_left)
  · have hvright :
        Cross.s2 ∈ (I.rowPath Cross.rowRight).vertexSet :=
      (I.rowPath Cross.rowRight).dropUntil_vertexSet_subset
        Cross.t1_mem_right hrsuf
    exact Cross.left_right_rows_disjoint Cross.s2_mem_left hvright

/-- The endpoint `s₁` of the deleted left middle segment is not on the right
replacement row. -/
theorem s1_not_mem_rightReplacementPath :
    Cross.s1 ∉ Cross.replacementPaths.rightPath.vertexSet := by
  intro hvright
  have hparts := Cross.replacementPaths.right_vertexSet_subset_parts hvright
  rcases Finset.mem_union.1 hparts with hpre_or_seg | hlsuf
  · rcases Finset.mem_union.1 hpre_or_seg with hpre | hseg
    · have hvrow :
          Cross.s1 ∈ (I.rowPath Cross.rowRight).vertexSet :=
        (I.rowPath Cross.rowRight).takeUntil_vertexSet_subset
          Cross.t2_mem_right hpre
      exact Cross.left_right_rows_disjoint Cross.s1_mem_left hvrow
    · have hrowContact : Cross.s1 ∈ I.rowVertexSet :=
        Cross.left_row_vertexSet_subset_rowVertexSet Cross.s1_mem_left
      have hend := Cross.orientedSegment2_clean_rows
        (by simpa [Cross.orientedSegment2_vertexSet] using hseg) hrowContact
      rcases hend with ht2 | hs2
      · exact Cross.t2_not_mem_left_row (by
          simpa [Cross.orientedSegment2_source, ht2] using Cross.s1_mem_left)
      · exact Cross.s1_ne_s2 (by
          simpa [Cross.orientedSegment2_target] using hs2)
  · exact Cross.s1_not_mem_left_suffix hlsuf

/-- The endpoint `t₂` of the deleted right middle segment is not on the left
replacement row. -/
theorem t2_not_mem_leftReplacementPath :
    Cross.t2 ∉ Cross.replacementPaths.leftPath.vertexSet := by
  intro hvleft
  have hparts := Cross.replacementPaths.left_vertexSet_subset_parts hvleft
  rcases Finset.mem_union.1 hparts with hpre_or_seg | hrsuf
  · rcases Finset.mem_union.1 hpre_or_seg with hpre | hseg
    · have hvrow :
          Cross.t2 ∈ (I.rowPath Cross.rowLeft).vertexSet :=
        (I.rowPath Cross.rowLeft).takeUntil_vertexSet_subset
          Cross.s1_mem_left hpre
      exact Cross.t2_not_mem_left_row hvrow
    · have hrowContact : Cross.t2 ∈ I.rowVertexSet :=
        Cross.right_row_vertexSet_subset_rowVertexSet Cross.t2_mem_right
      have hend := Cross.orientedSegment1_clean_rows
        (by simpa [Cross.orientedSegment1_vertexSet] using hseg) hrowContact
      rcases hend with hs1 | ht1
      · exact Cross.s1_not_mem_right_row (by
          simpa [Cross.orientedSegment1_source, hs1] using Cross.t2_mem_right)
      · exact Cross.t2_ne_t1 (by
          simpa [Cross.orientedSegment1_target] using ht1)
  · exact Cross.t2_not_mem_right_suffix hrsuf

/-- The endpoint `t₁` of the deleted right middle segment is not on the right
replacement row. -/
theorem t1_not_mem_rightReplacementPath :
    Cross.t1 ∉ Cross.replacementPaths.rightPath.vertexSet := by
  intro hvright
  have hparts := Cross.replacementPaths.right_vertexSet_subset_parts hvright
  rcases Finset.mem_union.1 hparts with hpre_or_seg | hlsuf
  · rcases Finset.mem_union.1 hpre_or_seg with hpre | hseg
    · exact Cross.t1_not_mem_right_prefix hpre
    · have hrowContact : Cross.t1 ∈ I.rowVertexSet :=
        Cross.right_row_vertexSet_subset_rowVertexSet Cross.t1_mem_right
      have hend := Cross.orientedSegment2_clean_rows
        (by simpa [Cross.orientedSegment2_vertexSet] using hseg) hrowContact
      rcases hend with ht2 | hs2
      · exact Cross.t2_ne_t1 (by
          simpa [Cross.orientedSegment2_source] using ht2.symm)
      · exact Cross.s2_not_mem_right_row (by
          simpa [Cross.orientedSegment2_target, hs2] using Cross.t1_mem_right)
  · have hvleft :
        Cross.t1 ∈ (I.rowPath Cross.rowLeft).vertexSet :=
      (I.rowPath Cross.rowLeft).dropUntil_vertexSet_subset
        Cross.s2_mem_left hlsuf
    exact Cross.left_right_rows_disjoint hvleft Cross.t1_mem_right

/-- The deleted left middle row segment is edge-disjoint from the left
replacement row. -/
theorem deletedLeftMiddle_edgeDisjoint_leftReplacementPath :
    Cross.deletedLeftMiddle.EdgeDisjoint Cross.replacementPaths.leftPath :=
  graphPath_edgeDisjoint_of_vertex_inter_subset_singleton
    (x := Cross.s1) (by
      intro v hvdel hvleft
      rcases Cross.deletedLeftMiddle_inter_leftPath_endpoint hvdel hvleft
        with hs1 | hs2
      · simpa [Cross.deletedLeftMiddle_source] using hs1
      · exact False.elim (Cross.s2_not_mem_leftReplacementPath
          (by simpa [Cross.deletedLeftMiddle_target, hs2] using hvleft)))

/-- The deleted left middle row segment is edge-disjoint from the right
replacement row. -/
theorem deletedLeftMiddle_edgeDisjoint_rightReplacementPath :
    Cross.deletedLeftMiddle.EdgeDisjoint Cross.replacementPaths.rightPath :=
  graphPath_edgeDisjoint_of_vertex_inter_subset_singleton
    (x := Cross.s2) (by
      intro v hvdel hvright
      rcases Cross.deletedLeftMiddle_inter_rightPath_endpoint hvdel hvright
        with hs1 | hs2
      · exact False.elim (Cross.s1_not_mem_rightReplacementPath
          (by simpa [Cross.deletedLeftMiddle_source, hs1] using hvright))
      · simpa [Cross.deletedLeftMiddle_target] using hs2)

/-- The deleted right middle row segment is edge-disjoint from the left
replacement row. -/
theorem deletedRightMiddle_edgeDisjoint_leftReplacementPath :
    Cross.deletedRightMiddle.EdgeDisjoint Cross.replacementPaths.leftPath :=
  graphPath_edgeDisjoint_of_vertex_inter_subset_singleton
    (x := Cross.t1) (by
      intro v hvdel hvleft
      rcases Cross.deletedRightMiddle_inter_leftPath_endpoint hvdel hvleft
        with ht2 | ht1
      · exact False.elim (Cross.t2_not_mem_leftReplacementPath
          (by simpa [Cross.deletedRightMiddle_source, ht2] using hvleft))
      · simpa [Cross.deletedRightMiddle_target] using ht1)

/-- The deleted right middle row segment is edge-disjoint from the right
replacement row. -/
theorem deletedRightMiddle_edgeDisjoint_rightReplacementPath :
    Cross.deletedRightMiddle.EdgeDisjoint Cross.replacementPaths.rightPath :=
  graphPath_edgeDisjoint_of_vertex_inter_subset_singleton
    (x := Cross.t2) (by
      intro v hvdel hvright
      rcases Cross.deletedRightMiddle_inter_rightPath_endpoint hvdel hvright
        with ht2 | ht1
      · simpa [Cross.deletedRightMiddle_source] using ht2
      · exact False.elim (Cross.t1_not_mem_rightReplacementPath
          (by simpa [Cross.deletedRightMiddle_target, ht1] using hvright)))

/-- The left switched row uses only edges from the two old rows and the fixed
`Q₀` family. -/
theorem replacementPaths_left_edgeSet_subset_rows_union_Q0 :
    Cross.replacementPaths.leftPath.edgeSet ⊆
      ((I.rowPath Cross.rowLeft).edgeSet ∪
          (I.rowPath Cross.rowRight).edgeSet) ∪ Q0.edgeSet := by
  classical
  intro e he
  have hraw := Cross.replacementPaths.left_edgeSet_subset he
  rcases Finset.mem_union.1 hraw with hrow_or_seg | hright
  · rcases Finset.mem_union.1 hrow_or_seg with hleft | hseg
    · exact Finset.mem_union.2 <| Or.inl <|
        Finset.mem_union.2 <| Or.inl hleft
    · have heqstar :
          e ∈ (Q0.data Cross.qIndex1 Cross.q_mem1).qstar.edgeSet :=
        Cross.segment1_edgeSet_subset_qstar hseg
      have heQ0 : e ∈ Q0.edgeSet := by
        exact Finset.mem_biUnion.mpr
          ⟨⟨Cross.qIndex1, Cross.q_mem1⟩, Finset.mem_attach _ _, heqstar⟩
      exact Finset.mem_union.2 (Or.inr heQ0)
  · exact Finset.mem_union.2 <| Or.inl <|
      Finset.mem_union.2 <| Or.inr hright

/-- The right switched row uses only edges from the two old rows and the fixed
`Q₀` family. -/
theorem replacementPaths_right_edgeSet_subset_rows_union_Q0 :
    Cross.replacementPaths.rightPath.edgeSet ⊆
      ((I.rowPath Cross.rowLeft).edgeSet ∪
          (I.rowPath Cross.rowRight).edgeSet) ∪ Q0.edgeSet := by
  classical
  intro e he
  have hraw := Cross.replacementPaths.right_edgeSet_subset he
  rcases Finset.mem_union.1 hraw with hrow_or_seg | hleft
  · rcases Finset.mem_union.1 hrow_or_seg with hright | hseg
    · exact Finset.mem_union.2 <| Or.inl <|
        Finset.mem_union.2 <| Or.inr hright
    · have heqstar :
          e ∈ (Q0.data Cross.qIndex2 Cross.q_mem2).qstar.edgeSet :=
        Cross.segment2_edgeSet_subset_qstar hseg
      have heQ0 : e ∈ Q0.edgeSet := by
        exact Finset.mem_biUnion.mpr
          ⟨⟨Cross.qIndex2, Cross.q_mem2⟩, Finset.mem_attach _ _, heqstar⟩
      exact Finset.mem_union.2 (Or.inr heQ0)
  · exact Finset.mem_union.2 <| Or.inl <|
      Finset.mem_union.2 <| Or.inl hleft

/-- The deleted left middle segment has an edge, because `s₁` and `s₂` are
distinct. -/
theorem deletedLeftMiddle_edgeSet_nonempty :
    Cross.deletedLeftMiddle.edgeSet.Nonempty := by
  have hne : Cross.deletedLeftMiddle.source ≠
      Cross.deletedLeftMiddle.target := by
    intro h
    exact Cross.s1_ne_s2 (by simpa using h)
  exact Cross.deletedLeftMiddle.edgeSet_nonempty_of_source_ne_target hne

/-- The deleted right middle segment has an edge, because `t₂` and `t₁` are
distinct. -/
theorem deletedRightMiddle_edgeSet_nonempty :
    Cross.deletedRightMiddle.edgeSet.Nonempty := by
  have hne : Cross.deletedRightMiddle.source ≠
      Cross.deletedRightMiddle.target := by
    intro h
    exact Cross.t2_ne_t1 h
  exact Cross.deletedRightMiddle.edgeSet_nonempty_of_source_ne_target hne

/-- The deleted left middle segment cannot be entirely contained in the fixed
`Q₀` edge set.  Otherwise ownership propagates along the connected row
segment from `s₁` to `s₂`, forcing the two distinct cross transversals to be
the same selected `Q*`. -/
theorem deletedLeftMiddle_edgeSet_not_subset_Q0 :
    ¬ Cross.deletedLeftMiddle.edgeSet ⊆ Q0.edgeSet := by
  intro hsub
  have howner :
      Cross.qIndex1 = Cross.qIndex2 :=
    Q0.qstar_owner_eq_of_graphPath_edges_subset
      Cross.deletedLeftMiddle
      (by
        simpa [Cross.deletedLeftMiddle_source] using
          Cross.s1_mem_qstar1)
      (by
        simpa [Cross.deletedLeftMiddle_target] using
          Cross.s2_mem_qstar2)
      hsub
  exact Cross.qIndex_ne howner

/-- The same ownership-propagation obstruction for the deleted right middle
segment. -/
theorem deletedRightMiddle_edgeSet_not_subset_Q0 :
    ¬ Cross.deletedRightMiddle.edgeSet ⊆ Q0.edgeSet := by
  intro hsub
  have howner :
      Cross.qIndex2 = Cross.qIndex1 :=
    Q0.qstar_owner_eq_of_graphPath_edges_subset
      Cross.deletedRightMiddle
      (by
        simpa [Cross.deletedRightMiddle_source] using
          Cross.t2_mem_qstar2)
      (by
        simpa [Cross.deletedRightMiddle_target] using
          Cross.t1_mem_qstar1)
      hsub
  exact Cross.qIndex_ne howner.symm

/-- The progress edge required at the end of the cross paragraph exists:
some edge of a deleted middle interval is not already an edge of the fixed
`Q₀` family.  In fact the left deleted middle interval alone suffices. -/
theorem exists_deletedMiddle_edge_not_mem_Q0 :
    ∃ deleted_edge : Sym2 V,
      (deleted_edge ∈ Cross.deletedLeftMiddle.edgeSet ∨
        deleted_edge ∈ Cross.deletedRightMiddle.edgeSet) ∧
        deleted_edge ∉ Q0.edgeSet := by
  classical
  by_contra hnone
  apply Cross.deletedLeftMiddle_edgeSet_not_subset_Q0
  intro e he
  by_contra hQ0
  exact hnone ⟨e, Or.inl he, hQ0⟩

theorem deletedLeftMiddle_edge_mem_tilde
    {e : Sym2 V} (he : e ∈ Cross.deletedLeftMiddle.edgeSet) :
    e ∈ I.tildeEdgeSet := by
  classical
  have herow : e ∈ (I.rowPath Cross.rowLeft).edgeSet :=
    Cross.deletedLeftMiddle_edgeSet_subset_row he
  have heRows : e ∈ I.rowEdgeSet := by
    exact Finset.mem_biUnion.mpr
      ⟨Cross.rowLeft, Finset.mem_univ _, herow⟩
  exact Finset.mem_union.2 (Or.inl heRows)

theorem deletedRightMiddle_edge_mem_tilde
    {e : Sym2 V} (he : e ∈ Cross.deletedRightMiddle.edgeSet) :
    e ∈ I.tildeEdgeSet := by
  classical
  have herow : e ∈ (I.rowPath Cross.rowRight).edgeSet :=
    Cross.deletedRightMiddle_edgeSet_subset_row he
  have heRows : e ∈ I.rowEdgeSet := by
    exact Finset.mem_biUnion.mpr
      ⟨Cross.rowRight, Finset.mem_univ _, herow⟩
  exact Finset.mem_union.2 (Or.inl heRows)

/-- If a successor maintained graph is contained in the old one and misses an
edge from the deleted left middle interval, then its edge count strictly
decreases. -/
theorem tilde_card_lt_of_missing_deletedLeftMiddle_edge
    {I' : IterationInput R hpos Q0} {e : Sym2 V}
    (hsub : I'.tildeEdgeSet ⊆ I.tildeEdgeSet)
    (he : e ∈ Cross.deletedLeftMiddle.edgeSet)
    (hmiss : e ∉ I'.tildeEdgeSet) :
    I'.tildeEdgeSet.card < I.tildeEdgeSet.card := by
  have hssub : I'.tildeEdgeSet ⊂ I.tildeEdgeSet := by
    refine ⟨hsub, ?_⟩
    intro hrev
    exact hmiss (hrev (Cross.deletedLeftMiddle_edge_mem_tilde he))
  exact Finset.card_lt_card hssub

/-- Same strict-decrease criterion using the deleted right middle interval. -/
theorem tilde_card_lt_of_missing_deletedRightMiddle_edge
    {I' : IterationInput R hpos Q0} {e : Sym2 V}
    (hsub : I'.tildeEdgeSet ⊆ I.tildeEdgeSet)
    (he : e ∈ Cross.deletedRightMiddle.edgeSet)
    (hmiss : e ∉ I'.tildeEdgeSet) :
    I'.tildeEdgeSet.card < I.tildeEdgeSet.card := by
  have hssub : I'.tildeEdgeSet ⊂ I.tildeEdgeSet := by
    refine ⟨hsub, ?_⟩
    intro hrev
    exact hmiss (hrev (Cross.deletedRightMiddle_edge_mem_tilde he))
  exact Finset.card_lt_card hssub

/-- The linkage `L''` obtained by performing the cross switch.

The disjointness hypotheses are the remaining geometric checks: the two new
switched rows must be disjoint from each other, and each must be disjoint from
all unchanged linkage paths.  The endpoint bookkeeping is handled by
`PerfectPathPacking.replaceTwoPathsSwapTargets`: the two new rows keep their
old `A`-endpoints and exchange their `B`-endpoints. -/
noncomputable def replacementLinkage
    (hleft_right :
      Cross.replacementPaths.leftPath.NodeDisjoint
        Cross.replacementPaths.rightPath)
    (hleft_disj :
      ∀ i : I.linkage.Index,
        i ≠ I.rowIndex Cross.rowLeft →
          i ≠ I.rowIndex Cross.rowRight →
            Cross.replacementPaths.leftPath.NodeDisjoint
              (I.linkage.path i))
    (hright_disj :
      ∀ i : I.linkage.Index,
        i ≠ I.rowIndex Cross.rowLeft →
          i ≠ I.rowIndex Cross.rowRight →
            Cross.replacementPaths.rightPath.NodeDisjoint
              (I.linkage.path i)) :
    PerfectPathPacking G A B :=
  PerfectPathPacking.replaceTwoPathsSwapTargets I.linkage
    (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
    Cross.rowIndex_ne
    Cross.replacementPaths.leftPath Cross.replacementPaths.rightPath
    (by
      rw [Cross.replacementPaths.left_source_eq]
      exact congrArg GraphPath.source
        (I.rowPath_eq_linkage_path Cross.rowLeft))
    (by
      rw [Cross.replacementPaths.left_target_eq]
      exact congrArg GraphPath.target
        (I.rowPath_eq_linkage_path Cross.rowRight))
    (by
      rw [Cross.replacementPaths.right_source_eq]
      exact congrArg GraphPath.source
        (I.rowPath_eq_linkage_path Cross.rowRight))
    (by
      rw [Cross.replacementPaths.right_target_eq]
      exact congrArg GraphPath.target
        (I.rowPath_eq_linkage_path Cross.rowLeft))
    hleft_right hleft_disj hright_disj

/-- Cross replacement linkage using the internally proved disjointness of the
two switched rows.  The only remaining disjointness obligations are against
unchanged linkage paths. -/
noncomputable def replacementLinkageOfDisjointUnchanged
    (hleft_disj :
      ∀ i : I.linkage.Index,
        i ≠ I.rowIndex Cross.rowLeft →
          i ≠ I.rowIndex Cross.rowRight →
            Cross.replacementPaths.leftPath.NodeDisjoint
              (I.linkage.path i))
    (hright_disj :
      ∀ i : I.linkage.Index,
        i ≠ I.rowIndex Cross.rowLeft →
          i ≠ I.rowIndex Cross.rowRight →
            Cross.replacementPaths.rightPath.NodeDisjoint
              (I.linkage.path i)) :
    PerfectPathPacking G A B :=
  Cross.replacementLinkage Cross.replacementPaths_nodeDisjoint
    hleft_disj hright_disj

/-- The cross replacement linkage with all vertex-disjointness checks
discharged from the cross hypotheses.  This is the formal Figure 8
construction: the two new paths are disjoint from each other and from every
unchanged linkage path, and they exchange the two old `B`-endpoints. -/
noncomputable def replacementLinkageConcrete : PerfectPathPacking G A B :=
  Cross.replacementLinkageOfDisjointUnchanged
    (fun _ hileft hiright =>
      Cross.replacementPaths_left_nodeDisjoint_unchanged hileft hiright)
    (fun _ hileft hiright =>
      Cross.replacementPaths_right_nodeDisjoint_unchanged hileft hiright)

@[simp] theorem replacementLinkageOfDisjointUnchanged_eq
    (hleft_disj :
      ∀ i : I.linkage.Index,
        i ≠ I.rowIndex Cross.rowLeft →
          i ≠ I.rowIndex Cross.rowRight →
            Cross.replacementPaths.leftPath.NodeDisjoint
              (I.linkage.path i))
    (hright_disj :
      ∀ i : I.linkage.Index,
        i ≠ I.rowIndex Cross.rowLeft →
          i ≠ I.rowIndex Cross.rowRight →
            Cross.replacementPaths.rightPath.NodeDisjoint
              (I.linkage.path i)) :
    Cross.replacementLinkageOfDisjointUnchanged hleft_disj hright_disj =
      Cross.replacementLinkage Cross.replacementPaths_nodeDisjoint
        hleft_disj hright_disj := rfl

@[simp] theorem replacementLinkage_path_left
    (hleft_right :
      Cross.replacementPaths.leftPath.NodeDisjoint
        Cross.replacementPaths.rightPath)
    (hleft_disj :
      ∀ i : I.linkage.Index,
        i ≠ I.rowIndex Cross.rowLeft →
          i ≠ I.rowIndex Cross.rowRight →
            Cross.replacementPaths.leftPath.NodeDisjoint
              (I.linkage.path i))
    (hright_disj :
      ∀ i : I.linkage.Index,
        i ≠ I.rowIndex Cross.rowLeft →
          i ≠ I.rowIndex Cross.rowRight →
            Cross.replacementPaths.rightPath.NodeDisjoint
              (I.linkage.path i)) :
    (Cross.replacementLinkage hleft_right hleft_disj hright_disj).path
      (I.rowIndex Cross.rowLeft) =
        Cross.replacementPaths.leftPath := by
  simp [replacementLinkage]

@[simp] theorem replacementLinkage_path_right
    (hleft_right :
      Cross.replacementPaths.leftPath.NodeDisjoint
        Cross.replacementPaths.rightPath)
    (hleft_disj :
      ∀ i : I.linkage.Index,
        i ≠ I.rowIndex Cross.rowLeft →
          i ≠ I.rowIndex Cross.rowRight →
            Cross.replacementPaths.leftPath.NodeDisjoint
              (I.linkage.path i))
    (hright_disj :
      ∀ i : I.linkage.Index,
        i ≠ I.rowIndex Cross.rowLeft →
          i ≠ I.rowIndex Cross.rowRight →
            Cross.replacementPaths.rightPath.NodeDisjoint
              (I.linkage.path i)) :
    (Cross.replacementLinkage hleft_right hleft_disj hright_disj).path
      (I.rowIndex Cross.rowRight) =
        Cross.replacementPaths.rightPath := by
  simp [replacementLinkage]

@[simp] theorem replacementLinkage_path_of_ne
    (hleft_right :
      Cross.replacementPaths.leftPath.NodeDisjoint
        Cross.replacementPaths.rightPath)
    (hleft_disj :
      ∀ i : I.linkage.Index,
        i ≠ I.rowIndex Cross.rowLeft →
          i ≠ I.rowIndex Cross.rowRight →
            Cross.replacementPaths.leftPath.NodeDisjoint
              (I.linkage.path i))
    (hright_disj :
      ∀ i : I.linkage.Index,
        i ≠ I.rowIndex Cross.rowLeft →
          i ≠ I.rowIndex Cross.rowRight →
            Cross.replacementPaths.rightPath.NodeDisjoint
              (I.linkage.path i))
    {i : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight) :
    (Cross.replacementLinkage hleft_right hleft_disj hright_disj).path i =
      I.linkage.path i := by
  simp [replacementLinkage, hileft, hiright]

@[simp] theorem replacementLinkageConcrete_path_left :
    Cross.replacementLinkageConcrete.path (I.rowIndex Cross.rowLeft) =
      Cross.replacementPaths.leftPath := by
  simp [replacementLinkageConcrete]

@[simp] theorem replacementLinkageConcrete_path_right :
    Cross.replacementLinkageConcrete.path (I.rowIndex Cross.rowRight) =
      Cross.replacementPaths.rightPath := by
  simp [replacementLinkageConcrete]

@[simp] theorem replacementLinkageConcrete_path_of_ne
    {i : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight) :
    Cross.replacementLinkageConcrete.path i = I.linkage.path i := by
  simp [replacementLinkageConcrete, hileft, hiright]

/-- Any old linkage vertex that is no longer a linkage vertex after the cross
lies in one of the two deleted middle row intervals. -/
theorem old_link_vertex_not_new_mem_deletedMiddle
    {v : V} (hold : v ∈ I.linkage.toPathPacking.vertexSet)
    (hnew : v ∉ Cross.replacementLinkageConcrete.toPathPacking.vertexSet) :
    v ∈ Cross.deletedMiddleVertexSet := by
  classical
  rcases (I.linkage.toPathPacking.mem_vertexSet).1 hold with ⟨i, hvi⟩
  by_cases hileft : i = I.rowIndex Cross.rowLeft
  · subst hileft
    have hvrow : v ∈ (I.rowPath Cross.rowLeft).vertexSet := by
      simpa [I.rowPath_eq_linkage_path Cross.rowLeft] using hvi
    rcases Cross.left_row_vertex_mem_prefix_or_deleted_or_suffix hvrow with
      hpre | hdel | hsuf
    · have hvleft :
          v ∈ Cross.replacementPaths.leftPath.vertexSet :=
        Cross.replacementPaths.left_prefix_subset_leftPath hpre
      have hvnew :
          v ∈ Cross.replacementLinkageConcrete.toPathPacking.vertexSet :=
        (Cross.replacementLinkageConcrete.toPathPacking.mem_vertexSet).2
          ⟨I.rowIndex Cross.rowLeft, by
            simpa [Cross.replacementLinkageConcrete_path_left] using hvleft⟩
      exact False.elim (hnew hvnew)
    · exact Finset.mem_union.2 (Or.inl hdel)
    · have hvright :
          v ∈ Cross.replacementPaths.rightPath.vertexSet :=
        Cross.replacementPaths.left_suffix_subset_rightPath hsuf
      have hvnew :
          v ∈ Cross.replacementLinkageConcrete.toPathPacking.vertexSet :=
        (Cross.replacementLinkageConcrete.toPathPacking.mem_vertexSet).2
          ⟨I.rowIndex Cross.rowRight, by
            simpa [Cross.replacementLinkageConcrete_path_right] using hvright⟩
      exact False.elim (hnew hvnew)
  · by_cases hiright : i = I.rowIndex Cross.rowRight
    · subst hiright
      have hvrow : v ∈ (I.rowPath Cross.rowRight).vertexSet := by
        simpa [I.rowPath_eq_linkage_path Cross.rowRight] using hvi
      rcases Cross.right_row_vertex_mem_prefix_or_deleted_or_suffix hvrow with
        hpre | hdel | hsuf
      · have hvright :
            v ∈ Cross.replacementPaths.rightPath.vertexSet :=
          Cross.replacementPaths.right_prefix_subset_rightPath hpre
        have hvnew :
            v ∈ Cross.replacementLinkageConcrete.toPathPacking.vertexSet :=
          (Cross.replacementLinkageConcrete.toPathPacking.mem_vertexSet).2
            ⟨I.rowIndex Cross.rowRight, by
              simpa [Cross.replacementLinkageConcrete_path_right] using hvright⟩
        exact False.elim (hnew hvnew)
      · exact Finset.mem_union.2 (Or.inr hdel)
      · have hvleft :
            v ∈ Cross.replacementPaths.leftPath.vertexSet :=
          Cross.replacementPaths.right_suffix_subset_leftPath hsuf
        have hvnew :
            v ∈ Cross.replacementLinkageConcrete.toPathPacking.vertexSet :=
          (Cross.replacementLinkageConcrete.toPathPacking.mem_vertexSet).2
            ⟨I.rowIndex Cross.rowLeft, by
              simpa [Cross.replacementLinkageConcrete_path_left] using hvleft⟩
        exact False.elim (hnew hvnew)
    · have hvnew_path :
          v ∈ (Cross.replacementLinkageConcrete.path i).vertexSet := by
        simpa [Cross.replacementLinkageConcrete_path_of_ne hileft hiright]
          using hvi
      have hvnew :
          v ∈ Cross.replacementLinkageConcrete.toPathPacking.vertexSet :=
        (Cross.replacementLinkageConcrete.toPathPacking.mem_vertexSet).2
          ⟨i, hvnew_path⟩
      exact False.elim (hnew hvnew)

/-- Any new linkage vertex that was not already an old linkage vertex lies in
one of the two inserted transversal segments. -/
theorem new_link_vertex_not_old_mem_insertedSegment
    {v : V}
    (hnew : v ∈ Cross.replacementLinkageConcrete.toPathPacking.vertexSet)
    (hold : v ∉ I.linkage.toPathPacking.vertexSet) :
    v ∈ Cross.insertedSegmentVertexSet := by
  classical
  rcases (Cross.replacementLinkageConcrete.toPathPacking.mem_vertexSet).1
      hnew with ⟨i, hvi⟩
  by_cases hileft : i = I.rowIndex Cross.rowLeft
  · subst hileft
    have hvleft : v ∈ Cross.replacementPaths.leftPath.vertexSet := by
      simpa [Cross.replacementLinkageConcrete_path_left] using hvi
    have hparts := Cross.replacementPaths.left_vertexSet_subset_parts hvleft
    rcases Finset.mem_union.1 hparts with hpre_or_seg | hrsuf
    · rcases Finset.mem_union.1 hpre_or_seg with hpre | hseg
      · have hvrow :
            v ∈ (I.rowPath Cross.rowLeft).vertexSet :=
          (I.rowPath Cross.rowLeft).takeUntil_vertexSet_subset
            Cross.s1_mem_left hpre
        have hvold :
            v ∈ I.linkage.toPathPacking.vertexSet :=
          (I.linkage.toPathPacking.mem_vertexSet).2
            ⟨I.rowIndex Cross.rowLeft, by
              simpa [I.rowPath_eq_linkage_path Cross.rowLeft] using hvrow⟩
        exact False.elim (hold hvold)
      · exact Finset.mem_union.2 <| Or.inl <|
          by simpa [Cross.orientedSegment1_vertexSet] using hseg
    · have hvrow :
          v ∈ (I.rowPath Cross.rowRight).vertexSet :=
        (I.rowPath Cross.rowRight).dropUntil_vertexSet_subset
          Cross.t1_mem_right hrsuf
      have hvold :
          v ∈ I.linkage.toPathPacking.vertexSet :=
        (I.linkage.toPathPacking.mem_vertexSet).2
          ⟨I.rowIndex Cross.rowRight, by
            simpa [I.rowPath_eq_linkage_path Cross.rowRight] using hvrow⟩
      exact False.elim (hold hvold)
  · by_cases hiright : i = I.rowIndex Cross.rowRight
    · subst hiright
      have hvright : v ∈ Cross.replacementPaths.rightPath.vertexSet := by
        simpa [Cross.replacementLinkageConcrete_path_right] using hvi
      have hparts := Cross.replacementPaths.right_vertexSet_subset_parts hvright
      rcases Finset.mem_union.1 hparts with hpre_or_seg | hlsuf
      · rcases Finset.mem_union.1 hpre_or_seg with hpre | hseg
        · have hvrow :
              v ∈ (I.rowPath Cross.rowRight).vertexSet :=
            (I.rowPath Cross.rowRight).takeUntil_vertexSet_subset
              Cross.t2_mem_right hpre
          have hvold :
              v ∈ I.linkage.toPathPacking.vertexSet :=
            (I.linkage.toPathPacking.mem_vertexSet).2
              ⟨I.rowIndex Cross.rowRight, by
                simpa [I.rowPath_eq_linkage_path Cross.rowRight] using hvrow⟩
          exact False.elim (hold hvold)
        · exact Finset.mem_union.2 <| Or.inr <|
            by simpa [Cross.orientedSegment2_vertexSet] using hseg
      · have hvrow :
            v ∈ (I.rowPath Cross.rowLeft).vertexSet :=
          (I.rowPath Cross.rowLeft).dropUntil_vertexSet_subset
            Cross.s2_mem_left hlsuf
        have hvold :
            v ∈ I.linkage.toPathPacking.vertexSet :=
          (I.linkage.toPathPacking.mem_vertexSet).2
            ⟨I.rowIndex Cross.rowLeft, by
              simpa [I.rowPath_eq_linkage_path Cross.rowLeft] using hvrow⟩
        exact False.elim (hold hvold)
    · have hvold_path :
          v ∈ (I.linkage.path i).vertexSet := by
        simpa [Cross.replacementLinkageConcrete_path_of_ne hileft hiright]
          using hvi
      have hvold :
          v ∈ I.linkage.toPathPacking.vertexSet :=
        (I.linkage.toPathPacking.mem_vertexSet).2 ⟨i, hvold_path⟩
      exact False.elim (hold hvold)

/-- A path that is clean for the successor linkage and misses the two deleted
middle intervals is clean for the old linkage. -/
theorem internallyDisjoint_old_of_new_clean_disjoint_deleted
    (P : GraphPath G)
    (hclean :
      P.InternallyDisjointFromSet
        Cross.replacementLinkageConcrete.toPathPacking.vertexSet)
    (hmiss : Disjoint P.vertexSet Cross.deletedMiddleVertexSet) :
    P.InternallyDisjointFromSet I.linkage.toPathPacking.vertexSet := by
  intro v hvP hvold
  by_cases hvnew :
      v ∈ Cross.replacementLinkageConcrete.toPathPacking.vertexSet
  · exact hclean hvP hvnew
  · have hvdel := Cross.old_link_vertex_not_new_mem_deletedMiddle hvold hvnew
    exact False.elim (Finset.disjoint_left.mp hmiss hvP hvdel)

/-- A path that is clean for the old linkage and misses the inserted
transversal pieces is clean for the successor linkage. -/
theorem internallyDisjoint_new_of_old_clean_disjoint_inserted
    (P : GraphPath G)
    (hclean :
      P.InternallyDisjointFromSet I.linkage.toPathPacking.vertexSet)
    (hmiss : Disjoint P.vertexSet Cross.insertedSegmentVertexSet) :
    P.InternallyDisjointFromSet
      Cross.replacementLinkageConcrete.toPathPacking.vertexSet := by
  intro v hvP hvnew
  by_cases hvold : v ∈ I.linkage.toPathPacking.vertexSet
  · exact hclean hvP hvold
  · have hvins := Cross.new_link_vertex_not_old_mem_insertedSegment hvnew hvold
    exact False.elim (Finset.disjoint_left.mp hmiss hvP hvins)

/-- A successor bridge between two unchanged linkage paths is already an old
bridge, provided the bridge path misses the two deleted middle row intervals. -/
theorem old_aux_adj_of_new_bridge_unchanged_miss_deleted
    {i j : I.linkage.Index} (hij : i ≠ j)
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (hjleft : j ≠ I.rowIndex Cross.rowLeft)
    (hjright : j ≠ I.rowIndex Cross.rowRight)
    (β :
      Cross.replacementLinkageConcrete.toPathPacking.BridgeBetween i j)
    (hmiss : Disjoint β.orientedPath.vertexSet Cross.deletedMiddleVertexSet) :
    (linkageAuxGraph I.linkage).Adj i j := by
  refine ⟨hij, Or.inl ?_⟩
  refine ⟨PathPacking.BridgeBetween.of_orientedPath
    I.linkage.toPathPacking β.orientedPath ?_ ?_ ?_⟩
  · have hsrc :=
      PathPacking.BridgeBetween.orientedPath_source_mem_left β
    simpa [Cross.replacementLinkageConcrete_path_of_ne hileft hiright]
      using hsrc
  · have htgt :=
      PathPacking.BridgeBetween.orientedPath_target_mem_right β
    simpa [Cross.replacementLinkageConcrete_path_of_ne hjleft hjright]
      using htgt
  · exact Cross.internallyDisjoint_old_of_new_clean_disjoint_deleted
      β.orientedPath β.orientedPath_internallyDisjoint hmiss

/-- An old bridge between two unchanged linkage paths is still a successor
bridge, provided it misses the inserted transversal segments. -/
theorem new_aux_adj_of_old_bridge_unchanged_miss_inserted
    {i j : I.linkage.Index} (hij : i ≠ j)
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (hjleft : j ≠ I.rowIndex Cross.rowLeft)
    (hjright : j ≠ I.rowIndex Cross.rowRight)
    (β : I.linkage.toPathPacking.BridgeBetween i j)
    (hmiss : Disjoint β.orientedPath.vertexSet Cross.insertedSegmentVertexSet) :
    (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j := by
  refine ⟨hij, Or.inl ?_⟩
  refine ⟨PathPacking.BridgeBetween.of_orientedPath
    Cross.replacementLinkageConcrete.toPathPacking β.orientedPath ?_ ?_ ?_⟩
  · have hsrc :=
      PathPacking.BridgeBetween.orientedPath_source_mem_left β
    simpa [Cross.replacementLinkageConcrete_path_of_ne hileft hiright]
      using hsrc
  · have htgt :=
      PathPacking.BridgeBetween.orientedPath_target_mem_right β
    simpa [Cross.replacementLinkageConcrete_path_of_ne hjleft hjright]
      using htgt
  · exact Cross.internallyDisjoint_new_of_old_clean_disjoint_inserted
      β.orientedPath β.orientedPath_internallyDisjoint hmiss

/-- Edge-level version of
`old_aux_adj_of_new_bridge_unchanged_miss_deleted`, allowing either bridge
orientation in the auxiliary graph definition. -/
theorem old_aux_adj_of_new_aux_adj_unchanged_miss_deleted
    {i j : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (hjleft : j ≠ I.rowIndex Cross.rowLeft)
    (hjright : j ≠ I.rowIndex Cross.rowRight)
    (hadj : (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j)
    (hmiss :
      ∀ β :
        Cross.replacementLinkageConcrete.toPathPacking.BridgeBetween i j,
        Disjoint β.orientedPath.vertexSet Cross.deletedMiddleVertexSet)
    (hmiss_rev :
      ∀ β :
        Cross.replacementLinkageConcrete.toPathPacking.BridgeBetween j i,
        Disjoint β.orientedPath.vertexSet Cross.deletedMiddleVertexSet) :
    (linkageAuxGraph I.linkage).Adj i j := by
  rcases hadj with ⟨hij, hbridge⟩
  rcases hbridge with hβ | hβ
  · rcases hβ with ⟨β⟩
    exact Cross.old_aux_adj_of_new_bridge_unchanged_miss_deleted
      hij hileft hiright hjleft hjright β (hmiss β)
  · rcases hβ with ⟨β⟩
    exact (linkageAuxGraph I.linkage).symm
      (Cross.old_aux_adj_of_new_bridge_unchanged_miss_deleted
        hij.symm hjleft hjright hileft hiright β (hmiss_rev β))

/-- Edge-level version of
`new_aux_adj_of_old_bridge_unchanged_miss_inserted`, allowing either bridge
orientation in the auxiliary graph definition. -/
theorem new_aux_adj_of_old_aux_adj_unchanged_miss_inserted
    {i j : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (hjleft : j ≠ I.rowIndex Cross.rowLeft)
    (hjright : j ≠ I.rowIndex Cross.rowRight)
    (hadj : (linkageAuxGraph I.linkage).Adj i j)
    (hmiss :
      ∀ β : I.linkage.toPathPacking.BridgeBetween i j,
        Disjoint β.orientedPath.vertexSet Cross.insertedSegmentVertexSet)
    (hmiss_rev :
      ∀ β : I.linkage.toPathPacking.BridgeBetween j i,
        Disjoint β.orientedPath.vertexSet Cross.insertedSegmentVertexSet) :
    (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j := by
  rcases hadj with ⟨hij, hbridge⟩
  rcases hbridge with hβ | hβ
  · rcases hβ with ⟨β⟩
    exact Cross.new_aux_adj_of_old_bridge_unchanged_miss_inserted
      hij hileft hiright hjleft hjright β (hmiss β)
  · rcases hβ with ⟨β⟩
    exact (linkageAuxGraph Cross.replacementLinkageConcrete).symm
      (Cross.new_aux_adj_of_old_bridge_unchanged_miss_inserted
        hij.symm hjleft hjright hileft hiright β (hmiss_rev β))

/-- If a successor-clean path is stopped at its first deleted-middle hit, the
prefix is clean with respect to the old linkage.  The only old-only linkage
vertices are deleted-middle vertices, and first-hit minimality allows such a
vertex only at the new prefix endpoint. -/
theorem cleanPrefixToDeleted_internallyDisjoint_old_of_new_clean
    (P : GraphPath G)
    (hclean :
      P.InternallyDisjointFromSet
        Cross.replacementLinkageConcrete.toPathPacking.vertexSet)
    (hne : (P.vertexSet ∩ Cross.deletedMiddleVertexSet).Nonempty) :
    (P.cleanPrefixToSet Cross.deletedMiddleVertexSet hne).InternallyDisjointFromSet
      I.linkage.toPathPacking.vertexSet := by
  intro v hvPrefix hvold
  have hcleanPrefixNew :
      (P.cleanPrefixToSet Cross.deletedMiddleVertexSet hne).InternallyDisjointFromSet
        Cross.replacementLinkageConcrete.toPathPacking.vertexSet := by
    simpa [GraphPath.cleanPrefixToSet] using
      P.takeUntil_internallyDisjointFromSet
        (P.firstHitVertex_mem_vertexSet Cross.deletedMiddleVertexSet hne)
        hclean
  by_cases hvnew :
      v ∈ Cross.replacementLinkageConcrete.toPathPacking.vertexSet
  · exact hcleanPrefixNew hvPrefix hvnew
  · have hvdel := Cross.old_link_vertex_not_new_mem_deletedMiddle hvold hvnew
    have hv_eq :
        v = P.firstHitVertex Cross.deletedMiddleVertexSet hne :=
      P.eq_firstHitVertex_of_mem_takeUntil_of_mem_set
        Cross.deletedMiddleVertexSet hne (by
          simpa [GraphPath.cleanPrefixToSet] using hvPrefix) hvdel
    exact Or.inr (by simp [GraphPath.cleanPrefixToSet, hv_eq])

/-- If a successor bridge from an unchanged row first hits a deleted middle
interval, that prefix witnesses an old auxiliary edge from the unchanged row
to one of the two crossed old rows. -/
theorem old_aux_adj_to_crossed_row_of_new_bridge_hits_deleted
    {i j : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (β :
      Cross.replacementLinkageConcrete.toPathPacking.BridgeBetween i j)
    (hne : (β.orientedPath.vertexSet ∩
      Cross.deletedMiddleVertexSet).Nonempty) :
    (linkageAuxGraph I.linkage).Adj i (I.rowIndex Cross.rowLeft) ∨
      (linkageAuxGraph I.linkage).Adj i (I.rowIndex Cross.rowRight) := by
  classical
  let P : GraphPath G := β.orientedPath
  let Prefix : GraphPath G :=
    P.cleanPrefixToSet Cross.deletedMiddleVertexSet hne
  have hsrc_new :
      P.source ∈
        (Cross.replacementLinkageConcrete.path i).vertexSet :=
    PathPacking.BridgeBetween.orientedPath_source_mem_left β
  have hsrc_old : Prefix.source ∈ (I.linkage.path i).vertexSet := by
    simpa [Prefix, P, Cross.replacementLinkageConcrete_path_of_ne hileft hiright]
      using hsrc_new
  have hclean_old :
      Prefix.InternallyDisjointFromSet I.linkage.toPathPacking.vertexSet := by
    simpa [Prefix, P] using
      Cross.cleanPrefixToDeleted_internallyDisjoint_old_of_new_clean
        P β.orientedPath_internallyDisjoint hne
  have htgt_del :
      Prefix.target ∈ Cross.deletedMiddleVertexSet := by
    simpa [Prefix, P] using
      P.cleanPrefixToSet_target_mem Cross.deletedMiddleVertexSet hne
  rcases Finset.mem_union.1 htgt_del with htgt_left | htgt_right
  · have htgt_old :
        Prefix.target ∈
          (I.linkage.path (I.rowIndex Cross.rowLeft)).vertexSet := by
      have htgt_row :
          Prefix.target ∈ (I.rowPath Cross.rowLeft).vertexSet :=
        (I.rowPath Cross.rowLeft).segmentOfBefore_vertexSet_subset
          Cross.s1_before_s2 htgt_left
      simpa [I.rowPath_eq_linkage_path Cross.rowLeft] using htgt_row
    exact Or.inl ⟨hileft, Or.inl
      ⟨PathPacking.BridgeBetween.of_orientedPath
        I.linkage.toPathPacking Prefix hsrc_old htgt_old hclean_old⟩⟩
  · have htgt_old :
        Prefix.target ∈
          (I.linkage.path (I.rowIndex Cross.rowRight)).vertexSet := by
      have htgt_row :
          Prefix.target ∈ (I.rowPath Cross.rowRight).vertexSet :=
        (I.rowPath Cross.rowRight).segmentOfBefore_vertexSet_subset
          Cross.t2_before_t1 htgt_right
      simpa [I.rowPath_eq_linkage_path Cross.rowRight] using htgt_row
    exact Or.inr ⟨hiright, Or.inl
      ⟨PathPacking.BridgeBetween.of_orientedPath
        I.linkage.toPathPacking Prefix hsrc_old htgt_old hclean_old⟩⟩

/-- In the old degree-two path, any vertex adjacent to either crossed row is
one of the displayed local vertices. -/
theorem mem_local_quad_of_old_adj_to_crossed_row
    {i auxA auxD : I.linkage.Index}
    (hAU_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Cross.rowLeft))
    (hUV_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight))
    (hVD_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hU_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowLeft) 2)
    (hV_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowRight) 2)
    (hA_ne_V : auxA ≠ I.rowIndex Cross.rowRight)
    (hU_ne_D : I.rowIndex Cross.rowLeft ≠ auxD)
    (hadj :
      (linkageAuxGraph I.linkage).Adj i (I.rowIndex Cross.rowLeft) ∨
        (linkageAuxGraph I.linkage).Adj i (I.rowIndex Cross.rowRight)) :
    i ∈ ({auxA, I.rowIndex Cross.rowLeft,
        I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index) := by
  classical
  rcases hadj with hleft | hright
  · have hi :
        i = auxA ∨ i = I.rowIndex Cross.rowRight := by
      have h := DegreeEquals.two_adj_eq_or_eq
        (G := linkageAuxGraph I.linkage) hU_old
        ((linkageAuxGraph I.linkage).symm hAU_old) hUV_old
        hA_ne_V ((linkageAuxGraph I.linkage).symm hleft)
      rcases h with h | h
      · exact Or.inl h
      · exact Or.inr h
    rcases hi with rfl | rfl <;> simp
  · have hi :
        i = I.rowIndex Cross.rowLeft ∨ i = auxD := by
      have h := DegreeEquals.two_adj_eq_or_eq
        (G := linkageAuxGraph I.linkage) hV_old
        ((linkageAuxGraph I.linkage).symm hUV_old) hVD_old
        hU_ne_D ((linkageAuxGraph I.linkage).symm hright)
      rcases h with h | h
      · exact Or.inl h
      · exact Or.inr h
    rcases hi with rfl | rfl <;> simp

/-- If the first inserted hit of an old bridge lies on the first inserted
cross segment, then the bridge prefix, possibly followed along that segment,
witnesses an old auxiliary edge to one of the crossed rows. -/
theorem old_aux_adj_to_crossed_row_of_old_bridge_first_inserted_in_segment1
    {i j : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (β : I.linkage.toPathPacking.BridgeBetween i j)
    (hne : (β.orientedPath.vertexSet ∩
      Cross.insertedSegmentVertexSet).Nonempty)
    (hxseg :
      (β.orientedPath.cleanPrefixToSet
        Cross.insertedSegmentVertexSet hne).target ∈
          Cross.orientedSegment1.vertexSet) :
    (linkageAuxGraph I.linkage).Adj i (I.rowIndex Cross.rowLeft) ∨
      (linkageAuxGraph I.linkage).Adj i (I.rowIndex Cross.rowRight) := by
  classical
  let P : GraphPath G := β.orientedPath
  let Prefix : GraphPath G :=
    P.cleanPrefixToSet Cross.insertedSegmentVertexSet hne
  have hsrc_old : Prefix.source ∈ (I.linkage.path i).vertexSet := by
    simpa [Prefix, P] using
      PathPacking.BridgeBetween.orientedPath_source_mem_left β
  have hprefix_clean :
      Prefix.InternallyDisjointFromSet I.linkage.toPathPacking.vertexSet := by
    simpa [Prefix, P, GraphPath.cleanPrefixToSet] using
      P.takeUntil_internallyDisjointFromSet
        (P.firstHitVertex_mem_vertexSet Cross.insertedSegmentVertexSet hne)
        β.orientedPath_internallyDisjoint
  by_cases hxold : Prefix.target ∈ I.linkage.toPathPacking.vertexSet
  · have hend := Cross.orientedSegment1_clean_linkage hxseg hxold
    rcases hend with hs1 | ht1
    · have htgt_old :
          Prefix.target ∈
            (I.linkage.path (I.rowIndex Cross.rowLeft)).vertexSet := by
        have hrow : Prefix.target ∈ (I.rowPath Cross.rowLeft).vertexSet := by
          rw [hs1, Cross.orientedSegment1_source]
          exact Cross.s1_mem_left
        simpa [I.rowPath_eq_linkage_path Cross.rowLeft] using hrow
      exact Or.inl ⟨hileft, Or.inl
        ⟨PathPacking.BridgeBetween.of_orientedPath
          I.linkage.toPathPacking Prefix hsrc_old htgt_old hprefix_clean⟩⟩
    · have htgt_old :
          Prefix.target ∈
            (I.linkage.path (I.rowIndex Cross.rowRight)).vertexSet := by
        have hrow : Prefix.target ∈ (I.rowPath Cross.rowRight).vertexSet := by
          rw [ht1, Cross.orientedSegment1_target]
          exact Cross.t1_mem_right
        simpa [I.rowPath_eq_linkage_path Cross.rowRight] using hrow
      exact Or.inr ⟨hiright, Or.inl
        ⟨PathPacking.BridgeBetween.of_orientedPath
          I.linkage.toPathPacking Prefix hsrc_old htgt_old hprefix_clean⟩⟩
  · let Tail : GraphPath G := Cross.orientedSegment1.dropUntil hxseg
    have hglue : Prefix.target = Tail.source := by
      simp [Tail, Prefix, P]
    have hinter :
        ∀ ⦃v : V⦄, v ∈ Prefix.vertexSet → v ∈ Tail.vertexSet →
          v = Prefix.target := by
      intro v hvpre hvtail
      have hvtail_seg :
          v ∈ Cross.orientedSegment1.vertexSet :=
        Cross.orientedSegment1.dropUntil_vertexSet_subset hxseg
          (by simpa [Tail] using hvtail)
      have hvins : v ∈ Cross.insertedSegmentVertexSet :=
        Finset.mem_union.2 (Or.inl hvtail_seg)
      have hv_eq :
          v = P.firstHitVertex Cross.insertedSegmentVertexSet hne :=
        P.eq_firstHitVertex_of_mem_takeUntil_of_mem_set
          Cross.insertedSegmentVertexSet hne
          (by simpa [Prefix, GraphPath.cleanPrefixToSet] using hvpre) hvins
      simpa [Prefix, P, GraphPath.cleanPrefixToSet] using hv_eq
    let Joined : GraphPath G :=
      Prefix.appendWithEqOfInterSubsetTarget Tail hglue hinter
    have htail_clean :
        Tail.InternallyDisjointFromSet I.linkage.toPathPacking.vertexSet := by
      simpa [Tail] using
        Cross.orientedSegment1.dropUntil_internallyDisjointFromSet
          hxseg Cross.orientedSegment1_clean_linkage
    have hjoined_clean :
        Joined.InternallyDisjointFromSet I.linkage.toPathPacking.vertexSet := by
      simpa [Joined] using
        Prefix.appendWithEqOfInterSubsetTarget_internallyDisjointFromSet
          Tail hglue hinter hprefix_clean htail_clean hxold
    have hjoined_src : Joined.source ∈ (I.linkage.path i).vertexSet := by
      simpa [Joined] using hsrc_old
    have hjoined_tgt :
        Joined.target ∈
          (I.linkage.path (I.rowIndex Cross.rowRight)).vertexSet := by
      have htgt : Joined.target = Cross.t1 := by
        simp [Joined, Tail]
      have hrow : Joined.target ∈ (I.rowPath Cross.rowRight).vertexSet := by
        simpa [htgt] using Cross.t1_mem_right
      simpa [I.rowPath_eq_linkage_path Cross.rowRight] using hrow
    exact Or.inr ⟨hiright, Or.inl
      ⟨PathPacking.BridgeBetween.of_orientedPath
        I.linkage.toPathPacking Joined hjoined_src hjoined_tgt hjoined_clean⟩⟩

/-- Symmetric version of
`old_aux_adj_to_crossed_row_of_old_bridge_first_inserted_in_segment1` for the
second inserted cross segment. -/
theorem old_aux_adj_to_crossed_row_of_old_bridge_first_inserted_in_segment2
    {i j : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (β : I.linkage.toPathPacking.BridgeBetween i j)
    (hne : (β.orientedPath.vertexSet ∩
      Cross.insertedSegmentVertexSet).Nonempty)
    (hxseg :
      (β.orientedPath.cleanPrefixToSet
        Cross.insertedSegmentVertexSet hne).target ∈
          Cross.orientedSegment2.vertexSet) :
    (linkageAuxGraph I.linkage).Adj i (I.rowIndex Cross.rowLeft) ∨
      (linkageAuxGraph I.linkage).Adj i (I.rowIndex Cross.rowRight) := by
  classical
  let P : GraphPath G := β.orientedPath
  let Prefix : GraphPath G :=
    P.cleanPrefixToSet Cross.insertedSegmentVertexSet hne
  have hsrc_old : Prefix.source ∈ (I.linkage.path i).vertexSet := by
    simpa [Prefix, P] using
      PathPacking.BridgeBetween.orientedPath_source_mem_left β
  have hprefix_clean :
      Prefix.InternallyDisjointFromSet I.linkage.toPathPacking.vertexSet := by
    simpa [Prefix, P, GraphPath.cleanPrefixToSet] using
      P.takeUntil_internallyDisjointFromSet
        (P.firstHitVertex_mem_vertexSet Cross.insertedSegmentVertexSet hne)
        β.orientedPath_internallyDisjoint
  by_cases hxold : Prefix.target ∈ I.linkage.toPathPacking.vertexSet
  · have hend := Cross.orientedSegment2_clean_linkage hxseg hxold
    rcases hend with ht2 | hs2
    · have htgt_old :
          Prefix.target ∈
            (I.linkage.path (I.rowIndex Cross.rowRight)).vertexSet := by
        have hrow : Prefix.target ∈ (I.rowPath Cross.rowRight).vertexSet := by
          rw [ht2, Cross.orientedSegment2_source]
          exact Cross.t2_mem_right
        simpa [I.rowPath_eq_linkage_path Cross.rowRight] using hrow
      exact Or.inr ⟨hiright, Or.inl
        ⟨PathPacking.BridgeBetween.of_orientedPath
          I.linkage.toPathPacking Prefix hsrc_old htgt_old hprefix_clean⟩⟩
    · have htgt_old :
          Prefix.target ∈
            (I.linkage.path (I.rowIndex Cross.rowLeft)).vertexSet := by
        have hrow : Prefix.target ∈ (I.rowPath Cross.rowLeft).vertexSet := by
          rw [hs2, Cross.orientedSegment2_target]
          exact Cross.s2_mem_left
        simpa [I.rowPath_eq_linkage_path Cross.rowLeft] using hrow
      exact Or.inl ⟨hileft, Or.inl
        ⟨PathPacking.BridgeBetween.of_orientedPath
          I.linkage.toPathPacking Prefix hsrc_old htgt_old hprefix_clean⟩⟩
  · let Tail : GraphPath G := Cross.orientedSegment2.dropUntil hxseg
    have hglue : Prefix.target = Tail.source := by
      simp [Tail, Prefix, P]
    have hinter :
        ∀ ⦃v : V⦄, v ∈ Prefix.vertexSet → v ∈ Tail.vertexSet →
          v = Prefix.target := by
      intro v hvpre hvtail
      have hvtail_seg :
          v ∈ Cross.orientedSegment2.vertexSet :=
        Cross.orientedSegment2.dropUntil_vertexSet_subset hxseg
          (by simpa [Tail] using hvtail)
      have hvins : v ∈ Cross.insertedSegmentVertexSet :=
        Finset.mem_union.2 (Or.inr hvtail_seg)
      have hv_eq :
          v = P.firstHitVertex Cross.insertedSegmentVertexSet hne :=
        P.eq_firstHitVertex_of_mem_takeUntil_of_mem_set
          Cross.insertedSegmentVertexSet hne
          (by simpa [Prefix, GraphPath.cleanPrefixToSet] using hvpre) hvins
      simpa [Prefix, P, GraphPath.cleanPrefixToSet] using hv_eq
    let Joined : GraphPath G :=
      Prefix.appendWithEqOfInterSubsetTarget Tail hglue hinter
    have htail_clean :
        Tail.InternallyDisjointFromSet I.linkage.toPathPacking.vertexSet := by
      simpa [Tail] using
        Cross.orientedSegment2.dropUntil_internallyDisjointFromSet
          hxseg Cross.orientedSegment2_clean_linkage
    have hjoined_clean :
        Joined.InternallyDisjointFromSet I.linkage.toPathPacking.vertexSet := by
      simpa [Joined] using
        Prefix.appendWithEqOfInterSubsetTarget_internallyDisjointFromSet
          Tail hglue hinter hprefix_clean htail_clean hxold
    have hjoined_src : Joined.source ∈ (I.linkage.path i).vertexSet := by
      simpa [Joined] using hsrc_old
    have hjoined_tgt :
        Joined.target ∈
          (I.linkage.path (I.rowIndex Cross.rowLeft)).vertexSet := by
      have htgt : Joined.target = Cross.s2 := by
        simp [Joined, Tail]
      have hrow : Joined.target ∈ (I.rowPath Cross.rowLeft).vertexSet := by
        simpa [htgt] using Cross.s2_mem_left
      simpa [I.rowPath_eq_linkage_path Cross.rowLeft] using hrow
    exact Or.inl ⟨hileft, Or.inl
      ⟨PathPacking.BridgeBetween.of_orientedPath
        I.linkage.toPathPacking Joined hjoined_src hjoined_tgt hjoined_clean⟩⟩

/-- Combined inserted-hit localization for old bridges: if an old bridge from
an unchanged row hits one of the inserted cross segments, then the unchanged
row has an old auxiliary edge to one of the crossed rows. -/
theorem old_aux_adj_to_crossed_row_of_old_bridge_hits_inserted
    {i j : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (β : I.linkage.toPathPacking.BridgeBetween i j)
    (hne : (β.orientedPath.vertexSet ∩
      Cross.insertedSegmentVertexSet).Nonempty) :
    (linkageAuxGraph I.linkage).Adj i (I.rowIndex Cross.rowLeft) ∨
      (linkageAuxGraph I.linkage).Adj i (I.rowIndex Cross.rowRight) := by
  have hx :
      (β.orientedPath.cleanPrefixToSet
        Cross.insertedSegmentVertexSet hne).target ∈
          Cross.insertedSegmentVertexSet := by
    exact β.orientedPath.cleanPrefixToSet_target_mem
      Cross.insertedSegmentVertexSet hne
  rcases Finset.mem_union.1 hx with hx1 | hx2
  · exact Cross.old_aux_adj_to_crossed_row_of_old_bridge_first_inserted_in_segment1
      hileft hiright β hne hx1
  · exact Cross.old_aux_adj_to_crossed_row_of_old_bridge_first_inserted_in_segment2
      hileft hiright β hne hx2

/-- If an old bridge between two unchanged rows does not survive as a
successor auxiliary edge, then the first endpoint must lie in the local
quadruple.  If the bridge misses the inserted segments it promotes to a
successor bridge, contradiction; otherwise the first inserted hit gives an old
edge to a crossed row, and degree-two saturation forces locality. -/
theorem mem_local_quad_of_old_bridge_not_new_unchanged
    {i j auxA auxD : I.linkage.Index}
    (hij : i ≠ j)
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (hjleft : j ≠ I.rowIndex Cross.rowLeft)
    (hjright : j ≠ I.rowIndex Cross.rowRight)
    (β : I.linkage.toPathPacking.BridgeBetween i j)
    (hnotnew :
      ¬ (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j)
    (hAU_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Cross.rowLeft))
    (hUV_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight))
    (hVD_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hU_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowLeft) 2)
    (hV_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowRight) 2)
    (hA_ne_V : auxA ≠ I.rowIndex Cross.rowRight)
    (hU_ne_D : I.rowIndex Cross.rowLeft ≠ auxD) :
    i ∈ ({auxA, I.rowIndex Cross.rowLeft,
        I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index) := by
  classical
  by_cases hhit :
      (β.orientedPath.vertexSet ∩ Cross.insertedSegmentVertexSet).Nonempty
  · exact Cross.mem_local_quad_of_old_adj_to_crossed_row
      hAU_old hUV_old hVD_old hU_old hV_old hA_ne_V hU_ne_D
      (Cross.old_aux_adj_to_crossed_row_of_old_bridge_hits_inserted
        hileft hiright β hhit)
  · have hmiss :
        Disjoint β.orientedPath.vertexSet Cross.insertedSegmentVertexSet := by
      rw [Finset.disjoint_left]
      intro v hvP hvIns
      exact hhit ⟨v, Finset.mem_inter.2 ⟨hvP, hvIns⟩⟩
    have hnew :
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j :=
      Cross.new_aux_adj_of_old_bridge_unchanged_miss_inserted
        hij hileft hiright hjleft hjright β hmiss
    exact False.elim (hnotnew hnew)

/-- Endpoint-localizing form for an old auxiliary edge that disappears after
the cross.  If endpoint `i` is not one of the two crossed rows, then it must
belong to the local quadruple. -/
theorem mem_local_quad_of_old_adj_not_new_at_left_endpoint
    {i j auxA auxD : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (hadj : (linkageAuxGraph I.linkage).Adj i j)
    (hnotnew :
      ¬ (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j)
    (hAU_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Cross.rowLeft))
    (hUV_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight))
    (hVD_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hU_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowLeft) 2)
    (hV_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowRight) 2)
    (hA_ne_V : auxA ≠ I.rowIndex Cross.rowRight)
    (hU_ne_D : I.rowIndex Cross.rowLeft ≠ auxD) :
    i ∈ ({auxA, I.rowIndex Cross.rowLeft,
        I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index) := by
  classical
  by_cases hjleft_eq : j = I.rowIndex Cross.rowLeft
  · exact Cross.mem_local_quad_of_old_adj_to_crossed_row
      hAU_old hUV_old hVD_old hU_old hV_old hA_ne_V hU_ne_D
      (Or.inl (by simpa [hjleft_eq] using hadj))
  · by_cases hjright_eq : j = I.rowIndex Cross.rowRight
    · exact Cross.mem_local_quad_of_old_adj_to_crossed_row
        hAU_old hUV_old hVD_old hU_old hV_old hA_ne_V hU_ne_D
        (Or.inr (by simpa [hjright_eq] using hadj))
    · rcases hadj with ⟨hij, hbridge⟩
      rcases hbridge with hβ | hβ
      · rcases hβ with ⟨β⟩
        exact Cross.mem_local_quad_of_old_bridge_not_new_unchanged
          hij hileft hiright hjleft_eq hjright_eq β hnotnew
          hAU_old hUV_old hVD_old hU_old hV_old hA_ne_V hU_ne_D
      · rcases hβ with ⟨β⟩
        exact Cross.mem_local_quad_of_old_bridge_not_new_unchanged
          hij hileft hiright hjleft_eq hjright_eq
          (reverseBridge β) hnotnew
          hAU_old hUV_old hVD_old hU_old hV_old hA_ne_V hU_ne_D

/-- Symmetric endpoint-localizing form for an old auxiliary edge that
disappears after the cross. -/
theorem mem_local_quad_of_old_adj_not_new_at_right_endpoint
    {i j auxA auxD : I.linkage.Index}
    (hjleft : j ≠ I.rowIndex Cross.rowLeft)
    (hjright : j ≠ I.rowIndex Cross.rowRight)
    (hadj : (linkageAuxGraph I.linkage).Adj i j)
    (hnotnew :
      ¬ (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j)
    (hAU_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Cross.rowLeft))
    (hUV_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight))
    (hVD_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hU_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowLeft) 2)
    (hV_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowRight) 2)
    (hA_ne_V : auxA ≠ I.rowIndex Cross.rowRight)
    (hU_ne_D : I.rowIndex Cross.rowLeft ≠ auxD) :
    j ∈ ({auxA, I.rowIndex Cross.rowLeft,
        I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index) := by
  exact Cross.mem_local_quad_of_old_adj_not_new_at_left_endpoint
    hjleft hjright ((linkageAuxGraph I.linkage).symm hadj)
    (fun hnew => hnotnew ((linkageAuxGraph Cross.replacementLinkageConcrete).symm hnew))
    hAU_old hUV_old hVD_old hU_old hV_old hA_ne_V hU_ne_D

/-- New-only analogue of
`mem_local_quad_of_old_bridge_not_new_unchanged`: a successor bridge between
unchanged rows that is not an old auxiliary edge forces the first endpoint into
the local quadruple. -/
theorem mem_local_quad_of_new_bridge_not_old_unchanged
    {i j auxA auxD : I.linkage.Index}
    (hij : i ≠ j)
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (hjleft : j ≠ I.rowIndex Cross.rowLeft)
    (hjright : j ≠ I.rowIndex Cross.rowRight)
    (β :
      Cross.replacementLinkageConcrete.toPathPacking.BridgeBetween i j)
    (hnotold : ¬ (linkageAuxGraph I.linkage).Adj i j)
    (hAU_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Cross.rowLeft))
    (hUV_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight))
    (hVD_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hU_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowLeft) 2)
    (hV_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowRight) 2)
    (hA_ne_V : auxA ≠ I.rowIndex Cross.rowRight)
    (hU_ne_D : I.rowIndex Cross.rowLeft ≠ auxD) :
    i ∈ ({auxA, I.rowIndex Cross.rowLeft,
        I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index) := by
  classical
  by_cases hhit :
      (β.orientedPath.vertexSet ∩ Cross.deletedMiddleVertexSet).Nonempty
  · exact Cross.mem_local_quad_of_old_adj_to_crossed_row
      hAU_old hUV_old hVD_old hU_old hV_old hA_ne_V hU_ne_D
      (Cross.old_aux_adj_to_crossed_row_of_new_bridge_hits_deleted
        hileft hiright β hhit)
  · have hmiss :
        Disjoint β.orientedPath.vertexSet Cross.deletedMiddleVertexSet := by
      rw [Finset.disjoint_left]
      intro v hvP hvDel
      exact hhit ⟨v, Finset.mem_inter.2 ⟨hvP, hvDel⟩⟩
    have hold :
        (linkageAuxGraph I.linkage).Adj i j :=
      Cross.old_aux_adj_of_new_bridge_unchanged_miss_deleted
        hij hileft hiright hjleft hjright β hmiss
    exact False.elim (hnotold hold)

/-- Symmetric endpoint version of
`mem_local_quad_of_new_bridge_not_old_unchanged`. -/
theorem mem_local_quad_of_new_bridge_not_old_unchanged_right_endpoint
    {i j auxA auxD : I.linkage.Index}
    (hij : i ≠ j)
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (hjleft : j ≠ I.rowIndex Cross.rowLeft)
    (hjright : j ≠ I.rowIndex Cross.rowRight)
    (β :
      Cross.replacementLinkageConcrete.toPathPacking.BridgeBetween i j)
    (hnotold : ¬ (linkageAuxGraph I.linkage).Adj i j)
    (hAU_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Cross.rowLeft))
    (hUV_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight))
    (hVD_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hU_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowLeft) 2)
    (hV_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowRight) 2)
    (hA_ne_V : auxA ≠ I.rowIndex Cross.rowRight)
    (hU_ne_D : I.rowIndex Cross.rowLeft ≠ auxD) :
    j ∈ ({auxA, I.rowIndex Cross.rowLeft,
        I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index) := by
  exact Cross.mem_local_quad_of_new_bridge_not_old_unchanged
    hij.symm hjleft hjright hileft hiright (reverseBridge β)
    (fun hold => hnotold ((linkageAuxGraph I.linkage).symm hold))
    hAU_old hUV_old hVD_old hU_old hV_old hA_ne_V hU_ne_D

/-- Auxiliary adjacencies between two vertices outside the cross local
quadruple are unchanged.  This is the fully formalized nonlocal-pair part of
the Figure 8 symmetric-difference locality assertion. -/
theorem aux_adj_iff_of_both_not_mem_cross_local_quad
    {u v auxA auxD : I.linkage.Index}
    (hu_not :
      u ∉ ({auxA, I.rowIndex Cross.rowLeft,
        I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index))
    (hv_not :
      v ∉ ({auxA, I.rowIndex Cross.rowLeft,
        I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index))
    (hAU_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Cross.rowLeft))
    (hUV_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight))
    (hVD_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hU_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowLeft) 2)
    (hV_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowRight) 2)
    (hA_ne_V : auxA ≠ I.rowIndex Cross.rowRight)
    (hU_ne_D : I.rowIndex Cross.rowLeft ≠ auxD) :
    (linkageAuxGraph Cross.replacementLinkageConcrete).Adj u v ↔
      (linkageAuxGraph I.linkage).Adj u v := by
  classical
  have huleft : u ≠ I.rowIndex Cross.rowLeft := by
    intro h
    exact hu_not (by simp [h])
  have huright : u ≠ I.rowIndex Cross.rowRight := by
    intro h
    exact hu_not (by simp [h])
  have hvleft : v ≠ I.rowIndex Cross.rowLeft := by
    intro h
    exact hv_not (by simp [h])
  have hvright : v ≠ I.rowIndex Cross.rowRight := by
    intro h
    exact hv_not (by simp [h])
  constructor
  · intro hnew
    by_contra hnotold
    rcases hnew with ⟨hij, hbridge⟩
    have hulocal :
        u ∈ ({auxA, I.rowIndex Cross.rowLeft,
          I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index) := by
      rcases hbridge with hβ | hβ
      · rcases hβ with ⟨β⟩
        exact Cross.mem_local_quad_of_new_bridge_not_old_unchanged
          hij huleft huright hvleft hvright β hnotold
          hAU_old hUV_old hVD_old hU_old hV_old hA_ne_V hU_ne_D
      · rcases hβ with ⟨β⟩
        exact Cross.mem_local_quad_of_new_bridge_not_old_unchanged
          hij huleft huright hvleft hvright (reverseBridge β) hnotold
          hAU_old hUV_old hVD_old hU_old hV_old hA_ne_V hU_ne_D
    exact hu_not hulocal
  · intro hold
    by_contra hnotnew
    have hulocal :
        u ∈ ({auxA, I.rowIndex Cross.rowLeft,
          I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index) :=
      Cross.mem_local_quad_of_old_adj_not_new_at_left_endpoint
        huleft huright hold hnotnew
        hAU_old hUV_old hVD_old hU_old hV_old hA_ne_V hU_ne_D
    exact hu_not hulocal

/-- A successor bridge from an unchanged row to the left replacement row gives
an old auxiliary edge from that row to one of the two crossed old rows. -/
theorem old_aux_adj_to_crossed_row_of_new_bridge_to_left_replacement
    {i : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (β :
      Cross.replacementLinkageConcrete.toPathPacking.BridgeBetween
        i (I.rowIndex Cross.rowLeft)) :
    (linkageAuxGraph I.linkage).Adj i (I.rowIndex Cross.rowLeft) ∨
      (linkageAuxGraph I.linkage).Adj i (I.rowIndex Cross.rowRight) := by
  classical
  by_cases hhit :
      (β.orientedPath.vertexSet ∩ Cross.deletedMiddleVertexSet).Nonempty
  · exact Cross.old_aux_adj_to_crossed_row_of_new_bridge_hits_deleted
      hileft hiright β hhit
  · have hmiss :
        Disjoint β.orientedPath.vertexSet Cross.deletedMiddleVertexSet := by
      rw [Finset.disjoint_left]
      intro v hvP hvDel
      exact hhit ⟨v, Finset.mem_inter.2 ⟨hvP, hvDel⟩⟩
    let P : GraphPath G := β.orientedPath
    have hsrc_old : P.source ∈ (I.linkage.path i).vertexSet := by
      have hsrc_new :=
        PathPacking.BridgeBetween.orientedPath_source_mem_left β
      simpa [P, Cross.replacementLinkageConcrete_path_of_ne hileft hiright]
        using hsrc_new
    have hclean_old :
        P.InternallyDisjointFromSet I.linkage.toPathPacking.vertexSet := by
      exact Cross.internallyDisjoint_old_of_new_clean_disjoint_deleted
        P β.orientedPath_internallyDisjoint hmiss
    have htgt_left :
        P.target ∈ Cross.replacementPaths.leftPath.vertexSet := by
      have htgt_new :=
        PathPacking.BridgeBetween.orientedPath_target_mem_right β
      simpa [P, Cross.replacementLinkageConcrete_path_left] using htgt_new
    have hparts := Cross.replacementPaths.left_vertexSet_subset_parts htgt_left
    rcases Finset.mem_union.1 hparts with hpre_or_seg | hrsuf
    · rcases Finset.mem_union.1 hpre_or_seg with hpre | hseg
      · have htgt_old :
            P.target ∈
              (I.linkage.path (I.rowIndex Cross.rowLeft)).vertexSet := by
          have hrow :
              P.target ∈ (I.rowPath Cross.rowLeft).vertexSet :=
            (I.rowPath Cross.rowLeft).takeUntil_vertexSet_subset
              Cross.s1_mem_left hpre
          simpa [I.rowPath_eq_linkage_path Cross.rowLeft] using hrow
        exact Or.inl ⟨hileft, Or.inl
          ⟨PathPacking.BridgeBetween.of_orientedPath
            I.linkage.toPathPacking P hsrc_old htgt_old hclean_old⟩⟩
      · have hxseg : P.target ∈ Cross.orientedSegment1.vertexSet := by
          simpa [Cross.orientedSegment1_vertexSet] using hseg
        by_cases hxold : P.target ∈ I.linkage.toPathPacking.vertexSet
        · have hend := Cross.orientedSegment1_clean_linkage hxseg hxold
          rcases hend with hs1 | ht1
          · have htgt_old :
                P.target ∈
                  (I.linkage.path (I.rowIndex Cross.rowLeft)).vertexSet := by
              have hrow :
                  P.target ∈ (I.rowPath Cross.rowLeft).vertexSet := by
                rw [hs1, Cross.orientedSegment1_source]
                exact Cross.s1_mem_left
              simpa [I.rowPath_eq_linkage_path Cross.rowLeft] using hrow
            exact Or.inl ⟨hileft, Or.inl
              ⟨PathPacking.BridgeBetween.of_orientedPath
                I.linkage.toPathPacking P hsrc_old htgt_old hclean_old⟩⟩
          · have htgt_old :
                P.target ∈
                  (I.linkage.path (I.rowIndex Cross.rowRight)).vertexSet := by
              have hrow :
                  P.target ∈ (I.rowPath Cross.rowRight).vertexSet := by
                rw [ht1, Cross.orientedSegment1_target]
                exact Cross.t1_mem_right
              simpa [I.rowPath_eq_linkage_path Cross.rowRight] using hrow
            exact Or.inr ⟨hiright, Or.inl
              ⟨PathPacking.BridgeBetween.of_orientedPath
                I.linkage.toPathPacking P hsrc_old htgt_old hclean_old⟩⟩
        · let Tail : GraphPath G := Cross.orientedSegment1.dropUntil hxseg
          have hglue : P.target = Tail.source := by
            simp [Tail, P]
          have hinter :
              ∀ ⦃v : V⦄, v ∈ P.vertexSet → v ∈ Tail.vertexSet →
                v = P.target := by
            intro v hvP hvtail
            have hvtail_seg :
                v ∈ Cross.orientedSegment1.vertexSet :=
              Cross.orientedSegment1.dropUntil_vertexSet_subset hxseg
                (by simpa [Tail] using hvtail)
            have hvleft :
                v ∈ Cross.replacementPaths.leftPath.vertexSet :=
              Cross.replacementPaths.segment1_subset_leftPath hvtail_seg
            have hvnew :
                v ∈ Cross.replacementLinkageConcrete.toPathPacking.vertexSet :=
              (Cross.replacementLinkageConcrete.toPathPacking.mem_vertexSet).2
                ⟨I.rowIndex Cross.rowLeft, by
                  simpa [Cross.replacementLinkageConcrete_path_left] using hvleft⟩
            rcases β.orientedPath_internallyDisjoint
                (by simpa [P] using hvP) hvnew with hsrc | htgt
            · have hsrc_new :
                  P.source ∈
                    (Cross.replacementLinkageConcrete.path i).vertexSet :=
                PathPacking.BridgeBetween.orientedPath_source_mem_left β
              have hsrc_i :
                  P.source ∈ (I.linkage.path i).vertexSet := by
                simpa [P, Cross.replacementLinkageConcrete_path_of_ne
                  hileft hiright] using hsrc_new
              have hsrc_left : P.source ∈
                  Cross.replacementPaths.leftPath.vertexSet := by
                simpa [P, hsrc] using hvleft
              exact False.elim <|
                Finset.disjoint_left.mp
                  (Cross.replacementPaths_left_nodeDisjoint_unchanged
                    hileft hiright) hsrc_left hsrc_i
            · simpa [P] using htgt
          let Joined : GraphPath G :=
            P.appendWithEqOfInterSubsetTarget Tail hglue hinter
          have htail_clean :
              Tail.InternallyDisjointFromSet
                I.linkage.toPathPacking.vertexSet := by
            simpa [Tail] using
              Cross.orientedSegment1.dropUntil_internallyDisjointFromSet
                hxseg Cross.orientedSegment1_clean_linkage
          have hjoined_clean :
              Joined.InternallyDisjointFromSet
                I.linkage.toPathPacking.vertexSet := by
            simpa [Joined] using
              P.appendWithEqOfInterSubsetTarget_internallyDisjointFromSet
                Tail hglue hinter hclean_old htail_clean hxold
          have hjoined_src :
              Joined.source ∈ (I.linkage.path i).vertexSet := by
            simpa [Joined] using hsrc_old
          have hjoined_tgt :
              Joined.target ∈
                (I.linkage.path (I.rowIndex Cross.rowRight)).vertexSet := by
            have htgt : Joined.target = Cross.t1 := by
              simp [Joined, Tail]
            have hrow :
                Joined.target ∈ (I.rowPath Cross.rowRight).vertexSet := by
              simpa [htgt] using Cross.t1_mem_right
            simpa [I.rowPath_eq_linkage_path Cross.rowRight] using hrow
          exact Or.inr ⟨hiright, Or.inl
            ⟨PathPacking.BridgeBetween.of_orientedPath
              I.linkage.toPathPacking Joined hjoined_src hjoined_tgt
              hjoined_clean⟩⟩
    · have htgt_old :
          P.target ∈
            (I.linkage.path (I.rowIndex Cross.rowRight)).vertexSet := by
        have hrow : P.target ∈ (I.rowPath Cross.rowRight).vertexSet :=
          (I.rowPath Cross.rowRight).dropUntil_vertexSet_subset
            Cross.t1_mem_right hrsuf
        simpa [I.rowPath_eq_linkage_path Cross.rowRight] using hrow
      exact Or.inr ⟨hiright, Or.inl
        ⟨PathPacking.BridgeBetween.of_orientedPath
          I.linkage.toPathPacking P hsrc_old htgt_old hclean_old⟩⟩

/-- Symmetric version of
`old_aux_adj_to_crossed_row_of_new_bridge_to_left_replacement` for the right
replacement row. -/
theorem old_aux_adj_to_crossed_row_of_new_bridge_to_right_replacement
    {i : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (β :
      Cross.replacementLinkageConcrete.toPathPacking.BridgeBetween
        i (I.rowIndex Cross.rowRight)) :
    (linkageAuxGraph I.linkage).Adj i (I.rowIndex Cross.rowLeft) ∨
      (linkageAuxGraph I.linkage).Adj i (I.rowIndex Cross.rowRight) := by
  classical
  by_cases hhit :
      (β.orientedPath.vertexSet ∩ Cross.deletedMiddleVertexSet).Nonempty
  · exact Cross.old_aux_adj_to_crossed_row_of_new_bridge_hits_deleted
      hileft hiright β hhit
  · have hmiss :
        Disjoint β.orientedPath.vertexSet Cross.deletedMiddleVertexSet := by
      rw [Finset.disjoint_left]
      intro v hvP hvDel
      exact hhit ⟨v, Finset.mem_inter.2 ⟨hvP, hvDel⟩⟩
    let P : GraphPath G := β.orientedPath
    have hsrc_old : P.source ∈ (I.linkage.path i).vertexSet := by
      have hsrc_new :=
        PathPacking.BridgeBetween.orientedPath_source_mem_left β
      simpa [P, Cross.replacementLinkageConcrete_path_of_ne hileft hiright]
        using hsrc_new
    have hclean_old :
        P.InternallyDisjointFromSet I.linkage.toPathPacking.vertexSet := by
      exact Cross.internallyDisjoint_old_of_new_clean_disjoint_deleted
        P β.orientedPath_internallyDisjoint hmiss
    have htgt_right :
        P.target ∈ Cross.replacementPaths.rightPath.vertexSet := by
      have htgt_new :=
        PathPacking.BridgeBetween.orientedPath_target_mem_right β
      simpa [P, Cross.replacementLinkageConcrete_path_right] using htgt_new
    have hparts := Cross.replacementPaths.right_vertexSet_subset_parts htgt_right
    rcases Finset.mem_union.1 hparts with hpre_or_seg | hlsuf
    · rcases Finset.mem_union.1 hpre_or_seg with hpre | hseg
      · have htgt_old :
            P.target ∈
              (I.linkage.path (I.rowIndex Cross.rowRight)).vertexSet := by
          have hrow :
              P.target ∈ (I.rowPath Cross.rowRight).vertexSet :=
            (I.rowPath Cross.rowRight).takeUntil_vertexSet_subset
              Cross.t2_mem_right hpre
          simpa [I.rowPath_eq_linkage_path Cross.rowRight] using hrow
        exact Or.inr ⟨hiright, Or.inl
          ⟨PathPacking.BridgeBetween.of_orientedPath
            I.linkage.toPathPacking P hsrc_old htgt_old hclean_old⟩⟩
      · have hxseg : P.target ∈ Cross.orientedSegment2.vertexSet := by
          simpa [Cross.orientedSegment2_vertexSet] using hseg
        by_cases hxold : P.target ∈ I.linkage.toPathPacking.vertexSet
        · have hend := Cross.orientedSegment2_clean_linkage hxseg hxold
          rcases hend with ht2 | hs2
          · have htgt_old :
                P.target ∈
                  (I.linkage.path (I.rowIndex Cross.rowRight)).vertexSet := by
              have hrow :
                  P.target ∈ (I.rowPath Cross.rowRight).vertexSet := by
                rw [ht2, Cross.orientedSegment2_source]
                exact Cross.t2_mem_right
              simpa [I.rowPath_eq_linkage_path Cross.rowRight] using hrow
            exact Or.inr ⟨hiright, Or.inl
              ⟨PathPacking.BridgeBetween.of_orientedPath
                I.linkage.toPathPacking P hsrc_old htgt_old hclean_old⟩⟩
          · have htgt_old :
                P.target ∈
                  (I.linkage.path (I.rowIndex Cross.rowLeft)).vertexSet := by
              have hrow :
                  P.target ∈ (I.rowPath Cross.rowLeft).vertexSet := by
                rw [hs2, Cross.orientedSegment2_target]
                exact Cross.s2_mem_left
              simpa [I.rowPath_eq_linkage_path Cross.rowLeft] using hrow
            exact Or.inl ⟨hileft, Or.inl
              ⟨PathPacking.BridgeBetween.of_orientedPath
                I.linkage.toPathPacking P hsrc_old htgt_old hclean_old⟩⟩
        · let Tail : GraphPath G := Cross.orientedSegment2.dropUntil hxseg
          have hglue : P.target = Tail.source := by
            simp [Tail, P]
          have hinter :
              ∀ ⦃v : V⦄, v ∈ P.vertexSet → v ∈ Tail.vertexSet →
                v = P.target := by
            intro v hvP hvtail
            have hvtail_seg :
                v ∈ Cross.orientedSegment2.vertexSet :=
              Cross.orientedSegment2.dropUntil_vertexSet_subset hxseg
                (by simpa [Tail] using hvtail)
            have hvright :
                v ∈ Cross.replacementPaths.rightPath.vertexSet :=
              Cross.replacementPaths.segment2_subset_rightPath hvtail_seg
            have hvnew :
                v ∈ Cross.replacementLinkageConcrete.toPathPacking.vertexSet :=
              (Cross.replacementLinkageConcrete.toPathPacking.mem_vertexSet).2
                ⟨I.rowIndex Cross.rowRight, by
                  simpa [Cross.replacementLinkageConcrete_path_right] using hvright⟩
            rcases β.orientedPath_internallyDisjoint
                (by simpa [P] using hvP) hvnew with hsrc | htgt
            · have hsrc_new :
                  P.source ∈
                    (Cross.replacementLinkageConcrete.path i).vertexSet :=
                PathPacking.BridgeBetween.orientedPath_source_mem_left β
              have hsrc_i :
                  P.source ∈ (I.linkage.path i).vertexSet := by
                simpa [P, Cross.replacementLinkageConcrete_path_of_ne
                  hileft hiright] using hsrc_new
              have hsrc_right : P.source ∈
                  Cross.replacementPaths.rightPath.vertexSet := by
                simpa [P, hsrc] using hvright
              exact False.elim <|
                Finset.disjoint_left.mp
                  (Cross.replacementPaths_right_nodeDisjoint_unchanged
                    hileft hiright) hsrc_right hsrc_i
            · simpa [P] using htgt
          let Joined : GraphPath G :=
            P.appendWithEqOfInterSubsetTarget Tail hglue hinter
          have htail_clean :
              Tail.InternallyDisjointFromSet
                I.linkage.toPathPacking.vertexSet := by
            simpa [Tail] using
              Cross.orientedSegment2.dropUntil_internallyDisjointFromSet
                hxseg Cross.orientedSegment2_clean_linkage
          have hjoined_clean :
              Joined.InternallyDisjointFromSet
                I.linkage.toPathPacking.vertexSet := by
            simpa [Joined] using
              P.appendWithEqOfInterSubsetTarget_internallyDisjointFromSet
                Tail hglue hinter hclean_old htail_clean hxold
          have hjoined_src :
              Joined.source ∈ (I.linkage.path i).vertexSet := by
            simpa [Joined] using hsrc_old
          have hjoined_tgt :
              Joined.target ∈
                (I.linkage.path (I.rowIndex Cross.rowLeft)).vertexSet := by
            have htgt : Joined.target = Cross.s2 := by
              simp [Joined, Tail]
            have hrow :
                Joined.target ∈ (I.rowPath Cross.rowLeft).vertexSet := by
              simpa [htgt] using Cross.s2_mem_left
            simpa [I.rowPath_eq_linkage_path Cross.rowLeft] using hrow
          exact Or.inl ⟨hileft, Or.inl
            ⟨PathPacking.BridgeBetween.of_orientedPath
              I.linkage.toPathPacking Joined hjoined_src hjoined_tgt
              hjoined_clean⟩⟩
    · have htgt_old :
          P.target ∈
            (I.linkage.path (I.rowIndex Cross.rowLeft)).vertexSet := by
        have hrow : P.target ∈ (I.rowPath Cross.rowLeft).vertexSet :=
          (I.rowPath Cross.rowLeft).dropUntil_vertexSet_subset
            Cross.s2_mem_left hlsuf
        simpa [I.rowPath_eq_linkage_path Cross.rowLeft] using hrow
      exact Or.inl ⟨hileft, Or.inl
        ⟨PathPacking.BridgeBetween.of_orientedPath
          I.linkage.toPathPacking P hsrc_old htgt_old hclean_old⟩⟩

/-- Endpoint-localizing form for a successor auxiliary edge that was not an
old edge.  This includes the cases where the other endpoint is one of the two
replacement rows. -/
theorem mem_local_quad_of_new_adj_not_old_at_left_endpoint
    {i j auxA auxD : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (hadj :
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j)
    (hnotold : ¬ (linkageAuxGraph I.linkage).Adj i j)
    (hAU_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Cross.rowLeft))
    (hUV_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight))
    (hVD_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hU_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowLeft) 2)
    (hV_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowRight) 2)
    (hA_ne_V : auxA ≠ I.rowIndex Cross.rowRight)
    (hU_ne_D : I.rowIndex Cross.rowLeft ≠ auxD) :
    i ∈ ({auxA, I.rowIndex Cross.rowLeft,
        I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index) := by
  classical
  by_cases hjleft_eq : j = I.rowIndex Cross.rowLeft
  · rcases hadj with ⟨_hij, hbridge⟩
    have hadj_cross :
        (linkageAuxGraph I.linkage).Adj i (I.rowIndex Cross.rowLeft) ∨
          (linkageAuxGraph I.linkage).Adj i (I.rowIndex Cross.rowRight) := by
      rcases hbridge with hβ | hβ
      · rcases hβ with ⟨β⟩
        exact Cross.old_aux_adj_to_crossed_row_of_new_bridge_to_left_replacement
          hileft hiright (by simpa [hjleft_eq] using β)
      · rcases hβ with ⟨β⟩
        exact Cross.old_aux_adj_to_crossed_row_of_new_bridge_to_left_replacement
          hileft hiright (by simpa [hjleft_eq] using (reverseBridge β))
    exact Cross.mem_local_quad_of_old_adj_to_crossed_row
      hAU_old hUV_old hVD_old hU_old hV_old hA_ne_V hU_ne_D hadj_cross
  · by_cases hjright_eq : j = I.rowIndex Cross.rowRight
    · rcases hadj with ⟨_hij, hbridge⟩
      have hadj_cross :
          (linkageAuxGraph I.linkage).Adj i (I.rowIndex Cross.rowLeft) ∨
            (linkageAuxGraph I.linkage).Adj i (I.rowIndex Cross.rowRight) := by
        rcases hbridge with hβ | hβ
        · rcases hβ with ⟨β⟩
          exact Cross.old_aux_adj_to_crossed_row_of_new_bridge_to_right_replacement
            hileft hiright (by simpa [hjright_eq] using β)
        · rcases hβ with ⟨β⟩
          exact Cross.old_aux_adj_to_crossed_row_of_new_bridge_to_right_replacement
            hileft hiright (by simpa [hjright_eq] using (reverseBridge β))
      exact Cross.mem_local_quad_of_old_adj_to_crossed_row
        hAU_old hUV_old hVD_old hU_old hV_old hA_ne_V hU_ne_D hadj_cross
    · rcases hadj with ⟨hij, hbridge⟩
      rcases hbridge with hβ | hβ
      · rcases hβ with ⟨β⟩
        exact Cross.mem_local_quad_of_new_bridge_not_old_unchanged
          hij hileft hiright hjleft_eq hjright_eq β hnotold
          hAU_old hUV_old hVD_old hU_old hV_old hA_ne_V hU_ne_D
      · rcases hβ with ⟨β⟩
        exact Cross.mem_local_quad_of_new_bridge_not_old_unchanged
          hij hileft hiright hjleft_eq hjright_eq
          (reverseBridge β) hnotold
          hAU_old hUV_old hVD_old hU_old hV_old hA_ne_V hU_ne_D

/-- Symmetric endpoint-localizing form for a successor auxiliary edge that was
not an old edge. -/
theorem mem_local_quad_of_new_adj_not_old_at_right_endpoint
    {i j auxA auxD : I.linkage.Index}
    (hjleft : j ≠ I.rowIndex Cross.rowLeft)
    (hjright : j ≠ I.rowIndex Cross.rowRight)
    (hadj :
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j)
    (hnotold : ¬ (linkageAuxGraph I.linkage).Adj i j)
    (hAU_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Cross.rowLeft))
    (hUV_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight))
    (hVD_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hU_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowLeft) 2)
    (hV_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowRight) 2)
    (hA_ne_V : auxA ≠ I.rowIndex Cross.rowRight)
    (hU_ne_D : I.rowIndex Cross.rowLeft ≠ auxD) :
    j ∈ ({auxA, I.rowIndex Cross.rowLeft,
        I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index) := by
  exact Cross.mem_local_quad_of_new_adj_not_old_at_left_endpoint
    hjleft hjright ((linkageAuxGraph Cross.replacementLinkageConcrete).symm hadj)
    (fun hold => hnotold ((linkageAuxGraph I.linkage).symm hold))
    hAU_old hUV_old hVD_old hU_old hV_old hA_ne_V hU_ne_D

/-- Figure 8 auxiliary-locality theorem for the cross operation: every
auxiliary edge whose status changes has both endpoints in the local quadruple.

This is the formal replacement for the earlier support hypothesis in the
cross action.  The proof uses the vertex-status lemmas for deleted and
inserted pieces, first-hit localization of bridge paths, and degree-two
saturation of the two crossed old row vertices. -/
theorem cross_adjChangeSupportedIn
    (auxA auxD : I.linkage.Index)
    (hAU_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Cross.rowLeft))
    (hUV_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight))
    (hVD_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hU_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowLeft) 2)
    (hV_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowRight) 2)
    (hA_ne_V : auxA ≠ I.rowIndex Cross.rowRight)
    (hU_ne_D : I.rowIndex Cross.rowLeft ≠ auxD) :
    AdjChangeSupportedIn (linkageAuxGraph I.linkage)
      (linkageAuxGraph Cross.replacementLinkageConcrete)
      ({auxA, I.rowIndex Cross.rowLeft,
        I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index) := by
  classical
  intro u v hnonlocal
  constructor
  · intro hnew
    by_contra hnotold
    rcases hnonlocal with hu_not | hv_not
    · have huleft : u ≠ I.rowIndex Cross.rowLeft := by
        intro h
        exact hu_not (by simp [h])
      have huright : u ≠ I.rowIndex Cross.rowRight := by
        intro h
        exact hu_not (by simp [h])
      have hulocal :
          u ∈ ({auxA, I.rowIndex Cross.rowLeft,
            I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index) :=
        Cross.mem_local_quad_of_new_adj_not_old_at_left_endpoint
          huleft huright hnew hnotold hAU_old hUV_old hVD_old
          hU_old hV_old hA_ne_V hU_ne_D
      exact hu_not hulocal
    · have hvleft : v ≠ I.rowIndex Cross.rowLeft := by
        intro h
        exact hv_not (by simp [h])
      have hvright : v ≠ I.rowIndex Cross.rowRight := by
        intro h
        exact hv_not (by simp [h])
      have hvlocal :
          v ∈ ({auxA, I.rowIndex Cross.rowLeft,
            I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index) :=
        Cross.mem_local_quad_of_new_adj_not_old_at_right_endpoint
          hvleft hvright hnew hnotold hAU_old hUV_old hVD_old
          hU_old hV_old hA_ne_V hU_ne_D
      exact hv_not hvlocal
  · intro hold
    by_contra hnotnew
    rcases hnonlocal with hu_not | hv_not
    · have huleft : u ≠ I.rowIndex Cross.rowLeft := by
        intro h
        exact hu_not (by simp [h])
      have huright : u ≠ I.rowIndex Cross.rowRight := by
        intro h
        exact hu_not (by simp [h])
      have hulocal :
          u ∈ ({auxA, I.rowIndex Cross.rowLeft,
            I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index) :=
        Cross.mem_local_quad_of_old_adj_not_new_at_left_endpoint
          huleft huright hold hnotnew hAU_old hUV_old hVD_old
          hU_old hV_old hA_ne_V hU_ne_D
      exact hu_not hulocal
    · have hvleft : v ≠ I.rowIndex Cross.rowLeft := by
        intro h
        exact hv_not (by simp [h])
      have hvright : v ≠ I.rowIndex Cross.rowRight := by
        intro h
        exact hv_not (by simp [h])
      have hvlocal :
          v ∈ ({auxA, I.rowIndex Cross.rowLeft,
            I.rowIndex Cross.rowRight, auxD} : Finset I.linkage.Index) :=
        Cross.mem_local_quad_of_old_adj_not_new_at_right_endpoint
          hvleft hvright hold hnotnew hAU_old hUV_old hVD_old
          hU_old hV_old hA_ne_V hU_ne_D
      exact hv_not hvlocal

/-- After the cross switch, the deleted left middle row segment is clean with
respect to the new linkage.  Its two endpoints now lie on the two switched
rows, while its interior is no longer a linkage vertex. -/
theorem deletedLeftMiddle_clean_replacementLinkageConcrete :
    Cross.deletedLeftMiddle.InternallyDisjointFromSet
      Cross.replacementLinkageConcrete.toPathPacking.vertexSet := by
  intro v hvdel hvnew
  rcases (Cross.replacementLinkageConcrete.toPathPacking.mem_vertexSet).1
      hvnew with ⟨i, hvi⟩
  by_cases hileft : i = I.rowIndex Cross.rowLeft
  · subst hileft
    have hvleft : v ∈ Cross.replacementPaths.leftPath.vertexSet := by
      simpa using hvi
    exact Cross.deletedLeftMiddle_inter_leftPath_endpoint hvdel hvleft
  · by_cases hiright : i = I.rowIndex Cross.rowRight
    · subst hiright
      have hvright : v ∈ Cross.replacementPaths.rightPath.vertexSet := by
        simpa using hvi
      exact Cross.deletedLeftMiddle_inter_rightPath_endpoint hvdel hvright
    · have hvrow :
          v ∈ (I.rowPath Cross.rowLeft).vertexSet :=
        (I.rowPath Cross.rowLeft).segmentOfBefore_vertexSet_subset
          Cross.s1_before_s2 hvdel
      have hvrow' :
          v ∈ (I.linkage.path (I.rowIndex Cross.rowLeft)).vertexSet := by
        simpa [I.rowPath_eq_linkage_path Cross.rowLeft] using hvrow
      have hvi_old : v ∈ (I.linkage.path i).vertexSet := by
        simpa [Cross.replacementLinkageConcrete_path_of_ne hileft hiright]
          using hvi
      exact False.elim <|
        Finset.disjoint_left.mp
          (I.linkage.toPathPacking.node_disjoint
            (fun h => hileft h.symm)) hvrow' hvi_old

/-- After the cross switch, the deleted right middle row segment is clean with
respect to the new linkage. -/
theorem deletedRightMiddle_clean_replacementLinkageConcrete :
    Cross.deletedRightMiddle.InternallyDisjointFromSet
      Cross.replacementLinkageConcrete.toPathPacking.vertexSet := by
  intro v hvdel hvnew
  rcases (Cross.replacementLinkageConcrete.toPathPacking.mem_vertexSet).1
      hvnew with ⟨i, hvi⟩
  by_cases hileft : i = I.rowIndex Cross.rowLeft
  · subst hileft
    have hvleft : v ∈ Cross.replacementPaths.leftPath.vertexSet := by
      simpa using hvi
    exact Cross.deletedRightMiddle_inter_leftPath_endpoint hvdel hvleft
  · by_cases hiright : i = I.rowIndex Cross.rowRight
    · subst hiright
      have hvright : v ∈ Cross.replacementPaths.rightPath.vertexSet := by
        simpa using hvi
      exact Cross.deletedRightMiddle_inter_rightPath_endpoint hvdel hvright
    · have hvrow :
          v ∈ (I.rowPath Cross.rowRight).vertexSet :=
        (I.rowPath Cross.rowRight).segmentOfBefore_vertexSet_subset
          Cross.t2_before_t1 hvdel
      have hvrow' :
          v ∈ (I.linkage.path (I.rowIndex Cross.rowRight)).vertexSet := by
        simpa [I.rowPath_eq_linkage_path Cross.rowRight] using hvrow
      have hvi_old : v ∈ (I.linkage.path i).vertexSet := by
        simpa [Cross.replacementLinkageConcrete_path_of_ne hileft hiright]
          using hvi
      exact False.elim <|
        Finset.disjoint_left.mp
          (I.linkage.toPathPacking.node_disjoint
            (fun h => hiright h.symm)) hvrow' hvi_old

/-- The deleted left middle segment witnesses an auxiliary edge between the two
replacement rows in the new linkage. -/
theorem replacementLinkageConcrete_adj_left_right_from_deletedLeftMiddle :
    (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
      (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight) := by
  refine ⟨Cross.rowIndex_ne, Or.inl ?_⟩
  refine ⟨PathPacking.BridgeBetween.of_orientedPath
    Cross.replacementLinkageConcrete.toPathPacking
    Cross.deletedLeftMiddle ?_ ?_
    Cross.deletedLeftMiddle_clean_replacementLinkageConcrete⟩
  · simpa [Cross.deletedLeftMiddle_source] using
      Cross.replacementPaths.s1_mem_leftPath
  · simpa [Cross.deletedLeftMiddle_target] using
      Cross.replacementPaths.s2_mem_rightPath

/-- The deleted right middle segment witnesses the same replacement-row
adjacency, in the opposite orientation. -/
theorem replacementLinkageConcrete_adj_right_left_from_deletedRightMiddle :
    (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
      (I.rowIndex Cross.rowRight) (I.rowIndex Cross.rowLeft) := by
  refine ⟨Cross.rowIndex_ne.symm, Or.inl ?_⟩
  refine ⟨PathPacking.BridgeBetween.of_orientedPath
    Cross.replacementLinkageConcrete.toPathPacking
    Cross.deletedRightMiddle ?_ ?_
    Cross.deletedRightMiddle_clean_replacementLinkageConcrete⟩
  · simpa [Cross.deletedRightMiddle_source] using
      Cross.replacementPaths.t2_mem_rightPath
  · simpa [Cross.deletedRightMiddle_target] using
      Cross.replacementPaths.t1_mem_leftPath

/-- If an old bridge from an unchanged linkage path first hits the inserted
`Q₁` segment of a cross, then the prefix to that first hit is a clean
successor bridge to the left replacement row. -/
theorem new_aux_adj_to_left_replacement_of_old_bridge_first_inserted_in_segment1
    {i j : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (β : I.linkage.toPathPacking.BridgeBetween i j)
    (hne : (β.orientedPath.vertexSet ∩
      Cross.insertedSegmentVertexSet).Nonempty)
    (hxseg :
      (β.orientedPath.cleanPrefixToSet
        Cross.insertedSegmentVertexSet hne).target ∈
          Cross.orientedSegment1.vertexSet) :
    (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
      i (I.rowIndex Cross.rowLeft) := by
  classical
  let P : GraphPath G := β.orientedPath
  let Prefix : GraphPath G :=
    P.cleanPrefixToSet Cross.insertedSegmentVertexSet hne
  have hsrc_new :
      Prefix.source ∈ (Cross.replacementLinkageConcrete.path i).vertexSet := by
    have hsrc_old : Prefix.source ∈ (I.linkage.path i).vertexSet := by
      simpa [Prefix, P] using
        PathPacking.BridgeBetween.orientedPath_source_mem_left β
    simpa [Cross.replacementLinkageConcrete_path_of_ne hileft hiright]
      using hsrc_old
  have hprefix_old :
      Prefix.InternallyDisjointFromSet
        I.linkage.toPathPacking.vertexSet := by
    simpa [Prefix, P, GraphPath.cleanPrefixToSet] using
      P.takeUntil_internallyDisjointFromSet
        (P.firstHitVertex_mem_vertexSet Cross.insertedSegmentVertexSet hne)
        β.orientedPath_internallyDisjoint
  have hprefix_new :
      Prefix.InternallyDisjointFromSet
        Cross.replacementLinkageConcrete.toPathPacking.vertexSet := by
    intro v hvPrefix hvnew
    by_cases hvold : v ∈ I.linkage.toPathPacking.vertexSet
    · exact hprefix_old hvPrefix hvold
    · have hvins := Cross.new_link_vertex_not_old_mem_insertedSegment
        hvnew hvold
      have hv_eq :
          v = P.firstHitVertex Cross.insertedSegmentVertexSet hne :=
        P.eq_firstHitVertex_of_mem_takeUntil_of_mem_set
          Cross.insertedSegmentVertexSet hne
          (by simpa [Prefix, GraphPath.cleanPrefixToSet] using hvPrefix)
          hvins
      exact Or.inr (by
        simpa [Prefix, P, GraphPath.cleanPrefixToSet] using hv_eq)
  have htgt_new :
      Prefix.target ∈
        (Cross.replacementLinkageConcrete.path
          (I.rowIndex Cross.rowLeft)).vertexSet := by
    have hleft :
        Prefix.target ∈ Cross.replacementPaths.leftPath.vertexSet :=
      Cross.replacementPaths.segment1_subset_leftPath hxseg
    simpa [Cross.replacementLinkageConcrete_path_left] using hleft
  exact ⟨hileft, Or.inl
    ⟨PathPacking.BridgeBetween.of_orientedPath
      Cross.replacementLinkageConcrete.toPathPacking Prefix hsrc_new
      htgt_new hprefix_new⟩⟩

/-- If an old bridge from an unchanged linkage path first hits the inserted
`Q₂` segment of a cross, then the prefix to that first hit is a clean
successor bridge to the right replacement row. -/
theorem new_aux_adj_to_right_replacement_of_old_bridge_first_inserted_in_segment2
    {i j : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (β : I.linkage.toPathPacking.BridgeBetween i j)
    (hne : (β.orientedPath.vertexSet ∩
      Cross.insertedSegmentVertexSet).Nonempty)
    (hxseg :
      (β.orientedPath.cleanPrefixToSet
        Cross.insertedSegmentVertexSet hne).target ∈
          Cross.orientedSegment2.vertexSet) :
    (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
      i (I.rowIndex Cross.rowRight) := by
  classical
  let P : GraphPath G := β.orientedPath
  let Prefix : GraphPath G :=
    P.cleanPrefixToSet Cross.insertedSegmentVertexSet hne
  have hsrc_new :
      Prefix.source ∈ (Cross.replacementLinkageConcrete.path i).vertexSet := by
    have hsrc_old : Prefix.source ∈ (I.linkage.path i).vertexSet := by
      simpa [Prefix, P] using
        PathPacking.BridgeBetween.orientedPath_source_mem_left β
    simpa [Cross.replacementLinkageConcrete_path_of_ne hileft hiright]
      using hsrc_old
  have hprefix_old :
      Prefix.InternallyDisjointFromSet
        I.linkage.toPathPacking.vertexSet := by
    simpa [Prefix, P, GraphPath.cleanPrefixToSet] using
      P.takeUntil_internallyDisjointFromSet
        (P.firstHitVertex_mem_vertexSet Cross.insertedSegmentVertexSet hne)
        β.orientedPath_internallyDisjoint
  have hprefix_new :
      Prefix.InternallyDisjointFromSet
        Cross.replacementLinkageConcrete.toPathPacking.vertexSet := by
    intro v hvPrefix hvnew
    by_cases hvold : v ∈ I.linkage.toPathPacking.vertexSet
    · exact hprefix_old hvPrefix hvold
    · have hvins := Cross.new_link_vertex_not_old_mem_insertedSegment
        hvnew hvold
      have hv_eq :
          v = P.firstHitVertex Cross.insertedSegmentVertexSet hne :=
        P.eq_firstHitVertex_of_mem_takeUntil_of_mem_set
          Cross.insertedSegmentVertexSet hne
          (by simpa [Prefix, GraphPath.cleanPrefixToSet] using hvPrefix)
          hvins
      exact Or.inr (by
        simpa [Prefix, P, GraphPath.cleanPrefixToSet] using hv_eq)
  have htgt_new :
      Prefix.target ∈
        (Cross.replacementLinkageConcrete.path
          (I.rowIndex Cross.rowRight)).vertexSet := by
    have hright :
        Prefix.target ∈ Cross.replacementPaths.rightPath.vertexSet :=
      Cross.replacementPaths.segment2_subset_rightPath hxseg
    simpa [Cross.replacementLinkageConcrete_path_right] using hright
  exact ⟨hiright, Or.inl
    ⟨PathPacking.BridgeBetween.of_orientedPath
      Cross.replacementLinkageConcrete.toPathPacking Prefix hsrc_new
      htgt_new hprefix_new⟩⟩

/-- Combined inserted-hit form for successor bridge survival: an old bridge
from an unchanged linkage path to either crossed row whose first new linkage
hit is inserted survives as a successor bridge to one of the two replacement
rows. -/
theorem new_aux_adj_to_replacement_of_old_bridge_hits_inserted
    {i j : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (β : I.linkage.toPathPacking.BridgeBetween i j)
    (hne : (β.orientedPath.vertexSet ∩
      Cross.insertedSegmentVertexSet).Nonempty) :
    (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        i (I.rowIndex Cross.rowLeft) ∨
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        i (I.rowIndex Cross.rowRight) := by
  have hx :
      (β.orientedPath.cleanPrefixToSet
        Cross.insertedSegmentVertexSet hne).target ∈
          Cross.insertedSegmentVertexSet := by
    exact β.orientedPath.cleanPrefixToSet_target_mem
      Cross.insertedSegmentVertexSet hne
  rcases Finset.mem_union.1 hx with hx1 | hx2
  · exact Or.inl
      (Cross.new_aux_adj_to_left_replacement_of_old_bridge_first_inserted_in_segment1
        hileft hiright β hne hx1)
  · exact Or.inr
      (Cross.new_aux_adj_to_right_replacement_of_old_bridge_first_inserted_in_segment2
        hileft hiright β hne hx2)

/-- An old bridge from an unchanged linkage path to the left crossed row
survives after a cross as a successor bridge to one of the two replacement
rows.  If the old bridge hits an inserted transversal segment, truncate to
the first inserted hit; if it misses the inserted segments but ends in the
deleted left middle interval, append along that deleted interval to `s₂`,
which now lies on the right replacement row. -/
theorem new_aux_adj_to_replacement_of_old_bridge_to_left_crossed_row
    {i : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (β : I.linkage.toPathPacking.BridgeBetween
      i (I.rowIndex Cross.rowLeft)) :
    (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        i (I.rowIndex Cross.rowLeft) ∨
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        i (I.rowIndex Cross.rowRight) := by
  classical
  by_cases hhit :
      (β.orientedPath.vertexSet ∩ Cross.insertedSegmentVertexSet).Nonempty
  · exact Cross.new_aux_adj_to_replacement_of_old_bridge_hits_inserted
      hileft hiright β hhit
  · have hmiss :
        Disjoint β.orientedPath.vertexSet Cross.insertedSegmentVertexSet := by
      rw [Finset.disjoint_left]
      intro v hvP hvIns
      exact hhit ⟨v, Finset.mem_inter.2 ⟨hvP, hvIns⟩⟩
    let P : GraphPath G := β.orientedPath
    have hsrc_old : P.source ∈ (I.linkage.path i).vertexSet := by
      simpa [P] using
        PathPacking.BridgeBetween.orientedPath_source_mem_left β
    have hsrc_new :
        P.source ∈ (Cross.replacementLinkageConcrete.path i).vertexSet := by
      simpa [P, Cross.replacementLinkageConcrete_path_of_ne hileft hiright]
        using hsrc_old
    have hclean_new :
        P.InternallyDisjointFromSet
          Cross.replacementLinkageConcrete.toPathPacking.vertexSet :=
      Cross.internallyDisjoint_new_of_old_clean_disjoint_inserted
        P β.orientedPath_internallyDisjoint hmiss
    have htgt_old :
        P.target ∈
          (I.linkage.path (I.rowIndex Cross.rowLeft)).vertexSet := by
      simpa [P] using
        PathPacking.BridgeBetween.orientedPath_target_mem_right β
    have htgt_row :
        P.target ∈ (I.rowPath Cross.rowLeft).vertexSet := by
      simpa [I.rowPath_eq_linkage_path Cross.rowLeft] using htgt_old
    rcases Cross.left_row_vertex_mem_prefix_or_deleted_or_suffix htgt_row with
      hpre | hdel | hsuf
    · have htgt_new :
          P.target ∈
            (Cross.replacementLinkageConcrete.path
              (I.rowIndex Cross.rowLeft)).vertexSet := by
        have hleft :
            P.target ∈ Cross.replacementPaths.leftPath.vertexSet :=
          Cross.replacementPaths.left_prefix_subset_leftPath hpre
        simpa [P, Cross.replacementLinkageConcrete_path_left] using hleft
      exact Or.inl ⟨hileft, Or.inl
        ⟨PathPacking.BridgeBetween.of_orientedPath
          Cross.replacementLinkageConcrete.toPathPacking P hsrc_new
          htgt_new hclean_new⟩⟩
    · by_cases hs1 : P.target = Cross.s1
      · have htgt_new :
            P.target ∈
              (Cross.replacementLinkageConcrete.path
                (I.rowIndex Cross.rowLeft)).vertexSet := by
          have hleft :
              P.target ∈ Cross.replacementPaths.leftPath.vertexSet := by
            rw [hs1]
            exact Cross.replacementPaths.s1_mem_leftPath
          simpa [P, Cross.replacementLinkageConcrete_path_left] using hleft
        exact Or.inl ⟨hileft, Or.inl
          ⟨PathPacking.BridgeBetween.of_orientedPath
            Cross.replacementLinkageConcrete.toPathPacking P hsrc_new
            htgt_new hclean_new⟩⟩
      · by_cases hs2 : P.target = Cross.s2
        · have htgt_new :
              P.target ∈
                (Cross.replacementLinkageConcrete.path
                  (I.rowIndex Cross.rowRight)).vertexSet := by
            have hright :
                P.target ∈ Cross.replacementPaths.rightPath.vertexSet := by
              rw [hs2]
              exact Cross.replacementPaths.s2_mem_rightPath
            simpa [P, Cross.replacementLinkageConcrete_path_right] using hright
          exact Or.inr ⟨hiright, Or.inl
            ⟨PathPacking.BridgeBetween.of_orientedPath
              Cross.replacementLinkageConcrete.toPathPacking P hsrc_new
              htgt_new hclean_new⟩⟩
        · let Tail : GraphPath G := Cross.deletedLeftMiddle.dropUntil hdel
          have hglue : P.target = Tail.source := by
            simp [Tail, P]
          have hinter :
              ∀ ⦃v : V⦄, v ∈ P.vertexSet → v ∈ Tail.vertexSet →
                v = P.target := by
            intro v hvP hvTail
            have hvdel :
                v ∈ Cross.deletedLeftMiddle.vertexSet :=
              Cross.deletedLeftMiddle.dropUntil_vertexSet_subset hdel
                (by simpa [Tail] using hvTail)
            have hvrow :
                v ∈ (I.rowPath Cross.rowLeft).vertexSet :=
              (I.rowPath Cross.rowLeft).segmentOfBefore_vertexSet_subset
                Cross.s1_before_s2 hvdel
            have hvold :
                v ∈ I.linkage.toPathPacking.vertexSet :=
              (I.linkage.toPathPacking.mem_vertexSet).2
                ⟨I.rowIndex Cross.rowLeft, by
                  simpa [I.rowPath_eq_linkage_path Cross.rowLeft] using hvrow⟩
            rcases β.orientedPath_internallyDisjoint
                (by simpa [P] using hvP) hvold with hsrc | htgt
            · have hv_i : v ∈ (I.linkage.path i).vertexSet := by
                simpa [P, hsrc] using hsrc_old
              have hv_left :
                  v ∈
                    (I.linkage.path (I.rowIndex Cross.rowLeft)).vertexSet := by
                simpa [I.rowPath_eq_linkage_path Cross.rowLeft] using hvrow
              exact False.elim <|
                Finset.disjoint_left.mp
                  (I.linkage.toPathPacking.node_disjoint hileft)
                  hv_i hv_left
            · simpa [P] using htgt
          have htail_clean :
              Tail.InternallyDisjointFromSet
                Cross.replacementLinkageConcrete.toPathPacking.vertexSet := by
            simpa [Tail] using
              Cross.deletedLeftMiddle.dropUntil_internallyDisjointFromSet
                hdel Cross.deletedLeftMiddle_clean_replacementLinkageConcrete
          have hglue_not_new :
              P.target ∉
                Cross.replacementLinkageConcrete.toPathPacking.vertexSet := by
            intro hnew
            rcases Cross.deletedLeftMiddle_clean_replacementLinkageConcrete
                hdel hnew with hS1 | hS2
            · exact hs1 (by
                simpa [P, Cross.deletedLeftMiddle_source] using hS1)
            · exact hs2 (by
                simpa [P, Cross.deletedLeftMiddle_target] using hS2)
          let Joined : GraphPath G :=
            P.appendWithEqOfInterSubsetTarget Tail hglue hinter
          have hjoined_clean :
              Joined.InternallyDisjointFromSet
                Cross.replacementLinkageConcrete.toPathPacking.vertexSet := by
            simpa [Joined] using
              P.appendWithEqOfInterSubsetTarget_internallyDisjointFromSet
                Tail hglue hinter hclean_new htail_clean hglue_not_new
          have hjoined_src :
              Joined.source ∈
                (Cross.replacementLinkageConcrete.path i).vertexSet := by
            simpa [Joined] using hsrc_new
          have hjoined_tgt :
              Joined.target ∈
                (Cross.replacementLinkageConcrete.path
                  (I.rowIndex Cross.rowRight)).vertexSet := by
            have htgt : Joined.target = Cross.s2 := by
              simp [Joined, Tail]
            have hright :
                Joined.target ∈ Cross.replacementPaths.rightPath.vertexSet := by
              rw [htgt]
              exact Cross.replacementPaths.s2_mem_rightPath
            simpa [Cross.replacementLinkageConcrete_path_right] using hright
          exact Or.inr ⟨hiright, Or.inl
            ⟨PathPacking.BridgeBetween.of_orientedPath
              Cross.replacementLinkageConcrete.toPathPacking Joined
              hjoined_src hjoined_tgt hjoined_clean⟩⟩
    · have htgt_new :
          P.target ∈
            (Cross.replacementLinkageConcrete.path
              (I.rowIndex Cross.rowRight)).vertexSet := by
        have hright :
            P.target ∈ Cross.replacementPaths.rightPath.vertexSet :=
          Cross.replacementPaths.left_suffix_subset_rightPath hsuf
        simpa [P, Cross.replacementLinkageConcrete_path_right] using hright
      exact Or.inr ⟨hiright, Or.inl
        ⟨PathPacking.BridgeBetween.of_orientedPath
          Cross.replacementLinkageConcrete.toPathPacking P hsrc_new
          htgt_new hclean_new⟩⟩

/-- Symmetric bridge-survival lemma for an old bridge from an unchanged
linkage path to the right crossed row.  The retained prefix of the right row
lies on the right replacement, while the retained suffix and the far endpoint
`t₁` lie on the left replacement. -/
theorem new_aux_adj_to_replacement_of_old_bridge_to_right_crossed_row
    {i : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (β : I.linkage.toPathPacking.BridgeBetween
      i (I.rowIndex Cross.rowRight)) :
    (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        i (I.rowIndex Cross.rowLeft) ∨
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        i (I.rowIndex Cross.rowRight) := by
  classical
  by_cases hhit :
      (β.orientedPath.vertexSet ∩ Cross.insertedSegmentVertexSet).Nonempty
  · exact Cross.new_aux_adj_to_replacement_of_old_bridge_hits_inserted
      hileft hiright β hhit
  · have hmiss :
        Disjoint β.orientedPath.vertexSet Cross.insertedSegmentVertexSet := by
      rw [Finset.disjoint_left]
      intro v hvP hvIns
      exact hhit ⟨v, Finset.mem_inter.2 ⟨hvP, hvIns⟩⟩
    let P : GraphPath G := β.orientedPath
    have hsrc_old : P.source ∈ (I.linkage.path i).vertexSet := by
      simpa [P] using
        PathPacking.BridgeBetween.orientedPath_source_mem_left β
    have hsrc_new :
        P.source ∈ (Cross.replacementLinkageConcrete.path i).vertexSet := by
      simpa [P, Cross.replacementLinkageConcrete_path_of_ne hileft hiright]
        using hsrc_old
    have hclean_new :
        P.InternallyDisjointFromSet
          Cross.replacementLinkageConcrete.toPathPacking.vertexSet :=
      Cross.internallyDisjoint_new_of_old_clean_disjoint_inserted
        P β.orientedPath_internallyDisjoint hmiss
    have htgt_old :
        P.target ∈
          (I.linkage.path (I.rowIndex Cross.rowRight)).vertexSet := by
      simpa [P] using
        PathPacking.BridgeBetween.orientedPath_target_mem_right β
    have htgt_row :
        P.target ∈ (I.rowPath Cross.rowRight).vertexSet := by
      simpa [I.rowPath_eq_linkage_path Cross.rowRight] using htgt_old
    rcases Cross.right_row_vertex_mem_prefix_or_deleted_or_suffix htgt_row with
      hpre | hdel | hsuf
    · have htgt_new :
          P.target ∈
            (Cross.replacementLinkageConcrete.path
              (I.rowIndex Cross.rowRight)).vertexSet := by
        have hright :
            P.target ∈ Cross.replacementPaths.rightPath.vertexSet :=
          Cross.replacementPaths.right_prefix_subset_rightPath hpre
        simpa [P, Cross.replacementLinkageConcrete_path_right] using hright
      exact Or.inr ⟨hiright, Or.inl
        ⟨PathPacking.BridgeBetween.of_orientedPath
          Cross.replacementLinkageConcrete.toPathPacking P hsrc_new
          htgt_new hclean_new⟩⟩
    · by_cases ht2 : P.target = Cross.t2
      · have htgt_new :
            P.target ∈
              (Cross.replacementLinkageConcrete.path
                (I.rowIndex Cross.rowRight)).vertexSet := by
          have hright :
              P.target ∈ Cross.replacementPaths.rightPath.vertexSet := by
            rw [ht2]
            exact Cross.replacementPaths.t2_mem_rightPath
          simpa [P, Cross.replacementLinkageConcrete_path_right] using hright
        exact Or.inr ⟨hiright, Or.inl
          ⟨PathPacking.BridgeBetween.of_orientedPath
            Cross.replacementLinkageConcrete.toPathPacking P hsrc_new
            htgt_new hclean_new⟩⟩
      · by_cases ht1 : P.target = Cross.t1
        · have htgt_new :
              P.target ∈
                (Cross.replacementLinkageConcrete.path
                  (I.rowIndex Cross.rowLeft)).vertexSet := by
            have hleft :
                P.target ∈ Cross.replacementPaths.leftPath.vertexSet := by
              rw [ht1]
              exact Cross.replacementPaths.t1_mem_leftPath
            simpa [P, Cross.replacementLinkageConcrete_path_left] using hleft
          exact Or.inl ⟨hileft, Or.inl
            ⟨PathPacking.BridgeBetween.of_orientedPath
              Cross.replacementLinkageConcrete.toPathPacking P hsrc_new
              htgt_new hclean_new⟩⟩
        · let Tail : GraphPath G := Cross.deletedRightMiddle.dropUntil hdel
          have hglue : P.target = Tail.source := by
            simp [Tail, P]
          have hinter :
              ∀ ⦃v : V⦄, v ∈ P.vertexSet → v ∈ Tail.vertexSet →
                v = P.target := by
            intro v hvP hvTail
            have hvdel :
                v ∈ Cross.deletedRightMiddle.vertexSet :=
              Cross.deletedRightMiddle.dropUntil_vertexSet_subset hdel
                (by simpa [Tail] using hvTail)
            have hvrow :
                v ∈ (I.rowPath Cross.rowRight).vertexSet :=
              (I.rowPath Cross.rowRight).segmentOfBefore_vertexSet_subset
                Cross.t2_before_t1 hvdel
            have hvold :
                v ∈ I.linkage.toPathPacking.vertexSet :=
              (I.linkage.toPathPacking.mem_vertexSet).2
                ⟨I.rowIndex Cross.rowRight, by
                  simpa [I.rowPath_eq_linkage_path Cross.rowRight] using hvrow⟩
            rcases β.orientedPath_internallyDisjoint
                (by simpa [P] using hvP) hvold with hsrc | htgt
            · have hv_i : v ∈ (I.linkage.path i).vertexSet := by
                simpa [P, hsrc] using hsrc_old
              have hv_right :
                  v ∈
                    (I.linkage.path (I.rowIndex Cross.rowRight)).vertexSet := by
                simpa [I.rowPath_eq_linkage_path Cross.rowRight] using hvrow
              exact False.elim <|
                Finset.disjoint_left.mp
                  (I.linkage.toPathPacking.node_disjoint hiright)
                  hv_i hv_right
            · simpa [P] using htgt
          have htail_clean :
              Tail.InternallyDisjointFromSet
                Cross.replacementLinkageConcrete.toPathPacking.vertexSet := by
            simpa [Tail] using
              Cross.deletedRightMiddle.dropUntil_internallyDisjointFromSet
                hdel Cross.deletedRightMiddle_clean_replacementLinkageConcrete
          have hglue_not_new :
              P.target ∉
                Cross.replacementLinkageConcrete.toPathPacking.vertexSet := by
            intro hnew
            rcases Cross.deletedRightMiddle_clean_replacementLinkageConcrete
                hdel hnew with hT2 | hT1
            · exact ht2 (by
                simpa [P, Cross.deletedRightMiddle_source] using hT2)
            · exact ht1 (by
                simpa [P, Cross.deletedRightMiddle_target] using hT1)
          let Joined : GraphPath G :=
            P.appendWithEqOfInterSubsetTarget Tail hglue hinter
          have hjoined_clean :
              Joined.InternallyDisjointFromSet
                Cross.replacementLinkageConcrete.toPathPacking.vertexSet := by
            simpa [Joined] using
              P.appendWithEqOfInterSubsetTarget_internallyDisjointFromSet
                Tail hglue hinter hclean_new htail_clean hglue_not_new
          have hjoined_src :
              Joined.source ∈
                (Cross.replacementLinkageConcrete.path i).vertexSet := by
            simpa [Joined] using hsrc_new
          have hjoined_tgt :
              Joined.target ∈
                (Cross.replacementLinkageConcrete.path
                  (I.rowIndex Cross.rowLeft)).vertexSet := by
            have htgt : Joined.target = Cross.t1 := by
              simp [Joined, Tail]
            have hleft :
                Joined.target ∈ Cross.replacementPaths.leftPath.vertexSet := by
              rw [htgt]
              exact Cross.replacementPaths.t1_mem_leftPath
            simpa [Cross.replacementLinkageConcrete_path_left] using hleft
          exact Or.inl ⟨hileft, Or.inl
            ⟨PathPacking.BridgeBetween.of_orientedPath
              Cross.replacementLinkageConcrete.toPathPacking Joined
              hjoined_src hjoined_tgt hjoined_clean⟩⟩
    · have htgt_new :
          P.target ∈
            (Cross.replacementLinkageConcrete.path
              (I.rowIndex Cross.rowLeft)).vertexSet := by
        have hleft :
            P.target ∈ Cross.replacementPaths.leftPath.vertexSet :=
          Cross.replacementPaths.right_suffix_subset_leftPath hsuf
        simpa [P, Cross.replacementLinkageConcrete_path_left] using hleft
      exact Or.inl ⟨hileft, Or.inl
        ⟨PathPacking.BridgeBetween.of_orientedPath
          Cross.replacementLinkageConcrete.toPathPacking P hsrc_new
          htgt_new hclean_new⟩⟩

/-- Auxiliary-adjacency version of
`new_aux_adj_to_replacement_of_old_bridge_to_left_crossed_row`.

The old auxiliary edge may be witnessed in either orientation.  Reversing the
bridge if necessary gives an old bridge from the unchanged endpoint to the
left crossed row, and the bridge-survival lemma then attaches that endpoint to
one of the two replacement rows. -/
theorem new_aux_adj_to_replacement_of_old_adj_to_left_crossed_row
    {i : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (hadj :
      (linkageAuxGraph I.linkage).Adj i (I.rowIndex Cross.rowLeft)) :
    (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        i (I.rowIndex Cross.rowLeft) ∨
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        i (I.rowIndex Cross.rowRight) := by
  rcases hadj with ⟨_hne, hbridge | hbridge⟩
  · rcases hbridge with ⟨β⟩
    exact Cross.new_aux_adj_to_replacement_of_old_bridge_to_left_crossed_row
      hileft hiright β
  · rcases hbridge with ⟨β⟩
    exact Cross.new_aux_adj_to_replacement_of_old_bridge_to_left_crossed_row
      hileft hiright (reverseBridge β)

/-- Symmetric adjacency-survival statement for an old edge written with the
crossed row first. -/
theorem new_aux_adj_from_left_replacement_of_old_adj_from_left_crossed_row
    {i : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (hadj :
      (linkageAuxGraph I.linkage).Adj (I.rowIndex Cross.rowLeft) i) :
    (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        (I.rowIndex Cross.rowLeft) i ∨
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        (I.rowIndex Cross.rowRight) i := by
  have h :=
    Cross.new_aux_adj_to_replacement_of_old_adj_to_left_crossed_row
      hileft hiright ((linkageAuxGraph I.linkage).symm hadj)
  exact h.imp
    (fun hleft => (linkageAuxGraph Cross.replacementLinkageConcrete).symm hleft)
    (fun hright => (linkageAuxGraph Cross.replacementLinkageConcrete).symm hright)

/-- Auxiliary-adjacency version of
`new_aux_adj_to_replacement_of_old_bridge_to_right_crossed_row`. -/
theorem new_aux_adj_to_replacement_of_old_adj_to_right_crossed_row
    {i : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (hadj :
      (linkageAuxGraph I.linkage).Adj i (I.rowIndex Cross.rowRight)) :
    (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        i (I.rowIndex Cross.rowLeft) ∨
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        i (I.rowIndex Cross.rowRight) := by
  rcases hadj with ⟨_hne, hbridge | hbridge⟩
  · rcases hbridge with ⟨β⟩
    exact Cross.new_aux_adj_to_replacement_of_old_bridge_to_right_crossed_row
      hileft hiright β
  · rcases hbridge with ⟨β⟩
    exact Cross.new_aux_adj_to_replacement_of_old_bridge_to_right_crossed_row
      hileft hiright (reverseBridge β)

/-- Symmetric adjacency-survival statement for an old edge written with the
right crossed row first. -/
theorem new_aux_adj_from_replacement_of_old_adj_from_right_crossed_row
    {i : I.linkage.Index}
    (hileft : i ≠ I.rowIndex Cross.rowLeft)
    (hiright : i ≠ I.rowIndex Cross.rowRight)
    (hadj :
      (linkageAuxGraph I.linkage).Adj (I.rowIndex Cross.rowRight) i) :
    (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        (I.rowIndex Cross.rowLeft) i ∨
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        (I.rowIndex Cross.rowRight) i := by
  have h :=
    Cross.new_aux_adj_to_replacement_of_old_adj_to_right_crossed_row
      hileft hiright ((linkageAuxGraph I.linkage).symm hadj)
  exact h.imp
    (fun hleft => (linkageAuxGraph Cross.replacementLinkageConcrete).symm hleft)
    (fun hright => (linkageAuxGraph Cross.replacementLinkageConcrete).symm hright)

/-- The two crossed rows are distinct. -/
theorem rowLeft_ne_rowRight : Cross.rowLeft ≠ Cross.rowRight := by
  intro h
  exact Cross.rowIndex_ne (by rw [h])

/-- Concrete attachment dispatch for the nonterminating cross branch.

The old local adjacencies `A -- rowLeft` and `rowRight -- D` survive as
attachments from `A` and `D` to one of the two replacement rows.  Since the
replacement rows are adjacent and remain degree two, the two outside endpoints
must attach to different replacement rows. -/
theorem replacement_attachment_order_of_old_local_data
    (auxA auxD : I.linkage.Index)
    (hAU_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Cross.rowLeft))
    (hVD_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hU_new :
      DegreeEquals (linkageAuxGraph Cross.replacementLinkageConcrete)
        (I.rowIndex Cross.rowLeft) 2)
    (hV_new :
      DegreeEquals (linkageAuxGraph Cross.replacementLinkageConcrete)
        (I.rowIndex Cross.rowRight) 2)
    (hAV : auxA ≠ I.rowIndex Cross.rowRight)
    (hUD : I.rowIndex Cross.rowLeft ≠ auxD)
    (hAD : auxA ≠ auxD) :
    ((linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        auxA (I.rowIndex Cross.rowLeft) ∧
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        (I.rowIndex Cross.rowRight) auxD) ∨
    ((linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        auxA (I.rowIndex Cross.rowRight) ∧
      (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        (I.rowIndex Cross.rowLeft) auxD) := by
  classical
  let H' := linkageAuxGraph Cross.replacementLinkageConcrete
  have hA_attach :
      H'.Adj auxA (I.rowIndex Cross.rowLeft) ∨
        H'.Adj auxA (I.rowIndex Cross.rowRight) := by
    simpa [H'] using
      Cross.new_aux_adj_to_replacement_of_old_adj_to_left_crossed_row
        hAU_old.1 hAV hAU_old
  have hD_attach :
      H'.Adj auxD (I.rowIndex Cross.rowLeft) ∨
        H'.Adj auxD (I.rowIndex Cross.rowRight) := by
    have hD_ne_left : auxD ≠ I.rowIndex Cross.rowLeft := hUD.symm
    have hD_ne_right : auxD ≠ I.rowIndex Cross.rowRight := hVD_old.1.symm
    simpa [H'] using
      Cross.new_aux_adj_to_replacement_of_old_adj_to_right_crossed_row
        hD_ne_left hD_ne_right
        ((linkageAuxGraph I.linkage).symm hVD_old)
  have horder :=
    cross_attachment_order_of_degree_two
      (H := H') (A := auxA) (U := I.rowIndex Cross.rowLeft)
      (V := I.rowIndex Cross.rowRight) (D := auxD)
      (by
        simpa [H'] using
          Cross.replacementLinkageConcrete_adj_left_right_from_deletedLeftMiddle)
      (by simpa [H'] using hU_new)
      (by simpa [H'] using hV_new)
      hA_attach hD_attach hAU_old.1 hAV hUD hVD_old.1.symm hAD
  simpa [H'] using horder

/-- Row family obtained from a cross when the successor order is the
left-to-right order of the two switched rows. -/
noncomputable def successorRowPathLeftRight (r : I.Row) : GraphPath G :=
  if r = Cross.rowLeft then
    Cross.replacementPaths.leftPath
  else if r = Cross.rowRight then
    Cross.replacementPaths.rightPath
  else
    I.rowPath r

@[simp] theorem successorRowPathLeftRight_left :
    Cross.successorRowPathLeftRight Cross.rowLeft =
      Cross.replacementPaths.leftPath := by
  simp [successorRowPathLeftRight]

@[simp] theorem successorRowPathLeftRight_right :
    Cross.successorRowPathLeftRight Cross.rowRight =
      Cross.replacementPaths.rightPath := by
  simp [successorRowPathLeftRight, Cross.rowLeft_ne_rowRight.symm]

@[simp] theorem successorRowPathLeftRight_of_ne
    {r : I.Row} (hleft : r ≠ Cross.rowLeft)
    (hright : r ≠ Cross.rowRight) :
    Cross.successorRowPathLeftRight r = I.rowPath r := by
  simp [successorRowPathLeftRight, hleft, hright]

/-- Left-to-right cross successor row-contact invariant from the two genuine
contact-survival obligations.

Rows outside the crossed pair are unchanged.  The two displayed crossed rows
are replaced by the left and right switched rows, so it is enough to prove
that every fixed `Q₀` path hits both replacement rows. -/
theorem successorCurrentRowsInvariantLeftRight_of_replacement_hits
    (hleftHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.leftPath)
    (hrightHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.rightPath) :
    TypeOneCurrentRowsInvariant R hpos Q0 I.Row
      Cross.successorRowPathLeftRight := by
  classical
  intro i hi
  rcases I.q0_intersection_invariant i hi with
    ⟨hrows, hp0, hpz, havoid⟩
  refine ⟨?_, hp0, hpz, havoid⟩
  intro r
  by_cases hleft : r = Cross.rowLeft
  · subst r
    simpa using hleftHit i hi
  · by_cases hright : r = Cross.rowRight
    · subst r
      simpa using hrightHit i hi
    · simpa [Cross.successorRowPathLeftRight_of_ne hleft hright]
        using hrows r

/-- Left-to-right cross successor row-contact traces from the two
replacement-hit obligations. -/
theorem successorBareExtendedRowContactTracesLeftRight_of_replacement_hits
    (order : I.Row ≃ Fin (z h))
    (hleftHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.leftPath)
    (hrightHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.rightPath) :
    ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
      Nonempty
        (TypeOneBareExtendedRowContactTrace
          (h := h) I.Row order Cross.successorRowPathLeftRight
          (Q0.data i hi).qstar) :=
  TypeOneBareExtendedRowContactTrace.nonempty_of_currentRowsInvariant
    (order := order)
    (Cross.successorCurrentRowsInvariantLeftRight_of_replacement_hits
      hleftHit hrightHit)

/-- The linkage index map for the left-to-right cross successor keeps the same
row index names. -/
def successorRowIndexLeftRight (r : I.Row) :
    Cross.replacementLinkageConcrete.Index :=
  I.rowIndex r

theorem successorRowPathLeftRight_eq_linkage_path
    (r : I.Row) :
    Cross.successorRowPathLeftRight r =
      Cross.replacementLinkageConcrete.path
        (Cross.successorRowIndexLeftRight r) := by
  by_cases hleft : r = Cross.rowLeft
  · subst hleft
    simp [successorRowIndexLeftRight]
  · by_cases hright : r = Cross.rowRight
    · subst hright
      simp [successorRowIndexLeftRight]
    · rw [Cross.successorRowPathLeftRight_of_ne hleft hright]
      rw [I.rowPath_eq_linkage_path r]
      exact (Cross.replacementLinkageConcrete_path_of_ne
        (fun hidx => hleft (Cross.rowLeft_index_unique r hidx))
        (fun hidx => hright (Cross.rowRight_index_unique r hidx))).symm

/-- Concrete successor `IterationInput` for the left-to-right cross branch.

The only input is the invariant update proved by the nonterminating branch:
the fixed `Q0` paths still meet every successor row and avoid the same outside
linkage paths.  The row replacement, linkage construction, row-index
bookkeeping, and auxiliary isomorphism are all filled in here. -/
noncomputable def successorInputLeftRight
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathLeftRight) :
    IterationInput R hpos Q0 where
  Row := I.Row
  rowFintype := inferInstance
  rowDecidableEq := inferInstance
  rowPath := Cross.successorRowPathLeftRight
  linkage := Cross.replacementLinkageConcrete
  rowIndex := Cross.successorRowIndexLeftRight
  rowPath_eq_linkage_path :=
    Cross.successorRowPathLeftRight_eq_linkage_path
  linkage_is_block_replacement := I.linkage_is_block_replacement
  aux_iso_fixed_outside := haux
  q0_intersection_invariant := hq0

/-- The left-to-right cross successor preserves injectivity of the row labels
into the linkage index type. -/
theorem successorInputLeftRight_rowIndexInjective
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathLeftRight)
    (hinj : I.RowIndexInjective) :
    (Cross.successorInputLeftRight haux hq0).RowIndexInjective := by
  intro r s hrs
  exact hinj hrs

/-- The left-to-right cross successor keeps the same displayed row order. -/
noncomputable def successorInputLeftRight_orderedRows
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathLeftRight)
    (O : I.OrderedRows) :
    (Cross.successorInputLeftRight haux hq0).OrderedRows where
  order := O.order

/-- The left-to-right cross successor preserves the explicit iteration
invariant package, provided the local nonterminating analysis has supplied the
successor `Q0` contact invariant. -/
noncomputable def successorInputLeftRight_iterationInvariants
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathLeftRight)
    (Inv : TypeOneIterationInvariants I) :
    TypeOneIterationInvariants
      (Cross.successorInputLeftRight haux hq0) where
  orderedRows :=
    Cross.successorInputLeftRight_orderedRows haux hq0 Inv.orderedRows
  rowIndexInjective :=
    Cross.successorInputLeftRight_rowIndexInjective haux hq0
      Inv.rowIndexInjective
  rowsNodeDisjoint :=
    IterationInput.rowsNodeDisjoint_of_rowIndexInjective
      (Cross.successorInputLeftRight haux hq0)
      (Cross.successorInputLeftRight_rowIndexInjective haux hq0
        Inv.rowIndexInjective)

/-- The left-to-right concrete cross successor preserves the active auxiliary
two-path invariant when the local nonterminating branch proves that auxiliary
adjacency is unchanged on the shared index type. -/
noncomputable def successorInputLeftRight_activeAuxiliaryInvariant
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathLeftRight)
    (Inv : TypeOneIterationInvariants I)
    (Haux : TypeOneActiveAuxiliaryInvariant I Inv)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j) :
    TypeOneActiveAuxiliaryInvariant
      (Cross.successorInputLeftRight haux hq0)
      (Cross.successorInputLeftRight_iterationInvariants haux hq0 Inv) where
  degree_two := by
    intro r
    have hiff :
        ∀ x y : I.linkage.Index,
          (linkageAuxGraph I.linkage).Adj x y ↔
            (linkageAuxGraph Cross.replacementLinkageConcrete).Adj x y := by
      intro x y
      exact (hadj_iff x y).symm
    simpa [successorInputLeftRight, successorRowIndexLeftRight] using
      (degreeEquals_equiv_iff (Equiv.refl I.linkage.Index) hiff).1
        (Haux.degree_two r)
  consecutive_adj := by
    intro r s hcon
    exact (hadj_iff (I.rowIndex r) (I.rowIndex s)).2
      (Haux.consecutive_adj hcon)
  no_chord := by
    intro r s hnew
    exact Haux.no_chord ((hadj_iff (I.rowIndex r) (I.rowIndex s)).1 hnew)

/-- The left-to-right cross successor preserves the two fixed boundary rows
when the nonterminating local analysis proves unchanged auxiliary adjacency
on the shared index type. -/
noncomputable def successorInputLeftRight_boundaryAuxiliaryInvariant
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathLeftRight)
    (Inv : TypeOneExtendedFullIterationInvariants I)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j) :
    TypeOneBoundaryAuxiliaryInvariant
      (Cross.successorInputLeftRight haux hq0)
      (Cross.successorInputLeftRight_iterationInvariants haux hq0
        Inv.full.base) where
  lowerBoundary := Inv.boundary.lowerBoundary
  upperBoundary := Inv.boundary.upperBoundary
  lower_path_eq := by
    change Cross.replacementLinkageConcrete.path Inv.boundary.lowerBoundary =
      L.path R.p0Index
    rw [Cross.replacementLinkageConcrete_path_of_ne
      (Inv.boundary.lower_ne_row Cross.rowLeft)
      (Inv.boundary.lower_ne_row Cross.rowRight)]
    exact Inv.boundary.lower_path_eq
  upper_path_eq := by
    change Cross.replacementLinkageConcrete.path Inv.boundary.upperBoundary =
      L.path (R.pZPlusOneIndex hpos)
    rw [Cross.replacementLinkageConcrete_path_of_ne
      (Inv.boundary.upper_ne_row Cross.rowLeft)
      (Inv.boundary.upper_ne_row Cross.rowRight)]
    exact Inv.boundary.upper_path_eq
  lower_ne_row := by
    intro r
    exact Inv.boundary.lower_ne_row r
  upper_ne_row := by
    intro r
    exact Inv.boundary.upper_ne_row r
  lower_degree_two := by
    have hiff :
        ∀ x y : I.linkage.Index,
          (linkageAuxGraph I.linkage).Adj x y ↔
            (linkageAuxGraph Cross.replacementLinkageConcrete).Adj x y := by
      intro x y
      exact (hadj_iff x y).symm
    simpa [successorInputLeftRight, successorRowIndexLeftRight] using
      (degreeEquals_equiv_iff (Equiv.refl I.linkage.Index) hiff).1
        Inv.boundary.lower_degree_two
  upper_degree_two := by
    have hiff :
        ∀ x y : I.linkage.Index,
          (linkageAuxGraph I.linkage).Adj x y ↔
            (linkageAuxGraph Cross.replacementLinkageConcrete).Adj x y := by
      intro x y
      exact (hadj_iff x y).symm
    simpa [successorInputLeftRight, successorRowIndexLeftRight] using
      (degreeEquals_equiv_iff (Equiv.refl I.linkage.Index) hiff).1
        Inv.boundary.upper_degree_two
  lower_adj_first := by
    exact (hadj_iff Inv.boundary.lowerBoundary
      (I.rowIndex
        ((Cross.successorInputLeftRight_iterationInvariants haux hq0
          Inv.full.base).orderedRows.order.symm
            (⟨0, by dsimp [z]; omega⟩ : Fin (z h))))).2
      Inv.boundary.lower_adj_first
  last_adj_upper := by
    exact (hadj_iff
      (I.rowIndex
        ((Cross.successorInputLeftRight_iterationInvariants haux hq0
          Inv.full.base).orderedRows.order.symm
            (⟨z h - 1, by dsimp [z]; omega⟩ : Fin (z h))))
      Inv.boundary.upperBoundary).2
      Inv.boundary.last_adj_upper
  lowerOutside := Inv.boundary.lowerOutside
  upperOutside := Inv.boundary.upperOutside
  lower_adj_outside := by
    exact (hadj_iff Inv.boundary.lowerBoundary
      Inv.boundary.lowerOutside).2 Inv.boundary.lower_adj_outside
  upper_adj_outside := by
    exact (hadj_iff Inv.boundary.upperBoundary
      Inv.boundary.upperOutside).2 Inv.boundary.upper_adj_outside
  lowerOutside_ne_row := by
    intro r
    exact Inv.boundary.lowerOutside_ne_row r
  upperOutside_ne_row := by
    intro r
    exact Inv.boundary.upperOutside_ne_row r
  lowerOutside_ne_lower := Inv.boundary.lowerOutside_ne_lower
  lowerOutside_ne_upper := Inv.boundary.lowerOutside_ne_upper
  upperOutside_ne_lower := Inv.boundary.upperOutside_ne_lower
  upperOutside_ne_upper := Inv.boundary.upperOutside_ne_upper

/-- The left-to-right cross successor does not add edges to the maintained
graph `H̃`: the new row edges are old row edges or edges of the fixed `Q0`
family. -/
theorem successorInputLeftRight_tilde_subset
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathLeftRight) :
    (Cross.successorInputLeftRight haux hq0).tildeEdgeSet ⊆
      I.tildeEdgeSet := by
  classical
  intro e he
  rcases Finset.mem_union.1 (by
      simpa [successorInputLeftRight, IterationInput.tildeEdgeSet] using he)
    with hrow | hQ0
  · have hrow' :
        e ∈ Finset.univ.biUnion
          (fun r : I.Row => (Cross.successorRowPathLeftRight r).edgeSet) := by
      simpa [IterationInput.rowEdgeSet, successorInputLeftRight] using hrow
    rcases Finset.mem_biUnion.mp hrow' with ⟨r, _hr, her⟩
    by_cases hleft : r = Cross.rowLeft
    · subst hleft
      have hraw :=
        Cross.replacementPaths_left_edgeSet_subset_rows_union_Q0
          (by simpa using her)
      rcases Finset.mem_union.1 hraw with hrows | hq
      · rcases Finset.mem_union.1 hrows with hleftEdge | hrightEdge
        · have heRows : e ∈ I.rowEdgeSet :=
            Finset.mem_biUnion.mpr
              ⟨Cross.rowLeft, Finset.mem_univ _, hleftEdge⟩
          exact Finset.mem_union.2 (Or.inl heRows)
        · have heRows : e ∈ I.rowEdgeSet :=
            Finset.mem_biUnion.mpr
              ⟨Cross.rowRight, Finset.mem_univ _, hrightEdge⟩
          exact Finset.mem_union.2 (Or.inl heRows)
      · exact Finset.mem_union.2 (Or.inr hq)
    · by_cases hright : r = Cross.rowRight
      · subst hright
        have hraw :=
          Cross.replacementPaths_right_edgeSet_subset_rows_union_Q0
            (by simpa using her)
        rcases Finset.mem_union.1 hraw with hrows | hq
        · rcases Finset.mem_union.1 hrows with hleftEdge | hrightEdge
          · have heRows : e ∈ I.rowEdgeSet :=
              Finset.mem_biUnion.mpr
                ⟨Cross.rowLeft, Finset.mem_univ _, hleftEdge⟩
            exact Finset.mem_union.2 (Or.inl heRows)
          · have heRows : e ∈ I.rowEdgeSet :=
              Finset.mem_biUnion.mpr
                ⟨Cross.rowRight, Finset.mem_univ _, hrightEdge⟩
            exact Finset.mem_union.2 (Or.inl heRows)
        · exact Finset.mem_union.2 (Or.inr hq)
      · have herOld : e ∈ (I.rowPath r).edgeSet := by
          simpa [Cross.successorRowPathLeftRight_of_ne hleft hright] using her
        have heRows : e ∈ I.rowEdgeSet :=
          Finset.mem_biUnion.mpr ⟨r, Finset.mem_univ _, herOld⟩
        exact Finset.mem_union.2 (Or.inl heRows)
  · exact Finset.mem_union.2 (Or.inr hQ0)

/-- The explicit linkage-support invariant survives the left-to-right cross
successor.  The only changed linkage paths are the two successor rows, so
all unchanged linkage vertices inherit the old support classification. -/
theorem successorInputLeftRight_typeOneLinkageSupportInvariant
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathLeftRight)
    (hsupport : IterationInput.TypeOneLinkageSupportInvariant I) :
    IterationInput.TypeOneLinkageSupportInvariant
      (Cross.successorInputLeftRight haux hq0) := by
  classical
  intro v hv
  rcases ((Cross.successorInputLeftRight haux hq0).linkage.toPathPacking.mem_vertexSet).1
      hv with ⟨i, hvi⟩
  by_cases hileft : i = I.rowIndex Cross.rowLeft
  · subst i
    exact Finset.mem_union.2 (Or.inl (by
      rw [IterationInput.rowVertexSet]
      exact Finset.mem_biUnion.mpr
        ⟨Cross.rowLeft, Finset.mem_univ Cross.rowLeft, by
          simpa [successorInputLeftRight] using hvi⟩))
  · by_cases hiright : i = I.rowIndex Cross.rowRight
    · subst i
      exact Finset.mem_union.2 (Or.inl (by
        rw [IterationInput.rowVertexSet]
        exact Finset.mem_biUnion.mpr
          ⟨Cross.rowRight, Finset.mem_univ Cross.rowRight, by
            simpa [successorInputLeftRight] using hvi⟩))
    · have hv_old_path : v ∈ (I.linkage.path i).vertexSet := by
        change v ∈ (Cross.replacementLinkageConcrete.path i).vertexSet at hvi
        rwa [Cross.replacementLinkageConcrete_path_of_ne hileft hiright] at hvi
      have hv_old_link : v ∈ I.linkage.toPathPacking.vertexSet :=
        (I.linkage.toPathPacking.mem_vertexSet).2 ⟨i, hv_old_path⟩
      have hraw := hsupport hv_old_link
      rcases Finset.mem_union.1 hraw with hrow | hrest
      · rw [IterationInput.rowVertexSet] at hrow
        rcases Finset.mem_biUnion.1 hrow with ⟨r, _hr, hvr⟩
        have hr_ne_left : r ≠ Cross.rowLeft := by
          intro hr
          subst r
          have hvleft :
              v ∈ (I.linkage.path (I.rowIndex Cross.rowLeft)).vertexSet := by
            simpa [I.rowPath_eq_linkage_path Cross.rowLeft] using hvr
          exact Finset.disjoint_left.mp
            (I.linkage.toPathPacking.node_disjoint hileft) hv_old_path hvleft
        have hr_ne_right : r ≠ Cross.rowRight := by
          intro hr
          subst r
          have hvright :
              v ∈ (I.linkage.path (I.rowIndex Cross.rowRight)).vertexSet := by
            simpa [I.rowPath_eq_linkage_path Cross.rowRight] using hvr
          exact Finset.disjoint_left.mp
            (I.linkage.toPathPacking.node_disjoint hiright) hv_old_path hvright
        exact Finset.mem_union.2 (Or.inl (by
          rw [IterationInput.rowVertexSet]
          exact Finset.mem_biUnion.mpr ⟨r, Finset.mem_univ r, by
            simpa [successorInputLeftRight,
              Cross.successorRowPathLeftRight_of_ne hr_ne_left hr_ne_right]
              using hvr⟩))
      · exact Finset.mem_union.2 (Or.inr hrest)

/-- A deleted left-middle edge is not an edge of any successor row in the
left-to-right cross successor. -/
theorem deletedLeftMiddle_edgeDisjoint_successorRowPathLeftRight
    (r : I.Row) :
    Cross.deletedLeftMiddle.EdgeDisjoint
      (Cross.successorRowPathLeftRight r) := by
  classical
  by_cases hleft : r = Cross.rowLeft
  · subst r
    simpa using Cross.deletedLeftMiddle_edgeDisjoint_leftReplacementPath
  · by_cases hright : r = Cross.rowRight
    · subst r
      simpa using Cross.deletedLeftMiddle_edgeDisjoint_rightReplacementPath
    · rw [Cross.successorRowPathLeftRight_of_ne hleft hright]
      rw [GraphPath.EdgeDisjoint, Finset.disjoint_left]
      intro e hedel herow
      have hileft : I.rowIndex r ≠ I.rowIndex Cross.rowLeft := by
        intro hidx
        exact hleft (Cross.rowLeft_index_unique r hidx)
      have hnode :
          (I.rowPath Cross.rowLeft).NodeDisjoint (I.rowPath r) := by
        simpa [I.rowPath_eq_linkage_path r] using
          (Cross.left_row_nodeDisjoint_unchanged (i := I.rowIndex r) hileft)
      have hedge :
          (I.rowPath Cross.rowLeft).EdgeDisjoint (I.rowPath r) :=
        graphPath_edgeDisjoint_of_nodeDisjoint hnode
      exact Finset.disjoint_left.mp hedge
        (Cross.deletedLeftMiddle_edgeSet_subset_row hedel) herow

/-- A deleted right-middle edge is not an edge of any successor row in the
left-to-right cross successor. -/
theorem deletedRightMiddle_edgeDisjoint_successorRowPathLeftRight
    (r : I.Row) :
    Cross.deletedRightMiddle.EdgeDisjoint
      (Cross.successorRowPathLeftRight r) := by
  classical
  by_cases hleft : r = Cross.rowLeft
  · subst r
    simpa using Cross.deletedRightMiddle_edgeDisjoint_leftReplacementPath
  · by_cases hright : r = Cross.rowRight
    · subst r
      simpa using Cross.deletedRightMiddle_edgeDisjoint_rightReplacementPath
    · rw [Cross.successorRowPathLeftRight_of_ne hleft hright]
      rw [GraphPath.EdgeDisjoint, Finset.disjoint_left]
      intro e hedel herow
      have hiright : I.rowIndex r ≠ I.rowIndex Cross.rowRight := by
        intro hidx
        exact hright (Cross.rowRight_index_unique r hidx)
      have hnode :
          (I.rowPath Cross.rowRight).NodeDisjoint (I.rowPath r) := by
        simpa [I.rowPath_eq_linkage_path r] using
          (Cross.right_row_nodeDisjoint_unchanged
            (i := I.rowIndex r) hiright)
      have hedge :
          (I.rowPath Cross.rowRight).EdgeDisjoint (I.rowPath r) :=
        graphPath_edgeDisjoint_of_nodeDisjoint hnode
      exact Finset.disjoint_left.mp hedge
        (Cross.deletedRightMiddle_edgeSet_subset_row hedel) herow

/-- Deleted left-middle edges are absent from the successor row-edge set. -/
theorem deletedLeftMiddle_edge_not_mem_successorRowEdgeSet
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathLeftRight)
    {e : Sym2 V} (he : e ∈ Cross.deletedLeftMiddle.edgeSet) :
    e ∉ (Cross.successorInputLeftRight haux hq0).rowEdgeSet := by
  classical
  intro hrow
  rw [IterationInput.rowEdgeSet] at hrow
  rcases Finset.mem_biUnion.1 hrow with ⟨r, _hr, herow⟩
  exact Finset.disjoint_left.mp
    (Cross.deletedLeftMiddle_edgeDisjoint_successorRowPathLeftRight r)
    he (by simpa [successorInputLeftRight] using herow)

/-- Deleted right-middle edges are absent from the successor row-edge set. -/
theorem deletedRightMiddle_edge_not_mem_successorRowEdgeSet
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathLeftRight)
    {e : Sym2 V} (he : e ∈ Cross.deletedRightMiddle.edgeSet) :
    e ∉ (Cross.successorInputLeftRight haux hq0).rowEdgeSet := by
  classical
  intro hrow
  rw [IterationInput.rowEdgeSet] at hrow
  rcases Finset.mem_biUnion.1 hrow with ⟨r, _hr, herow⟩
  exact Finset.disjoint_left.mp
    (Cross.deletedRightMiddle_edgeDisjoint_successorRowPathLeftRight r)
    he (by simpa [successorInputLeftRight] using herow)

/-- A deleted left-middle edge that is not in the fixed `Q₀` family is absent
from the successor `Htilde`. -/
theorem deletedLeftMiddle_edge_not_mem_successorTilde_of_not_mem_Q0
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathLeftRight)
    {e : Sym2 V} (he : e ∈ Cross.deletedLeftMiddle.edgeSet)
    (hQ0 : e ∉ Q0.edgeSet) :
    e ∉ (Cross.successorInputLeftRight haux hq0).tildeEdgeSet := by
  intro htilde
  rcases Finset.mem_union.1
      (by simpa [IterationInput.tildeEdgeSet] using htilde) with hrow | hq
  · exact Cross.deletedLeftMiddle_edge_not_mem_successorRowEdgeSet
      haux hq0 he hrow
  · exact hQ0 hq

/-- A deleted right-middle edge that is not in the fixed `Q₀` family is absent
from the successor `Htilde`. -/
theorem deletedRightMiddle_edge_not_mem_successorTilde_of_not_mem_Q0
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathLeftRight)
    {e : Sym2 V} (he : e ∈ Cross.deletedRightMiddle.edgeSet)
    (hQ0 : e ∉ Q0.edgeSet) :
    e ∉ (Cross.successorInputLeftRight haux hq0).tildeEdgeSet := by
  intro htilde
  rcases Finset.mem_union.1
      (by simpa [IterationInput.tildeEdgeSet] using htilde) with hrow | hq
  · exact Cross.deletedRightMiddle_edge_not_mem_successorRowEdgeSet
      haux hq0 he hrow
  · exact hQ0 hq

/-- Row family obtained from a cross when the successor order switches the two
replacement rows.  This is the second possibility in Figure 8: the right
switched row is placed before the left switched row in the maintained row
order. -/
noncomputable def successorRowPathRightLeft (r : I.Row) : GraphPath G :=
  if r = Cross.rowLeft then
    Cross.replacementPaths.rightPath
  else if r = Cross.rowRight then
    Cross.replacementPaths.leftPath
  else
    I.rowPath r

@[simp] theorem successorRowPathRightLeft_left :
    Cross.successorRowPathRightLeft Cross.rowLeft =
      Cross.replacementPaths.rightPath := by
  simp [successorRowPathRightLeft]

@[simp] theorem successorRowPathRightLeft_right :
    Cross.successorRowPathRightLeft Cross.rowRight =
      Cross.replacementPaths.leftPath := by
  simp [successorRowPathRightLeft, Cross.rowLeft_ne_rowRight.symm]

@[simp] theorem successorRowPathRightLeft_of_ne
    {r : I.Row} (hleft : r ≠ Cross.rowLeft)
    (hright : r ≠ Cross.rowRight) :
    Cross.successorRowPathRightLeft r = I.rowPath r := by
  simp [successorRowPathRightLeft, hleft, hright]

/-- Switched-order cross successor row-contact invariant from the same two
contact-survival facts, with the replacement rows swapped in the maintained
row order. -/
theorem successorCurrentRowsInvariantRightLeft_of_replacement_hits
    (hleftReplacementHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.leftPath)
    (hrightReplacementHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.rightPath) :
    TypeOneCurrentRowsInvariant R hpos Q0 I.Row
      Cross.successorRowPathRightLeft := by
  classical
  intro i hi
  rcases I.q0_intersection_invariant i hi with
    ⟨hrows, hp0, hpz, havoid⟩
  refine ⟨?_, hp0, hpz, havoid⟩
  intro r
  by_cases hleft : r = Cross.rowLeft
  · subst r
    simpa using hrightReplacementHit i hi
  · by_cases hright : r = Cross.rowRight
    · subst r
      simpa using hleftReplacementHit i hi
    · simpa [Cross.successorRowPathRightLeft_of_ne hleft hright]
        using hrows r

/-- Right-to-left cross successor row-contact traces from the two
replacement-hit obligations. -/
theorem successorBareExtendedRowContactTracesRightLeft_of_replacement_hits
    (order : I.Row ≃ Fin (z h))
    (hleftReplacementHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.leftPath)
    (hrightReplacementHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.rightPath) :
    ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
      Nonempty
        (TypeOneBareExtendedRowContactTrace
          (h := h) I.Row order Cross.successorRowPathRightLeft
          (Q0.data i hi).qstar) :=
  TypeOneBareExtendedRowContactTrace.nonempty_of_currentRowsInvariant
    (order := order)
    (Cross.successorCurrentRowsInvariantRightLeft_of_replacement_hits
      hleftReplacementHit hrightReplacementHit)

/-- The linkage index map for the switched successor order swaps the two
crossed row indices and leaves every other row index unchanged. -/
def successorRowIndexRightLeft (r : I.Row) :
    Cross.replacementLinkageConcrete.Index :=
  if r = Cross.rowLeft then
    I.rowIndex Cross.rowRight
  else if r = Cross.rowRight then
    I.rowIndex Cross.rowLeft
  else
    I.rowIndex r

@[simp] theorem successorRowIndexRightLeft_left :
    Cross.successorRowIndexRightLeft Cross.rowLeft =
      I.rowIndex Cross.rowRight := by
  simp [successorRowIndexRightLeft]

@[simp] theorem successorRowIndexRightLeft_right :
    Cross.successorRowIndexRightLeft Cross.rowRight =
      I.rowIndex Cross.rowLeft := by
  simp [successorRowIndexRightLeft, Cross.rowLeft_ne_rowRight.symm]

@[simp] theorem successorRowIndexRightLeft_of_ne
    {r : I.Row} (hleft : r ≠ Cross.rowLeft)
    (hright : r ≠ Cross.rowRight) :
    Cross.successorRowIndexRightLeft r = I.rowIndex r := by
  simp [successorRowIndexRightLeft, hleft, hright]

theorem successorRowPathRightLeft_eq_linkage_path
    (r : I.Row) :
    Cross.successorRowPathRightLeft r =
      Cross.replacementLinkageConcrete.path
        (Cross.successorRowIndexRightLeft r) := by
  by_cases hleft : r = Cross.rowLeft
  · subst hleft
    simp [successorRowIndexRightLeft]
  · by_cases hright : r = Cross.rowRight
    · subst hright
      simp [successorRowIndexRightLeft, hleft]
    · rw [Cross.successorRowPathRightLeft_of_ne hleft hright]
      rw [Cross.successorRowIndexRightLeft_of_ne hleft hright]
      rw [I.rowPath_eq_linkage_path r]
      exact (Cross.replacementLinkageConcrete_path_of_ne
        (fun hidx => hleft (Cross.rowLeft_index_unique r hidx))
        (fun hidx => hright (Cross.rowRight_index_unique r hidx))).symm

/-- Concrete successor `IterationInput` for the right-to-left cross branch.

The auxiliary-isomorphism and `Q0` contact invariant are supplied by the
nonterminating local analysis; this definition only performs the row-order
bookkeeping. -/
noncomputable def successorInputRightLeft
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathRightLeft) :
    IterationInput R hpos Q0 where
  Row := I.Row
  rowFintype := inferInstance
  rowDecidableEq := inferInstance
  rowPath := Cross.successorRowPathRightLeft
  linkage := Cross.replacementLinkageConcrete
  rowIndex := Cross.successorRowIndexRightLeft
  rowPath_eq_linkage_path :=
    Cross.successorRowPathRightLeft_eq_linkage_path
  linkage_is_block_replacement := I.linkage_is_block_replacement
  aux_iso_fixed_outside := haux
  q0_intersection_invariant := hq0

/-- The switched successor row-index map is the old row-index map composed
with the transposition of the two crossed row labels. -/
theorem successorRowIndexRightLeft_eq_swap
    (r : I.Row) :
    Cross.successorRowIndexRightLeft r =
      I.rowIndex ((Equiv.swap Cross.rowLeft Cross.rowRight) r) := by
  by_cases hleft : r = Cross.rowLeft
  · subst r
    simp [successorRowIndexRightLeft]
  · by_cases hright : r = Cross.rowRight
    · subst r
      simp [successorRowIndexRightLeft, Cross.rowLeft_ne_rowRight.symm]
    · rw [Cross.successorRowIndexRightLeft_of_ne hleft hright]
      rw [Equiv.swap_apply_of_ne_of_ne hleft hright]

/-- The right-to-left cross successor preserves injectivity of row labels by
swapping the two crossed labels before applying the old injective map. -/
theorem successorInputRightLeft_rowIndexInjective
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathRightLeft)
    (hinj : I.RowIndexInjective) :
    (Cross.successorInputRightLeft haux hq0).RowIndexInjective := by
  intro r s hrs
  have hswap :
      (Equiv.swap Cross.rowLeft Cross.rowRight) r =
        (Equiv.swap Cross.rowLeft Cross.rowRight) s := by
    change Cross.successorRowIndexRightLeft r =
      Cross.successorRowIndexRightLeft s at hrs
    rw [Cross.successorRowIndexRightLeft_eq_swap r,
      Cross.successorRowIndexRightLeft_eq_swap s] at hrs
    exact hinj hrs
  exact (Equiv.swap Cross.rowLeft Cross.rowRight).injective hswap

/-- The switched cross successor keeps the same displayed row positions; the
swap is already encoded in `successorRowPathRightLeft` and
`successorRowIndexRightLeft`. -/
noncomputable def successorInputRightLeft_orderedRows
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathRightLeft)
    (O : I.OrderedRows) :
    (Cross.successorInputRightLeft haux hq0).OrderedRows where
  order := O.order

/-- The switched cross successor preserves the explicit iteration invariant
package, once the local nonterminating branch supplies the successor `Q0`
contact invariant. -/
noncomputable def successorInputRightLeft_iterationInvariants
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathRightLeft)
    (Inv : TypeOneIterationInvariants I) :
    TypeOneIterationInvariants
      (Cross.successorInputRightLeft haux hq0) where
  orderedRows :=
    Cross.successorInputRightLeft_orderedRows haux hq0 Inv.orderedRows
  rowIndexInjective :=
    Cross.successorInputRightLeft_rowIndexInjective haux hq0
      Inv.rowIndexInjective
  rowsNodeDisjoint :=
    IterationInput.rowsNodeDisjoint_of_rowIndexInjective
      (Cross.successorInputRightLeft haux hq0)
      (Cross.successorInputRightLeft_rowIndexInjective haux hq0
        Inv.rowIndexInjective)

/-- Swapping the two crossed row labels before applying `I.rowIndex` is the
same as swapping their two linkage indices after applying `I.rowIndex`. -/
theorem successorIndexSwap_apply_rowIndex
    (hinj : I.RowIndexInjective) (r : I.Row) :
    (Equiv.swap (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight))
        (I.rowIndex r) =
      I.rowIndex ((Equiv.swap Cross.rowLeft Cross.rowRight) r) := by
  by_cases hleft : r = Cross.rowLeft
  · subst r
    simp
  · by_cases hright : r = Cross.rowRight
    · subst r
      simp
    · have hidx_left : I.rowIndex r ≠ I.rowIndex Cross.rowLeft := by
        intro h
        exact hleft (hinj h)
      have hidx_right : I.rowIndex r ≠ I.rowIndex Cross.rowRight := by
        intro h
        exact hright (hinj h)
      simp [Equiv.swap_apply_of_ne_of_ne hidx_left hidx_right,
        Equiv.swap_apply_of_ne_of_ne hleft hright]

/-- The local index transposition used in the switched cross branch fixes the
lower boundary index, because the boundary row is not one of the active rows. -/
theorem successorIndexSwap_apply_lowerBoundary
    (Inv : TypeOneExtendedFullIterationInvariants I) :
    (Equiv.swap (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight))
        Inv.boundary.lowerBoundary =
      Inv.boundary.lowerBoundary := by
  rw [Equiv.swap_apply_of_ne_of_ne]
  · exact Inv.boundary.lower_ne_row Cross.rowLeft
  · exact Inv.boundary.lower_ne_row Cross.rowRight

/-- The local index transposition used in the switched cross branch fixes the
upper boundary index. -/
theorem successorIndexSwap_apply_upperBoundary
    (Inv : TypeOneExtendedFullIterationInvariants I) :
    (Equiv.swap (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight))
        Inv.boundary.upperBoundary =
      Inv.boundary.upperBoundary := by
  rw [Equiv.swap_apply_of_ne_of_ne]
  · exact Inv.boundary.upper_ne_row Cross.rowLeft
  · exact Inv.boundary.upper_ne_row Cross.rowRight

/-- The switched-order cross successor preserves the active auxiliary
two-path invariant when the successor auxiliary graph is the old auxiliary
graph with the two crossed row indices swapped.

This is the precise invariant-transport form of the paper's “possibly
switching them” clause. -/
noncomputable def successorInputRightLeft_activeAuxiliaryInvariant_of_swapAdj
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathRightLeft)
    (Inv : TypeOneIterationInvariants I)
    (Haux : TypeOneActiveAuxiliaryInvariant I Inv)
    (hadj_swap :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) i)
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) j)) :
    TypeOneActiveAuxiliaryInvariant
      (Cross.successorInputRightLeft haux hq0)
      (Cross.successorInputRightLeft_iterationInvariants haux hq0 Inv) where
  degree_two := by
    intro r
    let e : I.linkage.Index ≃ I.linkage.Index :=
      Equiv.swap (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
    have hiff :
        ∀ x y : I.linkage.Index,
          (linkageAuxGraph I.linkage).Adj x y ↔
            (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
              (e x) (e y) := by
      intro x y
      have h := hadj_swap (e x) (e y)
      simpa [e] using h.symm
    have hdeg :
        DegreeEquals (linkageAuxGraph Cross.replacementLinkageConcrete)
          (e (I.rowIndex r)) 2 :=
      (degreeEquals_equiv_iff e hiff).1 (Haux.degree_two r)
    have hidx :
        Cross.successorRowIndexRightLeft r = e (I.rowIndex r) := by
      rw [Cross.successorRowIndexRightLeft_eq_swap r]
      exact (Cross.successorIndexSwap_apply_rowIndex
        Inv.rowIndexInjective r).symm
    change DegreeEquals (linkageAuxGraph Cross.replacementLinkageConcrete)
      (Cross.successorRowIndexRightLeft r) 2
    rw [hidx]
    exact hdeg
  consecutive_adj := by
    intro r s hcon
    let e : I.linkage.Index ≃ I.linkage.Index :=
      Equiv.swap (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
    have hr :
        Cross.successorRowIndexRightLeft r = e (I.rowIndex r) := by
      rw [Cross.successorRowIndexRightLeft_eq_swap r]
      exact (Cross.successorIndexSwap_apply_rowIndex
        Inv.rowIndexInjective r).symm
    have hs :
        Cross.successorRowIndexRightLeft s = e (I.rowIndex s) := by
      rw [Cross.successorRowIndexRightLeft_eq_swap s]
      exact (Cross.successorIndexSwap_apply_rowIndex
        Inv.rowIndexInjective s).symm
    have hold : (linkageAuxGraph I.linkage).Adj
        (I.rowIndex r) (I.rowIndex s) :=
      Haux.consecutive_adj hcon
    have hnew :
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
          (e (I.rowIndex r)) (e (I.rowIndex s)) := by
      have h := (hadj_swap (e (I.rowIndex r)) (e (I.rowIndex s))).2
      exact h (by simpa [e] using hold)
    change (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
      (Cross.successorRowIndexRightLeft r)
      (Cross.successorRowIndexRightLeft s)
    rw [hr, hs]
    exact hnew
  no_chord := by
    intro r s hnew
    let e : I.linkage.Index ≃ I.linkage.Index :=
      Equiv.swap (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
    have hr :
        Cross.successorRowIndexRightLeft r = e (I.rowIndex r) := by
      rw [Cross.successorRowIndexRightLeft_eq_swap r]
      exact (Cross.successorIndexSwap_apply_rowIndex
        Inv.rowIndexInjective r).symm
    have hs :
        Cross.successorRowIndexRightLeft s = e (I.rowIndex s) := by
      rw [Cross.successorRowIndexRightLeft_eq_swap s]
      exact (Cross.successorIndexSwap_apply_rowIndex
        Inv.rowIndexInjective s).symm
    have hnew' :
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
          (e (I.rowIndex r)) (e (I.rowIndex s)) := by
      change (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
        (Cross.successorRowIndexRightLeft r)
        (Cross.successorRowIndexRightLeft s) at hnew
      rwa [hr, hs] at hnew
    have hold : (linkageAuxGraph I.linkage).Adj
        (I.rowIndex r) (I.rowIndex s) := by
      have h := (hadj_swap (e (I.rowIndex r)) (e (I.rowIndex s))).1 hnew'
      simpa [e] using h
    exact Haux.no_chord hold

/-- The switched-order cross successor preserves the boundary rows when the
successor auxiliary graph is the old auxiliary graph with the two crossed row
indices transposed. -/
noncomputable def successorInputRightLeft_boundaryAuxiliaryInvariant_of_swapAdj
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathRightLeft)
    (Inv : TypeOneExtendedFullIterationInvariants I)
    (hadj_swap :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) i)
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) j)) :
    TypeOneBoundaryAuxiliaryInvariant
      (Cross.successorInputRightLeft haux hq0)
      (Cross.successorInputRightLeft_iterationInvariants haux hq0
        Inv.full.base) where
  lowerBoundary := Inv.boundary.lowerBoundary
  upperBoundary := Inv.boundary.upperBoundary
  lower_path_eq := by
    change Cross.replacementLinkageConcrete.path Inv.boundary.lowerBoundary =
      L.path R.p0Index
    rw [Cross.replacementLinkageConcrete_path_of_ne
      (Inv.boundary.lower_ne_row Cross.rowLeft)
      (Inv.boundary.lower_ne_row Cross.rowRight)]
    exact Inv.boundary.lower_path_eq
  upper_path_eq := by
    change Cross.replacementLinkageConcrete.path Inv.boundary.upperBoundary =
      L.path (R.pZPlusOneIndex hpos)
    rw [Cross.replacementLinkageConcrete_path_of_ne
      (Inv.boundary.upper_ne_row Cross.rowLeft)
      (Inv.boundary.upper_ne_row Cross.rowRight)]
    exact Inv.boundary.upper_path_eq
  lower_ne_row := by
    intro r h
    let e : I.linkage.Index ≃ I.linkage.Index :=
      Equiv.swap (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
    have hsucc :
        Cross.successorRowIndexRightLeft r = e (I.rowIndex r) := by
      rw [Cross.successorRowIndexRightLeft_eq_swap r]
      exact (Cross.successorIndexSwap_apply_rowIndex
        Inv.full.base.rowIndexInjective r).symm
    have hfix :
        e Inv.boundary.lowerBoundary = Inv.boundary.lowerBoundary := by
      simpa [e] using Cross.successorIndexSwap_apply_lowerBoundary Inv
    have hcontra : Inv.boundary.lowerBoundary = I.rowIndex r := by
      calc
        Inv.boundary.lowerBoundary = e Inv.boundary.lowerBoundary := by
          exact hfix.symm
        _ = e (Cross.successorRowIndexRightLeft r) := by
          rw [h]
          rfl
        _ = e (e (I.rowIndex r)) := by rw [hsucc]
        _ = I.rowIndex r := by simp [e]
    exact Inv.boundary.lower_ne_row r hcontra
  upper_ne_row := by
    intro r h
    let e : I.linkage.Index ≃ I.linkage.Index :=
      Equiv.swap (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
    have hsucc :
        Cross.successorRowIndexRightLeft r = e (I.rowIndex r) := by
      rw [Cross.successorRowIndexRightLeft_eq_swap r]
      exact (Cross.successorIndexSwap_apply_rowIndex
        Inv.full.base.rowIndexInjective r).symm
    have hfix :
        e Inv.boundary.upperBoundary = Inv.boundary.upperBoundary := by
      simpa [e] using Cross.successorIndexSwap_apply_upperBoundary Inv
    have hcontra : Inv.boundary.upperBoundary = I.rowIndex r := by
      calc
        Inv.boundary.upperBoundary = e Inv.boundary.upperBoundary := by
          exact hfix.symm
        _ = e (Cross.successorRowIndexRightLeft r) := by
          rw [h]
          rfl
        _ = e (e (I.rowIndex r)) := by rw [hsucc]
        _ = I.rowIndex r := by simp [e]
    exact Inv.boundary.upper_ne_row r hcontra
  lower_degree_two := by
    let e : I.linkage.Index ≃ I.linkage.Index :=
      Equiv.swap (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
    have hiff :
        ∀ x y : I.linkage.Index,
          (linkageAuxGraph I.linkage).Adj x y ↔
            (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
              (e x) (e y) := by
      intro x y
      have h := hadj_swap (e x) (e y)
      simpa [e] using h.symm
    have hdeg :
        DegreeEquals (linkageAuxGraph Cross.replacementLinkageConcrete)
          (e Inv.boundary.lowerBoundary) 2 :=
      (degreeEquals_equiv_iff e hiff).1 Inv.boundary.lower_degree_two
    have hfix :
        e Inv.boundary.lowerBoundary = Inv.boundary.lowerBoundary := by
      simpa [e] using Cross.successorIndexSwap_apply_lowerBoundary Inv
    simpa [hfix] using hdeg
  upper_degree_two := by
    let e : I.linkage.Index ≃ I.linkage.Index :=
      Equiv.swap (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
    have hiff :
        ∀ x y : I.linkage.Index,
          (linkageAuxGraph I.linkage).Adj x y ↔
            (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
              (e x) (e y) := by
      intro x y
      have h := hadj_swap (e x) (e y)
      simpa [e] using h.symm
    have hdeg :
        DegreeEquals (linkageAuxGraph Cross.replacementLinkageConcrete)
          (e Inv.boundary.upperBoundary) 2 :=
      (degreeEquals_equiv_iff e hiff).1 Inv.boundary.upper_degree_two
    have hfix :
        e Inv.boundary.upperBoundary = Inv.boundary.upperBoundary := by
      simpa [e] using Cross.successorIndexSwap_apply_upperBoundary Inv
    simpa [hfix] using hdeg
  lower_adj_first := by
    let e : I.linkage.Index ≃ I.linkage.Index :=
      Equiv.swap (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
    let r0 : I.Row :=
      (Cross.successorInputRightLeft_iterationInvariants haux hq0
        Inv.full.base).orderedRows.order.symm
          (⟨0, by dsimp [z]; omega⟩ : Fin (z h))
    have hsucc :
        Cross.successorRowIndexRightLeft r0 = e (I.rowIndex r0) := by
      rw [Cross.successorRowIndexRightLeft_eq_swap r0]
      exact (Cross.successorIndexSwap_apply_rowIndex
        Inv.full.base.rowIndexInjective r0).symm
    have hfix :
        e Inv.boundary.lowerBoundary = Inv.boundary.lowerBoundary := by
      simpa [e] using Cross.successorIndexSwap_apply_lowerBoundary Inv
    change (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
      Inv.boundary.lowerBoundary (Cross.successorRowIndexRightLeft r0)
    rw [hsucc]
    refine (hadj_swap Inv.boundary.lowerBoundary (e (I.rowIndex r0))).2 ?_
    simpa [e, hfix] using Inv.boundary.lower_adj_first
  last_adj_upper := by
    let e : I.linkage.Index ≃ I.linkage.Index :=
      Equiv.swap (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
    let rlast : I.Row :=
      (Cross.successorInputRightLeft_iterationInvariants haux hq0
        Inv.full.base).orderedRows.order.symm
          (⟨z h - 1, by dsimp [z]; omega⟩ : Fin (z h))
    have hsucc :
        Cross.successorRowIndexRightLeft rlast = e (I.rowIndex rlast) := by
      rw [Cross.successorRowIndexRightLeft_eq_swap rlast]
      exact (Cross.successorIndexSwap_apply_rowIndex
        Inv.full.base.rowIndexInjective rlast).symm
    have hfix :
        e Inv.boundary.upperBoundary = Inv.boundary.upperBoundary := by
      simpa [e] using Cross.successorIndexSwap_apply_upperBoundary Inv
    change (linkageAuxGraph Cross.replacementLinkageConcrete).Adj
      (Cross.successorRowIndexRightLeft rlast) Inv.boundary.upperBoundary
    rw [hsucc]
    refine (hadj_swap (e (I.rowIndex rlast)) Inv.boundary.upperBoundary).2 ?_
    simpa [e, hfix] using Inv.boundary.last_adj_upper
  lowerOutside := Inv.boundary.lowerOutside
  upperOutside := Inv.boundary.upperOutside
  lower_adj_outside := by
    let e : I.linkage.Index ≃ I.linkage.Index :=
      Equiv.swap (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
    have hfixLower :
        e Inv.boundary.lowerBoundary = Inv.boundary.lowerBoundary := by
      simpa [e] using Cross.successorIndexSwap_apply_lowerBoundary Inv
    have hfixOutside :
        e Inv.boundary.lowerOutside = Inv.boundary.lowerOutside := by
      exact Equiv.swap_apply_of_ne_of_ne
        (Inv.boundary.lowerOutside_ne_row Cross.rowLeft)
        (Inv.boundary.lowerOutside_ne_row Cross.rowRight)
    refine (hadj_swap Inv.boundary.lowerBoundary
      Inv.boundary.lowerOutside).2 ?_
    simpa [e, hfixLower, hfixOutside] using
      Inv.boundary.lower_adj_outside
  upper_adj_outside := by
    let e : I.linkage.Index ≃ I.linkage.Index :=
      Equiv.swap (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
    have hfixUpper :
        e Inv.boundary.upperBoundary = Inv.boundary.upperBoundary := by
      simpa [e] using Cross.successorIndexSwap_apply_upperBoundary Inv
    have hfixOutside :
        e Inv.boundary.upperOutside = Inv.boundary.upperOutside := by
      exact Equiv.swap_apply_of_ne_of_ne
        (Inv.boundary.upperOutside_ne_row Cross.rowLeft)
        (Inv.boundary.upperOutside_ne_row Cross.rowRight)
    refine (hadj_swap Inv.boundary.upperBoundary
      Inv.boundary.upperOutside).2 ?_
    simpa [e, hfixUpper, hfixOutside] using
      Inv.boundary.upper_adj_outside
  lowerOutside_ne_row := by
    intro r h
    let e : I.linkage.Index ≃ I.linkage.Index :=
      Equiv.swap (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
    have hsucc :
        Cross.successorRowIndexRightLeft r = e (I.rowIndex r) := by
      rw [Cross.successorRowIndexRightLeft_eq_swap r]
      exact (Cross.successorIndexSwap_apply_rowIndex
        Inv.full.base.rowIndexInjective r).symm
    have hfix :
        e Inv.boundary.lowerOutside = Inv.boundary.lowerOutside := by
      exact Equiv.swap_apply_of_ne_of_ne
        (Inv.boundary.lowerOutside_ne_row Cross.rowLeft)
        (Inv.boundary.lowerOutside_ne_row Cross.rowRight)
    have hcontra : Inv.boundary.lowerOutside = I.rowIndex r := by
      calc
        Inv.boundary.lowerOutside = e Inv.boundary.lowerOutside := hfix.symm
        _ = e ((Cross.successorInputRightLeft haux hq0).rowIndex r) := by
          rw [h]
        _ = e (Cross.successorRowIndexRightLeft r) := rfl
        _ = e (e (I.rowIndex r)) := by rw [hsucc]
        _ = I.rowIndex r := by simp [e]
    exact Inv.boundary.lowerOutside_ne_row r hcontra
  upperOutside_ne_row := by
    intro r h
    let e : I.linkage.Index ≃ I.linkage.Index :=
      Equiv.swap (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight)
    have hsucc :
        Cross.successorRowIndexRightLeft r = e (I.rowIndex r) := by
      rw [Cross.successorRowIndexRightLeft_eq_swap r]
      exact (Cross.successorIndexSwap_apply_rowIndex
        Inv.full.base.rowIndexInjective r).symm
    have hfix :
        e Inv.boundary.upperOutside = Inv.boundary.upperOutside := by
      exact Equiv.swap_apply_of_ne_of_ne
        (Inv.boundary.upperOutside_ne_row Cross.rowLeft)
        (Inv.boundary.upperOutside_ne_row Cross.rowRight)
    have hcontra : Inv.boundary.upperOutside = I.rowIndex r := by
      calc
        Inv.boundary.upperOutside = e Inv.boundary.upperOutside := hfix.symm
        _ = e ((Cross.successorInputRightLeft haux hq0).rowIndex r) := by
          rw [h]
        _ = e (Cross.successorRowIndexRightLeft r) := rfl
        _ = e (e (I.rowIndex r)) := by rw [hsucc]
        _ = I.rowIndex r := by simp [e]
    exact Inv.boundary.upperOutside_ne_row r hcontra
  lowerOutside_ne_lower := Inv.boundary.lowerOutside_ne_lower
  lowerOutside_ne_upper := Inv.boundary.lowerOutside_ne_upper
  upperOutside_ne_lower := Inv.boundary.upperOutside_ne_lower
  upperOutside_ne_upper := Inv.boundary.upperOutside_ne_upper

/-- The switched-order cross successor also does not add edges to the
maintained graph `H̃`. -/
theorem successorInputRightLeft_tilde_subset
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathRightLeft) :
    (Cross.successorInputRightLeft haux hq0).tildeEdgeSet ⊆
      I.tildeEdgeSet := by
  classical
  intro e he
  rcases Finset.mem_union.1 (by
      simpa [successorInputRightLeft, IterationInput.tildeEdgeSet] using he)
    with hrow | hQ0
  · have hrow' :
        e ∈ Finset.univ.biUnion
          (fun r : I.Row => (Cross.successorRowPathRightLeft r).edgeSet) := by
      simpa [IterationInput.rowEdgeSet, successorInputRightLeft] using hrow
    rcases Finset.mem_biUnion.mp hrow' with ⟨r, _hr, her⟩
    by_cases hleft : r = Cross.rowLeft
    · subst hleft
      have hraw :=
        Cross.replacementPaths_right_edgeSet_subset_rows_union_Q0
          (by simpa using her)
      rcases Finset.mem_union.1 hraw with hrows | hq
      · rcases Finset.mem_union.1 hrows with hleftEdge | hrightEdge
        · have heRows : e ∈ I.rowEdgeSet :=
            Finset.mem_biUnion.mpr
              ⟨Cross.rowLeft, Finset.mem_univ _, hleftEdge⟩
          exact Finset.mem_union.2 (Or.inl heRows)
        · have heRows : e ∈ I.rowEdgeSet :=
            Finset.mem_biUnion.mpr
              ⟨Cross.rowRight, Finset.mem_univ _, hrightEdge⟩
          exact Finset.mem_union.2 (Or.inl heRows)
      · exact Finset.mem_union.2 (Or.inr hq)
    · by_cases hright : r = Cross.rowRight
      · subst hright
        have hraw :=
          Cross.replacementPaths_left_edgeSet_subset_rows_union_Q0
            (by simpa using her)
        rcases Finset.mem_union.1 hraw with hrows | hq
        · rcases Finset.mem_union.1 hrows with hleftEdge | hrightEdge
          · have heRows : e ∈ I.rowEdgeSet :=
              Finset.mem_biUnion.mpr
                ⟨Cross.rowLeft, Finset.mem_univ _, hleftEdge⟩
            exact Finset.mem_union.2 (Or.inl heRows)
          · have heRows : e ∈ I.rowEdgeSet :=
              Finset.mem_biUnion.mpr
                ⟨Cross.rowRight, Finset.mem_univ _, hrightEdge⟩
            exact Finset.mem_union.2 (Or.inl heRows)
        · exact Finset.mem_union.2 (Or.inr hq)
      · have herOld : e ∈ (I.rowPath r).edgeSet := by
          simpa [Cross.successorRowPathRightLeft_of_ne hleft hright] using her
        have heRows : e ∈ I.rowEdgeSet :=
          Finset.mem_biUnion.mpr ⟨r, Finset.mem_univ _, herOld⟩
        exact Finset.mem_union.2 (Or.inl heRows)
  · exact Finset.mem_union.2 (Or.inr hQ0)

/-- The explicit linkage-support invariant also survives the switched-order
cross successor.  The successor row order swaps the two replacement rows, but
the current linkage support argument is unchanged: the two replacement paths
are successor rows and all other linkage paths keep their old support. -/
theorem successorInputRightLeft_typeOneLinkageSupportInvariant
    (haux : AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hq0 :
      TypeOneCurrentRowsInvariant R hpos Q0 I.Row
        Cross.successorRowPathRightLeft)
    (hsupport : IterationInput.TypeOneLinkageSupportInvariant I) :
    IterationInput.TypeOneLinkageSupportInvariant
      (Cross.successorInputRightLeft haux hq0) := by
  classical
  intro v hv
  rcases ((Cross.successorInputRightLeft haux hq0).linkage.toPathPacking.mem_vertexSet).1
      hv with ⟨i, hvi⟩
  by_cases hileft : i = I.rowIndex Cross.rowLeft
  · subst i
    exact Finset.mem_union.2 (Or.inl (by
      rw [IterationInput.rowVertexSet]
      exact Finset.mem_biUnion.mpr
        ⟨Cross.rowRight, Finset.mem_univ Cross.rowRight, by
          simpa [successorInputRightLeft] using hvi⟩))
  · by_cases hiright : i = I.rowIndex Cross.rowRight
    · subst i
      exact Finset.mem_union.2 (Or.inl (by
        rw [IterationInput.rowVertexSet]
        exact Finset.mem_biUnion.mpr
          ⟨Cross.rowLeft, Finset.mem_univ Cross.rowLeft, by
            simpa [successorInputRightLeft] using hvi⟩))
    · have hv_old_path : v ∈ (I.linkage.path i).vertexSet := by
        change v ∈ (Cross.replacementLinkageConcrete.path i).vertexSet at hvi
        rwa [Cross.replacementLinkageConcrete_path_of_ne hileft hiright] at hvi
      have hv_old_link : v ∈ I.linkage.toPathPacking.vertexSet :=
        (I.linkage.toPathPacking.mem_vertexSet).2 ⟨i, hv_old_path⟩
      have hraw := hsupport hv_old_link
      rcases Finset.mem_union.1 hraw with hrow | hrest
      · rw [IterationInput.rowVertexSet] at hrow
        rcases Finset.mem_biUnion.1 hrow with ⟨r, _hr, hvr⟩
        have hr_ne_left : r ≠ Cross.rowLeft := by
          intro hr
          subst r
          have hvleft :
              v ∈ (I.linkage.path (I.rowIndex Cross.rowLeft)).vertexSet := by
            simpa [I.rowPath_eq_linkage_path Cross.rowLeft] using hvr
          exact Finset.disjoint_left.mp
            (I.linkage.toPathPacking.node_disjoint hileft) hv_old_path hvleft
        have hr_ne_right : r ≠ Cross.rowRight := by
          intro hr
          subst r
          have hvright :
              v ∈ (I.linkage.path (I.rowIndex Cross.rowRight)).vertexSet := by
            simpa [I.rowPath_eq_linkage_path Cross.rowRight] using hvr
          exact Finset.disjoint_left.mp
            (I.linkage.toPathPacking.node_disjoint hiright) hv_old_path hvright
        exact Finset.mem_union.2 (Or.inl (by
          rw [IterationInput.rowVertexSet]
          exact Finset.mem_biUnion.mpr ⟨r, Finset.mem_univ r, by
            simpa [successorInputRightLeft,
              Cross.successorRowPathRightLeft_of_ne hr_ne_left hr_ne_right]
              using hvr⟩))
      · exact Finset.mem_union.2 (Or.inr hrest)

/-- A deleted left-middle edge is not an edge of any successor row in the
right-to-left cross successor. -/
theorem deletedLeftMiddle_edgeDisjoint_successorRowPathRightLeft
    (r : I.Row) :
    Cross.deletedLeftMiddle.EdgeDisjoint
      (Cross.successorRowPathRightLeft r) := by
  classical
  by_cases hleft : r = Cross.rowLeft
  · subst r
    simpa using Cross.deletedLeftMiddle_edgeDisjoint_rightReplacementPath
  · by_cases hright : r = Cross.rowRight
    · subst r
      simpa using Cross.deletedLeftMiddle_edgeDisjoint_leftReplacementPath
    · rw [Cross.successorRowPathRightLeft_of_ne hleft hright]
      rw [GraphPath.EdgeDisjoint, Finset.disjoint_left]
      intro e hedel herow
      have hileft : I.rowIndex r ≠ I.rowIndex Cross.rowLeft := by
        intro hidx
        exact hleft (Cross.rowLeft_index_unique r hidx)
      have hnode :
          (I.rowPath Cross.rowLeft).NodeDisjoint (I.rowPath r) := by
        simpa [I.rowPath_eq_linkage_path r] using
          (Cross.left_row_nodeDisjoint_unchanged (i := I.rowIndex r) hileft)
      have hedge :
          (I.rowPath Cross.rowLeft).EdgeDisjoint (I.rowPath r) :=
        graphPath_edgeDisjoint_of_nodeDisjoint hnode
      exact Finset.disjoint_left.mp hedge
        (Cross.deletedLeftMiddle_edgeSet_subset_row hedel) herow

