  have hn_mem_pTwoZ :
      T.contact rn ∈ (L.path (R.pTwoZIndex hpos)).vertexSet := by
    simpa [rn, hidx] using T.contact_mem_linkage rn
  have hn_mid :
      T.contact rn ∈ middleBoundaryVertexSet (L := L) R hpos :=
