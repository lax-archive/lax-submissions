    exact ⟨D.toBlockerSegmentData⟩

end ClaimB3BlockerBlockInsideIntervalTerminalProofData

namespace ClaimB3EndpointBracketTerminalProofData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}
variable {inv : TypeOneIterationInvariants I}

/-- The endpoint/bracket terminal package directly supplies the
compressed-trace endpoint package used in the finite Claim B.3 ascent.

This is the Lean form of the paper's blocker paragraph.  A blocked hill
candidate gives a maximal blocker block inside its row interval; the two
boundary alternatives in which the blocker enters from the lower row are
ruled out by the already-proved Claim B.2 strip barrier, so the compressed
trace has upper neighbors on both sides and hence yields the next higher
hill. -/
noncomputable def toTraceCompressionTerminalEndpointProofData
    (C : ClaimB3EndpointBracketTerminalProofData I inv) :
    ClaimB3TraceCompressionTerminalEndpointProofData I inv where
  terminal_noBumpNoCross := C.terminal_noBumpNoCross
  terminal_aux_noChord := C.terminal_aux_noChord
  no_hill := C.no_hill
  trace_compression :=
    C.atomized_trace.toTraceCompressionExtractionCertificate
  higher_hill_data_of_blocker := by
    intro H j' hj' hblock
    let S : ClaimB2PlanarStripCertificate I inv :=
      claimB2_planarStripCertificate_of_noBumpNoCross
        C.terminal_aux_noChord C.terminal_noBumpNoCross
    rcases C.hill_bracket H with ⟨Bkt⟩
    rcases C.atomized_trace.blockerBlockInsideIntervalData_of_blocker
        S Bkt j' hj' (C.trace_last_zero j') hblock with ⟨D⟩
    have hprev_lt :
        D.block.1 - 1 < (C.atomized_trace.blocks j').len + 1 :=
      lt_of_le_of_lt (Nat.sub_le _ _) D.block.2
    have hnext_lt :
        D.block.1 + 1 < (C.atomized_trace.blocks j').len + 1 :=
      Nat.succ_lt_succ D.block_lt
    have hprev_not :
        ((C.atomized_trace.blocks j').blockRow
            ⟨D.block.1 - 1, hprev_lt⟩).1 + 1 ≠ H.row.1 := by
      intro hprev
      rcases C.atomized_trace.lowerNeighborAtomData_of_prevBoundary
          j' D.bracket hj' D.block_pos D.block_row hprev
          (by simpa using D.first_mem) with ⟨N⟩
      exact N.impossible S hj'
    have hnext_not :
        ((C.atomized_trace.blocks j').blockRow
            ⟨D.block.1 + 1, hnext_lt⟩).1 + 1 ≠ H.row.1 := by
      intro hnext
      rcases C.atomized_trace.lowerNeighborAtomData_of_nextBoundary
          j' D.bracket hj' D.block_lt D.block_row hnext
          (by simpa using D.last_mem) with ⟨N⟩
      exact N.impossible S hj'
    exact (C.atomized_trace.blocks j').higherHillFromBlockerData_of_block_without_lower_neighbors
      D.block_row D.block_pos D.block_lt
      (by simpa using hprev_not) (by simpa using hnext_not)

/-- Choose the maximal blocker block from the atomized trace and package it in
the inside-interval form consumed by the Claim B.3 barrier chain. -/
def toBlockerBlockInsideIntervalTerminalProofData
    (C : ClaimB3EndpointBracketTerminalProofData I inv) :
    ClaimB3BlockerBlockInsideIntervalTerminalProofData I inv where
  terminal_noBumpNoCross := C.terminal_noBumpNoCross
  terminal_aux_noChord := C.terminal_aux_noChord
  no_hill := C.no_hill
  atomized_trace := C.atomized_trace
  blocker_block_inside_interval := by
    intro H j' hj' hblock
    let S : ClaimB2PlanarStripCertificate I inv :=
      claimB2_planarStripCertificate_of_noBumpNoCross
        C.terminal_aux_noChord C.terminal_noBumpNoCross
    rcases C.hill_bracket H with ⟨Bkt⟩
    exact C.atomized_trace.blockerBlockInsideIntervalData_of_blocker
      S Bkt j' hj' (C.trace_last_zero j') hblock

end ClaimB3EndpointBracketTerminalProofData

