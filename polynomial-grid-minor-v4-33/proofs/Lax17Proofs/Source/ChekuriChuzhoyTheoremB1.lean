/-- The extra finite-graph datum needed by the Figure 7 local-dichotomy proof:
the left endpoint of the bump triple has a second old neighbor outside the
local triple.

This is the degree-saturation fact used to rule out the local skip edge in the
nonterminating branch.  It is kept as a small certificate so the page-60 proof
data can depend on the paper's real local graph fact rather than on a bundled
auxiliary-graph isomorphism. -/
structure TypeOneBumpLeftOutsideNeighborData
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0}
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Bump : BumpWitness I) where
  auxL : I.linkage.Index
  left_adj_auxL :
    (let D :=
      TypeOneExtendedFutureCleanIterationInvariants.bumpLocalTripleData
        (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
        Inv Bump
     (linkageAuxGraph I.linkage).Adj D.left auxL)
  auxL_ne_left :
    (let D :=
      TypeOneExtendedFutureCleanIterationInvariants.bumpLocalTripleData
        (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
        Inv Bump
     auxL ≠ D.left)
  auxL_ne_mid : auxL ≠ I.rowIndex Bump.row
  auxL_ne_right :
    (let D :=
      TypeOneExtendedFutureCleanIterationInvariants.bumpLocalTripleData
        (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
        Inv Bump
     auxL ≠ D.right)

namespace TypeOneBumpLeftOutsideNeighborData

variable {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
variable {Q : PerfectPathPacking G R.X R.Y}
variable {Q0 : TypeOneQStarFamily R hpos Q}
variable {I : IterationInput R hpos Q0}

/-- Construct the Figure 7 left-outside-neighbor certificate from the
maintained extended degree-two path.

The proof is a case split on the position of the bumped row.  If the bump is
at the first active row, the left endpoint of the local triple is the fixed
lower boundary row and its second neighbor is the stored lower outside
neighbor.  Otherwise the left endpoint is the preceding active row; its second
neighbor is either the lower boundary row, when that preceding active row is
first, or the previous active row in the maintained order. -/
noncomputable def ofInvariant
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (Bump : BumpWitness I) :
    TypeOneBumpLeftOutsideNeighborData Inv Bump := by
  classical
  let order := Inv.base.orderedRows.order
  let p : Fin (z h) := order Bump.row
  let H := linkageAuxGraph I.linkage
  by_cases hfirst : p.1 = 0
  · by_cases hlast : p.1 + 1 = z h
    · have hztwo : 2 ≤ z h := by
        dsimp [z]
        omega
      omega
    · let nextFin : Fin (z h) := ⟨p.1 + 1, by omega⟩
      let nextRow : I.Row := order.symm nextFin
      have hnot_one : ¬ 1 = z h := by
        intro hz
        exact hlast (by
          rw [hfirst]
          omega)
      refine
        { auxL := Inv.extended.boundary.lowerOutside
          left_adj_auxL := ?_
          auxL_ne_left := ?_
          auxL_ne_mid := Inv.extended.boundary.lowerOutside_ne_row Bump.row
          auxL_ne_right := ?_ }
      · simpa [TypeOneExtendedFutureCleanIterationInvariants.bumpLocalTripleData,
          order, p, hfirst, hlast, hnot_one, nextFin, nextRow] using
          Inv.extended.boundary.lower_adj_outside
      · simpa [TypeOneExtendedFutureCleanIterationInvariants.bumpLocalTripleData,
          order, p, hfirst, hlast, hnot_one, nextFin, nextRow] using
          Inv.extended.boundary.lowerOutside_ne_lower
      · simpa [TypeOneExtendedFutureCleanIterationInvariants.bumpLocalTripleData,
          order, p, hfirst, hlast, hnot_one, nextFin, nextRow] using
          Inv.extended.boundary.lowerOutside_ne_row nextRow
  · let prevFin : Fin (z h) := ⟨p.1 - 1, by omega⟩
    let prevRow : I.Row := order.symm prevFin
    have hprev_order : order prevRow = prevFin := by
      simp [prevRow]
