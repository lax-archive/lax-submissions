  · exact Or.inl hdrop
  · rcases hsucc with ⟨S⟩
    exact Or.inr ⟨S.next, ⟨hsuccInv S⟩, S.tilde_card_lt⟩

/-- Upgrade a cross action certificate to the full-invariant-preserving action
outcome once each successor certificate is known to preserve both the row
bookkeeping and the active auxiliary two-path invariant. -/
theorem CrossActionCertificate.fullInvariantSimplifyingActionOutcome
