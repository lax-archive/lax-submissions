        linkageAuxDegreeTwoCount L' < linkageAuxDegreeTwoCount L := by
  have hpos : 0 < h := by omega
  exact reroutingConclusion_of_page60_typeOne_paper_updates_sparse_terminal_autoInitial
    (L := L) (h := h) hbad hlink hpos
    (fun {R} {Q} S {I} Inv Bump =>
      let T :=
        TypeOneExtendedFutureCleanIterationInvariants.bumpLocalTripleData
          (R := R) (hpos := hpos) (Q := Q) (Q0 := S.Q0) (I := I)
          Inv Bump
      let N :=
        TypeOneBumpLeftOutsideNeighborData.ofInvariant
          (R := R) (hpos := hpos) (Q := Q) (Q0 := S.Q0) (I := I)
          Inv Bump
      have hsupport :
          AdjChangeSupportedIn (linkageAuxGraph I.linkage)
            (linkageAuxGraph Bump.replacementLinkageConcrete)
            ({T.left, I.rowIndex Bump.row, T.right} :
                Finset I.linkage.Index) := by
        simpa [T] using
          Bump.bump_adjChangeSupportedIn T.left T.right
            T.left_adj_mid T.mid_adj_right T.mid_degree_two T.left_ne_right
      Bump.paperActionUpdate_of_supportedLocalDichotomy_constructedSuccessor_fromLocalData_traces_autoAdj
        Inv
        ((D hpos).hbump_trace S Inv Bump)
        N.auxL T.left T.right hsupport
        N.left_adj_auxL T.left_adj_mid T.mid_adj_right
        T.left_degree_two T.mid_degree_two T.right_degree_two
        N.auxL_ne_left N.auxL_ne_mid N.auxL_ne_right
        T.left_ne_mid T.left_ne_right T.mid_ne_right)
    (fun {R} {Q} S {I} Inv Cross =>
      Cross.paperActionUpdate_of_localOutsideData_traces
        Inv
        (CrossWitness.CrossLocalOutsideData.ofInvariant
          (R := R) (hpos := hpos) (Q := Q) (Q0 := S.Q0) (I := I)
          Inv Cross)
        ((D hpos).hcross_leftRight_trace S Inv Cross)
        ((D hpos).hcross_rightLeft_trace S Inv Cross))
    (fun {R} {Q} S I Inv hterm =>
      ((D hpos).hterminal (R := R) (Q := Q) S I Inv hterm).toTerminalSparseGridTraceCertificate)
    (fun {R} {Q} T =>
      (D hpos).hTypeTwo (R := R) (Q := Q) T)

