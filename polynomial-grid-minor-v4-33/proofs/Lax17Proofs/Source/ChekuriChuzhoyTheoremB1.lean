    ClaimB3FutureCleanTerminalEndpointProofData I Inv.base where
  terminal_noBumpNoCross := hterm
  terminal_aux_noChord :=
    Inv.extended.full.active_aux.terminalRowsAuxNoChord
  no_hill := D.no_hill
  future_segments_clean := Inv.future_segments_clean
  trace_first_max := by
    simpa using D.trace_first_max hterm
  higher_hill_data_of_blocker := D.higher_hill_data_of_blocker

/-- Claim B.3 follows from the future-clean terminal package. -/
theorem claimB3ConnectedIntersections
    (D : TerminalSparseGridFutureCleanProofData (hpos := hpos) I Inv)
    (hterm : NoBumpNoCross I) :
    ClaimB3ConnectedIntersections I Inv.base :=
  claimB3_connectedIntersections_of_futureCleanTerminalEndpointProofData
    (D.toClaimB3FutureCleanTerminalEndpointProofData hterm)

/-- Forget the terminal proof internals down to the sparse-grid trace
certificate consumed by the minor construction. -/
noncomputable def toTerminalSparseGridTraceCertificate
    (D : TerminalSparseGridFutureCleanProofData (hpos := hpos) I Inv) :
    TerminalSparseGridTraceCertificate I :=
  D.assembly.toTerminalSparseGridTraceCertificate

/-- The future-clean terminal package contains the desired grid minor once the
bump/cross loop has reached a terminal no-bump/no-cross state. -/
theorem containsGridMinor
    (D : TerminalSparseGridFutureCleanProofData (hpos := hpos) I Inv)
    (_hterm : NoBumpNoCross I) :
    ContainsGridMinor G h :=
  D.toTerminalSparseGridTraceCertificate.containsGridMinor

end TerminalSparseGridFutureCleanProofData

/-- If the local action certificates are available for every bump and cross,
then the finite rerouting loop reaches either the no-bump/no-cross terminal
state or a degree-drop state. -/
theorem exists_noBumpNoCross_or_degree_drop_of_action_certificates
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (hbump :
      ∀ {I : IterationInput R hpos Q0} (B : BumpWitness I),
        BumpActionCertificate B)
    (hcross :
      ∀ {I : IterationInput R hpos Q0} (C : CrossWitness I),
        CrossActionCertificate C)
    (I₀ : IterationInput R hpos Q0) :
    ∃ I : IterationInput R hpos Q0,
      NoBumpNoCross I ∨
        ∃ L'' : PerfectPathPacking G A B,
          linkageAuxDegreeTwoCount L'' <
            linkageAuxDegreeTwoCount I.linkage := by
  classical
  refine
    exists_terminal_or_degree_drop_of_simplifying_actions
      (Terminal := NoBumpNoCross)
      ?_ I₀
  intro I hnot_terminal
  by_cases hb : HasBump I
  · rcases hb with ⟨B⟩
    exact (hbump B).simplifyingActionOutcome
  · by_cases hc : HasCross I
    · rcases hc with ⟨C⟩
      exact (hcross C).simplifyingActionOutcome
    · exact False.elim (hnot_terminal ⟨hb, hc⟩)

/-- Invariant-aware no-bump/no-cross loop.  This is the same finite descent as
`exists_noBumpNoCross_or_degree_drop_of_action_certificates`, but the
successor branch is required to preserve the explicit row invariant package
needed by Claim B.3 and the terminal grid-model construction. -/
theorem exists_noBumpNoCross_or_degree_drop_of_invariant_actions
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    (hstep :
      ∀ I : IterationInput R hpos Q0,
        TypeOneIterationInvariants I →
          ¬ NoBumpNoCross I → InvariantSimplifyingActionOutcome I)
    (I₀ : IterationInput R hpos Q0)
    (Inv₀ : TypeOneIterationInvariants I₀) :
    ∃ I : IterationInput R hpos Q0,
      Nonempty (TypeOneIterationInvariants I) ∧
        (NoBumpNoCross I ∨
          ∃ L'' : PerfectPathPacking G A B,
            linkageAuxDegreeTwoCount L'' <
              linkageAuxDegreeTwoCount I.linkage) :=
  exists_terminal_or_degree_drop_of_invariant_actions
    (Terminal := NoBumpNoCross) hstep I₀ Inv₀

/-- Upgrade a bump action certificate to the invariant-preserving action
outcome once each successor certificate is known to preserve the row invariant
package. -/
theorem BumpActionCertificate.invariantSimplifyingActionOutcome
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0} {Bump : BumpWitness I}
    (C : BumpActionCertificate Bump)
    (hsuccInv :
      ∀ S : BumpSuccessorCertificate Bump,
        TypeOneIterationInvariants S.next) :
    InvariantSimplifyingActionOutcome I := by
  rcases C.degree_drop with hdrop | hsucc
  · exact Or.inl hdrop
  · rcases hsucc with ⟨S⟩
    exact Or.inr ⟨S.next, ⟨hsuccInv S⟩, S.tilde_card_lt⟩

/-- Upgrade a cross action certificate to the invariant-preserving action
outcome once each successor certificate is known to preserve the row invariant
package. -/
theorem CrossActionCertificate.invariantSimplifyingActionOutcome
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0} {Cross : CrossWitness I}
    (C : CrossActionCertificate Cross)
    (hsuccInv :
      ∀ S : CrossSuccessorCertificate Cross,
        TypeOneIterationInvariants S.next) :
    InvariantSimplifyingActionOutcome I := by
  rcases C.degree_drop with hdrop | hsucc
  · exact Or.inl hdrop
  · rcases hsucc with ⟨S⟩
    exact Or.inr ⟨S.next, ⟨hsuccInv S⟩, S.tilde_card_lt⟩

/-- Upgrade a bump action certificate to the full-invariant-preserving action
outcome once each successor certificate is known to preserve both the row
bookkeeping and the active auxiliary two-path invariant. -/
theorem BumpActionCertificate.fullInvariantSimplifyingActionOutcome
    {R : IndexedAuxiliaryPrefix L h} {hpos : 0 < h}
    {Q : PerfectPathPacking G R.X R.Y}
    {Q0 : TypeOneQStarFamily R hpos Q}
    {I : IterationInput R hpos Q0} {Bump : BumpWitness I}
    (C : BumpActionCertificate Bump)
    (hsuccInv :
      ∀ S : BumpSuccessorCertificate Bump,
        TypeOneFullIterationInvariants S.next) :
