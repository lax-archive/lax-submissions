/-- Figure 8 local degree-test update with the successor order chosen from
the concrete attachment dispatch.

This removes the manual choice between the two successor row orders from the
caller.  The remaining supplied data are exactly the branch-specific
auxiliary-graph descriptions and the no-skip contact-survival facts for the two
replacement rows. -/
noncomputable def paperActionUpdate_of_localDegreeTest_constructedSuccessor_byAttachments
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (auxA auxD : I.linkage.Index)
    (hAU_old :
      (linkageAuxGraph I.linkage).Adj auxA (I.rowIndex Cross.rowLeft))
    (hUV_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowLeft) (I.rowIndex Cross.rowRight))
    (hVD_old :
      (linkageAuxGraph I.linkage).Adj
        (I.rowIndex Cross.rowRight) auxD)
    (hA_old : DegreeEquals (linkageAuxGraph I.linkage) auxA 2)
    (hU_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowLeft) 2)
    (hV_old :
      DegreeEquals (linkageAuxGraph I.linkage)
        (I.rowIndex Cross.rowRight) 2)
    (hD_old : DegreeEquals (linkageAuxGraph I.linkage) auxD 2)
    (hAV : auxA ≠ I.rowIndex Cross.rowRight)
    (hUD : I.rowIndex Cross.rowLeft ≠ auxD)
    (hAD : auxA ≠ auxD)
    (haux_left :
      AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j)
    (haux_right :
      AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hadj_swap :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) i)
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) j))
    (hleftReplacementHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.leftPath)
    (hrightReplacementHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.rightPath) :
    CrossPaperActionUpdate Inv Cross := by
  classical
  by_cases hU_new :
      DegreeEquals (linkageAuxGraph Cross.replacementLinkageConcrete)
        (I.rowIndex Cross.rowLeft) 2
  · by_cases hV_new :
        DegreeEquals (linkageAuxGraph Cross.replacementLinkageConcrete)
          (I.rowIndex Cross.rowRight) 2
    · have horder :=
          Cross.replacement_attachment_order_of_old_local_data auxA auxD
            hAU_old hVD_old hU_new hV_new hAV hUD hAD
      exact
        match horder with
        | Or.inl _ =>
            Cross.paperActionUpdate_leftRight_of_localDegreeTest_constructedSuccessor_hitsReplacements
              Inv auxA auxD hAU_old hUV_old hVD_old hA_old hU_old hV_old
              hD_old hAV hUD haux_left hleftReplacementHit
              hrightReplacementHit hadj_iff
        | Or.inr _ =>
            Cross.paperActionUpdate_rightLeft_of_localDegreeTest_constructedSuccessor_hitsReplacements
              Inv auxA auxD hAU_old hUV_old hVD_old hA_old hU_old hV_old
              hD_old hAV hUD haux_right hleftReplacementHit
              hrightReplacementHit hadj_swap
    · exact
        Cross.paperActionUpdate_leftRight_of_localDegreeTest_constructedSuccessor_hitsReplacements
          Inv auxA auxD hAU_old hUV_old hVD_old hA_old hU_old hV_old
          hD_old hAV hUD haux_left hleftReplacementHit hrightReplacementHit
          hadj_iff
  · exact
      Cross.paperActionUpdate_leftRight_of_localDegreeTest_constructedSuccessor_hitsReplacements
        Inv auxA auxD hAU_old hUV_old hVD_old hA_old hU_old hV_old
        hD_old hAV hUD haux_left hleftReplacementHit hrightReplacementHit
        hadj_iff

/-- Figure 8 local degree-test update with both the old local quadruple and the
successor order chosen internally.

This is the paper-level wrapper for the nonterminating cross branch once the
two branch-specific auxiliary-graph descriptions and replacement-row contact
facts are available.  The wrapper first extracts the old boundary-aware local
quadruple from the maintained extended row path, then uses the concrete
attachment dispatch to choose between the `X,Y` and `Y,X` successor orders. -/
noncomputable def paperActionUpdate_of_orderedLocalDegreeTest_constructedSuccessor_byAttachments
    (Inv : TypeOneExtendedFutureCleanIterationInvariants I)
    (haux_left :
      AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hadj_iff :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj i j)
    (haux_right :
      AuxGraphsIsomorphic L Cross.replacementLinkageConcrete)
    (hadj_swap :
      ∀ i j : I.linkage.Index,
        (linkageAuxGraph Cross.replacementLinkageConcrete).Adj i j ↔
          (linkageAuxGraph I.linkage).Adj
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) i)
            ((Equiv.swap (I.rowIndex Cross.rowLeft)
              (I.rowIndex Cross.rowRight)) j))
    (hleftReplacementHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.leftPath)
    (hrightReplacementHit :
      ∀ i : Q.Index, ∀ hi : i ∈ Q0.indices,
        HitsGraphPath (Q0.data i hi).qstar
          Cross.replacementPaths.rightPath) :
    CrossPaperActionUpdate Inv Cross := by
  classical
  rcases Cross.old_rows_forward_or_backward Inv with hforward | hbackward
  · let D :=
      TypeOneExtendedFutureCleanIterationInvariants.crossForwardLocalQuadData
        (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
        Inv Cross hforward
    exact
      Cross.paperActionUpdate_of_localDegreeTest_constructedSuccessor_byAttachments
        Inv D.auxA D.auxD D.hAU_old D.hUV_old D.hVD_old D.hA_old
        D.hU_old D.hV_old D.hD_old D.hAV D.hUD D.hAD
        haux_left hadj_iff haux_right hadj_swap
        hleftReplacementHit hrightReplacementHit
  · let D :=
      TypeOneExtendedFutureCleanIterationInvariants.crossBackwardLocalQuadData
        (R := R) (hpos := hpos) (Q := Q) (Q0 := Q0) (I := I)
        Inv Cross hbackward
    exact
      Cross.paperActionUpdate_of_localDegreeTest_constructedSuccessor_byAttachments
        Inv D.auxA D.auxD D.hAU_old D.hUV_old D.hVD_old D.hA_old
        D.hU_old D.hV_old D.hD_old D.hAV D.hUD D.hAD
        haux_left hadj_iff haux_right hadj_swap
        hleftReplacementHit hrightReplacementHit

