    (hterminal :
      ∀ I : IterationInput R hpos S.Q0,
        TypeOneIterationInvariants I → NoBumpNoCross I →
          ContainsGridMinor G h) :
    ContainsGridMinor G h ∨
      ∃ L'' : PerfectPathPacking G A B,
        linkageAuxDegreeTwoCount L'' < linkageAuxDegreeTwoCount L :=
  IndexedAuxiliaryPrefix.gridMinor_or_degree_drop_of_invariant_actions
    hstep hterminal S.input S.initialInvariants

