open Lax457868Proofs.ReusedOriginal.Construction.MarkingMath
open Lax457868Proofs.ExceptionRefinementStep
open Lax457868Proofs.ExceptionPhaseSource
open Lax457868Proofs.ReusedOriginal.Construction.AdaptiveTapeCounting

noncomputable section

set_option maxHeartbeats 2000000

/-- Restore the original A-domain modulus and requested batch size.  The
representative selection inside a previous attempt may have changed either
scalar. -/
def restoreInitialDomain (m r : ℕ) : Com :=
  (Com.assign "drawModulus" (.lit m)).seq
    (.assign "batchTarget" (.lit r))

/-- Restore the A-domain parameters saved before the first attempt. -/
def restoreInitialDomainRuntime : Com :=
  (Com.assign "drawModulus" (.var "initialDomainSize")).seq
    (.assign "batchTarget" (.var "initialBatchTarget"))

/-- The guarded result of one checked attempt. -/
def initialRetryDecision : Com :=
  .ite (.eq (.var "batchFailed") (.lit 0))
    (.ite (.eq (.var "repFailed") (.lit 0))
      (.ite (.eq (.var "attemptAccepted") (.lit 1))
        (.assign "initialRetryStatus" (.lit 1))
        (restoreInitialDomainRuntime.seq
          (.assign "initialRetriesLeft"
            (.sub (.var "initialRetriesLeft") (.lit 1)))))
      (.assign "initialRetryStatus" (.lit 2)))
    (.assign "initialRetryStatus" (.lit 2))

/-- Every decision branch is read-free and takes at most twenty steps. -/
lemma retryDecision_cost_le {B p : ℕ} {σ τ : Env}
    (hrun : BigStepB B initialRetryDecision σ τ p) : p ≤ 20 := by
  unfold initialRetryDecision at hrun
  cases hrun with
  | ite_false _ hset =>
      cases hset
      simp [Cond.size, Expr.size]
  | ite_true _ hrep =>
      cases hrep with
      | ite_false _ hset =>
          cases hset
          simp [Cond.size, Expr.size]
      | ite_true _ haccept =>
          cases haccept with
          | ite_true _ hset =>
              cases hset
              simp [Cond.size, Expr.size]
          | ite_false _ hrestore =>
              cases hrestore with
              | seq hfirst hlast =>
                  cases hfirst with
                  | seq ha hb =>
                      cases ha
                      cases hb
                      cases hlast
                      simp [Cond.size, Expr.size]

/-- One iteration of the fixed retry loop.  An empty remaining budget sets
exhaustion without calling the sampler.  On an ordinary rejected attempt the
machine restores the original sampling registers and decrements the counter.
The outer draw failure guard protects the possibly stale `repFailed` value. -/
def initialRetryBody : Com :=
  .ite (.eq (.var "initialRetriesLeft") (.lit 0))
    (.assign "initialRetryStatus" (.lit 3))
    (fullInitialAttempt.seq initialRetryDecision)

/-- One fixed source program.  The attempt cap is read from a runtime
register; no command is generated by recursion on that cap. -/
def initialSamplerRetriesSource : Com :=
  (Com.assign "initialDomainSize" (.var "drawModulus")).seq
    ((Com.assign "initialBatchTarget" (.var "batchTarget")).seq
      ((Com.assign "initialRetriesLeft" (.var "initialRetryCap")).seq
        ((Com.assign "initialRetryStatus" (.lit 0)).seq
          (.while (.eq (.var "initialRetryStatus") (.lit 0))
            initialRetryBody))))

/-- In a nonempty retry iteration, the source executes a complete actual
attempt before testing its outcome.  This retains the exact machine costs of
the attempt and of the remaining loop. -/
lemma retryWhile_first_attempt {B : ℕ} {σ τ : Env} {cost left : ℕ}
    (hleft : σ.vars "initialRetriesLeft" = left)
    (hstatus : σ.vars "initialRetryStatus" = 0)
    (hpositive : 0 < left) (hleftB : left < B)
    (hrun : BigStepB B
      (.while (.eq (.var "initialRetryStatus") (.lit 0)) initialRetryBody)
      σ τ cost) :
    ∃ σa σd q p u,
      BigStepB B fullInitialAttempt σ σa q ∧
      BigStepB B initialRetryDecision σa σd p ∧
      BigStepB B
        (.while (.eq (.var "initialRetryStatus") (.lit 0)) initialRetryBody)
        σd τ u ∧
      cost = 1 + (Cond.eq (.var "initialRetryStatus") (.lit 0)).size +
        1 + (Cond.eq (.var "initialRetriesLeft") (.lit 0)).size +
        (q + p) + u := by
  cases hrun with
  | while_false hguard =>
      have hvar : (Expr.var "initialRetryStatus").evalB B σ = some 0 := by
        rw [evalB_var_iff]
        exact ⟨hstatus.symm, by rw [hstatus]; omega⟩
      have hlit : (Expr.lit 0).evalB B σ = some 0 := evalB_lit (by omega)
      have htrue : (Cond.eq (.var "initialRetryStatus") (.lit 0)).evalB B σ =
          some true := by rw [evalB_condEq hvar hlit]; simp
      simp [htrue] at hguard
  | while_true hguard hbody htail =>
      unfold initialRetryBody at hbody
      cases hbody with
      | ite_true hzero hset =>
          have hfalse : (Cond.eq (.var "initialRetriesLeft") (.lit 0)).evalB B σ =
              some false := by
            have hvar : (Expr.var "initialRetriesLeft").evalB B σ = some left := by
              rw [evalB_var_iff]
              exact ⟨hleft.symm, by rw [hleft]; exact hleftB⟩
            have hlit : (Expr.lit 0).evalB B σ = some 0 :=
              evalB_lit (by omega)
            rw [evalB_condEq hvar hlit]
            simp [Nat.ne_of_gt hpositive]
          simp [hfalse] at hzero
      | ite_false hnonzero hseq =>
          cases hseq with
          | seq hattempt hdecision =>
              exact ⟨_, _, _, _, _, hattempt, hdecision, htail, by omega⟩

/-- The charge from the checked one-attempt theorem, with the actual number
of bits used by the draw and the actual representative stage charge. -/
def attemptCharge (n m _r _t targetCap used valueCount : ℕ)
    (drawFailed : Bool) (stageCost : ℕ) : ℕ :=
  2 + initialDrawSampleCost n m used
    (valueCount + if drawFailed then 1 else 0) valueCount drawFailed +
    (if drawFailed then 5 else 4 + stageCost) + 9 +
    (300 * (n + targetCap + 1) + (94 * n + 15) + 8 + (20 * n + 9))

/-- A standalone checked full-attempt run witness for a charge and its
cost parameters.  This predicate does not connect consecutive retry states. -/
def CheckedAttemptCharge (B n m r t targetCap q : ℕ) : Prop :=
  ∃ (σ₀ σ₁ : Env) (used valueCount : ℕ)
    (drawFailed : Bool) (stageCost : ℕ),
    Run B fullInitialAttempt σ₀ σ₁ q ∧
      q = attemptCharge n m r t targetCap used valueCount drawFailed stageCost

private lemma restore_run {B m r : ℕ} {σ : Env}
    (hmB : m < B) (hrB : r < B) :
    Run B (restoreInitialDomain m r) σ
      ((σ.setVar "drawModulus" m).setVar "batchTarget" r) 4 := by
  have hm : Run B (.assign "drawModulus" (.lit m)) σ
      (σ.setVar "drawModulus" m) 2 := by
    simpa using (Run.assign (evalB_lit hmB))
  have hr : Run B (.assign "batchTarget" (.lit r))
      (σ.setVar "drawModulus" m)
      ((σ.setVar "drawModulus" m).setVar "batchTarget" r) 2 := by
    simpa using (Run.assign (evalB_lit hrB))
  exact hm.seq hr

private lemma restore_runtime_run {B m r : ℕ} {σ : Env}
    (hm : σ.vars "initialDomainSize" = m)
    (hr : σ.vars "initialBatchTarget" = r)
    (hmB : m < B) (hrB : r < B) :
    Run B restoreInitialDomainRuntime σ
      ((σ.setVar "drawModulus" m).setVar "batchTarget" r) 4 := by
  have hvarM : (Expr.var "initialDomainSize").evalB B σ = some m := by
    rw [evalB_var_iff]
    exact ⟨hm.symm, by rw [hm]; exact hmB⟩
  have hfirst : Run B (.assign "drawModulus" (.var "initialDomainSize"))
      σ (σ.setVar "drawModulus" m) 2 := by
    simpa using (Run.assign hvarM)
  have hvarR : (Expr.var "initialBatchTarget").evalB B
      (σ.setVar "drawModulus" m) = some r := by
    rw [evalB_var_iff]
    constructor
    · simpa using hr.symm
    · simpa [hr] using hrB
  have hsecond : Run B (.assign "batchTarget" (.var "initialBatchTarget"))
      (σ.setVar "drawModulus" m)
      ((σ.setVar "drawModulus" m).setVar "batchTarget" r) 2 := by
    simpa using (Run.assign hvarR)
  exact hfirst.seq hsecond

private lemma runWhileTrue {B : ℕ} {b : Cond} {c : Com}
    {σ σ₁ σ₂ : Env} {P Q : ℕ}
    (hb : b.evalB B σ = some true)
    (hbody : Run B c σ σ₁ P)
    (hloop : Run B (.while b c) σ₁ σ₂ Q) :
    Run B (.while b c) σ σ₂ (1 + b.size + P + Q) := by
  obtain ⟨p, hp, hbs⟩ := hbody
  obtain ⟨q, hq, hls⟩ := hloop
  exact ⟨1 + b.size + p + q, by omega,
    BigStepB.while_true hb hbs hls⟩

/-- The state facts needed to invoke the checked full attempt.  Scratch
contents are arbitrary; each next state is represented from its actual
array lengths. -/
structure ReadyInput (B n m domainCap r t bufferCap targetCap Q k cap : ℕ)
    (G : SimpleGraph (Fin n)) (x : List ℕ) (A : Finset ℕ) where
  I : Input B n m domainCap r t bufferCap targetCap Q G x A
  degree : ℕ → ℕ
  inter : ℕ → ℕ
  neighbors : ℕ → ℕ
  exceptionFlags : ℕ → ℕ
  exceptionList : ℕ → ℕ
  hactiveA : I.σ.arrs "activeA" = arrOf n (setFlag A)
  hdegree : I.σ.arrs "degree" = arrOf n degree
  hinter : I.σ.arrs "inter" = arrOf n inter
  hneighbors : I.σ.arrs "neighbors" = arrOf n neighbors
  hexceptionFlags : I.σ.arrs "exceptionFlags" = arrOf n exceptionFlags
  hexceptionList : I.σ.arrs "exceptionList" = arrOf n exceptionList
  hnearBound : I.σ.vars "nearBound" = k / 3
  hexceptionCap : I.σ.vars "exceptionCap" = cap
  hnB : 2 * n + 1 < B
  hkB : k / 3 < B
  hcapB : cap < B

private def ReadyInput.withRetriesLeft
    {B n m domainCap r t bufferCap targetCap Q k cap : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (left : ℕ) :
    ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A := by
  let J : Input B n m domainCap r t bufferCap targetCap Q G x A := {
    R.I with
    σ := R.I.σ.setVar "initialRetriesLeft" left
    hn := by simpa using R.I.hn
    hQpow := by simpa using R.I.hQpow
    hactiveBCount := by simpa using R.I.hactiveBCount
    hdrawModulus := by simpa using R.I.hdrawModulus
    hbatchTarget := by simpa using R.I.hbatchTarget
    hdrawCap := by simpa using R.I.hdrawCap
    hinput := by simpa using R.I.hinput
    hkey0 := by simpa using R.I.hkey0
    hdrawDomain := by simpa using R.I.hdrawDomain
    hsampleDraws := by simpa using R.I.hsampleDraws
    hsampleFlags := by simpa using R.I.hsampleFlags
    hord := by simpa using R.I.hord
    hoff := by simpa using R.I.hoff
    htarget := by simpa using R.I.htarget
    hactiveB := by simpa using R.I.hactiveB
    hclassB := by simpa using R.I.hclassB
    hclassSize := by simpa using R.I.hclassSize
    hmarkedCount := by simpa using R.I.hmarkedCount
    hstamp := by simpa using R.I.hstamp
    hmarked := by simpa using R.I.hmarked
    htouched := by simpa using R.I.htouched
    hsplit := by simpa using R.I.hsplit
    hrepB := by simpa using R.I.hrepB
    hcount := by simpa using R.I.hcount
    hscratch := by simpa using R.I.hscratch
    hrepClass := by simpa using R.I.hrepClass
  }
  exact {
    R with
    I := J
    hactiveA := by simpa [J] using R.hactiveA
    hdegree := by simpa [J] using R.hdegree
    hinter := by simpa [J] using R.hinter
    hneighbors := by simpa [J] using R.hneighbors
    hexceptionFlags := by simpa [J] using R.hexceptionFlags
    hexceptionList := by simpa [J] using R.hexceptionList
    hnearBound := by simpa [J] using R.hnearBound
    hexceptionCap := by simpa [J] using R.hexceptionCap
  }

private def ReadyInput.withSetup
    {B n m domainCap r t bufferCap targetCap Q k cap : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (attemptCap : ℕ) :
    ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A := by
  let σ₁ := R.I.σ.setVar "initialDomainSize" m
  let σ₂ := σ₁.setVar "initialBatchTarget" r
  let σ₃ := σ₂.setVar "initialRetriesLeft" attemptCap
  let σ₄ := σ₃.setVar "initialRetryStatus" 0
  let J : Input B n m domainCap r t bufferCap targetCap Q G x A := {
    R.I with
    σ := σ₄
    hn := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hn
    hQpow := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hQpow
    hactiveBCount := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hactiveBCount
    hdrawModulus := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hdrawModulus
    hbatchTarget := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hbatchTarget
    hdrawCap := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hdrawCap
    hinput := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hinput
    hkey0 := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hkey0
    hdrawDomain := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hdrawDomain
    hsampleDraws := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hsampleDraws
    hsampleFlags := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hsampleFlags
    hord := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hord
    hoff := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hoff
    htarget := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.htarget
    hactiveB := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hactiveB
    hclassB := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hclassB
    hclassSize := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hclassSize
    hmarkedCount := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hmarkedCount
    hstamp := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hstamp
    hmarked := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hmarked
    htouched := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.htouched
    hsplit := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hsplit
    hrepB := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hrepB
    hcount := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hcount
    hscratch := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hscratch
    hrepClass := by simpa [σ₄, σ₃, σ₂, σ₁] using R.I.hrepClass
  }
  exact {
    R with
    I := J
    hactiveA := by simpa [J, σ₄, σ₃, σ₂, σ₁] using R.hactiveA
    hdegree := by simpa [J, σ₄, σ₃, σ₂, σ₁] using R.hdegree
    hinter := by simpa [J, σ₄, σ₃, σ₂, σ₁] using R.hinter
    hneighbors := by simpa [J, σ₄, σ₃, σ₂, σ₁] using R.hneighbors
    hexceptionFlags := by simpa [J, σ₄, σ₃, σ₂, σ₁] using R.hexceptionFlags
    hexceptionList := by simpa [J, σ₄, σ₃, σ₂, σ₁] using R.hexceptionList
    hnearBound := by simpa [J, σ₄, σ₃, σ₂, σ₁] using R.hnearBound
    hexceptionCap := by simpa [J, σ₄, σ₃, σ₂, σ₁] using R.hexceptionCap
  }

/-- Vary the unused flat random tape while preserving every noninput source
register and proof-side graph/domain parameter. -/
def ReadyInput.reinput
    {B n m domainCap r t bufferCap targetCap Q k cap : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (bits : List Bool)
    (hbudget : r * t * Nat.clog 2 m + n * t * Nat.clog 2 n ≤ bits.length) :
    ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A := by
  let J := InitialFlatLaw.reinputInitialAttempt R.I bits hbudget
  exact {
    R with
    I := J
    hactiveA := by simpa [J, InitialFlatLaw.reinputInitialAttempt] using R.hactiveA
    hdegree := by simpa [J, InitialFlatLaw.reinputInitialAttempt] using R.hdegree
    hinter := by simpa [J, InitialFlatLaw.reinputInitialAttempt] using R.hinter
    hneighbors := by simpa [J, InitialFlatLaw.reinputInitialAttempt] using R.hneighbors
    hexceptionFlags := by simpa [J, InitialFlatLaw.reinputInitialAttempt] using R.hexceptionFlags
    hexceptionList := by simpa [J, InitialFlatLaw.reinputInitialAttempt] using R.hexceptionList
    hnearBound := by simpa [J, InitialFlatLaw.reinputInitialAttempt] using R.hnearBound
    hexceptionCap := by simpa [J, InitialFlatLaw.reinputInitialAttempt] using R.hexceptionCap
  }

lemma ReadyInput.reinput_bits
    {B n m domainCap r t bufferCap targetCap Q k cap : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (bits : List Bool)
    (hbudget : r * t * Nat.clog 2 m + n * t * Nat.clog 2 n ≤ bits.length) :
    (R.reinput bits hbudget).I.bits = bits := rfl

lemma ReadyInput.reinput_state
    {B n m domainCap r t bufferCap targetCap Q k cap : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (bits : List Bool)
    (hbudget : r * t * Nat.clog 2 m + n * t * Nat.clog 2 n ≤ bits.length) :
    (R.reinput bits hbudget).I.σ =
      {R.I.σ with inp := bits.map Bool.toNat ++ R.I.rest} := rfl

lemma ReadyInput.reinput_self_state
    {B n m domainCap r t bufferCap targetCap Q k cap : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A) :
    (R.reinput R.I.bits R.I.hbudget).I.σ = R.I.σ := by
  rw [ReadyInput.reinput_state]
  simpa [← R.I.hinput]

private lemma ready_after_rejection
    {B n m domainCap r t bufferCap targetCap Q k cap : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    {σ' : Env} {charge d : ℕ}
    (hrun : Run B fullInitialAttempt R.I.σ σ' charge)
    (hn : σ'.vars "n" = n)
    (hqpow : σ'.vars "qpow" = Q)
    (hoff : σ'.arrs "off" = arrOf (n + 1) (offset x))
    (htgt : σ'.arrs "tgt" = arrOf targetCap (target x))
    (hactiveA : σ'.arrs "activeA" = arrOf n (setFlag A))
    (hactiveB : σ'.arrs "activeB" = arrOf n R.I.activeB)
    (hinp : σ'.inp = (R.I.bits.drop d).map Bool.toNat ++ R.I.rest)
    (hbudget : r * t * Nat.clog 2 m + n * t * Nat.clog 2 n ≤
      (R.I.bits.drop d).length) :
    ∃ S : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A,
      Run B (restoreInitialDomain m r) σ' S.I.σ 4 ∧
      S.I.σ = (σ'.setVar "drawModulus" m).setVar "batchTarget" r ∧
      S.I.bits = R.I.bits.drop d ∧ S.I.rest = R.I.rest ∧
      S.I.activeB = R.I.activeB := by
  let τ := (σ'.setVar "drawModulus" m).setVar "batchTarget" r
  have hrestore : Run B (restoreInitialDomain m r) σ' τ 4 :=
    restore_run R.I.hmB R.I.hrB
  have harrLen {a : String} {len : ℕ} {f : ℕ → ℕ}
      (h : R.I.σ.arrs a = arrOf len f) : (σ'.arrs a).length = len := by
    rw [run_array_length_eq hrun a, h]
    simp [arrOf]
  obtain ⟨key0, hkey0⟩ := exists_arrOf_of_length (harrLen R.I.hkey0)
  obtain ⟨oldDraws, holdDraws⟩ := exists_arrOf_of_length (harrLen R.I.hsampleDraws)
  obtain ⟨oldFlags, holdFlags⟩ := exists_arrOf_of_length (harrLen R.I.hsampleFlags)
  obtain ⟨ord, hord⟩ := exists_arrOf_of_length (harrLen R.I.hord)
  obtain ⟨classB, hclassB⟩ := exists_arrOf_of_length (harrLen R.I.hclassB)
  obtain ⟨classSize, hclassSize⟩ := exists_arrOf_of_length (harrLen R.I.hclassSize)
  obtain ⟨markedCount, hmarkedCount⟩ :=
    exists_arrOf_of_length (harrLen R.I.hmarkedCount)
  obtain ⟨stamp, hstamp⟩ := exists_arrOf_of_length (harrLen R.I.hstamp)
  obtain ⟨marked, hmarked⟩ := exists_arrOf_of_length (harrLen R.I.hmarked)
  obtain ⟨touched, htouched⟩ := exists_arrOf_of_length (harrLen R.I.htouched)
  obtain ⟨split, hsplit⟩ := exists_arrOf_of_length (harrLen R.I.hsplit)
  obtain ⟨repB, hrepB⟩ := exists_arrOf_of_length (harrLen R.I.hrepB)
  obtain ⟨count, hcount⟩ := exists_arrOf_of_length (harrLen R.I.hcount)
  obtain ⟨scratchOrder, hscratchOrder⟩ :=
    exists_arrOf_of_length (harrLen R.I.hscratch)
  obtain ⟨repClass, hrepClass⟩ := exists_arrOf_of_length (harrLen R.I.hrepClass)
  obtain ⟨degree, hdegree⟩ := exists_arrOf_of_length (harrLen R.hdegree)
  obtain ⟨inter, hinter⟩ := exists_arrOf_of_length (harrLen R.hinter)
  obtain ⟨neighbors, hneighbors⟩ := exists_arrOf_of_length (harrLen R.hneighbors)
  obtain ⟨exceptionFlags, hexceptionFlags⟩ :=
    exists_arrOf_of_length (harrLen R.hexceptionFlags)
  obtain ⟨exceptionList, hexceptionList⟩ :=
    exists_arrOf_of_length (harrLen R.hexceptionList)
  have hdomain : σ'.arrs "drawDomain" = arrOf domainCap R.I.domain := by
    rw [hrun.frame_arr "drawDomain" (by decide)]
    exact R.I.hdrawDomain
  have hactiveCount : σ'.vars "activeBCount" =
      (activeVertices n R.I.activeB).card := by
    rw [hrun.frame_var "activeBCount" (by decide)]
    exact R.I.hactiveBCount
  have hdrawCap : σ'.vars "drawCap" = t := by
    rw [hrun.frame_var "drawCap" (by decide)]
    exact R.I.hdrawCap
  have hnear : σ'.vars "nearBound" = k / 3 := by
    rw [hrun.frame_var "nearBound" (by decide)]
    exact R.hnearBound
  have hcap : σ'.vars "exceptionCap" = cap := by
    rw [hrun.frame_var "exceptionCap" (by decide)]
    exact R.hexceptionCap
  let J : Input B n m domainCap r t bufferCap targetCap Q G x A := {
    σ := τ
    key0 := key0
    domain := R.I.domain
    oldDraws := oldDraws
    oldFlags := oldFlags
    ord := ord
    activeB := R.I.activeB
    classB := classB
    classSize := classSize
    markedCount := markedCount
    stamp := stamp
    marked := marked
    touched := touched
    split := split
    repB := repB
    count := count
    scratchOrder := scratchOrder
    repClass := repClass
    bits := R.I.bits.drop d
    rest := R.I.rest
    hx := R.I.hx
    htargetCapEq := R.I.htargetCapEq
    henum := R.I.henum
    hAnonempty := R.I.hAnonempty
    hA := R.I.hA
    hn := by simpa [τ] using hn
    hQpow := by simpa [τ] using hqpow
    hactiveBCount := by simpa [τ] using hactiveCount
    hdrawModulus := by simp [τ]
    hbatchTarget := by simp [τ]
    hdrawCap := by simpa [τ] using hdrawCap
    hinput := by simpa [τ] using hinp
    hkey0 := by simpa [τ] using hkey0
    hdrawDomain := by simpa [τ] using hdomain
    hsampleDraws := by simpa [τ] using holdDraws
    hsampleFlags := by simpa [τ] using holdFlags
    hord := by simpa [τ] using hord
    hoff := by simpa [τ] using hoff
    htarget := by simpa [τ] using htgt
    hactiveB := by simpa [τ] using hactiveB
    hclassB := by simpa [τ] using hclassB
    hclassSize := by simpa [τ] using hclassSize
    hmarkedCount := by simpa [τ] using hmarkedCount
    hstamp := by simpa [τ] using hstamp
    htouched := by simpa [τ] using htouched
    hmarked := by simpa [τ] using hmarked
    hsplit := by simpa [τ] using hsplit
    hrepB := by simpa [τ] using hrepB
    hcount := by simpa [τ] using hcount
    hscratch := by simpa [τ] using hscratchOrder
    hrepClass := by simpa [τ] using hrepClass
    hactive01 := R.I.hactive01
    hQle := R.I.hQle
    hQltB := R.I.hQltB
    hnPlusOneB := R.I.hnPlusOneB
    htargetCapB := R.I.htargetCapB
    hrBuf := R.I.hrBuf
    hrB := R.I.hrB
    htB := R.I.htB
    hmPos := R.I.hmPos
    hmCap := R.I.hmCap
    hmB := R.I.hmB
    htwoB := R.I.htwoB
    honeB := R.I.honeB
    hpowM := R.I.hpowM
    hpowN := R.I.hpowN
    hbudget := hbudget
  }
  let S : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A := {
    I := J
    degree := degree
    inter := inter
    neighbors := neighbors
    exceptionFlags := exceptionFlags
    exceptionList := exceptionList
    hactiveA := by simpa [J, τ] using hactiveA
    hdegree := by simpa [J, τ] using hdegree
    hinter := by simpa [J, τ] using hinter
    hneighbors := by simpa [J, τ] using hneighbors
    hexceptionFlags := by simpa [J, τ] using hexceptionFlags
    hexceptionList := by simpa [J, τ] using hexceptionList
    hnearBound := by simpa [J, τ] using hnear
    hexceptionCap := by simpa [J, τ] using hcap
    hnB := R.hnB
    hkB := R.hkB
    hcapB := R.hcapB
  }
  exact ⟨S, hrestore, rfl, rfl, rfl, rfl⟩

/-- The complete accepted output: an actual choice, its representative map,
the exception and sample flags, and both packed prefixes. -/
def AcceptedResult {n : ℕ} (G : SimpleGraph (Fin n))
    (A C : Finset ℕ) (r k cap : ℕ) (σ : Env) : Prop :=
  ∃ (mapped : ℕ → ℕ)
    (choice : InitialChoice A C (fun b => numericNeighborhood G b ∩ A) r)
    (packedExceptions packedSample : ℕ → ℕ),
    σ.vars "initialRetryStatus" = 1 ∧
    σ.vars "attemptAccepted" = 1 ∧
    σ.arrs "repB" = arrOf n mapped ∧
    (∀ b ∈ C, choice.representative b = mapped b) ∧
    σ.arrs "exceptionFlags" = arrOf n (setFlag (choice.exceptions k)) ∧
    σ.arrs "exceptionList" = arrOf n packedExceptions ∧
    PrefixEnumerates (σ.vars "exceptionCount") packedExceptions
      (choice.exceptions k) ∧
    σ.vars "exceptionCount" = (choice.exceptions k).card ∧
    σ.arrs "sampleFlags" = arrOf n (setFlag choice.sample) ∧
    σ.arrs "ord" = arrOf n packedSample ∧
    PrefixEnumerates (σ.vars "sampleCount") packedSample choice.sample ∧
    σ.vars "sampleCount" = choice.sample.card ∧
    (choice.exceptions k).card ≤ cap

/-- Bits reserved for one full attempt, without performing any machine
arithmetic with this product. -/
def attemptBitBudget (n m r t : ℕ) : ℕ :=
  r * t * Nat.clog 2 m + n * t * Nat.clog 2 n

private lemma drop_budget {bits : List Bool} {d per fuel : ℕ}
    (hbudget : (fuel + 1) * per ≤ bits.length)
    (hd : d ≤ per) : fuel * per ≤ (bits.drop d).length := by
  simp only [List.length_drop]
  have heq : (fuel + 1) * per = fuel * per + per := by ring
  omega

private lemma draw_consumed_le {m r t used : ℕ} {hm : 0 < m}
    {tape : Fin (r * t) → Fin (Nat.clog 2 m) → Bool}
    {values : List (Fin m)} {failed : Bool}
    (htrace : DrawTrace m hm t r (List.ofFn tape) values used failed) :
    used * Nat.clog 2 m ≤ r * t * Nat.clog 2 m := by
  have hu := (DrawTrace.used_and_calls m hm t htrace).1
  exact Nat.mul_le_mul_right _ (by simpa using hu)

/-- The complete attempt has a definite consumed-bit prefix even when a
bounded selector aborts. The suffix equation refers to the actual source
input, including the fixed unread input after the finite flat tape. -/
lemma readyAttempt_run_consumed
    {B n m domainCap r t bufferCap targetCap Q k cap : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (bits : List Bool)
    (hbudget : attemptBitBudget n m r t ≤ bits.length) :
    ∃ d : ℕ, ∃ σa : Env, ∃ q : ℕ,
      Run B fullInitialAttempt (R.reinput bits (by simpa [attemptBitBudget] using hbudget)).I.σ σa q ∧
      σa.inp = (bits.drop d).map Bool.toNat ++ R.I.rest ∧
      d ≤ attemptBitBudget n m r t := by
  let J := R.reinput bits (by simpa [attemptBitBudget] using hbudget)
  obtain ⟨σsel, σa, tape, tail, values, used, drawFailed, stageCost,
    hbits, htrace, hselRun, hfull, hbatch, hinpSel, houtSel,
    hoff, htgt, hactiveA, hactiveB, hn, hqpow,
    hdrawFailure, hdrawSuccess⟩ :=
    fullInitialAttempt_run_bits J.I J.hactiveA J.hdegree J.hinter
      J.hneighbors J.hexceptionFlags J.hexceptionList J.hnearBound
      J.hexceptionCap J.hnB J.hkB J.hcapB
  have hdrawLe : used * Nat.clog 2 m ≤ r * t * Nat.clog 2 m :=
    draw_consumed_le htrace
  let q := attemptCharge n m r t targetCap used values.length drawFailed stageCost
  have hfull' : Run B fullInitialAttempt J.I.σ σa q := by
    simpa [q, attemptCharge] using hfull
  cases drawFailed with
  | true =>
      obtain ⟨_, _, _, _, hinp⟩ := hdrawFailure rfl
      refine ⟨used * Nat.clog 2 m, σa, q, ?_, ?_, ?_⟩
      · exact hfull'
      · simpa [J, ReadyInput.reinput, InitialFlatLaw.reinputInitialAttempt] using hinp
      · exact hdrawLe.trans (Nat.le_add_right _ _)
  | false =>
      obtain ⟨W, repFailed, repUsed, hW, hWA, hvaluesLen,
        hrepLe, hrepVal, hinp, hrepFailure, hrepSuccess⟩ := hdrawSuccess rfl
      refine ⟨used * Nat.clog 2 m + repUsed, σa, q, ?_, ?_, ?_⟩
      · exact hfull'
      · simpa [J, ReadyInput.reinput, InitialFlatLaw.reinputInitialAttempt] using hinp
      · dsimp [attemptBitBudget]
        omega

/-- Two actual full-attempt runs reading the same consumed prefix stop at
the same bit position and have identical noninput output and memory. -/
lemma readyAttempt_same_prefix
    {B n m domainCap r t bufferCap targetCap Q k cap : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (bits bits' : List Bool)
    (hbudget : attemptBitBudget n m r t ≤ bits.length)
    (hbudget' : attemptBitBudget n m r t ≤ bits'.length)
    {σa σb : Env} {q q' d d' : ℕ}
    (hrun : Run B fullInitialAttempt
      (R.reinput bits (by simpa [attemptBitBudget] using hbudget)).I.σ σa q)
    (hrun' : Run B fullInitialAttempt
      (R.reinput bits' (by simpa [attemptBitBudget] using hbudget')).I.σ σb q')
    (hinp : σa.inp = (bits.drop d).map Bool.toNat ++ R.I.rest)
    (hinp' : σb.inp = (bits'.drop d').map Bool.toNat ++ R.I.rest)
    (hd : d ≤ attemptBitBudget n m r t)
    (hd' : d' ≤ attemptBitBudget n m r t)
    (hpre : bits.take d = bits'.take d) :
    d' = d ∧
      σb = {σa with inp := (bits'.drop d).map Bool.toNat ++ R.I.rest} := by
  let pre := (bits.take d).map Bool.toNat
  let tail := (bits'.drop d).map Bool.toNat ++ R.I.rest
  have hsplit : bits.map Bool.toNat =
      (bits.take d).map Bool.toNat ++ (bits.drop d).map Bool.toNat := by
    simpa only [List.map_append] using
      congrArg (List.map Bool.toNat) (List.take_append_drop d bits).symm
  have hsplit' : bits'.map Bool.toNat =
      (bits'.take d).map Bool.toNat ++ (bits'.drop d).map Bool.toNat := by
    simpa only [List.map_append] using
      congrArg (List.map Bool.toNat) (List.take_append_drop d bits').symm
  have hinput :
      (R.reinput bits (by simpa [attemptBitBudget] using hbudget)).I.σ.inp =
        pre ++ σa.inp := by
    change bits.map Bool.toNat ++ R.I.rest = pre ++ σa.inp
    rw [hinp]
    dsimp [pre]
    rw [hsplit]
    simp only [List.append_assoc]
  have hother :
      (R.reinput bits' (by simpa [attemptBitBudget] using hbudget')).I.σ =
        {(R.reinput bits (by simpa [attemptBitBudget] using hbudget)).I.σ with
          inp := pre ++ tail} := by
    change {R.I.σ with inp := bits'.map Bool.toNat ++ R.I.rest} =
      {R.I.σ with inp := pre ++ tail}
    have hinpEq : bits'.map Bool.toNat ++ R.I.rest = pre ++ tail := by
      dsimp [pre, tail]
      rw [hsplit', ← hpre]
      simp only [List.append_assoc]
    simp [hinpEq]
  have hsame : σb = {σa with inp := tail} := by
    apply StoppedPrefixAveraging.run_result_same_prefix hrun pre hinput tail
    simpa [hother] using hrun'
  have hdrop : (bits'.drop d').map Bool.toNat = (bits'.drop d).map Bool.toNat := by
    have h : σb.inp = tail := by simpa using congrArg Env.inp hsame
    rw [hinp'] at h
    exact List.append_cancel_right h
  have hlength := congrArg List.length hdrop
  simp only [List.length_map, List.length_drop] at hlength
  have hdN : d ≤ bits'.length := hd.trans hbudget'
  have hd'N : d' ≤ bits'.length := hd'.trans hbudget'
  have heq : d' = d := by omega
  exact ⟨heq, hsame⟩

/-- Replay one rejected attempt and its retry-decision command after
replacing the unread suffix. The next ready state changes only in its input. -/
lemma rejected_step_replay
    {B n m domainCap r t bufferCap targetCap Q k cap : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R J : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (bits bits' : List Bool)
    (hbudget : attemptBitBudget n m r t ≤ bits.length)
    (hbudget' : attemptBitBudget n m r t ≤ bits'.length)
    {σa : Env} {q d p : ℕ}
    (hrun : Run B fullInitialAttempt
      (R.reinput bits (by simpa [attemptBitBudget] using hbudget)).I.σ σa q)
    (hinp : σa.inp = (bits.drop d).map Bool.toNat ++ R.I.rest)
    (hpre : bits.take d = bits'.take d)
    (hdecision : Run B initialRetryDecision σa J.I.σ p)
    (hJbits : J.I.bits = bits.drop d)
    (hnextBudget : attemptBitBudget n m r t ≤ (bits'.drop d).length) :
    let σb := {σa with inp := (bits'.drop d).map Bool.toNat ++ R.I.rest}
    Run B fullInitialAttempt
      (R.reinput bits' (by simpa [attemptBitBudget] using hbudget')).I.σ σb q ∧
    Run B initialRetryDecision σb
      (J.reinput (bits'.drop d)
        (by simpa [attemptBitBudget] using hnextBudget)).I.σ p := by
  let pre := (bits.take d).map Bool.toNat
  let tail := (bits'.drop d).map Bool.toNat ++ R.I.rest
  have hinput :
      (R.reinput bits (by simpa [attemptBitBudget] using hbudget)).I.σ.inp =
        pre ++ σa.inp := by
    change bits.map Bool.toNat ++ R.I.rest = pre ++ σa.inp
    rw [hinp]
    dsimp [pre]
    have hsplit := congrArg (List.map Bool.toNat) (List.take_append_drop d bits).symm
    simp only [List.map_append] at hsplit
    rw [hsplit]
    simp only [List.append_assoc]
  have hstart :
      (R.reinput bits' (by simpa [attemptBitBudget] using hbudget')).I.σ =
        {(R.reinput bits (by simpa [attemptBitBudget] using hbudget)).I.σ with
          inp := pre ++ tail} := by
    change {R.I.σ with inp := bits'.map Bool.toNat ++ R.I.rest} =
      {R.I.σ with inp := pre ++ tail}
    have hsplit := congrArg (List.map Bool.toNat) (List.take_append_drop d bits').symm
    simp only [List.map_append] at hsplit
    have hinpEq : bits'.map Bool.toNat ++ R.I.rest = pre ++ tail := by
      dsimp [pre, tail]
      rw [hsplit, ← hpre]
      simp only [List.append_assoc]
    simp [hinpEq]
  have hrun' : Run B fullInitialAttempt
      (R.reinput bits' (by simpa [attemptBitBudget] using hbudget')).I.σ
      {σa with inp := tail} q := by
    simpa only [hstart] using
      StoppedPrefixAveraging.run_replace_consumed_suffix hrun pre hinput tail
  have hdecinp : J.I.σ.inp = σa.inp :=
    hdecision.frame_inp (by decide)
  have hJrest : J.I.rest = R.I.rest := by
    have h := J.I.hinput
    rw [hJbits, hdecinp, hinp] at h
    exact List.append_cancel_left h.symm
  have hnextState :
      (J.reinput (bits'.drop d)
        (by simpa [attemptBitBudget] using hnextBudget)).I.σ =
        {J.I.σ with inp := tail} := by
    rw [ReadyInput.reinput_state]
    simp [tail, hJrest]
  have hdecision' : Run B initialRetryDecision {σa with inp := tail}
      (J.reinput (bits'.drop d)
        (by simpa [attemptBitBudget] using hnextBudget)).I.σ p := by
    have hrep := StoppedPrefixAveraging.run_replace_consumed_suffix
      hdecision [] (by simpa using hdecinp.symm) tail
    simpa only [List.nil_append, hnextState] using hrep
  exact ⟨hrun', hdecision'⟩

/-- Actual bits consumed by one full attempt on a finite flat tape. -/
noncomputable def readyAttemptConsumed
    {B n m domainCap r t bufferCap targetCap Q k cap N : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (hbudget : attemptBitBudget n m r t ≤ N)
    (ρ : FlatTraceLaw.FlatTape N) : ℕ :=
  Classical.choose (readyAttempt_run_consumed R (List.ofFn ρ) (by
    simpa using hbudget))

lemma readyAttemptConsumed_spec
    {B n m domainCap r t bufferCap targetCap Q k cap N : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (hbudget : attemptBitBudget n m r t ≤ N)
    (ρ : FlatTraceLaw.FlatTape N) :
    ∃ σa : Env, ∃ q : ℕ,
      Run B fullInitialAttempt
        (R.reinput (List.ofFn ρ) (by simpa [attemptBitBudget] using hbudget)).I.σ
        σa q ∧
      σa.inp = ((List.ofFn ρ).drop (readyAttemptConsumed R hbudget ρ)).map
        Bool.toNat ++ R.I.rest ∧
      readyAttemptConsumed R hbudget ρ ≤ attemptBitBudget n m r t := by
  exact Classical.choose_spec
    (readyAttempt_run_consumed R (List.ofFn ρ) (by simpa using hbudget))

lemma readyAttemptConsumed_le
    {B n m domainCap r t bufferCap targetCap Q k cap N : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (hbudget : attemptBitBudget n m r t ≤ N)
    (ρ : FlatTraceLaw.FlatTape N) :
    readyAttemptConsumed R hbudget ρ ≤ N := by
  obtain ⟨σa, q, hrun, hinp, hd⟩ := readyAttemptConsumed_spec R hbudget ρ
  exact hd.trans hbudget

lemma readyAttemptConsumed_causal
    {B n m domainCap r t bufferCap targetCap Q k cap N : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (hbudget : attemptBitBudget n m r t ≤ N)
    (ρ τ : FlatTraceLaw.FlatTape N)
    (hpre : (List.ofFn ρ).take (readyAttemptConsumed R hbudget ρ) =
      (List.ofFn τ).take (readyAttemptConsumed R hbudget ρ)) :
    readyAttemptConsumed R hbudget τ = readyAttemptConsumed R hbudget ρ := by
  obtain ⟨σa, q, hrun, hinp, hd⟩ := readyAttemptConsumed_spec R hbudget ρ
  obtain ⟨σb, q', hrun', hinp', hd'⟩ := readyAttemptConsumed_spec R hbudget τ
  exact (readyAttempt_same_prefix R (List.ofFn ρ) (List.ofFn τ)
    (by simpa using hbudget) (by simpa using hbudget)
    hrun hrun' hinp hinp' hd hd' hpre).1

/-- The source loop continues precisely after a successful capped selection
whose actual acceptance scan rejects the sampled representatives. -/
def readyAttemptRejected
    {B n m domainCap r t bufferCap targetCap Q k cap N : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (hbudget : attemptBitBudget n m r t ≤ N)
    (ρ : FlatTraceLaw.FlatTape N) : Prop :=
  ∃ σa : Env, ∃ q : ℕ,
    Run B fullInitialAttempt
      (R.reinput (List.ofFn ρ) (by simpa [attemptBitBudget] using hbudget)).I.σ
      σa q ∧
    σa.vars "batchFailed" = 0 ∧ σa.vars "repFailed" = 0 ∧
    σa.vars "attemptAccepted" = 0

lemma readyAttemptRejected_of_same_prefix
    {B n m domainCap r t bufferCap targetCap Q k cap N : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (hbudget : attemptBitBudget n m r t ≤ N)
    (ρ τ : FlatTraceLaw.FlatTape N)
    (hpre : (List.ofFn ρ).take (readyAttemptConsumed R hbudget ρ) =
      (List.ofFn τ).take (readyAttemptConsumed R hbudget ρ))
    (hreject : readyAttemptRejected R hbudget ρ) :
    readyAttemptRejected R hbudget τ := by
  obtain ⟨σr, qr, hrunr, hbatch, hrep, haccept⟩ := hreject
  obtain ⟨σa, q, hruna, hinp, hd⟩ := readyAttemptConsumed_spec R hbudget ρ
  obtain ⟨σb, q', hrunb, hinp', hd'⟩ := readyAttemptConsumed_spec R hbudget τ
  have hrEq : σr = σa := by
    obtain ⟨_, _, ha⟩ := hrunr
    obtain ⟨_, _, hb⟩ := hruna
    exact (BigStep.unique ha.bigStep hb.bigStep).1
  have hsame := (readyAttempt_same_prefix R (List.ofFn ρ) (List.ofFn τ)
    (by simpa using hbudget) (by simpa using hbudget)
    hruna hrunb hinp hinp' hd hd' hpre).2
  refine ⟨σb, q', hrunb, ?_, ?_, ?_⟩
  · simpa [hsame, hrEq] using hbatch
  · simpa [hsame, hrEq] using hrep
  · simpa [hsame, hrEq] using haccept

/-- Reinputting a ready state changes only the concrete random input. The
source outcome event is evaluated by replacing that input with its candidate
flat tape, so the event itself is invariant under reinput. -/
lemma readyBadFiber_reinput_eq
    {B n m domainCap r t bufferCap targetCap Q k cap N : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (hbudget : attemptBitBudget n m r t ≤ N)
    (ρ τ υ : FlatTraceLaw.FlatTape N) :
    (FlatTraceLaw.flatBitsEquiv _).symm
      ⟨List.ofFn υ, by simp [ReadyInput.reinput_bits]⟩ ∈
      sourceInitialBadFiber
        (R.reinput (List.ofFn ρ) (by simpa [attemptBitBudget] using hbudget)).I
        k cap ↔
    (FlatTraceLaw.flatBitsEquiv _).symm
      ⟨List.ofFn υ, by simp [ReadyInput.reinput_bits]⟩ ∈
      sourceInitialBadFiber
        (R.reinput (List.ofFn τ) (by simpa [attemptBitBudget] using hbudget)).I
        k cap := by
  simp only [sourceInitialBadFiber, Finset.mem_biUnion,
    sourceInitialOutcomeFiber, Finset.mem_filter, Finset.mem_univ, true_and]
  have hflatρ : FlatTraceLaw.flatBits
      ((FlatTraceLaw.flatBitsEquiv
        (R.reinput (List.ofFn ρ) (by simpa [attemptBitBudget] using hbudget)).I.bits.length).symm
        ⟨List.ofFn υ, by simp [ReadyInput.reinput_bits]⟩) = List.ofFn υ :=
    congrArg Subtype.val ((FlatTraceLaw.flatBitsEquiv
      (R.reinput (List.ofFn ρ) (by simpa [attemptBitBudget] using hbudget)).I.bits.length).apply_symm_apply
      ⟨List.ofFn υ, by simp [ReadyInput.reinput_bits]⟩)
  have hflatτ : FlatTraceLaw.flatBits
      ((FlatTraceLaw.flatBitsEquiv
        (R.reinput (List.ofFn τ) (by simpa [attemptBitBudget] using hbudget)).I.bits.length).symm
        ⟨List.ofFn υ, by simp [ReadyInput.reinput_bits]⟩) = List.ofFn υ :=
    congrArg Subtype.val ((FlatTraceLaw.flatBitsEquiv
      (R.reinput (List.ofFn τ) (by simpa [attemptBitBudget] using hbudget)).I.bits.length).apply_symm_apply
      ⟨List.ofFn υ, by simp [ReadyInput.reinput_bits]⟩)
  rw [hflatρ, hflatτ]
  simp only [ReadyInput.reinput, InitialFlatLaw.reinputInitialAttempt]
  constructor
  · rintro ⟨ω, hbad, ⟨w⟩⟩
    refine ⟨ω, hbad, ⟨?_⟩⟩
    exact { w with }
  · rintro ⟨ω, hbad, ⟨w⟩⟩
    refine ⟨ω, hbad, ⟨?_⟩⟩
    exact { w with }

/-- Every actual source continuation belongs to the single-attempt bad
fiber; capped draw or representative failures are excluded. -/
lemma readyAttemptRejected_badFiber
    {B n m domainCap r t bufferCap targetCap Q k cap N : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (hbudget : attemptBitBudget n m r t ≤ N)
    (ρ : FlatTraceLaw.FlatTape N)
    (hreject : readyAttemptRejected R hbudget ρ) :
    (FlatTraceLaw.flatBitsEquiv _).symm
      ⟨List.ofFn ρ, by simp [ReadyInput.reinput_bits]⟩ ∈
      sourceInitialBadFiber
        (R.reinput (List.ofFn ρ) (by simpa [attemptBitBudget] using hbudget)).I
        k cap := by
  let J := R.reinput (List.ofFn ρ) (by simpa [attemptBitBudget] using hbudget)
  obtain ⟨σr, qr, hrunr, hrbatch, hrrep, hraccept⟩ := hreject
  obtain ⟨σsel, σa, tape, tail, values, used, drawFailed, stageCost,
    hbits, htrace, hselRun, hfull, hbatch, hinpSel, houtSel,
    hoff, htgt, hactiveA, hactiveB, hn, hqpow,
    hdrawFailure, hdrawSuccess⟩ :=
    fullInitialAttempt_run_bits J.I J.hactiveA J.hdegree J.hinter
      J.hneighbors J.hexceptionFlags J.hexceptionList J.hnearBound
      J.hexceptionCap J.hnB J.hkB J.hcapB
  have heq : σr = σa := by
    obtain ⟨_, _, ha⟩ := hrunr
    obtain ⟨_, _, hb⟩ := hfull
    exact (BigStep.unique ha.bigStep hb.bigStep).1
  have hbatch0 : σa.vars "batchFailed" = 0 := by simpa [heq] using hrbatch
  have hrep0 : σa.vars "repFailed" = 0 := by simpa [heq] using hrrep
  have haccept0 : σa.vars "attemptAccepted" = 0 := by simpa [heq] using hraccept
  have hdrawOK : drawFailed = false := by
    cases drawFailed with
    | false => rfl
    | true => simp [hbatch] at hbatch0
  obtain ⟨W, repFailed, repUsed, hW, hWA, hvaluesLen,
    hrepLe, hrepVal, hinp, hrepFailure, hrepSuccess⟩ := hdrawSuccess hdrawOK
  have hrepOK : repFailed = false := by
    cases repFailed with
    | false => rfl
    | true =>
        obtain ⟨hselEq, _, _, _⟩ := hrepFailure rfl
        simp [hselEq, hrepVal] at hrep0
  obtain ⟨mapped, choice, packedExceptions, packedSample,
    hmappedSel, hdraws, hchoiceSample, hchoiceRep,
    hacceptRun, hExceptionsEq, hflags, hlist, hprefixE,
    hcountE, hacceptBit, hsampleFlags, hord, hprefixW,
    hcountW, hrepFinal, hactiveBFinal, hinpFinal⟩ := hrepSuccess hrepOK
  have hbatchSel : σsel.vars "batchFailed" = 0 := by
    calc
      _ = σa.vars "batchFailed" := (hacceptRun.frame_var "batchFailed" (by decide)).symm
      _ = 0 := hbatch0
  have hrepSel : σsel.vars "repFailed" = 0 := by simpa [hrepOK] using hrepVal
  have hbad : cap < (choice.exceptions k).card := by
    by_contra h
    have hpass : (choice.exceptions k).card ≤ cap := Nat.le_of_not_gt h
    simp [hpass] at hacceptBit
    omega
  simpa [J, ReadyInput.reinput_bits] using
    initialSamplerAttempt_run_badFiber J.I σsel _ k cap choice mapped
      hselRun hbatchSel hrepSel hmappedSel hchoiceRep hbad

/-- Finite event for an actual source attempt that continues retrying. -/
noncomputable def readyAttemptRejectedFiber
    {B n m domainCap r t bufferCap targetCap Q k cap N : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (hbudget : attemptBitBudget n m r t ≤ N) :
    Finset (FlatTraceLaw.FlatTape N) := by
  classical
  exact Finset.univ.filter (readyAttemptRejected R hbudget)

/-- The actual continuation event is at most half of all finite source
tapes, including the selector-failure tapes in the denominator. -/
lemma readyAttemptRejected_half
    {B n m domainCap r t bufferCap targetCap Q k cap N : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (hbudget : attemptBitBudget n m r t ≤ N)
    (hmass : SamplerWeightedRetries.badMass
      (SamplerInitialRetries.outcomeWeight A
        (activeVertices n R.I.activeB)
        (fun b => numericNeighborhood G b ∩ A) r)
      (SamplerInitialRetries.outcomeBad A
        (activeVertices n R.I.activeB)
        (fun b => numericNeighborhood G b ∩ A) r k cap) ≤ (1 / 2 : ℚ)) :
    2 * (readyAttemptRejectedFiber R hbudget).card ≤ 2 ^ N := by
  classical
  let anchor : FlatTraceLaw.FlatTape N := fun _ => false
  let J := R.reinput (List.ofFn anchor) (by simpa [attemptBitBudget] using hbudget)
  let f : FlatTraceLaw.FlatTape N → FlatTraceLaw.FlatTape J.I.bits.length :=
    fun ρ => (FlatTraceLaw.flatBitsEquiv _).symm
      ⟨List.ofFn ρ, by simp [J, ReadyInput.reinput_bits]⟩
  let E : Finset (FlatTraceLaw.FlatTape N) :=
    readyAttemptRejectedFiber R hbudget
  have hmaps : ∀ ρ ∈ E, f ρ ∈ sourceInitialBadFiber J.I k cap := by
    intro ρ hρ
    have hreject : readyAttemptRejected R hbudget ρ :=
      by simpa [E, readyAttemptRejectedFiber] using hρ
    have hbad := readyAttemptRejected_badFiber R hbudget ρ hreject
    exact (readyBadFiber_reinput_eq R hbudget ρ anchor ρ).mp hbad
  have hinj : ∀ ρ ∈ E, ∀ τ ∈ E, f ρ = f τ → ρ = τ := by
    intro ρ _ τ _ heq
    have hbits : List.ofFn ρ = List.ofFn τ := by
      have h := congrArg FlatTraceLaw.flatBits heq
      have hρ : FlatTraceLaw.flatBits (f ρ) = List.ofFn ρ := by
        exact congrArg Subtype.val ((FlatTraceLaw.flatBitsEquiv _).apply_symm_apply
          ⟨List.ofFn ρ, by simp [J, ReadyInput.reinput_bits]⟩)
      have hτ : FlatTraceLaw.flatBits (f τ) = List.ofFn τ := by
        exact congrArg Subtype.val ((FlatTraceLaw.flatBitsEquiv _).apply_symm_apply
          ⟨List.ofFn τ, by simp [J, ReadyInput.reinput_bits]⟩)
      simpa [hρ, hτ] using h
    exact List.ofFn_injective hbits
  have hcard : E.card ≤ (sourceInitialBadFiber J.I k cap).card :=
    Finset.card_le_card_of_injOn f hmaps hinj
  have hhalf : 2 * (sourceInitialBadFiber J.I k cap).card ≤
      2 ^ J.I.bits.length :=
    sourceInitialBadFiber_half J.I k cap (by exact hmass)
  have hlen : J.I.bits.length = N := by simp [J, ReadyInput.reinput_bits]
  have htotal := (Nat.mul_le_mul_left 2 hcard).trans hhalf
  simpa [E, hlen] using htotal

private lemma eq_zero_eval {B : ℕ} {σ : Env} {v : String} {z : ℕ}
    (hz : σ.vars v = z) (hzB : z < B) (hzero : 0 < B) :
    (Cond.eq (.var v) (.lit 0)).evalB B σ = some (z == 0) := by
  have hvar : (Expr.var v).evalB B σ = some z := by
    rw [evalB_var_iff]
    exact ⟨hz.symm, by rw [hz]; exact hzB⟩
  have hlit : (Expr.lit 0).evalB B σ = some 0 := evalB_lit hzero
  rw [evalB_condEq hvar hlit]

private lemma eq_one_eval {B : ℕ} {σ : Env} {v : String} {z : ℕ}
    (hz : σ.vars v = z) (hzB : z < B) (hone : 1 < B) :
    (Cond.eq (.var v) (.lit 1)).evalB B σ = some (z == 1) := by
  have hvar : (Expr.var v).evalB B σ = some z := by
    rw [evalB_var_iff]
    exact ⟨hz.symm, by rw [hz]; exact hzB⟩
  have hlit : (Expr.lit 1).evalB B σ = some 1 := evalB_lit hone
  rw [evalB_condEq hvar hlit]

/-- The exhaustion branch does not touch the random input or any scratch
array.  It is used even when no complete attempt budget remains. -/
private lemma empty_loop_run {B : ℕ} {σ : Env}
    (hstatus : σ.vars "initialRetryStatus" = 0)
    (hleft : σ.vars "initialRetriesLeft" = 0)
    (h3B : 3 < B) :
    Run B (.while (.eq (.var "initialRetryStatus") (.lit 0))
      initialRetryBody) σ (σ.setVar "initialRetryStatus" 3) 14 := by
  have hzeroB : 0 < B := by omega
  have hguard : (Cond.eq (.var "initialRetryStatus") (.lit 0)).evalB B σ =
      some true := by simpa using eq_zero_eval hstatus hzeroB hzeroB
  have hleftGuard : (Cond.eq (.var "initialRetriesLeft") (.lit 0)).evalB B σ =
      some true := by simpa using eq_zero_eval hleft hzeroB hzeroB
  have hassign : Run B (.assign "initialRetryStatus" (.lit 3)) σ
      (σ.setVar "initialRetryStatus" 3) 2 := by
    simpa using (Run.assign (x := "initialRetryStatus") (evalB_lit h3B))
  have hbody : Run B initialRetryBody σ
      (σ.setVar "initialRetryStatus" 3) 6 := by
    simpa [initialRetryBody, Cond.size, Expr.size] using
      (Run.ite_true (d := fullInitialAttempt.seq _)
        hleftGuard hassign)
  have hstop : (Cond.eq (.var "initialRetryStatus") (.lit 0)).evalB B
      (σ.setVar "initialRetryStatus" 3) = some false := by
    simpa using eq_zero_eval (σ := σ.setVar "initialRetryStatus" 3)
      (v := "initialRetryStatus") (z := 3) (by simp) h3B hzeroB
  have htail : Run B (.while (.eq (.var "initialRetryStatus") (.lit 0))
      initialRetryBody) (σ.setVar "initialRetryStatus" 3)
      (σ.setVar "initialRetryStatus" 3) 4 := by
    simpa [Cond.size, Expr.size] using
      (Run.while_false (c := initialRetryBody) hstop)
  have hwhole := runWhileTrue hguard hbody htail
  exact hwhole.mono (by simp [Cond.size, Expr.size])

/-- Exact executions with no attempts left pay only the exhaustion step. -/
lemma retryWhile_zero_cost {B : ℕ} {σ τ : Env} {cost : ℕ}
    (hstatus : σ.vars "initialRetryStatus" = 0)
    (hleft : σ.vars "initialRetriesLeft" = 0)
    (h3B : 3 < B)
    (hrun : BigStepB B
      (.while (.eq (.var "initialRetryStatus") (.lit 0)) initialRetryBody)
      σ τ cost) : cost ≤ 14 := by
  obtain ⟨_, hbound, hcanon⟩ := empty_loop_run hstatus hleft h3B
  have heq := BigStep.unique hrun.bigStep hcanon.bigStep
  omega

/-- A finished retry loop has the fixed cost of its final false guard. -/
lemma retryWhile_stopped_cost {B : ℕ} {σ τ : Env} {cost status : ℕ}
    (hstatus : σ.vars "initialRetryStatus" = status)
    (hstatusB : status < B) (hnotzero : status ≠ 0)
    (hrun : BigStepB B
      (.while (.eq (.var "initialRetryStatus") (.lit 0)) initialRetryBody)
      σ τ cost) : cost = 4 := by
  have hvar : (Expr.var "initialRetryStatus").evalB B σ = some status := by
    rw [evalB_var_iff]
    exact ⟨hstatus.symm, by rw [hstatus]; exact hstatusB⟩
  have hlit : (Expr.lit 0).evalB B σ = some 0 := evalB_lit (by omega)
  have hfalse : (Cond.eq (.var "initialRetryStatus") (.lit 0)).evalB B σ =
      some false := by rw [evalB_condEq hvar hlit]; simp [hnotzero]
  have hcanon : BigStepB B
      (.while (.eq (.var "initialRetryStatus") (.lit 0)) initialRetryBody)
      σ σ 4 := by
    simpa [Cond.size, Expr.size] using
      (BigStepB.while_false (c := initialRetryBody) hfalse)
  have heq := BigStep.unique hrun.bigStep hcanon.bigStep
  exact heq.2

lemma retryWhile_nonzero_cost {B : ℕ} {σ τ : Env} {cost : ℕ}
    (hnotzero : σ.vars "initialRetryStatus" ≠ 0)
    (hrun : BigStepB B
      (.while (.eq (.var "initialRetryStatus") (.lit 0)) initialRetryBody)
      σ τ cost) : cost = 4 := by
  cases hrun with
  | while_false _ => rfl
  | while_true hguard _ _ =>
      obtain ⟨a, c, ha, hc, hbool⟩ := evalB_condEq_iff.mp hguard
      obtain ⟨rfl, _⟩ := evalB_var_iff.mp ha
      obtain ⟨rfl, _⟩ := evalB_lit_iff.mp hc
      simp at hbool
      exact False.elim (hnotzero hbool)

private lemma retry_body_attempt {B fuel q p : ℕ} {σ σa τ : Env}
    (hleft : σ.vars "initialRetriesLeft" = fuel + 1)
    (hfuelB : fuel + 1 < B) (hzeroB : 0 < B)
    (hfull : Run B fullInitialAttempt σ σa q)
    (hdecision : Run B initialRetryDecision σa τ p) :
    Run B initialRetryBody σ τ (q + p + 4) := by
  have hguard : (Cond.eq (.var "initialRetriesLeft") (.lit 0)).evalB B σ =
      some false := by
    simpa using eq_zero_eval hleft hfuelB hzeroB
  have hseq : Run B (fullInitialAttempt.seq initialRetryDecision) σ τ (q + p) :=
    hfull.seq hdecision
  exact (Run.ite_false hguard hseq).mono (by
    simp [Cond.size, Expr.size]; omega)

private lemma retry_stop {B : ℕ} {σ : Env} {z : ℕ}
    (hstatus : σ.vars "initialRetryStatus" = z)
    (hzB : z < B) (hzeroB : 0 < B) (hne : z ≠ 0) :
    Run B (.while (.eq (.var "initialRetryStatus") (.lit 0))
      initialRetryBody) σ σ 4 := by
  have hguard : (Cond.eq (.var "initialRetryStatus") (.lit 0)).evalB B σ =
      some false := by
    simpa [hne] using eq_zero_eval hstatus hzB hzeroB
  simpa [Cond.size, Expr.size] using
    (Run.while_false (c := initialRetryBody) hguard)

private lemma decrement_run {B fuel : ℕ} {σ : Env}
    (hleft : σ.vars "initialRetriesLeft" = fuel + 1)
    (hfuelB : fuel + 1 < B) (honeB : 1 < B) :
    Run B (.assign "initialRetriesLeft"
      (.sub (.var "initialRetriesLeft") (.lit 1)))
      σ (σ.setVar "initialRetriesLeft" fuel) 4 := by
  have hvar : (Expr.var "initialRetriesLeft").evalB B σ = some (fuel + 1) := by
    rw [evalB_var_iff]
    exact ⟨hleft.symm, by rw [hleft]; exact hfuelB⟩
  have hsub : (Expr.sub (.var "initialRetriesLeft") (.lit 1)).evalB B σ =
      some fuel := by
    simpa [Bop.apply] using
      (evalB_bin (op := .sub) hvar (evalB_lit honeB) (by omega : fuel < B))
  simpa using (Run.assign (x := "initialRetriesLeft") hsub)

/-- A concrete ordered prefix of ordinary rejected source attempts. Each
step records its actual full-attempt Run, exact input consumption, and the
flat-tape rejection fiber proved from its selected representative array.
The recursive constructor follows the actual retry decision state. -/
inductive SourceRejectionTrace
    {B n m domainCap r t bufferCap targetCap Q k cap : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ} :
    ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A →
      List (ℕ × ℕ) → Prop where
  | nil (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A) :
      SourceRejectionTrace R []
  | last (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
      (σa : Env) (q d : ℕ)
      (hrun : Run B fullInitialAttempt R.I.σ σa q)
      (hinp : σa.inp = (R.I.bits.drop d).map Bool.toNat ++ R.I.rest)
      (hbound : d ≤ attemptBitBudget n m r t)
      (hbatch : σa.vars "batchFailed" = 0)
      (hrep : σa.vars "repFailed" = 0)
      (haccept : σa.vars "attemptAccepted" = 0)
      (hbad : (FlatTraceLaw.flatBitsEquiv R.I.bits.length).symm
        ⟨R.I.bits, rfl⟩ ∈ sourceInitialBadFiber R.I k cap)
      (hstopped : ∃ ω : SamplerInitialRetries.InitialOutcome A
          (activeVertices n R.I.activeB)
          (fun b => numericNeighborhood G b ∩ A) r,
        SamplerInitialRetries.outcomeBad A (activeVertices n R.I.activeB)
          (fun b => numericNeighborhood G b ∩ A) r k cap ω = true ∧
        ∃ w : SourceInitialOutcomeWitness R.I R.I.bits ω,
          d = w.used * Nat.clog 2 m + w.repUsed) :
      SourceRejectionTrace R [(q, d)]
  | step
      (R J : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
      (σa : Env) (q d p : ℕ) (rest : List (ℕ × ℕ))
      (hrun : Run B fullInitialAttempt R.I.σ σa q)
      (hinp : σa.inp = (R.I.bits.drop d).map Bool.toNat ++ R.I.rest)
      (hbound : d ≤ attemptBitBudget n m r t)
      (hbatch : σa.vars "batchFailed" = 0)
      (hrep : σa.vars "repFailed" = 0)
      (haccept : σa.vars "attemptAccepted" = 0)
      (hbad : (FlatTraceLaw.flatBitsEquiv R.I.bits.length).symm
        ⟨R.I.bits, rfl⟩ ∈ sourceInitialBadFiber R.I k cap)
      (hstopped : ∃ ω : SamplerInitialRetries.InitialOutcome A
          (activeVertices n R.I.activeB)
          (fun b => numericNeighborhood G b ∩ A) r,
        SamplerInitialRetries.outcomeBad A (activeVertices n R.I.activeB)
          (fun b => numericNeighborhood G b ∩ A) r k cap ω = true ∧
        ∃ w : SourceInitialOutcomeWitness R.I R.I.bits ω,
          d = w.used * Nat.clog 2 m + w.repUsed)
      (hdecision : Run B initialRetryDecision σa J.I.σ p)
      (hbits : J.I.bits = R.I.bits.drop d)
      (htail : SourceRejectionTrace J rest) :
      SourceRejectionTrace R ((q, d) :: rest)

lemma SourceRejectionTrace.head_rejected
    {B n m domainCap r t bufferCap targetCap Q k cap : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    {R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A}
    {q d : ℕ} {rest : List (ℕ × ℕ)}
    (htrace : SourceRejectionTrace R ((q, d) :: rest)) :
    ∃ σa : Env, Run B fullInitialAttempt R.I.σ σa q ∧
      σa.vars "batchFailed" = 0 ∧ σa.vars "repFailed" = 0 ∧
      σa.vars "attemptAccepted" = 0 ∧
      σa.inp = (R.I.bits.drop d).map Bool.toNat ++ R.I.rest ∧
      d ≤ attemptBitBudget n m r t := by
  cases htrace with
  | last R σa q d hrun hinp hbound hbatch hrep haccept hbad hstopped =>
      exact ⟨σa, hrun, hbatch, hrep, haccept, hinp, hbound⟩
  | step R J σa q d p rest hrun hinp hbound hbatch hrep haccept hbad hstopped
        hdecision hbits htail =>
      exact ⟨σa, hrun, hbatch, hrep, haccept, hinp, hbound⟩

/-- The bit count stored in a rejected source step is the canonical
stopping time of the actual full-attempt Run. -/
lemma SourceRejectionTrace.head_canonical
    {B n m domainCap r t bufferCap targetCap Q k cap : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    {R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A}
    {q d : ℕ} {rest : List (ℕ × ℕ)}
    (htrace : SourceRejectionTrace R ((q, d) :: rest)) :
    let ρ := (FlatTraceLaw.flatBitsEquiv R.I.bits.length).symm ⟨R.I.bits, rfl⟩
    d = readyAttemptConsumed R (by simpa [attemptBitBudget] using R.I.hbudget) ρ ∧
      readyAttemptRejected R (by simpa [attemptBitBudget] using R.I.hbudget) ρ := by
  let ρ := (FlatTraceLaw.flatBitsEquiv R.I.bits.length).symm ⟨R.I.bits, rfl⟩
  have hbits : List.ofFn ρ = R.I.bits :=
    congrArg Subtype.val
      ((FlatTraceLaw.flatBitsEquiv R.I.bits.length).apply_symm_apply
        ⟨R.I.bits, rfl⟩)
  have hbudget : attemptBitBudget n m r t ≤ R.I.bits.length := by
    simpa [attemptBitBudget] using R.I.hbudget
  obtain ⟨σa, hrun, hbatch, hrep, haccept, hinp, hd⟩ :=
    htrace.head_rejected
  obtain ⟨σb, qb, hrunb, hinpb, hdb⟩ := readyAttemptConsumed_spec R hbudget ρ
  have hrun' : Run B fullInitialAttempt
      (R.reinput (List.ofFn ρ) (by simpa [attemptBitBudget] using hbudget)).I.σ
      σa q := by
    simpa [hbits, ReadyInput.reinput_self_state] using hrun
  have hsame := readyAttempt_same_prefix R (List.ofFn ρ) (List.ofFn ρ)
    (by simpa using hbudget) (by simpa using hbudget)
    hrun' hrunb (by simpa [hbits] using hinp) hinpb hd hdb rfl
  constructor
  · exact hsame.1.symm
  · exact ⟨σa, q, hrun', hbatch, hrep, haccept⟩

/-- A rejected-prefix certificate indexed only by the actual machine
environment. This removes proof-side array representation choices from the
tail event used in stopped-prefix averaging. -/
inductive RawRejected {B : ℕ} : Env → ℕ → Prop where
  | zero (σ : Env) : RawRejected σ 0
  | final (σ σa : Env) (q : ℕ)
      (hrun : Run B fullInitialAttempt σ σa q)
      (hbatch : σa.vars "batchFailed" = 0)
      (hrep : σa.vars "repFailed" = 0)
      (haccept : σa.vars "attemptAccepted" = 0) :
      RawRejected σ 1
  | step (σ σa τ : Env) (q p k : ℕ)
      (hrun : Run B fullInitialAttempt σ σa q)
      (hbatch : σa.vars "batchFailed" = 0)
      (hrep : σa.vars "repFailed" = 0)
      (haccept : σa.vars "attemptAccepted" = 0)
      (hdecision : Run B initialRetryDecision σa τ p)
      (htail : RawRejected (B := B) τ k) :
      RawRejected σ (k + 1)

lemma SourceRejectionTrace.raw
    {B n m domainCap r t bufferCap targetCap Q k cap : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    {R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A}
    {rejects : List (ℕ × ℕ)}
    (htrace : SourceRejectionTrace R rejects) :
    RawRejected (B := B) R.I.σ rejects.length := by
  induction htrace with
  | nil R => exact RawRejected.zero R.I.σ
  | last R σa q d hrun hinp hbound hbatch hrep haccept hbad hstopped =>
      exact RawRejected.final R.I.σ σa q hrun hbatch hrep haccept
  | step R J σa q d p rest hrun hinp hbound hbatch hrep haccept hbad hstopped
        hdecision hbits htail ih =>
      simpa [List.length_cons, Nat.add_comm] using
        RawRejected.step R.I.σ σa J.I.σ q p rest.length hrun hbatch
          hrep haccept hdecision ih

lemma RawRejected.head
    {B : ℕ} {σ : Env} {j : ℕ}
    (h : RawRejected (B := B) σ (j + 1)) :
    ∃ σa q, Run B fullInitialAttempt σ σa q ∧
      σa.vars "batchFailed" = 0 ∧ σa.vars "repFailed" = 0 ∧
      σa.vars "attemptAccepted" = 0 := by
  cases h with
  | final σ σa q hrun hbatch hrep haccept =>
      exact ⟨σa, q, hrun, hbatch, hrep, haccept⟩
  | step σ σa τ q p k hrun hbatch hrep haccept hdecision htail =>
      exact ⟨σa, q, hrun, hbatch, hrep, haccept⟩

lemma RawRejected.tail_of_succ
    {B : ℕ} {σ : Env} {j : ℕ}
    (h : RawRejected (B := B) σ (j + 2)) :
    ∃ σa τ q p, Run B fullInitialAttempt σ σa q ∧
      σa.vars "batchFailed" = 0 ∧ σa.vars "repFailed" = 0 ∧
      σa.vars "attemptAccepted" = 0 ∧
      Run B initialRetryDecision σa τ p ∧ RawRejected (B := B) τ (j + 1) := by
  cases h with
  | step σ σa τ q p k hrun hbatch hrep haccept hdecision htail =>
      exact ⟨σa, τ, q, p, hrun, hbatch, hrep, haccept, hdecision, htail⟩

/-- After an actual ordinary rejection, the source decision has a canonical
ready successor. Its unread bits are exactly the suffix of the original
flat tape. -/
lemma rejected_next_ready
    {B n m domainCap r t bufferCap targetCap Q k cap : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (fuel : ℕ)
    (hpositive : 1 ≤ fuel)
    (hsavedM : R.I.σ.vars "initialDomainSize" = m)
    (hsavedR : R.I.σ.vars "initialBatchTarget" = r)
    (hleft : R.I.σ.vars "initialRetriesLeft" = fuel + 1)
    (hstatus : R.I.σ.vars "initialRetryStatus" = 0)
    (hfuelB : fuel + 1 < B)
    (hbudget : (fuel + 1) * attemptBitBudget n m r t ≤ R.I.bits.length)
    {σa : Env} {q : ℕ}
    (hrun : Run B fullInitialAttempt R.I.σ σa q)
    (hbatch0 : σa.vars "batchFailed" = 0)
    (hrep0 : σa.vars "repFailed" = 0)
    (haccept0 : σa.vars "attemptAccepted" = 0) :
    ∃ (d : ℕ) (J : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
      (p : ℕ),
      d ≤ attemptBitBudget n m r t ∧
      σa.inp = (R.I.bits.drop d).map Bool.toNat ++ R.I.rest ∧
      J.I.bits = R.I.bits.drop d ∧ J.I.rest = R.I.rest ∧
      J.I.activeB = R.I.activeB ∧
      Run B initialRetryDecision σa J.I.σ p ∧
      J.I.σ.vars "initialDomainSize" = m ∧
      J.I.σ.vars "initialBatchTarget" = r ∧
      J.I.σ.vars "initialRetriesLeft" = fuel ∧
      J.I.σ.vars "initialRetryStatus" = 0 ∧
      fuel * attemptBitBudget n m r t ≤ J.I.bits.length := by
  have hper : attemptBitBudget n m r t ≤ R.I.bits.length := by
    have hmul : attemptBitBudget n m r t ≤
        (fuel + 1) * attemptBitBudget n m r t := by
      nlinarith [Nat.zero_le (fuel * attemptBitBudget n m r t)]
    exact hmul.trans hbudget
  obtain ⟨d, σb, qb, hrunb, hinpb, hd⟩ :=
    readyAttempt_run_consumed R R.I.bits hper
  have hrunb' : Run B fullInitialAttempt R.I.σ σb qb := by
    simpa [ReadyInput.reinput_self_state] using hrunb
  have heq : σb = σa := by
    obtain ⟨_, _, ha⟩ := hrunb'
    obtain ⟨_, _, hb⟩ := hrun
    exact (BigStep.unique ha.bigStep hb.bigStep).1
  have hinp : σa.inp = (R.I.bits.drop d).map Bool.toNat ++ R.I.rest := by
    simpa [heq] using hinpb
  obtain ⟨σsel, σc, tape, tail, values, used, drawFailed, stageCost,
    hbits, htrace, hselRun, hfull, hbatch, hinpSel, houtSel,
    hoff, htgt, hactiveA, hactiveB, hn, hqpow,
    hdrawFailure, hdrawSuccess⟩ :=
    fullInitialAttempt_run_bits R.I R.hactiveA R.hdegree R.hinter
      R.hneighbors R.hexceptionFlags R.hexceptionList R.hnearBound
      R.hexceptionCap R.hnB R.hkB R.hcapB
  have heqc : σc = σa := by
    obtain ⟨_, _, ha⟩ := hfull
    obtain ⟨_, _, hb⟩ := hrun
    exact (BigStep.unique ha.bigStep hb.bigStep).1
  have hnextBudget : fuel * attemptBitBudget n m r t ≤
      (R.I.bits.drop d).length := drop_budget hbudget hd
  obtain ⟨S, _hrestoreS, hSstate, hSbits, hSrest, hSactive⟩ :=
    ready_after_rejection R hrun (by simpa [heqc] using hn)
      (by simpa [heqc] using hqpow) (by simpa [heqc] using hoff)
      (by simpa [heqc] using htgt) (by simpa [heqc] using hactiveA)
      (by simpa [heqc] using hactiveB) hinp (by
        have hperNext : attemptBitBudget n m r t ≤
            fuel * attemptBitBudget n m r t := by
          simpa using Nat.mul_le_mul_right
            (attemptBitBudget n m r t) hpositive
        exact hperNext.trans hnextBudget)
  let J := S.withRetriesLeft fuel
  let τ := (σa.setVar "drawModulus" m).setVar "batchTarget" r
  let υ := τ.setVar "initialRetriesLeft" fuel
  have hleftA : σa.vars "initialRetriesLeft" = fuel + 1 := by
    rw [hrun.frame_var "initialRetriesLeft" (by decide)]
    exact hleft
  have hsavedMA : σa.vars "initialDomainSize" = m := by
    rw [hrun.frame_var "initialDomainSize" (by decide)]
    exact hsavedM
  have hsavedRA : σa.vars "initialBatchTarget" = r := by
    rw [hrun.frame_var "initialBatchTarget" (by decide)]
    exact hsavedR
  have hstatusA : σa.vars "initialRetryStatus" = 0 := by
    rw [hrun.frame_var "initialRetryStatus" (by decide)]
    exact hstatus
  have hrestore : Run B restoreInitialDomainRuntime σa τ 4 :=
    restore_runtime_run hsavedMA hsavedRA R.I.hmB R.I.hrB
  have hleftτ : τ.vars "initialRetriesLeft" = fuel + 1 := by
    simpa [τ] using hleftA
  have hdecrement : Run B (.assign "initialRetriesLeft"
      (.sub (.var "initialRetriesLeft") (.lit 1))) τ υ 4 :=
    decrement_run hleftτ hfuelB R.I.honeB
  have hrestoreDec : Run B
      (restoreInitialDomainRuntime.seq
        (.assign "initialRetriesLeft"
          (.sub (.var "initialRetriesLeft") (.lit 1)))) σa υ 8 :=
    hrestore.seq hdecrement
  have hzeroB : 0 < B := by omega
  have hbatchGuard : (Cond.eq (.var "batchFailed") (.lit 0)).evalB B σa =
      some true := by simpa using eq_zero_eval hbatch0 hzeroB hzeroB
  have hrepGuard : (Cond.eq (.var "repFailed") (.lit 0)).evalB B σa =
      some true := by simpa using eq_zero_eval hrep0 hzeroB hzeroB
  have hacceptGuard : (Cond.eq (.var "attemptAccepted") (.lit 1)).evalB B σa =
      some false := by simpa using eq_one_eval haccept0 hzeroB R.I.honeB
  have hinner : Run B
      (.ite (.eq (.var "attemptAccepted") (.lit 1))
        (.assign "initialRetryStatus" (.lit 1))
        (restoreInitialDomainRuntime.seq
          (.assign "initialRetriesLeft"
            (.sub (.var "initialRetriesLeft") (.lit 1))))) σa υ 12 := by
    simpa [Cond.size, Expr.size] using Run.ite_false hacceptGuard hrestoreDec
  have hrepBranch : Run B
      (.ite (.eq (.var "repFailed") (.lit 0))
        (.ite (.eq (.var "attemptAccepted") (.lit 1))
          (.assign "initialRetryStatus" (.lit 1))
          (restoreInitialDomainRuntime.seq
            (.assign "initialRetriesLeft"
              (.sub (.var "initialRetriesLeft") (.lit 1)))))
        (.assign "initialRetryStatus" (.lit 2))) σa υ 16 := by
    simpa [Cond.size, Expr.size] using
      (Run.ite_true (d := .assign "initialRetryStatus" (.lit 2))
        hrepGuard hinner)
  have hdecision : Run B initialRetryDecision σa υ 20 := by
    simpa [initialRetryDecision, Cond.size, Expr.size] using
      (Run.ite_true (d := .assign "initialRetryStatus" (.lit 2))
        hbatchGuard hrepBranch)
  have hJstate : J.I.σ = υ := by
    change S.I.σ.setVar "initialRetriesLeft" fuel = υ
    rw [hSstate]
  refine ⟨d, J, 20, hd, hinp, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · change S.I.bits = R.I.bits.drop d
    exact hSbits
  · change S.I.rest = R.I.rest
    exact hSrest
  · change S.I.activeB = R.I.activeB
    exact hSactive
  · simpa [hJstate] using hdecision
  · rw [hJstate]
    simpa [υ, τ] using hsavedMA
  · rw [hJstate]
    simpa [υ, τ] using hsavedRA
  · rw [hJstate]
    simp [υ]
  · rw [hJstate]
    simpa [υ, τ] using hstatusA
  · change fuel * attemptBitBudget n m r t ≤ S.I.bits.length
    rw [hSbits]
    exact hnextBudget

/-- Finite flat tapes on which the concrete source has an ordered prefix of
`j` ordinary rejected attempts. -/
noncomputable def rawRejectedFiber
    {B n m domainCap r t bufferCap targetCap Q k cap N : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (hbudget : attemptBitBudget n m r t ≤ N) (j : ℕ) :
    Finset (FlatTraceLaw.FlatTape N) := by
  classical
  exact Finset.univ.filter fun ρ =>
    RawRejected (B := B)
      (R.reinput (List.ofFn ρ) (by simpa [attemptBitBudget] using hbudget)).I.σ j

lemma rawRejectedFiber_one_half
    {B n m domainCap r t bufferCap targetCap Q k cap N : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (hbudget : attemptBitBudget n m r t ≤ N)
    (hmass : SamplerWeightedRetries.badMass
      (SamplerInitialRetries.outcomeWeight A
        (activeVertices n R.I.activeB)
        (fun b => numericNeighborhood G b ∩ A) r)
      (SamplerInitialRetries.outcomeBad A
        (activeVertices n R.I.activeB)
        (fun b => numericNeighborhood G b ∩ A) r k cap) ≤ (1 / 2 : ℚ)) :
    2 * (rawRejectedFiber R hbudget 1).card ≤ 2 ^ N := by
  classical
  have hsub : rawRejectedFiber R hbudget 1 ⊆
      readyAttemptRejectedFiber R hbudget := by
    intro ρ hρ
    have hraw : RawRejected (B := B)
        (R.reinput (List.ofFn ρ)
          (by simpa [attemptBitBudget] using hbudget)).I.σ 1 := by
      simpa [rawRejectedFiber] using hρ
    obtain ⟨σa, q, hrun, hbatch, hrep, haccept⟩ :=
      RawRejected.head (j := 0) hraw
    simpa [readyAttemptRejectedFiber, readyAttemptRejected] using
      (show readyAttemptRejected R hbudget ρ from
        ⟨σa, q, hrun, hbatch, hrep, haccept⟩)
  exact (Nat.mul_le_mul_left 2 (Finset.card_le_card hsub)).trans
    (readyAttemptRejected_half R hbudget hmass)

/-- A rejected trace on a different completion of the same consumed prefix
has its remaining rejected trace in the canonical post-decision state. -/
lemma RawRejected.tail_replay
    {B n m domainCap r t bufferCap targetCap Q k cap : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R J : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (bits bits' : List Bool)
    (hbudget : attemptBitBudget n m r t ≤ bits.length)
    (hbudget' : attemptBitBudget n m r t ≤ bits'.length)
    {σa : Env} {q d p j : ℕ}
    (hrun : Run B fullInitialAttempt
      (R.reinput bits (by simpa [attemptBitBudget] using hbudget)).I.σ σa q)
    (hinp : σa.inp = (bits.drop d).map Bool.toNat ++ R.I.rest)
    (hpre : bits.take d = bits'.take d)
    (hdecision : Run B initialRetryDecision σa J.I.σ p)
    (hJbits : J.I.bits = bits.drop d)
    (hnextBudget : attemptBitBudget n m r t ≤ (bits'.drop d).length)
    (hraw : RawRejected (B := B)
      (R.reinput bits' (by simpa [attemptBitBudget] using hbudget')).I.σ
      (j + 2)) :
    RawRejected (B := B)
      (J.reinput (bits'.drop d)
        (by simpa [attemptBitBudget] using hnextBudget)).I.σ (j + 1) := by
  obtain ⟨σb, τb, qb, pb, hrunb, _, _, _, hdecisionb, htail⟩ :=
    hraw.tail_of_succ
  obtain ⟨hrun', hdecision'⟩ :=
    rejected_step_replay R J bits bits' hbudget hbudget' hrun hinp
      hpre hdecision hJbits hnextBudget
  have heqA : σb = {σa with inp := (bits'.drop d).map Bool.toNat ++ R.I.rest} := by
    obtain ⟨_, _, ha⟩ := hrunb
    obtain ⟨_, _, hb⟩ := hrun'
    exact (BigStep.unique ha.bigStep hb.bigStep).1
  have heqJ : τb =
      (J.reinput (bits'.drop d)
        (by simpa [attemptBitBudget] using hnextBudget)).I.σ := by
    obtain ⟨_, _, ha⟩ := hdecisionb
    obtain ⟨_, _, hb⟩ := hdecision'
    exact (BigStep.unique (by simpa [heqA] using ha.bigStep) hb.bigStep).1
  simpa [heqJ] using htail

private lemma sum_indicator_const {α : Type} [Fintype α]
    (P : α → Prop) [DecidablePred P] (c : ℚ) :
    (∑ a : α, if P a then c else 0) =
      c * ((Finset.univ.filter P).card : ℚ) := by
  classical
  calc
    (∑ a : α, if P a then c else 0) =
        ∑ a ∈ Finset.univ.filter P, c := by rw [Finset.sum_filter]
    _ = c * ((Finset.univ.filter P).card : ℚ) := by simp [mul_comm]

/-- The actual sequential retry source has a geometric rejected-prefix
count, with each attempt beginning at the unread suffix of the previous
source Run. Selector aborts contribute no rejected continuation. -/
lemma rawRejectedFiber_geometric_of_left
    {B n m domainCap r t bufferCap targetCap Q k cap : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (active : ℕ → ℕ)
    (hmass : SamplerWeightedRetries.badMass
      (SamplerInitialRetries.outcomeWeight A
        (activeVertices n active)
        (fun b => numericNeighborhood G b ∩ A) r)
      (SamplerInitialRetries.outcomeBad A
        (activeVertices n active)
        (fun b => numericNeighborhood G b ∩ A) r k cap) ≤ (1 / 2 : ℚ)) :
    ∀ (fuel N left : ℕ)
      (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A),
      R.I.activeB = active →
      R.I.σ.vars "initialDomainSize" = m →
      R.I.σ.vars "initialBatchTarget" = r →
      R.I.σ.vars "initialRetriesLeft" = left →
      R.I.σ.vars "initialRetryStatus" = 0 →
      fuel + 1 ≤ left →
      left < B →
      left * attemptBitBudget n m r t ≤ N →
      (hperInput : attemptBitBudget n m r t ≤ N) →
      2 ^ (fuel + 1) *
        (rawRejectedFiber R hperInput (fuel + 1)).card ≤ 2 ^ N := by
  classical
  intro fuel
  induction fuel with
  | zero =>
      intro N left R hactive hsavedM hsavedR hleft hstatus hleftBound hB
        hbudget hperInput
      have hmassR : SamplerWeightedRetries.badMass
          (SamplerInitialRetries.outcomeWeight A
            (activeVertices n R.I.activeB)
            (fun b => numericNeighborhood G b ∩ A) r)
          (SamplerInitialRetries.outcomeBad A
            (activeVertices n R.I.activeB)
            (fun b => numericNeighborhood G b ∩ A) r k cap) ≤ (1 / 2 : ℚ) := by
        rw [hactive]
        exact hmass
      simpa using rawRejectedFiber_one_half R hperInput hmassR
  | succ fuel ih =>
      intro N left R hactive hsavedM hsavedR hleft hstatus hleftBound hB
        hbudget hperInput
      let per := attemptBitBudget n m r t
      have hper : per ≤ N := by simpa [per] using hperInput
      let used : FlatTraceLaw.FlatTape N → ℕ :=
        readyAttemptConsumed R (by simpa [per] using hper)
      let first : FlatTraceLaw.FlatTape N → Prop :=
        readyAttemptRejected R (by simpa [per] using hper)
      let many : FlatTraceLaw.FlatTape N → Prop := fun ρ =>
        RawRejected (B := B)
          (R.reinput (List.ofFn ρ)
            (by simpa [attemptBitBudget, per] using hper)).I.σ (fuel + 2)
      let X : FlatTraceLaw.FlatTape N → ℚ := fun ρ =>
        if many ρ then (2 ^ (fuel + 1) : ℚ) else 0
      let Y : FlatTraceLaw.FlatTape N → ℚ := fun ρ =>
        if first ρ then 1 else 0
      have husedBound : ∀ ρ, used ρ ≤ N := by
        intro ρ
        exact readyAttemptConsumed_le R (by simpa [per] using hper) ρ
      have husedCausal : ∀ ρ τ,
          (List.ofFn ρ).take (used ρ) =
            (List.ofFn τ).take (used ρ) → used τ = used ρ := by
        intro ρ τ hpre
        exact readyAttemptConsumed_causal R
          (by simpa [per] using hper) ρ τ hpre
      have hY : ∀ ρ τ,
          (List.ofFn ρ).take (used ρ) =
            (List.ofFn τ).take (used ρ) → Y τ = Y ρ := by
        intro ρ τ hpre
        by_cases hρ : first ρ
        · have hτ : first τ :=
            readyAttemptRejected_of_same_prefix R
              (by simpa [per] using hper) ρ τ hpre hρ
          simp [Y, hρ, hτ]
        · have hτ : ¬ first τ := by
            intro hτ
            have hu := husedCausal ρ τ hpre
            have hpre' : (List.ofFn τ).take (used τ) =
                (List.ofFn ρ).take (used τ) := by simpa [hu] using hpre.symm
            exact hρ (readyAttemptRejected_of_same_prefix R
              (by simpa [per] using hper) τ ρ hpre' hτ)
          simp [Y, hρ, hτ]
      have hmean : ∀ ρ, (∑ tail : FlatTraceLaw.FlatTape (N - used ρ),
          X ((splitEquiv (husedBound ρ)).symm
            ((splitEquiv (husedBound ρ) ρ).1, tail))) ≤
            Y ρ * 2 ^ (N - used ρ) := by
        intro ρ
        by_cases hfirst : first ρ
        · let bits := List.ofFn ρ
          let Rρ := R.reinput bits (by
            change attemptBitBudget n m r t ≤ bits.length
            simpa only [bits, List.length_ofFn, per] using hper)
          have hfirstProof : first ρ := hfirst
          obtain ⟨σa, q, hrun, hbatch, hrep, haccept⟩ := hfirst
          obtain ⟨d, J, p, hd, hinp, hJbits, hJrest, hJactive,
            hdecision, hJsavedM, hJsavedR, hJleft, hJstatus, hJbudget⟩ :=
            rejected_next_ready Rρ (left - 1) (by omega)
              (by change R.I.σ.vars "initialDomainSize" = m; exact hsavedM)
              (by change R.I.σ.vars "initialBatchTarget" = r; exact hsavedR)
              (by change R.I.σ.vars "initialRetriesLeft" = left - 1 + 1;
                  rw [hleft]; omega)
              (by change R.I.σ.vars "initialRetryStatus" = 0; exact hstatus)
              (by omega)
              (by change (left - 1 + 1) * per ≤ bits.length
                  have heq : left - 1 + 1 = left := by omega
                  rw [heq]
                  simpa only [bits, List.length_ofFn, per] using
                    hbudget)
              hrun hbatch hrep haccept
          have hused : d = used ρ := by
            change d = readyAttemptConsumed R hper ρ
            obtain ⟨σu, qu, hrunu, hinpu, hdu⟩ :=
              readyAttemptConsumed_spec R (by simpa [per] using hper) ρ
            have heq : σa = σu := by
              obtain ⟨_, _, ha⟩ := hrun
              obtain ⟨_, _, hb⟩ := hrunu
              exact (BigStep.unique ha.bigStep hb.bigStep).1
            change σa.inp = (bits.drop d).map Bool.toNat ++ R.I.rest at hinp
            have heqInp := hinp.symm.trans (by simpa [heq, bits] using hinpu)
            have hlen := congrArg List.length heqInp
            simp only [List.length_append, List.length_map, List.length_drop] at hlen
            have hdN : d ≤ N := hd.trans hper
            have huN : readyAttemptConsumed R hper ρ ≤ N :=
              readyAttemptConsumed_le R hper ρ
            have hbitsLen : bits.length = N := by simp [bits]
            simp only [List.length_ofFn] at hlen
            omega
          have htailN : J.I.bits.length = N - used ρ := by
            change J.I.bits.length = N - used ρ
            rw [hJbits]
            change (bits.drop d).length = N - used ρ
            simp only [List.length_drop, bits, List.length_ofFn, hused]
          have htailBudget : (left - 1) * per ≤ N - used ρ := by
            rw [htailN] at hJbudget
            exact hJbudget
          have hJactiveZero : J.I.activeB = active := by
            change J.I.activeB = R.I.activeB at hJactive
            exact hJactive.trans hactive
          have hperTail : per ≤ N - used ρ := by
            have hpos : 1 ≤ left - 1 := by omega
            have hmul := Nat.mul_le_mul_right per hpos
            have hle : per ≤ (left - 1) * per := by simpa using hmul
            exact hle.trans htailBudget
          have htailHalf := ih (N - used ρ) (left - 1) J hJactiveZero
            hJsavedM hJsavedR hJleft hJstatus (by omega) (by omega)
            (by simpa [per] using htailBudget)
            (by simpa [per] using hperTail)
          let E := rawRejectedFiber J (by simpa [per] using hperTail)
            (fuel + 1)
          have htailMem (tail : FlatTraceLaw.FlatTape (N - used ρ)) :
              many ((splitEquiv (husedBound ρ)).symm
                ((splitEquiv (husedBound ρ) ρ).1, tail)) →
                tail ∈ E := by
            intro hmany
            let τ := (splitEquiv (husedBound ρ)).symm
              ((splitEquiv (husedBound ρ) ρ).1, tail)
            have hsplit := StoppedPrefixAveraging.boolTape_split (husedBound ρ) τ
            have hpair : splitEquiv (husedBound ρ) τ =
                ((splitEquiv (husedBound ρ) ρ).1, tail) :=
              Equiv.apply_symm_apply _ _
            have hprefix : bits.take d = (List.ofFn τ).take d := by
              rw [hused]
              rw [StoppedPrefixAveraging.prefix_of_split (husedBound ρ),
                StoppedPrefixAveraging.prefix_of_split (husedBound ρ), hpair]
            have hdrop : (List.ofFn τ).drop d = List.ofFn tail := by
              rw [hused, hsplit, hpair]
              simp
            have hnextPer : per ≤ ((List.ofFn τ).drop d).length := by
              rw [hdrop]
              simpa only [List.length_ofFn] using hperTail
            have hrawTail := RawRejected.tail_replay R J bits (List.ofFn τ)
              (by simpa only [per, bits, List.length_ofFn] using hper)
              (by simpa only [per, List.length_ofFn] using hper)
              (by simpa only [bits] using hrun)
              (by change σa.inp = (bits.drop d).map Bool.toNat ++ R.I.rest;
                  exact hinp)
              hprefix hdecision (by change J.I.bits = bits.drop d; exact hJbits)
              (by simpa [per] using hnextPer) hmany
            simp only [E, rawRejectedFiber, Finset.mem_filter,
              Finset.mem_univ, true_and]
            simpa only [hdrop] using hrawTail
          have hsumX :
              (∑ tail : FlatTraceLaw.FlatTape (N - used ρ),
                X ((splitEquiv (husedBound ρ)).symm
                  ((splitEquiv (husedBound ρ) ρ).1,
                    tail))) ≤
                (2 ^ (fuel + 1) : ℚ) * (E.card : ℚ) := by
            calc
              _ ≤ ∑ tail : FlatTraceLaw.FlatTape (N - used ρ),
                  if tail ∈ E then (2 ^ (fuel + 1) : ℚ) else 0 := by
                    apply Finset.sum_le_sum
                    intro tail _
                    by_cases h : many
                        ((splitEquiv (husedBound ρ)).symm
                          ((splitEquiv (husedBound ρ) ρ).1,
                            tail))
                    · have hmem := htailMem tail h
                      simp [X, h, hmem]
                    · simp only [X, if_neg h]
                      by_cases hmem : tail ∈ E
                      · simp [hmem]
                      · simp [hmem]
              _ = _ := by
                rw [sum_indicator_const]
                simp [E]
          have hq : (2 ^ (fuel + 1) : ℚ) * (E.card : ℚ) ≤
              2 ^ (N - used ρ) := by
            exact_mod_cast (by simpa [E] using htailHalf)
          have hYρ : Y ρ = 1 := by simp [Y, hfirstProof]
          rw [hYρ, one_mul]
          exact hsumX.trans hq
        · have hzero : ∀ tail : FlatTraceLaw.FlatTape (N - used ρ),
              X ((splitEquiv (husedBound ρ)).symm
                ((splitEquiv (husedBound ρ) ρ).1,
                  tail)) = 0 := by
            intro tail
            let τ := (splitEquiv (husedBound ρ)).symm
              ((splitEquiv (husedBound ρ) ρ).1, tail)
            have hprefix : (List.ofFn ρ).take (used ρ) =
                (List.ofFn τ).take (used ρ) := by
              rw [StoppedPrefixAveraging.prefix_of_split (husedBound ρ),
                StoppedPrefixAveraging.prefix_of_split (husedBound ρ)]
              simp [τ]
            have hnot : ¬ many τ := by
              intro hmany
              obtain ⟨σa, q, hrun, hbatch, hrep, haccept⟩ :=
                RawRejected.head (j := fuel + 1) hmany
              have hrejτ : first τ := ⟨σa, q, hrun, hbatch, hrep, haccept⟩
              have husedτ := husedCausal ρ τ hprefix
              have hprefix' : (List.ofFn τ).take (used τ) =
                  (List.ofFn ρ).take (used τ) := by
                simpa [husedτ] using hprefix.symm
              exact hfirst (readyAttemptRejected_of_same_prefix R
                (by simpa [per] using hper) τ ρ hprefix' hrejτ)
            change X τ = 0
            simp [X, hnot]
          simp [hzero, Y, hfirst]
      have havg := StoppedPrefixAveraging.sum_le_of_stopped_prefix used
        husedBound husedCausal X Y hY hmean
      have hsumX : (∑ ρ : FlatTraceLaw.FlatTape N, X ρ) =
          (2 ^ (fuel + 1) : ℚ) *
            ((rawRejectedFiber R (by simpa [per] using hper)
              (fuel + 2)).card : ℚ) := by
        have hh := sum_indicator_const many (2 ^ (fuel + 1) : ℚ)
        have hE : rawRejectedFiber R (by simpa [per] using hper)
            (fuel + 2) = Finset.univ.filter many := rfl
        rw [hE]
        exact hh
      have hsumY : (∑ ρ : FlatTraceLaw.FlatTape N, Y ρ) =
          ((readyAttemptRejectedFiber R
            (by simpa [per] using hper)).card : ℚ) := by
        have hh := sum_indicator_const first 1
        have hE : readyAttemptRejectedFiber R
            (by simpa [per] using hper) = Finset.univ.filter first := rfl
        rw [hE]
        simpa only [one_mul] using hh
      have hq : (2 ^ (fuel + 1) : ℚ) *
          ((rawRejectedFiber R (by simpa [per] using hper)
            (fuel + 2)).card : ℚ) ≤
          ((readyAttemptRejectedFiber R
            (by simpa [per] using hper)).card : ℚ) := by
        simpa [hsumX, hsumY] using havg
      have hmassR : SamplerWeightedRetries.badMass
          (SamplerInitialRetries.outcomeWeight A
            (activeVertices n R.I.activeB)
            (fun b => numericNeighborhood G b ∩ A) r)
          (SamplerInitialRetries.outcomeBad A
            (activeVertices n R.I.activeB)
            (fun b => numericNeighborhood G b ∩ A) r k cap) ≤ (1 / 2 : ℚ) := by
        rw [hactive]
        exact hmass
      have hhalf := readyAttemptRejected_half R
        (by simpa [per] using hper) hmassR
      have hhalfQ : 2 *
          ((readyAttemptRejectedFiber R
            (by simpa [per] using hper)).card : ℚ) ≤ 2 ^ N := by
        exact_mod_cast hhalf
      have hfinalQ : (2 ^ (fuel + 2) : ℚ) *
          ((rawRejectedFiber R (by simpa [per] using hper)
            (fuel + 2)).card : ℚ) ≤ 2 ^ N := by
        rw [show fuel + 2 = (fuel + 1) + 1 by omega, pow_succ]
        nlinarith
      have hfinalNat : 2 ^ (fuel + 2) *
          (rawRejectedFiber R (by simpa [per] using hper)
            (fuel + 2)).card ≤ 2 ^ N := by
        exact_mod_cast hfinalQ
      convert hfinalNat using 1 <;> congr 1 <;> omega

/-- Matching the runtime retry counter to the rejected-prefix length gives
the usual geometric exhaustion bound. -/
lemma rawRejectedFiber_geometric
    {B n m domainCap r t bufferCap targetCap Q k cap N fuel : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (hsavedM : R.I.σ.vars "initialDomainSize" = m)
    (hsavedR : R.I.σ.vars "initialBatchTarget" = r)
    (hleft : R.I.σ.vars "initialRetriesLeft" = fuel + 1)
    (hstatus : R.I.σ.vars "initialRetryStatus" = 0)
    (hB : fuel + 1 < B)
    (hbudget : (fuel + 1) * attemptBitBudget n m r t ≤ N)
    (hper : attemptBitBudget n m r t ≤ N)
    (hmass : SamplerWeightedRetries.badMass
      (SamplerInitialRetries.outcomeWeight A
        (activeVertices n R.I.activeB)
        (fun b => numericNeighborhood G b ∩ A) r)
      (SamplerInitialRetries.outcomeBad A
        (activeVertices n R.I.activeB)
        (fun b => numericNeighborhood G b ∩ A) r k cap) ≤ (1 / 2 : ℚ)) :
    2 ^ (fuel + 1) * (rawRejectedFiber R hper (fuel + 1)).card ≤ 2 ^ N := by
  exact rawRejectedFiber_geometric_of_left R.I.activeB hmass fuel N
    (fuel + 1) R rfl hsavedM hsavedR hleft hstatus (by omega) hB
    hbudget hper

/-- Execution of the single fixed while loop from a state whose runtime
counter contains `fuel`, retaining every actual rejected attempt. -/
lemma initialRetryWhile_run_withTrace
    {B n m domainCap r t bufferCap targetCap Q k cap : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (fuel : ℕ)
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (hsavedM : R.I.σ.vars "initialDomainSize" = m)
    (hsavedR : R.I.σ.vars "initialBatchTarget" = r)
    (hleft : R.I.σ.vars "initialRetriesLeft" = fuel)
    (hstatus : R.I.σ.vars "initialRetryStatus" = 0)
    (hfuelB : fuel < B)
    (hbudget : fuel * attemptBitBudget n m r t ≤ R.I.bits.length) :
    ∃ (σ' : Env) (charges : List ℕ) (consumed : ℕ),
      Run B (.while (.eq (.var "initialRetryStatus") (.lit 0))
        initialRetryBody) R.I.σ σ'
        (charges.sum + 28 * charges.length + 14) ∧
      (∀ q ∈ charges, CheckedAttemptCharge B n m r t targetCap q) ∧
      charges.length ≤ fuel ∧
      consumed ≤ fuel * attemptBitBudget n m r t ∧
      σ'.inp = (R.I.bits.drop consumed).map Bool.toNat ++ R.I.rest ∧
      σ'.vars "n" = n ∧ σ'.vars "qpow" = Q ∧
      (AcceptedResult G A (activeVertices n R.I.activeB) r k cap σ' ∨
        (σ'.vars "initialRetryStatus" = 2 ∧
          (σ'.vars "batchFailed" = 1 ∨
            (σ'.vars "batchFailed" = 0 ∧ σ'.vars "repFailed" = 1))) ∨
        (σ'.vars "initialRetryStatus" = 3 ∧ charges.length = fuel)) ∧
      ∃ rejects : List (ℕ × ℕ),
        SourceRejectionTrace R rejects ∧
        charges.length ≤ rejects.length + 1 ∧
        (σ'.vars "initialRetryStatus" = 3 →
          charges.length = rejects.length) := by
  induction fuel generalizing R with
  | zero =>
      have h3B : 3 < B := by
        obtain ⟨a, ha⟩ := R.I.hAnonempty
        have han := Finset.mem_range.mp (R.I.hA ha)
        have hbound := R.hnB
        omega
      let σ' := R.I.σ.setVar "initialRetryStatus" 3
      have hrun : Run B (.while (.eq (.var "initialRetryStatus") (.lit 0))
          initialRetryBody) R.I.σ σ' 14 := empty_loop_run hstatus hleft h3B
      refine ⟨σ', [], 0, ?_, (by simp), by simp, by simp, ?_, ?_, ?_, ?_, ?_⟩
      · simpa using hrun
      · simp [σ', R.I.hinput]
      · simpa [σ'] using R.I.hn
      · simpa [σ'] using R.I.hQpow
      · exact Or.inr (Or.inr ⟨by simp [σ'], rfl⟩)
      · exact ⟨[], SourceRejectionTrace.nil R, by simp, by simp⟩
  | succ fuel ih =>
      obtain ⟨σsel, σa, tape, tail, values, used, drawFailed, stageCost,
        hbits, htrace, hselRun, hfull, hbatch, hinpSel, _houtSel,
        hoff, htgt, hactiveA, hactiveB, hn, hqpow,
        hdrawFailure, hdrawSuccess⟩ :=
        fullInitialAttempt_run_bits R.I R.hactiveA R.hdegree R.hinter
          R.hneighbors R.hexceptionFlags R.hexceptionList R.hnearBound
          R.hexceptionCap R.hnB R.hkB R.hcapB
      let q := attemptCharge n m r t targetCap used values.length drawFailed stageCost
      have hfull' : Run B fullInitialAttempt R.I.σ σa q := by
        simpa [q, attemptCharge] using hfull
      have hchecked : CheckedAttemptCharge B n m r t targetCap q :=
        ⟨R.I.σ, σa, used, values.length, drawFailed, stageCost, hfull', rfl⟩
      have hdrawLe : used * Nat.clog 2 m ≤ r * t * Nat.clog 2 m :=
        draw_consumed_le htrace
      have hzeroB : 0 < B := by omega
      have hleftA : σa.vars "initialRetriesLeft" = fuel + 1 := by
        calc
          _ = R.I.σ.vars "initialRetriesLeft" :=
            hfull'.frame_var "initialRetriesLeft" (by decide)
          _ = fuel + 1 := hleft
      have hstatusA : σa.vars "initialRetryStatus" = 0 := by
        calc
          _ = R.I.σ.vars "initialRetryStatus" :=
            hfull'.frame_var "initialRetryStatus" (by decide)
          _ = 0 := hstatus
      have hsavedMA : σa.vars "initialDomainSize" = m := by
        calc
          _ = R.I.σ.vars "initialDomainSize" :=
            hfull'.frame_var "initialDomainSize" (by decide)
          _ = m := hsavedM
      have hsavedRA : σa.vars "initialBatchTarget" = r := by
        calc
          _ = R.I.σ.vars "initialBatchTarget" :=
            hfull'.frame_var "initialBatchTarget" (by decide)
          _ = r := hsavedR
      have hguard : (Cond.eq (.var "initialRetryStatus") (.lit 0)).evalB B
          R.I.σ = some true := by
        simpa using eq_zero_eval hstatus hzeroB hzeroB
      have h3B : 3 < B := by
        obtain ⟨a, ha⟩ := R.I.hAnonempty
        have han := Finset.mem_range.mp (R.I.hA ha)
        have hbound := R.hnB
        omega
      cases drawFailed with
      | true =>
          obtain ⟨_, _, _, _, hinpFailed⟩ := hdrawFailure rfl
          have hbatchGuard : (Cond.eq (.var "batchFailed") (.lit 0)).evalB B σa =
              some false := by
            simpa using eq_zero_eval hbatch R.I.honeB hzeroB
          let σ' := σa.setVar "initialRetryStatus" 2
          have hassign : Run B (.assign "initialRetryStatus" (.lit 2)) σa σ' 2 := by
            simpa [σ'] using
              (Run.assign (x := "initialRetryStatus") (evalB_lit R.I.htwoB))
          have hdecision : Run B initialRetryDecision σa σ' 6 := by
            simpa [initialRetryDecision, Cond.size, Expr.size] using
              (Run.ite_false hbatchGuard hassign)
          have hbody : Run B initialRetryBody R.I.σ σ' (q + 10) :=
            retry_body_attempt hleft hfuelB hzeroB hfull' hdecision
          have hstop : Run B (.while (.eq (.var "initialRetryStatus") (.lit 0))
              initialRetryBody) σ' σ' 4 :=
            retry_stop (by simp [σ']) R.I.htwoB hzeroB (by decide)
          have hwhole : Run B (.while (.eq (.var "initialRetryStatus") (.lit 0))
              initialRetryBody) R.I.σ σ' (q + 18) := by
            have h := runWhileTrue hguard hbody hstop
            exact h.mono (by simp [Cond.size, Expr.size]; omega)
          refine ⟨σ', [q], used * Nat.clog 2 m, ?_, (by simpa using hchecked),
            by simp, ?_, ?_, ?_, ?_, ?_, ?_⟩
          · exact hwhole.mono (by simp)
          · have hper : used * Nat.clog 2 m ≤ attemptBitBudget n m r t :=
              hdrawLe.trans (Nat.le_add_right _ _)
            have hmore : attemptBitBudget n m r t ≤
                (fuel + 1) * attemptBitBudget n m r t := by
              nlinarith [Nat.zero_le (fuel * attemptBitBudget n m r t)]
            exact hper.trans hmore
          · simpa [σ'] using hinpFailed
          · simpa [σ'] using hn
          · simpa [σ'] using hqpow
          · exact Or.inr (Or.inl ⟨by simp [σ'], Or.inl (by simpa [σ'] using hbatch)⟩)
          · exact ⟨[], SourceRejectionTrace.nil R, by simp, by simp [σ']⟩
      | false =>
          obtain ⟨W, repFailed, repUsed, hW, hWA, hvaluesLen,
            hrepLe, hrepVal, hinpAttempt, hrepFailure, hrepSuccess⟩ :=
            hdrawSuccess rfl
          let d := used * Nat.clog 2 m + repUsed
          have hd : d ≤ attemptBitBudget n m r t := by
            dsimp [d, attemptBitBudget]
            omega
          have hbatch0 : σa.vars "batchFailed" = 0 := by simpa using hbatch
          have hbatchGuard :
              (Cond.eq (.var "batchFailed") (.lit 0)).evalB B σa =
                some true := by
            simpa using eq_zero_eval hbatch0 hzeroB hzeroB
          cases repFailed with
          | true =>
              obtain ⟨heq, haccept, _, _⟩ := hrepFailure rfl
              have hrepA : σa.vars "repFailed" = 1 := by
                rw [heq]
                simpa using hrepVal
              have hrepGuard :
                  (Cond.eq (.var "repFailed") (.lit 0)).evalB B σa =
                    some false := by
                simpa using eq_zero_eval hrepA R.I.honeB hzeroB
              let σ' := σa.setVar "initialRetryStatus" 2
              have hassign : Run B (.assign "initialRetryStatus" (.lit 2)) σa σ' 2 := by
                simpa [σ'] using
                  (Run.assign (x := "initialRetryStatus") (evalB_lit R.I.htwoB))
              have hinner : Run B
                  (.ite (.eq (.var "repFailed") (.lit 0))
                    (.ite (.eq (.var "attemptAccepted") (.lit 1))
                      (.assign "initialRetryStatus" (.lit 1))
                      (restoreInitialDomainRuntime.seq
                        (.assign "initialRetriesLeft"
                          (.sub (.var "initialRetriesLeft") (.lit 1)))))
                    (.assign "initialRetryStatus" (.lit 2))) σa σ' 6 := by
                simpa [Cond.size, Expr.size] using
                  (Run.ite_false hrepGuard hassign)
              have hdecision : Run B initialRetryDecision σa σ' 10 := by
                simpa [initialRetryDecision, Cond.size, Expr.size] using
                  (Run.ite_true (d := .assign "initialRetryStatus" (.lit 2))
                    hbatchGuard hinner)
              have hbody : Run B initialRetryBody R.I.σ σ' (q + 14) :=
                retry_body_attempt hleft hfuelB hzeroB hfull' hdecision
              have hstop : Run B (.while (.eq (.var "initialRetryStatus") (.lit 0))
                  initialRetryBody) σ' σ' 4 :=
                retry_stop (by simp [σ']) R.I.htwoB hzeroB (by decide)
              have hwhole : Run B (.while (.eq (.var "initialRetryStatus") (.lit 0))
                  initialRetryBody) R.I.σ σ' (q + 22) := by
                have h := runWhileTrue hguard hbody hstop
                exact h.mono (by simp [Cond.size, Expr.size]; omega)
              refine ⟨σ', [q], d, ?_, (by simpa using hchecked),
                by simp, ?_, ?_, ?_, ?_, ?_, ?_⟩
              · exact hwhole.mono (by simp)
              · have hmore : attemptBitBudget n m r t ≤
                    (fuel + 1) * attemptBitBudget n m r t := by
                  nlinarith [Nat.zero_le (fuel * attemptBitBudget n m r t)]
                exact hd.trans hmore
              · simpa [σ', d] using hinpAttempt
              · simpa [σ'] using hn
              · simpa [σ'] using hqpow
              · exact Or.inr (Or.inl ⟨by simp [σ'], Or.inr
                  ⟨by simpa [σ'] using hbatch0, by simpa [σ'] using hrepA⟩⟩)
              · exact ⟨[], SourceRejectionTrace.nil R, by simp, by simp [σ']⟩
          | false =>
              obtain ⟨mapped, choice, packedExceptions, packedSample,
                hmappedSel, _hdraws, hchoiceSample, hchoiceRep,
                hacceptRun, _hExceptionsEq, hflags, hlist, hprefixE,
                hcountE, hacceptBit, hsampleFlags, hord, hprefixW,
                hcountW, hrepFinal, _hactiveBFinal, hinpFinal⟩ :=
                hrepSuccess rfl
              have hrepA : σa.vars "repFailed" = 0 := by
                calc
                  σa.vars "repFailed" = σsel.vars "repFailed" :=
                    hacceptRun.frame_var "repFailed" (by decide)
                  _ = 0 := by simpa using hrepVal
              have hrepGuard :
                  (Cond.eq (.var "repFailed") (.lit 0)).evalB B σa =
                    some true := by
                simpa using eq_zero_eval hrepA hzeroB hzeroB
              by_cases hpass : (choice.exceptions k).card ≤ cap
              · have hacceptA : σa.vars "attemptAccepted" = 1 := by
                  simpa [hpass] using hacceptBit
                have hacceptGuard :
                    (Cond.eq (.var "attemptAccepted") (.lit 1)).evalB B σa =
                      some true := by
                  simpa using eq_one_eval hacceptA R.I.honeB R.I.honeB
                let σ' := σa.setVar "initialRetryStatus" 1
                have hassign : Run B (.assign "initialRetryStatus" (.lit 1))
                    σa σ' 2 := by
                  simpa [σ'] using
                    (Run.assign (x := "initialRetryStatus") (evalB_lit R.I.honeB))
                have hinner : Run B
                    (.ite (.eq (.var "attemptAccepted") (.lit 1))
                      (.assign "initialRetryStatus" (.lit 1))
                      (restoreInitialDomainRuntime.seq
                        (.assign "initialRetriesLeft"
                          (.sub (.var "initialRetriesLeft") (.lit 1)))))
                    σa σ' 6 := by
                  simpa [Cond.size, Expr.size] using
                    (Run.ite_true (d := restoreInitialDomainRuntime.seq
                      (.assign "initialRetriesLeft"
                        (.sub (.var "initialRetriesLeft") (.lit 1))))
                      hacceptGuard hassign)
                have hrepBranch : Run B
                    (.ite (.eq (.var "repFailed") (.lit 0))
                      (.ite (.eq (.var "attemptAccepted") (.lit 1))
                        (.assign "initialRetryStatus" (.lit 1))
                        (restoreInitialDomainRuntime.seq
                          (.assign "initialRetriesLeft"
                            (.sub (.var "initialRetriesLeft") (.lit 1)))))
                      (.assign "initialRetryStatus" (.lit 2))) σa σ' 10 := by
                  simpa [Cond.size, Expr.size] using
                    (Run.ite_true (d := .assign "initialRetryStatus" (.lit 2))
                      hrepGuard hinner)
                have hdecision : Run B initialRetryDecision σa σ' 14 := by
                  simpa [initialRetryDecision, Cond.size, Expr.size] using
                    (Run.ite_true (d := .assign "initialRetryStatus" (.lit 2))
                      hbatchGuard hrepBranch)
                have hbody : Run B initialRetryBody R.I.σ σ' (q + 18) :=
                  retry_body_attempt hleft hfuelB hzeroB hfull' hdecision
                have hstop : Run B (.while (.eq (.var "initialRetryStatus") (.lit 0))
                    initialRetryBody) σ' σ' 4 :=
                  retry_stop (by simp [σ']) R.I.honeB hzeroB (by decide)
                have hwhole : Run B (.while (.eq (.var "initialRetryStatus") (.lit 0))
                    initialRetryBody) R.I.σ σ' (q + 26) := by
                  have h := runWhileTrue hguard hbody hstop
                  exact h.mono (by simp [Cond.size, Expr.size]; omega)
                refine ⟨σ', [q], d, ?_, (by simpa using hchecked),
                  by simp, ?_, ?_, (by simpa [σ'] using hn),
                  (by simpa [σ'] using hqpow), ?_, ?_⟩
                · exact hwhole.mono (by simp)
                · have hmore : attemptBitBudget n m r t ≤
                      (fuel + 1) * attemptBitBudget n m r t := by
                    nlinarith [Nat.zero_le (fuel * attemptBitBudget n m r t)]
                  exact hd.trans hmore
                · simpa [σ', d] using hinpFinal
                · refine Or.inl ?_
                  refine ⟨mapped, choice, packedExceptions, packedSample,
                    by simp [σ'], by simpa [σ'] using hacceptA,
                    by simpa [σ'] using hrepFinal, hchoiceRep,
                    by simpa [σ'] using hflags, by simpa [σ'] using hlist,
                    ?_, ?_, ?_, by simpa [σ'] using hord, ?_, ⟨?_, hpass⟩⟩
                  · simpa [σ'] using hprefixE
                  · simpa [σ'] using hcountE
                  · simpa [σ', hchoiceSample] using hsampleFlags
                  · simpa [σ', hchoiceSample] using hprefixW
                  · simpa [σ', hchoiceSample] using hcountW
                · exact ⟨[], SourceRejectionTrace.nil R, by simp,
                    by simp [σ']⟩
              · have hacceptA : σa.vars "attemptAccepted" = 0 := by
                  simpa [hpass] using hacceptBit
                have hacceptGuard :
                    (Cond.eq (.var "attemptAccepted") (.lit 1)).evalB B σa =
                      some false := by
                  simpa using eq_one_eval hacceptA hzeroB R.I.honeB
                let τ := (σa.setVar "drawModulus" m).setVar "batchTarget" r
                let υ := τ.setVar "initialRetriesLeft" fuel
                have hrestore : Run B restoreInitialDomainRuntime σa τ 4 :=
                  restore_runtime_run hsavedMA hsavedRA R.I.hmB R.I.hrB
                have hleftτ : τ.vars "initialRetriesLeft" = fuel + 1 := by
                  simpa [τ] using hleftA
                have hdecrement : Run B (.assign "initialRetriesLeft"
                    (.sub (.var "initialRetriesLeft") (.lit 1))) τ υ 4 := by
                  exact decrement_run hleftτ hfuelB R.I.honeB
                have hrestoreDec : Run B
                    (restoreInitialDomainRuntime.seq
                      (.assign "initialRetriesLeft"
                        (.sub (.var "initialRetriesLeft") (.lit 1)))) σa υ 8 :=
                  hrestore.seq hdecrement
                have hstatusυ : υ.vars "initialRetryStatus" = 0 := by
                  simpa [υ, τ] using hstatusA
                have hleftυ : υ.vars "initialRetriesLeft" = fuel := by
                  simp [υ]
                have hinner : Run B
                    (.ite (.eq (.var "attemptAccepted") (.lit 1))
                      (.assign "initialRetryStatus" (.lit 1))
                      (restoreInitialDomainRuntime.seq
                        (.assign "initialRetriesLeft"
                          (.sub (.var "initialRetriesLeft") (.lit 1)))))
                    σa υ 12 := by
                  simpa [Cond.size, Expr.size] using
                    (Run.ite_false hacceptGuard hrestoreDec)
                have hrepBranch : Run B
                    (.ite (.eq (.var "repFailed") (.lit 0))
                      (.ite (.eq (.var "attemptAccepted") (.lit 1))
                        (.assign "initialRetryStatus" (.lit 1))
                        (restoreInitialDomainRuntime.seq
                          (.assign "initialRetriesLeft"
                            (.sub (.var "initialRetriesLeft") (.lit 1)))))
                      (.assign "initialRetryStatus" (.lit 2))) σa υ 16 := by
                  simpa [Cond.size, Expr.size] using
                    (Run.ite_true (d := .assign "initialRetryStatus" (.lit 2))
                      hrepGuard hinner)
                have hdecision : Run B initialRetryDecision σa υ 20 := by
                  simpa [initialRetryDecision, Cond.size, Expr.size] using
                    (Run.ite_true (d := .assign "initialRetryStatus" (.lit 2))
                      hbatchGuard hrepBranch)
                have hbody : Run B initialRetryBody R.I.σ υ (q + 24) :=
                  retry_body_attempt hleft hfuelB hzeroB hfull' hdecision
                have hbatchSel : σsel.vars "batchFailed" = 0 := by
                  exact (hacceptRun.frame_var "batchFailed" (by decide)).symm.trans
                    hbatch0
                have hrepSel : σsel.vars "repFailed" = 0 := by
                  simpa using hrepVal
                have hreject :
                    (FlatTraceLaw.flatBitsEquiv R.I.bits.length).symm
                      ⟨R.I.bits, rfl⟩ ∈
                    sourceInitialBadFiber R.I k cap := by
                  apply initialSamplerAttempt_run_badFiber R.I σsel _ k cap
                    choice mapped hselRun hbatchSel hrepSel hmappedSel hchoiceRep
                  omega
                have hrejectStopped :
                    ∃ ω : SamplerInitialRetries.InitialOutcome A
                        (activeVertices n R.I.activeB)
                        (fun b => numericNeighborhood G b ∩ A) r,
                      SamplerInitialRetries.outcomeBad A
                        (activeVertices n R.I.activeB)
                        (fun b => numericNeighborhood G b ∩ A) r k cap ω = true ∧
                      ∃ w : SourceInitialOutcomeWitness R.I R.I.bits ω,
                        d = w.used * Nat.clog 2 m + w.repUsed := by
                  have hdLength : d ≤ R.I.bits.length := by
                    have hper : attemptBitBudget n m r t ≤
                        (fuel + 1) * attemptBitBudget n m r t := by
                      nlinarith [Nat.zero_le (fuel * attemptBitBudget n m r t)]
                    exact hd.trans (hper.trans hbudget)
                  exact sourceInitialBadFiber_consumed R.I σsel _ d k cap
                    hselRun (hinpSel.symm.trans (by simpa [d] using hinpFinal))
                    hdLength hreject
                by_cases hzero : fuel = 0
                · have hleftZero : υ.vars "initialRetriesLeft" = 0 := by
                    simpa [hzero] using hleftυ
                  have htail : Run B
                      (.while (.eq (.var "initialRetryStatus") (.lit 0))
                        initialRetryBody) υ (υ.setVar "initialRetryStatus" 3) 14 :=
                    empty_loop_run hstatusυ hleftZero h3B
                  let σ' := υ.setVar "initialRetryStatus" 3
                  have hwhole : Run B
                      (.while (.eq (.var "initialRetryStatus") (.lit 0))
                        initialRetryBody) R.I.σ σ' (q + 42) := by
                    have h := runWhileTrue hguard hbody htail
                    exact h.mono (by simp [Cond.size, Expr.size]; omega)
                  refine ⟨σ', [q], d, ?_, (by simpa using hchecked),
                    by simp, ?_, ?_, (by simpa [σ', υ, τ] using hn),
                    (by simpa [σ', υ, τ] using hqpow), ?_, ?_⟩
                  · exact hwhole.mono (by simp)
                  · simpa [hzero] using hd
                  · simpa [σ', υ, τ, d] using hinpFinal
                  · exact Or.inr (Or.inr ⟨by simp [σ'], by simp [hzero]⟩)
                  · refine ⟨[(q, d)], ?_, by simp, by simp⟩
                    exact SourceRejectionTrace.last R σa q d hfull'
                      (by simpa [d] using hinpFinal) hd hbatch0 hrepA
                      hacceptA hreject hrejectStopped
                · have hpositive : 1 ≤ fuel := Nat.one_le_iff_ne_zero.mpr hzero
                  have hbudgetNext : fuel * attemptBitBudget n m r t ≤
                      (R.I.bits.drop d).length := drop_budget hbudget hd
                  have hper : attemptBitBudget n m r t ≤
                      fuel * attemptBitBudget n m r t := by
                    simpa using Nat.mul_le_mul_right
                      (attemptBitBudget n m r t) hpositive
                  obtain ⟨S, _hrestoreS, hSstate, hSbits, hSrest, hSactive⟩ :=
                    ready_after_rejection R hfull' hn hqpow hoff htgt
                      hactiveA hactiveB hinpFinal (hper.trans hbudgetNext)
                  let J := S.withRetriesLeft fuel
                  have hJstate : J.I.σ = υ := by
                    change S.I.σ.setVar "initialRetriesLeft" fuel = υ
                    rw [hSstate]
                  have hJsavedM : J.I.σ.vars "initialDomainSize" = m := by
                    rw [hJstate]
                    simpa [υ, τ] using hsavedMA
                  have hJsavedR : J.I.σ.vars "initialBatchTarget" = r := by
                    rw [hJstate]
                    simpa [υ, τ] using hsavedRA
                  have hJleft : J.I.σ.vars "initialRetriesLeft" = fuel := by
                    rw [hJstate]
                    exact hleftυ
                  have hJstatus : J.I.σ.vars "initialRetryStatus" = 0 := by
                    rw [hJstate]
                    exact hstatusυ
                  obtain ⟨σ', tailCharges, tailConsumed, hrecRun,
                    htailChecked, htailLen, htailConsumed, hinpRec,
                    hnRec, hqRec, htailOutcome, tailRejects,
                    htailTrace, htailAtMost, htailExhausted⟩ :=
                    ih J hJsavedM hJsavedR hJleft hJstatus
                      (by omega) (by
                        change fuel * attemptBitBudget n m r t ≤ S.I.bits.length
                        rw [hSbits]
                        exact hbudgetNext)
                  have hrecRun' : Run B
                      (.while (.eq (.var "initialRetryStatus") (.lit 0))
                        initialRetryBody) υ σ'
                      (tailCharges.sum + 28 * tailCharges.length + 14) := by
                    simpa [hJstate] using hrecRun
                  have hwhole : Run B
                      (.while (.eq (.var "initialRetryStatus") (.lit 0))
                        initialRetryBody) R.I.σ σ'
                      (q + 28 + (tailCharges.sum +
                        28 * tailCharges.length + 14)) := by
                    have h := runWhileTrue hguard hbody hrecRun'
                    exact h.mono (by simp [Cond.size, Expr.size]; omega)
                  refine ⟨σ', q :: tailCharges, d + tailConsumed, ?_,
                    (by
                      intro x hx
                      rcases List.mem_cons.mp hx with rfl | h
                      · exact hchecked
                      · exact htailChecked x h), ?_, ?_, ?_, hnRec, hqRec, ?_, ?_⟩
                  · exact hwhole.mono (by
                      simp only [List.sum_cons, List.length_cons]
                      omega)
                  · simp only [List.length_cons]
                    omega
                  · have hsum : d + tailConsumed ≤
                        attemptBitBudget n m r t +
                          fuel * attemptBitBudget n m r t :=
                      Nat.add_le_add hd htailConsumed
                    simpa [Nat.succ_mul, Nat.add_comm, Nat.add_left_comm,
                      Nat.add_assoc] using hsum
                  · calc
                      σ'.inp = (J.I.bits.drop tailConsumed).map Bool.toNat ++
                          J.I.rest := hinpRec
                      _ = ((R.I.bits.drop d).drop tailConsumed).map Bool.toNat ++
                          R.I.rest := by rw [show J.I.bits = R.I.bits.drop d from
                            hSbits, show J.I.rest = R.I.rest from hSrest]
                      _ = (R.I.bits.drop (d + tailConsumed)).map Bool.toNat ++
                          R.I.rest := by simp [List.drop_drop]
                  · rcases htailOutcome with haccepted | hfailure | hexhausted
                    · have hJactive : J.I.activeB = R.I.activeB := by
                        change S.I.activeB = R.I.activeB
                        exact hSactive
                      exact Or.inl (by simpa [hJactive] using haccepted)
                    · exact Or.inr (Or.inl hfailure)
                    · exact Or.inr (Or.inr ⟨hexhausted.1, by
                        simpa [List.length_cons] using congrArg Nat.succ hexhausted.2⟩)
                  · refine ⟨(q, d) :: tailRejects, ?_, ?_, ?_⟩
                    · exact SourceRejectionTrace.step R J σa q d 20
                        tailRejects hfull' (by simpa [d] using hinpFinal)
                        hd hbatch0 hrepA hacceptA hreject hrejectStopped
                        (by simpa [hJstate] using hdecision)
                        (by change S.I.bits = R.I.bits.drop d; exact hSbits)
                        htailTrace
                    · simpa using Nat.succ_le_succ htailAtMost
                    · intro hstatus3
                      exact congrArg Nat.succ (htailExhausted hstatus3)

/-- The original compact loop interface, obtained by erasing the retained
rejection trace. -/
lemma initialRetryWhile_run
    {B n m domainCap r t bufferCap targetCap Q k cap : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (fuel : ℕ)
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (hsavedM : R.I.σ.vars "initialDomainSize" = m)
    (hsavedR : R.I.σ.vars "initialBatchTarget" = r)
    (hleft : R.I.σ.vars "initialRetriesLeft" = fuel)
    (hstatus : R.I.σ.vars "initialRetryStatus" = 0)
    (hfuelB : fuel < B)
    (hbudget : fuel * attemptBitBudget n m r t ≤ R.I.bits.length) :
    ∃ (σ' : Env) (charges : List ℕ) (consumed : ℕ),
      Run B (.while (.eq (.var "initialRetryStatus") (.lit 0))
        initialRetryBody) R.I.σ σ'
        (charges.sum + 28 * charges.length + 14) ∧
      (∀ q ∈ charges, CheckedAttemptCharge B n m r t targetCap q) ∧
      charges.length ≤ fuel ∧
      consumed ≤ fuel * attemptBitBudget n m r t ∧
      σ'.inp = (R.I.bits.drop consumed).map Bool.toNat ++ R.I.rest ∧
      σ'.vars "n" = n ∧ σ'.vars "qpow" = Q ∧
      (AcceptedResult G A (activeVertices n R.I.activeB) r k cap σ' ∨
        (σ'.vars "initialRetryStatus" = 2 ∧
          (σ'.vars "batchFailed" = 1 ∨
            (σ'.vars "batchFailed" = 0 ∧ σ'.vars "repFailed" = 1))) ∨
        (σ'.vars "initialRetryStatus" = 3 ∧ charges.length = fuel)) := by
  obtain ⟨σ', charges, consumed, hrun, hchecked, hlen, hconsumed,
    hinp, hn, hqpow, houtcome, _⟩ :=
    initialRetryWhile_run_withTrace fuel R hsavedM hsavedR hleft
      hstatus hfuelB hbudget
  exact ⟨σ', charges, consumed, hrun, hchecked, hlen, hconsumed,
    hinp, hn, hqpow, houtcome⟩

/-- Execute the fixed source with a runtime attempt cap.  Each element of
`charges` has a standalone checked full-attempt charge witness, while the
global execution bound sums those charges.  The remaining input is precisely
the unconsumed suffix of the supplied bit tape.  Only ordinary exception-count
rejection can start another attempt. -/
lemma initialSamplerRetriesSource_run_withTrace
    {B n m domainCap r t bufferCap targetCap Q k cap : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (attemptCap : ℕ)
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (hcap : R.I.σ.vars "initialRetryCap" = attemptCap)
    (hcapB : attemptCap < B)
    (hbudget : attemptCap * attemptBitBudget n m r t ≤ R.I.bits.length) :
    ∃ (σ' : Env) (charges : List ℕ) (consumed : ℕ),
      Run B initialSamplerRetriesSource R.I.σ σ'
        (charges.sum + 28 * charges.length + 22) ∧
      (∀ q ∈ charges, CheckedAttemptCharge B n m r t targetCap q) ∧
      charges.length ≤ attemptCap ∧
      consumed ≤ attemptCap * attemptBitBudget n m r t ∧
      σ'.inp = (R.I.bits.drop consumed).map Bool.toNat ++ R.I.rest ∧
      σ'.vars "n" = n ∧ σ'.vars "qpow" = Q ∧
      (AcceptedResult G A (activeVertices n R.I.activeB) r k cap σ' ∨
        (σ'.vars "initialRetryStatus" = 2 ∧
          (σ'.vars "batchFailed" = 1 ∨
            (σ'.vars "batchFailed" = 0 ∧ σ'.vars "repFailed" = 1))) ∨
        (σ'.vars "initialRetryStatus" = 3 ∧ charges.length = attemptCap)) ∧
      ∃ (S : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
        (rejects : List (ℕ × ℕ)),
        S.I.bits = R.I.bits ∧ S.I.activeB = R.I.activeB ∧
        S.I.σ = (((R.I.σ.setVar "initialDomainSize" m).setVar
          "initialBatchTarget" r).setVar "initialRetriesLeft" attemptCap).setVar
            "initialRetryStatus" 0 ∧
        SourceRejectionTrace S rejects ∧
        charges.length ≤ rejects.length + 1 ∧
        (σ'.vars "initialRetryStatus" = 3 →
          charges.length = rejects.length) := by
  let σ₁ := R.I.σ.setVar "initialDomainSize" m
  let σ₂ := σ₁.setVar "initialBatchTarget" r
  let σ₃ := σ₂.setVar "initialRetriesLeft" attemptCap
  let σ₄ := σ₃.setVar "initialRetryStatus" 0
  have hfirstEval : (Expr.var "drawModulus").evalB B R.I.σ = some m := by
    rw [evalB_var_iff]
    exact ⟨R.I.hdrawModulus.symm, by rw [R.I.hdrawModulus]; exact R.I.hmB⟩
  have hfirst : Run B (.assign "initialDomainSize" (.var "drawModulus"))
      R.I.σ σ₁ 2 := by
    simpa [σ₁] using (Run.assign (x := "initialDomainSize") hfirstEval)
  have hsecondEval : (Expr.var "batchTarget").evalB B σ₁ = some r := by
    rw [evalB_var_iff]
    constructor
    · simpa [σ₁] using R.I.hbatchTarget.symm
    · simpa [σ₁, R.I.hbatchTarget] using R.I.hrB
  have hsecond : Run B (.assign "initialBatchTarget" (.var "batchTarget"))
      σ₁ σ₂ 2 := by
    simpa [σ₂] using (Run.assign (x := "initialBatchTarget") hsecondEval)
  have hthirdEval : (Expr.var "initialRetryCap").evalB B σ₂ =
      some attemptCap := by
    rw [evalB_var_iff]
    constructor
    · simpa [σ₂, σ₁] using hcap.symm
    · simpa [σ₂, σ₁, hcap] using hcapB
  have hthird : Run B (.assign "initialRetriesLeft" (.var "initialRetryCap"))
      σ₂ σ₃ 2 := by
    simpa [σ₃] using (Run.assign (x := "initialRetriesLeft") hthirdEval)
  have hzeroB : 0 < B := by omega
  have hfourth : Run B (.assign "initialRetryStatus" (.lit 0))
      σ₃ σ₄ 2 := by
    simpa [σ₄] using
      (Run.assign (x := "initialRetryStatus") (evalB_lit hzeroB))
  let S := R.withSetup attemptCap
  have hSstate : S.I.σ = σ₄ := rfl
  have hSavedM : S.I.σ.vars "initialDomainSize" = m := by
    rw [hSstate]
    simp [σ₄, σ₃, σ₂, σ₁]
  have hSavedR : S.I.σ.vars "initialBatchTarget" = r := by
    rw [hSstate]
    simp [σ₄, σ₃, σ₂]
  have hLeft : S.I.σ.vars "initialRetriesLeft" = attemptCap := by
    rw [hSstate]
    simp [σ₄, σ₃]
  have hStatus : S.I.σ.vars "initialRetryStatus" = 0 := by
    rw [hSstate]
    simp [σ₄]
  obtain ⟨σ', charges, consumed, hloop, hchecked, hlen, hconsumed, hinp,
    hnFinal, hqFinal, houtcome, rejects, htrace, hatMost,
    hexhausted⟩ :=
    initialRetryWhile_run_withTrace attemptCap S hSavedM hSavedR hLeft hStatus
      hcapB (by
        change attemptCap * attemptBitBudget n m r t ≤ R.I.bits.length
        exact hbudget)
  have hloop' : Run B (.while (.eq (.var "initialRetryStatus") (.lit 0))
      initialRetryBody) σ₄ σ' (charges.sum + 28 * charges.length + 14) := by
    simpa [hSstate] using hloop
  refine ⟨σ', charges, consumed, ?_, hchecked, hlen, hconsumed, ?_,
    hnFinal, hqFinal, ?_, ?_⟩
  · have hwhole := hfirst.seq (hsecond.seq (hthird.seq (hfourth.seq hloop')))
    change Run B initialSamplerRetriesSource R.I.σ σ'
      (charges.sum + 28 * charges.length + 22)
    exact hwhole.mono (by omega)
  · have hSbits : S.I.bits = R.I.bits := rfl
    have hSrest : S.I.rest = R.I.rest := rfl
    simpa only [hSbits, hSrest] using hinp
  · have hSactive : S.I.activeB = R.I.activeB := rfl
    simpa only [hSactive] using houtcome
  · exact ⟨S, rejects, rfl, rfl, rfl, htrace, hatMost, hexhausted⟩

/-- Exhaustion of the actual fixed source entails exactly `attemptCap`
ordinary rejected full attempts, starting at the exact post-setup machine
state. -/
lemma source_status3_raw
    {B n m domainCap r t bufferCap targetCap Q k cap : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (attemptCap : ℕ)
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (hcap : R.I.σ.vars "initialRetryCap" = attemptCap)
    (hcapB : attemptCap < B)
    (hbudget : attemptCap * attemptBitBudget n m r t ≤ R.I.bits.length)
    {σout : Env} {cost : ℕ}
    (hrun : Run B initialSamplerRetriesSource R.I.σ σout cost)
    (hstatus : σout.vars "initialRetryStatus" = 3) :
    ∃ S : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A,
      S.I.bits = R.I.bits ∧ S.I.activeB = R.I.activeB ∧
      S.I.σ = (((R.I.σ.setVar "initialDomainSize" m).setVar
        "initialBatchTarget" r).setVar "initialRetriesLeft" attemptCap).setVar
          "initialRetryStatus" 0 ∧
      RawRejected (B := B) S.I.σ attemptCap := by
  obtain ⟨σ', charges, consumed, hrun', hchecked, hlen, hconsumed,
    hinp, hn, hqpow, houtcome, S, rejects, hbits, hactive, hsetup,
    htrace, hatMost, hexhausted⟩ :=
    initialSamplerRetriesSource_run_withTrace attemptCap R hcap hcapB hbudget
  have heq : σout = σ' := by
    obtain ⟨_, _, ha⟩ := hrun
    obtain ⟨_, _, hb⟩ := hrun'
    exact (BigStep.unique ha.bigStep hb.bigStep).1
  have hstatus' : σ'.vars "initialRetryStatus" = 3 := by
    simpa [heq] using hstatus
  have hcapLen : charges.length = attemptCap := by
    rcases houtcome with hgood | habort | hexhaust
    · obtain ⟨mapped, choice, packedExceptions, packedSample,
        hgoodStatus, _⟩ := hgood
      omega
    · omega
    · exact hexhaust.2
  have hrejectLen : rejects.length = attemptCap := by
    calc
      rejects.length = charges.length := (hexhausted hstatus').symm
      _ = attemptCap := hcapLen
  refine ⟨S, hbits, hactive, hsetup, ?_⟩
  simpa [hrejectLen] using htrace.raw

/-- Actual source tapes ending at the fixed retry cap. -/
noncomputable def sourceExhaustedFiber
    {B n m domainCap r t bufferCap targetCap Q k cap N : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (hper : attemptBitBudget n m r t ≤ N) :
    Finset (FlatTraceLaw.FlatTape N) := by
  classical
  exact Finset.univ.filter fun ρ =>
    ∃ (σout : Env) (cost : ℕ),
      Run B initialSamplerRetriesSource
        (R.reinput (List.ofFn ρ)
          (by simpa [attemptBitBudget] using hper)).I.σ σout cost ∧
      σout.vars "initialRetryStatus" = 3

/-- Exact source exhaustion is bounded by the geometric all-rejection
event. The first cap setup runs before any random bit is read. -/
lemma sourceExhaustedFiber_geometric
    {B n m domainCap r t bufferCap targetCap Q k cap N : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (attemptCap : ℕ)
    (hcap : R.I.σ.vars "initialRetryCap" = attemptCap)
    (hcapB : attemptCap < B)
    (hpositive : 0 < attemptCap)
    (hbudget : attemptCap * attemptBitBudget n m r t ≤ N)
    (hper : attemptBitBudget n m r t ≤ N)
    (hmass : SamplerWeightedRetries.badMass
      (SamplerInitialRetries.outcomeWeight A
        (activeVertices n R.I.activeB)
        (fun b => numericNeighborhood G b ∩ A) r)
      (SamplerInitialRetries.outcomeBad A
        (activeVertices n R.I.activeB)
        (fun b => numericNeighborhood G b ∩ A) r k cap) ≤ (1 / 2 : ℚ)) :
    2 ^ attemptCap * (sourceExhaustedFiber R hper).card ≤ 2 ^ N := by
  classical
  let S0 := R.withSetup attemptCap
  have hSsavedM : S0.I.σ.vars "initialDomainSize" = m := by
    simp [S0, ReadyInput.withSetup]
  have hSsavedR : S0.I.σ.vars "initialBatchTarget" = r := by
    simp [S0, ReadyInput.withSetup]
  have hSleft : S0.I.σ.vars "initialRetriesLeft" = attemptCap := by
    simp [S0, ReadyInput.withSetup]
  have hSstatus : S0.I.σ.vars "initialRetryStatus" = 0 := by
    simp [S0, ReadyInput.withSetup]
  have hSmass : SamplerWeightedRetries.badMass
      (SamplerInitialRetries.outcomeWeight A
        (activeVertices n S0.I.activeB)
        (fun b => numericNeighborhood G b ∩ A) r)
      (SamplerInitialRetries.outcomeBad A
        (activeVertices n S0.I.activeB)
        (fun b => numericNeighborhood G b ∩ A) r k cap) ≤ (1 / 2 : ℚ) := by
    exact hmass
  have hsub : sourceExhaustedFiber R hper ⊆
      rawRejectedFiber S0 hper attemptCap := by
    intro ρ hρ
    obtain ⟨σout, cost, hrun, hstatus⟩ :
        ∃ (σout : Env) (cost : ℕ),
          Run B initialSamplerRetriesSource
            (R.reinput (List.ofFn ρ)
              (by simpa [attemptBitBudget] using hper)).I.σ σout cost ∧
          σout.vars "initialRetryStatus" = 3 := by
      simpa [sourceExhaustedFiber] using hρ
    let Rρ := R.reinput (List.ofFn ρ)
      (by simpa [attemptBitBudget] using hper)
    obtain ⟨S, hbits, hactive, hsetup, hraw⟩ :=
      source_status3_raw attemptCap Rρ
        (by change R.I.σ.vars "initialRetryCap" = attemptCap; exact hcap)
        hcapB (by simpa [Rρ, ReadyInput.reinput_bits] using hbudget)
        hrun hstatus
    have hstate : S.I.σ =
        (S0.reinput (List.ofFn ρ)
          (by simpa [attemptBitBudget] using hper)).I.σ := by
      rw [hsetup]
      rfl
    have hraw' : RawRejected (B := B)
        (S0.reinput (List.ofFn ρ)
          (by simpa [attemptBitBudget] using hper)).I.σ attemptCap := by
      simpa [hstate] using hraw
    simpa [rawRejectedFiber] using hraw'
  have hgeom := rawRejectedFiber_geometric S0 hSsavedM hSsavedR
    (fuel := attemptCap - 1)
    (by simpa [Nat.sub_add_cancel hpositive] using hSleft)
    hSstatus (by omega) (by simpa [Nat.sub_add_cancel hpositive] using hbudget)
    hper hSmass
  have hcount : 2 ^ attemptCap *
      (rawRejectedFiber S0 hper attemptCap).card ≤ 2 ^ N := by
    simpa [Nat.sub_add_cancel hpositive] using hgeom
  exact (Nat.mul_le_mul_left _ (Finset.card_le_card hsub)).trans hcount

/-- Compact source-loop interface, with the retained ordered trace erased. -/
lemma initialSamplerRetriesSource_run
    {B n m domainCap r t bufferCap targetCap Q k cap : ℕ}
    {G : SimpleGraph (Fin n)} {x : List ℕ} {A : Finset ℕ}
    (attemptCap : ℕ)
    (R : ReadyInput B n m domainCap r t bufferCap targetCap Q k cap G x A)
    (hcap : R.I.σ.vars "initialRetryCap" = attemptCap)
    (hcapB : attemptCap < B)
    (hbudget : attemptCap * attemptBitBudget n m r t ≤ R.I.bits.length) :
    ∃ (σ' : Env) (charges : List ℕ) (consumed : ℕ),
      Run B initialSamplerRetriesSource R.I.σ σ'
        (charges.sum + 28 * charges.length + 22) ∧
      (∀ q ∈ charges, CheckedAttemptCharge B n m r t targetCap q) ∧
      charges.length ≤ attemptCap ∧
      consumed ≤ attemptCap * attemptBitBudget n m r t ∧
      σ'.inp = (R.I.bits.drop consumed).map Bool.toNat ++ R.I.rest ∧
      σ'.vars "n" = n ∧ σ'.vars "qpow" = Q ∧
      (AcceptedResult G A (activeVertices n R.I.activeB) r k cap σ' ∨
        (σ'.vars "initialRetryStatus" = 2 ∧
          (σ'.vars "batchFailed" = 1 ∨
            (σ'.vars "batchFailed" = 0 ∧ σ'.vars "repFailed" = 1))) ∨
        (σ'.vars "initialRetryStatus" = 3 ∧ charges.length = attemptCap)) := by
  obtain ⟨σ', charges, consumed, hrun, hchecked, hlen, hconsumed,
    hinp, hn, hqpow, houtcome, _⟩ :=
    initialSamplerRetriesSource_run_withTrace attemptCap R hcap hcapB hbudget
  exact ⟨σ', charges, consumed, hrun, hchecked, hlen, hconsumed,
    hinp, hn, hqpow, houtcome⟩

