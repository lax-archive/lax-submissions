% Citations
% Bibliography is handled by biblatex/biber.  The in-text style is alphabetic,
% so an ordinary \cite still comes out as [Ber79].  Inside a footnote, \cite
% switches automatically to the long humanities-style form
%     Jean Berstel, Transductions and Context-Free Languages, 1979
% see \incite below.
\usepackage{csquotes}
\usepackage[backend=bibtex, style=alphabetic, maxnames=99]{biblatex}
\addbibresource{bib.bib}

% for the moment, I just use the standard cite command, but at some point I want to improve it so that it is inline
\newcommand{\mycite}[2][]{\cite[#2]{#1}}

% Inline citation: full author names, title, year.
% The optional argument is a pinpoint, e.g. \incite[Lemma 3]{key}.
% Several keys are allowed, e.g. \incite{key1,key2}.
\DeclareCiteCommand{\incite}
  {\usebibmacro{prenote}}
  {\printnames[given-family]{labelname}%
   \setunit{\addcomma\space}%
   \printfield[citetitle]{title}%
   \setunit{\addcomma\space}%
   \printfield{year}}
  {\multicitedelim}
  {\usebibmacro{postnote}}

% Inside a footnote, \cite means \incite.  \shortcite is the escape hatch that
% always gives the short label, also in a footnote.
\newif\ifinfootnote
\makeatletter
\let\incite@footnotetext\@footnotetext
\long\def\@footnotetext#1{\incite@footnotetext{\infootnotetrue#1}}
\makeatother
\let\shortcite\cite
\protected\def\cite{\ifinfootnote\expandafter\incite\else\expandafter\shortcite\fi}

% Block-style inline citation: left-indented with vertical space above/below.
\newcommand{\inciteblock}[2][]{%
    \par\smallskip
    \noindent\hspace*{3em}\parbox[t]{\dimexpr\linewidth-2em\relax}{\incite[#1]{#2}}%
    \par\smallskip
}